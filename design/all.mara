
module all

use mara.core
sdl :: use mara.sdl

main :: fun() {

	print("Hello there!\n")

	types_and_values()
	operators()
	control_flow()
	functions()
}


types_and_values :: fun() {
	print("Types and Values")

	CONSTANT :: 7
	
	// name : type = value
	its_true: bool = true
	// we can guess the type if you skip it
	its_false := false

	smallest_int: i8
	biggest_int: i128

	smallest_uint: u8
	biggest_uint: u128

	smallest_float: f16
	biggest_float: f64
	print("As you see, this one is", biggest_float)

	untyped_memory: byte
	string_byte: utf8

	array: [64]byte // value, holds its own data
	slice: []byte // reference, points to someone else's data
	slice_array: [..47]utf8 // the main container type in Mara

	pointer : ^f64 = &biggest_float
	biggest_float = 99
	value := pointer^
	print("This should read out", value)

	print()

	// slices and pointers don't get intialized
	// you can't read from them until you assign them
	// you can't assign numbers to pointers
	// you can't do math on pointers
}

operators :: fun() {
	print("Operators")

	a := 8	b := 2
	c := a + b
	d := a - b
	e := a * b
	f := a / b
	g := a % b
	print("8 2 10 6 16 4 0")
	print(a, b, c, d, e, f, g)

	if c == 10 do print("c is 10")
	if d != e do print("d is not e")

	its_true := a > b
	its_false := a < b

	if true and its_true do print("logic!")
	if its_false or its_true do print("big brain logic!")
	if b <= a and b + 6 >= a do print("galaxy brain logic!")
	if not its_false do print("double negative...")

	flags, things: u8
	flags = 7 << 4 		// 01110000
	things = 255 >> 2 	// 00111111
	print("flags: %, things: %", flags, things)
	// these test bit overlap
	both_set := flags & things
	either_set := flags | things
	whats_xor := flags ~ things
	print("either: %, both: %, xor: %",
		either_set, both_set, whats_xor)

	// +% -% *% wrap on overflow instead of trapping (plain + - * would crash)
	hi, lo : u8 = 255, 0
	wrap_add := hi +% 1   // 0    wraps past the top
	wrap_sub := lo -% 1   // 255  wraps past the bottom
	wrap_mul := hi *% 2   // 254  (510 mod 256)
	print("add %, sub %, mul %", wrap_add, wrap_sub, wrap_mul)

	print()
}

control_flow :: fun() {
	print("Control Flow: If")
	water_temperature := 101

	// braces go around the entire if-else block
	if water_temperature > 100 {
		print("It's steam!")
	// elif means else if
	elif water_temperature == 100
		print("It's bubbly!")

	// this checks from 0 to 99
	elif water_temperature in 0..100
		print("It's probably hot")
	else
		print("It's ice!")
	}

	water_temperature = -1
	if bool(water_temperature) do print("
		Only true/false allowed as conditions
	 	Only 0 converts to false")

	print("\nControl Flow: For")

	some_numbers : [5]u8 = [11, 22, 33, 44, 55]
	for number, index in some_numbers {
		if number == index + 10 do continue
		print("The number:", number)
		print("The index: ", index)
	}

	n := 11
	for i in 5..n
	do print("Range:", i)

	always_true := true
	for always_true {
		print("Infinite loop")
		break
	}
}

functions :: fun() {
	print("Functions")

	local_add :: fun(count: u32, number: i32)
	-> named_return : i64
	{
		result := count + number
		named_return = result // already declared
		return named_return // return statement required
	}

	multi_return :: fun() -> i64, i64 {
		one := local_add(6, -5)
		three := one + 2
		return three, 4 + 5
	}
	a, b := multi_return()
	print("Uhh... 3 and 9:", a, "and", b)

	default_values :: fun(five := 5) -> seven : u32 {
		result := 2 + five
		return result
	}
}