
module all

use mara.core
sdl :: use mara.sdl

// Program starts running in the main function
main :: fun() {

	// print statement uses c printf under the hood
	print("Hello there!")

	// table of contents
	basic_variables_and_types()
	control_flow()
}

basic_variables_and_types :: fun() {
	
	// name : type = value
	its_true: bool = true
	// we can guess the type if you skip it
	thats_false := false

	smallest_int: i8
	biggest_int: i128

	smallest_uint: u8
	biggest_uint: u128

	smallest_float: f16
	biggest_float: f64

	untyped_memory: byte
	string_byte: utf8

	array_of_numbers: [64]i32 // value, holds its own data
	slice: []i32 // reference, points to someone else's data

	partial_array: [..64]i32 // an array that's also a slice
}

control_flow :: fun() {
	water_temperature := 101

	// Braces go around the entire block
	if water_temperature > 100 {
		print("It's steam!")
	elif water_temperature == 100
		print("It's bubbly!")

	// high value excluded, so this checks from 0 to 99
	elif water_temperature in 0..100
		print("It's probably hot")
	else
		print("It's cold!")
	}
}