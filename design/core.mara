module core

// BIG IDEAS
// everything is a scope
// program graph analyzer
// the graph has to map back to source code to change it
// Everything the compiler knows is reachable from the graph, and every graph node knows its source spans. An analysis result that dies with its pass is a bug.

// SMALL IDEAS
// checked generics

// constructor is a dispatch group
// type, value, and cast
int :: struct(n: cint = 64) {
	val : [n]bit
}

float :: struct(mantissa: cint, exponent: cint) {
	val: [mantissa + exponent + 1]bit
} 

 i8 :: int(8)
i16 :: int(16)
i32 :: int(32)
i64 :: int(64)

f32 :: distinct float(23, 8)
f64 :: distinct float(52, 11)

bool :: distinct bit
true  :: bool(1)
false :: bool(0)

// consider inlining these
and :: fun(a: bool, b: bool) -> bool {
    if a is true return b
    return false 
}

or  :: fun(a: bool, b: bool) -> bool {
	if a is true return true
	return b  
}
not :: fun(a: bool) -> bool {
	if a is true return false
	else return true
}

Array :: struct(item: $T, n: i64 = 256) {
	cap : i64 = n
	len : i64 = 0
	using items: [n]item
}

main :: fun {
	a := 33
	b := 63
	result := a + b
}