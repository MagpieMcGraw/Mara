module rejector

use mara.math

five_deep :: fun(storage: ^[]byte) -> []Vec3 {
	my_vec := let([5]Vec3, storage)
	return my_vec[:]
}

seven_deep :: fun(storage: ^[]byte) -> []Vec3 {
	my_vec := let([7]Vec3, storage)
	return my_vec[:]
}

shallow :: fun(storage: ^[]byte) -> []Vec3 {
	buf: [..1024]byte
	five_vecs := five_deep(&buf)
	seven_vecs := seven_deep(storage)
	return seven_vecs
}

main :: fun() {
	storage: [..1024]byte
	some_vecs := shallow(&storage)
}