module camera

use mara.memory
use mara.math
use mara.sdl

use event
use object

Camera :: struct(w, h, fovy : f32) {
	obj := Object {
		speed = 50
		turn_speed = 0.2
		pos = Vec3{0, 0, 512}
	}
	proj, ortho, view : Mat4
	w_width, w_height := w, h
	fov_y := to_radians(fovy)
	fov_x := fov_y * w_width / w_height
	near_plane : f32 = 0.1
	far_plane  : f32 = 50000

	proj, ortho, view = view_and_projections(#self)

	view_and_projections :: fun(cam: ^Self) -> Mat4, Mat4, Mat4 {
		w, h := cam.w_width, cam.w_height
		proj := mat4_perspective(cam.fov_y, w/h, cam.near_plane, cam.far_plane)
		half_w := w / 2
		half_h := h / 2
		ortho := mat4_ortho(-half_w, half_w, -half_h, half_h, -1, 1)
		t := mat4_translate(cam.obj.pos)
		r := mat4_from_quat(cam.obj.dir)
		view := r * t

		return proj, ortho, view
	}
}

camera_look_down :: fun(camera: ^Camera) {
	camera.obj.dir *= quat_angle_axis(
	to_radians(180), Vec3{0, 1, 0})
}

camera_align_with_gravity :: fun(camera: ^Camera) {
	camera.obj.dir = quat_from_fwd_and_up({0, 1, 0}, {0, 0, 1})
}

camera_move :: fun(events: ^Event_State, loop_time: f32, camera: ^Camera) {
	direction: Vec3
	speed: f32 = 500

	fwd, up, right := obj_get_directions(camera.obj.dir)

	if events.keyboard.held[sdl.Scancode.W] {
		direction += fwd
	}
	if events.keyboard.held[sdl.Scancode.S] {
		direction -= fwd
	}
	if events.keyboard.held[sdl.Scancode.A] {
		direction -= right
	}
	if events.keyboard.held[sdl.Scancode.D] {
		direction += right
	}
	if events.keyboard.held[sdl.Scancode.Q] {
		direction += up
	}
	if events.keyboard.held[sdl.Scancode.Z] {
		direction -= up
	}

	if events.keyboard.held[sdl.Scancode.LShift] {
		speed *= 0.2
	}

	if events.keyboard.held[sdl.Scancode.LCtrl] {
		speed *= 5.0
	}

	move_this_frame := direction * speed * loop_time
	camera.obj.accel += move_this_frame
}

camera_turn_flying :: fun(xrel, yrel, zrel: i32, loop_time: f32, camera: ^Camera) {
	sensitivity: f32 = 0.005
	turn_speed: f32 = 0.5  // Faster turn speed for direct mode
	x_rot := turn_speed * f32(xrel) * sensitivity
	y_rot := turn_speed * f32(yrel) * sensitivity
	z_rot := turn_speed * f32(zrel) * 5 * sensitivity

	// Get camera's local axes
	camera_fwd, camera_up, camera_right := obj_get_directions(camera.obj.dir)

	// Directly apply rotation (no momentum)
	yaw_quat := quat_angle_axis(x_rot, camera_up)
	camera.obj.dir = yaw_quat * camera.obj.dir

	// Recalculate after yaw
	camera_fwd, camera_up, camera_right = obj_get_directions(camera.obj.dir)

	pitch_quat := quat_angle_axis(y_rot, camera_right)
	camera.obj.dir = pitch_quat * camera.obj.dir

	// Roll
	if z_rot != 0 {
		camera_fwd, _, _ = obj_get_directions(camera.obj.dir)
		roll_quat := quat_angle_axis(z_rot, camera_fwd)
		camera.obj.dir = roll_quat * camera.obj.dir
	}
}

// Walking camera - constrained to ground-based movement
// Yaw always around world up, no roll, maintains upright orientation
camera_turn_walking :: fun(xrel, yrel, zrel: i32, loop_time: f32, camera: ^Camera) {
	if xrel == 0 and yrel == 0 do return

	sensitivity: f32 = 0.01
	x_rot := camera.obj.turn_speed * f32(xrel) * sensitivity
	y_rot := camera.obj.turn_speed * f32(yrel) * sensitivity

	// World up axis for yaw (always stays upright)
	world_up := Vec3{0, 0, 1}

	// Yaw around world up (horizontal turning, unaffected by pitch)
	if xrel != 0 {
		yaw_quat := quat_angle_axis(x_rot, world_up)
		camera.obj.dir = yaw_quat * camera.obj.dir
	}

	// Pitch around camera's local right axis (look up/down)
	if yrel != 0 {
		_, _, camera_right := obj_get_directions(camera.obj.dir)
		pitch_quat := quat_angle_axis(y_rot, camera_right)
		camera.obj.dir = pitch_quat * camera.obj.dir
	}
}

camera_update :: fun(camera: ^Camera, loop_time: f32) {
	physics_resolution: f32 = 0.001
	physics_this_frame := loop_time / physics_resolution

	damping_factor: f32 = 0.99
	camera.obj.accel *= math.pow(damping_factor, physics_this_frame)
	camera.obj.pos += (camera.obj.accel * loop_time)

	translation_mx := mat4_translate(-camera.obj.pos)
	rotation_mx := mat4_transpose(mat4_from_quat(camera.obj.dir))
	camera.view = rotation_mx * translation_mx
}

camera_update_size :: fun(camera: ^Camera, w_width, w_height: f32) {
	if w_width == camera.w_width and w_height == camera.w_height {
		return
	}

	camera.w_width = w_width
	camera.w_height = w_height

	aspect_ratio := w_width / w_height
	camera.fov_x = camera.fov_y * aspect_ratio

	camera.proj = mat4_perspective(camera.fov_y, aspect_ratio, camera.near_plane, camera.far_plane)

	// Update orthographic projection for 2D rendering
	half_w := w_width / 2
	half_h := w_height / 2
	camera.ortho = mat4_ortho(-half_w, half_w, -half_h, half_h, -1, 1)
}

// Project world position to screen pixels (origin at center, +x right, +y up)
// Returns screen x, y in pixels from center, and ok=false if behind camera
world_to_screen :: fun(world_pos: Vec3, camera: ^Camera) -> (x, y: f32, ok: bool) {
	// Transform to clip space
	pos4 := Vec4{world_pos.x, world_pos.y, world_pos.z, 1}
	view_pos := camera.view * pos4
	clip_pos := camera.proj * view_pos

	// Check if behind camera (w <= 0 means behind or at camera plane)
	if clip_pos.w <= 0 {
		return 0, 0, false
	}

	// Perspective divide to NDC (-1 to 1)
	ndc_x := clip_pos.x / clip_pos.w
	ndc_y := clip_pos.y / clip_pos.w

	// Convert to pixels from center
	x = ndc_x * camera.w_width / 2
	y = ndc_y * camera.w_height / 2

	return x, y, true
}

mouse_ray :: fun(mouse_x, mouse_y: i32, camera: ^Camera) -> Vec3 {
	// mouse x and y needs to be in the range of 1 to -1
	x := (2 * f32(mouse_x)) / f32(camera.w_width) - 1
	y := 1 - (2 * f32(mouse_y)) / f32(camera.w_height)

	// create mouse ray, apply inverse projection
	mouse := Vec4{x, y, 0, 0}
	inv_projection := mat4_inverse(camera.proj)
	unprojected := inv_projection * mouse

	// we have to write 1, 0 into the mouse ray
	adjusted := Vec4{unprojected.x, unprojected.y, 1, 0}

	// apply inverted view matrix to mouse ray
	inv_view := mat4_inverse(camera.view)
	ray := normalize(inv_view * adjusted)

	return Vec3{ray.x, ray.y, ray.z}
}