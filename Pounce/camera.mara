module camera

use mara.memory
use mara.math

use object

Camera :: struct(w, h, fovy : f32) {
	obj := Object {
		speed = 50
		turn_speed = 0.2
		pos = Vec3{0, 0, 512}
	}
	proj, ortho, view : Mat4
	w_width, w_height := w, h
	fov_y := to_radians(fovy)
	fov_x := fov_y * w_width / w_height
	near_plane : f32 = 0.1
	far_plane  : f32 = 50000

	proj, ortho, view = view_and_projections(#self)

	view_and_projections :: fun(cam: ^Self) -> Mat4, Mat4, Mat4 {
		w, h := cam.w_width, cam.w_height
		proj := mat4_perspective(cam.fov_y, w/h, cam.near_plane, cam.far_plane)
		half_w := w / 2
		half_h := h / 2
		ortho := mat4_ortho(-half_w, half_w, -half_h, half_h, -1, 1)
		t := mat4_translate(cam.obj.pos)
		r := mat4_from_quaternion(cam.obj.dir)
		view := r * t

		return proj, ortho, view
	}
}

