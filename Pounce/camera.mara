mouse_ray :: fun(mouse_x, mouse_y: i32, camera: ^Camera) -> Vec3 {
	// mouse x and y needs to be in the range of 1 to -1
	x := (2 * f32(mouse_x)) / f32(camera.w_width) - 1
	y := 1 - (2 * f32(mouse_y)) / f32(camera.w_height)

	// create mouse ray, apply inverse projection
	mouse := Vec4{x, y, 0, 0}
	inv_projection := mat4_inverse(camera.proj)
	unprojected := inv_projection * mouse

	// we have to write 1, 0 into the mouse ray
	adjusted := Vec4{unprojected.x, unprojected.y, 1, 0}

	// apply inverted view matrix to mouse ray
	inv_view := mat4_inverse(camera.view)
	ray := normalize(inv_view * adjusted)

	return Vec3{ray.x, ray.y, ray.z}
}