
module gfx.shader

use mara.os
use mara.string
use mara.memory
gl :: use mara.open_gl

Shader_Error :: error {
    Bad_Text
    Failed_Compilation
    Failed_Link
}

load_and_compile :: fun(filepath: cstring) -> u32, u32, err {
	data: [..32 * KB]byte
	os.read_entire_file(filepath, &data)?

	text : []utf8 = data[:]
	VERSION_TAG :: "#version"
	vs_tag, vs_found := text.find(VERSION_TAG)
	if not vs_found do return 0, 0, Bad_Text

	next := vs_tag + VERSION_TAG.len
	fs_tag, fs_found := text.find(VERSION_TAG, next)
	if not fs_found do return 0, 0, Bad_Text

	vtext := text[:fs_tag]
	ftext := text[fs_tag:]

	compile :: fun(text: ^[]utf8, shader_type: u32) -> u32, err {
		shader := gl.CreateShader(shader_type)
		slen : i32 = i32(text.len)
		gl.ShaderSource(shader, 1, &text.ptr, &slen)
		gl.CompileShader(shader)

		status : i32
		gl.GetShaderiv(shader, gl.COMPILE_STATUS, &status)
		if status == 0 {
			gl.DeleteShader(shader)
			return 0, Failed_Compilation
		}
		return shader
	}
	vshader := compile(&vtext, gl.VERTEX_SHADER)?
	fshader := compile(&ftext, gl.FRAGMENT_SHADER)?
	return vshader, fshader
}

make_program :: fun(filepath: cstring) -> u32, err {
	vshader, fshader := load_and_compile(filepath)?

	program := gl.CreateProgram()
	gl.AttachShader(program, vshader)
	gl.AttachShader(program, fshader)
	gl.LinkProgram(program)

	status: i32
	gl.GetProgramiv(program, gl.LINK_STATUS, &status)
	if status == 0 {
		gl.DeleteProgram(program)
		gl.DeleteShader(vshader)
		gl.DeleteShader(fshader)
		return 0, Failed_Link
	}

	gl.DetachShader(program, vshader)
	gl.DetachShader(program, fshader)

	return program
}
