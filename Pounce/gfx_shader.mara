module gfx.shader

use mara.os
use mara.string

shader_load_text :: fun(filepath: cstr) -> vtext, ftext: [16 * KB]utf8 {
	data: [..32 * KB]byte
	read_ok := os.read_entire_file(filepath, &data)
	as_str : []utf8 = data[:]

	// Split shader file at second occurence of #version
	VERSION_TAG :: "#version"
	vs_tag, vs_found := string.find(VERSION_TAG, as_str)

	next := vs_tag + VERSION_TAG.len
	fs_tag, fs_found := string.find(VERSION_TAG, as_str, vs_tag)

	// because these are fixed arrays, they copy data from the slice
	vtext = as_str[0:fs_tag]
	ftext = as_str[fs_tag:]

	return vtext, ftext
}

