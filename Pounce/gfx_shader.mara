module gfx.shader

use mara.core
use mara.files
use mara.paths
use mara.string
use mara.memory
gl :: use mara.open_gl

Shader_Error :: error {
    Bad_Text
    Failed_Compilation
    Failed_Link
}

VERSION_TAG :: "#version"
INCLUDE_TAG :: "#include "

// Expands #include lines into out; returns where the fragment shader starts.
expand :: fun(out: ^[]utf8, text: []utf8, filepath: []utf8) -> i64, err {
	fragment_at : i64 = 0
	versions : i64 = 0
	line : i64 = 1
	at : i64 = 0
	for at < text.len {
		stop := line_end(text, at)
		this := text[at:stop]
		renumber := false
		if this.starts_with(INCLUDE_TAG) {
			name := trimmed(this[INCLUDE_TAG.len:.len])
			if name.len == 0 do return 0, Bad_Text
			path := get_dir(filepath)
			&path ++ name
			bytes : [32 * KB]byte = void
			_, unread := read_entire_file(path, &bytes)
			if unread {
				print(filepath, "includes", path, "which can't be read")
				return 0, unread
			}
			included : []utf8 = bytes
			out ++ included ++ "\n"
			renumber = true
		else
			if this.starts_with(VERSION_TAG) {
				versions += 1
				if versions == 2 do fragment_at = out.len
				renumber = true
			}
			out ++ this ++ "\n"
		}
		// So GL reports the file's own line numbers
		if renumber do out ++ "#line " ++ int_text(line + 1) ++ "\n"
		line += 1
		at = stop + 1
	}
	if versions != 2 do return 0, Bad_Text
	return fragment_at
}

// Compiles a file's vertex and fragment shaders; GL's messages are printed.
load_and_compile :: fun(filepath: []utf8) -> u32, u32, err {
	data: [32 * KB]byte = void
	read_entire_file(filepath, &data)?

	raw : []utf8 = data
	text : [128 * KB]utf8
	fragment_at := expand(&text, raw, filepath)?

	compile :: fun(name: []utf8, text: []utf8,
		shader_type: gl.Shader_Type) -> u32, err
	{
		shader := gl.CreateShader(shader_type)
		source := text.ptr
		n := i32(text.len)
		gl.ShaderSource(shader, 1, &source, &n)
		gl.CompileShader(shader)

		status : i32
		gl.GetShaderiv(shader, gl.COMPILE_STATUS, &status)

		log : [2048]utf8
		got : i32 = 0
		log.len = log.cap   // room for GL to fill
		gl.GetShaderInfoLog(shader, i32(log.cap), &got, &log[0])
		log.len = i64(got)
		if log.len > 0 {
			print(name, shader_type, "says:")
			print(log)
		}

		if status == 0 {
			gl.DeleteShader(shader)
			return 0, Failed_Compilation
		}
		return shader
	}
	vshader := compile(filepath, text[:fragment_at], gl.VERTEX_SHADER)?
	fshader, ferr := compile(filepath, text[fragment_at:.len],
		gl.FRAGMENT_SHADER)
	if ferr {gl.DeleteShader(vshader) return 0, 0, ferr}
	return vshader, fshader
}

make_program :: fun(filepath: []utf8) -> u32, err {
	vshader, fshader, e := load_and_compile(filepath)
	defer gl.DeleteShader(vshader)
	defer gl.DeleteShader(fshader)
	if bool(e) do return 0, e

	program := gl.CreateProgram()
	gl.AttachShader(program, vshader)
	gl.AttachShader(program, fshader)

	gl.LinkProgram(program)

	status: i32
	gl.GetProgramiv(program, gl.LINK_STATUS, &status)

	log : [1024]utf8
	got : i32 = 0
	log.len = log.cap   // room for GL to fill
	gl.GetProgramInfoLog(program, i32(log.cap), &got, &log[0])
	log.len = i64(got)
	if log.len > 0 {
		print(filepath, "linking says:")
		print(log)
	}

	if status == 0 {
		gl.DeleteProgram(program)
		return 0, Failed_Link
	}
	gl.DetachShader(program, vshader)
	gl.DetachShader(program, fshader)

	return program
}
