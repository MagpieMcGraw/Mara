module gfx.shader

use mara.os
use mara.string
gl :: use mara.open_gl

load_and_compile :: fun(filepath: cstr) -> u32, u32 {
	data: [..32 * KB]byte
	read_ok := os.read_entire_file(filepath, &data)
	text : []utf8 = data[:]

	// Split shader file at second occurence of #version
	VERSION_TAG :: "#version"
	vs_tag, vs_found := text.find(VERSION_TAG)

	next := vs_tag + VERSION_TAG.len
	fs_tag, fs_found := text.find(VERSION_TAG, next)

	// because these are fixed arrays, they copy data from the slice
	vtext := text[0:fs_tag]
	ftext := text[fs_tag:]

	vshader := gl.CreateShader(gl.VERTEX_SHADER)
	fshader := gl.CreateShader(gl.FRAGMENT_SHADER)

	gl.ShaderSource(vshader, 1, &vtext.ptr, &vtext.len)
	gl.ShaderSource(fshader, 1, &ftext.ptr, &ftext.len)

	gl.CompileShader(vshader)
	gl.CompileShader(fshader)

	// Check compilation status
	vstatus fstatus: i32
	gl.GetShaderiv(shader, gl.COMPILE_STATUS, &success)

	// Always check for logs
	log_buff: [512]u8
	log_length: i32
	gl.GetShaderInfoLog(shader, 512, &log_length, &log_buff[0])

	if success == 0 {
		gl.DeleteShader(shader)
	}

	return vshader, fshader
}

make_program :: fun(filepath: cstr) -> u32 {
	vshader, fshader := load_and_compile(filepath)

	program := gl.CreateProgram()
	gl.AttachShader(program, vshader)
	gl.AttachShader(program, fshader)
	gl.LinkProgram(program)

	success: i32
	gl.GetProgramiv(program, gl.LINK_STATUS, &success)

	log: [..1024]utf8
	gl.GetProgramInfoLog(program, log.cap, &log.len, &log[0])

	if success == 0 do gl.DeleteProgram(program)

	gl.DetachShader(program, vshader)
	gl.DetachShader(program, fshader)

	return program
}