module cache

// Asset cache — streaming rewrite of the old Odin cache_v3.
//
// Job: at BUILD time pre-decode every asset once (PNG -> raw pixels, GLB -> raw
// verts/inds) and pack them into a flat .bin per asset type; at RUNTIME open that
// .bin and STREAM assets out a few per frame (seek to one entry, read just its
// payload) instead of slurping the whole file or re-decoding the source folders.
//
// This keeps cache_v3's STREAMING function — open once, read assets on demand by
// index — but improves the architecture two ways:
//   * ONE Cache_Entry (generic `meta` slot) and ONE `Cache` runtime handle,
//     instead of cache_v3's five near-identical entry structs + five
//     struct-of-arrays TOCs + five copies of every operation. Each asset type is
//     just "open a different .bin and stream it."
//   * The TOC is read on demand (one ~100-byte entry when that asset is streamed)
//     rather than held resident in parallel arrays — the runtime asset tables
//     (Assets.textures/.meshes) own name lookup, so the whole TOC never needs to
//     sit in RAM. cache_v3 loaded all five TOCs up front; this loads none.
//
// File layout (written by the savers below, unchanged from the seek-free build):
//   [Cache_Header] [Cache_Entry * count] [payload bytes, concatenated]
// data_offset is absolute from the start of the file, so a streaming read is a
// single seek + read.
//
// Validation is magic + version only, same level as cache_v3.

use mara.core   // str64, utf8, the `+` append overload
use mara.os     // file_open_read/write, file_seek, file_read, file_write, file_close
use gfx         // Vertex, Mesh_Data

CACHE_MAGIC   :: u32(0x68636143)  // "Cach" little-endian
CACHE_VERSION :: u32(1)

Cache_Error :: error {
    Bad_Header   // magic/version mismatch or a too-short file -> caller rebuilds from source
}

// File layout:  [Cache_Header] [Cache_Entry * count] [payload bytes, concatenated]
Cache_Header :: struct {
    magic:   u32
    version: u32
    count:   u32
    _pad:    u32
}

// One entry per asset. `meta` is the asset-specific slot:
//   textures: meta[0]=width  meta[1]=height
//   meshes:   meta[0]=vertex_count  meta[1]=index_count
// data_offset is absolute from the start of the file, so reading a payload needs
// nothing but the entry itself.
Cache_Entry :: struct {
    name:        [64]utf8
    name_len:    u32
    meta:        [4]u32
    data_offset: u64
    data_size:   u64
}

HEADER_SIZE :: size_of(Cache_Header)
ENTRY_SIZE  :: size_of(Cache_Entry)

// Build-time inputs. The runtime object.Texture/object.Mesh don't carry pixel or
// vertex bytes (those live on the GPU), so saving needs its own carriers.
Tex_Blob :: struct {
    name:   str64
    w, h:   i32
    pixels: []byte
}

Mesh_Blob :: struct {
    name: str64
    mesh: Mesh_Data
}

// Size the header+TOC scratch buffer the savers need.
cache_toc_bytes :: fun(count: i64) -> i64 {
    return HEADER_SIZE + count * ENTRY_SIZE
}

// ---------------------------------------------------------------------------
// Name <-> entry helpers
// ---------------------------------------------------------------------------

entry_set_name :: fun(e: ^Cache_Entry, name: str64) {
    n := name.len
    if n > 64 do n = 64
    for i in 0..n {
        e.name[i] = name[i]
    }
    e.name_len = u32(n)
}

// Reconstruct the entry's name as a str64.
entry_name :: fun(e: ^Cache_Entry) -> str64 {
    out : str64
    for i in 0..i64(e.name_len) {
        &out + e.name[i]
    }
    return out
}

// Writes the header into `toc` and returns the absolute offset where payloads
// begin (also the number of header+TOC bytes to write).
cache_put_header :: fun(toc: ^[]byte, count: i64) -> i64 {
    h : Cache_Header = {
        magic   = CACHE_MAGIC,
        version = CACHE_VERSION,
        count   = u32(count),
        _pad    = 0,
    }
    toc[0] = h
    return HEADER_SIZE + count * ENTRY_SIZE
}

// ---------------------------------------------------------------------------
// Write (build step) — header+TOC built in `toc` (typed blits), payloads after.
// ---------------------------------------------------------------------------

// `toc` must hold cache_toc_bytes(blobs.len). Texture pixels are written
// straight from the blobs — no staging copy.
cache_save_textures :: fun(path: []utf8, blobs: []Tex_Blob, toc: ^[]byte) -> err {
    count := blobs.len
    off := cache_put_header(toc, count)   // absolute payload start

    for i in 0..count {
        b := blobs[i]
        e : Cache_Entry
        entry_set_name(&e, b.name)
        e.meta[0] = u32(b.w)
        e.meta[1] = u32(b.h)
        e.data_offset = u64(off)
        e.data_size = u64(b.pixels.len)
        toc[HEADER_SIZE + i * ENTRY_SIZE] = e
        off += b.pixels.len
    }

    id := file_open_write(path)?
    defer file_close(id)

    head := toc[0 : cache_toc_bytes(count)]
    _ = file_write(id, &head)?
    for i in 0..count {
        px := blobs[i].pixels
        _ = file_write(id, &px)?
    }
}

// `toc` holds header+TOC; `data` stages the concatenated vertex/index bytes
// (no []T -> []byte view exists outside mara.os, so each value is blitted in).
// `data` must hold the summed payload bytes.
cache_save_meshes :: fun(path: []utf8, blobs: []Mesh_Blob, toc: ^[]byte, data: ^[]byte) -> err {
    count := blobs.len
    base := cache_put_header(toc, count)   // absolute payload start
    dcur : i64 = 0                         // cursor within `data`

    for i in 0..count {
        b := blobs[i]
        vcount := b.mesh.vertices.len
        icount := b.mesh.indices.len
        vbytes := vcount * size_of(Vertex)
        ibytes := icount * size_of(u32)

        e : Cache_Entry
        entry_set_name(&e, b.name)
        e.meta[0] = u32(vcount)
        e.meta[1] = u32(icount)
        e.data_offset = u64(base + dcur)
        e.data_size = u64(vbytes + ibytes)
        toc[HEADER_SIZE + i * ENTRY_SIZE] = e

        for v in 0..vcount {
            data[dcur + v * size_of(Vertex)] = b.mesh.vertices[v]
        }
        ioff := dcur + vbytes
        for k in 0..icount {
            data[ioff + k * size_of(u32)] = b.mesh.indices[k]
        }
        dcur += vbytes + ibytes
    }

    id := file_open_write(path)?
    defer file_close(id)

    head := toc[0 : cache_toc_bytes(count)]
    _ = file_write(id, &head)?
    payload := data[0 : dcur]
    _ = file_write(id, &payload)?
}

// ---------------------------------------------------------------------------
// Read (runtime) — open once, stream assets by index.
//
//   c : Cache
//   cache_open(&c, path)?               // header read + validated, handle left open
//   for i in 0..c.count {
//       e := cache_entry(&c, i)?        // one TOC entry (name, w/h or counts, size)
//       cache_read(&c, e, &dst)?                    // fill dst with a texture's pixels, or
//       cache_read_mesh(&c, e, &scratch, &verts, &inds)?   // fill verts/inds with a mesh
//   }
//   cache_close(&c)
//
// The read functions return err only and fill a caller-owned buffer rather than
// returning a slice: a slice bound from a multi-value return (`px, e := f()`)
// isn't usable yet (the codegen tracks it as neither array nor slice). The caller
// owns the destination and already holds the entry, so it knows the size.
// ---------------------------------------------------------------------------

// A streaming handle: an open cache file plus its entry count. The TOC is read on
// demand (cache_entry), so this stays tiny — embed one per asset type.
Cache :: struct {
    file:    os.File_Id
    is_open: bool
    count:   i64
}

// Open a cache .bin, validate its header, leave the handle open for streaming.
// Any error (missing file, bad magic/version) means "no usable cache" — the
// caller rebuilds from the source folders. On error the handle is closed.
cache_open :: fun(c: ^Cache, path: []utf8) -> err {
    c.is_open = false
    c.count = 0

    id := file_open_read(path)?

    hbuf : [HEADER_SIZE]byte = void
    head := hbuf[0 : HEADER_SIZE]
    rerr := file_read(id, &head)
    if bool(rerr) or head.len < HEADER_SIZE {
        file_close(id)
        return Bad_Header
    }
    h : Cache_Header = head[0]
    if h.magic != CACHE_MAGIC or h.version != CACHE_VERSION {
        file_close(id)
        return Bad_Header
    }

    c.file = id
    c.is_open = true
    c.count = i64(h.count)
}

cache_close :: fun(c: ^Cache) {
    if c.is_open {
        file_close(c.file)
        c.is_open = false
    }
}

// Read one TOC entry by index: the asset's name + meta (w/h or vert/index counts)
// + where its payload lives. Cheap (one ~100-byte read) — call it to learn an
// asset's shape before sizing the buffer cache_read fills.
cache_entry :: fun(c: ^Cache, index: i64) -> Cache_Entry, err {
    file_seek(c.file, HEADER_SIZE + index * ENTRY_SIZE, SEEK_SET)?
    ebuf : [ENTRY_SIZE]byte = void
    es := ebuf[0 : ENTRY_SIZE]
    file_read(c.file, &es)?
    e : Cache_Entry = es[0]
    return e
}

// Stream an entry's raw payload into `dst`'s backing (texture pixels). `dst` must
// have capacity for e.data_size bytes; that many land at dst[0:]. One seek + one
// read — `dst[0:size]` has len = cap = size, so file_read reads exactly this entry
// and never spills into the next. The caller holds the entry, so it knows the size.
cache_read :: fun(c: ^Cache, e: Cache_Entry, dst: ^[]byte) -> err {
    size := i64(e.data_size)
    file_seek(c.file, i64(e.data_offset), SEEK_SET)?
    buf := dst[0 : size]
    file_read(c.file, &buf)?
}

// Stream a mesh entry: read its payload into `scratch`, then reinterpret the bytes
// into the caller's verts/inds backing (vao_add_mesh wants real []Vertex / []u32,
// and those outlive any file buffer). `scratch` must hold e.data_size bytes; the
// counts are e.meta[0]/[1]. Caller builds Mesh_Data{verts[0:vc], inds[0:ic]}.
cache_read_mesh :: fun(c: ^Cache, e: Cache_Entry, scratch: ^[]byte, verts: ^[]Vertex, inds: ^[]u32) -> err {
    vcount := i64(e.meta[0])
    icount := i64(e.meta[1])
    size := i64(e.data_size)

    file_seek(c.file, i64(e.data_offset), SEEK_SET)?
    buf := scratch[0 : size]
    file_read(c.file, &buf)?

    for v in 0..vcount {
        vert : Vertex = buf[v * size_of(Vertex)]
        verts[v] = vert
    }
    ioff := vcount * size_of(Vertex)
    for k in 0..icount {
        ix : u32 = buf[ioff + k * size_of(u32)]
        inds[k] = ix
    }
}
