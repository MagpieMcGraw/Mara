module cache

// Asset cache: a .bin per asset type, built once, streamed by index.

use mara.core
use mara.files
use gfx

CACHE_MAGIC   :: u32(0x68636143)  // "Cach" little-endian
CACHE_VERSION :: u32(1)

Cache_Error :: error {
    Bad_Header   // wrong magic or version, or a file cut short
}

// File layout: [Cache_Header] [Cache_Entry * count] [payload bytes]
Cache_Header :: struct {
    magic:   u32
    version: u32
    count:   u32
    _pad:    u32
}

// meta: a texture's width, height; a mesh's vertex count, index count
Cache_Entry :: struct {
    name:        [64!]utf8
    name_len:    u32
    meta:        [4!]u32
    data_offset: u64   // from the file's start
    data_size:   u64
}

HEADER_SIZE :: size_of(Cache_Header)
ENTRY_SIZE  :: size_of(Cache_Entry)

// Build-time inputs: the bytes the runtime Texture and Mesh don't carry.
Tex_Blob :: struct {
    name:   str64
    w, h:   i32
    pixels: []byte
}

Mesh_Blob :: struct {
    name: str64
    mesh: Mesh_Data
}

// The bytes of a header and count entries: the room the savers' toc needs.
cache_toc_bytes :: fun(count: i64) -> i64 {
    return HEADER_SIZE + count * ENTRY_SIZE
}

entry_set_name :: fun(e: ^Cache_Entry, name: str64) {
    n := name.len
    if n > 64 do n = 64
    for i in 0:n {
        e.name[i] = name[i]
    }
    e.name_len = u32(n)
}

entry_name :: fun(e: ^Cache_Entry) -> str64 {
    out : str64
    for i in 0:i64(e.name_len) {
        &out ++ e.name[i]
    }
    return out
}

// Returns the offset where payloads begin.
cache_put_header :: fun(toc: ^[]byte, count: i64) -> i64 {
    h : Cache_Header = {
        magic   = CACHE_MAGIC,
        version = CACHE_VERSION,
        count   = u32(count),
        _pad    = 0,
    }
    toc[0] = h
    return HEADER_SIZE + count * ENTRY_SIZE
}

// toc must hold cache_toc_bytes(blobs.len).
cache_save_textures :: fun(path: []utf8,
    blobs: []Tex_Blob, toc: ^[]byte) -> err
{
    count := blobs.len
    toc.len = cache_toc_bytes(count)
    off := cache_put_header(toc, count)

    for i in 0:count {
        b := blobs[i]
        e : Cache_Entry
        entry_set_name(&e, b.name)
        e.meta[0] = u32(b.w)
        e.meta[1] = u32(b.h)
        e.data_offset = u64(off)
        e.data_size = u64(b.pixels.len)
        toc[HEADER_SIZE + i * ENTRY_SIZE] = e
        off += b.pixels.len
    }

    id := file_open_write(path)?
    defer file_close(id)

    file_write_text(id, toc[:])?
    for i in 0:count {
        px := blobs[i].pixels
        file_write_text(id, px)?
    }
}

// data must hold every mesh's vertex and index bytes: they're staged there.
cache_save_meshes :: fun(path: []utf8,
    blobs: []Mesh_Blob, toc: ^[]byte, data: ^[]byte) -> err
{
    count := blobs.len
    toc.len = cache_toc_bytes(count)
    base := cache_put_header(toc, count)
    dcur : i64 = 0   // cursor within data
    data.len = data.cap

    for i in 0:count {
        b := blobs[i]
        vcount := b.mesh.vertices.len
        icount := b.mesh.indices.len
        vbytes := vcount * size_of(Vertex)
        ibytes := icount * size_of(u32)

        e : Cache_Entry
        entry_set_name(&e, b.name)
        e.meta[0] = u32(vcount)
        e.meta[1] = u32(icount)
        e.data_offset = u64(base + dcur)
        e.data_size = u64(vbytes + ibytes)
        toc[HEADER_SIZE + i * ENTRY_SIZE] = e

        data[dcur : dcur + vbytes] = b.mesh.vertices
        ioff := dcur + vbytes
        data[ioff : ioff + ibytes] = b.mesh.indices
        dcur += vbytes + ibytes
    }
    data.len = dcur

    id := file_open_write(path)?
    defer file_close(id)

    file_write_text(id, toc[:])?
    file_write_text(id, data[:])?
}

// Reading: cache_open, then cache_entry + cache_read per index, cache_close.

// An open cache file and its entry count; entries are read on demand.
Cache :: struct {
    file:    File_Id
    is_open: bool
    count:   i64
}

// On any error there's no usable cache: rebuild it from the source files.
cache_open :: fun(c: ^Cache, path: []utf8) -> err {
    c.is_open = false
    c.count = 0

    id := file_open_read(path)?

    hbuf : [HEADER_SIZE!]byte = void
    head := hbuf[0 : HEADER_SIZE]
    rerr := file_read(id, &head)
    if bool(rerr) or head.len < HEADER_SIZE {
        file_close(id)
        return Bad_Header
    }
    h : Cache_Header = head[0]
    if h.magic != CACHE_MAGIC or h.version != CACHE_VERSION {
        file_close(id)
        return Bad_Header
    }

    c.file = id
    c.is_open = true
    c.count = i64(h.count)
}

cache_close :: fun(c: ^Cache) {
    if c.is_open {
        file_close(c.file)
        c.is_open = false
    }
}

// One entry by index: its name, meta, and where its payload is.
cache_entry :: fun(c: ^Cache, index: i64) -> Cache_Entry, err {
    file_seek(c.file, HEADER_SIZE + index * ENTRY_SIZE, SEEK_SET)?
    ebuf : [ENTRY_SIZE!]byte = void
    es := ebuf[0 : ENTRY_SIZE]
    file_read(c.file, &es)?
    e : Cache_Entry = es[0]
    return e
}

// Fills dst with e's payload (e.data_size bytes) and returns a view of it.
cache_read :: fun(c: ^Cache, e: Cache_Entry, dst: ^[]byte) -> []byte, err {
    size := i64(e.data_size)
    file_seek(c.file, i64(e.data_offset), SEEK_SET)?
    dst.len = size
    buf := dst[0 : size]
    file_read(c.file, &buf)?
    return buf
}

// Fills verts and inds from a mesh entry; scratch must hold e.data_size bytes.
cache_read_mesh :: fun(c: ^Cache, e: Cache_Entry, scratch: ^[]byte,
    verts: ^[]Vertex, inds: ^[]u32) -> Mesh_Data, err
{
    vcount := i64(e.meta[0])
    icount := i64(e.meta[1])
    size := i64(e.data_size)
    vbytes := vcount * size_of(Vertex)
    if size != vbytes + icount * size_of(u32) {
        return Mesh_Data{all 0}, Bad_Header
    }

    file_seek(c.file, i64(e.data_offset), SEEK_SET)?
    scratch.len = size
    verts.len = vcount
    inds.len = icount
    buf := scratch[0 : size]
    file_read(c.file, &buf)?
    if buf.len != size do return Mesh_Data{all 0}, Bad_Header

    verts[0 : vcount] = buf[0 : vbytes]
    inds[0 : icount] = buf[vbytes : size]

    return Mesh_Data{ verts[0:vcount], inds[0:icount] }
}
