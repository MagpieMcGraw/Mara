module perf

use mara.string
use mara.time

MAX_PERF_PHASES :: 16

// we assume there's no gaps between phases 
Performance_Timer :: struct {
    names: [MAX_PERF_PHASES]String
    times: [MAX_PERF_PHASES]f64
    count: i64
    phase_start: u64
    total_start: u64
}

// Call once at the start of a timing session with the first phase name.
perf_timer_begin :: fun(
	first_phase: [:, 0]utf8) -> Performance_Timer
{
	timer: Performance_Timer
    timer.count = 0
    timer.total_start = time_now()
    timer.phase_start = timer.total_start
    timer.names[0].len = 0
    &timer.names[0] + first_phase
    return timer
}

// End the current phase, record its time, and start timing next_phase.
perf_timer_mark :: fun(timer: ^Performance_Timer, next_phase: [:, 0]utf8) {
    seconds, now := time_since(timer.phase_start)

    if timer.count < MAX_PERF_PHASES {
        timer.times[timer.count] = seconds
        timer.count += 1
    }

    if timer.count < MAX_PERF_PHASES {
        timer.names[timer.count].len = 0
        &timer.names[timer.count] + next_phase
    }
    timer.phase_start = now
}

// End the final phase and print all phase times plus the total.
perf_timer_end :: fun(timer: ^Performance_Timer) {
    seconds, _ := time_since(timer.phase_start)

    if timer.count < MAX_PERF_PHASES {
        timer.times[timer.count] = seconds
        timer.count += 1
    }

    total, _ := time_since(timer.total_start)

    print("=== Performance ===")
    for i in 0..timer.count {
        print(" ", timer.names[i], ":", timer.times[i] * 1000, "ms")
    }
    print("  Total:", total * 1000, "ms")
}