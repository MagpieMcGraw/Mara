module ui

// Port of Warlock's ui.odin. UI elements (text), gizmos (3D axes), and graphs
// (frame-time bars) that track the camera and live in screen space.
//
// Two deviations from the Odin original, both forced by Mara's model:
//   * Warlock stored glyphs/shapes in a generic `Array(T)` and recovered the
//     start index with a raw_data/uintptr pointer-diff hack. Pounce uses plain
//     `[..N]T` partial arrays, so each element records `start_index`
//     (= glyphs.len at append time) and a count, then slices
//     `glyphs[start_index : start_index+count]` on demand.
//   * `[2]f32`/Vec3 elementwise ops and `.xy` swizzles aren't available, so the
//     Bounds math is expanded to scalar components.

use mara.core
use mara.math
use object
use entity
use asset
use asset_resolve

// 2D bounding box for UI layout calculations. Stored as scalar components
// (Mara's `[2]f32` has no elementwise operators, and bare computed `[2]f32`
// literals don't lower in every position), so min/max are kept as four floats.
Bounds :: struct {
	min_x: f32
	min_y: f32
	max_x: f32
	max_y: f32
}

// Calculate bounds from a slice of shapes (gizmo / graph), each with .obj.
// Uses tracking_offset and scale to determine extents.
bounds_from_shapes :: fun(objects: []Shape) -> Bounds {
	bounds: Bounds
	bounds.min_x =  999999.0
	bounds.min_y =  999999.0
	bounds.max_x = -999999.0
	bounds.max_y = -999999.0

	for i in 0..objects.len {
		if not objects[i].obj.exists do continue

		off_x := objects[i].obj.tracking_offset.x
		off_y := objects[i].obj.tracking_offset.y
		half_x := objects[i].obj.scale.x * 0.5
		half_y := objects[i].obj.scale.y * 0.5

		bounds.min_x = min(bounds.min_x, off_x - half_x)
		bounds.min_y = min(bounds.min_y, off_y - half_y)
		bounds.max_x = max(bounds.max_x, off_x + half_x)
		bounds.max_y = max(bounds.max_y, off_y + half_y)
	}

	return bounds
}

bounds_size :: fun(b: Bounds) -> (x, y: f32) {
	return b.max_x - b.min_x, b.max_y - b.min_y
}

bounds_center :: fun(b: Bounds) -> (x, y: f32) {
	return (b.min_x + b.max_x) * 0.5, (b.min_y + b.max_y) * 0.5
}

// Place a UI element so its bounds sit exactly in the top-right corner.
place_top_right :: fun(
	obj: ^Object,
	bounds: Bounds,
	screen_width: f32, screen_height: f32,
	fov_y: f32)
{
	distance := obj.tracking_offset.z

	// Screen half-extents in world units
	half_w := pixels_to_world(screen_width / 2, distance, fov_y, screen_height)
	half_h := pixels_to_world(screen_height / 2, distance, fov_y, screen_height)

	// Position so bounds.max aligns with top-right corner
	obj.tracking_offset.x = half_w - bounds.max_x
	obj.tracking_offset.y = half_h - bounds.max_y
}

// Subtle color palette
COLOR_WHITE   :: [3]f32{1.0, 1.0, 1.0}
COLOR_CORAL   :: [3]f32{1.0, 0.5, 0.5}
COLOR_PEACH   :: [3]f32{1.0, 0.7, 0.5}
COLOR_SAND    :: [3]f32{1.0, 0.85, 0.6}
COLOR_CREAM   :: [3]f32{1.0, 0.95, 0.7}
COLOR_MINT    :: [3]f32{0.6, 1.0, 0.7}
COLOR_SAGE    :: [3]f32{0.6, 0.85, 0.6}
COLOR_SKY     :: [3]f32{0.5, 0.75, 1.0}
COLOR_POWDER  :: [3]f32{0.7, 0.8, 1.0}
COLOR_LILAC   :: [3]f32{0.8, 0.6, 1.0}
COLOR_ROSE    :: [3]f32{1.0, 0.6, 0.8}
COLOR_SLATE   :: [3]f32{0.6, 0.65, 0.7}
COLOR_SILVER  :: [3]f32{0.8, 0.8, 0.85}
COLOR_KHAKI   :: [3]f32{0.75, 0.7, 0.5}
COLOR_CYAN    :: [3]f32{0.5, 0.9, 0.9}
COLOR_GOLD    :: [3]f32{1.0, 0.8, 0.4}

// Bold palette. Pounce defines these too — that's fine: a name in two modules is
// only an error at an ambiguous *bare* use, where you qualify (ui.X / Pounce.X).
// ui's own references (the ui_graph default = COLOR_GREEN) are unambiguous here.
COLOR_RED     :: [3]f32{0.9, 0.2, 0.2}
COLOR_ORANGE  :: [3]f32{0.95, 0.5, 0.1}
COLOR_YELLOW  :: [3]f32{0.95, 0.85, 0.1}
COLOR_GREEN   :: [3]f32{0.2, 0.75, 0.2}
COLOR_TEAL    :: [3]f32{0.1, 0.7, 0.7}
COLOR_BLUE    :: [3]f32{0.2, 0.4, 0.9}
COLOR_PURPLE  :: [3]f32{0.6, 0.2, 0.8}
COLOR_MAGENTA :: [3]f32{0.9, 0.2, 0.6}

UI_DEFAULT_DISTANCE :: 5.0

// π/2 as a float literal. A cross-module `math.PI / 2` mis-lowers (the qualified
// PI constant emits as the integer 3, so the divide becomes an invalid
// `fdiv float 3, 2.0`), so the quarter-turn angle is spelled out directly here.
HALF_PI     ::  1.5707963267948966
NEG_HALF_PI :: -1.5707963267948966

// Convert desired screen pixel size to world-space size.
pixels_to_world :: fun(pixel_height: f32, distance: f32, fov_y: f32, screen_height: f32) -> f32 {
	return pixel_height * distance * tan(fov_y / 2) * 2 / screen_height
}

// ============================================================================
// UI_Gizmo - 3D shapes that track the camera like UI elements.
// Used for coordinate axes indicator in screen corner.
// ============================================================================

UI_GIZMO_SHAPE_COUNT :: 7  // 1 cube + 3 cylinders + 3 pyramids

UI_Gizmo :: struct {
	obj: Object
	start_index: i64    // first shape slot in the shared shape array
	shape_count: i64
	bounds: Bounds
	size_pixels: f32    // desired size in screen pixels
	resolved: bool
}

// Create a coordinate axes gizmo at screen position (pixels from center).
ui_gizmo_create_pixels :: fun(
	x: f32, y: f32,
	size_pixels: f32,
	shape_array: ^[]Shape) -> UI_Gizmo
{
	gizmo: UI_Gizmo
	gizmo.obj.exists = true
	gizmo.obj.tracking_offset = Vec3{x, y, UI_DEFAULT_DISTANCE}
	gizmo.size_pixels = size_pixels

	// Record where our shapes start, then append UI_GIZMO_SHAPE_COUNT of them.
	gizmo.start_index = shape_array.len
	gizmo.shape_count = UI_GIZMO_SHAPE_COUNT

	// Arrow proportions - all relative to 1.0 total size.
	shaft_thickness : f32 = 0.12
	shaft_length    : f32 = 0.7
	head_size       : f32 = 0.25
	cube_size       : f32 = 0.2

	shaft_offset : f32 = shaft_length / 2
	head_offset  : f32 = shaft_length + head_size / 2

	// Shape 0: Dark cube at center.
	s0: Shape
	s0.obj = Object{}
	s0.obj.scale = Vec3{cube_size, cube_size, cube_size}
	s0.visual = visual_create()
	s0.visual.mesh.name = "=cube"
	s0.visual.color = [0.2, 0.2, 0.2]
	shape_array + s0

	// Shape 1: X axis shaft (red cylinder).
	s1: Shape
	s1.obj = Object{}
	s1.obj.scale = Vec3{shaft_thickness, shaft_thickness, shaft_length}
	s1.obj.tracking_offset = Vec3{shaft_offset, 0, 0}
	s1.obj.dir = quat_angle_axis(HALF_PI, Vec3{0, 1, 0})
	s1.visual = visual_create()
	s1.visual.mesh.name = "=cylinder"
	s1.visual.color = [0.8, 0.3, 0.3]
	shape_array + s1

	// Shape 2: X axis head (red pyramid).
	s2: Shape
	s2.obj = Object{}
	s2.obj.scale = Vec3{head_size, head_size, head_size}
	s2.obj.tracking_offset = Vec3{head_offset, 0, 0}
	s2.obj.dir = quat_angle_axis(HALF_PI, Vec3{0, 1, 0})
	s2.visual = visual_create()
	s2.visual.mesh.name = "=pyramid"
	s2.visual.color = [0.8, 0.3, 0.3]
	shape_array + s2

	// Shape 3: Y axis shaft (green cylinder).
	s3: Shape
	s3.obj = Object{}
	s3.obj.scale = Vec3{shaft_thickness, shaft_thickness, shaft_length}
	s3.obj.tracking_offset = Vec3{0, shaft_offset, 0}
	s3.obj.dir = quat_angle_axis(NEG_HALF_PI, Vec3{1, 0, 0})
	s3.visual = visual_create()
	s3.visual.mesh.name = "=cylinder"
	s3.visual.color = [0.3, 0.7, 0.3]
	shape_array + s3

	// Shape 4: Y axis head (green pyramid).
	s4: Shape
	s4.obj = Object{}
	s4.obj.scale = Vec3{head_size, head_size, head_size}
	s4.obj.tracking_offset = Vec3{0, head_offset, 0}
	s4.obj.dir = quat_angle_axis(NEG_HALF_PI, Vec3{1, 0, 0})
	s4.visual = visual_create()
	s4.visual.mesh.name = "=pyramid"
	s4.visual.color = [0.3, 0.7, 0.3]
	shape_array + s4

	// Shape 5: Z axis shaft (blue cylinder).
	s5: Shape
	s5.obj = Object{}
	s5.obj.scale = Vec3{shaft_thickness, shaft_thickness, shaft_length}
	s5.obj.tracking_offset = Vec3{0, 0, shaft_offset}
	s5.visual = visual_create()
	s5.visual.mesh.name = "=cylinder"
	s5.visual.color = [0.3, 0.4, 0.8]
	shape_array + s5

	// Shape 6: Z axis head (blue pyramid).
	s6: Shape
	s6.obj = Object{}
	s6.obj.scale = Vec3{head_size, head_size, head_size}
	s6.obj.tracking_offset = Vec3{0, 0, head_offset}
	s6.visual = visual_create()
	s6.visual.mesh.name = "=pyramid"
	s6.visual.color = [0.3, 0.4, 0.8]
	shape_array + s6

	return gizmo
}

// Resolve gizmo - convert pixel position/size to world units.
ui_gizmo_resolve :: fun(gizmo: ^UI_Gizmo, shape_array: ^[]Shape, fov_y: f32, screen_height: f32) -> bool {
	if not gizmo.obj.exists do return true
	if gizmo.resolved do return true

	distance := gizmo.obj.tracking_offset.z

	// Convert screen pixel offset to world units.
	gizmo.obj.tracking_offset.x = pixels_to_world(
		gizmo.obj.tracking_offset.x, distance, fov_y, screen_height)
	gizmo.obj.tracking_offset.y = pixels_to_world(
		gizmo.obj.tracking_offset.y, distance, fov_y, screen_height)

	// Convert pixel size to world scale factor.
	world_size := pixels_to_world(gizmo.size_pixels, distance, fov_y, screen_height)

	// Scale all shapes and their tracking offsets.
	for i in 0..gizmo.shape_count {
		shape := &shape_array[gizmo.start_index + i]
		shape.obj.scale *= world_size
		shape.obj.tracking_offset *= world_size
	}

	gizmo.bounds = bounds_from_shapes(
		shape_array[gizmo.start_index : gizmo.start_index + gizmo.shape_count])

	gizmo.resolved = true
	return true
}

// Update gizmo to track camera position (axes stay world-aligned).
ui_gizmo_update :: fun(gizmo: ^UI_Gizmo, shape_array: ^[]Shape, camera_obj: Object) {
	if not gizmo.obj.exists do return

	// Track gizmo origin to camera.
	obj_track_other(&gizmo.obj, camera_obj)

	// Update each shape to track the gizmo origin (keep local orientation).
	for i in 0..gizmo.shape_count {
		shape := &shape_array[gizmo.start_index + i]
		if shape.obj.exists {
			obj_track_other(&shape.obj, gizmo.obj)
		}
	}
}

// ============================================================================
// UI_Graph - Bar graph that tracks camera like UI elements.
// Used for frame time visualization.
// ============================================================================

UI_GRAPH_SAMPLE_COUNT :: 300

UI_Graph :: struct {
	obj: Object
	start_index: i64    // first shape slot in the shared shape array
	shape_count: i64
	bounds: Bounds
	samples: [UI_GRAPH_SAMPLE_COUNT]f32   // circular buffer of values
	sample_index: i64                     // next write position
	width_pixels: f32                     // total width in pixels
	height_pixels: f32                    // max height in pixels
	max_value: f32                        // value that corresponds to max height
	resolved: bool
	// Store resolved world units for update
	bar_width: f32
	bar_max_height: f32
}

// Create a bar graph at screen position (pixels from center).
ui_graph_create_pixels :: fun(
	x: f32, y: f32,
	width_pixels: f32, height_pixels: f32,
	max_value: f32,
	shape_array: ^[]Shape,
	color: [3]f32 = COLOR_GREEN) -> UI_Graph
{
	graph: UI_Graph
	graph.obj.exists = true
	graph.obj.tracking_offset = Vec3{x, y, UI_DEFAULT_DISTANCE}
	graph.width_pixels = width_pixels
	graph.height_pixels = height_pixels
	graph.max_value = max_value

	// Record where our shapes start, then append up to UI_GRAPH_SAMPLE_COUNT bars.
	graph.start_index = shape_array.len

	// Initialize all bars as quads.
	bar_width_pixels := width_pixels / f32(UI_GRAPH_SAMPLE_COUNT)
	for i in 0..UI_GRAPH_SAMPLE_COUNT {
		if shape_array.len >= shape_array.cap do break
		bar: Shape
		bar.obj = Object{}
		bar.obj.scale = Vec3{1, 1, 1}  // Will be set properly in resolve/update
		// Position bars left to right, tracking_offset.x is relative to graph center.
		x_offset := (f32(i) - f32(UI_GRAPH_SAMPLE_COUNT) / 2 + 0.5) * bar_width_pixels
		bar.obj.tracking_offset = Vec3{x_offset, 0, 0}
		bar.visual = visual_create()
		bar.visual.mesh.name = "=quad"
		bar.visual.color = color
		shape_array + bar
	}

	// Count the bars that actually fit (the loop breaks early if the pool is full).
	// resolve/update iterate this, never UI_GRAPH_SAMPLE_COUNT, so they can't index
	// past the appended slots — the same shape_count discipline the gizmo uses.
	graph.shape_count = shape_array.len - graph.start_index

	return graph
}

// Resolve graph - convert pixel dimensions to world units.
ui_graph_resolve :: fun(graph: ^UI_Graph, shape_array: ^[]Shape, fov_y: f32, screen_height: f32) -> bool {
	if not graph.obj.exists do return true
	if graph.resolved do return true

	distance := graph.obj.tracking_offset.z

	// Convert position from pixels to world.
	graph.obj.tracking_offset.x = pixels_to_world(
		graph.obj.tracking_offset.x, distance, fov_y, screen_height)
	graph.obj.tracking_offset.y = pixels_to_world(
		graph.obj.tracking_offset.y, distance, fov_y, screen_height)

	// Convert dimensions to world units.
	graph.bar_width = pixels_to_world(
		graph.width_pixels / f32(UI_GRAPH_SAMPLE_COUNT), distance, fov_y, screen_height)
	graph.bar_max_height = pixels_to_world(
		graph.height_pixels, distance, fov_y, screen_height)

	// Update bar tracking offsets to world units.
	for i in 0..graph.shape_count {
		x_offset := (f32(i) - f32(UI_GRAPH_SAMPLE_COUNT) / 2 + 0.5) * graph.bar_width
		shape_array[graph.start_index + i].obj.tracking_offset.x = x_offset
	}

	// Graph bounds are fixed based on dimensions (bars grow downward from top).
	total_width := graph.bar_width * f32(UI_GRAPH_SAMPLE_COUNT)
	graph.bounds.min_x = -total_width / 2
	graph.bounds.min_y = -graph.bar_max_height
	graph.bounds.max_x = total_width / 2
	graph.bounds.max_y = 0

	graph.resolved = true
	return true
}

// Add a new sample to the graph.
ui_graph_add_sample :: fun(graph: ^UI_Graph, value: f32) {
	if not graph.obj.exists do return

	graph.samples[graph.sample_index] = value
	graph.sample_index = (graph.sample_index + 1) % UI_GRAPH_SAMPLE_COUNT
}

// Update graph to track camera and update bar heights based on samples.
ui_graph_update :: fun(graph: ^UI_Graph, shape_array: ^[]Shape, camera_obj: Object) {
	if not graph.obj.exists do return
	if not graph.resolved do return

	// Track graph origin to camera (face camera like text elements).
	obj_track_other(&graph.obj, camera_obj)
	graph.obj.dir = camera_obj.dir

	// Update each bar.
	for i in 0..graph.shape_count {
		shape := &shape_array[graph.start_index + i]
		if not shape.obj.exists do continue

		// Get sample value (read in order from oldest to newest for display).
		sample_idx := (graph.sample_index + i) % UI_GRAPH_SAMPLE_COUNT
		value := graph.samples[sample_idx]

		// Calculate bar height (no limit - show full spike height).
		bar_height := (value / graph.max_value) * graph.bar_max_height
		bar_height = max(bar_height, graph.bar_max_height * 0.02)  // minimum 2% of max height

		// Color red if value exceeds max, otherwise use original color.
		if value > graph.max_value {
			shape.visual.color = COLOR_RED
		else
			shape.visual.color = COLOR_GREEN
		}

		// Set scale (width, height, depth for quad).
		shape.obj.scale = Vec3{graph.bar_width, bar_height, graph.bar_width}

		// Position bar - offset Y so top of bar is at graph origin (bars grow downward).
		shape.obj.tracking_offset.y = -bar_height / 2

		// Track to graph, then face camera.
		obj_track_other(&shape.obj, graph.obj)
		shape.obj.dir = camera_obj.dir
	}
}
