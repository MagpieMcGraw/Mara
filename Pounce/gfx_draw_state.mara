module gfx

use mara.core
use mara.math
use mara.string

use gfx.shader
gl :: use mara.open_gl

use object
use camera

MAX_BATCHES              :: 16
MAX_INSTANCES_PER_BATCH  :: 512

Mesh_Batch :: struct {
    mesh_id:        i64
    instances:      [MAX_INSTANCES_PER_BATCH]Instance
}

// One MultiDrawIndirect command, in GL's layout
DrawCommand :: struct {
    index_count:    u32
    instance_count: u32
    first_index:    u32
    base_vertex:    i32
    base_instance:  u32
}

// Everything one MultiDrawIndirect call needs
DrawState :: struct {
	shader_id: u32,
	texture: u32,

	vao_state: ^VAO_State,

	command_buffer: u32,

	batches: [MAX_BATCHES]Mesh_Batch
	batch_count: i64

	instance_capacity: i64,

	commands: [256]DrawCommand,
	command_count: i64,
}

// Filled in place: a DrawState is ~790 KB, too big to return on the stack.
draw_state_init :: fun(state: ^DrawState, shader_file: []utf8,
	vao_state: ^VAO_State, max_instances: i64, max_commands: isize)
{
	shader_id, shader_err := make_program(shader_file)
	if bool(shader_err) do print(shader_err)

	command_buffer: u32
	gl.GenBuffers(1, &command_buffer)
	gl.BindBuffer(gl.DRAW_INDIRECT_BUFFER, command_buffer)
	gl.BufferData(gl.DRAW_INDIRECT_BUFFER,
				  max_commands * size_of(DrawCommand),
				  void,
				  gl.DYNAMIC_DRAW)
	gl.BindBuffer(gl.DRAW_INDIRECT_BUFFER, 0)

	state^ = DrawState{
		shader_id = shader_id,
		texture = 0,
		batch_count = 0,
		vao_state = vao_state,
		command_buffer = command_buffer,
		instance_capacity = max_instances,
		command_count = 0,
	}
}

draw_state_bind :: fun(state: ^DrawState) {
	gl.UseProgram(state.shader_id)
	gl.ActiveTexture(gl.TEXTURE0)
	gl.BindTexture(gl.TEXTURE_2D_ARRAY, state.texture)
}

// A missing GL object asserts here instead of drawing a blank frame.
draw_state_assert_ready :: fun(state: ^DrawState) {
	assert(state.shader_id != 0)
	assert(state.command_buffer != 0)
	assert(state.texture != 0)

	vao := state.vao_state
	assert(vao != void)
	assert(vao.vao != 0)
	assert(vao.vertex_vbo != 0)
	assert(vao.ebo != 0)
	assert(vao.instance_vbo != 0)

	// Nothing uploaded: no indices to draw
	assert(vao.mesh_count > 0)
	assert(vao.index_offset > 0)
}

get_or_create_batch :: fun(state: ^DrawState, mesh_id: i64) -> ^Mesh_Batch {
    for i in 0:state.batch_count {
        if state.batches[i].mesh_id == mesh_id {
            return &state.batches[i]
        }
    }
    if state.batch_count >= MAX_BATCHES {
        crash("DrawState batch limit (16) exceeded")
    }
    batch := &state.batches[state.batch_count]
    batch.mesh_id = mesh_id
    batch.instances.len = 0
    state.batch_count += 1
    return batch
}

draw_state_append :: fun(state: ^DrawState,
	objects: []Object, visuals: []Visual, cam: Camera)
{
	if objects.len == 0 do return
	if visuals.len == 0 do return

	for i in 0:objects.len {
		if not objects[i].exists do continue

		// For now objects[i] goes with visuals[i]
		obj := objects[i]
		vis := visuals[i]
		mesh_id := visuals[i].mesh.index

		batch := get_or_create_batch(state, mesh_id)

		mvp := opengl_create_mvp_matrix(
			obj.pos, obj.dir, obj.scale,
			cam.view, cam.proj,
		)
		instance := Instance{
			mvp_matrix = mvp,
			tex_coords = vis.texture.uv,
			color = vis.color,
			layer = vis.texture.layer,
		}
		&batch.instances ++ instance
	}
}

append_one :: fun(state: ^DrawState,
	obj: Object, vis: Visual, cam: Camera)
{
	if not obj.exists do return

	mesh_id := vis.mesh.index
	batch := get_or_create_batch(state, mesh_id)

	mvp := opengl_create_mvp_matrix(
		obj.pos, obj.dir, obj.scale,
		cam.view, cam.proj,
	)
	instance := Instance{
		mvp_matrix = mvp,
		tex_coords = vis.texture.uv,
		color = vis.color,
		layer = vis.texture.layer,
	}
	&batch.instances ++ instance
}

draw_state_reset :: fun(state: ^DrawState) {
    for i in 0:state.batch_count {
        state.batches[i].instances.len = 0
    }
    state.batch_count = 0
    state.command_count = 0
}

// Uploads each batch's instances, then draws them all with one call.
draw_state_render :: fun(state: ^DrawState) {
	vao_info := state.vao_state
	assert(vao_info != void)
	gl.BindBuffer(gl.ARRAY_BUFFER, vao_info.instance_vbo)

	gpu_offset: isize = 0
	state.command_count = 0
	for i in 0:state.batch_count {
	    batch := &state.batches[i]
	    count := batch.instances.len
	    if count == 0 do continue
	    if batch.mesh_id not in 0:vao_info.mesh_count do continue
	    if state.command_count > 255 do break
	    mesh := vao_info.meshes[batch.mesh_id]
	    state.commands[state.command_count] = DrawCommand{
	        index_count    = mesh.index_count,
	        instance_count = u32(count),
	        first_index    = mesh.first_index,
	        base_vertex    = mesh.base_vertex,
	        base_instance  = u32(gpu_offset),
	    }
	    state.command_count += 1
	    gl.BufferSubData(gl.ARRAY_BUFFER,
	                     gpu_offset * size_of(Instance),
	                     isize(count) * isize(size_of(Instance)),
	                     batch.instances[0:count].ptr)
	    gpu_offset += isize(count)
	}

	// Upload command data
	gl.BindBuffer(gl.DRAW_INDIRECT_BUFFER, state.command_buffer)
	gl.BufferSubData(gl.DRAW_INDIRECT_BUFFER, 0,
					 isize(state.command_count) * isize(size_of(DrawCommand)),
					 state.commands[0:state.command_count].ptr)

	// ONE DRAW CALL FOR EVERYTHING
	draw_state_bind(state)
	gl.BindVertexArray(vao_info.vao)
	gl.MultiDrawElementsIndirect(
		gl.TRIANGLES,
		gl.UNSIGNED_INT,
		0, i32(state.command_count), 0,
	)

	gl.BindVertexArray(0)
	gl.BindBuffer(gl.DRAW_INDIRECT_BUFFER, 0)
}

opengl_create_mvp_matrix :: fun(pos: Vec3, dir: Quat,
	scale_factors: Vec3, view_mx, proj_mx: Mat4) -> Mat4
{
	rotation := mat4_from_quat(dir)
	translation := mat4_translate(pos)
	scale := mat4_scale(scale_factors)

	model := (translation * (rotation * scale))
	mv_matrix := view_mx * model
	mvp_matrix := proj_mx * mv_matrix
	return mvp_matrix
}
