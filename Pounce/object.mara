module object

use mara.core
use mara.math
use mara.string

Object :: struct {
	dir := QUAT_IDENTITY

	pos: Vec3
	scale: Vec3
	accel: Vec3
	tracking_offset: Vec3 // used to follow other objects

	speed, turn_speed : f32

	exists := true     // used by Array to track active items
	highlighted: bool // draw with highlight effect (wireframe overlay)
}

obj_get_directions :: fun(dir: Quat) -> (fwd, up, right : Vec3) {
	rot_mx := mat4_from_quat(dir)
	fwd.xyz = rot_mx[2].xyz
	up.xyz = rot_mx[1].xyz
	right.xyz = rot_mx[0].xyz
	return fwd, up, right
}

obj_face :: fun(dir: Quat) -> Quat {
	default_up : Vec3 = [0, 1, 0]
	rotation_quat := quat_angle_axis(to_radians(180), default_up)
	new_dir := dir * rotation_quat
	return new_dir
}

obj_track_other :: fun(obj: ^Object, other_obj: Object) {
	fwd, up, right := obj_get_directions(other_obj.dir)
	z_off := fwd  * obj.tracking_offset.z
	y_off := up * obj.tracking_offset.y
	x_off := right * obj.tracking_offset.x
	obj.pos = other_obj.pos + z_off + y_off + x_off
}

DEFAULT_MESH :: Mesh{"=quad", 0}
DEFAULT_TEXTURE :: Texture{"DEFAULT", {0, 0, 0, 0}, 0}  // 1x1 white pixel at (0,0)
ATLAS_TEXTURE :: Texture{"ATLAS", {1, 1, 0, 0}, 0} 

Visual :: struct {
	texture := DEFAULT_TEXTURE
	mesh := DEFAULT_MESH
	texture_index: u32
	color: [3]f32 = [1, 0, 0]
	font: [..64]utf8   // for glyph resolution
	resolve: bool      // enable automatic asset resolution
}

Texture :: struct {
	name:  str64
	uv:    [4]f32,  // scale_x, scale_y, offset_x, offset_y
	layer: u32,     // texture array layer
}

Mesh :: struct {
	name:  str64
	index: i64,
}

Playa :: struct {
	obj : Object
	visual : Visual
	obj.scale = Vec3{100, 100, 100}
}