module Pounce
use mara.core

use mara.os
use mara.memory
use mara.math
use mara.string
use mara.time
use mara.open_gl
use mara.sdl
use mara.font

use gfx
use event
use object
use camera
use asset
use gfx.shader

COLOR_RED 		:: Vec3{0.9, 0.2, 0.2}
COLOR_ORANGE  	:: Vec3{0.95, 0.5, 0.1}
COLOR_YELLOW  	:: Vec3{0.95, 0.85, 0.1}
COLOR_GREEN   	:: Vec3{0.2, 0.75, 0.2}
COLOR_TEAL    	:: Vec3{0.1, 0.7, 0.7}
COLOR_BLUE    	:: Vec3{0.2, 0.4, 0.9}
COLOR_PURPLE  	:: Vec3{0.6, 0.2, 0.8}
COLOR_MAGENTA 	:: [3!]f32{0.9, 0.2, 0.6}

// A square in the scene, dragged with the left mouse button.
Marker :: struct {
	pos:   Vec3
	color: [3!]f32
}

MARKER_DEPTH :: 120.0   // z of the plane the squares sit on
MARKER_HALF  :: 20.0    // half a square's side

Timers :: struct {
	work  := time.Timer()
	frame := Timer()
	fixed := time.Fixed_Timer()
}

Megastruct :: struct {
	initialized: bool
	running: bool

	window: sdl.Window
	gl_context: sdl.GLContext

	timers := Timers()

	fps := 60.9
	frame_counter := 0

	using events: Event_State,

	cameras: [6]Camera = all Camera(1280, 720, 90)

	cam := Camera(1280, 720, 90)
	mouse_look: bool

	vao: VAO_State = void
	draw_state_object: DrawState
	draw_state_highlight: DrawState
	draw_state_text: DrawState

	assets := Assets()

	playa := Playa()

	markers: [4!]Marker
	dragging: i64 = -1    // the dragged square's index; -1: none
	drag_offset: Vec3     // from the mouse's point on the plane to the square
}

game_init :: fun(game: ^Megastruct, memory_bytes: ^[]byte) -> err {
	game^ = Megastruct()

	sdl.Init(Video)?

	_ = sdl.GL_SetAttribute(ContextProfileMask, i32(GLprofile.Core))
	_ = sdl.GL_SetAttribute(ContextMajorVersion, 4)
	_ = sdl.GL_SetAttribute(ContextMinorVersion, 5)

	game.window = sdl.CreateWindow("Not main...", 960, 540,
		OpenGL | Resizable)?

	game.gl_context = sdl.GL_CreateContext(game.window)?
	_ = sdl.GL_MakeCurrent(game.window, game.gl_context)
	gl_load(GL_GetProcAddress)

	game.vao = VAO_State()
	draw_state_init(&game.draw_state_object,
		"data/shaders/instanced.glsl",
		&game.vao, 8192, 32)
	draw_state_init(&game.draw_state_text,
		"data/shaders/instanced_text.glsl",
		&game.vao, 8192, 32)

	&game.assets.init(&game.vao, "data/fonts/Inter_18pt-Regular.ttf")

	// Object shader: the image atlas. Text shader: the font atlas.
	game.draw_state_object.texture = game.assets.texture_id
	game.draw_state_text.texture = game.assets.font_texture_id

	// Flipped 180 about Y: the scene sits along +Z, in front of the camera.
	game.cam.obj.pos = Vec3{0, 0, 0}
	camera_look_down(&game.cam)

	// The playa quad shows the whole font atlas (ATLAS_TEXTURE).
	game.playa.obj.pos = Vec3{0, 0, 120}
	game.playa.obj.scale = Vec3{70, 70, 70}
	game.playa.visual.texture = ATLAS_TEXTURE

	// A cross of squares around the playa, at its depth.
	game.markers[0] = Marker{Vec3{ 90,   0, MARKER_DEPTH}, [1, 0, 0]}
	game.markers[1] = Marker{Vec3{  0,  90, MARKER_DEPTH}, [0, 1, 0]}
	game.markers[2] = Marker{Vec3{-90,   0, MARKER_DEPTH}, [0, 0, 1]}
	game.markers[3] = Marker{Vec3{  0, -90, MARKER_DEPTH}, [1, 1, 0]}

	game.running = true
	game.initialized = true
	return Ok
}

game_events :: fun(game: ^Megastruct) {
	quit_msg := ""
	&quit_msg ++ "Escaping..."

	process(&game.events)
	ev := &game.events	kb := &ev.keyboard	file := &ev.dropfile
	if ev.quit 				do game.running = false
	if file.was_dropped		do print("dropepd file: ", file.name)
	if kb.pressed[P]		do print("Printing!")
	if kb.pressed[T]		do print("Testing!")
	if kb.pressed[Escape] 	{
		print(quit_msg)
		game.running = false
	}

	// Right-click toggles mouselook (relative mouse mode).
	if ev.mouse.pressed[3] {
		game.mouse_look = not game.mouse_look
		_ = sdl.SetWindowRelativeMouseMode(game.window, game.mouse_look)
	}
	if game.mouse_look do camera_turn_walking(&game.cam, &ev.mouse)

	// Left button: grab the square under the mouse, keep it there while held.
	if not game.mouse_look {
		at, on := mouse_on_plane(game, MARKER_DEPTH)
		if ev.mouse.pressed[1] and on {
			game.dragging = -1
			for m, i in game.markers {
				dx := abs_f32(at.x - m.pos.x)
				dy := abs_f32(at.y - m.pos.y)
				if dx <= MARKER_HALF and dy <= MARKER_HALF {
					game.dragging = i
					game.drag_offset = m.pos - at
				}
			}
		}
		if not ev.mouse.held[1] do game.dragging = -1
		if game.dragging >= 0 and on {
			game.markers[game.dragging].pos = at + game.drag_offset
		}
	}
}

// Where the mouse's ray crosses the plane at z; false when it doesn't.
mouse_on_plane :: fun(game: ^Megastruct, z: f32) -> Vec3, bool {
	w : i32 = 0
	h : i32 = 0
	_ = sdl.GetWindowSizeInPixels(game.window, &w, &h)
	if w <= 0 or h <= 0 do return Vec3{all 0}, false
	x := 2.0 * game.events.mouse.x / f32(w) - 1.0
	y := 1.0 - 2.0 * game.events.mouse.y / f32(h)
	inv := mat4_inverse(game.cam.proj * game.cam.view)
	near := inv * Vec4{x, y, -1, 1}
	far := inv * Vec4{x, y, 1, 1}
	if near.w == 0 or far.w == 0 do return Vec3{all 0}, false
	a := Vec3{near.x / near.w, near.y / near.w, near.z / near.w}
	b := Vec3{far.x / far.w, far.y / far.w, far.z / far.w}
	d := b - a
	if abs_f32(d.z) < 0.0001 do return Vec3{all 0}, false
	t := (z - a.z) / d.z
	if t < 0 or t > 1 do return Vec3{all 0}, false
	return Vec3{a.x + d.x * t, a.y + d.y * t, z}, true
}

game_update :: fun(game: ^Megastruct, dt: f64) {
	camera_move(&game.cam, &game.events.keyboard, f32(game.timers.fixed.step))
	camera_update(&game.cam, f32(game.timers.fixed.step))
}

// A flat-colored quad: DEFAULT_TEXTURE samples the atlas's white pixel.
draw_marker :: fun(state: ^DrawState,
	pos: Vec3, color: [3!]f32, cam: Camera)
{
	obj := Object(){pos = pos, scale = Vec3{40, 40, 40}}
	vis := Visual(){color = color}
	append_one(state, obj, vis, cam)
}

game_draw :: fun(game: ^Megastruct) {
	draw_state_assert_ready(&game.draw_state_object)
	draw_state_assert_ready(&game.draw_state_text)

	ClearColor(0.85, 0.80, 0.70, 1.0)
	Clear(COLOR_BUFFER_BIT | DEPTH_BUFFER_BIT)

	// The squares: object shader, image atlas.
	for m in game.markers {
		draw_marker(&game.draw_state_object, m.pos, m.color, game.cam)
	}
	draw_state_render(&game.draw_state_object)
	draw_state_reset(&game.draw_state_object)

	// The playa: text shader, font atlas.
	append_one(&game.draw_state_text,
		game.playa.obj, game.playa.visual, game.cam)
	draw_state_render(&game.draw_state_text)
	draw_state_reset(&game.draw_state_text)

	_ = GL_SwapWindow(game.window)
}

game_run :: fun(memory_bytes: ^[]byte) -> bool {
	game := let(Megastruct, &memory_bytes[0])
	if not game.initialized {
		init_err := game_init(&game, memory_bytes)
		if init_err {
			print("Pounce couldn't start:", init_err, init_err.where())
			return false
		}
	}

	timer := &game.timers
	timer.work.counter = time.clock_ns()

	game_events(&game)

	tally_up(&timer.frame, &timer.fixed)
	for one_step(&timer.fixed) do game_update(&game, timer.fixed.step)

	game_draw(&game)

	use_fps := if game.events.window_in_focus do game.fps else 2.0
	sleep(timer.work, use_fps)

	if not game.running do game_end(game)
	return game.running
}

game_end :: fun(game: Megastruct) {
	sdl.DestroyWindow(game.window)
	sdl.Quit()
}
