module Pounce
use mara.core

use mara.os
use mara.memory
use mara.math
use mara.string
use mara.time
use mara.open_gl
use mara.sdl
use mara.font

use gfx
use event
use object
use camera
use perf
use asset
use test_draw
use gfx.shader

COLOR_RED 		:: Vec3{0.9, 0.2, 0.2}
COLOR_ORANGE  	:: Vec3{0.95, 0.5, 0.1}
COLOR_YELLOW  	:: Vec3{0.95, 0.85, 0.1}
COLOR_GREEN   	:: Vec3{0.2, 0.75, 0.2}
COLOR_TEAL    	:: Vec3{0.1, 0.7, 0.7}
COLOR_BLUE    	:: Vec3{0.2, 0.4, 0.9}
COLOR_PURPLE  	:: Vec3{0.6, 0.2, 0.8}
COLOR_MAGENTA 	:: [3]f32{0.9, 0.2, 0.6}

Player :: struct {
	x, y: i64
	size  := 50
	color := COLOR_RED
}

Timers :: struct {
	work  : time.Timer
	frame : Timer
	fixed : time.Fixed_Timer
}

// Megastruct - this is the actual game data
Megastruct :: struct {
	initialized: bool
	running: bool

	// Platform handles
	window: sdl.Window
	gl_context: sdl.GLContext

	timers: Timers

	fps := 60.9
	frame_counter := 0

	// Input
	using events: Event_State,

	// Asset system
	//assets: Assets

	cameras: [..6]Camera = all Camera(1280, 720, 90)

	camera := Camera(1280, 720, 90)
	mouse_look: bool

	// Draw states
	vao: VAO_State = void
	draw_state_object: DrawState
	draw_state_highlight: DrawState
	draw_state_text: DrawState

	assets : Assets

	// Rendering
	quad:   Quad_Renderer
	player: Player
	playa : Playa
}

game_init :: fun(game: ^Megastruct, memory: ^[]byte) {
	game^ = Megastruct{}

	init_err := sdl.Init(Video)

	_ = sdl.GL_SetAttribute(ContextProfileMask, .Core)
	_ = sdl.GL_SetAttribute(ContextMajorVersion, 4)
	_ = sdl.GL_SetAttribute(ContextMinorVersion, 5)

	game.window = sdl.CreateWindow("Not main...", 960, 540,
		OpenGL | Resizable)

	game.gl_context = sdl.GL_CreateContext(game.window)
	_ = sdl.GL_MakeCurrent(game.window, game.gl_context)
	gl_load(GL_GetProcAddress)

	// testing the gfx
	game.vao = VAO_State()
	//gfx.primitives_init(&game.vao)
	game.draw_state_object = draw_state_create(
		"data/shaders/instanced.glsl",
		&game.vao, 8192, 32)
	game.draw_state_text = draw_state_create(
		"data/shaders/instanced_text.glsl",
		&game.vao, 8192, 32)

	&game.assets.init(&game.vao, "data/fonts/Inter_18pt-Regular.ttf")

	// Texture binding flows asset -> draw state: the object shader samples the
	// image atlas, the text shader samples the font atlas. Without this the
	// draw states sample texture 0 and discard everything (draw_state_assert_ready
	// catches it).
	game.draw_state_object.texture = game.assets.texture_id
	game.draw_state_text.texture = game.assets.font_texture_id

	// Camera setup mirrors the Warlock reference (Warlock.odin): sit at the origin
	// and look_down (a 180 flip about Y). At raw identity the camera's view axis is
	// parallel to the world up (+Z) that camera_turn_walking yaws around, so
	// horizontal mouselook rolled instead of panning; look_down fixes the
	// orientation. The scene then sits out along +Z in front of the camera.
	game.camera.obj.pos = Vec3{0, 0, 0}
	camera_look_down(&game.camera)

	// Playa quad shows the whole font atlas (layer 0) so the MDEI text path has
	// real glyph data to sample. tex_coords {1,1,0,0} maps the quad's 0..1 UVs
	// across the full sheet ({0,0,0,0} would sample one empty corner and discard).
	game.playa.obj.pos = Vec3{0, 0, 120}
	game.playa.obj.scale = Vec3{70, 70, 70}
	game.playa.visual.texture = ATLAS_TEXTURE

	game.running = true
	game.initialized = true
}

game_events :: fun(game: ^Megastruct) {
	quit_msg := ""
	&quit_msg + "Escaping..."

	process(&game.events)
	ev := &game.events	kb := &ev.keyboard	file := &ev.dropfile
	if ev.quit 				do game.running = false
	if file.was_dropped		do print("dropepd file: ", file.name)
	if kb.pressed[W] 		do game.player.y -= 50
	if kb.pressed[A] 		do game.player.x -= 50
	if kb.pressed[S]		do game.player.y += 50
	if kb.pressed[D] 		do game.player.x += 50
	if kb.pressed[P]		do print("Printing!")
	if kb.pressed[T]		do print("Testing!")
	if kb.pressed[Escape] 	{
		print(quit_msg)
		game.running = false
	}

	// Mouselook gate (matches the Warlock reference): right-click toggles it.
	// Enabling turns on relative mouse mode, which locks the cursor to the window
	// and feeds unbounded relative motion — so turning never stops at the window
	// edge. The turn itself runs once per frame here, not per fixed step.
	if ev.mouse.pressed[3] {
		game.mouse_look = not game.mouse_look
		_ = sdl.SetWindowRelativeMouseMode(game.window, game.mouse_look)
	}
	if game.mouse_look do camera_turn_walking(&game.camera, &ev.mouse)
}
game_update :: fun(game: ^Megastruct, dt: f64) {
	camera_move(&game.camera, &game.events.keyboard, f32(game.timers.fixed.step))
	camera_update(&game.camera, f32(game.timers.fixed.step))
}
// Append a solid-colored quad through the object shader. The image atlas holds a
// white pixel at (0,0) layer 0, so DEFAULT_TEXTURE (uv {0,0,0,0}) samples white
// and `color` comes through flat — a clean orientation marker.
draw_marker :: fun(state: ^DrawState, pos: Vec3, color: [3]f32, camera: Camera) {
	obj := Object{pos = pos, scale = Vec3{40, 40, 40}, exists = true}
	vis := Visual{color = color}
	append_one(state, obj, vis, camera)
}

game_draw :: fun(game: ^Megastruct) {
	// --- Everything OpenGL needs to draw this frame ---
	// Static GPU state (checked by draw_state_assert_ready):
	//   shader         linked program        (0 = link failed)
	//   command_buffer MDI indirect buffer
	//   texture        sampler2DArray source (image / font atlas)
	//   vao + 3 VBOs   vao / vertex_vbo / ebo / instance_vbo
	//   mesh_count>0   at least one mesh uploaded to the shared VAO
	//   index_offset>0 geometry actually uploaded (indices exist to draw)
	// Per-frame data (checked inside draw_state_render):
	//   each batch's instances.len is its instance count (one source of truth)
	//   each mesh_id resolves to a VAO_Mesh with index_count > 0
	//   command_count > 0 once batches are flattened to DrawCommands
	draw_state_assert_ready(&game.draw_state_object)
	draw_state_assert_ready(&game.draw_state_text)

	ClearColor(0.85, 0.80, 0.70, 1.0)
	Clear(COLOR_BUFFER_BIT | DEPTH_BUFFER_BIT)

	// Orientation cross of solid quads around the playa, so one object isn't the
	// only thing on screen: +X red, +Y green, -X blue, -Y yellow, at the playa's
	// depth. Drawn through the object shader / image atlas.
	draw_marker(&game.draw_state_object, Vec3{ 90,   0, 120}, [1, 0, 0], game.camera)
	draw_marker(&game.draw_state_object, Vec3{  0,  90, 120}, [0, 1, 0], game.camera)
	draw_marker(&game.draw_state_object, Vec3{-90,   0, 120}, [0, 0, 1], game.camera)
	draw_marker(&game.draw_state_object, Vec3{  0, -90, 120}, [1, 1, 0], game.camera)
	draw_state_render(&game.draw_state_object)
	draw_state_reset(&game.draw_state_object)

	// Playa quad through the text shader / font atlas.
	append_one(&game.draw_state_text,
		game.playa.obj, game.playa.visual, game.camera)
	draw_state_render(&game.draw_state_text)
	draw_state_reset(&game.draw_state_text)

	_ = GL_SwapWindow(game.window)
}

game_run :: fun(memory: ^[]byte) -> bool {
	game := let(Megastruct, &memory[0])
	if not game.initialized do game_init(&game, memory)

	timer := &game.timers
	timer.work.counter = time_now()

	game_events(&game)

	tally_up(&timer.frame, &timer.fixed)
	for one_step(&timer.fixed) do game_update(&game, timer.fixed.step)

	game_draw(&game)

	use_fps := if game.events.window_in_focus do game.fps else 2.0
	sleep(timer.work, use_fps)

	if not game.running do game_end(game)
	return game.running
}

game_end :: fun(game: Megastruct) {
	sdl.DestroyWindow(game.window)
	sdl.Quit()
}