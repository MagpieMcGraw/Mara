module Pounce
use mara.core

use mara.os
use mara.memory
use mara.math
use mara.string
use mara.time
use mara.open_gl
use mara.sdl

use mara.lazy_font

use gfx
use event
use object
use camera
use perf
use asset
use test_draw
use gfx.shader

COLOR_RED 		:: Vec3{0.9, 0.2, 0.2}
COLOR_ORANGE  	:: Vec3{0.95, 0.5, 0.1}
COLOR_YELLOW  	:: Vec3{0.95, 0.85, 0.1}
COLOR_GREEN   	:: Vec3{0.2, 0.75, 0.2}
COLOR_TEAL    	:: Vec3{0.1, 0.7, 0.7}
COLOR_BLUE    	:: Vec3{0.2, 0.4, 0.9}
COLOR_PURPLE  	:: Vec3{0.6, 0.2, 0.8}
COLOR_MAGENTA 	:: [3]f32{0.9, 0.2, 0.6}

Player :: struct {
	x, y: i64
	size  := 50
	color := COLOR_RED
}

Timers :: struct {
	work  : time.Timer
	frame : Timer
	fixed : time.Fixed_Timer
}

// Megastruct - this is the actual game data
Megastruct :: struct {
	initialized: bool
	running: bool

	// Platform handles
	window: sdl.Window
	gl_context: sdl.GLContext

	timers: Timers

	fps := 60.9
	frame_counter := 0

	// Input
	using events: Event_State,

	// Asset system
	//assets: Assets

	cameras: [..6]Camera = all Camera(1280, 720, 90)

	camera := Camera(1280, 720, 90)
	mouse_look: bool

	// Draw states
	vao: VAO_State = #skip_constructor
	draw_state_object: DrawState
	draw_state_highlight: DrawState
	draw_state_text: DrawState

	// Rendering
	quad:   Quad_Renderer
	player: Player
}

game_init :: fun(game: ^Megastruct, memory: ^[]byte) {
	game^ = Megastruct{}

	init_err := sdl.Init(Video)

	sdl.GL_SetAttribute(ContextProfileMask, .Core)
	sdl.GL_SetAttribute(ContextMajorVersion, 4)
	sdl.GL_SetAttribute(ContextMinorVersion, 5)

	game.window = sdl.CreateWindow("Not main...", 960, 540,
		OpenGL | Resizable)

	game.gl_context = sdl.GL_CreateContext(game.window)
	sdl.GL_MakeCurrent(game.window, game.gl_context)
	gl_load(GL_GetProcAddress)

	quad_init(&game.quad)
	game.player.x = 455
	game.player.y = 270

	// testing the gfx
	game.vao = VAO_State()
	gfx.primitives_init(&game.vao)
	game.draw_state_object = draw_state_create(
		"data/shaders/instanced.glsl",
		&game.vao, 8192, 32)

	ttf_data : [..32 * MB]byte
	err := read_entire_file(
		"data/fonts/Inter_18pt-Regular.ttf", &ttf_data)
	print("TTF file read", err)
	test_ttf := TTF_Layout(&ttf_data)

	game.running = true
	game.initialized = true
}

game_events :: fun(game: ^Megastruct) {
	quit_msg : str
	&quit_msg + "Escaping..."

	process(&game.events)
	match game.events {
		quit 					do game.running = false
		dropfile.was_dropped
			print("dropepd file: ", dropfile.name)
		keyboard.pressed[W] 	do game.player.y -= 50
		keyboard.pressed[A] 	do game.player.x -= 50
		keyboard.pressed[S]		do game.player.y += 50
		keyboard.pressed[D] 	do game.player.x += 50
		keyboard.pressed[P]		do print("Printing!")
		keyboard.pressed[T]		do print("Testing!")
		keyboard.pressed[Escape]
			print(quit_msg)
			game.running = false
	}
}

game_update :: fun(dt: f64) {
	// so far we do nothing
}

game_draw :: fun(game: ^Megastruct) {
	ClearColor(0.85, 0.80, 0.70, 1.0)
	Clear(COLOR_BUFFER_BIT | DEPTH_BUFFER_BIT)
	p := &game.player
	draw_quad(&game.quad, 960.0, 540.0,
		f32(p.x), f32(p.y), f32(p.size), f32(p.size), p.color)
	GL_SwapWindow(game.window)
}

game_run :: fun(memory: ^[]byte) -> bool {
	game := let(Megastruct, &memory[0])
	if not game.initialized do game_init(&game, memory)

	timer := &game.timers
	timer.work.counter = time_now()

	game_events(&game)

	tally_up(&timer.frame, &timer.fixed)
	for one_step(&timer.fixed) do game_update(timer.fixed.step)

	game_draw(&game)

	use_fps := if game.events.window_in_focus do game.fps else 2.0
	sleep(timer.work, use_fps)

	if not game.running do game_end(game)
	return game.running
}

game_end :: fun(game: Megastruct) {
	sdl.DestroyWindow(game.window)
	sdl.Quit()
}