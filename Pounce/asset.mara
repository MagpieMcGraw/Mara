module asset

use mara.string

Texture :: struct {
    name:  String,
    uv:    [4]f32,  // scale_x, scale_y, offset_x, offset_y
    layer: u32,     // texture array layer
}

Mesh :: struct {
    name:  String,
    index: i64,
}

Font :: struct {
    w, h : i32,
    name: String,
    layer: u32,
    offset_x, offset_y: i32,  // Position within atlas layer
	//info: stbtt.fontinfo,
	//packed_chars: []stbtt.packedchar,
}