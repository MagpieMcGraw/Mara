module asset

use mara.string

Texture :: struct {
    name:  str,
    uv:    [4]f32,  // scale_x, scale_y, offset_x, offset_y
    layer: u32,     // texture array layer
}

Mesh :: struct {
    name:  str,
    index: i32,
}

Font :: struct {
    w, h : i32,
    name: str,
    layer: u32,
    offset_x, offset_y: i32,  // Position within atlas layer
    glyphs: [256]Glyph
}

Glyph :: struct {
	x, y, w, h: i32
	bearing_x, bearing_y, advance :i32
}

