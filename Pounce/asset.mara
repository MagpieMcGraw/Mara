module asset

use mara.core

use mara.os
use mara.skyline
use mara.font
gl :: use mara.open_gl

use object
use gfx
use cache

DEFAULT_MESH :: Mesh{"=quad", 0}
DEFAULT_TEXTURE :: Texture{"DEFAULT", {0, 0, 0, 0}, 0}  // 1x1 white pixel at (0,0)
ATLAS_TEXTURE :: Texture{"ATLAS", {1, 1, 0, 0}, 0}      // entire atlas layer 0

Font :: struct {
	size : i32 = 1024
	name: str64
	layer: u32,
	offset_x, offset_y: i32,  // Position within atlas layer
	metrics: Line_Metrics     // from mara.font, same type load_glyphs returns
	glyphs: [256]Glyph
}

// Streaming state
Stream_State :: union {
	Idle,           // Nothing to do
	Streaming,      // Loading assets from cache
	Done,           // All assets loaded
}

// Files found on disk in the data directory
Disk :: struct {
	models:		[..MAX_MESHES]str64
	textures:	[..MAX_TEXTURES]str64
	audio:		[..MAX_AUDIO]str64
	fonts:		[..MAX_FONTS]str64
}

MAX_TEXTURES :: 1024
MAX_MESHES :: 512
MAX_FONTS :: 64
MAX_AUDIO :: 256
ATLAS_LAYERS :: 16
FONT_RANGE :: 256
FONT_SCALE :: 125

Assets :: struct {
	// LATER
	// cache: Cache,

	// GPU texture array for images
	texture_id:   u32,
	texture_size: i32,

	// GPU texture array for fonts (single-channel)
	font_texture_id:   u32,
	font_texture_size: i32,

	textures:	[..MAX_TEXTURES]Texture
	meshes:		[..MAX_MESHES]Mesh
	fonts:		[..MAX_FONTS]Font

	state: Stream_State,

	tex_stream: Tex_Stream,
	mesh_stream: Mesh_Stream,
	font_stream: Font_Stream,

	// Reference to VAO for mesh uploads
	vao: ^VAO_State,

	// Files found on disk
	on_disk: Disk,

	// Resolution state
	needs_resolve: bool,  // Set true to trigger a resolve pass
}


Tex_Stream :: struct {
	packer:        Texture_Packer
	cache_index:   i64
	current_layer: u32
	file_handle:   os.File_Id
	file_open:     bool
}

Mesh_Stream :: struct {
	cache_index:  i64
	file_handle:  os.File_Id
	file_open:    bool
}

Font_Stream :: struct {
	font_files:   [MAX_FONTS]str64
	current:      i64
	initialized:  bool
}

// // Initialize asset system - FAST, only loads cache TOC
init :: fun(a: ^Assets, vao: ^VAO_State, fname: []utf8) {
    a.vao = vao

    print("Look at that asset!")

    // default meshes
    prim_indices, prim_names := gfx.primitives_init(vao)
    for i in 0..prim_names.cap {
        &a.meshes + Mesh{prim_names[i], prim_indices[i]}
    }

    // GPU texture array setup
    a.texture_size = 2048

    gl.GenTextures(1, &a.texture_id)
    gl.BindTexture(gl.TEXTURE_2D_ARRAY, a.texture_id)
    gl.TexParameteri(gl.TEXTURE_2D_ARRAY, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE)
    gl.TexParameteri(gl.TEXTURE_2D_ARRAY, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE)
    gl.TexParameteri(gl.TEXTURE_2D_ARRAY, gl.TEXTURE_MIN_FILTER, gl.NEAREST)
    gl.TexParameteri(gl.TEXTURE_2D_ARRAY, gl.TEXTURE_MAG_FILTER, gl.NEAREST)

    // Allocate texture array on GPU
    gl.TexImage3D(gl.TEXTURE_2D_ARRAY, 0, gl.RGBA8,
        a.texture_size, a.texture_size, ATLAS_LAYERS,
        0, gl.RGBA, gl.UNSIGNED_BYTE, void)

    // White pixel at (0,0) layer 0 for default
    white := [4]u8{255, 255, 255, 255}
    gl.TexSubImage3D(gl.TEXTURE_2D_ARRAY, 0, 0, 0, 0, 1, 1, 1,
        gl.RGBA, gl.UNSIGNED_BYTE, &white)
    gl.BindTexture(gl.TEXTURE_2D_ARRAY, 0)

    // Register default texture so it can be queried by name
    &a.textures + DEFAULT_TEXTURE

    // GPU font texture array setup, one layer per font
    a.font_texture_size = 1024

    gl.GenTextures(1, &a.font_texture_id)
    gl.BindTexture(gl.TEXTURE_2D_ARRAY, a.font_texture_id)
    gl.TexParameteri(gl.TEXTURE_2D_ARRAY, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE)
    gl.TexParameteri(gl.TEXTURE_2D_ARRAY, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE)
    gl.TexParameteri(gl.TEXTURE_2D_ARRAY, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR)
    gl.TexParameteri(gl.TEXTURE_2D_ARRAY, gl.TEXTURE_MAG_FILTER, gl.LINEAR)

    gl.TexImage3D(gl.TEXTURE_2D_ARRAY, 0, gl.RGBA8,
        a.font_texture_size, a.font_texture_size, MAX_FONTS,
        0, gl.RGBA, gl.UNSIGNED_BYTE, void)
    gl.BindTexture(gl.TEXTURE_2D_ARRAY, 0)

    load_font_test(a, fname)
}

load_font_test :: fun(a: ^Assets, fname: []utf8) {
	this_font := &a.fonts[.len]

	print("font size:", a.fonts[.len].size)
	pixels := load_glyphs_and_metrics(fname,
		&this_font.glyphs, &this_font.metrics)

    gl.BindTexture(gl.TEXTURE_2D_ARRAY, a.font_texture_id)
    gl.TexSubImage3D(gl.TEXTURE_2D_ARRAY, 0,
        0, 0, i32(a.fonts.len),
        this_font.size, this_font.size, 1,
        gl.RGB, gl.UNSIGNED_BYTE, &pixels)
    gl.GenerateMipmap(gl.TEXTURE_2D_ARRAY)
    gl.BindTexture(gl.TEXTURE_2D_ARRAY, 0)

    this_font.layer = u32(a.fonts.len)
    this_font.name = fname
    a.fonts.len += 1

    print(a.fonts[.len - 1].name)
}

