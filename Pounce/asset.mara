module asset

use mara.core

use mara.os
use mara.font

use gfx

DEFAULT_MESH :: Mesh{"=quad", 0}
DEFAULT_TEXTURE :: Texture{"DEFAULT", {0, 0, 0, 0}, 0}  // 1x1 white pixel at (0,0)
ATLAS_TEXTURE :: Texture{"ATLAS", {1, 1, 0, 0}, 0}      // entire atlas layer 0

Texture :: struct {
	name:  str64
	uv:    [4]f32,  // scale_x, scale_y, offset_x, offset_y
	layer: u32,     // texture array layer
}

Mesh :: struct {
	name:  str64
	index: i32,
}

Font :: struct {
	w, h : i32,
	name: str64
	layer: u32,
	offset_x, offset_y: i32,  // Position within atlas layer
	metrics: Line_Metrics     // from mara.font, same type load_glyphs returns
	glyphs: [256]Glyph
}

// Streaming state
Stream_State :: union {
	Idle,           // Nothing to do
	Streaming,      // Loading assets from cache
	Done,           // All assets loaded
}

// Files found on disk in the data directory
Disk :: struct {
	models:		[..MAX_MESHES]str64
	textures:	[..MAX_TEXTURES]str64
	audio:		[..MAX_AUDIO]str64
	fonts:		[..MAX_FONTS]str64
}

// Asset system
Assets :: struct {
	// Cache TOC (loaded at init, fast)
	// cache: Cache_V3,

	// GPU texture array for images
	texture_id:   u32,
	texture_size: i32,

	// GPU texture array for fonts (single-channel)
	font_texture_id:   u32,
	font_texture_size: i32,

	textures:	[..MAX_TEXTURES]Texture
	meshes:		[..MAX_MESHES]Mesh
	fonts:		[..MAX_FONTS]Font


	state: Stream_State,

	tex_stream: Tex_Stream,
	mesh_stream: Mesh_Stream,
	font_stream: Font_Stream,

	// Reference to VAO for mesh uploads
	vao: ^VAO_State,

	// Files found on disk
	on_disk: Disk,

	// Resolution state
	needs_resolve: bool,  // Set true to trigger a resolve pass
}

MAX_TEXTURES :: 1024
MAX_MESHES :: 512
MAX_FONTS :: 64
MAX_AUDIO :: 256
ATLAS_LAYERS :: 16
FONT_RANGE :: 256
FONT_SCALE :: 125

// Texture streaming state
Tex_Stream :: struct {
	packer:        Texture_Packer,
	cache_index:   i64,
	current_layer: u32,
	file_handle:   os.File_Id,
	file_open:     bool,
}

// Mesh streaming state
Mesh_Stream :: struct {
	cache_index:  i64,
	file_handle:  os.File_Id,
	file_open:    bool,
}

// Font streaming state
Font_Stream :: struct {
	font_files:   [dynamic]string,  // paths to TTF/OTF files
	current:      int,              // current font being loaded
	initialized:  bool,
}

