module asset

use mara.core
use mara.font

DEFAULT_MESH :: Mesh{"=quad", 0}
DEFAULT_TEXTURE :: Texture{"DEFAULT", {0, 0, 0, 0}, 0}  // 1x1 white pixel at (0,0)
ATLAS_TEXTURE :: Texture{"ATLAS", {1, 1, 0, 0}, 0}      // entire atlas layer 0

Texture :: struct {
    name:  str64
    uv:    [4]f32,  // scale_x, scale_y, offset_x, offset_y
    layer: u32,     // texture array layer
}

Mesh :: struct {
    name:  str64
    index: i32,
}

Font :: struct {
    w, h : i32,
    name: str64
    layer: u32,
    offset_x, offset_y: i32,  // Position within atlas layer
    metrics: Line_Metrics     // from mara.font, same type load_glyphs returns
    glyphs: [256]Glyph
}
