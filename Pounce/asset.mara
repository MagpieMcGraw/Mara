module asset

use mara.core

use mara.files
use mara.skyline
use mara.font
gl :: use mara.open_gl

use object
use gfx
use cache

Font :: struct {
	size : i32 = 1024
	name: str64
	layer: u32,
	offset_x, offset_y: i32,  // position within the atlas layer
	metrics: Line_Metrics
	glyphs: [256]Glyph
}

Stream_State :: union {
	Idle, Streaming, Done
}

// Files found on disk in the data directory
Disk :: struct {
	models:		[MAX_MESHES]str64
	textures:	[MAX_TEXTURES]str64
	audio:		[MAX_AUDIO]str64
	fonts:		[MAX_FONTS]str64
}

MAX_TEXTURES :: 1024
MAX_MESHES :: 512
MAX_FONTS :: 64
MAX_AUDIO :: 256
ATLAS_LAYERS :: 16
FONT_RANGE :: 256
FONT_SCALE :: 125

Assets :: struct {
	// GPU texture array for images
	texture_id:   u32,
	texture_size: i32,

	// GPU texture array for fonts
	font_texture_id:   u32,
	font_texture_size: i32,

	textures:	[MAX_TEXTURES]Texture
	meshes:		[MAX_MESHES]Mesh
	fonts:		[MAX_FONTS]Font

	state: Stream_State,

	tex_stream := Tex_Stream()
	mesh_stream: Mesh_Stream,
	font_stream: Font_Stream,

	vao: ^VAO_State,

	on_disk: Disk,

	needs_resolve: bool,  // set to trigger a resolve pass
}

Tex_Stream :: struct {
	packer: = Skyline(1024, 1024)
	cache_index:   i64
	current_layer: u32
	file_handle:   File_Id
	file_open:     bool
}

Mesh_Stream :: struct {
	cache_index:  i64
	file_handle:  File_Id
	file_open:    bool
}

Font_Stream :: struct {
	font_files:   [MAX_FONTS!]str64
	current:      i64
	initialized:  bool
}

init :: fun(a: ^Assets, vao: ^VAO_State, fname: []utf8) {
    a.vao = vao
    target :: gl.TEXTURE_2D_ARRAY

    prim_indices, prim_names := gfx.primitives_init(vao)
    for i in 0:prim_names.cap {
        &a.meshes ++ Mesh{prim_names[i], prim_indices[i]}
    }

    // Image texture array
    a.texture_size = 2048

    gl.GenTextures(1, &a.texture_id)
    gl.BindTexture(target, a.texture_id)
    gl.TexParameteri(target, gl.TEXTURE_WRAP_S, i32(gl.CLAMP_TO_EDGE))
    gl.TexParameteri(target, gl.TEXTURE_WRAP_T, i32(gl.CLAMP_TO_EDGE))
    gl.TexParameteri(target, gl.TEXTURE_MIN_FILTER, i32(gl.NEAREST))
    gl.TexParameteri(target, gl.TEXTURE_MAG_FILTER, i32(gl.NEAREST))

    gl.TexImage3D(target, 0, gl.RGBA8,
        a.texture_size, a.texture_size, ATLAS_LAYERS,
        0, gl.RGBA, gl.UNSIGNED_BYTE, void)

    // A white pixel at (0,0), layer 0: the default texture
    white := [4!]u8{255, 255, 255, 255}
    gl.TexSubImage3D(target, 0, 0, 0, 0, 1, 1, 1,
        gl.RGBA, gl.UNSIGNED_BYTE, &white[0])
    gl.BindTexture(target, 0)

    &a.textures ++ DEFAULT_TEXTURE

    // Font texture array, one layer per font
    a.font_texture_size = 1024

    gl.GenTextures(1, &a.font_texture_id)
    gl.BindTexture(target, a.font_texture_id)
    gl.TexParameteri(target, gl.TEXTURE_WRAP_S, i32(gl.CLAMP_TO_EDGE))
    gl.TexParameteri(target, gl.TEXTURE_WRAP_T, i32(gl.CLAMP_TO_EDGE))
    gl.TexParameteri(target, gl.TEXTURE_MIN_FILTER,
        i32(gl.LINEAR_MIPMAP_LINEAR))
    gl.TexParameteri(target, gl.TEXTURE_MAG_FILTER, i32(gl.LINEAR))

    gl.TexImage3D(target, 0, gl.RGBA8,
        a.font_texture_size, a.font_texture_size, MAX_FONTS,
        0, gl.RGBA, gl.UNSIGNED_BYTE, void)
    gl.BindTexture(target, 0)

    load_font_test(a, fname)
}

load_font_test :: fun(a: ^Assets, fname: []utf8) {
	this_font := &a.fonts[.len]
	this_font^ = Font()
	pixels : [MSDF_ATLAS * MSDF_ATLAS * 3]byte
	e := load_glyphs_and_metrics(fname,
		&this_font.glyphs, &this_font.metrics, &pixels)
	if bool(e) {
		print("font", fname, "didn't load:", e)
		return
	}

    gl.BindTexture(gl.TEXTURE_2D_ARRAY, a.font_texture_id)
    gl.TexSubImage3D(gl.TEXTURE_2D_ARRAY, 0,
        0, 0, i32(a.fonts.len),
        this_font.size, this_font.size, 1,
        gl.RGB, gl.UNSIGNED_BYTE, pixels[0:pixels.cap].ptr)
    gl.GenerateMipmap(gl.TEXTURE_2D_ARRAY)
    gl.BindTexture(gl.TEXTURE_2D_ARRAY, 0)

    this_font.layer = u32(a.fonts.len)
    this_font.name = fname
    a.fonts.len += 1
}

// Packs textures into an atlas, no GL calls
Texture_Packer :: struct {
    pack_ctx: [64!]byte, 	// placeholder
    pack_nodes: [64!]byte,	// placeholder
    size: i32,
    is_full: bool,
}
