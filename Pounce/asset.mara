module asset

use mara.string
use mara.font

Texture :: struct {
    name:  str,
    uv:    [4]f32,  // scale_x, scale_y, offset_x, offset_y
    layer: u32,     // texture array layer
}

Mesh :: struct {
    name:  str,
    index: i32,
}
// ascent / descent / line_gap

Font :: struct {
    w, h : i32,
    name: str,
    layer: u32,
    offset_x, offset_y: i32,  // Position within atlas layer
    metrics: Metrics
    glyphs: [256]Glyph

    Metrics :: struct {
    	ascent, descent, line_gap : f32
    }
}