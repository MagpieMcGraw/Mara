module mara.core

// Slice :: class {
// 	len: i8..=isize
// 	cap: i8..=isize
// 	ptr: isize
// }

overload + add
add :: dispatch{ array_add }

slice_add :: fun(dst: ^[]$T, src: []$T) {
	dst[dst.len:] = src[:src.cap] // would this even work?
	dst.len += src.len
}

// maybe make these private?
Arena :: struct {
	size: [64]byte

	mark :: fun(a: ^Self) {
	}
	alloc :: fun(a: ^Self, size: i64) -> []byte	{
	}
	reset :: fun(a: ^Self) {
	}
	dump :: fun(a: ^Self, size: i64, name, span: ^byte)	{
	}
}

Program :: struct (ar_shape: ~Arena = void) {
	scope_allocator: ar_shape
	args: [..64][, 0]utf8
}