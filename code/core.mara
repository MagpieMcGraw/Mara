module mara.core

// string literal types
str64 :: type [..64]utf8
str256 :: type [..256]utf8
str1024 :: type [..1024]utf8

// utf8 arrays auto convert to this, and write a 0 byte.
// cstring :: distinct ^utf8

overload + add
add :: dispatch{ slice_add, slice_add_item }

slice_add :: fun(dst: ^[]$T, src: []$T) {
	assert(dst.len + src.len <= dst.cap)
	dst[dst.len:] = src
	dst.len += src.len
}

slice_add_item :: fun(dst: ^[]$T, src: $T) {
	assert(dst.len < dst.cap)
	dst[dst.len] = src
	dst.len += 1
}

Arena :: struct {
	size: [64]byte

	mark :: fun(a: ^Self) {
	}
	alloc :: fun(a: ^Self, size: i64) -> []byte	{
	}
	reset :: fun(a: ^Self) {
	}
	dump :: fun(a: ^Self, size: i64, name, span: ^byte)	{
	}
}

Program :: struct (ar_shape: ~Arena = void) {
	scope_allocator: ar_shape
	args: [..64][]utf8
}