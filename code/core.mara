module mara.core

str64 :: alias [64]utf8
str256 :: alias [256]utf8
str1024 :: alias [1024]utf8

KB :: 1 << 10 // 1024
MB :: 1 << 20 // 1024 * 1024
GB :: 1 << 30 // 1024 * 1024 * 1024

overload ++ add
// `&list ++ x` appends x to the list. `list ++ x` joins them into a new list.
// An append gives its list back, so appends chain: `&name ++ dir ++ "/"`.
// Nothing is written after what's appended. Text for C needs a 0 after it:
// a new list is all 0, and `name = []` makes a used one all 0 again
// (`name.len = 0` keeps its old characters).
add :: dispatch{ byte_add_item, slice_add, slice_add_item, join, join_item }

// `a == b`, `a != b` on lists and slices: whether both hold the same items.
// Text is a list of characters, so this is how texts compare.
overload == equal
equal :: dispatch{ slice_equal }
overload != not_equal
not_equal :: dispatch{ slice_not_equal }

// Whether a and b hold the same items in the same order.
slice_equal :: fun(a: []$T, b: []$T) -> bool {
	if a.len != b.len do return false
	for x, i in a {
		if x != b[i] do return false
	}
	return true
}

// Whether a and b differ: in how many items they hold, or in one of them.
slice_not_equal :: fun(a: []$T, b: []$T) -> bool {
	return not slice_equal(a, b)
}

// Appends one byte, given as a u8, to dst; it must fit in dst's capacity.
byte_add_item :: fun(dst: ^[]byte, src: u8) -> ^[]byte {
	n := dst.len
	dst[n] = src
	dst.len = n + 1
	return dst
}

// Appends items to dst; they must fit in dst's capacity. A slicing of a
// fixed array is full: set its len to 0 first to fill it.
slice_add :: fun(dst: ^[]$T, src: []$T) -> ^[]T {
	n := dst.len
	dst[n:] = src
	dst.len = n + src.len
	return dst
}

// Appends one item to dst; it must fit in dst's capacity.
slice_add_item :: fun(dst: ^[]$T, src: $T) -> ^[]T {
	n := dst.len
	dst[n] = src
	dst.len = n + 1
	return dst
}

// A new list: a's items, then b's — of a's own type, its room (a Path
// joined is a Path: `cwd ++ "/code"`), a itself as it was. `a ++ b`. Past the
// room, the program stops, as an add does. (`&a ++ b` adds into a itself.)
join :: fun(a: [$N]$T, b: []T) -> [N]T {
	out := a
	&out ++ b
	return out
}

// A new list: a's items, then one more — of a's own type. `a ++ item`.
join_item :: fun(a: [$N]$T, b: T) -> [N]T {
	out := a
	&out ++ b
	return out
}

// returns a pointer to the next empty item in the list
// and increments the .len by 1
next :: fun(list: ^[]$T) -> ^T {
	/*
	we could zero the slot that's about to get written
	array append could be written as next(&list)^ = x
	*/
	n := list.len
	assert(n < list.cap)
	list.len = n + 1
	return &list[n]
}

// `x in xs`: whether some item of xs is x — includes(xs, x) — and `x not in
// xs`, whether none is. A list, an array, a view; through one pointer too
// (`this_file not in files`, files a ^[]Filename). (An overload names a
// dispatch group: includes is this one's one member.)
overload in in_items
in_items :: dispatch{ includes }

// Whether some item of items is x, `==` as their types have it: numbers the
// same number; text the same characters, letters' case minded, of any room
// (a str64 item, x a view). The items one at a time, from the first.
includes :: fun(items: []$T, x: $U) -> bool {
	for item in items {
		if item == x do return true
	}
	return false
}

// The items `keep` says yes to, in their order, into storage after what's
// there: a view of them. keep is any function taking an item and giving a
// bool — `filter(entries, is_mara, &storage)`. Room for every item is taken
// from storage, its len moved past it all, kept or not; the view's room is
// that much (more appends to it fit). Short of room, the program stops (as
// slice() does).
filter :: fun(items: []$T, keep: $P, storage: ^[]byte) -> []T {
	new := slice([:items.len]T, storage)
	for item in items {if keep(item) do &new ++ item}
	return new
}
