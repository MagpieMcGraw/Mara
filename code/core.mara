module mara.core

// string literal types
str64 :: type [..64]utf8
str256 :: type [..256]utf8
str1024 :: type [..1024]utf8

// FFI boundary type — legal only in foreign signatures. utf8 partial arrays
// auto-convert (a 0 byte is written at [len]; needs len < cap) and string
// literals convert free (their rodata carries the \0). NB the checker
// recognizes this type by FLAT NAME (CSTRING_FLAT_NAME in type_checker.odin,
// "mara_core_cstring") — moving the decl to another module breaks the
// conversion rules until that constant is updated to match.
cstring :: distinct ^utf8

overload + add
add :: dispatch{ slice_add, slice_add_item }

slice_add :: fun(dst: ^[]$T, src: []$T) {
	assert(dst.len + src.len <= dst.cap)
	dst[dst.len:] = src
	dst.len += src.len
}

slice_add_item :: fun(dst: ^[]$T, src: $T) {
	assert(dst.len < dst.cap)
	dst[dst.len] = src
	dst.len += 1
}

Arena :: struct {
	size: [64]byte

	mark :: fun(a: ^Self) {
	}
	alloc :: fun(a: ^Self, size: i64) -> []byte	{
	}
	reset :: fun(a: ^Self) {
	}
	dump :: fun(a: ^Self, size: i64, name, span: ^byte)	{
	}
}

Program :: struct (ar_shape: ~Arena = void) {
	scope_allocator: ar_shape
	args: [..64][]utf8
}