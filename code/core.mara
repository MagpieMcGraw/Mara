module mara.core

// A text buffer of up to 64 characters: `name : str64`, then `&name + "text"`.
str64 :: [..64]utf8
// A text buffer of up to 256 characters (see str64).
str256 :: [..256]utf8
// A text buffer of up to 1024 characters (see str64).
str1024 :: [..1024]utf8

// `&list + x` appends to a text buffer or a list: text, one character, items or one item.
overload + add
// Appends to a text buffer or a list; which one runs depends on what is added.
add :: dispatch{ utf8_add, utf8_add_item, slice_add, slice_add_item }

// `a == b` on text: whether both hold the same characters.
overload == equal
// Whether two texts hold the same characters: `a == b`.
equal :: dispatch{ utf8_equal }

// `a != b` on text: whether their characters differ.
overload != not_equal
// Whether two texts' characters differ: `a != b`.
not_equal :: dispatch{ utf8_not_equal }

// Appends text to dst; it must fit in dst's capacity.
// (We write 0 after it, so dst stays a valid C string.)
utf8_add :: fun(dst: ^[]utf8, src: []utf8) {
	assert(dst.len + src.len <= dst.cap)
	dst[dst.len:] = src
	dst.len += src.len
	if dst.len < dst.cap do dst[dst.len] = 0
}

// Whether a and b hold the same characters.
utf8_equal :: fun(a: []utf8, b: []utf8) -> bool {
	if a.len != b.len do return false
	for c, i in a {
		if c != b[i] do return false
	}
	return true
}

// Whether a and b hold different characters.
utf8_not_equal :: fun(a: []utf8, b: []utf8) -> bool {
	return not utf8_equal(a, b)
}

// Appends one character to dst; it must fit in dst's capacity.
utf8_add_item :: fun(dst: ^[]utf8, src: utf8) {
	assert(dst.len < dst.cap)
	dst[dst.len] = src
	dst.len += 1
	if dst.len < dst.cap do dst[dst.len] = 0
}

// Appends items to dst; they must fit in dst's capacity.
slice_add :: fun(dst: ^[]$T, src: []$T) {
	assert(dst.len + src.len <= dst.cap)
	dst[dst.len:] = src
	dst.len += src.len
}

// Appends one item to dst; it must fit in dst's capacity.
slice_add_item :: fun(dst: ^[]$T, src: $T) {
	assert(dst.len < dst.cap)
	dst[dst.len] = src
	dst.len += 1
}

// The items `keep` says yes to, in their order, into storage after what's
// there: a view of them. keep is any function taking an item and giving a
// bool — `filter(entries, is_mara, &storage)`. Room for every item is taken
// from storage, its len moved past it all, kept or not; the view's room is
// that much (more appends to it fit). Short of room, the program stops (as
// slice() does).
filter :: fun(items: []$T, keep: $P, storage: ^[]byte) -> []T {
	new := slice([:items.len]T, storage)
	for item in items {if keep(item) do &new + item}
	return new
}

// Each item into the list for its kind, in their order: one list for each
// value of the enum kind gives back, indexed by it — `lists[Mara_File]`.
// kind is any function taking an item and giving a value of an enum:
// `group(entries, kind_of, &storage)`. Each kind is counted first, then
// room for its items carved from storage (its len moved past them all),
// then the items appended. Short of room, the program stops (as slice()
// does).
group :: fun(items: []$T, kind: fun(T) -> $K, storage: ^[]byte) -> [K][]T {
	counts : [K]i64
	for item in items {
		counts[kind(item)] += 1
	}
	lists : [K][]T
	for c, i in counts {
		lists[i] = slice([:c]T, storage)
	}
	for item in items {
		&lists[kind(item)] + item
	}
	return lists
}

// What an arena must have to be the program's allocator. Arena_Basic and
// Arena_Debug (mara.memory) are the ones to use.
Arena :: struct {
	size: [64]byte

	// Remembers where the arena is now; reset frees what came after.
	mark :: fun(a: ^Self) {
	}
	// Hands out size bytes.
	alloc :: fun(a: ^Self, size: i64) -> []byte	{
	}
	// Frees everything allocated since the last mark.
	reset :: fun(a: ^Self) {
	}
	// Reports that an allocation of size bytes didn't fit.
	dump :: fun(a: ^Self, size: i64, name, span: ^byte)	{
	}
}

// The running program, `this_program`: its command-line arguments and its
// allocator. args[0] is the program's own path, the rest what it was run
// with. Values of 1 KB or more live in the allocator, not on the stack: a
// program with any sets one at the top of main —
// `this_program = Program(Arena_Basic(16 * MB))`. That's the only write: any
// fun can read this_program, none can change it (no writes into it, no
// pointers or slices of it).
Program :: struct (ar_shape: ~Arena = void) {
	scope_allocator: ar_shape
	args: [..64][]utf8
}