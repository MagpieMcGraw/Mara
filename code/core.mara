module mara.core

str64 :: alias [64]utf8
str256 :: alias [256]utf8
str1024 :: alias [1024]utf8

KB :: 1 << 10 // 1024
MB :: 1 << 20 // 1024 * 1024
GB :: 1 << 30 // 1024 * 1024 * 1024

overload + add
// Appends to a text buffer or a list, or joins one to a new one; which one
// runs depends on what is added, and to what.
add :: dispatch{ utf8_add, utf8_add_item, slice_add, slice_add_item, join, join_item }

// `a == b` on text: whether both hold the same characters.
overload == equal
// Whether two texts hold the same characters: `a == b`.
equal :: dispatch{ utf8_equal }

// `a != b` on text: whether their characters differ.
overload != not_equal
// Whether two texts' characters differ: `a != b`.
not_equal :: dispatch{ utf8_not_equal }

// Appends text to dst; it must fit in dst's capacity. A slicing of a fixed
// array is full: set its len to 0 first to fill it.
// (We write 0 after it, so dst stays a valid C string.)
utf8_add :: fun(dst: ^[]utf8, src: []utf8) {
	n := dst.len
	assert(n + src.len <= dst.cap)
	dst[n:] = src
	end := n + src.len
	dst.len = end
	if end < dst.cap do dst[end] = 0
}

// Whether a and b hold the same characters.
utf8_equal :: fun(a: []utf8, b: []utf8) -> bool {
	if a.len != b.len do return false
	for c, i in a {
		if c != b[i] do return false
	}
	return true
}

// Whether a and b hold different characters.
utf8_not_equal :: fun(a: []utf8, b: []utf8) -> bool {
	return not utf8_equal(a, b)
}

// Appends one character to dst; it must fit in dst's capacity.
utf8_add_item :: fun(dst: ^[]utf8, src: utf8) {
	n := dst.len
	assert(n < dst.cap)
	dst[n] = src
	dst.len = n + 1
	if n + 1 < dst.cap do dst[n + 1] = 0
}

// Appends items to dst; they must fit in dst's capacity. A slicing of a
// fixed array is full: set its len to 0 first to fill it.
slice_add :: fun(dst: ^[]$T, src: []$T) {
	n := dst.len
	assert(n + src.len <= dst.cap)
	dst[n:] = src
	dst.len = n + src.len
}

// Appends one item to dst; it must fit in dst's capacity.
slice_add_item :: fun(dst: ^[]$T, src: $T) {
	n := dst.len
	assert(n < dst.cap)
	dst[n] = src
	dst.len = n + 1
}

// A new list: a's items, then b's — of a's own type, its room (a Path
// joined is a Path: `cwd + "/code"`), a itself as it was. `a + b`. Past the
// room, the program stops, as an add does. (`&a + b` adds into a itself.)
join :: fun(a: [$N]$T, b: []T) -> [N]T {
	out := a
	&out + b
	return out
}

// A new list: a's items, then one more — of a's own type. `a + item`.
join_item :: fun(a: [$N]$T, b: T) -> [N]T {
	out := a
	&out + b
	return out
}

// returns a pointer to the current item in a container
// and increments the .len by 1
next :: fun(list: ^[]$T) -> ^T {
	/*
	we could zero the slot that's about to get written
	array append could be written as next(&list)^ = x
	*/
	n := list.len
	assert(n < list.cap)
	list.len = n + 1
	return &list[n]
}

// `x in xs`: whether some item of xs is x — includes(xs, x) — and `x not in
// xs`, whether none is. A list, an array, a view; through one pointer too
// (`this_file not in files`, files a ^[]Filename). (An overload names a
// dispatch group: includes is this one's one member.)
overload in in_items
in_items :: dispatch{ includes }

// Whether some item of items is x, `==` as their types have it: numbers the
// same number; text the same characters, letters' case minded, of any room
// (a str64 item, x a view). The items one at a time, from the first.
includes :: fun(items: []$T, x: $U) -> bool {
	for item in items {
		if item == x do return true
	}
	return false
}

// The items `keep` says yes to, in their order, into storage after what's
// there: a view of them. keep is any function taking an item and giving a
// bool — `filter(entries, is_mara, &storage)`. Room for every item is taken
// from storage, its len moved past it all, kept or not; the view's room is
// that much (more appends to it fit). Short of room, the program stops (as
// slice() does).
filter :: fun(items: []$T, keep: $P, storage: ^[]byte) -> []T {
	new := slice([:items.len]T, storage)
	for item in items {if keep(item) do &new + item}
	return new
}

// What an arena must have to be the program's allocator. Arena_Basic and
// Arena_Debug (mara.memory) are the ones to use.
Arena :: struct {
	size: [64!]byte

	// Remembers where the arena is now; reset frees what came after.
	mark :: fun(a: ^Self) {
	}
	// Hands out size bytes.
	alloc :: fun(a: ^Self, size: i64) -> []byte	{
	}
	// Frees everything allocated since the last mark.
	reset :: fun(a: ^Self) {
	}
	// Reports that an allocation of size bytes didn't fit.
	dump :: fun(a: ^Self, size: i64, name, span: ^byte)	{
	}
}