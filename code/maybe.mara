module mara.maybe

// Generic optional type. Holds either `None` (nothing) or `Some{value: T}`
// (a wrapped T). A pointer needs none: its `void` is its null.
//
// Usage:
//
//     m : Maybe(i64) = Some{value = 42}
//     match m {
//     None     return -1
//     Some s   return s.value
//     }
Maybe :: union($T: type) {
	None
	Some {
		value: T
	}
}
