sin :: dispatch {
	sin_f32
	sin_f64
}
// sin x, x in radians. An infinity or a NaN: NaN.
sin_f32 :: fun(x: f32) -> f32 {
	d := f64(x)
	ix := (f64_bits(d) >> 32) & 0x7fffffff
	if ix <= 0x3fe921fb {
		if ix < 0x3e400000 do return x
		return f32(sin_poly(d))
	}
	if ix >= 0x7ff00000 do return x - x
	n, y, _ := rem_pio2(d)
	q := n & 3
	if q == 0 do return f32(sin_poly(y))
	if q == 1 do return f32(cos_poly(y))
	if q == 2 do return f32(-sin_poly(y))
	return f32(-cos_poly(y))
}
sin_f64 :: fun(x: f64) -> f64 {
	ix := (f64_bits(x) >> 32) & 0x7fffffff
	if ix <= 0x3fe921fb {   // (|x| ~<= π/4)
		if ix < 0x3e400000 do return x   // (|x| < 2^-27: sin x is x, to the bit)
		return sin_kernel(x, 0.0)
	}
	if ix >= 0x7ff00000 do return x - x
	n, y0, y1 := rem_pio2(x)
	q := n & 3
	if q == 0 do return sin_kernel(y0, y1)
	if q == 1 do return cos_kernel(y0, y1)
	if q == 2 do return -sin_kernel(y0, y1)
	return -cos_kernel(y0, y1)
}

cos :: dispatch {
	cos_f32
	cos_f64
}
// cos x, x in radians. An infinity or a NaN: NaN.
cos_f32 :: fun(x: f32) -> f32 {
	d := f64(x)
	ix := (f64_bits(d) >> 32) & 0x7fffffff
	if ix <= 0x3fe921fb do return f32(cos_poly(d))
	if ix >= 0x7ff00000 do return x - x
	n, y, _ := rem_pio2(d)
	q := n & 3
	if q == 0 do return f32(cos_poly(y))
	if q == 1 do return f32(-sin_poly(y))
	if q == 2 do return f32(-cos_poly(y))
	return f32(sin_poly(y))
}
cos_f64 :: fun(x: f64) -> f64 {
	ix := (f64_bits(x) >> 32) & 0x7fffffff
	if ix <= 0x3fe921fb {
		if ix < 0x3e46a09e do return 1.0   // (|x| < 2^-27·√2: cos x is 1, to the bit)
		return cos_kernel(x, 0.0)
	}
	if ix >= 0x7ff00000 do return x - x
	n, y0, y1 := rem_pio2(x)
	q := n & 3
	if q == 0 do return cos_kernel(y0, y1)
	if q == 1 do return -sin_kernel(y0, y1)
	if q == 2 do return -cos_kernel(y0, y1)
	return sin_kernel(y0, y1)
}

acos :: dispatch {
	acos_f32
	acos_f64
}
// acos x, in [0, π]. |x| past 1, or a NaN: NaN.
acos_f32 :: fun(x: f32) -> f32 { return f32(acos_f64(f64(x))) }
acos_f64 :: fun(x: f64) -> f64 {
	hx := f64_bits(x)
	ix := (hx >> 32) & 0x7fffffff
	if ix >= 0x3ff00000 {   // (|x| >= 1, or a NaN)
		if ix == 0x3ff00000 and (hx & 0xffffffff) == 0 {
			if (hx >> 63) == 0 do return 0.0
			return PI_HI + 2.0 * PIO2_LO
		}
		return (x - x) / (x - x)
	}
	if ix < 0x3fe00000 {   // (|x| < ½)
		if ix <= 0x3c600000 do return PIO2_HI + PIO2_LO
		// (π/2 − x kept exact, x·R(x²) and π/2's low part added, rounded once.)
		ah, al := two_sum_f64(PIO2_HI, -x)
		return ah + (al + (PIO2_LO - x * acos_r(x * x)))
	}
	if (hx >> 63) == 1 {   // (x < -½: π − 2·asin √((1 + x)/2))
		// (√z in double-double, s + c; π − 2s kept exact.)
		z := (1.0 + x) * 0.5
		s := sqrt_f64(z)
		ph, pl := two_prod_f64(s, s)
		c := ((z - ph) - pl) / (2.0 * s)
		ah, al := two_sum_f64(PI_HI, -2.0 * s)
		return ah + (al - 2.0 * ((c + acos_r(z) * s) - PIO2_LO))
	}
	// (x > ½: 2·asin √((1 − x)/2), √ split so its square is exact)
	z := (1.0 - x) * 0.5
	s := sqrt_f64(z)
	df := f64_from_bits((f64_bits(s) >> 32) << 32)
	c := (z - df * df) / (s + df)
	w := acos_r(z) * s + c
	return 2.0 * (df + w)
}

pow :: dispatch {
	pow_f32
	pow_f64
}
// base to the power exp — C's pow's results, its special cases too: x^0 and
// 1^y are 1 (a NaN's too); a negative x to a power not whole, NaN; zeros and
// infinities as C has them.
pow_f32 :: fun(base: f32, exp: f32) -> f32 {
	x := f64(base)
	y := f64(exp)
	sign := 1.0
	ix := f64_bits(x)
	if ix == 0 or ix >= 0x7ff0000000000000 or not (abs_f64(y) < 18446744073709551616.0) {
		done, v, s := pow_special(x, y)
		if done do return f32(v)
		sign = s
	}
	// (In f64 only: z = y·ln x to 2^-45 or so, plenty for f32.)
	z := y * pow_log_short(abs_f64(x))
	if z > 100.0 do return f32(sign * f64_from_bits(0x7ff0000000000000))
	if z < -110.0 do return f32(sign * 0.0)
	return f32(sign * pow_exp_short(z))
}
pow_f64 :: fun(base: f64, exp: f64) -> f64 {
	y := exp
	sign := 1.0
	ix := f64_bits(base)
	if ix == 0 or ix >= 0x7ff0000000000000 or not (abs_f64(y) < 18446744073709551616.0) {
		// (Not the usual case — x positive and finite, y finite, not past
		// 2^64 — which needs none of the special ones.)
		done, v, s := pow_special(base, y)
		if done do return v
		sign = s
	}
	// (y·ln x: ln x as lh + ll; each of y and lh split at 26 bits, so the
	// product's high part is exact.)
	lh, ll := pow_log(abs_f64(base))
	yh := f64_from_bits(f64_bits(y) & 0xfffffffff8000000)
	yl := y - yh
	lhh := f64_from_bits(f64_bits(lh) & 0xfffffffff8000000)
	lhl := (lh - lhh) + ll
	return sign * pow_exp(yh * lhh, yl * lhh + y * lhl)
}

// pow's special cases, C's: done, and its value — or not done, and the
// result's sign: −1 for a negative x to an odd y.
pow_special :: fun(x: f64, y: f64) -> bool, f64, f64 {
	inf := f64_from_bits(0x7ff0000000000000)
	if y == 0.0 do return true, 1.0, 1.0
	if x == 1.0 do return true, 1.0, 1.0
	if x != x or y != y do return true, x + y, 1.0
	ax := abs_f64(x)
	ay := abs_f64(y)
	if ay == inf {
		if ax == 1.0 do return true, 1.0, 1.0
		if (ax > 1.0) == (y > 0.0) do return true, inf, 1.0
		return true, 0.0, 1.0
	}
	whole := floor_f64(y) == y
	odd := whole and ay < 9007199254740992.0 and (i64(y) & 1) != 0
	negative := (f64_bits(x) >> 63) == 1
	if ax == inf or x == 0.0 {
		// (An infinity or a zero to y: one or the other, its sign x's for y odd.)
		r := 0.0
		if (ax == inf) == (y > 0.0) do r = inf
		if negative and odd do return true, -r, 1.0
		return true, r, 1.0
	}
	sign := 1.0
	if negative {
		if not whole do return true, (x - x) / (x - x), 1.0
		if odd do sign = -1.0
	}
	if ay > 18446744073709551616.0 {
		// (|y| past 2^64: ±1 stays 1 — so big a y is even — any other x
		// overflows, or underflows.)
		if ax == 1.0 do return true, 1.0, 1.0
		if (ax > 1.0) == (y > 0.0) do return true, sign * inf, 1.0
		return true, sign * 0.0, 1.0
	}
	return false, 0.0, sign
}

// A float's bits, and the float of bits — the same bits, another type: no
// work on the machine.
f64_bits :: fun(x: f64) -> u64 { @llvm.bitcast.f64 }
f64_from_bits :: fun(u: u64) -> f64 { @llvm.bitcast.i64 }

// Double-double: a sum of two f64s, the second what the first's rounding
// lost — 106 bits. a + b as one: its rounding and the rest.
two_sum_f64 :: fun(a: f64, b: f64) -> f64, f64 {
	s := a + b
	bb := s - a
	return s, (a - (s - bb)) + (b - bb)
}
// ... |a| at least |b|'s, quicker.
fast_two_sum_f64 :: fun(a: f64, b: f64) -> f64, f64 {
	s := a + b
	return s, b - (s - a)
}
// a·b as one: its rounding and the rest (Dekker's: each split in halves of
// 26 bits, whose products are exact).
two_prod_f64 :: fun(a: f64, b: f64) -> f64, f64 {
	p := a * b
	ah, al := split_f64(a)
	bh, bl := split_f64(b)
	return p, ((ah * bh - p) + ah * bl + al * bh) + al * bl
}
split_f64 :: fun(a: f64) -> f64, f64 {
	c := 134217729.0 * a   // (2^27 + 1)
	hi := c - (c - a)
	return hi, a - hi
}

// sin(x + y) for |x + y| <= π/4, y what reducing x left: x + S1·x³ +
// x⁵·R(x²) + y·cos x, fdlibm's polynomial (its __kernel_sin's). S1·x³ kept
// exact enough: x = xh + xl, xh x's top 13 bits — xh³ and S1's top 14 bits
// times it exact — then the rest of it added, rounded once.
sin_kernel :: fun(x: f64, y: f64) -> f64 {
	xh := f64_from_bits(f64_bits(x) & 0xffffff0000000000)
	xl := x - xh
	xh2 := xh * xh
	xh3 := xh2 * xh
	r3 := xl * (3.0 * xh2 + xl * (3.0 * xh + xl))   // (x³ − xh³)
	th := SIN_S1_HI * xh3
	tl := SIN_S1_LO * xh3 + SIN_S1 * r3
	z := x * x
	r := SIN_S2 + z * (SIN_S3 + z * (SIN_S4 + z * (SIN_S5 + z * SIN_S6)))
	sh, sl := fast_two_sum_f64(x, th)
	return sh + (sl + (tl + (z * z * x * r + y * (1.0 - 0.5 * z))))
}

// cos(x + y) for |x + y| <= π/4: 1 − x²/2 + x⁴·R(x²) − y·sin x, fdlibm's
// polynomial (its __kernel_cos's). 1 − x²/2 kept exact: x = xh + xl, xh x's
// top 26 bits — xh² exact — the rest of x² added, rounded once.
cos_kernel :: fun(x: f64, y: f64) -> f64 {
	xh := f64_from_bits(f64_bits(x) & 0xfffffffff8000000)
	zh := xh * xh
	zl := (x - xh) * (x + xh)   // (x² − xh²)
	z := x * x
	zz := z * z
	r := z * (COS_C1 + z * (COS_C2 + z * COS_C3)) + zz * zz * (COS_C4 + z * (COS_C5 + z * COS_C6))
	hz := 0.5 * zh
	w := 1.0 - hz
	return w + (((1.0 - w) - hz) + (z * r - 0.5 * zl - x * y))
}

// fdlibm's own kernels, in plain f64 (for the f32 ones): sin x and cos x,
// |x| <= π/4.
sin_poly :: fun(x: f64) -> f64 {
	z := x * x
	r := SIN_S2 + z * (SIN_S3 + z * (SIN_S4 + z * (SIN_S5 + z * SIN_S6)))
	return x + z * x * (SIN_S1 + z * r)
}
cos_poly :: fun(x: f64) -> f64 {
	z := x * x
	zz := z * z
	r := z * (COS_C1 + z * (COS_C2 + z * COS_C3)) + zz * zz * (COS_C4 + z * (COS_C5 + z * COS_C6))
	hz := 0.5 * z
	w := 1.0 - hz
	return w + (((1.0 - w) - hz) + z * r)
}

// x reduced by π/2: n, its quadrant (n & 3 is), and y0 + y1, what's left,
// |y0 + y1| <= π/4 or so — π/2 in three parts, each one more only when x
// is near a multiple of π/2 (fdlibm's __ieee754_rem_pio2, its medium
// case); past 2^20·π/2, rem_pio2_large.
rem_pio2 :: fun(x: f64) -> i64, f64, f64 {
	ix := (f64_bits(x) >> 32) & 0x7fffffff
	if ix >= 0x413921fb do return rem_pio2_large(x)
	// (Rounded by adding 1.5·2^52: the sum's bits past the constant's are
	// n, two's complement — no float made an int, so nothing to check;
	// |x·2/π| < 2^20 here.)
	big := x * INV_PIO2 + 6755399441055744.0
	nf := big - 6755399441055744.0
	n := i64(f64_bits(big)) -% 0x4338000000000000
	r := x - nf * PIO2_1
	w := nf * PIO2_1T
	y0 := r - w
	j := i64(ix >> 20)
	if j - i64((f64_bits(y0) >> 52) & 0x7ff) > 16 {
		t := r
		w = nf * PIO2_2
		r = t - w
		w = nf * PIO2_2T - ((t - r) - w)
		y0 = r - w
		if j - i64((f64_bits(y0) >> 52) & 0x7ff) > 49 {
			t = r
			w = nf * PIO2_3
			r = t - w
			w = nf * PIO2_3T - ((t - r) - w)
			y0 = r - w
		}
	}
	return n, y0, (r - y0) - w
}

// |x| past 2^20·π/2 reduced by π/2 (rem_pio2's), by 2/π's own bits: x·2/π
// is x's 53 bits times 2/π's — the bits before a window of 192 make whole
// turns (multiples of 4), the ones past it change no bit kept (Payne-Hanek).
// Its last two whole bits are the quadrant; its fraction (past ½: the next
// quadrant's, negative) times π/2 in double-double, y0 + y1.
rem_pio2_large :: fun(x: f64) -> i64, f64, f64 {
	hx := f64_bits(x)
	k := i64((hx >> 52) & 0x7ff) - 1075             // (|x| = m·2^k)
	m := (hx & 0xfffffffffffff) | 0x10000000000000
	two_over_pi : [40!]u64 = {
		0xA2F9836E, 0x4E441529, 0xFC2757D1, 0xF534DDC0, 0xDB629599, 0x3C439041,
		0xFE5163AB, 0xDEBBC561, 0xB7246E3A, 0x424DD2E0, 0x06492EEA, 0x09D1921C,
		0xFE1DEB1C, 0xB129A73E, 0xE88235F5, 0x2EBB4484, 0xE99C7026, 0xB45F7E41,
		0x3991D639, 0x835339F4, 0x9C845F8B, 0xBDF9283B, 0x1FF897FF, 0xDE05980F,
		0xEF2F118B, 0x5A0A6D1F, 0x6D367ECF, 0x27CB09B7, 0x4F463F66, 0x9E5FEA2D,
		0x7527BAC7, 0xEBE5F17B, 0x3D0739F7, 0x8A5292EA, 0x6BFB5FB1, 0x1F8D5D08,
		0x56033046, 0xFC7B6BAB, 0xF0CFBC20, 0x9AF4361D
	}
	// (Its window: bits i0 .. i0 + 191 of 2/π — bit i weighs 2^-i — six
	// words of 32, the first the most significant.)
	i0 := k - 1
	if i0 < 1 do i0 = 1
	q := (i0 - 1) / 32
	sh := u64((i0 - 1) % 32)
	win : [6!]u64
	for j in 0:6 {
		a := two_over_pi[q + j]
		if sh == 0 {
			win[j] = a
		else
			win[j] = ((a << sh) | (two_over_pi[q + j + 1] >> (32 - sh))) & 0xffffffff
		}
	}
	// (m times the window: 256 bits in eight 32-bit limbs, the least
	// significant first.)
	m_lo := m & 0xffffffff
	m_hi := m >> 32
	p : [8!]u64
	for a in 0:6 {
		f := win[5 - a]
		t := f * m_lo + p[a]
		p[a] = t & 0xffffffff
		t = f * m_hi + p[a + 1] + (t >> 32)
		p[a + 1] = t & 0xffffffff
		p[a + 2] = t >> 32
	}
	// (x·2/π = the product · 2^(k − i0 − 191): its binary point `point` bits up.)
	point := i0 + 191 - k
	n := i64(limb_bit(p[:], point) + 2 * limb_bit(p[:], point + 1))
	f1 : u64 = 0   // (the fraction's first 64 bits)
	f2 : u64 = 0   // (its next 64)
	for b in 1:65 {
		f1 = f1 | (limb_bit(p[:], point - b) << u64(64 - b))
		f2 = f2 | (limb_bit(p[:], point - 64 - b) << u64(64 - b))
	}
	// (As a double-double: four 32-bit pieces, each exact, summed exactly.)
	d1 := f64(f1 >> 32) * TWO_M32
	d2 := f64(f1 & 0xffffffff) * TWO_M32 * TWO_M32
	d3 := f64(f2 >> 32) * TWO_M32 * TWO_M32 * TWO_M32
	d4 := f64(f2 & 0xffffffff) * TWO_M32 * TWO_M32 * TWO_M32 * TWO_M32
	s3, e3 := two_sum_f64(d3, d4)
	s2, e2 := two_sum_f64(d2, s3)
	s1, e1 := two_sum_f64(d1, s2)
	fh, fl := fast_two_sum_f64(s1, e1 + e2 + e3)
	if fh > 0.5 or (fh == 0.5 and fl >= 0.0) {
		fh = fh - 1.0
		n += 1
	}
	ph, pl := two_prod_f64(fh, PIO2_HI)
	y0, y1 := fast_two_sum_f64(ph, pl + (fh * PIO2_LO + fl * PIO2_HI))
	if (hx >> 63) == 1 do return -n, -y0, -y1
	return n, y0, y1
}

// Bit b of a number in 32-bit limbs, the least significant first (b from 0).
limb_bit :: fun(p: []u64, b: i64) -> u64 {
	if b < 0 or b >= p.len * 32 do return 0
	return (p[b / 32] >> u64(b % 32)) & 1
}

// fdlibm's rational approximation in acos: (asin √z / √z − 1)/z, near enough.
acos_r :: fun(z: f64) -> f64 {
	p := z * (ACOS_PS0 + z * (ACOS_PS1 + z * (ACOS_PS2 + z * (ACOS_PS3 + z * (ACOS_PS4 + z * ACOS_PS5)))))
	q := 1.0 + z * (ACOS_QS1 + z * (ACOS_QS2 + z * (ACOS_QS3 + z * ACOS_QS4)))
	return p / q
}

// ln x, x positive and finite, as hi + lo: x = 2^k·z, z in [OFF, 2·OFF)
// (OFF: POW_LOG_OFF's bits, just under √½), c near z — a table's 1/c and log c, by z's top 7
// bits — then r = z·(1/c) − 1, |r| < 2^-7, exact: ln x = k·ln 2 + log c +
// log1p r, its first terms kept exact (r − r²/2 split so its square is),
// log1p r's rest a polynomial.
pow_log :: fun(x: f64) -> f64, f64 {
	ix := i64(f64_bits(x))
	if (ix >> 52) == 0 do ix = i64(f64_bits(x * 4503599627370496.0)) - 52 * 4503599627370496   // (subnormal: 2^52 up)
	tmp := ix - POW_LOG_OFF
	i := (tmp >> 45) & 127
	k := tmp >> 52
	iz := u64(ix - k * 4503599627370496)
	z := f64_from_bits(iz)
	invc := POW_INVC[i]
	zh := f64_from_bits((iz + 0x80000000) & 0xffffffff00000000)   // (z's top 21 bits)
	zl := z - zh
	rh := zh * invc - 1.0
	rl := zl * invc
	r := rh + rl
	kd := f64(k)
	t1 := kd * POW_LN2_HI + POW_LOGC_HI[i]   // (exact: both multiples of 2^-43)
	t2, lo2 := two_sum_f64(t1, r)
	lo1 := kd * POW_LN2_LO + POW_LOGC_LO[i]
	arh := -0.5 * rh
	arh2 := rh * arh   // (−rh²/2, exact)
	hi := t2 + arh2
	lo3 := rl * (arh - 0.5 * r)
	lo4 := (t2 - hi) + arh2
	r2 := r * r
	r4 := r2 * r2
	p := r * r2 * (0.3333333333333333 + r * (-0.25) + r2 * (0.2 + r * (-0.16666666666666666)) + r4 * (0.14285714285714285 + r * (-0.125) + r2 * (0.1111111111111111 + r * (-0.1))))
	lo := lo1 + lo2 + lo3 + lo4 + p
	y := hi + lo
	return y, (hi - y) + lo
}

// ln x for pow_f32, x a positive f32's: pow_log's way, f64 only.
pow_log_short :: fun(x: f64) -> f64 {
	ix := i64(f64_bits(x))
	tmp := ix - POW_LOG_OFF
	i := (tmp >> 45) & 127
	k := tmp >> 52
	z := f64_from_bits(u64(ix - k * 4503599627370496))
	r := z * POW_INVC[i] - 1.0
	r2 := r * r
	p := r2 * (-0.5 + r * 0.3333333333333333 + r2 * (-0.25 + r * 0.2 + r2 * -0.16666666666666666))
	kd := f64(k)
	return (kd * POW_LN2_HI + POW_LOGC_HI[i]) + (r + (p + (kd * POW_LN2_LO + POW_LOGC_LO[i])))
}

// e^x for pow_f32, |x| <= 110: pow_exp's way, f64 only.
pow_exp_short :: fun(x: f64) -> f64 {
	kd := floor_f64(x * POW_INV_LN2N + 0.5)
	r := (x - kd * POW_LN2N_HI) - kd * POW_LN2N_LO
	ki := i64(kd)
	j := ki & 127
	scale := f64_from_bits(u64(i64(f64_bits(POW_EXP2_HI[j])) + (ki >> 7) * 4503599627370496))
	r2 := r * r
	return scale + scale * (r + r2 * (0.5 + r * 0.16666666666666666 + r2 * 0.041666666666666664))
}

// e^(x + xtail), xtail what x left: x·128/ln 2 = kd + f, |f| <= ½ — e^x =
// 2^(kd/128)·e^r, r = x − kd·ln 2/128, |r| <= ln 2/256 — 2^(kd/128) =
// 2^top·2^(j/128), the second a table's; e^r − 1 a polynomial; rounded once,
// in scale + scale·tmp.
pow_exp :: fun(x: f64, xtail: f64) -> f64 {
	if x > 710.0 do return f64_from_bits(0x7ff0000000000000)
	if x < -746.0 do return 0.0
	kd := floor_f64(x * POW_INV_LN2N + 0.5)
	r := ((x - kd * POW_LN2N_HI) - kd * POW_LN2N_LO) + xtail
	ki := i64(kd)
	j := ki & 127
	top := ki >> 7
	rel := POW_EXP2_REL[j]
	r2 := r * r
	tmp := rel + (r + (r2 * (0.5 + r * 0.16666666666666666) + r2 * r2 * (0.041666666666666664 + r * 0.008333333333333333 + r2 * 0.001388888888888889) + rel * r))
	hb := i64(f64_bits(POW_EXP2_HI[j]))
	if top > -1000 and top < 1023 {
		scale := f64_from_bits(u64(hb + top * 4503599627370496))
		return scale + scale * tmp
	}
	if top >= 1023 {   // (2^1023 and up: halved, then doubled — overflowing, if it does)
		scale := f64_from_bits(u64(hb + (top - 1) * 4503599627370496))
		return 2.0 * (scale + scale * tmp)
	}
	// (Near 2^-1022 and below — scale·tmp subnormal, rounded too coarsely —
	// worked out 2^1022 up, then scaled back exactly: below 2^-1022, its last
	// bit 2^-1074's, rounded there once — by 1 + y, y < 1, which rounds there
	// too.)
	s := f64_from_bits(u64(hb + (top + 1022) * 4503599627370496))
	sl := s * tmp
	y := s + sl
	if y >= 1.0 do return y * f64_from_bits(u64(1) << 52)
	one := 1.0 + s
	rest := ((1.0 - one) + s) + sl
	return ((one + rest) - 1.0) * f64_from_bits(u64(1) << 52)
}

tan :: fun(angle: f32) -> f32 {
	return sin(angle) / cos(angle)
}

to_radians :: fun(degrees: f32) -> f32 {
	return degrees * PI / 180.0
}

// ============================================================================
// Vec3 operations
// ============================================================================

dot :: fun(a: Vec3, b: Vec3) -> f32 {
	return a.x * b.x + a.y * b.y + a.z * b.z
}

cross :: fun(a: Vec3, b: Vec3) -> Vec3 {
	result : Vec3
	result.x = a.y * b.z - a.z * b.y
	result.y = a.z * b.x - a.x * b.z
	result.z = a.x * b.y - a.y * b.x
	return result
}

vec3_length :: fun(v: Vec3) -> f32 {
	return sqrt(v.x * v.x + v.y * v.y + v.z * v.z)
}

vec3_normalize :: fun(v: Vec3) -> Vec3 {
	len := vec3_length(v)
	if len < 0.000001 { return v }
	result : Vec3
	result.x = v.x / len
	result.y = v.y / len
	result.z = v.z / len
	return result
}

vec3_add :: fun(a: Vec3, b: Vec3) -> Vec3 {
	result : Vec3
	result.x = a.x + b.x
	result.y = a.y + b.y
	result.z = a.z + b.z
	return result
}

vec3_add_scalar :: fun(v: Vec3, s: f32) -> Vec3 {
	result : Vec3
	result.x = v.x + s
	result.y = v.y + s
	result.z = v.z + s
	return result
}

vec3_sub :: fun(a: Vec3, b: Vec3) -> Vec3 {
	result : Vec3
	result.x = a.x - b.x
	result.y = a.y - b.y
	result.z = a.z - b.z
	return result
}

vec3_sub_scalar :: fun(v: Vec3, s: f32) -> Vec3 {
	result : Vec3
	result.x = v.x - s
	result.y = v.y - s
	result.z = v.z - s
	return result
}

vec3_scale :: fun(v: Vec3, s: f32) -> Vec3 {
	result : Vec3
	result.x = v.x * s
	result.y = v.y * s
	result.z = v.z * s
	return result
}

vec3_negate :: fun(v: Vec3) -> Vec3 {
	result : Vec3
	result.x = -v.x
	result.y = -v.y
	result.z = -v.z
	return result
}

vec3_mul :: fun(a: Vec3, b: Vec3) -> Vec3 {
	result : Vec3
	result.x = a.x * b.x
	result.y = a.y * b.y
	result.z = a.z * b.z
	return result
}

// ============================================================================
// Vec4 operations
// ============================================================================

vec4_length :: fun(v: Vec4) -> f32 {
	return sqrt(v.x * v.x + v.y * v.y + v.z * v.z + v.w * v.w)
}

vec4_normalize :: fun(v: Vec4) -> Vec4 {
	len := vec4_length(v)
	if len < 0.000001 { return v }
	result : Vec4
	result.x = v.x / len
	result.y = v.y / len
	result.z = v.z / len
	result.w = v.w / len
	return result
}

length :: dispatch {
	vec3_length
	vec4_length
}

normalize :: dispatch {
	vec3_normalize
	vec4_normalize
}

// ============================================================================
// Mat4 operations
// ============================================================================

mat4_mul :: fun(a: Mat4, b: Mat4) -> Mat4 {
	result : Mat4
	for col in 0:4 {
		for row in 0:4 {
			sum : f32 = 0.0
			for k in 0:4 {
				sum = sum + a[k][row] * b[col][k]
			}
			result[col][row] = sum
		}
	}
	return result
}

mat4_mul_vec4 :: fun(m: Mat4, v: Vec4) -> Vec4 {
	result : Vec4
	result.x = m.x.x * v.x + m.y.x * v.y + m.z.x * v.z + m.w.x * v.w
	result.y = m.x.y * v.x + m.y.y * v.y + m.z.y * v.z + m.w.y * v.w
	result.z = m.x.z * v.x + m.y.z * v.y + m.z.z * v.z + m.w.z * v.w
	result.w = m.x.w * v.x + m.y.w * v.y + m.z.w * v.z + m.w.w * v.w
	return result
}

mat4_identity :: fun() -> Mat4 {
	m : Mat4
	for i in 0:4 {
		m[i][i] = 1.0
	}
	return m
}

mat4_transpose :: fun(m: Mat4) -> Mat4 {
	r : Mat4
	for i in 0:4 {
		for j in 0:4 {
			r[i][j] = m[j][i]
		}
	}
	return r
}

mat4_translate :: fun(pos: Vec3) -> Mat4 {
	m := mat4_identity()
	m.w.x = pos.x
	m.w.y = pos.y
	m.w.z = pos.z
	return m
}

mat4_scale :: fun(s: Vec3) -> Mat4 {
	m : Mat4
	m.x.x = s.x
	m.y.y = s.y
	m.z.z = s.z
	m.w.w = 1.0
	return m
}

// Perspective projection (right-handed, clip space z: -1 to 1)
mat4_perspective :: fun(fov_y: f32, aspect: f32, near: f32, far: f32) -> Mat4 {
	m : Mat4
	t := tan(fov_y * 0.5)
	if abs(t) < 0.000001 { return m }
	m.x.x = 1.0 / (aspect * t)
	m.y.y = 1.0 / t
	m.z.z = -(far + near) / (far - near)
	m.z.w = -1.0
	m.w.z = -(2.0 * far * near) / (far - near)
	return m
}

// Orthographic projection (right-handed, clip space z: -1 to 1)
mat4_ortho :: fun(left: f32, right: f32, bottom: f32, top: f32, near: f32, far: f32) -> Mat4 {
	m : Mat4
	width  := right - left
	height := top - bottom
	depth  := far - near
	if abs(width) < 0.000001 or abs(height) < 0.000001 or abs(depth) < 0.000001 { return m }
	m.x.x = 2.0 / width
	m.y.y = 2.0 / height
	m.z.z = -2.0 / depth
	m.w.x = -(right + left) / width
	m.w.y = -(top + bottom) / height
	m.w.z = -(far + near) / depth
	m.w.w = 1.0
	return m
}

// 4x4 matrix inverse via cofactor expansion
mat4_inverse :: fun(m: Mat4) -> Mat4 {
	b00 := m[0][0] * m[1][1] - m[0][1] * m[1][0]
	b01 := m[0][0] * m[1][2] - m[0][2] * m[1][0]
	b02 := m[0][0] * m[1][3] - m[0][3] * m[1][0]
	b03 := m[0][1] * m[1][2] - m[0][2] * m[1][1]
	b04 := m[0][1] * m[1][3] - m[0][3] * m[1][1]
	b05 := m[0][2] * m[1][3] - m[0][3] * m[1][2]
	b06 := m[2][0] * m[3][1] - m[2][1] * m[3][0]
	b07 := m[2][0] * m[3][2] - m[2][2] * m[3][0]
	b08 := m[2][0] * m[3][3] - m[2][3] * m[3][0]
	b09 := m[2][1] * m[3][2] - m[2][2] * m[3][1]
	b10 := m[2][1] * m[3][3] - m[2][3] * m[3][1]
	b11 := m[2][2] * m[3][3] - m[2][3] * m[3][2]

	det := b00 * b11 - b01 * b10 + b02 * b09 + b03 * b08 - b04 * b07 + b05 * b06
	assert(abs(det) >= 0.000001)   // singular matrix has no inverse

	inv_det := 1.0 / det
	r : Mat4
	r[0][0] = ( m[1][1] * b11 - m[1][2] * b10 + m[1][3] * b09) * inv_det
	r[0][1] = (-m[0][1] * b11 + m[0][2] * b10 - m[0][3] * b09) * inv_det
	r[0][2] = ( m[3][1] * b05 - m[3][2] * b04 + m[3][3] * b03) * inv_det
	r[0][3] = (-m[2][1] * b05 + m[2][2] * b04 - m[2][3] * b03) * inv_det
	r[1][0] = (-m[1][0] * b11 + m[1][2] * b08 - m[1][3] * b07) * inv_det
	r[1][1] = ( m[0][0] * b11 - m[0][2] * b08 + m[0][3] * b07) * inv_det
	r[1][2] = (-m[3][0] * b05 + m[3][2] * b02 - m[3][3] * b01) * inv_det
	r[1][3] = ( m[2][0] * b05 - m[2][2] * b02 + m[2][3] * b01) * inv_det
	r[2][0] = ( m[1][0] * b10 - m[1][1] * b08 + m[1][3] * b06) * inv_det
	r[2][1] = (-m[0][0] * b10 + m[0][1] * b08 - m[0][3] * b06) * inv_det
	r[2][2] = ( m[3][0] * b04 - m[3][1] * b02 + m[3][3] * b00) * inv_det
	r[2][3] = (-m[2][0] * b04 + m[2][1] * b02 - m[2][3] * b00) * inv_det
	r[3][0] = (-m[1][0] * b09 + m[1][1] * b07 - m[1][2] * b06) * inv_det
	r[3][1] = ( m[0][0] * b09 - m[0][1] * b07 + m[0][2] * b06) * inv_det
	r[3][2] = (-m[3][0] * b03 + m[3][1] * b01 - m[3][2] * b00) * inv_det
	r[3][3] = ( m[2][0] * b03 - m[2][1] * b01 + m[2][2] * b00) * inv_det
	return r
}

// Build rotation matrix from quaternion (column-major, same layout as Odin linalg)
mat4_from_quat :: fun(q: Quat) -> Mat4 {
	xx := q.x * q.x
	yy := q.y * q.y
	zz := q.z * q.z
	xy := q.x * q.y
	xz := q.x * q.z
	yz := q.y * q.z
	wx := q.w * q.x
	wy := q.w * q.y
	wz := q.w * q.z

	m := mat4_identity()
	m.x.x = 1.0 - 2.0 * (yy + zz)
	m.x.y = 2.0 * (xy + wz)
	m.x.z = 2.0 * (xz - wy)

	m.y.x = 2.0 * (xy - wz)
	m.y.y = 1.0 - 2.0 * (xx + zz)
	m.y.z = 2.0 * (yz + wx)

	m.z.x = 2.0 * (xz + wy)
	m.z.y = 2.0 * (yz - wx)
	m.z.z = 1.0 - 2.0 * (xx + yy)
	return m
}

// ============================================================================
// Quaternion operations  (Quat = [x, y, z, w])
// ============================================================================

quat_angle_axis :: fun(angle: f32, axis: Vec3) -> Quat {
	a := vec3_normalize(axis)
	half := angle * 0.5
	s := sin(half)
	q : Quat
	q.x = a.x * s
	q.y = a.y * s
	q.z = a.z * s
	q.w = cos(half)
	return q
}

quat_mul :: fun(a: Quat, b: Quat) -> Quat {
	q : Quat
	q.x = a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y
	q.y = a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x
	q.z = a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w
	q.w = a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z
	return q
}

quat_normalize :: fun(q: Quat) -> Quat {
	len := sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w)
	if len < 0.000001 { return q }
	r : Quat
	r.x = q.x / len
	r.y = q.y / len
	r.z = q.z / len
	r.w = q.w / len
	return r
}

// Build quaternion from forward and up vectors
quat_from_fwd_and_up :: fun(fwd: Vec3, up: Vec3) -> Quat {
	f := vec3_normalize(fwd)
	r := vec3_normalize(cross(up, f))
	u := cross(f, r)

	// rotation matrix to quaternion (Shepperd's method)
	trace := r.x + u.y + f.z
	q : Quat
	if trace > 0.0 {
		s := sqrt(trace + 1.0) * 2.0
		q.w = 0.25 * s
		q.x = (u.z - f.y) / s
		q.y = (f.x - r.z) / s
		q.z = (r.y - u.x) / s
	elif r.x > u.y and r.x > f.z
		s := sqrt(1.0 + r.x - u.y - f.z) * 2.0
		q.w = (u.z - f.y) / s
		q.x = 0.25 * s
		q.y = (r.y + u.x) / s
		q.z = (f.x + r.z) / s
	elif u.y > f.z
		s := sqrt(1.0 + u.y - r.x - f.z) * 2.0
		q.w = (f.x - r.z) / s
		q.x = (r.y + u.x) / s
		q.y = 0.25 * s
		q.z = (u.z + f.y) / s
	else
		s := sqrt(1.0 + f.z - r.x - u.y) * 2.0
		q.w = (r.y - u.x) / s
		q.x = (f.x + r.z) / s
		q.y = (u.z + f.y) / s
		q.z = 0.25 * s
	}
	return quat_normalize(q)
}

// Spherical linear interpolation
quat_slerp :: fun(a: Quat, b: Quat, t: f32) -> Quat {
	q : Quat
	d := a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
	b2 := b
	if d < 0.0 {
		b2.x = -b.x
		b2.y = -b.y
		b2.z = -b.z
		b2.w = -b.w
		d = -d
	}
	if d > 0.9995 {
		q.x = a.x + t * (b2.x - a.x)
		q.y = a.y + t * (b2.y - a.y)
		q.z = a.z + t * (b2.z - a.z)
		q.w = a.w + t * (b2.w - a.w)
		return quat_normalize(q)
	}
	// d is in [0, 0.9995] here (the parallel case returned above), so acos is
	// well-defined and theta is at least ~0.0316 rad — no divide-by-zero below.
	theta := acos(d)
	// sin(theta) == sqrt(1 - d*d): d == cos(theta) and theta is in [0, PI/2],
	// where sin is non-negative. Exact, and cheaper than another sin() call.
	sin_theta := sqrt(1.0 - d * d)
	s1 := sin((1.0 - t) * theta) / sin_theta
	s2 := sin(t * theta) / sin_theta
	q.x = s1 * a.x + s2 * b2.x
	q.y = s1 * a.y + s2 * b2.y
	q.z = s1 * a.z + s2 * b2.z
	q.w = s1 * a.w + s2 * b2.w
	return q
}
