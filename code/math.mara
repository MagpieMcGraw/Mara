module mara.math

Vec3 :: distinct [3]f32
Vec4 :: distinct [4]f32
Quat :: distinct [4]f32
Mat4 :: distinct [4][4]f32

PI  :: 3.141592653589793
TAU :: 6.283185307179586
QUAT_IDENTITY :: Quat{w = 1.0}

overload * mul
mul :: dispatch {
	mat4_mul
	mat4_mul_vec4
	vec3_mul
	vec3_scale
	quat_mul
}

overload + add
add :: dispatch {
	vec3_add
	vec3_add_scalar
}

overload - sub
sub :: dispatch {
	vec3_sub
	vec3_sub_scalar
	vec3_negate
}

// ============================================================================
// Min / Max / Abs
// ============================================================================

min :: dispatch {
	min_int
	min_u16
	min_f32
	min_f64
}

max :: dispatch {
	max_int
	max_u16
	max_f32
	max_f64
}

abs :: dispatch {
	abs_int
	abs_f32
	abs_f64
}

min_int :: fun(a: i64, b: i64) -> i64 { @llvm.smin.i64 }
min_u16 :: fun(a: u16, b: u16) -> u16 { @llvm.umin.i16 }
min_f32 :: fun(a: f32, b: f32) -> f32 { @llvm.minnum.f32 }
min_f64 :: fun(a: f64, b: f64) -> f64 { @llvm.minnum.f64 }
max_int :: fun(a: i64, b: i64) -> i64 { @llvm.smax.i64 }
max_u16 :: fun(a: u16, b: u16) -> u16 { @llvm.umax.i16 }
max_f32 :: fun(a: f32, b: f32) -> f32 { @llvm.maxnum.f32 }
max_f64 :: fun(a: f64, b: f64) -> f64 { @llvm.maxnum.f64 }

// abs(i64_min) TRAPS, on purpose. |i64_min| = 2^63 isn't representable as i64,
// so `-x` overflow-traps like all Mara arithmetic (every build mode) — a loud
// crash on the one impossible input beats a silent wrong value. Do NOT "fix"
// this with @llvm.abs.i64: its is_int_min_poison=false silently returns the
// negative i64_min, which contradicts Mara's trap-on-overflow model and the
// "hard errors over silent fallbacks" rule. (If a total abs is ever wanted, the
// answer is an unsigned return, abs(i64) -> u64, not a silent wrap.)
abs_int :: fun(x: i64) -> i64 {
	if x < 0 { return -x }
	return x
}
abs_f32 :: fun(x: f32) -> f32 { @llvm.fabs.f32 }
abs_f64 :: fun(x: f64) -> f64 { @llvm.fabs.f64 }

// ============================================================================
// Scalar math
// ============================================================================

sqrt :: dispatch {
	sqrt_f32
	sqrt_f64
}
sqrt_f32 :: fun(x: f32) -> f32 { @llvm.sqrt.f32 }
sqrt_f64 :: fun(x: f64) -> f64 { @llvm.sqrt.f64 }

sin :: dispatch {
	sin_f32
	sin_f64
}
sin_f32 :: fun(x: f32) -> f32 { @llvm.sin.f32 }
sin_f64 :: fun(x: f64) -> f64 { @llvm.sin.f64 }

cos :: dispatch {
	cos_f32
	cos_f64
}
cos_f32 :: fun(x: f32) -> f32 { @llvm.cos.f32 }
cos_f64 :: fun(x: f64) -> f64 { @llvm.cos.f64 }

acos :: dispatch {
	acos_f32
	acos_f64
}
acos_f32 :: fun(x: f32) -> f32 { @llvm.acos.f32 }
acos_f64 :: fun(x: f64) -> f64 { @llvm.acos.f64 }

pow :: dispatch {
	pow_f32
	pow_f64
}
pow_f32 :: fun(base: f32, exp: f32) -> f32 { @llvm.pow.f32 }
pow_f64 :: fun(base: f64, exp: f64) -> f64 { @llvm.pow.f64 }

tan :: fun(angle: f32) -> f32 {
	return sin(angle) / cos(angle)
}

to_radians :: fun(degrees: f32) -> f32 {
	return degrees * PI / 180.0
}

// ============================================================================
// Vec3 operations
// ============================================================================

dot :: fun(a: Vec3, b: Vec3) -> f32 {
	return a.x * b.x + a.y * b.y + a.z * b.z
}

cross :: fun(a: Vec3, b: Vec3) -> Vec3 {
	result : Vec3
	result.x = a.y * b.z - a.z * b.y
	result.y = a.z * b.x - a.x * b.z
	result.z = a.x * b.y - a.y * b.x
	return result
}

vec3_length :: fun(v: Vec3) -> f32 {
	return sqrt(v.x * v.x + v.y * v.y + v.z * v.z)
}

vec3_normalize :: fun(v: Vec3) -> Vec3 {
	len := vec3_length(v)
	if len < 0.000001 { return v }
	result : Vec3
	result.x = v.x / len
	result.y = v.y / len
	result.z = v.z / len
	return result
}

vec3_add :: fun(a: Vec3, b: Vec3) -> Vec3 {
	result : Vec3
	result.x = a.x + b.x
	result.y = a.y + b.y
	result.z = a.z + b.z
	return result
}

vec3_add_scalar :: fun(v: Vec3, s: f32) -> Vec3 {
	result : Vec3
	result.x = v.x + s
	result.y = v.y + s
	result.z = v.z + s
	return result
}

vec3_sub :: fun(a: Vec3, b: Vec3) -> Vec3 {
	result : Vec3
	result.x = a.x - b.x
	result.y = a.y - b.y
	result.z = a.z - b.z
	return result
}

vec3_sub_scalar :: fun(v: Vec3, s: f32) -> Vec3 {
	result : Vec3
	result.x = v.x - s
	result.y = v.y - s
	result.z = v.z - s
	return result
}

vec3_scale :: fun(v: Vec3, s: f32) -> Vec3 {
	result : Vec3
	result.x = v.x * s
	result.y = v.y * s
	result.z = v.z * s
	return result
}

vec3_negate :: fun(v: Vec3) -> Vec3 {
	result : Vec3
	result.x = -v.x
	result.y = -v.y
	result.z = -v.z
	return result
}

vec3_mul :: fun(a: Vec3, b: Vec3) -> Vec3 {
	result : Vec3
	result.x = a.x * b.x
	result.y = a.y * b.y
	result.z = a.z * b.z
	return result
}

// ============================================================================
// Vec4 operations
// ============================================================================

vec4_length :: fun(v: Vec4) -> f32 {
	return sqrt(v.x * v.x + v.y * v.y + v.z * v.z + v.w * v.w)
}

vec4_normalize :: fun(v: Vec4) -> Vec4 {
	len := vec4_length(v)
	if len < 0.000001 { return v }
	result : Vec4
	result.x = v.x / len
	result.y = v.y / len
	result.z = v.z / len
	result.w = v.w / len
	return result
}

length :: dispatch {
	vec3_length
	vec4_length
}

normalize :: dispatch {
	vec3_normalize
	vec4_normalize
}

// ============================================================================
// Mat4 operations
// ============================================================================

mat4_mul :: fun(a: Mat4, b: Mat4) -> Mat4 {
	result : Mat4
	for col in 0..4 {
		for row in 0..4 {
			sum : f32 = 0.0
			for k in 0..4 {
				sum = sum + a[k][row] * b[col][k]
			}
			result[col][row] = sum
		}
	}
	return result
}

mat4_mul_vec4 :: fun(m: Mat4, v: Vec4) -> Vec4 {
	result : Vec4
	result.x = m.x.x * v.x + m.y.x * v.y + m.z.x * v.z + m.w.x * v.w
	result.y = m.x.y * v.x + m.y.y * v.y + m.z.y * v.z + m.w.y * v.w
	result.z = m.x.z * v.x + m.y.z * v.y + m.z.z * v.z + m.w.z * v.w
	result.w = m.x.w * v.x + m.y.w * v.y + m.z.w * v.z + m.w.w * v.w
	return result
}

mat4_identity :: fun() -> Mat4 {
	m : Mat4
	for i in 0..4 {
		m[i][i] = 1.0
	}
	return m
}

mat4_transpose :: fun(m: Mat4) -> Mat4 {
	r : Mat4
	for i in 0..4 {
		for j in 0..4 {
			r[i][j] = m[j][i]
		}
	}
	return r
}

mat4_translate :: fun(pos: Vec3) -> Mat4 {
	m := mat4_identity()
	m.w.x = pos.x
	m.w.y = pos.y
	m.w.z = pos.z
	return m
}

mat4_scale :: fun(s: Vec3) -> Mat4 {
	m : Mat4
	m.x.x = s.x
	m.y.y = s.y
	m.z.z = s.z
	m.w.w = 1.0
	return m
}

// Perspective projection (right-handed, clip space z: -1 to 1)
mat4_perspective :: fun(fov_y: f32, aspect: f32, near: f32, far: f32) -> Mat4 {
	m : Mat4
	t := tan(fov_y * 0.5)
	if abs(t) < 0.000001 { return m }
	m.x.x = 1.0 / (aspect * t)
	m.y.y = 1.0 / t
	m.z.z = -(far + near) / (far - near)
	m.z.w = -1.0
	m.w.z = -(2.0 * far * near) / (far - near)
	return m
}

// Orthographic projection (right-handed, clip space z: -1 to 1)
mat4_ortho :: fun(left: f32, right: f32, bottom: f32, top: f32, near: f32, far: f32) -> Mat4 {
	m : Mat4
	width  := right - left
	height := top - bottom
	depth  := far - near
	if abs(width) < 0.000001 or abs(height) < 0.000001 or abs(depth) < 0.000001 { return m }
	m.x.x = 2.0 / width
	m.y.y = 2.0 / height
	m.z.z = -2.0 / depth
	m.w.x = -(right + left) / width
	m.w.y = -(top + bottom) / height
	m.w.z = -(far + near) / depth
	m.w.w = 1.0
	return m
}

// 4x4 matrix inverse via cofactor expansion
mat4_inverse :: fun(m: Mat4) -> Mat4 {
	b00 := m[0][0] * m[1][1] - m[0][1] * m[1][0]
	b01 := m[0][0] * m[1][2] - m[0][2] * m[1][0]
	b02 := m[0][0] * m[1][3] - m[0][3] * m[1][0]
	b03 := m[0][1] * m[1][2] - m[0][2] * m[1][1]
	b04 := m[0][1] * m[1][3] - m[0][3] * m[1][1]
	b05 := m[0][2] * m[1][3] - m[0][3] * m[1][2]
	b06 := m[2][0] * m[3][1] - m[2][1] * m[3][0]
	b07 := m[2][0] * m[3][2] - m[2][2] * m[3][0]
	b08 := m[2][0] * m[3][3] - m[2][3] * m[3][0]
	b09 := m[2][1] * m[3][2] - m[2][2] * m[3][1]
	b10 := m[2][1] * m[3][3] - m[2][3] * m[3][1]
	b11 := m[2][2] * m[3][3] - m[2][3] * m[3][2]

	det := b00 * b11 - b01 * b10 + b02 * b09 + b03 * b08 - b04 * b07 + b05 * b06
	assert(abs(det) >= 0.000001)   // singular matrix has no inverse

	inv_det := 1.0 / det
	r : Mat4
	r[0][0] = ( m[1][1] * b11 - m[1][2] * b10 + m[1][3] * b09) * inv_det
	r[0][1] = (-m[0][1] * b11 + m[0][2] * b10 - m[0][3] * b09) * inv_det
	r[0][2] = ( m[3][1] * b05 - m[3][2] * b04 + m[3][3] * b03) * inv_det
	r[0][3] = (-m[2][1] * b05 + m[2][2] * b04 - m[2][3] * b03) * inv_det
	r[1][0] = (-m[1][0] * b11 + m[1][2] * b08 - m[1][3] * b07) * inv_det
	r[1][1] = ( m[0][0] * b11 - m[0][2] * b08 + m[0][3] * b07) * inv_det
	r[1][2] = (-m[3][0] * b05 + m[3][2] * b02 - m[3][3] * b01) * inv_det
	r[1][3] = ( m[2][0] * b05 - m[2][2] * b02 + m[2][3] * b01) * inv_det
	r[2][0] = ( m[1][0] * b10 - m[1][1] * b08 + m[1][3] * b06) * inv_det
	r[2][1] = (-m[0][0] * b10 + m[0][1] * b08 - m[0][3] * b06) * inv_det
	r[2][2] = ( m[3][0] * b04 - m[3][1] * b02 + m[3][3] * b00) * inv_det
	r[2][3] = (-m[2][0] * b04 + m[2][1] * b02 - m[2][3] * b00) * inv_det
	r[3][0] = (-m[1][0] * b09 + m[1][1] * b07 - m[1][2] * b06) * inv_det
	r[3][1] = ( m[0][0] * b09 - m[0][1] * b07 + m[0][2] * b06) * inv_det
	r[3][2] = (-m[3][0] * b03 + m[3][1] * b01 - m[3][2] * b00) * inv_det
	r[3][3] = ( m[2][0] * b03 - m[2][1] * b01 + m[2][2] * b00) * inv_det
	return r
}

// Build rotation matrix from quaternion (column-major, same layout as Odin linalg)
mat4_from_quat :: fun(q: Quat) -> Mat4 {
	xx := q.x * q.x
	yy := q.y * q.y
	zz := q.z * q.z
	xy := q.x * q.y
	xz := q.x * q.z
	yz := q.y * q.z
	wx := q.w * q.x
	wy := q.w * q.y
	wz := q.w * q.z

	m := mat4_identity()
	m.x.x = 1.0 - 2.0 * (yy + zz)
	m.x.y = 2.0 * (xy + wz)
	m.x.z = 2.0 * (xz - wy)

	m.y.x = 2.0 * (xy - wz)
	m.y.y = 1.0 - 2.0 * (xx + zz)
	m.y.z = 2.0 * (yz + wx)

	m.z.x = 2.0 * (xz + wy)
	m.z.y = 2.0 * (yz - wx)
	m.z.z = 1.0 - 2.0 * (xx + yy)
	return m
}

// ============================================================================
// Quaternion operations  (Quat = [x, y, z, w])
// ============================================================================

quat_angle_axis :: fun(angle: f32, axis: Vec3) -> Quat {
	a := vec3_normalize(axis)
	half := angle * 0.5
	s := sin(half)
	q : Quat
	q.x = a.x * s
	q.y = a.y * s
	q.z = a.z * s
	q.w = cos(half)
	return q
}

quat_mul :: fun(a: Quat, b: Quat) -> Quat {
	q : Quat
	q.x = a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y
	q.y = a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x
	q.z = a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w
	q.w = a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z
	return q
}

quat_normalize :: fun(q: Quat) -> Quat {
	len := sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w)
	if len < 0.000001 { return q }
	r : Quat
	r.x = q.x / len
	r.y = q.y / len
	r.z = q.z / len
	r.w = q.w / len
	return r
}

// Build quaternion from forward and up vectors
quat_from_fwd_and_up :: fun(fwd: Vec3, up: Vec3) -> Quat {
	f := vec3_normalize(fwd)
	r := vec3_normalize(cross(up, f))
	u := cross(f, r)

	// rotation matrix to quaternion (Shepperd's method)
	trace := r.x + u.y + f.z
	q : Quat
	if trace > 0.0 {
		s := sqrt(trace + 1.0) * 2.0
		q.w = 0.25 * s
		q.x = (u.z - f.y) / s
		q.y = (f.x - r.z) / s
		q.z = (r.y - u.x) / s
	elif r.x > u.y and r.x > f.z
		s := sqrt(1.0 + r.x - u.y - f.z) * 2.0
		q.w = (u.z - f.y) / s
		q.x = 0.25 * s
		q.y = (r.y + u.x) / s
		q.z = (f.x + r.z) / s
	elif u.y > f.z
		s := sqrt(1.0 + u.y - r.x - f.z) * 2.0
		q.w = (f.x - r.z) / s
		q.x = (r.y + u.x) / s
		q.y = 0.25 * s
		q.z = (u.z + f.y) / s
	else
		s := sqrt(1.0 + f.z - r.x - u.y) * 2.0
		q.w = (r.y - u.x) / s
		q.x = (f.x + r.z) / s
		q.y = (u.z + f.y) / s
		q.z = 0.25 * s
	}
	return quat_normalize(q)
}

// Spherical linear interpolation
quat_slerp :: fun(a: Quat, b: Quat, t: f32) -> Quat {
	q : Quat
	d := a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
	b2 := b
	if d < 0.0 {
		b2.x = -b.x
		b2.y = -b.y
		b2.z = -b.z
		b2.w = -b.w
		d = -d
	}
	if d > 0.9995 {
		q.x = a.x + t * (b2.x - a.x)
		q.y = a.y + t * (b2.y - a.y)
		q.z = a.z + t * (b2.z - a.z)
		q.w = a.w + t * (b2.w - a.w)
		return quat_normalize(q)
	}
	// d is in [0, 0.9995] here (the parallel case returned above), so acos is
	// well-defined and theta is at least ~0.0316 rad — no divide-by-zero below.
	theta := acos(d)
	// sin(theta) == sqrt(1 - d*d): d == cos(theta) and theta is in [0, PI/2],
	// where sin is non-negative. Exact, and cheaper than another sin() call.
	sin_theta := sqrt(1.0 - d * d)
	s1 := sin((1.0 - t) * theta) / sin_theta
	s2 := sin(t * theta) / sin_theta
	q.x = s1 * a.x + s2 * b2.x
	q.y = s1 * a.y + s2 * b2.y
	q.z = s1 * a.z + s2 * b2.z
	q.w = s1 * a.w + s2 * b2.w
	return q
}
