module mara.math

Vec3 :: distinct [3!]f32
Vec4 :: distinct [4!]f32
Quat :: distinct [4!]f32
Mat4 :: distinct [4!][4!]f32

PI  :: 3.141592653589793
TAU :: 6.283185307179586
QUAT_IDENTITY :: Quat{w = 1.0}

overload * mul
mul :: dispatch {
	mat4_mul
	mat4_mul_vec4
	vec3_mul
	vec3_scale
	quat_mul
}

overload + add
add :: dispatch {
	vec3_add
	vec3_add_scalar
}

overload - sub
sub :: dispatch {
	vec3_sub
	vec3_sub_scalar
	vec3_negate
}

// ============================================================================
// Min / Max / Abs
// ============================================================================

min :: dispatch {
	min_int
	min_u16
	min_f32
	min_f64
}

max :: dispatch {
	max_int
	max_u16
	max_f32
	max_f64
}

abs :: dispatch {
	abs_int
	abs_f32
	abs_f64
}

min_int :: fun(a: i64, b: i64) -> i64 { @llvm.smin.i64 }
min_u16 :: fun(a: u16, b: u16) -> u16 { @llvm.umin.i16 }
min_f32 :: fun(a: f32, b: f32) -> f32 { @llvm.minnum.f32 }
min_f64 :: fun(a: f64, b: f64) -> f64 { @llvm.minnum.f64 }
max_int :: fun(a: i64, b: i64) -> i64 { @llvm.smax.i64 }
max_u16 :: fun(a: u16, b: u16) -> u16 { @llvm.umax.i16 }
max_f32 :: fun(a: f32, b: f32) -> f32 { @llvm.maxnum.f32 }
max_f64 :: fun(a: f64, b: f64) -> f64 { @llvm.maxnum.f64 }

// How many 0 bits come before the lowest 1 bit: 0 for an odd number, 3 for
// 8. A 0 has no 1 bit, so it gives its width: 64 for a u64. One machine
// instruction. Two values XORed: the first byte they differ in is
// trailing_zeros(a ~ b) / 8.
trailing_zeros :: dispatch {
	trailing_zeros_u64
	trailing_zeros_u32
	trailing_zeros_i64
}

trailing_zeros_u64 :: fun(x: u64) -> u64 { @llvm.cttz.i64 }
trailing_zeros_u32 :: fun(x: u32) -> u32 { @llvm.cttz.i32 }
trailing_zeros_i64 :: fun(x: i64) -> i64 { @llvm.cttz.i64 }

// How many 0 bits come above the highest 1 bit: 63 for a u64's 1, 0 when
// the top bit is 1. A 0 gives its width. The highest 1 bit's place is
// 63 - leading_zeros(x) for a u64, so it's a whole number's log2.
leading_zeros :: dispatch {
	leading_zeros_u64
	leading_zeros_u32
	leading_zeros_i64
}

leading_zeros_u64 :: fun(x: u64) -> u64 { @llvm.ctlz.i64 }
leading_zeros_u32 :: fun(x: u32) -> u32 { @llvm.ctlz.i32 }
leading_zeros_i64 :: fun(x: i64) -> i64 { @llvm.ctlz.i64 }

// How many bits are 1.
count_ones :: dispatch {
	count_ones_u64
	count_ones_u32
	count_ones_i64
}

count_ones_u64 :: fun(x: u64) -> u64 { @llvm.ctpop.i64 }
count_ones_u32 :: fun(x: u32) -> u32 { @llvm.ctpop.i32 }
count_ones_i64 :: fun(x: i64) -> i64 { @llvm.ctpop.i64 }

// x's bits turned left by n places: the ones pushed out at the top come
// back in at the bottom. n is taken modulo the width, so turning a u64 by
// 64 leaves it as it was.
rotate_left :: dispatch {
	rotate_left_u64
	rotate_left_u32
}

// x's bits turned right by n places: the ones pushed out at the bottom come
// back in at the top. n is taken modulo the width.
rotate_right :: dispatch {
	rotate_right_u64
	rotate_right_u32
}

rotate_left_u64 :: fun(x: u64, n: u64) -> u64 { return funnel_left_u64(x, x, n) }
rotate_left_u32 :: fun(x: u32, n: u32) -> u32 { return funnel_left_u32(x, x, n) }
rotate_right_u64 :: fun(x: u64, n: u64) -> u64 { return funnel_right_u64(x, x, n) }
rotate_right_u32 :: fun(x: u32, n: u32) -> u32 { return funnel_right_u32(x, x, n) }

// a and b side by side as one number twice as wide, a the top half, shifted
// left by n (modulo the width): the top half then. With a and b the same,
// a rotate.
funnel_left_u64 :: fun(a: u64, b: u64, n: u64) -> u64 { @llvm.fshl.i64 }
funnel_left_u32 :: fun(a: u32, b: u32, n: u32) -> u32 { @llvm.fshl.i32 }

// a and b side by side as one number twice as wide, a the top half, shifted
// right by n (modulo the width): the bottom half then.
funnel_right_u64 :: fun(a: u64, b: u64, n: u64) -> u64 { @llvm.fshr.i64 }
funnel_right_u32 :: fun(a: u32, b: u32, n: u32) -> u32 { @llvm.fshr.i32 }

// abs(i64_min) TRAPS, on purpose. |i64_min| = 2^63 isn't representable as i64,
// so `-x` overflow-traps like all Mara arithmetic (every build mode) — a loud
// crash on the one impossible input beats a silent wrong value. Do NOT "fix"
// this with @llvm.abs.i64: its is_int_min_poison=false silently returns the
// negative i64_min, which contradicts Mara's trap-on-overflow model and the
// "hard errors over silent fallbacks" rule. (If a total abs is ever wanted, the
// answer is an unsigned return, abs(i64) -> u64, not a silent wrap.)
abs_int :: fun(x: i64) -> i64 {
	if x < 0 { return -x }
	return x
}
abs_f32 :: fun(x: f32) -> f32 { @llvm.fabs.f32 }
abs_f64 :: fun(x: f64) -> f64 { @llvm.fabs.f64 }

// ============================================================================
// Scalar math
// ============================================================================

sqrt :: dispatch {
	sqrt_f32
	sqrt_f64
}
sqrt_f32 :: fun(x: f32) -> f32 { @llvm.sqrt.f32 }
sqrt_f64 :: fun(x: f64) -> f64 { @llvm.sqrt.f64 }

// The whole number at or below x.
floor :: dispatch {
	floor_f32
	floor_f64
}
floor_f32 :: fun(x: f32) -> f32 { @llvm.floor.f32 }
floor_f64 :: fun(x: f64) -> f64 { @llvm.floor.f64 }

// The whole number at or above x.
ceil :: dispatch {
	ceil_f32
	ceil_f64
}
ceil_f32 :: fun(x: f32) -> f32 { @llvm.ceil.f32 }
ceil_f64 :: fun(x: f64) -> f64 { @llvm.ceil.f64 }

// sin, cos, acos and pow are computed here, in Mara — arithmetic and the
// CPU's own instructions (sqrt, floor, fabs) — no C library. sin and cos: x
// reduced by π/2 — in three parts of π/2 up to 2^20·π/2 (Cody-Waite), past
// that by 2/π's own bits (Payne-Hanek), so sin(1e300) is right too — then
// fdlibm's polynomials on [-π/4, π/4] (fdlibm: Sun's freely distributable
// libm, which most C libraries' math descends from), their leading terms
// kept exact. acos: fdlibm's rational approximation, square roots for |x|
// past ½, its leading terms kept exact too. pow: e^(y·ln x), ln and e^ each
// by a table of 128 and a short polynomial, y·ln x to some 68 bits; C's
// special cases. The f64 ones: within 0.6 of a unit in the last place
// (Windows' C library's: 0.73 for sin and cos, 0.84 for acos, pow far off
// near 1 to a big power). The f32 ones: worked out in f64, rounded once —
// the nearest f32, every case tested.

// (fdlibm's constants, and a few more.)
