module mara.crypto

use mara.core
use mara.math
use mara.os

// Hashes, keyed hashes and password hashing.
//
//     digest := sha256("some text")             // [32!]byte
//     mac := hmac_sha256(key, message)
//     stored := bcrypt_make(password, 12)?      // keep this text
//     ok := bcrypt_check(password, stored)
//
// To hash something in pieces, a big file's say: sha256_start, then sha256_add for
// each piece, then sha256_finish. md5 and sha1 have the same three.
//
// md5 and sha1 are broken for security: they're here because formats need them,
// the WebSocket handshake needs sha1 and upload checksums md5. To compare a digest
// or a token someone sent, use same_secret, not `==`.

// Whether two byte strings are the same, taking the same time wherever they differ:
// a comparison that stopped at the first difference would tell an attacker how
// much of a guess was right.
same_secret :: fun(a: []byte, b: []byte) -> bool {
	if a.len != b.len do return false
	seen : u8 = 0
	for k in 0:a.len {
		seen = seen | (u8(a[k]) ~ u8(b[k]))
	}
	return seen == 0
}

// ---------------------------------------------------------------------------
// SHA-256
// ---------------------------------------------------------------------------

SHA256_K :: [64!]u32{
	0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5, 0x3956C25B, 0x59F111F1,
	0x923F82A4, 0xAB1C5ED5, 0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3,
	0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174, 0xE49B69C1, 0xEFBE4786,
	0x0FC19DC6, 0x240CA1CC, 0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
	0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7, 0xC6E00BF3, 0xD5A79147,
	0x06CA6351, 0x14292967, 0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13,
	0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85, 0xA2BFE8A1, 0xA81A664B,
	0xC24B8B70, 0xC76C51A3, 0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
	0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5, 0x391C0CB3, 0x4ED8AA4A,
	0x5B9CCA4F, 0x682E6FF3, 0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208,
	0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2,
}

// A SHA-256 being worked out. sha256_start makes one.
Sha256 :: struct {
	state: [8!]u32
	waiting: [64]byte   // what's come since the last whole block
	total: i64          // bytes in all
}

sha256_start :: fun() -> Sha256 {
	s : Sha256
	s.state = [8!]u32{0x6A09E667, 0xBB67AE85, 0x3C6EF372, 0xA54FF53A, 0x510E527F, 0x9B05688C, 0x1F83D9AB, 0x5BE0CD19}
	s.waiting.len = 0
	s.total = 0
	return s
}

// Adds a piece to what's being hashed.
sha256_add :: fun(s: ^Sha256, data: []byte) {
	s.total += data.len
	k : i64 = 0
	if s.waiting.len > 0 {
		for k < data.len and s.waiting.len < 64 {
			&s.waiting + data[k]
			k += 1
		}
		if s.waiting.len < 64 do return
		sha256_block(s, s.waiting[0:64])
		s.waiting.len = 0
	}
	for k + 64 <= data.len {
		sha256_block(s, data[k:k + 64])
		k += 64
	}
	for k < data.len {
		&s.waiting + data[k]
		k += 1
	}
}

// The digest of everything added.
sha256_finish :: fun(s: ^Sha256) -> [32!]byte {
	bits := u64(s.total) * 8
	sha_pad_add(s, sha256_add, bits)
	out : [32!]byte
	for k in 0:8 {
		w := s.state[k]
		out[k * 4] = u8(w >> 24)
		out[k * 4 + 1] = u8((w >> 16) & 255)
		out[k * 4 + 2] = u8((w >> 8) & 255)
		out[k * 4 + 3] = u8(w & 255)
	}
	return out
}

// The SHA-256 digest of data.
sha256 :: fun(data: []byte) -> [32!]byte {
	s := sha256_start()
	sha256_add(&s, data)
	return sha256_finish(&s)
}

sha256_block :: fun(s: ^Sha256, block: []byte) {
	w : [64!]u32
	for t in 0:16 do w[t] = big_endian_u32(block, t * 4)
	for t in 16:64 {
		x := w[t - 15]
		y := w[t - 2]
		small0 := rotate_right(x, 7) ~ rotate_right(x, 18) ~ (x >> 3)
		small1 := rotate_right(y, 17) ~ rotate_right(y, 19) ~ (y >> 10)
		w[t] = w[t - 16] +% small0 +% w[t - 7] +% small1
	}
	a := s.state[0]
	b := s.state[1]
	c := s.state[2]
	d := s.state[3]
	e := s.state[4]
	f := s.state[5]
	g := s.state[6]
	h := s.state[7]
	for t in 0:64 {
		big1 := rotate_right(e, 6) ~ rotate_right(e, 11) ~ rotate_right(e, 25)
		choose := (e & f) ~ (u32(0xFFFFFFFF) ~ e) & g
		one := h +% big1 +% choose +% SHA256_K[t] +% w[t]
		big0 := rotate_right(a, 2) ~ rotate_right(a, 13) ~ rotate_right(a, 22)
		most := (a & b) ~ (a & c) ~ (b & c)
		two := big0 +% most
		h = g
		g = f
		f = e
		e = d +% one
		d = c
		c = b
		b = a
		a = one +% two
	}
	s.state[0] = s.state[0] +% a
	s.state[1] = s.state[1] +% b
	s.state[2] = s.state[2] +% c
	s.state[3] = s.state[3] +% d
	s.state[4] = s.state[4] +% e
	s.state[5] = s.state[5] +% f
	s.state[6] = s.state[6] +% g
	s.state[7] = s.state[7] +% h
}

// ---------------------------------------------------------------------------
// SHA-1
// ---------------------------------------------------------------------------

// A SHA-1 being worked out. sha1_start makes one.
Sha1 :: struct {
	state: [5!]u32
	waiting: [64]byte
	total: i64
}

sha1_start :: fun() -> Sha1 {
	s : Sha1
	s.state = [5!]u32{0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0}
	s.waiting.len = 0
	s.total = 0
	return s
}

// Adds a piece to what's being hashed.
sha1_add :: fun(s: ^Sha1, data: []byte) {
	s.total += data.len
	k : i64 = 0
	if s.waiting.len > 0 {
		for k < data.len and s.waiting.len < 64 {
			&s.waiting + data[k]
			k += 1
		}
		if s.waiting.len < 64 do return
		sha1_block(s, s.waiting[0:64])
		s.waiting.len = 0
	}
	for k + 64 <= data.len {
		sha1_block(s, data[k:k + 64])
		k += 64
	}
	for k < data.len {
		&s.waiting + data[k]
		k += 1
	}
}

// The digest of everything added.
sha1_finish :: fun(s: ^Sha1) -> [20!]byte {
	bits := u64(s.total) * 8
	sha_pad_add(s, sha1_add, bits)
	out : [20!]byte
	for k in 0:5 {
		w := s.state[k]
		out[k * 4] = u8(w >> 24)
		out[k * 4 + 1] = u8((w >> 16) & 255)
		out[k * 4 + 2] = u8((w >> 8) & 255)
		out[k * 4 + 3] = u8(w & 255)
	}
	return out
}

// The SHA-1 digest of data.
sha1 :: fun(data: []byte) -> [20!]byte {
	s := sha1_start()
	sha1_add(&s, data)
	return sha1_finish(&s)
}

sha1_block :: fun(s: ^Sha1, block: []byte) {
	w : [80!]u32
	for t in 0:16 do w[t] = big_endian_u32(block, t * 4)
	for t in 16:80 do w[t] = rotate_left(w[t - 3] ~ w[t - 8] ~ w[t - 14] ~ w[t - 16], 1)
	a := s.state[0]
	b := s.state[1]
	c := s.state[2]
	d := s.state[3]
	e := s.state[4]
	for t in 0:80 {
		mix : u32 = b ~ c ~ d
		constant : u32 = 0xCA62C1D6
		if t < 20 {
			mix = (b & c) | ((u32(0xFFFFFFFF) ~ b) & d)
			constant = 0x5A827999
		elif t < 40
			constant = 0x6ED9EBA1
		elif t < 60
			mix = (b & c) | (b & d) | (c & d)
			constant = 0x8F1BBCDC
		}
		next_a := rotate_left(a, 5) +% mix +% e +% constant +% w[t]
		e = d
		d = c
		c = rotate_left(b, 30)
		b = a
		a = next_a
	}
	s.state[0] = s.state[0] +% a
	s.state[1] = s.state[1] +% b
	s.state[2] = s.state[2] +% c
	s.state[3] = s.state[3] +% d
	s.state[4] = s.state[4] +% e
}

// SHA's end: a 0x80 byte, zeros up to the block's last 8 bytes, then the length in
// bits, biggest byte first.
sha_pad_add :: fun(s: $S, adder: $P, bits: u64) {
	pad : [72]byte
	&pad + u8(0x80)
	for (s.waiting.len + pad.len) % 64 != 56 do &pad + u8(0)
	for k in 0:8 {
		&pad + u8((bits >> u64(56 - k * 8)) & 255)
	}
	adder(s, pad)
}

big_endian_u32 :: fun(data: []byte, at: i64) -> u32 {
	return (u32(u8(data[at])) << 24) | (u32(u8(data[at + 1])) << 16) | (u32(u8(data[at + 2])) << 8) | u32(u8(data[at + 3]))
}

little_endian_u32 :: fun(data: []byte, at: i64) -> u32 {
	return u32(u8(data[at])) | (u32(u8(data[at + 1])) << 8) | (u32(u8(data[at + 2])) << 16) | (u32(u8(data[at + 3])) << 24)
}

// ---------------------------------------------------------------------------
// MD5
// ---------------------------------------------------------------------------

MD5_K :: [64!]u32{
	0xD76AA478, 0xE8C7B756, 0x242070DB, 0xC1BDCEEE, 0xF57C0FAF, 0x4787C62A,
	0xA8304613, 0xFD469501, 0x698098D8, 0x8B44F7AF, 0xFFFF5BB1, 0x895CD7BE,
	0x6B901122, 0xFD987193, 0xA679438E, 0x49B40821, 0xF61E2562, 0xC040B340,
	0x265E5A51, 0xE9B6C7AA, 0xD62F105D, 0x02441453, 0xD8A1E681, 0xE7D3FBC8,
	0x21E1CDE6, 0xC33707D6, 0xF4D50D87, 0x455A14ED, 0xA9E3E905, 0xFCEFA3F8,
	0x676F02D9, 0x8D2A4C8A, 0xFFFA3942, 0x8771F681, 0x6D9D6122, 0xFDE5380C,
	0xA4BEEA44, 0x4BDECFA9, 0xF6BB4B60, 0xBEBFBC70, 0x289B7EC6, 0xEAA127FA,
	0xD4EF3085, 0x04881D05, 0xD9D4D039, 0xE6DB99E5, 0x1FA27CF8, 0xC4AC5665,
	0xF4292244, 0x432AFF97, 0xAB9423A7, 0xFC93A039, 0x655B59C3, 0x8F0CCC92,
	0xFFEFF47D, 0x85845DD1, 0x6FA87E4F, 0xFE2CE6E0, 0xA3014314, 0x4E0811A1,
	0xF7537E82, 0xBD3AF235, 0x2AD7D2BB, 0xEB86D391,
}

MD5_S :: [64!]u32{
	7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
	5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
	4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
	6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21,
}

// An MD5 being worked out. md5_start makes one.
Md5 :: struct {
	state: [4!]u32
	waiting: [64]byte
	total: i64
}

md5_start :: fun() -> Md5 {
	s : Md5
	s.state = [4!]u32{0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476}
	s.waiting.len = 0
	s.total = 0
	return s
}

// Adds a piece to what's being hashed.
md5_add :: fun(s: ^Md5, data: []byte) {
	s.total += data.len
	k : i64 = 0
	if s.waiting.len > 0 {
		for k < data.len and s.waiting.len < 64 {
			&s.waiting + data[k]
			k += 1
		}
		if s.waiting.len < 64 do return
		md5_block(s, s.waiting[0:64])
		s.waiting.len = 0
	}
	for k + 64 <= data.len {
		md5_block(s, data[k:k + 64])
		k += 64
	}
	for k < data.len {
		&s.waiting + data[k]
		k += 1
	}
}

// The digest of everything added.
md5_finish :: fun(s: ^Md5) -> [16!]byte {
	// (As SHA ends, but the length comes smallest byte first.)
	bits := u64(s.total) * 8
	pad : [72]byte
	&pad + u8(0x80)
	for (s.waiting.len + pad.len) % 64 != 56 do &pad + u8(0)
	for k in 0:8 {
		&pad + u8((bits >> u64(k * 8)) & 255)
	}
	md5_add(s, pad)
	out : [16!]byte
	for k in 0:4 {
		w := s.state[k]
		out[k * 4] = u8(w & 255)
		out[k * 4 + 1] = u8((w >> 8) & 255)
		out[k * 4 + 2] = u8((w >> 16) & 255)
		out[k * 4 + 3] = u8(w >> 24)
	}
	return out
}

// The MD5 digest of data.
md5 :: fun(data: []byte) -> [16!]byte {
	s := md5_start()
	md5_add(&s, data)
	return md5_finish(&s)
}

md5_block :: fun(s: ^Md5, block: []byte) {
	a := s.state[0]
	b := s.state[1]
	c := s.state[2]
	d := s.state[3]
	for t in 0:64 {
		mix : u32 = 0
		word := t
		if t < 16 {
			mix = (b & c) | ((u32(0xFFFFFFFF) ~ b) & d)
		elif t < 32
			mix = (d & b) | ((u32(0xFFFFFFFF) ~ d) & c)
			word = (5 * t + 1) % 16
		elif t < 48
			mix = b ~ c ~ d
			word = (3 * t + 5) % 16
		else
			mix = c ~ (b | (u32(0xFFFFFFFF) ~ d))
			word = (7 * t) % 16
		}
		sum := a +% mix +% MD5_K[t] +% little_endian_u32(block, word * 4)
		a = d
		d = c
		c = b
		b = b +% rotate_left(sum, MD5_S[t])
	}
	s.state[0] = s.state[0] +% a
	s.state[1] = s.state[1] +% b
	s.state[2] = s.state[2] +% c
	s.state[3] = s.state[3] +% d
}

// ---------------------------------------------------------------------------
// HMAC and PBKDF2
// ---------------------------------------------------------------------------

// A keyed SHA-256 of message: only someone with the key can make it.
hmac_sha256 :: fun(key: []byte, message: []byte) -> [32!]byte {
	block : [64!]u8
	for k in 0:64 do block[k] = 0
	if key.len > 64 {
		digest := sha256(key)
		for k in 0:32 do block[k] = u8(digest[k])
	else
		for k in 0:key.len do block[k] = u8(key[k])
	}
	for k in 0:64 do block[k] = block[k] ~ 0x36
	inner := sha256_start()
	sha256_add(&inner, block)
	sha256_add(&inner, message)
	inner_digest := sha256_finish(&inner)
	for k in 0:64 do block[k] = block[k] ~ 0x36 ~ 0x5C
	outer := sha256_start()
	sha256_add(&outer, block)
	sha256_add(&outer, inner_digest)
	return sha256_finish(&outer)
}

// A keyed SHA-1 of message. For formats that ask for it.
hmac_sha1 :: fun(key: []byte, message: []byte) -> [20!]byte {
	block : [64!]u8
	for k in 0:64 do block[k] = 0
	if key.len > 64 {
		digest := sha1(key)
		for k in 0:20 do block[k] = u8(digest[k])
	else
		for k in 0:key.len do block[k] = u8(key[k])
	}
	for k in 0:64 do block[k] = block[k] ~ 0x36
	inner := sha1_start()
	sha1_add(&inner, block)
	sha1_add(&inner, message)
	inner_digest := sha1_finish(&inner)
	for k in 0:64 do block[k] = block[k] ~ 0x36 ~ 0x5C
	outer := sha1_start()
	sha1_add(&outer, block)
	sha1_add(&outer, inner_digest)
	return sha1_finish(&outer)
}

// Fills out, all its room, with a key made from a password and a salt by PBKDF2
// over HMAC-SHA-256. More iterations make guessing the password slower.
pbkdf2_sha256 :: fun(password: []byte, salt: []byte, iterations: i64, out: ^[]byte) {
	out.len = 0
	block : u32 = 1
	for out.len < out.cap {
		// (U1 is the HMAC of the salt and the block's number, each next U the
		// HMAC of the one before, and the block all of them xored.)
		number : [4!]u8
		number[0] = u8(block >> 24)
		number[1] = u8((block >> 16) & 255)
		number[2] = u8((block >> 8) & 255)
		number[3] = u8(block & 255)
		first := hmac_sha256_start(password)
		sha256_add(&first.inner, salt)
		sha256_add(&first.inner, number)
		u := hmac_sha256_finish(&first)
		total := u
		for k in 1:iterations {
			u = hmac_sha256(password, u)
			for j in 0:32 do total[j] = u8(total[j]) ~ u8(u[j])
		}
		for j in 0:32 {
			if out.len < out.cap do out + total[j]
		}
		block += 1
	}
}

// (An HMAC-SHA-256 taken in pieces: pbkdf2's first step has two.)
Hmac_Sha256 :: struct {
	inner: Sha256
	outer: Sha256
}

hmac_sha256_start :: fun(key: []byte) -> Hmac_Sha256 {
	block : [64!]u8
	for k in 0:64 do block[k] = 0
	if key.len > 64 {
		digest := sha256(key)
		for k in 0:32 do block[k] = u8(digest[k])
	else
		for k in 0:key.len do block[k] = u8(key[k])
	}
	for k in 0:64 do block[k] = block[k] ~ 0x36
	h : Hmac_Sha256
	h.inner = sha256_start()
	sha256_add(&h.inner, block)
	for k in 0:64 do block[k] = block[k] ~ 0x36 ~ 0x5C
	h.outer = sha256_start()
	sha256_add(&h.outer, block)
	return h
}

hmac_sha256_finish :: fun(h: ^Hmac_Sha256) -> [32!]byte {
	inner_digest := sha256_finish(&h.inner)
	sha256_add(&h.outer, inner_digest)
	return sha256_finish(&h.outer)
}

// ---------------------------------------------------------------------------
// bcrypt
// ---------------------------------------------------------------------------

// What a bcrypt digest text can fail with when it's made.
Bcrypt_Error :: error {
	Bad_Bcrypt_Cost
}

// A new digest of password, with a random salt, as text to keep: "$2a$12$…", 60
// characters. Each step of cost doubles the time it takes: 12 is about a quarter of
// a second. Only a password's first 72 bytes count.
bcrypt_make :: fun(password: []byte, cost: i64) -> str64, err {
	if cost < 4 or cost > 31 {
		none : str64
		return none, Bad_Bcrypt_Cost
	}
	salt : [16]byte
	random_bytes(&salt)?
	return bcrypt_hash(password, salt, cost)
}

// Whether password is the one a digest was made from. A digest that isn't one is
// no match. (The "$2a$", "$2b$" and "$2y$" kinds are all made the same here.)
bcrypt_check :: fun(password: []byte, digest: []utf8) -> bool {
	if digest.len != 60 or digest[0] != '$' or digest[1] != '2' or digest[3] != '$' or digest[6] != '$' do return false
	kind := digest[2]
	if kind != 'a' and kind != 'b' and kind != 'y' do return false
	tens := i64(digest[4]) - i64('0')
	ones := i64(digest[5]) - i64('0')
	if tens < 0 or tens > 9 or ones < 0 or ones > 9 do return false
	cost := tens * 10 + ones
	if cost < 4 or cost > 31 do return false
	salt : [16]byte
	if not bcrypt_decode(digest[7:29], &salt) do return false
	again := bcrypt_hash(password, salt, cost)
	// (Only what's after the kind compared: a "$2b$" digest made elsewhere.)
	return same_secret(again[3:60], digest[3:60])
}

// The digest text of password with this salt and cost. bcrypt_make picks the salt.
bcrypt_hash :: fun(password: []byte, salt: []byte, cost: i64) -> str64 {
	// (The key is the password with a 0 after it, at most 72 bytes.)
	key : [72]byte
	for k in 0:password.len {
		if key.len < 72 do &key + password[k]
	}
	if key.len < 72 do &key + u8(0)

	// (Blowfish's keys are set up expensively: with the salt, then many times
	// with the key and the salt by turns.)
	state : Blowfish
	state.p = BLOWFISH_P
	state.s = BLOWFISH_S
	blowfish_expand(&state, key, salt)
	rounds := i64(1) << cost
	nothing : [0]byte
	for k in 0:rounds {
		blowfish_expand(&state, key, nothing)
		blowfish_expand(&state, salt, nothing)
	}

	// (Then this text is encrypted 64 times, and that's the digest.)
	words := [6!]u32{0x4F727068, 0x65616E42, 0x65686F6C, 0x64657253, 0x63727944, 0x6F756274}
	for k in 0:64 {
		for j in 0:3 {
			left, right := blowfish_encrypt(&state, words[j * 2], words[j * 2 + 1])
			words[j * 2] = left
			words[j * 2 + 1] = right
		}
	}
	hash : [24]byte
	for w in words {
		&hash + u8(w >> 24)
		&hash + u8((w >> 16) & 255)
		&hash + u8((w >> 8) & 255)
		&hash + u8(w & 255)
	}

	out : str64
	&out + "$2a$"
	&out + utf8(i64('0') + cost / 10)
	&out + utf8(i64('0') + cost % 10)
	&out + '$'
	bcrypt_encode(salt[0:16], &out)
	bcrypt_encode(hash[0:23], &out)
	return out
}

// Blowfish's keyed tables.
Blowfish :: struct {
	p: [18!]u32
	s: [1024!]u32
}

// One block encrypted.
blowfish_encrypt :: fun(b: ^Blowfish, first_left: u32, first_right: u32) -> u32, u32 {
	left := first_left
	right := first_right
	for k in 0:16 {
		left = left ~ b.p[k]
		x := left
		f := b.s[i64(x >> 24)] +% b.s[256 + i64((x >> 16) & 255)]
		f = (f ~ b.s[512 + i64((x >> 8) & 255)]) +% b.s[768 + i64(x & 255)]
		right = right ~ f
		kept := left
		left = right
		right = kept
	}
	kept := left
	left = right
	right = kept
	right = right ~ b.p[16]
	left = left ~ b.p[17]
	return left, right
}

// The tables remade from a key, each block of them encrypted from the one before,
// mixed with the salt if there is one. Both repeat as long as they're needed.
blowfish_expand :: fun(b: ^Blowfish, key: []byte, salt: []byte) {
	at : i64 = 0
	for k in 0:18 {
		word : u32 = 0
		for j in 0:4 {
			word = (word << 8) | u32(u8(key[at]))
			at += 1
			if at == key.len do at = 0
		}
		b.p[k] = b.p[k] ~ word
	}
	left : u32 = 0
	right : u32 = 0
	salt_at : i64 = 0
	for k in 0:9 {
		if salt.len > 0 {
			left = left ~ big_endian_u32(salt, salt_at)
			right = right ~ big_endian_u32(salt, salt_at + 4)
			salt_at = (salt_at + 8) % salt.len
		}
		left, right = blowfish_encrypt(b, left, right)
		b.p[k * 2] = left
		b.p[k * 2 + 1] = right
	}
	for k in 0:512 {
		if salt.len > 0 {
			left = left ~ big_endian_u32(salt, salt_at)
			right = right ~ big_endian_u32(salt, salt_at + 4)
			salt_at = (salt_at + 8) % salt.len
		}
		left, right = blowfish_encrypt(b, left, right)
		b.s[k * 2] = left
		b.s[k * 2 + 1] = right
	}
}

// bcrypt's own base64: another alphabet, no padding.
BCRYPT_ALPHABET :: "./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

bcrypt_encode :: fun(data: []byte, out: ^[]utf8) {
	k : i64 = 0
	for k < data.len {
		a := u32(u8(data[k]))
		out + BCRYPT_ALPHABET[i64(a >> 2)]
		if k + 1 == data.len {
			out + BCRYPT_ALPHABET[i64((a & 3) << 4)]
			return
		}
		b := u32(u8(data[k + 1]))
		out + BCRYPT_ALPHABET[i64(((a & 3) << 4) | (b >> 4))]
		if k + 2 == data.len {
			out + BCRYPT_ALPHABET[i64((b & 15) << 2)]
			return
		}
		c := u32(u8(data[k + 2]))
		out + BCRYPT_ALPHABET[i64(((b & 15) << 2) | (c >> 6))]
		out + BCRYPT_ALPHABET[i64(c & 63)]
		k += 3
	}
}

// 22 characters of bcrypt's base64 to a 16-byte salt. Whether they all were.
bcrypt_decode :: fun(text: []utf8, out: ^[]byte) -> bool {
	bits : u32 = 0
	held : u32 = 0
	for c in text {
		v : i64 = -1
		for k in 0:64 {
			if BCRYPT_ALPHABET[k] == c do v = k
		}
		if v < 0 do return false
		bits = ((bits << 6) | u32(v)) & 0xFFFF
		held += 6
		if held >= 8 {
			held -= 8
			out + u8((bits >> held) & 255)
		}
	}
	return out.len == 16
}

