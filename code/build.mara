module mara.build

use mara.core

// What `mara build` builds in a folder that has a build.mara: each constant
// of type Build there is one build, named by the constant.
//
//     module build
//     use mara.build
//
//     game :: Build(){dirs = ["../engine"], release = true}
//     tools :: Build(){dirs = ["../engine"]}
//
// `Build()` is a build with every field its default; the braces after it
// set the fields written (Mara's construct and override). `mara build`
// builds the one named as the folder, or the only one; `mara build tools`
// builds the one named tools. Flags written after it add to the build's own
// (`mara build tools -release`). The folders it names are searched by `mara
// ask`, `serve`, `view` and the language server too.
//
// The compiler reads the constants as they're written (text in quotes, true
// or false, a list of text in square brackets): build.mara is never run.

// One build: a module, where its modules are found, how it's made.
Build :: struct {
	// The module it builds, up to 64 bytes; "": the constant's name.
	module_name: str64 = ""
	// More folders searched for modules, as the project's own folder is: up
	// to 8, each a path of up to 96 bytes, relative to build.mara's folder
	// or whole.
	dirs: [8][96]utf8
	// The program's name, its extension left off, up to 64 bytes; "": the
	// module's.
	out: str64 = ""
	// Built optimized by LLVM, as `-release` does.
	release: bool = false
	// Built by LLVM, not the x86 backend, as `-llvm` does.
	llvm: bool = false
}
