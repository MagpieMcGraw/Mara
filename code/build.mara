module mara.build

use mara.core

// What `mara build` builds in a folder that has a build.mara: each constant
// of type Build there is one build, named by the constant.
//
//     module build
//     use mara.build
//
//     game :: Build(){dirs = ["../engine"], icon = "game.ico", release = true}
//     tools :: Build(){dirs = ["../engine"]}
//     timed :: Build(){module_name = "game", out = "game_timed", release = true, profile = "time", profile_skip = ["mara.math"]}
//
// `Build()` is a build with every field its default; the braces after it
// set the fields written (Mara's construct and override). `mara build`
// builds the one named as the folder, or the only one; `mara build tools`
// builds the one named tools. Flags written after it add to the build's own
// (`mara build tools -release`). The folders it names are searched by `mara
// ask`, `serve`, `view` and the language server too.
//
// The compiler reads the constants as they're written (text in quotes, true
// or false, a list of text in square brackets): build.mara is never run.

// One build: a module, where its modules are found, how it's made.
Build :: struct {
	// The module it builds, up to 64 bytes; "": the constant's name.
	module_name: str64 = ""
	// More folders searched for modules, as the project's own folder is: up
	// to 6, each a path of up to 96 bytes, relative to build.mara's folder
	// or whole.
	dirs: [6][96]utf8
	// The program's name, its extension left off, up to 64 bytes; "": the
	// module's.
	out: str64 = ""
	// The program's icon on Windows, an .ico file's path of up to 96 bytes,
	// relative to build.mara's folder or whole; none: Windows' plain one.
	// Explorer shows it, and SDL gives it to the program's windows.
	icon: [96]utf8
	// Built optimized by LLVM, as `-release` does.
	release: bool = false
	// Built by the x86 backend, not LLVM, as `-x86` does: the fastest build,
	// not optimized, Windows and Linux (x86-64).
	x86: bool = false
	// false: a Windows program that opens no console window with it, as
	// `-no console` builds one — a program with a window of its own. What
	// it prints is seen only where its output is sent on (`game > log.txt`);
	// a crash is still written to crash.txt beside it.
	console: bool = true
	// true: built with the C library, as `-crt` does — for a program that
	// binds C source calling it (printf, malloc). It needs
	// Visual Studio's C library installed. A Windows program is otherwise
	// built with none: its runtime is Mara's own.
	crt: bool = false
	// What the program measures of itself as it runs, as `-profile` does.
	// "time": how long each fun takes, written to profile.txt beside the
	// program when it ends. "memory": how full each partial array and arena
	// gets, written to memory.txt. Empty: nothing.
	profile: [8]utf8
	// Modules whose funs a time profile doesn't time, as `-skip` does: up
	// to 4 names of up to 64 bytes each. Their funs are optimized as in any
	// build, and their time is their callers' own. It applies whenever the
	// build is time profiled, by `profile` here or by `-profile time`.
	profile_skip: [4][64]utf8
}
