// ---------------------------------------------------------------------------
// SDL_Event union — tagged by event type, inline variant definitions.
// SDL3 lays out the event header as: u32 type (0..3), u32 reserved (4..7),
// u64 timestamp (8..15), then variant fields. Mirroring that here:
// `pad 4` reserves 4 bytes after the u32 tag so the payload starts at byte 8,
// matching SDL3's timestamp position. Total size = 128 = sizeof(SDL_Event).
// ---------------------------------------------------------------------------

Event :: union(tag u32, pad u32, size 128) {
    Quit = 256 {
        timestamp: u64
    }
    Terminating = 257 {
        timestamp: u64
    }
    LowMemory = 258 {
        timestamp: u64
    }
    WillEnterBackground = 259 {
        timestamp: u64
    }
    DidEnterBackground = 260 {
        timestamp: u64
    }
    WillEnterForeground = 261 {
        timestamp: u64
    }
    DidEnterForeground = 262 {
        timestamp: u64
    }
    LocaleChanged = 263 {
        timestamp: u64
    }
    SystemThemeChanged = 264 {
        timestamp: u64
    }
    DisplayOrientation = 337 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayAdded = 338 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayRemoved = 339 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayMoved = 340 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayDesktopModeChanged = 341 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayCurrentModeChanged = 342 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayContentScaleChanged = 343 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayUsableBoundsChanged = 344 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    WindowShown = 514 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowHidden = 515 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowExposed = 516 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowMoved = 517 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowResized = 518 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowPixelSizeChanged = 519 {
