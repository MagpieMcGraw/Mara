// ---------------------------------------------------------------------------
// SDL_FRect — used for render operations
// ---------------------------------------------------------------------------

SDL_FRect :: struct {
    x: f32
    y: f32
    w: f32
    h: f32
}

// SDL_DisplayMode — a display's size and refresh rate (GetCurrentDisplayMode).
Display_Mode :: struct {
    display:      u32
    format:       u32
    w:            i32
    h:            i32
    pixel_density: f32
    refresh_rate: f32     // frames a second; 0 when the display doesn't say
    refresh_numerator:   i32
    refresh_denominator: i32
    internal:     ^byte
}

// SDL_Rect — whole pixels: a texture's region to update, the clip rect.
SDL_Rect :: struct {
    x: i32
    y: i32
    w: i32
    h: i32
}

// A texture's pixels, 4 bytes each in this order in memory: R, G, B, A.
// (SDL_PIXELFORMAT_RGBA32: ABGR8888 on a little-endian machine.)
PIXELFORMAT_RGBA32 :: u32(0x16762004)
TEXTUREACCESS_STATIC :: i32(0)    // updated now and then (UpdateTexture)
BLENDMODE_NONE  :: u32(0)
BLENDMODE_BLEND :: u32(1)         // drawn over what's there by its alpha
SCALEMODE_NEAREST :: i32(0)       // a texel to a pixel, never blended
KMOD_SHIFT :: u16(0x0003)         // either shift key (GetModState)
KMOD_CTRL  :: u16(0x00C0)         // either control key

// The system's cursors (CreateSystemCursor), the ones for resizing too.
SYSTEM_CURSOR_DEFAULT     :: i32(0)   // an arrow
SYSTEM_CURSOR_TEXT        :: i32(1)   // an I-beam, over text
SYSTEM_CURSOR_NWSE_RESIZE :: i32(5)   // pointing up-left and down-right
SYSTEM_CURSOR_NESW_RESIZE :: i32(6)   // up-right and down-left
SYSTEM_CURSOR_EW_RESIZE   :: i32(7)   // left and right
SYSTEM_CURSOR_NS_RESIZE   :: i32(8)   // up and down
SYSTEM_CURSOR_MOVE        :: i32(9)   // all four ways
SYSTEM_CURSOR_POINTER     :: i32(11)  // a hand, over a link

// ---------------------------------------------------------------------------
// SDL functions
// ---------------------------------------------------------------------------
// SDL Window flags
WindowFlags :: union(tag u32) {
    Fullscreen         = 1
    OpenGL             = 2
    Occluded           = 4
    Hidden             = 8
    Borderless         = 16
    Resizable          = 32
    Minimized          = 64
    Maximized          = 128
    MouseGrabbed       = 256
    InputFocus         = 512
    MouseFocus         = 1024
    HighPixelDensity   = 8192
    MouseCapture       = 16384
    MouseRelativeMode  = 32768
    AlwaysOnTop        = 65536
    Utility            = 131072
    Tooltip            = 262144
    PopupMenu          = 524288
    KeyboardGrabbed    = 1048576
    Vulkan             = 268435456
    Metal              = 536870912
}

// SDL GL attributes
GLattr :: union(tag i32) {
    RedSize            = 0
    GreenSize          = 1
    BlueSize           = 2
    AlphaSize          = 3
    BufferSize         = 4
    DoubleBuffer       = 5
    DepthSize          = 6
    StencilSize        = 7
    AccumRedSize       = 8
    AccumGreenSize     = 9
    AccumBlueSize      = 10
    AccumAlphaSize     = 11
    Stereo             = 12
    MultisampleBuffers = 13
    MultisampleSamples = 14
    ContextMajorVersion = 17
    ContextMinorVersion = 18
    ContextProfileMask  = 21
}

GLprofile :: union(tag i32) {
    Core          = 1
    Compatibility = 2
    ES            = 4
}

// ---------------------------------------------------------------------------
// Opaque handle types
// ---------------------------------------------------------------------------
Window    :: ^byte
Renderer  :: distinct ^byte
Texture   :: distinct ^byte   // a renderer's image (CreateTexture)
Cursor    :: distinct ^byte   // a mouse cursor's look (CreateSystemCursor)
GLContext :: ^byte
IOStream  :: distinct ^byte

// ---------------------------------------------------------------------------
// Filesystem types
// ---------------------------------------------------------------------------

IOWhence :: union(tag i32) {
    Set = 0
    Cur = 1
    End = 2
}

PathType :: union(tag u32) {
    None      = 0
    File      = 1
    Directory = 2
    Other     = 3
}

PathInfo :: struct {
    type:        PathType
    size:        u64
    create_time: i64
    modify_time: i64
    access_time: i64
}

// C's text at p, 0-ended, appended into the buffer `out`, as much as its
// room holds (p void: none). A buffer keeps a 0 after its text, so it's C
// text again — a view of C's memory wouldn't be: its len is its cap, and
// cstring() finds no 0 after it.
c_text :: fun(p: ^byte, out: ^[$N]utf8) {
    if p == void do return
    view : []utf8 = slice_from_ptr(p, 1 << 20)
    for ch in view {
        if ch == 0 or out.len + 1 >= out.cap do break
        out[out.len] = ch
        out.len += 1
    }
    out[out.len] = 0
}

// MAKE SURE STRINGS PASSED TO C CODE HAVE A \0
foreign static_lib "SDL3" {
    fun SDL_Init(flags: Init_Flags) -> bool
    fun SDL_SetHint(name: cstring, value: cstring) -> bool
    fun SDL_CreateWindow(title: cstring, w: i32, h: i32, flags: WindowFlags) -> Window
    fun SDL_DestroyWindow(window: Window)
    fun SDL_GetWindowSize(window: Window, w: ^i32, h: ^i32) -> bool
    fun SDL_GetWindowSizeInPixels(window: Window, w: ^i32, h: ^i32) -> bool
    fun SDL_SetWindowRelativeMouseMode(window: Window, enabled: bool) -> bool
    fun SDL_PollEvent(event: ^Event) -> bool
    fun SDL_Delay(ms: u32)
    fun SDL_Quit()
    fun SDL_CreateRenderer(window: Window, name: cstring) -> Renderer
    fun SDL_DestroyRenderer(renderer: Renderer)
    fun SDL_SetRenderDrawColor(renderer: Renderer, r: u8, g: u8, b: u8, a: u8) -> bool
    fun SDL_RenderClear(renderer: Renderer) -> bool
    fun SDL_RenderFillRect(renderer: Renderer, rect: ^SDL_FRect) -> bool
    fun SDL_RenderPresent(renderer: Renderer) -> bool
    fun SDL_SetRenderDrawBlendMode(renderer: Renderer, mode: u32) -> bool
    fun SDL_SetRenderVSync(renderer: Renderer, vsync: i32) -> bool
    fun SDL_GetRenderOutputSize(renderer: Renderer, w: ^i32, h: ^i32) -> bool
    fun SDL_SetRenderClipRect(renderer: Renderer, rect: ^SDL_Rect) -> bool
    fun SDL_CreateTexture(renderer: Renderer, format: u32, access: i32, w: i32, h: i32) -> Texture
    fun SDL_UpdateTexture(texture: Texture, rect: ^SDL_Rect, pixels: ^byte, pitch: i32) -> bool
    fun SDL_RenderTexture(renderer: Renderer, texture: Texture, src: ^SDL_FRect, dst: ^SDL_FRect) -> bool
    fun SDL_SetTextureBlendMode(texture: Texture, mode: u32) -> bool
    fun SDL_SetTextureColorMod(texture: Texture, r: u8, g: u8, b: u8) -> bool
    fun SDL_SetTextureScaleMode(texture: Texture, mode: i32) -> bool
    fun SDL_DestroyTexture(texture: Texture)
    fun SDL_WaitEventTimeout(event: ^Event, ms: i32) -> bool
    fun SDL_SetWindowTitle(window: Window, title: cstring) -> bool
    fun SDL_SetWindowSize(window: Window, w: i32, h: i32) -> bool
    fun SDL_GetDisplayForWindow(window: Window) -> u32
    fun SDL_GetDisplayUsableBounds(display: u32, rect: ^SDL_Rect) -> bool
    fun SDL_GetCurrentDisplayMode(display: u32) -> ^Display_Mode
    fun SDL_GetModState() -> u16
    fun SDL_SetClipboardText(text: cstring) -> bool
    fun SDL_GetGlobalMouseState(x: ^f32, y: ^f32) -> u32
    fun SDL_GetWindowPosition(window: Window, x: ^i32, y: ^i32) -> bool
    fun SDL_GetWindowFlags(window: Window) -> u64
    fun SDL_RestoreWindow(window: Window) -> bool
    fun SDL_MaximizeWindow(window: Window) -> bool
    fun SDL_RaiseWindow(window: Window) -> bool
    fun SDL_CreateSystemCursor(id: i32) -> Cursor
    fun SDL_SetCursor(cursor: Cursor) -> bool
    fun SDL_GL_SetAttribute(attr: GLattr, value: i32) -> bool
    fun SDL_GL_CreateContext(window: Window) -> GLContext
    fun SDL_GL_MakeCurrent(window: Window, context: GLContext) -> bool
    fun SDL_GL_DestroyContext(context: GLContext) -> bool
    fun SDL_GL_SetSwapInterval(interval: i32) -> bool
    fun SDL_GL_SwapWindow(window: Window) -> bool
    fun SDL_GL_GetProcAddress(name: cstring) -> ^byte
    fun SDL_GetTicks() -> u32
    fun SDL_GetTicksNS() -> u64
    fun SDL_GetPerformanceCounter() -> u64
    fun SDL_GetPerformanceFrequency() -> u64
    fun SDL_DelayNS(ns: u64)
    fun SDL_DelayPrecise(ns: u64)
    fun SDL_GetError() -> ^byte
    fun SDL_malloc(size: usize) -> ^byte
    fun SDL_free(mem: ^byte)
    fun SDL_IOFromFile(file: cstring, mode: cstring) -> IOStream
    fun SDL_CloseIO(context: IOStream) -> bool
    fun SDL_ReadIO(context: IOStream, ptr: ^byte, size: usize) -> usize
    fun SDL_WriteIO(context: IOStream, ptr: ^byte, size: usize) -> usize
    fun SDL_SeekIO(context: IOStream, offset: i64, whence: IOWhence) -> i64
    fun SDL_TellIO(context: IOStream) -> i64
    fun SDL_GetIOSize(context: IOStream) -> i64
    fun SDL_FlushIO(context: IOStream) -> bool
    fun SDL_LoadFile(file: cstring, datasize: ^usize) -> ^byte
    fun SDL_SaveFile(file: cstring, data: ^byte, datasize: usize) -> bool
    fun SDL_GetBasePath() -> ^byte
    fun SDL_GetPrefPath(org: cstring, app: cstring) -> ^byte
    fun SDL_GetCurrentDirectory() -> ^byte
    fun SDL_CreateDirectory(path: cstring) -> bool
    fun SDL_RemovePath(path: cstring) -> bool
    fun SDL_RenamePath(oldpath: cstring, newpath: cstring) -> bool
    fun SDL_CopyFile(oldpath: cstring, newpath: cstring) -> bool
    fun SDL_GetPathInfo(path: cstring, info: ^PathInfo) -> bool
    fun SDL_InitSubSystem(flags: Init_Flags) -> bool
    fun SDL_QuitSubSystem(flags: Init_Flags)
    fun SDL_OpenAudioDeviceStream(device: u32, spec: ^AudioSpec, callback: ^byte, userdata: ^byte) -> AudioStream
    fun SDL_ResumeAudioStreamDevice(stream: AudioStream) -> bool
    fun SDL_PauseAudioStreamDevice(stream: AudioStream) -> bool
    fun SDL_PutAudioStreamData(stream: AudioStream, buf: ^byte, len: i32) -> bool
    fun SDL_GetAudioStreamQueued(stream: AudioStream) -> i32
    fun SDL_ClearAudioStream(stream: AudioStream) -> bool
    fun SDL_FlushAudioStream(stream: AudioStream) -> bool
    fun SDL_SetAudioStreamGain(stream: AudioStream, gain: f32) -> bool
    fun SDL_DestroyAudioStream(stream: AudioStream)
}

Init :: fun(flags: Init_Flags) -> bool { return SDL_Init(flags) }
SetHint :: fun(name: [$N]utf8, value: [$M]utf8) -> bool { return SDL_SetHint(cstring(name), cstring(value)) }
CreateWindow :: fun(title: [$N]utf8, w: i32, h: i32, flags: WindowFlags) -> Window { return SDL_CreateWindow(cstring(title), w, h, flags) }
DestroyWindow :: fun(window: Window) { SDL_DestroyWindow(window) }
GetWindowSize :: fun(window: Window, w: ^i32, h: ^i32) -> bool { return SDL_GetWindowSize(window, w, h) }
GetWindowSizeInPixels :: fun(window: Window, w: ^i32, h: ^i32) -> bool { return SDL_GetWindowSizeInPixels(window, w, h) }
// Locks the cursor to the window, hides it, and feeds relative motion.
SetWindowRelativeMouseMode :: fun(window: Window, enabled: bool) -> bool { return SDL_SetWindowRelativeMouseMode(window, enabled) }
PollEvent :: fun(event: ^Event) -> bool { return SDL_PollEvent(event) }
Delay :: fun(ms: u32) { SDL_Delay(ms) }
Quit :: fun() { SDL_Quit() }
// name: a driver's ("opengl", "direct3d11", …).
CreateRenderer :: fun(window: Window, name: [$N]utf8) -> Renderer { return SDL_CreateRenderer(window, cstring(name)) }
DestroyRenderer :: fun(renderer: Renderer) { SDL_DestroyRenderer(renderer) }
SetRenderDrawColor :: fun(renderer: Renderer, r: u8, g: u8, b: u8, a: u8) -> bool { return SDL_SetRenderDrawColor(renderer, r, g, b, a) }
RenderClear :: fun(renderer: Renderer) -> bool { return SDL_RenderClear(renderer) }
RenderFillRect :: fun(renderer: Renderer, rect: ^SDL_FRect) -> bool { return SDL_RenderFillRect(renderer, rect) }
RenderPresent :: fun(renderer: Renderer) -> bool { return SDL_RenderPresent(renderer) }
SetRenderDrawBlendMode :: fun(renderer: Renderer, mode: u32) -> bool { return SDL_SetRenderDrawBlendMode(renderer, mode) }
SetRenderVSync :: fun(renderer: Renderer, vsync: i32) -> bool { return SDL_SetRenderVSync(renderer, vsync) }
// The renderer's size in pixels (a window's on a high-density display
// has more than its size says).
GetRenderOutputSize :: fun(renderer: Renderer, w: ^i32, h: ^i32) -> bool { return SDL_GetRenderOutputSize(renderer, w, h) }
// Drawing kept inside rect (ClearRenderClipRect: everywhere again).
SetRenderClipRect :: fun(renderer: Renderer, rect: ^SDL_Rect) -> bool { return SDL_SetRenderClipRect(renderer, rect) }
// Drawing everywhere again: no clip rect.
ClearRenderClipRect :: fun(renderer: Renderer) -> bool { return SDL_SetRenderClipRect(renderer, void) }
CreateTexture :: fun(renderer: Renderer, format: u32, access: i32, w: i32, h: i32) -> Texture { return SDL_CreateTexture(renderer, format, access, w, h) }
// The pixels of the texture's rect, `pitch` bytes from a row to the next
// (UpdateWholeTexture: all of it).
UpdateTexture :: fun(texture: Texture, rect: ^SDL_Rect, pixels: []$T, pitch: i32) -> bool { return SDL_UpdateTexture(texture, rect, pixels.ptr, pitch) }
// The whole texture's pixels, as UpdateTexture writes a rect's.
UpdateWholeTexture :: fun(texture: Texture, pixels: []$T, pitch: i32) -> bool { return SDL_UpdateTexture(texture, void, pixels.ptr, pitch) }
RenderTexture :: fun(renderer: Renderer, texture: Texture, src: ^SDL_FRect, dst: ^SDL_FRect) -> bool { return SDL_RenderTexture(renderer, texture, src, dst) }
SetTextureBlendMode :: fun(texture: Texture, mode: u32) -> bool { return SDL_SetTextureBlendMode(texture, mode) }
// Each texel's color multiplied by this: white texels drawn in it.
SetTextureColorMod :: fun(texture: Texture, r: u8, g: u8, b: u8) -> bool { return SDL_SetTextureColorMod(texture, r, g, b) }
SetTextureScaleMode :: fun(texture: Texture, mode: i32) -> bool { return SDL_SetTextureScaleMode(texture, mode) }
DestroyTexture :: fun(texture: Texture) { SDL_DestroyTexture(texture) }
// The next event, waiting for it up to ms milliseconds: false when none came.
WaitEventTimeout :: fun(event: ^Event, ms: i32) -> bool { return SDL_WaitEventTimeout(event, ms) }
SetWindowTitle :: fun(window: Window, title: [$N]utf8) -> bool { return SDL_SetWindowTitle(window, cstring(title)) }
SetWindowSize :: fun(window: Window, w: i32, h: i32) -> bool { return SDL_SetWindowSize(window, w, h) }
// The display the window is on, and the part of it windows can use
// (the taskbar's left out).
GetDisplayForWindow :: fun(window: Window) -> u32 { return SDL_GetDisplayForWindow(window) }
GetDisplayUsableBounds :: fun(display: u32, rect: ^SDL_Rect) -> bool { return SDL_GetDisplayUsableBounds(display, rect) }
// The display's mode now: its refresh rate among it. (void: none.)
GetCurrentDisplayMode :: fun(display: u32) -> ^Display_Mode { return SDL_GetCurrentDisplayMode(display) }
// The modifier keys held now: KMOD_SHIFT, ...
GetModState :: fun() -> u16 { return SDL_GetModState() }
// Text put on the system's clipboard, for pasting anywhere.
SetClipboardText :: fun(text: [$N]utf8) -> bool { return SDL_SetClipboardText(cstring(text)) }
// Where the cursor is on the screen (and the buttons held).
GetGlobalMouseState :: fun(x: ^f32, y: ^f32) -> u32 { return SDL_GetGlobalMouseState(x, y) }
// Where the window's inside is on the screen.
GetWindowPosition :: fun(window: Window, x: ^i32, y: ^i32) -> bool { return SDL_GetWindowPosition(window, x, y) }
// The window's state, WindowFlags' bits: Minimized, InputFocus, ...
GetWindowFlags :: fun(window: Window) -> u64 { return SDL_GetWindowFlags(window) }
// A minimized (or maximized) window back to its size and place.
RestoreWindow :: fun(window: Window) -> bool { return SDL_RestoreWindow(window) }
MaximizeWindow :: fun(window: Window) -> bool { return SDL_MaximizeWindow(window) }
// The window in front of the others, given the keyboard.
RaiseWindow :: fun(window: Window) -> bool { return SDL_RaiseWindow(window) }
CreateSystemCursor :: fun(id: i32) -> Cursor { return SDL_CreateSystemCursor(id) }
// The mouse cursor's look, over the windows of this program.
SetCursor :: fun(cursor: Cursor) -> bool { return SDL_SetCursor(cursor) }
GL_SetAttribute :: fun(attr: GLattr, value: i32) -> bool { return SDL_GL_SetAttribute(attr, value) }
GL_CreateContext :: fun(window: Window) -> GLContext { return SDL_GL_CreateContext(window) }
GL_MakeCurrent :: fun(window: Window, context: GLContext) -> bool { return SDL_GL_MakeCurrent(window, context) }
GL_DestroyContext :: fun(context: GLContext) -> bool { return SDL_GL_DestroyContext(context) }
GL_SetSwapInterval :: fun(interval: i32) -> bool { return SDL_GL_SetSwapInterval(interval) }
GL_SwapWindow :: fun(window: Window) -> bool { return SDL_GL_SwapWindow(window) }
GL_GetProcAddress :: fun(name: [64]utf8) -> ^byte { return SDL_GL_GetProcAddress(cstring(name)) }
GetTicks :: fun() -> u32 { return SDL_GetTicks() }
GetTicksNS :: fun() -> u64 { return SDL_GetTicksNS() }
GetPerformanceCounter :: fun() -> u64 { return SDL_GetPerformanceCounter() }
GetPerformanceFrequency :: fun() -> u64 { return SDL_GetPerformanceFrequency() }
DelayNS :: fun(ns: u64) { SDL_DelayNS(ns) }
DelayPrecise :: fun(ns: u64) { SDL_DelayPrecise(ns) }
// What failed last, as SDL says it.
GetError :: fun() -> [256]utf8 {
    out : [256]utf8
    c_text(SDL_GetError(), &out)
    return out
}

// Memory
malloc :: fun(size: usize) -> ^byte { return SDL_malloc(size) }

// Filesystem — IOStream
IOFromFile :: fun(file: [$N]utf8, mode: [$M]utf8) -> IOStream { return SDL_IOFromFile(cstring(file), cstring(mode)) }
CloseIO :: fun(context: IOStream) -> bool { return SDL_CloseIO(context) }
// As much as `into` holds read into it from the stream: how many bytes
// came (fewer at its end; 0, failing).
ReadIO :: fun(context: IOStream, into: []$T) -> usize { return SDL_ReadIO(context, into.ptr, usize(into.len * size_of(T))) }
// `data` written to the stream: how many bytes went.
WriteIO :: fun(context: IOStream, data: []$T) -> usize { return SDL_WriteIO(context, data.ptr, usize(data.len * size_of(T))) }
SeekIO :: fun(context: IOStream, offset: i64, whence: IOWhence) -> i64 { return SDL_SeekIO(context, offset, whence) }
TellIO :: fun(context: IOStream) -> i64 { return SDL_TellIO(context) }
GetIOSize :: fun(context: IOStream) -> i64 { return SDL_GetIOSize(context) }
FlushIO :: fun(context: IOStream) -> bool { return SDL_FlushIO(context) }
LoadFile :: fun(file: [$N]utf8, datasize: ^usize) -> ^byte { return SDL_LoadFile(cstring(file), datasize) }
// `data` written to the file `file`, made new or over what it held.
SaveFile :: fun(file: [$N]utf8, data: []$T) -> bool { return SDL_SaveFile(cstring(file), data.ptr, usize(data.len * size_of(T))) }

// Filesystem — paths & metadata
// The directory the program runs from, '/'-ended (SDL's to keep).
GetBasePath :: fun() -> [512]utf8 {
    out : [512]utf8
    c_text(SDL_GetBasePath(), &out)
    return out
}
// The directory for the program's own files, made if it isn't there
// (SDL's memory, freed once copied).
GetPrefPath :: fun(org: [$N]utf8, app: [$M]utf8) -> [512]utf8 {
    out : [512]utf8
    p := SDL_GetPrefPath(cstring(org), cstring(app))
    c_text(p, &out)
    if p != void do SDL_free(p)
    return out
}
// The directory the program runs in (SDL's memory, freed once copied).
GetCurrentDirectory :: fun() -> [512]utf8 {
    out : [512]utf8
    p := SDL_GetCurrentDirectory()
    c_text(p, &out)
    if p != void do SDL_free(p)
    return out
}
CreateDirectory :: fun(path: [$N]utf8) -> bool { return SDL_CreateDirectory(cstring(path)) }
RemovePath :: fun(path: [$N]utf8) -> bool { return SDL_RemovePath(cstring(path)) }
RenamePath :: fun(oldpath: [$N]utf8, newpath: [$M]utf8) -> bool { return SDL_RenamePath(cstring(oldpath), cstring(newpath)) }
CopyFile :: fun(oldpath: [$N]utf8, newpath: [$M]utf8) -> bool { return SDL_CopyFile(cstring(oldpath), cstring(newpath)) }
GetPathInfo :: fun(path: [$N]utf8, info: ^PathInfo) -> bool { return SDL_GetPathInfo(cstring(path), info) }

// Audio — a stream to play through: opened on a device, given samples
// (PutAudioStreamData), it plays them, converting to the device's format
// on the way. It starts paused: ResumeAudioStreamDevice. The subsystem
// first: InitSubSystem(Audio) (or Init with it).

// The device SDL picks: the system's default output (or input).
AUDIO_DEVICE_DEFAULT_PLAYBACK  :: u32(0xFFFFFFFF)
AUDIO_DEVICE_DEFAULT_RECORDING :: u32(0xFFFFFFFE)

// An audio stream: what's put into it is played (OpenAudioDeviceStream).
AudioStream :: distinct ^byte

// A sample's format (SDL_AudioFormat): its bits, signed or not, a float or
// not, its bytes' order. S16, S32 and F32 are this machine's order (little-
// endian: x86, ARM).
AudioFormat :: union(tag u32) {
    U8    = 0x0008
    S8    = 0x8008
    S16LE = 0x8010
    S16BE = 0x9010
    S32LE = 0x8020
    S32BE = 0x9020
    F32LE = 0x8120
    F32BE = 0x9120
    S16   = 0x8010
    S32   = 0x8020
    F32   = 0x8120
}

// What a stream's samples are: their format, how many channels (2:
// stereo, each frame a left sample and a right), how many frames a second.
AudioSpec :: struct {
    format: AudioFormat
    channels: i32
    freq: i32
}

// Starts or stops some of SDL (Audio, say) apart from Init.
InitSubSystem :: fun(flags: Init_Flags) -> bool { return SDL_InitSubSystem(flags) }
QuitSubSystem :: fun(flags: Init_Flags) { SDL_QuitSubSystem(flags) }

// A stream onto `device` (AUDIO_DEVICE_DEFAULT_PLAYBACK) taking samples of
// `spec`, paused: void failing (GetError says why). What's played is what's
// put into it — no callback.
OpenAudioDeviceStream :: fun(device: u32, spec: AudioSpec) -> AudioStream {
    s := spec
    return SDL_OpenAudioDeviceStream(device, &s, void, void)
}
// The stream's device playing, or paused.
ResumeAudioStreamDevice :: fun(stream: AudioStream) -> bool { return SDL_ResumeAudioStreamDevice(stream) }
PauseAudioStreamDevice :: fun(stream: AudioStream) -> bool { return SDL_PauseAudioStreamDevice(stream) }
// Samples to play after what's queued: `data` (f32s for AudioFormat.F32),
// its channels' samples one after another.
PutAudioStreamData :: fun(stream: AudioStream, data: []$T) -> bool {
    return SDL_PutAudioStreamData(stream, data.ptr, i32(data.len * size_of(T)))
}
// How many bytes are queued, not played yet: what to keep ahead of.
GetAudioStreamQueued :: fun(stream: AudioStream) -> i32 { return SDL_GetAudioStreamQueued(stream) }
// What's queued dropped, unplayed.
ClearAudioStream :: fun(stream: AudioStream) -> bool { return SDL_ClearAudioStream(stream) }
// What's queued played through, though it doesn't fill a whole chunk: put
// at the end.
FlushAudioStream :: fun(stream: AudioStream) -> bool { return SDL_FlushAudioStream(stream) }
// The stream's volume: 1 as it is, 0 silent.
SetAudioStreamGain :: fun(stream: AudioStream, gain: f32) -> bool { return SDL_SetAudioStreamGain(stream, gain) }
// The stream closed, and its device with it (one opened for it).
DestroyAudioStream :: fun(stream: AudioStream) { SDL_DestroyAudioStream(stream) }
