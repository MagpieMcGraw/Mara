        data1: i32
        data2: i32
    }
    WindowHitTest = 529 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowIccprofChanged = 530 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowDisplayChanged = 531 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowDisplayScaleChanged = 532 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowSafeAreaChanged = 533 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowOccluded = 534 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowEnterFullscreen = 535 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowLeaveFullscreen = 536 {
        timestamp: u64
        windowID: u32
        data1: i32
