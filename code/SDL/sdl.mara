    }
    KeyboardRemoved = 774 {
        timestamp: u64
        which: u32
    }
    TextEditingCandidates = 775 {
        timestamp: u64
        windowID: u32
        candidates: ^byte
        num_candidates: i32
        selected_candidate: i32
        horizontal: u8
        padding1: u8
        padding2: u8
        padding3: u8
    }
    ScreenKeyboardShown = 776 {
        timestamp: u64
        windowID: u32
    }
    ScreenKeyboardHidden = 777 {
        timestamp: u64
        windowID: u32
    }
    MouseMotion = 1024 {
        timestamp: u64
        windowID: u32
        which: u32
        state: u32
        x: f32
        y: f32
        xrel: f32
        yrel: f32
    }
    MouseButtonDown = 1025 {
        timestamp: u64
        windowID: u32
        which: u32
        button: u8
        down: u8
        clicks: u8
        padding: u8
