    }
    GamepadAxisMotion = 1616 {
        timestamp: u64
        which: u32
        axis: u8
        padding1: u8
        padding2: u8
        padding3: u8
        value: i16
        padding4: u16
    }
    GamepadButtonDown = 1617 {
