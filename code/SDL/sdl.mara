module mara.sdl

// SDL3 bindings for Mara

Init_Flags :: union(tag u32) {
    Audio    = 16
    Video    = 32
    Joystick = 512
    Haptic   = 4096
    Gamepad  = 8192
    Events   = 16384
    Sensor   = 32768
    Camera   = 65536
}

// NEEDS DISTINCT!
// Variant names follow Mara's PascalCase convention even though SDL3's
// C constants are ALL_CAPS. Bare digits aren't valid identifiers, so the
// numeric row uses Num<n> / Kp<n>.
Scancode :: union(tag u32) {
    Unknown            = 0
    A                  = 4
    B                  = 5
    C                  = 6
    D                  = 7
    E                  = 8
    F                  = 9
    G                  = 10
    H                  = 11
    I                  = 12
    J                  = 13
    K                  = 14
    L                  = 15
    M                  = 16
    N                  = 17
    O                  = 18
    P                  = 19
    Q                  = 20
    R                  = 21
    S                  = 22
    T                  = 23
    U                  = 24
    V                  = 25
    W                  = 26
    X                  = 27
    Y                  = 28
    Z                  = 29
    Num1               = 30
    Num2               = 31
    Num3               = 32
    Num4               = 33
    Num5               = 34
    Num6               = 35
    Num7               = 36
    Num8               = 37
    Num9               = 38
    Num0               = 39
    Return             = 40
    Escape             = 41
    Backspace          = 42
    Tab                = 43
    Space              = 44
    Minus              = 45
    Equals             = 46
    LeftBracket        = 47
    RightBracket       = 48
    Backslash          = 49
    NonUsHash          = 50
    Semicolon          = 51
    Apostrophe         = 52
    Grave              = 53
    Comma              = 54
    Period             = 55
    Slash              = 56
    CapsLock           = 57
    F1                 = 58
    F2                 = 59
    F3                 = 60
    F4                 = 61
