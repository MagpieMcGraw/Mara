        data1: i32
        data2: i32
    }
    WindowHdrStateChanged = 538 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    KeyDown = 768 {
        timestamp: u64
        windowID: u32
        which: u32
        scancode: Scancode
        key: u32
        mod: u16
        raw: u16
        down: u8
        repeat: u8
    }
    KeyUp = 769 {
        timestamp: u64
        windowID: u32
        which: u32
        scancode: Scancode
        key: u32
        mod: u16
        raw: u16
        down: u8
        repeat: u8
    }
    TextEditing = 770 {
        timestamp: u64
        windowID: u32
        text: ^byte
