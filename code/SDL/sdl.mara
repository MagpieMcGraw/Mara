    AcClose            = 275
    AcExit             = 276
    AcSave             = 277
    AcPrint            = 278
    AcProperties       = 279
    AcSearch           = 280
    AcHome             = 281
    AcBack             = 282
    AcForward          = 283
    AcStop             = 284
    AcRefresh          = 285
    AcBookmarks        = 286
    SoftLeft           = 287
