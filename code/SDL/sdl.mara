module mara.sdl

// SDL3 bindings for Mara

Init_Flags :: union(tag u32) {
    Audio    = 16
    Video    = 32
    Joystick = 512
    Haptic   = 4096
    Gamepad  = 8192
    Events   = 16384
    Sensor   = 32768
    Camera   = 65536
}

// NEEDS DISTINCT!
Scancode :: union(tag u32) {
    Unknown  = 0
    A        = 4
    B        = 5
    C        = 6
    D        = 7
    E        = 8
    F        = 9
    G        = 10
    H        = 11
    I        = 12
    J        = 13
    K        = 14
    L        = 15
    M        = 16
    N        = 17
    O        = 18
    P        = 19
    Q        = 20
    R        = 21
    S        = 22
    T        = 23
    U        = 24
    V        = 25
    W        = 26
    X        = 27
    Y        = 28
    Z        = 29
    Num1     = 30
    Num2     = 31
    Num3     = 32
    Num4     = 33
    Num5     = 34
    Num6     = 35
    Num7     = 36
    Num8     = 37
    Num9     = 38
    Num0     = 39
    Return   = 40
    Escape   = 41
    Backspace = 42
    Tab      = 43
    Space    = 44
    Right    = 79
    Left     = 80
    Down     = 81
    Up       = 82
    LCTRL    = 224
    LSHIFT   = 225
    LALT     = 226
    LGUI     = 227
    RCTRL    = 228
    RSHIFT   = 229
    RALT     = 230
    RGUI     = 231
}

// ---------------------------------------------------------------------------
// SDL_Event union — tagged by event type, inline variant definitions.
// SDL3 lays out the event header as: u32 type (0..3), u32 reserved (4..7),
// u64 timestamp (8..15), then variant fields. Mirroring that here:
// `pad 4` reserves 4 bytes after the u32 tag so the payload starts at byte 8,
// matching SDL3's timestamp position. Total size = 128 = sizeof(SDL_Event).
// ---------------------------------------------------------------------------

Event :: union(tag u32, pad u32, size 128) {
    Quit = 256 {
        timestamp: u64
    }
    Terminating = 257 {
        timestamp: u64
    }
    LowMemory = 258 {
        timestamp: u64
    }
    WillEnterBackground = 259 {
        timestamp: u64
    }
    DidEnterBackground = 260 {
        timestamp: u64
    }
    WillEnterForeground = 261 {
        timestamp: u64
    }
    DidEnterForeground = 262 {
        timestamp: u64
    }
    LocaleChanged = 263 {
        timestamp: u64
    }
    SystemThemeChanged = 264 {
        timestamp: u64
    }
    DisplayOrientation = 337 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayAdded = 338 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayRemoved = 339 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayMoved = 340 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayDesktopModeChanged = 341 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayCurrentModeChanged = 342 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayContentScaleChanged = 343 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    DisplayUsableBoundsChanged = 344 {
        timestamp: u64
        displayID: u32
        data1: i32
        data2: i32
    }
    WindowShown = 514 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowHidden = 515 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowExposed = 516 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowMoved = 517 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowResized = 518 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowPixelSizeChanged = 519 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowMetalViewResized = 520 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowMinimized = 521 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowMaximized = 522 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowRestored = 523 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowMouseEnter = 524 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowMouseLeave = 525 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowFocusGained = 526 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowFocusLost = 527 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowCloseRequested = 528 {
        timestamp: u64
