        windowID: u32
        data1: i32
        data2: i32
    }
    WindowDisplayScaleChanged = 532 {
        timestamp: u64
        windowID: u32
        data1: i32
        data2: i32
    }
    WindowSafeAreaChanged = 533 {
        timestamp: u64
        windowID: u32
        data1: i32
