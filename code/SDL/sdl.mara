// ---------------------------------------------------------------------------
// SDL_FRect — used for render operations
// ---------------------------------------------------------------------------

SDL_FRect :: struct {
    x: f32
    y: f32
    w: f32
    h: f32
}

// SDL_DisplayMode — a display's size and refresh rate (GetCurrentDisplayMode).
Display_Mode :: struct {
    display:      u32
    format:       u32
    w:            i32
    h:            i32
    pixel_density: f32
    refresh_rate: f32     // frames a second; 0 when the display doesn't say
    refresh_numerator:   i32
    refresh_denominator: i32
    internal:     ^byte
}

// SDL_Rect — whole pixels: a texture's region to update, the clip rect.
SDL_Rect :: struct {
    x: i32
    y: i32
    w: i32
    h: i32
}

// A texture's pixels, 4 bytes each in this order in memory: R, G, B, A.
// (SDL_PIXELFORMAT_RGBA32: ABGR8888 on a little-endian machine.)
PIXELFORMAT_RGBA32 :: u32(0x16762004)
TEXTUREACCESS_STATIC :: i32(0)    // updated now and then (UpdateTexture)
BLENDMODE_NONE  :: u32(0)
BLENDMODE_BLEND :: u32(1)         // drawn over what's there by its alpha
SCALEMODE_NEAREST :: i32(0)       // a texel to a pixel, never blended
KMOD_SHIFT :: u16(0x0003)         // either shift key (GetModState)
KMOD_CTRL  :: u16(0x00C0)         // either control key

// The system's cursors (CreateSystemCursor), the ones for resizing too.
SYSTEM_CURSOR_DEFAULT     :: i32(0)   // an arrow
SYSTEM_CURSOR_TEXT        :: i32(1)   // an I-beam, over text
SYSTEM_CURSOR_NWSE_RESIZE :: i32(5)   // pointing up-left and down-right
SYSTEM_CURSOR_NESW_RESIZE :: i32(6)   // up-right and down-left
SYSTEM_CURSOR_EW_RESIZE   :: i32(7)   // left and right
SYSTEM_CURSOR_NS_RESIZE   :: i32(8)   // up and down
SYSTEM_CURSOR_MOVE        :: i32(9)   // all four ways
SYSTEM_CURSOR_POINTER     :: i32(11)  // a hand, over a link

// ---------------------------------------------------------------------------
// SDL functions
// ---------------------------------------------------------------------------
// SDL Window flags
WindowFlags :: union(tag u32) {
    Fullscreen         = 1
    OpenGL             = 2
    Occluded           = 4
    Hidden             = 8
    Borderless         = 16
    Resizable          = 32
    Minimized          = 64
    Maximized          = 128
    MouseGrabbed       = 256
    InputFocus         = 512
    MouseFocus         = 1024
    HighPixelDensity   = 8192
    MouseCapture       = 16384
    MouseRelativeMode  = 32768
    AlwaysOnTop        = 65536
    Utility            = 131072
    Tooltip            = 262144
    PopupMenu          = 524288
    KeyboardGrabbed    = 1048576
    Vulkan             = 268435456
    Metal              = 536870912
}

// SDL GL attributes
GLattr :: union(tag i32) {
    RedSize            = 0
    GreenSize          = 1
    BlueSize           = 2
    AlphaSize          = 3
    BufferSize         = 4
    DoubleBuffer       = 5
    DepthSize          = 6
    StencilSize        = 7
    AccumRedSize       = 8
    AccumGreenSize     = 9
    AccumBlueSize      = 10
    AccumAlphaSize     = 11
    Stereo             = 12
    MultisampleBuffers = 13
    MultisampleSamples = 14
    ContextMajorVersion = 17
    ContextMinorVersion = 18
    ContextProfileMask  = 21
}

GLprofile :: union(tag i32) {
    Core          = 1
    Compatibility = 2
    ES            = 4
}

// ---------------------------------------------------------------------------
// Opaque handle types
// ---------------------------------------------------------------------------
Window    :: ^byte
Renderer  :: distinct ^byte
Texture   :: distinct ^byte   // a renderer's image (CreateTexture)
Cursor    :: distinct ^byte   // a mouse cursor's look (CreateSystemCursor)
GLContext :: ^byte
IOStream  :: distinct ^byte

// ---------------------------------------------------------------------------
// Filesystem types
// ---------------------------------------------------------------------------

IOWhence :: union(tag i32) {
    Set = 0
    Cur = 1
    End = 2
}

PathType :: union(tag u32) {
    None      = 0
    File      = 1
    Directory = 2
    Other     = 3
}

PathInfo :: struct {
    type:        PathType
    size:        u64
    create_time: i64
    modify_time: i64
    access_time: i64
}

// MAKE SURE STRINGS PASSED TO C CODE HAVE A \0
// SDL reports success, not failure: its functions return true when they worked,
// and a handle is NULL when making it failed. `fails Failed` turns that around:
// a fun here that gives err is Ok when it worked, and Failed when it didn't. One
// that gives no err is called as it is, so PollEvent's bool still means an event.
foreign static_lib "SDL3" prefix SDL_ fails Failed {
    fun Init(flags: Init_Flags) -> err
    // What failed last, as SDL says it: C text, SDL's to keep (print_cstr, read_cstring).
    fun GetError() -> ^byte
    fun SetHint(name: cstring, value: cstring) -> err
    fun CreateWindow(title: cstring, w: i32, h: i32, flags: WindowFlags) -> Window, err
    fun SetWindowTitle(window: Window, title: cstring) -> err
    fun DestroyWindow(window: Window)
    fun GetWindowSize(window: Window, w: ^i32, h: ^i32) -> err
    fun GetWindowSizeInPixels(window: Window, w: ^i32, h: ^i32) -> err
    // Locks the cursor to the window, hides it, and feeds relative motion.
    fun SetWindowRelativeMouseMode(window: Window, enabled: bool) -> err
    fun PollEvent(event: ^Event) -> bool
    fun Delay(ms: u32)
    fun Quit()
    // name: a driver's ("opengl", "direct3d11", …).
    fun CreateRenderer(window: Window, name: cstring) -> Renderer, err
    fun DestroyRenderer(renderer: Renderer)
    fun SetRenderDrawColor(renderer: Renderer, r: u8, g: u8, b: u8, a: u8) -> err
    fun RenderClear(renderer: Renderer) -> err
    fun RenderFillRect(renderer: Renderer, rect: ^SDL_FRect) -> err
    fun RenderPresent(renderer: Renderer) -> err
    fun SetRenderDrawBlendMode(renderer: Renderer, mode: u32) -> err
    fun SetRenderVSync(renderer: Renderer, vsync: i32) -> err
    // The renderer's size in pixels (a window's on a high-density display
    // has more than its size says).
    fun GetRenderOutputSize(renderer: Renderer, w: ^i32, h: ^i32) -> err
    // Drawing kept inside rect (void: everywhere again).
    fun SetRenderClipRect(renderer: Renderer, rect: ^SDL_Rect) -> err
    fun CreateTexture(renderer: Renderer, format: u32, access: i32, w: i32, h: i32) -> Texture, err
    // The pixels of the texture's rect (void: all of it), `pitch` bytes from a row
    // to the next.
    fun UpdateTexture(texture: Texture, rect: ^SDL_Rect, pixels: ^byte, pitch: i32) -> err
    fun RenderTexture(renderer: Renderer, texture: Texture, src: ^SDL_FRect, dst: ^SDL_FRect) -> err
    fun SetTextureBlendMode(texture: Texture, mode: u32) -> err
    // Each texel's color multiplied by this: white texels drawn in it.
    fun SetTextureColorMod(texture: Texture, r: u8, g: u8, b: u8) -> err
    fun SetTextureScaleMode(texture: Texture, mode: i32) -> err
    fun DestroyTexture(texture: Texture)
    // The next event, waiting for it up to ms milliseconds: false when none came.
    fun WaitEventTimeout(event: ^Event, ms: i32) -> bool
    fun SetWindowSize(window: Window, w: i32, h: i32) -> err
    // The display the window is on, and the part of it windows can use
    // (the taskbar's left out).
    fun GetDisplayForWindow(window: Window) -> u32
    fun GetDisplayUsableBounds(display: u32, rect: ^SDL_Rect) -> err
    // The display's mode now: its refresh rate among it.
    fun GetCurrentDisplayMode(display: u32) -> ^Display_Mode, err
    // The modifier keys held now: KMOD_SHIFT, ...
    fun GetModState() -> u16
    // Where the cursor is on the screen (and the buttons held).
    fun GetGlobalMouseState(x: ^f32, y: ^f32) -> u32
    // Where the window's inside is on the screen.
    fun GetWindowPosition(window: Window, x: ^i32, y: ^i32) -> err
    // The window's state, WindowFlags' bits: Minimized, InputFocus, ...
    fun GetWindowFlags(window: Window) -> u64
    // A minimized (or maximized) window back to its size and place.
    fun RestoreWindow(window: Window) -> err
    fun MaximizeWindow(window: Window) -> err
    // The window in front of the others, given the keyboard.
    fun RaiseWindow(window: Window) -> err
    fun CreateSystemCursor(id: i32) -> Cursor, err
    // The mouse cursor's look, over the windows of this program.
    fun SetCursor(cursor: Cursor) -> err
    // Text put on the system's clipboard, for pasting anywhere.
    fun SetClipboardText(text: cstring) -> err
    fun GL_SetAttribute(attr: GLattr, value: i32) -> err
    fun GL_CreateContext(window: Window) -> GLContext, err
    fun GL_MakeCurrent(window: Window, context: GLContext) -> err
    fun GL_DestroyContext(context: GLContext) -> err
    fun GL_SetSwapInterval(interval: i32) -> err
    fun GL_SwapWindow(window: Window) -> err
    fun GetTicks() -> u32
    fun GetTicksNS() -> u64
    fun GetPerformanceCounter() -> u64
    fun GetPerformanceFrequency() -> u64
    fun DelayNS(ns: u64)
    fun DelayPrecise(ns: u64)
    // Memory
    fun malloc(size: usize) -> ^byte
    fun free(mem: ^byte)
    fun IOFromFile(file: cstring, mode: cstring) -> IOStream, err
    // At most `size` bytes read from the stream to ptr: how many came (fewer at
    // its end; 0, failing).
    fun ReadIO(context: IOStream, ptr: ^byte, size: usize) -> usize
    // `size` bytes at ptr written to the stream: how many went.
    fun WriteIO(context: IOStream, ptr: ^byte, size: usize) -> usize
    fun CloseIO(context: IOStream) -> err
    fun SeekIO(context: IOStream, offset: i64, whence: IOWhence) -> i64
    fun TellIO(context: IOStream) -> i64
    fun GetIOSize(context: IOStream) -> i64
    fun FlushIO(context: IOStream) -> err
    fun LoadFile(file: cstring, datasize: ^usize) -> ^byte, err
    // `datasize` bytes at `data` written to the file, made new or over what it held.
    fun SaveFile(file: cstring, data: ^byte, datasize: usize) -> err
    // The directory the program runs from, '/'-ended (SDL's to keep).
    fun GetBasePath() -> ^byte
    // The directory for the program's own files, made if it isn't there (free it).
    fun GetPrefPath(org: cstring, app: cstring) -> ^byte
    // The directory the program runs in (free it).
    fun GetCurrentDirectory() -> ^byte
    fun CreateDirectory(path: cstring) -> err
    fun RemovePath(path: cstring) -> err
    fun RenamePath(oldpath: cstring, newpath: cstring) -> err
    fun CopyFile(oldpath: cstring, newpath: cstring) -> err
    fun GetPathInfo(path: cstring, info: ^PathInfo) -> err
    // Starts or stops some of SDL (Audio, say) apart from Init.
    fun InitSubSystem(flags: Init_Flags) -> err
    fun QuitSubSystem(flags: Init_Flags)
    // A stream onto `device` (AUDIO_DEVICE_DEFAULT_PLAYBACK) taking samples of
    // `spec`, paused. What's played is what's put into it: callback and userdata void.
    fun OpenAudioDeviceStream(device: u32, spec: ^AudioSpec, callback: ^byte, userdata: ^byte) -> AudioStream, err
    // Samples to play after what's queued: `len` bytes at buf (f32s for
    // AudioFormat.F32), its channels' samples one after another.
    fun PutAudioStreamData(stream: AudioStream, buf: ^byte, len: i32) -> err
    // The stream's device playing, or paused.
    fun ResumeAudioStreamDevice(stream: AudioStream) -> err
    fun PauseAudioStreamDevice(stream: AudioStream) -> err
    // How many bytes are queued, not played yet: what to keep ahead of.
    fun GetAudioStreamQueued(stream: AudioStream) -> i32
    // What's queued dropped, unplayed.
    fun ClearAudioStream(stream: AudioStream) -> err
    // What's queued played through, though it doesn't fill a whole chunk: put
    // at the end.
    fun FlushAudioStream(stream: AudioStream) -> err
    // The stream's volume: 1 as it is, 0 silent.
    fun SetAudioStreamGain(stream: AudioStream, gain: f32) -> err
    // The stream closed, and its device with it (one opened for it).
    fun DestroyAudioStream(stream: AudioStream)
}

// gl_load takes a fun([]utf8), and only a foreign fun can take cstring, so this
// one stays a Mara fun.
foreign static_lib "SDL3" {
    fun SDL_GL_GetProcAddress(name: cstring) -> ^byte
}
GL_GetProcAddress :: fun(name: []utf8) -> ^byte { return SDL_GL_GetProcAddress(cstring(name)) }

// What SDL's functions fail with, when they give back false or no handle. SDL's
// reason is in GetError() then, until another SDL call fails, and the err's
// where() names the C function that failed.
SDL_Error :: error { Failed }

// Audio — a stream to play through: opened on a device, given samples
// (PutAudioStreamData), it plays them, converting to the device's format
// on the way. It starts paused: ResumeAudioStreamDevice. The subsystem
// first: InitSubSystem(Audio) (or Init with it).

// The device SDL picks: the system's default output (or input).
AUDIO_DEVICE_DEFAULT_PLAYBACK  :: u32(0xFFFFFFFF)
AUDIO_DEVICE_DEFAULT_RECORDING :: u32(0xFFFFFFFE)

// An audio stream: what's put into it is played (OpenAudioDeviceStream).
AudioStream :: distinct ^byte

// A sample's format (SDL_AudioFormat): its bits, signed or not, a float or
// not, its bytes' order. S16, S32 and F32 are this machine's order (little-
// endian: x86, ARM).
AudioFormat :: union(tag u32) {
    U8    = 0x0008
    S8    = 0x8008
    S16LE = 0x8010
    S16BE = 0x9010
    S32LE = 0x8020
    S32BE = 0x9020
    F32LE = 0x8120
    F32BE = 0x9120
    S16   = 0x8010
    S32   = 0x8020
    F32   = 0x8120
}

// What a stream's samples are: their format, how many channels (2:
// stereo, each frame a left sample and a right), how many frames a second.
AudioSpec :: struct {
    format: AudioFormat
    channels: i32
    freq: i32
}
