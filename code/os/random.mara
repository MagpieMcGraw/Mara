module mara.os

use mara.core

// Random bytes nobody can guess, from the system: for keys, salts and tokens.

// What asking the system for random bytes can fail with.
Random_Error :: error {
    Random_Failed
}

#if #windows {
	// Fills data with random bytes nobody can guess: all its room, so its len
	// becomes its cap. For keys, salts and tokens.
	random_bytes :: fun(data: ^[]byte) -> err {
		data.len = data.cap
		if data.cap == 0 do return
		// (2: BCRYPT_USE_SYSTEM_PREFERRED_RNG. It takes a u32, so a piece at a time.)
		done : i64 = 0
		for done < data.cap {
			piece := data.cap - done
			if piece > 1 << 30 do piece = 1 << 30
			if BCryptGenRandom(void, &data[done], u32(piece), 2) != 0 {
				data.len = 0
				return Random_Failed
			}
			done += piece
		}
	}

	foreign static_lib "bcrypt" {
		fun BCryptGenRandom(algorithm: ^byte, into: ^byte, size: u32, flags: u32) -> i32
	}
}

#if #linux {
	// Fills data with random bytes nobody can guess: all its room, so its len
	// becomes its cap. For keys, salts and tokens.
	random_bytes :: fun(data: ^[]byte) -> err {
		data.len = data.cap
		if data.cap == 0 do return
		// (A long ask can come back part done, or cut short by a signal.)
		done : i64 = 0
		for done < data.cap {
			n := getrandom(&data[done], usize(data.cap - done), 0)
			if n < 0 {
				if __errno_location()^ == EINTR do continue
				data.len = 0
				return Random_Failed
			}
			done += n
		}
	}

	foreign static_lib "c" {
		fun getrandom(into: ^byte, size: usize, flags: u32) -> i64
	}
}
