module mara.os

use mara.core
use mara.string

// Paths and directories: a path's parts, where the program is, what's in a directory.

// A path, as current_dir and exe_path give one back: up to 512
// characters (Windows' paths here end at 260), its room past them there to
// add a name to. Its separators are '/', Windows' too. Under 1 KB: it lives
// where it's declared, no arena needed.
Path :: alias [512]utf8

// A file or a directory found in a directory (dir_read): its name — not
// its path — whether it leads to a directory, and whether it's a link: a
// symbolic link (on Windows a junction too), its `dir` saying where it
// leads — true for a link to a directory, false for one to a file or to
// nothing there. A walk down a tree goes into the entries that are `dir and
// not link`: a link can lead back up, round and round, or to a tree walked
// already.
Dir_Entry :: struct {
    name: [260]utf8
    dir:  bool   // a directory, or a link to one
    link: bool   // a symbolic link, or a Windows junction
}

// Returns the file's name at the end of a path: the part after its last
// separator. A path with no separator is returned whole; one ending in a
// separator gives an empty slice. The result is a slice of the path, not a
// copy.
get_file :: fun(path: []utf8) -> []utf8 {
	start : i64 = 0
	for i in 0:path.len {
		if path_separator(path[i]) do start = i + 1
	}
	return path[start : path.len]
}

// Whether ch separates a path's parts: '/' — and on Windows '\' too
// (elsewhere a '\' can be part of a name).
path_separator :: fun(ch: utf8) -> bool {
	if ch == '/' do return true
	#if #windows {
		if ch == '\\' do return true
	}
	return false
}

// Returns the directory a path is in, as a Path of its own: the path up to
// and including its last separator ('\'s made '/' on Windows), so a file's
// name can go after it: `dir := get_dir(exe)`, `&dir + "font.ttf"`. A name
// alone gives an empty Path. A directory longer than a Path holds stops the
// program.
get_dir :: fun(path: []utf8) -> Path {
	end : i64 = 0
	for ch, i in path {
		if path_separator(ch) do end = i + 1
	}
	dir : Path
	&dir + path[0 : end]
	#if #windows {
		slashes_forward(&dir)
	}
	return dir
}

// A path's '\'s made '/': the paths this module gives back say '/' on every
// system, Windows' too (it takes either). Only on Windows: elsewhere a '\'
// can be part of a name.
slashes_forward :: fun(path: ^[]utf8) {
	for k in 0:path.len {
		if path[k] == '\\' do path[k] = '/'
	}
}

// The path without the separators at its end.
trim_separators :: fun(path: []utf8) -> []utf8 {
	n := path.len
	for n > 0 {
		if not path_separator(path[n - 1]) do break
		n -= 1
	}
	return path[0 : n]
}

// A path for C: copied, a 0 after it — so the functions here take any slice
// of a path, a view into storage too (its room ends where the path does: no
// 0 can follow). Empty when it's too long for the copy: the call then fails
// as for a path that isn't there.
c_path :: fun(path: []utf8) -> [512]utf8 {
	c : [512]utf8
	if path.len < c.cap do &c + path
	return c
}

// Whether two paths name the same place: separators at their ends not
// minded; on Windows '/' and '\' alike, and letters' case not minded (as its
// file system doesn't). Text only: neither path is looked up.
same_path :: fun(a: []utf8, b: []utf8) -> bool {
	x := trim_separators(a)
	y := trim_separators(b)
	if x.len != y.len do return false
	for i in 0:x.len {
		cx := x[i]
		cy := y[i]
		#if #windows {
			if cx == '/' do cx = '\\'
			if cy == '/' do cy = '\\'
			cx = lower(cx)
			cy = lower(cy)
		}
		if cx != cy do return false
	}
	return true
}

// Makes the directory at path, and any directories leading to it that aren't
// there yet. One that's there already is fine. Open_Failed when it can't be made:
// a file has that name, say, or the system won't allow it.
dir_make :: fun(path: []utf8) -> err {
	// (Each leading directory tried. One that fails, a drive's `C:` say, isn't
	// the failure yet: the last one says.)
	for k in 1:path.len {
		if path_separator(path[k]) do _ = dir_make_one(path[0:k])
	}
	if not dir_make_one(path) do return Open_Failed
}

#if #windows {
	// The directory the program runs in — where a path not whole starts —
	// as the system has it (real_path's: its letters' case as on disk, links
	// and junctions followed, a mapped drive's folder its server's), however
	// it was entered; whole (no separator at its end but a drive's root,
	// `C:/`), its separators '/', a 0 after it: a Path, its room past the
	// path there to add to (`&cwd + "/code"`). Too_Large when it's longer
	// than a Path holds; Open_Failed when it's gone (deleted while the
	// program ran in it); Read_Failed when the system won't say.
	// (exe_path: the program's own file, wherever it runs.)
	current_dir :: fun() -> Path, err {
		dir := real_path(".")?
		if dir.len == dir.cap do return dir, Too_Large   // (no room for its 0)
		dir[dir.len] = 0
		return dir
	}

	// Makes `path` the directory the program runs in: a path not whole starts
	// there from now on. Open_Failed when it can't go there: no such directory,
	// say.
	set_current_dir :: fun(path: []utf8) -> err {
		c := c_path(path)
		if SetCurrentDirectoryA(cstring(c)) == 0 do return Open_Failed
	}

	// One directory made, the one before it there already. Whether a directory
	// is there now.
	dir_make_one :: fun(path: []utf8) -> bool {
		c := c_path(path)
		if bool(CreateDirectoryA(cstring(c), void)) do return true
		kind := GetFileAttributesA(cstring(c))
		return kind != 0xFFFFFFFF and kind & 0x10 != 0   // (INVALID_FILE_ATTRIBUTES; FILE_ATTRIBUTE_DIRECTORY)
	}

	// Deletes the directory at path, which must be empty: Delete_Failed if not.
	dir_delete :: fun(path: []utf8) -> err {
		c := c_path(path)
		if not bool(RemoveDirectoryA(cstring(c))) do return Delete_Failed
	}

	// A path as the system has it, whole — a file's or a folder's: its
	// letters' case as on disk, its links (symlinks, junctions) followed to
	// where they lead, a mapped drive's folder its server's
	// (`//server/share/…`), `.` and `..` gone, its separators '/'. Two
	// spellings of one place give one path: a path from the command line or
	// a file made so, it compares with current_dir's and exe_path's
	// (real already) and the paths built on them as they are. Open_Failed
	// when nothing's there; Too_Large when it's longer than a Path holds;
	// Read_Failed when the system won't say.
	real_path :: fun(path: []utf8) -> Path, err {
		out : Path
		c := c_path(path)
		id := CreateFileA(cstring(c), 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, void, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NO_FILE)
		if id == INVALID_HANDLE_VALUE do return out, Open_Failed
		defer file_close(id)
		// (Its whole name, `\\?\C:\…` or `\\?\UNC\server\…`: its length, or
		// the room it wants, its 0 counted, when that's more than full has.)
		full : [600]utf8
		n := i64(GetFinalPathNameByHandleA(id, &full[0], u32(full.cap), 0))
		if n == 0 do return out, Read_Failed
		if n >= full.cap do return out, Too_Large
		full.len = n
		name : []utf8 = full
		unc := false
		if starts_with(name, "\\\\?\\UNC\\") {
			name = name[8 : name.len]
			unc = true
		elif starts_with(name, "\\\\?\\")
			name = name[4 : name.len]
		}
		room := name.len
		if unc do room += 2
		if room > out.cap do return out, Too_Large
		if unc do &out + "\\\\"
		&out + name
		slashes_forward(&out)
		return out
	}

	// The running program's own file: its path, whole, as the system has it
	// (real_path's: its letters' case as on disk, a link followed to the
	// file itself) — however it was started (by a name its PATH found, a
	// relative path, a link), unlike main's args[0], which is what its
	// starter wrote — for the files that come with it, beside it: a Path, to
	// cut to its directory and add a file's name to (`exe.len =
	// get_dir(exe).len`, `&exe + "font.ttf"`). Too_Large when it's longer
	// than a Path holds; Read_Failed when the system won't say.
	// (GetModuleFileNameA: in the system's code page, as the other files'
	// functions here take paths; the folders spelled as the program was
	// started — so real_path asked too.)
	exe_path :: fun() -> Path, err {
		path : Path
		n := i64(GetModuleFileNameA(void, &path[0], u32(path.cap)))
		if n == 0 do return path, Read_Failed
		// (As long as the room, it was cut off: no room for its 0.)
		if n >= path.cap do return path, Too_Large
		path.len = n
		return real_path(path)
	}

	// The files and directories in a directory, to look through what's there:
	// each one's name, whether it leads to a directory, and whether it's a
	// link (Dir_Entry) — not "." or "..", in no order to count on — into
	// storage after what's there, side by side, its len moved past them, and
	// given back, a view of them. Fails with Open_Failed when there's no
	// directory there, Too_Large when they don't fit in storage's room
	// (storage untouched). The path is copied: any slice of one will do
	// (cstring's 0 needn't follow it). (Counted first, then each written:
	// listed twice.)
	dir_read :: fun(path: []utf8, storage: ^[]byte) -> []Dir_Entry, err {
		start := storage.len
		none := slice([:0]Dir_Entry, storage)
		storage.len = start
		if path.len > 500 do return none, Open_Failed   // (its pattern on the stack, under 1 KB)
		pattern : [512]utf8
		&pattern + path
		&pattern + "\\*"
		found : WIN32_FIND_DATAA
		search := FindFirstFileA(cstring(pattern), &found)
		if search == INVALID_HANDLE_VALUE do return none, Open_Failed
		count : i64 = 0
		for true {
			name := read_cstring(260, &found.name[0])
			if name != "." and name != ".." do count += 1
			if not bool(FindNextFileA(search, &found)) do break
		}
		_ = FindClose(search)
		// (Room for them, past what aligning them may skip.)
		if storage.cap - start < count * size_of(Dir_Entry) + 8 do return none, Too_Large
		entries := slice([:count]Dir_Entry, storage)
		search = FindFirstFileA(cstring(pattern), &found)
		if search == INVALID_HANDLE_VALUE do return entries[0 : 0], Open_Failed
		k : i64 = 0
		for k < count {
			name := read_cstring(260, &found.name[0])
			if name != "." and name != ".." {
				entry : Dir_Entry
				&entry.name + name
				entry.dir = (found.attributes & FILE_ATTRIBUTE_DIRECTORY) != 0
				entry.link = false
				// (A link: a reparse point tagged a symbolic link or a
				// junction — OneDrive's placeholders are reparse points too.
				// Its own directory bit says what it was made as: asked
				// where it leads.)
				tag := found.reserved0
				if (found.attributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0 and (tag == IO_REPARSE_TAG_SYMLINK or tag == IO_REPARSE_TAG_MOUNT_POINT) {
					entry.link = true
					entry.dir = link_leads_to_dir(path, name)
				}
				&entries + entry
				k += 1
			}
			if not bool(FindNextFileA(search, &found)) do break
		}
		_ = FindClose(search)
		return entries   // (fewer when it lost some since it counted)
	}

	FILE_ATTRIBUTE_DIRECTORY     :: 0x10
	FILE_ATTRIBUTE_REPARSE_POINT :: 0x400
	IO_REPARSE_TAG_SYMLINK       :: 0xA000000C
	IO_REPARSE_TAG_MOUNT_POINT   :: 0xA0000003   // (a junction)

	// Whether a link in a directory leads to a directory that's there.
	// Opened, it's followed — asked for nothing, nothing read.
	link_leads_to_dir :: fun(path: []utf8, name: []utf8) -> bool {
		full : [800]utf8
		&full + path
		&full + "\\"
		&full + name
		id := CreateFileA(cstring(full), 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, void, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NO_FILE)
		if id == INVALID_HANDLE_VALUE do return false
		info : BY_HANDLE_FILE_INFORMATION
		got := bool(GetFileInformationByHandle(id, &info))
		file_close(id)
		return got and (info.attributes & FILE_ATTRIBUTE_DIRECTORY) != 0
	}

	// WIN32_FIND_DATAA's layout: DWORDs and FILETIMEs (DWORD pairs, so no
	// padding), then the name, MAX_PATH bytes, and the short 8.3 name's 14.
	WIN32_FIND_DATAA :: struct {
		attributes:       u32
		creation_low:     u32
		creation_high:    u32
		last_access_low:  u32
		last_access_high: u32
		last_write_low:   u32
		last_write_high:  u32
		size_high:        u32
		size_low:         u32
		reserved0:        u32
		reserved1:        u32
		name:             [260!]byte
		short_name:       [14!]byte
	}

	foreign static_lib "kernel32" {
		// The directory the program runs in, changed: 0 failing.
		fun SetCurrentDirectoryA(path: cstring) -> i32
		fun CreateDirectoryA(path: cstring, attributes: ^byte) -> i32
		fun RemoveDirectoryA(path: cstring) -> i32
		fun GetFileAttributesA(path: cstring) -> u32
		// A directory's entries: the first, and each next (false: no more).
		fun FindFirstFileA(pattern: cstring, found: ^WIN32_FIND_DATAA) -> File_Id
		fun FindNextFileA(search: File_Id, found: ^WIN32_FIND_DATAA) -> i32
		fun FindClose(search: File_Id) -> i32
		// A loaded library's file — void: the program's own — its path into name.
		fun GetModuleFileNameA(library: ^byte, name: ^utf8, size: u32) -> u32
		// The directory the program runs in, into buf: its length; the room it
		// wants (its 0 counted) when buf is too small; 0 failing.
		// An open file's or folder's whole path as the system has it, into buf
		// (flags 0: its letters' case as on disk, `\\?\C:\…`): its length; the
		// room it wants (its 0 counted) when buf is too small; 0 failing.
		fun GetFinalPathNameByHandleA(file: File_Id, buf: ^utf8, size: u32, flags: u32) -> u32
		fun GetFileInformationByHandle(file: File_Id, info: ^BY_HANDLE_FILE_INFORMATION) -> i32
	}
}

#if #linux {
	// The directory the program runs in — where a path not whole starts —
	// as the system has it (real_path's: links followed — getcwd gives none),
	// however it was entered; whole (no separator at its end but the root,
	// `/`): a Path, its room past the path there to add to (`&cwd +
	// "/code"`). Too_Large when it's longer than a Path holds; Open_Failed
	// when it's gone (deleted while the program ran in it); Read_Failed when
	// the system won't say. (exe_path: the program's own file, wherever it runs.)
	current_dir :: fun() -> Path, err {
		dir : Path
		if getcwd(&dir[0], usize(dir.cap)) == void {
			e := __errno_location()^
			if e == ERANGE do return dir, Too_Large
			if e == ENOENT do return dir, Open_Failed
			return dir, Read_Failed
		}
		n : i64 = 0
		for n < dir.cap and dir[n] != 0 {
			n += 1
		}
		dir.len = n
		return dir
	}

	// Makes `path` the directory the program runs in: a path not whole starts
	// there from now on. Open_Failed when it can't go there: no such directory,
	// say.
	set_current_dir :: fun(path: []utf8) -> err {
		c := c_path(path)
		if chdir(cstring(c)) != 0 do return Open_Failed
	}

	// One directory made, the one before it there already. Whether a directory
	// is there now.
	dir_make_one :: fun(path: []utf8) -> bool {
		c := c_path(path)
		if mkdir(cstring(c), 511) == 0 do return true   // (511: 0o777, less the umask)
		st : Stat
		return stat(cstring(c), &st) == 0 and (st.mode & S_IFMT) == S_IFDIR
	}

	// Deletes the directory at path, which must be empty: Delete_Failed if not.
	dir_delete :: fun(path: []utf8) -> err {
		c := c_path(path)
		if rmdir(cstring(c)) != 0 do return Delete_Failed
	}

	// A path as the system has it, whole — a file's or a folder's: its links
	// followed to where they lead, `.` and `..` gone. Two spellings of one
	// place give one path: the folders a gather starts at made so
	// (`real_path(cwd)`), the paths built on them compare as they are.
	// Open_Failed when nothing's there; Too_Large when it's longer than a
	// Path holds. (realpath's own room, given back: none here past 1 KB.)
	real_path :: fun(path: []utf8) -> Path, err {
		out : Path
		c := c_path(path)
		full := realpath(cstring(c), void)
		if full == void do return out, Open_Failed
		name := read_cstring(4096, full)
		if name.len > out.cap {
			free(full)
			return out, Too_Large
		}
		&out + name
		free(full)
		return out
	}

	// The running program's own file: its path, whole, as the system has it
	// (real_path's: a link followed to the file itself) — however it was
	// started (by a name its PATH found, a relative path, a link), unlike
	// main's args[0], which is what its starter wrote — for the files
	// that come with it, beside it: a Path, to cut to its directory and add
	// a file's name to (`exe.len = get_dir(exe).len`, `&exe + "font.ttf"`).
	// Too_Large when it's longer than a Path holds; Read_Failed when the
	// system won't say. (/proc/self/exe: a link to the program's file, the
	// kernel's own path for it.)
	exe_path :: fun() -> Path, err {
		path : Path
		link := "/proc/self/exe"
		n := readlink(cstring(link), &path[0], usize(path.cap))
		if n < 0 do return path, Read_Failed
		// (As long as the room, it may be cut off.)
		if n >= path.cap do return path, Too_Large
		path.len = n
		return path
	}

	// The files and directories in a directory, to look through what's there:
	// each one's name, whether it leads to a directory, and whether it's a
	// link (Dir_Entry) — not "." or "..", in no order to count on — into
	// storage after what's there, side by side, its len moved past them, and
	// given back, a view of them. Fails with Open_Failed when there's no
	// directory there, Too_Large when they don't fit in storage's room
	// (storage untouched). The path is copied: any slice of one will do
	// (cstring's 0 needn't follow it). (Counted first, then each written:
	// listed twice.)
	dir_read :: fun(path: []utf8, storage: ^[]byte) -> []Dir_Entry, err {
		start := storage.len
		none := slice([:0]Dir_Entry, storage)
		storage.len = start
		// (A copy of the path, a 0 after it: any slice of a path will do, as
		// on Windows, where its search pattern is built.)
		if path.len > 500 do return none, Open_Failed   // (the copy on the stack, under 1 KB)
		opened : [512]utf8
		&opened + path
		dir := opendir(cstring(opened))
		if dir == void do return none, Open_Failed
		count : i64 = 0
		for true {
			d := readdir(dir)
			if d == void do break
			name := read_cstring(256, &d.name[0])
			if name != "." and name != ".." do count += 1
		}
		_ = closedir(dir)
		// (Room for them, past what aligning them may skip.)
		if storage.cap - start < count * size_of(Dir_Entry) + 8 do return none, Too_Large
		entries := slice([:count]Dir_Entry, storage)
		dir = opendir(cstring(opened))
		if dir == void do return entries[0 : 0], Open_Failed
		k : i64 = 0
		for k < count {
			d := readdir(dir)
			if d == void do break
			name := read_cstring(256, &d.name[0])
			if name == "." or name == ".." do continue
			entry : Dir_Entry
			&entry.name + name
			entry.dir = d.kind == DT_DIR
			entry.link = false
			if d.kind == DT_LNK or d.kind == DT_UNKNOWN {
				entry.link, entry.dir = dir_entry_kind(path, name)
			}
			&entries + entry
			k += 1
		}
		_ = closedir(dir)
		return entries   // (fewer when it lost some since it counted)
	}

	// A directory's entry, asked of the system — not opened (a named pipe
	// opened waits for a writer): whether it's a link (lstat), and whether
	// it leads to a directory that's there (stat, through a link). For a
	// link readdir names (DT_LNK), and for a file system whose readdir
	// doesn't say what an entry is (DT_UNKNOWN).
	dir_entry_kind :: fun(path: []utf8, name: []utf8) -> bool, bool {
		if path.len + name.len > 500 do return false, false   // (on the stack, under 1 KB)
		full : [512]utf8
		&full + path
		&full + "/"
		&full + name
		st : Stat
		link := lstat(cstring(full), &st) == 0 and (st.mode & S_IFMT) == S_IFLNK
		dir := stat(cstring(full), &st) == 0 and (st.mode & S_IFMT) == S_IFDIR
		return link, dir
	}

	// struct dirent (glibc, x86_64): what readdir returns, one entry.
	Dirent :: struct {
		ino:    u64
		offset: i64
		size:   u16              // this record's
		kind:   u8               // DT_DIR, DT_REG, ...; DT_UNKNOWN: not said
		name:   [256!]byte
	}

	DT_UNKNOWN :: u8(0)
	DT_DIR     :: u8(4)
	DT_LNK     :: u8(10)
	S_IFMT     :: u32(0xF000)   // st_mode's file kind bits
	S_IFDIR    :: u32(0x4000)   // a directory
	S_IFLNK    :: u32(0xA000)   // a symbolic link
	ENOENT     :: 2
	ERANGE     :: 34

	foreign static_lib "c" {
		fun stat(path: cstring, out: ^Stat) -> i32    // (through a link to where it leads)
		fun lstat(path: cstring, out: ^Stat) -> i32   // (a link itself)
		// A directory's entries: opened, each next (void: no more), closed.
		fun opendir(path: cstring) -> ^byte
		fun readdir(dir: ^byte) -> ^Dirent
		fun closedir(dir: ^byte) -> i32
		// Where a link points: its path, not 0-ended, into buf; its length, -1 failing.
		fun readlink(path: cstring, buf: ^utf8, size: usize) -> i64
		// The directory the program runs in, 0-ended, into buf: buf; void failing
		// (too long for buf among the ways).
		fun getcwd(buf: ^utf8, size: usize) -> ^utf8
		fun chdir(path: cstring) -> i32
		fun mkdir(path: cstring, mode: u32) -> i32
		fun rmdir(path: cstring) -> i32
		// A path whole, links followed, 0-ended: in room it makes (resolved
		// void) — free it — or void failing.
		fun realpath(path: cstring, resolved: ^byte) -> ^byte
		fun free(p: ^byte)
	}
}
