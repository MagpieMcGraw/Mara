module mara.os

use mara.core
use mara.string

// The clock and waiting. (Frame timers, and the rest of time, are mara.time's.)

#if #windows {
	CREATE_WAITABLE_TIMER_HIGH_RESOLUTION :: 0x00000002
	SYNCHRONIZE          :: 0x00100000
	TIMER_MODIFY_STATE   :: 0x00000002

	// Now, on a clock that only goes forward: nanoseconds since some point —
	// the system's start, not a date. How long something took: the
	// difference of two.
	clock_ns :: fun() -> i64 {
		count : i64 = 0
		per_second : i64 = 0
		_ = QueryPerformanceCounter(&count)
		_ = QueryPerformanceFrequency(&per_second)   // (fixed while the system runs)
		// (Whole seconds, then the rest: count·10^9 at once would overflow.)
		return count / per_second * 1000000000 + count % per_second * 1000000000 / per_second
	}

	// Waits: the program does nothing for `ns` nanoseconds — at least, and
	// a little more, as the system wakes it: a fraction of a millisecond (a
	// high-resolution timer; Sleep's waits round up to the system's tick,
	// 15.6 ms). Before Windows 10's 1803 there's none: whole milliseconds.
	sleep_ns :: fun(ns: i64) {
		if ns <= 0 do return
		timer := CreateWaitableTimerExW(void, void, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, SYNCHRONIZE | TIMER_MODIFY_STATE)
		if timer == NO_FILE {
			Sleep(u32((ns + 999999) / 1000000))
			return
		}
		due : i64 = -((ns + 99) / 100)   // (from now: negative, in 100 ns)
		if bool(SetWaitableTimer(timer, &due, 0, void, void, 0)) do _ = WaitForSingleObject(timer, INFINITE)
		_ = CloseHandle(timer)
	}

	// Waits: the program does nothing for `ms` milliseconds (at least).
	sleep_ms :: fun(ms: u32) {
		sleep_ns(i64(ms) * 1000000)
	}

	foreign static_lib "kernel32" {
		fun Sleep(ms: u32)
		// Clocks and timers
		fun QueryPerformanceCounter(count: ^i64) -> i32
		fun QueryPerformanceFrequency(per_second: ^i64) -> i32
		fun CreateWaitableTimerExW(attributes: ^byte, name: ^byte, flags: u32, access: u32) -> File_Id
		fun SetWaitableTimer(timer: File_Id, due: ^i64, period: i32, routine: ^byte, argument: ^byte, resume: i32) -> i32
	}
}

#if #linux {
	// Now, on a clock that only goes forward: nanoseconds since some point —
	// the system's start, not a date. How long something took: the
	// difference of two.
	clock_ns :: fun() -> i64 {
		now := Timespec{seconds = 0, nanoseconds = 0}
		_ = clock_gettime(CLOCK_MONOTONIC, &now)
		return now.seconds * 1000000000 + now.nanoseconds
	}

	// Waits: the program does nothing for `ns` nanoseconds — at least, and
	// a little more, as the system wakes it.
	sleep_ns :: fun(ns: i64) {
		if ns <= 0 do return
		want := Timespec{seconds = ns / 1000000000, nanoseconds = ns % 1000000000}
		left := Timespec{seconds = 0, nanoseconds = 0}
		for nanosleep(&want, &left) != 0 {
			if __errno_location()^ != EINTR do return
			want = left   // (a signal cut it short: the rest)
		}
	}

	// Waits: the program does nothing for `ms` milliseconds (at least).
	sleep_ms :: fun(ms: u32) {
		sleep_ns(i64(ms) * 1000000)
	}

	// clock_gettime's and nanosleep's time.
	Timespec :: struct {
		seconds:     i64
		nanoseconds: i64
	}
	CLOCK_MONOTONIC  :: 1   // (clock_gettime: a clock that only goes forward)

	foreign static_lib "c" {
		fun nanosleep(want: ^Timespec, left: ^Timespec) -> i32
		fun clock_gettime(clock: i32, now: ^Timespec) -> i32
	}
}
