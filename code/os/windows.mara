module mara.os

use mara.core
use mara.string

// mara.os on Windows (os.mara says what's shared).
//
// Win32 platform layer — file I/O, virtual memory, dynamic library loading.
// All foreign calls go directly to kernel32.dll (statically linked at build
// time); no C glue file needed.
//
// Type notes:
//   Win32 HANDLE is a pointer-sized opaque token. The kernel uses it as
//   an index into a per-process handle table; user mode never derefs it.
//   We expose file handles as `File_Id :: distinct i64` and bind the
//   relevant kernel32 entry points with i64 in the HANDLE slots — same
//   bits at the ABI level (both pointer and i64 return in RAX on x64),
//   no ptr↔int conversion needed in user-facing code. INVALID_HANDLE_VALUE
//   ((HANDLE)-1 in C) becomes plain `-1` here.
//
//   Module handles (HMODULE from LoadLibraryA) and function-pointer
//   results from GetProcAddress stay as `^byte` for now — they're truly
//   pointer-typed and the call sites cast them at use. Could become
//   Module_Id / Symbol_Addr distinct types later if it'd help.
// Static-linked: clang resolves the symbols against kernel32.lib at link
// time. No dynamic_lib needed — kernel32.dll is implicitly loaded into every
// Win32 process at startup. BOOL is i32 (Win32 zero/non-zero), not Mara bool.

#if #windows {

	// ---- Files ----

	// ---------------------------------------------------------------------------
	// CreateFileA flag constants
	// ---------------------------------------------------------------------------

	// dwDesiredAccess
	GENERIC_READ  :: 0x80000000
	GENERIC_WRITE :: 0x40000000

	// dwShareMode
	FILE_SHARE_READ  :: 0x00000001
	FILE_SHARE_WRITE :: 0x00000002

	// dwCreationDisposition
	CREATE_NEW        :: 1   // fail if file exists
	CREATE_ALWAYS     :: 2   // truncate or create
	OPEN_EXISTING     :: 3   // fail if file does not exist
	OPEN_ALWAYS       :: 4   // open or create
	TRUNCATE_EXISTING :: 5   // open and truncate; fail if missing

	// dwFlagsAndAttributes
	FILE_ATTRIBUTE_NORMAL :: 0x80

	// (A folder opened too: a handle to it, nothing read — real_path.)
	FILE_FLAG_BACKUP_SEMANTICS :: 0x02000000

	// dwShareMode, a file others may delete while it's open
	FILE_SHARE_DELETE :: 0x00000004

	// MapViewOfFile's access: a view to read.
	FILE_MAP_READ :: 0x0004

	// ---------------------------------------------------------------------------
	// File I/O
	// ---------------------------------------------------------------------------

	// An open file, as file_open_read or file_open_write hands it back.
	// Pointer-sized opaque token. Win32 HANDLE is `void *` — fits in i64 on
	// x64 (and Win32 on x86 isn't a target we'd compile for in 2026).
	File_Id :: distinct i64

	// Win32 sentinel for "no valid handle" — what CreateFileA returns on
	// failure ((HANDLE)-1 in C). Typed as File_Id so equality against the
	// CreateFileA result doesn't need an explicit unwrap.
	INVALID_HANDLE_VALUE :: File_Id(-1)

	// "No template file" sentinel for CreateFileA's hTemplateFile slot.
	NO_FILE :: File_Id(0)

	// Open a file for reading. Returns (id, .Ok) on success; on failure
	// the File_Id is NO_FILE — safe to feed to `defer file_close`.
	// The path is copied for Windows (c_path): any slice of one will do. So
	// for every path this module takes.
	file_open_read :: fun(path: []utf8) -> File_Id, err {
		c := c_path(path)
		id := CreateFileA(cstring(c), GENERIC_READ, FILE_SHARE_READ, void, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NO_FILE)
		if id == INVALID_HANDLE_VALUE do return NO_FILE, Open_Failed
		return id
	}

	// Open a file for writing, creating it if missing and truncating if present.
	file_open_write :: fun(path: []utf8) -> File_Id, err {
		c := c_path(path)
		id := CreateFileA(cstring(c), GENERIC_WRITE, 0, void, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NO_FILE)
		if id == INVALID_HANDLE_VALUE do return NO_FILE, Open_Failed
		return id
	}

	// Open a file to add to its end, creating it if missing: each write goes
	// after what the file has then. Others can read it while it's open (a log).
	// (0x4: FILE_APPEND_DATA, writes only at the end. Written as a number,
	// not a constant here: a program may name its own so.)
	file_open_append :: fun(path: []utf8) -> File_Id, err {
		c := c_path(path)
		id := CreateFileA(cstring(c), 0x4, FILE_SHARE_READ, void, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NO_FILE)
		if id == INVALID_HANDLE_VALUE do return NO_FILE, Open_Failed
		return id
	}

	// Closes the file. NO_FILE is ignored, so `defer file_close(id)` right
	// after an open is safe even when the open failed.
	file_close :: fun(id: File_Id) {
		if id == NO_FILE do return
		_ = CloseHandle(id)
	}

	// The file's size in bytes.
	file_size :: fun(id: File_Id) -> i64, err {
		size: i64 = 0
		if not bool(GetFileSizeEx(id, &size)) do return 0, Size_Failed
		return size
	}

	// Reads the next piece of a file, a pipe or a program's output into data:
	// one read, up to data's capacity — less when less has come, or when the
	// system reads less at a time. data.len becomes the number of bytes read
	// (0 at the end of the file, or of a pipe whose writer closed — or with
	// no room to read into). For all of a file, read_entire_file.
	file_read :: fun(id: File_Id, data: ^[]byte) -> err {
		if data.cap == 0 {
			data.len = 0
			return
		}
		read: u32 = 0
		// (ReadFile counts in a u32: at most 1 GB a call, so a room of 4 GB
		// or more doesn't wrap to a small count — 4 GB to none.)
		want := data.cap
		if want > 1 << 30 do want = 1 << 30
		data.len = want   // (ReadFile's to fill: read is 0 when it fails)
		ok := bool(ReadFile(id, &data[0], u32(want), &read, void))
		data.len = i64(read)
		// (A pipe whose writer closed: its end, as a file's is — 0 bytes.)
		if not ok and GetLastError() != ERROR_BROKEN_PIPE do return Read_Failed
	}

	// Write data to the file. Returns (n, .Ok) where n is bytes written. Win32
	// may write fewer bytes than requested under disk-full / pipe conditions;
	// compare n against data.len for partial-write detection. data is only
	// read: a list, a slice, any view of bytes.
	file_write :: fun(id: File_Id, data: []byte) -> i64, err {
		if data.len == 0 do return 0   // (nothing to write: written)
		written: u32 = 0
		if not bool(WriteFile(id, data.ptr, u32(data.len), &written, void)) do return 0, Write_Failed
		return i64(written)
	}

	// Move the file pointer to `offset` relative to `whence` (SEEK_SET / SEEK_CUR
	// / SEEK_END) and return the resulting absolute position. Win32
	// SetFilePointerEx — the seek the cache's per-frame streaming will want.
	file_seek :: fun(id: File_Id, offset: i64, whence: u32) -> i64, err {
		new_pos: i64 = 0
		if not bool(SetFilePointerEx(id, offset, &new_pos, whence)) do return 0, Seek_Failed
		return new_pos
	}

	// Deletes the file at path.
	file_delete :: fun(path: []utf8) -> err {
		c := c_path(path)
		if not bool(DeleteFileA(cstring(c))) do return Delete_Failed
	}

	// Moves the file at `from` to `to`, as one step: whoever reads `to` finds
	// the old file or the new one, never part of one. A file at `to` is replaced.
	// Both must be on one drive, or it's Rename_Failed.
	file_rename :: fun(from: []utf8, to: []utf8) -> err {
		a := c_path(from)
		b := c_path(to)
		if not bool(MoveFileExA(cstring(a), cstring(b), 1)) do return Rename_Failed   // (1: MOVEFILE_REPLACE_EXISTING)
	}

	// Copy `src` to `dst`. Overwrites `dst` if it exists. Used by hot-reload
	// loops to copy a freshly-built DLL into a uniquely-named file the host
	// can LoadLibraryA — the original on disk stays unlocked so the build can
	// overwrite it for the next reload.
	copy_file :: fun(src: []utf8, dst: []utf8) -> err {
		from := c_path(src)
		to := c_path(dst)
		if not bool(CopyFileA(cstring(from), cstring(to), 0)) do return Copy_Failed
	}

	// Last-write time of a file, as Windows' 100-nanosecond FILETIME packed
	// into i64 (low DWORD in lo 32 bits, high DWORD in hi 32 bits). Returns 0
	// if the query fails — caller comparing against a previous value will
	// see a "change" and react safely. Used to poll for DLL rebuild events
	// without a directory watcher.
	file_mtime :: fun(path: []utf8) -> i64 {
		data : WIN32_FILE_ATTRIBUTE_DATA
		c := c_path(path)
		if not bool(GetFileAttributesExA(cstring(c), 0, &data)) do return 0
		lo : i64 = i64(data.last_write_low)
		hi : i64 = i64(data.last_write_high) << 32
		return lo | hi
	}

	// The file's bytes, mapped into memory: read where they lie, nothing
	// copied. The system reads each page from the file the first time it's
	// touched, so a big file costs only what's read of it. Read only. An empty
	// file gives an empty slice. Give the slice back to file_unmap when done,
	// the whole of it, not a piece.
	file_map :: fun(path: []utf8) -> []byte, err {
		id := file_open_read(path)?
		defer file_close(id)
		size := file_size(id)?
		if size == 0 do return []   // (Windows maps no empty file)
		// (The view keeps the file and the mapping open: both closed here.)
		mapping := CreateFileMappingA(id, void, PAGE_READONLY, 0, 0, void)
		if mapping == NO_FILE do return [], Map_Failed
		defer file_close(mapping)
		view := MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, usize(0))
		if view == void do return [], Map_Failed
		return slice_from_ptr(view, size)
	}

	// Unmaps a file file_map mapped. An empty slice is ignored.
	file_unmap :: fun(data: []byte) {
		if data.len == 0 do return
		_ = UnmapViewOfFile(data.ptr)
	}

	// Memory layout matches WIN32_FILE_ATTRIBUTE_DATA exactly: DWORD attributes
	// followed by three FILETIMEs (each a pair of DWORDs) followed by file
	// size's two DWORDs. Declared as nine consecutive u32s so the natural-
	// alignment doesn't insert padding between the DWORD and FILETIME slots.
	WIN32_FILE_ATTRIBUTE_DATA :: struct {
		attributes:         u32
		creation_low:       u32
		creation_high:      u32
		last_access_low:    u32
		last_access_high:   u32
		last_write_low:     u32
		last_write_high:    u32
		size_high:          u32
		size_low:           u32
	}

	// What GetFileInformationByHandle says of a file: DWORDs and FILETIMEs
	// (DWORD pairs).
	BY_HANDLE_FILE_INFORMATION :: struct {
		attributes:       u32
		creation_low:     u32
		creation_high:    u32
		last_access_low:  u32
		last_access_high: u32
		last_write_low:   u32
		last_write_high:  u32
		volume_serial:    u32
		size_high:        u32
		size_low:         u32
		links:            u32
		index_high:       u32
		index_low:        u32
	}

	foreign static_lib "kernel32" {
		// HANDLE-typed slots are bound as File_Id directly — same bits at the
		// ABI level (distinct lowers to its base i64 in IR), but the type
		// checker keeps stray i64s and other handle kinds out of these slots.
		fun CreateFileA(
			name: cstring,
			access: u32,
			share: u32,
			security: ^byte,            // LPSECURITY_ATTRIBUTES — actual pointer; pass void
			disposition: u32,
			flags: u32,
			template: File_Id) -> File_Id  // HANDLE hTemplateFile / return — pass File_Id(0) for none
		fun ReadFile(
			h: File_Id,
			buf: ^byte,
			bytes_to_read: u32,
			bytes_read_out: ^u32,
			overlapped: ^byte) -> i32
		fun WriteFile(
			h: File_Id,
			buf: ^byte,
			bytes_to_write: u32,
			bytes_written_out: ^u32,
			overlapped: ^byte) -> i32
		fun CloseHandle(h: File_Id) -> i32
		fun GetFileSizeEx(h: File_Id, size_out: ^i64) -> i32
		// distance is a LARGE_INTEGER passed by value; new_ptr_out is a
		// PLARGE_INTEGER that receives the resulting position; method is
		// FILE_BEGIN/CURRENT/END (== SEEK_SET/CUR/END).
		fun SetFilePointerEx(h: File_Id, distance: i64, new_ptr_out: ^i64, move_method: u32) -> i32
		fun DeleteFileA(name: cstring) -> i32
		fun MoveFileExA(from: cstring, to: cstring, flags: u32) -> i32
		fun CopyFileA(src: cstring, dst: cstring, fail_if_exists: i32) -> i32
		// info_level: GetFileExInfoStandard = 0 (the only documented value).
		// Fills the supplied WIN32_FILE_ATTRIBUTE_DATA with attributes +
		// FILETIMEs + size.
		fun GetFileAttributesExA(name: cstring, info_level: i32, out: ^byte) -> i32
		// A file mapped into memory: the mapping (sizes 0: the whole file;
		// void, failing), then a view of it (size 0: all of it).
		fun CreateFileMappingA(file: File_Id, attributes: ^byte, protect: u32, size_high: u32, size_low: u32, name: ^byte) -> File_Id
		fun MapViewOfFile(mapping: File_Id, access: u32, offset_high: u32, offset_low: u32, size: usize) -> ^byte
		fun UnmapViewOfFile(base: ^byte) -> i32
		fun GetLastError() -> u32
	}

	// ---- Paths ----

	// The directory the program runs in — where a path not whole starts —
	// as the system has it (real_path's: its letters' case as on disk, links
	// and junctions followed, a mapped drive's folder its server's), however
	// it was entered; whole (no separator at its end but a drive's root,
	// `C:/`), its separators '/', a 0 after it: a Path, its room past the
	// path there to add to (`&cwd ++ "/code"`). Too_Large when it's longer
	// than a Path holds; Open_Failed when it's gone (deleted while the
	// program ran in it); Read_Failed when the system won't say.
	// (exe_path: the program's own file, wherever it runs.)
	current_dir :: fun() -> Path, err {
		dir := real_path(".")?
		if dir.len == dir.cap do return dir, Too_Large   // (no room for the 0 after it: real_path's Path is zero past its len)
		return dir
	}

	// Makes `path` the directory the program runs in: a path not whole starts
	// there from now on. Open_Failed when it can't go there: no such directory,
	// say.
	set_current_dir :: fun(path: []utf8) -> err {
		c := c_path(path)
		if SetCurrentDirectoryA(cstring(c)) == 0 do return Open_Failed
	}

	// One directory made, the one before it there already. Whether a directory
	// is there now.
	dir_make_one :: fun(path: []utf8) -> bool {
		c := c_path(path)
		if bool(CreateDirectoryA(cstring(c), void)) do return true
		kind := GetFileAttributesA(cstring(c))
		return kind != 0xFFFFFFFF and kind & 0x10 != 0   // (INVALID_FILE_ATTRIBUTES; FILE_ATTRIBUTE_DIRECTORY)
	}

	// Deletes the directory at path, which must be empty: Delete_Failed if not.
	dir_delete :: fun(path: []utf8) -> err {
		c := c_path(path)
		if not bool(RemoveDirectoryA(cstring(c))) do return Delete_Failed
	}

	// A path as the system has it, whole — a file's or a folder's: its
	// letters' case as on disk, its links (symlinks, junctions) followed to
	// where they lead, a mapped drive's folder its server's
	// (`//server/share/…`), `.` and `..` gone, its separators '/'. Two
	// spellings of one place give one path: a path from the command line or
	// a file made so, it compares with current_dir's and exe_path's
	// (real already) and the paths built on them as they are. Open_Failed
	// when nothing's there; Too_Large when it's longer than a Path holds;
	// Read_Failed when the system won't say.
	real_path :: fun(path: []utf8) -> Path, err {
		out : Path
		c := c_path(path)
		id := CreateFileA(cstring(c), 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, void, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NO_FILE)
		if id == INVALID_HANDLE_VALUE do return out, Open_Failed
		defer file_close(id)
		// (Its whole name, `\\?\C:\…` or `\\?\UNC\server\…`: its length, or
		// the room it wants, its 0 counted, when that's more than full has.)
		full : [600]utf8
		full.len = full.cap   // (the system's to fill)
		n := i64(GetFinalPathNameByHandleA(id, &full[0], u32(full.cap), 0))
		if n == 0 do return out, Read_Failed
		if n >= full.cap do return out, Too_Large
		full.len = n
		name : []utf8 = full
		unc := false
		if starts_with(name, "\\\\?\\UNC\\") {
			name = name[8 : name.len]
			unc = true
		elif starts_with(name, "\\\\?\\")
			name = name[4 : name.len]
		}
		room := name.len
		if unc do room += 2
		if room > out.cap do return out, Too_Large
		if unc do &out ++ "\\\\"
		&out ++ name
		slashes_forward(&out)
		return out
	}

	// The running program's own file: its path, whole, as the system has it
	// (real_path's: its letters' case as on disk, a link followed to the
	// file itself) — however it was started (by a name its PATH found, a
	// relative path, a link), unlike main's args[0], which is what its
	// starter wrote — for the files that come with it, beside it: a Path, to
	// cut to its directory and add a file's name to (`exe.len =
	// get_dir(exe).len`, `&exe ++ "font.ttf"`). Too_Large when it's longer
	// than a Path holds; Read_Failed when the system won't say.
	// (GetModuleFileNameA: in the system's code page, as the other files'
	// functions here take paths; the folders spelled as the program was
	// started — so real_path asked too.)
	exe_path :: fun() -> Path, err {
		path : Path
		path.len = path.cap   // (the system's to fill)
		n := i64(GetModuleFileNameA(void, &path[0], u32(path.cap)))
		path.len = 0
		if n == 0 do return path, Read_Failed
		// (As long as the room, it was cut off: no room for its 0.)
		if n >= path.cap do return path, Too_Large
		path.len = n
		return real_path(path)
	}

	// The files and directories in a directory, to look through what's there:
	// each one's name, whether it leads to a directory, and whether it's a
	// link (Dir_Entry) — not "." or "..", in no order to count on — into
	// storage after what's there, side by side, its len moved past them, and
	// given back, a view of them. Fails with Open_Failed when there's no
	// directory there, Too_Large when they don't fit in storage's room
	// (storage untouched). The path is copied: any slice of one will do
	// (cstring's 0 needn't follow it). (Counted first, then each written:
	// listed twice.)
	dir_read :: fun(path: []utf8, storage: ^[]byte) -> []Dir_Entry, err {
		start := storage.len
		none := slice([:0]Dir_Entry, storage)
		storage.len = start
		if path.len > 500 do return none, Open_Failed   // (its pattern on the stack, under 1 KB)
		pattern : [512]utf8
		&pattern ++ path
		&pattern ++ "\\*"
		found : WIN32_FIND_DATAA
		search := FindFirstFileA(cstring(pattern), &found)
		if search == INVALID_HANDLE_VALUE do return none, Open_Failed
		count : i64 = 0
		for true {
			name := read_cstring(260, &found.name[0])
			if name != "." and name != ".." do count += 1
			if not bool(FindNextFileA(search, &found)) do break
		}
		_ = FindClose(search)
		// (Room for them, past what aligning them may skip.)
		if storage.cap - start < count * size_of(Dir_Entry) + 8 do return none, Too_Large
		entries := slice([:count]Dir_Entry, storage)
		search = FindFirstFileA(cstring(pattern), &found)
		if search == INVALID_HANDLE_VALUE do return entries[0 : 0], Open_Failed
		k : i64 = 0
		for k < count {
			name := read_cstring(260, &found.name[0])
			if name != "." and name != ".." {
				entry : Dir_Entry
				&entry.name ++ name
				entry.dir = (found.attributes & FILE_ATTRIBUTE_DIRECTORY) != 0
				entry.link = false
				// (A link: a reparse point tagged a symbolic link or a
				// junction — OneDrive's placeholders are reparse points too.
				// Its own directory bit says what it was made as: asked
				// where it leads.)
				tag := found.reserved0
				if (found.attributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0 and (tag == IO_REPARSE_TAG_SYMLINK or tag == IO_REPARSE_TAG_MOUNT_POINT) {
					entry.link = true
					entry.dir = link_leads_to_dir(path, name)
				}
				&entries ++ entry
				k += 1
			}
			if not bool(FindNextFileA(search, &found)) do break
		}
		_ = FindClose(search)
		return entries   // (fewer when it lost some since it counted)
	}

	FILE_ATTRIBUTE_DIRECTORY     :: 0x10
	FILE_ATTRIBUTE_REPARSE_POINT :: 0x400
	IO_REPARSE_TAG_SYMLINK       :: 0xA000000C
	IO_REPARSE_TAG_MOUNT_POINT   :: 0xA0000003   // (a junction)

	// Whether a link in a directory leads to a directory that's there.
	// Opened, it's followed — asked for nothing, nothing read.
	link_leads_to_dir :: fun(path: []utf8, name: []utf8) -> bool {
		full : [800]utf8
		&full ++ path
		&full ++ "\\"
		&full ++ name
		id := CreateFileA(cstring(full), 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, void, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NO_FILE)
		if id == INVALID_HANDLE_VALUE do return false
		info : BY_HANDLE_FILE_INFORMATION
		got := bool(GetFileInformationByHandle(id, &info))
		file_close(id)
		return got and (info.attributes & FILE_ATTRIBUTE_DIRECTORY) != 0
	}

	// WIN32_FIND_DATAA's layout: DWORDs and FILETIMEs (DWORD pairs, so no
	// padding), then the name, MAX_PATH bytes, and the short 8.3 name's 14.
	WIN32_FIND_DATAA :: struct {
		attributes:       u32
		creation_low:     u32
		creation_high:    u32
		last_access_low:  u32
		last_access_high: u32
		last_write_low:   u32
		last_write_high:  u32
		size_high:        u32
		size_low:         u32
		reserved0:        u32
		reserved1:        u32
		name:             [260!]byte
		short_name:       [14!]byte
	}

	foreign static_lib "kernel32" {
		// The directory the program runs in, changed: 0 failing.
		fun SetCurrentDirectoryA(path: cstring) -> i32
		fun CreateDirectoryA(path: cstring, attributes: ^byte) -> i32
		fun RemoveDirectoryA(path: cstring) -> i32
		fun GetFileAttributesA(path: cstring) -> u32
		// A directory's entries: the first, and each next (false: no more).
		fun FindFirstFileA(pattern: cstring, found: ^WIN32_FIND_DATAA) -> File_Id
		fun FindNextFileA(search: File_Id, found: ^WIN32_FIND_DATAA) -> i32
		fun FindClose(search: File_Id) -> i32
		// A loaded library's file — void: the program's own — its path into name.
		fun GetModuleFileNameA(library: ^byte, name: ^utf8, size: u32) -> u32
		// The directory the program runs in, into buf: its length; the room it
		// wants (its 0 counted) when buf is too small; 0 failing.
		// An open file's or folder's whole path as the system has it, into buf
		// (flags 0: its letters' case as on disk, `\\?\C:\…`): its length; the
		// room it wants (its 0 counted) when buf is too small; 0 failing.
		fun GetFinalPathNameByHandleA(file: File_Id, buf: ^utf8, size: u32, flags: u32) -> u32
		fun GetFileInformationByHandle(file: File_Id, info: ^BY_HANDLE_FILE_INFORMATION) -> i32
	}

	// ---- Pipes ----

	// ---------------------------------------------------------------------------
	// Named pipes: a program others connect to, by a name
	// ---------------------------------------------------------------------------

	// A name a program listens on (pipe_listen), for others on this machine
	// to connect to (pipe_connect). `id` is the pipe waiting for the next.
	Pipe_Listener :: struct {
		name: [300]utf8   // \\.\pipe\ and the name
		id:   File_Id
	}

	// Listens on a name — a word, such as "mara-view-game" — for programs on
	// this machine to connect to; pipe_accept takes each. Fails with
	// Name_Taken when another program listens on it.
	pipe_listen :: fun(name: []utf8) -> Pipe_Listener, err {
		l := Pipe_Listener{all 0}
		if name.len > 200 do return l, Listen_Failed
		&l.name ++ "\\\\.\\pipe\\"
		&l.name ++ name
		l.id = pipe_instance(&l, FILE_FLAG_FIRST_PIPE_INSTANCE)
		if l.id == INVALID_HANDLE_VALUE {
			l.id = NO_FILE
			if GetLastError() == ERROR_ACCESS_DENIED do return l, Name_Taken
			return l, Listen_Failed
		}
		return l
	}

	// The next program to connect to the listener's name, when one has: its
	// connection, to read from and write to as a file's id (pipe_read not to
	// wait), file_close ending it. NO_FILE when none has — it doesn't wait,
	// so a window can look each frame.
	pipe_accept :: fun(l: ^Pipe_Listener) -> File_Id, err {
		if l.id == NO_FILE {
			// (The last accept couldn't make the next one waiting: again.)
			l.id = pipe_instance(l, 0)
			if l.id == INVALID_HANDLE_VALUE {
				l.id = NO_FILE
				return NO_FILE, Accept_Failed
			}
		}
		// (Not waiting, ConnectNamedPipe says how it is: true, listening
		// from now on; then listening still, connected, or one came and went.)
		if bool(ConnectNamedPipe(l.id, void)) do return NO_FILE
		e := GetLastError()
		if e == ERROR_PIPE_LISTENING do return NO_FILE
		if e == ERROR_NO_DATA {
			_ = DisconnectNamedPipe(l.id)
			return NO_FILE
		}
		if e != ERROR_PIPE_CONNECTED do return NO_FILE, Accept_Failed
		// (Theirs now, its reads and writes waiting as a file's do; a new
		// one waits for the next.)
		mode: u32 = PIPE_WAIT
		_ = SetNamedPipeHandleState(l.id, &mode, void, void)
		taken := l.id
		l.id = pipe_instance(l, 0)
		if l.id == INVALID_HANDLE_VALUE do l.id = NO_FILE
		return taken
	}

	// Connects to a name a program listens on (pipe_listen): the connection,
	// to write to and read from as a file's id, file_close ending it. Fails
	// with Connect_Failed when nobody listens there.
	pipe_connect :: fun(name: []utf8) -> File_Id, err {
		full : [300]utf8
		if name.len > 200 do return NO_FILE, Connect_Failed
		&full ++ "\\\\.\\pipe\\"
		&full ++ name
		for _ in 0:5 {
			id := CreateFileA(cstring(full), GENERIC_READ | GENERIC_WRITE, 0, void, OPEN_EXISTING, 0, NO_FILE)
			if id != INVALID_HANDLE_VALUE do return id
			// (Each one taken, between one accept and the next: wait for one.)
			if GetLastError() != ERROR_PIPE_BUSY do return NO_FILE, Connect_Failed
			_ = WaitNamedPipeA(cstring(full), 1000)
		}
		return NO_FILE, Connect_Failed
	}

	// Stops listening: the name free for another. Connections taken stay
	// open until closed.
	pipe_listen_stop :: fun(l: ^Pipe_Listener) {
		file_close(l.id)
		l.id = NO_FILE
	}

	// One pipe of the listener's name, waiting for a program to connect:
	// not blocking (pipe_accept looks, and returns), and for this machine
	// only.
	pipe_instance :: fun(l: ^Pipe_Listener, first: u32) -> File_Id {
		return CreateNamedPipeA(cstring(l.name), PIPE_ACCESS_DUPLEX | first, PIPE_NOWAIT | PIPE_REJECT_REMOTE_CLIENTS,
		                        PIPE_UNLIMITED_INSTANCES, 4096, 4096, 0, void)
	}

	PIPE_ACCESS_DUPLEX            :: 0x00000003
	FILE_FLAG_FIRST_PIPE_INSTANCE :: 0x00080000   // fails when the name is taken
	PIPE_WAIT                     :: 0x00000000   // (byte mode: 0 too)
	PIPE_NOWAIT                   :: 0x00000001
	PIPE_REJECT_REMOTE_CLIENTS    :: 0x00000008
	PIPE_UNLIMITED_INSTANCES      :: 255
	ERROR_ACCESS_DENIED           :: 5
	ERROR_PIPE_BUSY               :: 231
	ERROR_NO_DATA                 :: 232
	ERROR_PIPE_CONNECTED          :: 535
	ERROR_PIPE_LISTENING          :: 536

	foreign static_lib "kernel32" {
		// Named pipes
		fun CreateNamedPipeA(
			name:          cstring,
			open_mode:     u32,
			pipe_mode:     u32,
			max_instances: u32,
			out_size:      u32,
			in_size:       u32,
			timeout:       u32,
			attributes:    ^SECURITY_ATTRIBUTES) -> File_Id
		fun ConnectNamedPipe(pipe: File_Id, overlapped: ^byte) -> i32
		fun DisconnectNamedPipe(pipe: File_Id) -> i32
		fun SetNamedPipeHandleState(pipe: File_Id, mode: ^u32, max_collection: ^u32, timeout: ^u32) -> i32
		fun WaitNamedPipeA(name: cstring, timeout: u32) -> i32
	}

	// ---- Processes ----

	// An environment variable's value (`env("LOCALAPPDATA")`): copied into a
	// Path, a 0 after it. Not_Set when no variable of that name is set;
	// Too_Large when the value is longer than a Path holds (511 characters).
	// (GetEnvironmentVariableA: in the system's code page, as the paths here
	// are. A value set empty reads as empty, not as Not_Set.)
	env :: fun(name: []utf8) -> Path, err {
		value : Path
		c := c_path(name)
		// (Its length; the room it wants, its 0 counted, when that's more
		// than value has; 0 for none, or for an empty one: the error says.)
		SetLastError(0)
		value.len = value.cap   // (the system's to fill)
		n := i64(GetEnvironmentVariableA(cstring(c), &value[0], u32(value.cap)))
		value.len = 0
		if n == 0 and GetLastError() == ERROR_ENVVAR_NOT_FOUND do return value, Not_Set
		if n >= value.cap do return value, Too_Large
		value.len = n
		return value
	}

	// ---------------------------------------------------------------------------
	// Processes: a program run with its input and output through pipes
	// ---------------------------------------------------------------------------

	// A program process_start started: its input, to write to with
	// file_write; its output, to read from with file_read, or pipe_read not
	// to wait (its error output comes there too). `id` is its Win32 process handle.
	Process :: struct {
		id:     File_Id
		input:  File_Id
		output: File_Id
	}

	// Runs a command line — a program and its arguments, as a terminal takes
	// them — its input and output through pipes. Read its output while it
	// runs: one that fills its output pipe waits until it is read.
	process_start :: fun(command: []utf8) -> Process, err {
		// (Each pipe's ends inheritable, then the parent's own ends made not:
		// the child holds only its own, so closing ours ends its input.)
		inherit := SECURITY_ATTRIBUTES{length = u32(size_of(SECURITY_ATTRIBUTES)), inherit_handle = 1}
		child_in := NO_FILE
		to_child := NO_FILE
		if not bool(CreatePipe(&child_in, &to_child, &inherit, 0)) do return Process{all 0}, Start_Failed
		from_child := NO_FILE
		child_out := NO_FILE
		if not bool(CreatePipe(&from_child, &child_out, &inherit, 0)) {
			file_close(child_in)
			file_close(to_child)
			return Process{all 0}, Start_Failed
		}
		_ = SetHandleInformation(to_child, HANDLE_FLAG_INHERIT, 0)
		_ = SetHandleInformation(from_child, HANDLE_FLAG_INHERIT, 0)
		start := STARTUPINFOA{size = u32(size_of(STARTUPINFOA)), flags = STARTF_USESTDHANDLES,
		                      std_input = child_in, std_output = child_out, std_error = child_out}
		info : PROCESS_INFORMATION
		started := CreateProcessA(void, cstring(command), void, void, 1, CREATE_NO_WINDOW, void, void, &start, &info)
		// (The child's ends are its own now: ours closed, started or not.)
		file_close(child_in)
		file_close(child_out)
		if not bool(started) {
			file_close(to_child)
			file_close(from_child)
			return Process{all 0}, Start_Failed
		}
		file_close(info.thread)
		return Process{id = info.process, input = to_child, output = from_child}
	}

	// Closes the process's input: it reads to its end. (A server its window
	// started exits there.)
	process_close_input :: fun(p: ^Process) {
		file_close(p.input)
		p.input = NO_FILE
	}

	// Reads from a pipe what has arrived, without waiting for more — for a
	// program that can't wait, as a window between its frames: data.len
	// becomes the number of bytes read, 0 when none has. Returns false once
	// the pipe has ended: its writer closed and all it wrote read.
	pipe_read :: fun(id: File_Id, data: ^[]byte) -> bool, err {
		data.len = 0
		waiting: u32 = 0
		if not bool(PeekNamedPipe(id, void, 0, void, &waiting, void)) {
			if GetLastError() == ERROR_BROKEN_PIPE do return false
			return false, Read_Failed
		}
		if waiting > 0 {
			file_read(id, data)?   // (what has arrived: it doesn't wait)
		}
		return true
	}

	// Waits for the process to end and returns its exit code — its input and
	// output closed first, so one still writing stops rather than waiting
	// for a reader. Read what it writes before.
	process_wait :: fun(p: ^Process) -> i64, err {
		process_close_input(p)
		file_close(p.output)
		p.output = NO_FILE
		code: u32 = 0
		waited := WaitForSingleObject(p.id, INFINITE) != WAIT_FAILED and bool(GetExitCodeProcess(p.id, &code))
		file_close(p.id)
		p.id = NO_FILE
		if not waited do return 0, Wait_Failed
		return i64(code)
	}

	// The program's own input: what a terminal types, or what the program
	// that started it writes (process_start). Read it with file_read.
	standard_input :: fun() -> File_Id {
		return GetStdHandle(STD_INPUT_HANDLE)
	}

	// The program's own output, written to with file_write. (print writes
	// there too, through a buffer of its own: mixing the two can reorder.)
	standard_output :: fun() -> File_Id {
		return GetStdHandle(STD_OUTPUT_HANDLE)
	}

	// CreatePipe's handles, inheritable or not.
	SECURITY_ATTRIBUTES :: struct {
		length:         u32
		descriptor:     ^byte
		inherit_handle: i32
	}

	// CreateProcessA's start: which handles are the child's input and output.
	STARTUPINFOA :: struct {
		size:           u32
		reserved:       ^byte
		desktop:        ^byte
		title:          ^byte
		x:              u32
		y:              u32
		x_size:         u32
		y_size:         u32
		x_chars:        u32
		y_chars:        u32
		fill_attribute: u32
		flags:          u32
		show_window:    u16
		reserved2_size: u16
		reserved2:      ^byte
		std_input:      File_Id
		std_output:     File_Id
		std_error:      File_Id
	}

	// What CreateProcessA started: its process and its first thread.
	PROCESS_INFORMATION :: struct {
		process:    File_Id
		thread:     File_Id
		process_id: u32
		thread_id:  u32
	}

	STARTF_USESTDHANDLES :: 0x00000100
	HANDLE_FLAG_INHERIT  :: 0x00000001
	CREATE_NO_WINDOW     :: 0x08000000   // no console window of its own
	INFINITE             :: 0xFFFFFFFF
	WAIT_FAILED          :: 0xFFFFFFFF
	STD_INPUT_HANDLE     :: 0xFFFFFFF6   // (DWORD)-10
	STD_OUTPUT_HANDLE    :: 0xFFFFFFF5   // (DWORD)-11
	ERROR_BROKEN_PIPE    :: 109
	ERROR_ENVVAR_NOT_FOUND :: 203

	foreign static_lib "kernel32" {
		// Processes and pipes
		fun CreatePipe(read: ^File_Id, write: ^File_Id, attributes: ^SECURITY_ATTRIBUTES, size: u32) -> i32
		fun SetHandleInformation(h: File_Id, mask: u32, flags: u32) -> i32
		fun CreateProcessA(
			application:        ^byte,    // void: the command line names the program
			command_line:       cstring,
			process_attributes: ^byte,
			thread_attributes:  ^byte,
			inherit_handles:    i32,
			creation_flags:     u32,
			environment:        ^byte,
			current_directory:  ^byte,
			startup:            ^STARTUPINFOA,
			info:               ^PROCESS_INFORMATION) -> i32
		fun WaitForSingleObject(h: File_Id, milliseconds: u32) -> u32
		fun GetExitCodeProcess(h: File_Id, code: ^u32) -> i32
		fun GetStdHandle(which: u32) -> File_Id
		fun SetLastError(code: u32)
		fun GetEnvironmentVariableA(name: cstring, value: ^utf8, size: u32) -> u32
		fun PeekNamedPipe(pipe: File_Id, buffer: ^byte, size: u32, read: ^u32, available: ^u32, message_left: ^u32) -> i32
	}

	// ---- Threads ----

	// ---------------------------------------------------------------------------
	// Threads
	// ---------------------------------------------------------------------------

	// A thread thread_start started, to wait for with thread_wait. `id` is
	// its Win32 thread handle.
	Thread :: struct {
		id: File_Id
	}

	// A lock one thread holds at a time: mutex_lock waits until it's free.
	// Zero is unlocked: declare one and use it. (Win32's SRWLOCK, a
	// pointer's size.)
	Mutex :: struct {
		lock: u64 = 0
	}

	// What threads wait on until another says something changed. Zero is ready:
	// declare one and use it. A Mutex guards what's waited for. (Win32's
	// CONDITION_VARIABLE, a pointer's size.)
	Condition :: struct {
		state: u64 = 0
	}

	// Runs work(data) on a new thread and returns at once. The thread puts
	// its big values on an arena of its own, of the program's kind and
	// arena_size bytes, made when it starts and released when it ends: what
	// it makes for the program goes into data. Wait for every thread
	// (thread_wait) before data goes, and before main returns: the program
	// ends when main does, its threads with it.
	thread_start :: fun(work: fun(^$T), data: ^T, arena_size: i64 = 16 << 20) -> Thread, err {
		start: ^Thread_Start = HeapAlloc(GetProcessHeap(), 0, usize(size_of(Thread_Start)))
		if start == void do return Thread{NO_FILE}, Thread_Start_Failed
		// (Copied in by the system: the escape check can't see a thread's
		// life, so it would refuse data in memory that outlives this call.
		// That data outlives the thread is the caller's: thread_wait.)
		given := Thread_Start{work = work, data = data, arena_size = arena_size}
		RtlMoveMemory(start, &given, usize(size_of(Thread_Start)))
		id := CreateThread(void, usize(0), thread_entry, start, 0, void)
		if id == NO_FILE {
			_ = HeapFree(GetProcessHeap(), 0, start)
			return Thread{NO_FILE}, Thread_Start_Failed
		}
		return Thread{id = id}
	}

	// A new thread's first fun, as Windows calls it: its start read and freed,
	// its work run on an arena of its own, the arena released after.
	thread_entry :: fun(start: ^Thread_Start) -> u32 {
		if start == void do return 0
		s := start^
		_ = HeapFree(GetProcessHeap(), 0, start)
		base := thread_run(s.work, s.data, s.arena_size)
		if base != void do vm_release(base, s.arena_size)
		return 0
	}

	// Waits for the thread to end. A thread waited for, or one that never
	// started, is ignored.
	thread_wait :: fun(t: ^Thread) {
		if t.id == NO_FILE do return
		_ = WaitForSingleObject(t.id, INFINITE)
		file_close(t.id)
		t.id = NO_FILE
	}

	// Takes the lock, waiting while another thread holds it.
	mutex_lock :: fun(m: ^Mutex) {
		AcquireSRWLockExclusive(m)
	}

	// Lets the lock go, for the next thread waiting for it.
	mutex_unlock :: fun(m: ^Mutex) {
		ReleaseSRWLockExclusive(m)
	}

	// Lets the lock go and waits for a wake, as one step: no wake can come
	// between the two. It holds the lock again when it returns. It can return
	// with no wake sent, so wait in a loop that checks what's being waited for:
	// `for not ready do condition_wait(&c, &m)`.
	condition_wait :: fun(c: ^Condition, m: ^Mutex) {
		_ = SleepConditionVariableSRW(c, m, INFINITE, 0)
	}

	// Wakes one thread waiting on c, if any is.
	condition_wake_one :: fun(c: ^Condition) {
		WakeConditionVariable(c)
	}

	// Wakes every thread waiting on c.
	condition_wake_all :: fun(c: ^Condition) {
		WakeAllConditionVariable(c)
	}

	// How many threads the machine runs at once: its logical processors.
	cpu_count :: fun() -> i64 {
		return i64(GetActiveProcessorCount(0xFFFF))   // (0xFFFF: every processor group)
	}

	foreign static_lib "kernel32" {
		// Threads
		fun CreateThread(attributes: ^byte, stack: usize, entry: fun(^byte) -> u32, start: ^byte, flags: u32, id: ^u32) -> File_Id
		fun GetProcessHeap() -> ^byte
		fun HeapAlloc(heap: ^byte, flags: u32, size: usize) -> ^byte
		fun HeapFree(heap: ^byte, flags: u32, p: ^byte) -> i32
		fun AcquireSRWLockExclusive(lock: ^Mutex)
		fun ReleaseSRWLockExclusive(lock: ^Mutex)
		fun SleepConditionVariableSRW(c: ^Condition, lock: ^Mutex, ms: u32, flags: u32) -> i32
		fun WakeConditionVariable(c: ^Condition)
		fun WakeAllConditionVariable(c: ^Condition)
		fun GetActiveProcessorCount(group: u16) -> u32
	}

	// ---- Time ----

	CREATE_WAITABLE_TIMER_HIGH_RESOLUTION :: 0x00000002
	SYNCHRONIZE          :: 0x00100000
	TIMER_MODIFY_STATE   :: 0x00000002

	// Now, on a clock that only goes forward: nanoseconds since some point —
	// the system's start, not a date. How long something took: the
	// difference of two.
	clock_ns :: fun() -> i64 {
		count : i64 = 0
		per_second : i64 = 0
		_ = QueryPerformanceCounter(&count)
		_ = QueryPerformanceFrequency(&per_second)   // (fixed while the system runs)
		// (Whole seconds, then the rest: count·10^9 at once would overflow.)
		return count / per_second * 1000000000 + count % per_second * 1000000000 / per_second
	}

	// Now, by the calendar: nanoseconds since 1970-01-01 00:00 UTC. It jumps
	// when the system's clock is set, so for how long something took, clock_ns.
	clock_unix_ns :: fun() -> i64 {
		ticks : u64 = 0
		GetSystemTimePreciseAsFileTime(&ticks)   // (in 100 ns, since 1601)
		return (i64(ticks) - 116444736000000000) * 100
	}

	// Waits: the program does nothing for `ns` nanoseconds — at least, and
	// a little more, as the system wakes it: a fraction of a millisecond (a
	// high-resolution timer; Sleep's waits round up to the system's tick,
	// 15.6 ms). Before Windows 10's 1803 there's none: whole milliseconds.
	sleep_ns :: fun(ns: i64) {
		if ns <= 0 do return
		timer := CreateWaitableTimerExW(void, void, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, SYNCHRONIZE | TIMER_MODIFY_STATE)
		if timer == NO_FILE {
			Sleep(u32((ns + 999999) / 1000000))
			return
		}
		due : i64 = -((ns + 99) / 100)   // (from now: negative, in 100 ns)
		if bool(SetWaitableTimer(timer, &due, 0, void, void, 0)) do _ = WaitForSingleObject(timer, INFINITE)
		_ = CloseHandle(timer)
	}

	// Waits: the program does nothing for `ms` milliseconds (at least).
	sleep_ms :: fun(ms: u32) {
		sleep_ns(i64(ms) * 1000000)
	}

	foreign static_lib "kernel32" {
		fun Sleep(ms: u32)
		// Clocks and timers
		fun QueryPerformanceCounter(count: ^i64) -> i32
		fun QueryPerformanceFrequency(per_second: ^i64) -> i32
		fun GetSystemTimePreciseAsFileTime(ticks: ^u64)
		fun CreateWaitableTimerExW(attributes: ^byte, name: ^byte, flags: u32, access: u32) -> File_Id
		fun SetWaitableTimer(timer: File_Id, due: ^i64, period: i32, routine: ^byte, argument: ^byte, resume: i32) -> i32
	}

	// ---- Memory ----

	// ---------------------------------------------------------------------------
	// VirtualAlloc / VirtualFree flags
	// ---------------------------------------------------------------------------

	// flAllocationType — combinable via OR
	MEM_RESERVE :: 0x2000
	MEM_COMMIT  :: 0x1000

	// dwFreeType
	MEM_RELEASE :: 0x8000

	// flProtect
	PAGE_NOACCESS  :: 0x01
	PAGE_READONLY  :: 0x02
	PAGE_READWRITE :: 0x04

	// ---------------------------------------------------------------------------
	// Virtual memory
	// ---------------------------------------------------------------------------

	// Reserve a virtual address range without committing physical pages.
	// Touching uncommitted bytes traps; commit them first with vm_commit.
	// Caller must release with vm_release.
	vm_reserve :: fun(size: i64) -> ^byte {
		return VirtualAlloc(void, usize(size), MEM_RESERVE, PAGE_NOACCESS)
	}

	// Commit physical pages for the [base, base+size) range. Returns 1 on
	// success, 0 on failure (typically out-of-memory). The range must lie
	// inside something previously returned by vm_reserve.
	vm_commit :: fun(base: ^byte, size: i64) -> i64 {
		if VirtualAlloc(base, usize(size), MEM_COMMIT, PAGE_READWRITE) == void do return 0
		return 1
	}

	// Release a reserved (and possibly committed) range. `base` must be
	// exactly the pointer returned by vm_reserve, and size the size reserved
	// (Windows remembers it; Linux doesn't). Partial releases are not
	// supported.
	vm_release :: fun(base: ^byte, size: i64) {
		_ = VirtualFree(base, usize(0), MEM_RELEASE)
	}

	foreign static_lib "kernel32" {
		fun VirtualAlloc(
			addr:       ^byte,        // LPVOID — pass void to let the system choose
			size:       usize,
			alloc_type: u32,          // MEM_RESERVE / MEM_COMMIT (or both via OR)
			protect:    u32) -> ^byte // PAGE_* flags
		fun VirtualFree(
			addr:      ^byte,
			size:      usize,         // 0 with MEM_RELEASE
			free_type: u32) -> i32
	}

	// ---- Libraries ----

	// ---------------------------------------------------------------------------
	// Dynamic library loading (dlopen-equivalent)
	// ---------------------------------------------------------------------------

	// Load a DLL by name. Returns void on failure. Win32's search order applies —
	// pass a full path to bypass it. Caller must release with free_library.
	load_library :: fun(name: []utf8) -> ^byte {
		return LoadLibraryA(cstring(name))
	}

	// Look up a symbol in a loaded module. Returns void if the symbol does not
	// exist. Cast the returned ^byte to the appropriate function pointer type
	// at the call site.
	find_symbol :: fun(mod: ^byte, name: []utf8) -> ^byte {
		return GetProcAddress(mod, cstring(name))
	}

	// Unloads a library that load_library loaded.
	free_library :: fun(mod: ^byte) {
	_ = FreeLibrary(mod)
	}

	foreign static_lib "kernel32" {
		fun LoadLibraryA(name: cstring) -> ^byte
		fun GetProcAddress(mod: ^byte, name: cstring) -> ^byte
		fun FreeLibrary(mod: ^byte) -> i32
	}

	// ---- Random ----

	// Fills data with random bytes nobody can guess: all its room, so its len
	// becomes its cap. For keys, salts and tokens.
	random_bytes :: fun(data: ^[]byte) -> err {
		data.len = data.cap
		if data.cap == 0 do return
		// (2: BCRYPT_USE_SYSTEM_PREFERRED_RNG. It takes a u32, so a piece at a time.)
		done : i64 = 0
		for done < data.cap {
			piece := data.cap - done
			if piece > 1 << 30 do piece = 1 << 30
			if BCryptGenRandom(void, &data[done], u32(piece), 2) != 0 {
				data.len = 0
				return Random_Failed
			}
			done += piece
		}
	}

	foreign static_lib "bcrypt" {
		fun BCryptGenRandom(algorithm: ^byte, into: ^byte, size: u32, flags: u32) -> i32
	}

	// ---- Network ----

	// ---------------------------------------------------------------------------
	// Sockets: talking to other machines (Winsock)
	// ---------------------------------------------------------------------------

	// The address of a machine by its name — "example.com", or an IP
	// address's text, "192.168.1.20" or "::1" — and the port given. A name
	// is asked of the network's name servers: it may take a second or more.
	// A name with an IPv4 address and an IPv6 one gives the IPv4 one. Fails
	// with Lookup_Failed when the name has no address.
	net_lookup :: fun(name: []utf8, port: u16) -> Net_Address, err {
		a := net_any(port)
		if not net_start() do return a, Socket_Failed
		if name.len > 255 do return a, Lookup_Failed
		text : [256]utf8
		&text ++ name
		hints := Addrinfo_Hints()
		hints.kind = SOCK_DGRAM   // (each address once, not once a kind)
		found: ^Addrinfo = void
		if getaddrinfo(cstring(text), void, &hints, &found) != 0 do return a, Lookup_Failed
		defer freeaddrinfo(found)
		pick := net_pick(found)
		if pick == void do return a, Lookup_Failed
		at := Sockaddr()
		size := pick.size
		if size > usize(size_of(Sockaddr)) do size = usize(size_of(Sockaddr))
		RtlMoveMemory(&at, pick.at, size)
		a = address_of(&at)
		a.port = port
		return a
	}

	// Of getaddrinfo's answers, the one to use: the first IPv4 address
	// when the name has one, else the first IPv6 one (void when neither).
	// IPv4 reaches a server at net_local and at net_any alike, where the
	// system's first pick may not: "localhost" is ::1 first, and nobody
	// listening at 127.0.0.1 hears it.
	net_pick :: fun(found: ^Addrinfo) -> ^Addrinfo {
		each := found
		for each != void {
			if each.family == AF_INET do return each
			each = each.next
		}
		each = found
		for each != void {
			if each.family == AF_INET6 do break
			each = each.next
		}
		return each   // (void when neither: the list's end)
	}

	// A UDP socket at `at` — net_any(port) for every address of this
	// machine, net_local(port) for this machine only — to send packets from
	// and receive packets at. Port 0: one the system picks, the socket's
	// `port` saying which. Fails with Port_Taken when another socket has
	// the port.
	udp_open :: fun(at: Net_Address) -> Udp_Socket, err {
		s := Udp_Socket{id = NO_SOCKET, v4 = false, port = 0}
		id, e := net_bind(at, SOCK_DGRAM, &s.v4, &s.port)
		if e do return s, e
		s.id = id
		return s
	}

	// Sends data, one packet, to `to`. It may never arrive, or arrive after
	// one sent later: UDP doesn't check. (Nor does it here: a packet the
	// system has no room for at the moment is lost too.) Packets up to
	// about 1200 bytes go whole across any network.
	udp_send :: fun(s: ^Udp_Socket, to: Net_Address, data: []byte) -> err {
		if s.v4 and not net_is_ip4(to) do return Unreachable   // (an IPv4 socket reaches no IPv6 address)
		at := Sockaddr()
		size := sockaddr_of(to, s.v4, &at)
		if sendto(s.id, data.ptr, i32(data.len), 0, &at, i32(size)) >= 0 do return
		if WSAGetLastError() == WSAEWOULDBLOCK do return
		return Send_Failed
	}

	// Takes the next packet that has arrived, without waiting: true, the
	// packet in data (data.len its size) and its sender in `from`; false
	// when none has. data's room is the biggest packet it takes: a bigger
	// one is lost, failing with Packet_Too_Large.
	udp_receive :: fun(s: ^Udp_Socket, data: ^[]byte, from: ^Net_Address) -> bool, err {
		data.len = 0
		if data.cap == 0 do return false, Packet_Too_Large
		for true {
			at := Sockaddr()
			size: i32 = i32(size_of(Sockaddr))
			data.len = data.cap   // (the system's to fill)
			n := recvfrom(s.id, &data[0], i32(data.cap), 0, &at, &size)
			data.len = 0
			if n >= 0 {
				data.len = i64(n)
				from^ = address_of(&at)
				return true
			}
			e := WSAGetLastError()
			if e == WSAEWOULDBLOCK do return false
			if e == WSAEMSGSIZE do return false, Packet_Too_Large
			// (Word from the network that an earlier packet found nobody
			// there: no packet. Windows tells it here; take the next.)
			if e != WSAECONNRESET and e != WSAENETRESET do return false, Receive_Failed
		}
		return false
	}

	// Closes the socket.
	udp_close :: fun(s: ^Udp_Socket) {
		if s.id == NO_SOCKET do return
		_ = closesocket(s.id)
		s.id = NO_SOCKET
	}

	// Listens at `at` — net_any(port) or net_local(port), as udp_open —
	// for TCP connections, tcp_accept taking each. Port 0: one the system
	// picks, the listener's `port` saying which. Fails with Port_Taken
	// when another socket has the port.
	tcp_listen :: fun(at: Net_Address) -> Tcp_Listener, err {
		l := Tcp_Listener{id = NO_SOCKET, v4 = false, port = 0}
		id, e := net_bind(at, SOCK_STREAM, &l.v4, &l.port)
		if e do return l, e
		l.id = id
		return l
	}

	// The next connection to the listener, when one has come: true, and
	// `c` it. False when none has: it doesn't wait, so a game can look each
	// frame.
	tcp_accept :: fun(l: ^Tcp_Listener, c: ^Tcp_Connection) -> bool, err {
		at := Sockaddr()
		size: i32 = i32(size_of(Sockaddr))
		id := accept(l.id, &at, &size)
		if id == NO_SOCKET {
			e := WSAGetLastError()
			if e == WSAEWOULDBLOCK or e == WSAECONNRESET do return false   // (none, or one that came and went)
			return false, Socket_Failed
		}
		// (Not waiting, as the listener; not handed to programs this one
		// starts.)
		on: u32 = 1
		_ = ioctlsocket(id, FIONBIO, &on)
		_ = SetHandleInformation(id, HANDLE_FLAG_INHERIT, 0)
		net_no_delay(id)
		c.id = id
		c.v4 = l.v4
		c.peer = address_of(&at)
		return true
	}

	// Stops listening: the port free for another. Connections taken stay
	// open until closed.
	tcp_listen_stop :: fun(l: ^Tcp_Listener) {
		if l.id == NO_SOCKET do return
		_ = closesocket(l.id)
		l.id = NO_SOCKET
	}

	// Connects to a program listening at `to` (tcp_listen), waiting up to
	// wait_ms milliseconds for it to answer. Fails with Unreachable when
	// nobody answered.
	tcp_connect :: fun(to: Net_Address, wait_ms: i64 = 5000) -> Tcp_Connection, err {
		c := Tcp_Connection{id = NO_SOCKET, v4 = net_is_ip4(to), peer = to}
		if not net_start() do return c, Socket_Failed
		id := net_socket(c.v4, SOCK_STREAM)
		if id == NO_SOCKET do return c, Socket_Failed
		at := Sockaddr()
		size := sockaddr_of(to, c.v4, &at)
		if connect(id, &at, i32(size)) != 0 {
			// (Under way: wait for it.)
			if WSAGetLastError() != WSAEWOULDBLOCK or not net_connected(id, wait_ms) {
				_ = closesocket(id)
				return c, Unreachable
			}
		}
		net_no_delay(id)
		c.id = id
		return c
	}

	// Waits on many sockets at once, so one thread can serve many connections.
	// net_waiter_open makes one, with room for `room` sockets, taking what it
	// needs from storage. A waiter is one thread's. Several threads can each add
	// the same Tcp_Listener to their own, and tcp_accept shares its connections.
	// (WSAPoll: the sockets, in a list it's given each time.)
	Net_Waiter :: struct {
		sockets: []Wsa_Poll_Fd
		tags: []i64
	}

	// WSAPOLLFD.
	Wsa_Poll_Fd :: struct {
		id: File_Id
		events: i16
		answers: i16
	}

	POLLRDNORM :: 0x0100
	POLLWRNORM :: 0x0010
	POLLERR    :: 0x0001
	POLLHUP    :: 0x0002
	POLLNVAL   :: 0x0004

	// Adds a listener to wait on. Several threads can each add one listener to their own
	// waiter, and tcp_accept shares its connections out. (On Windows a new connection wakes
	// them all, and those too late get false from tcp_accept.)
	net_waiter_add_listener :: fun(w: ^Net_Waiter, l: ^Tcp_Listener, tag: i64) -> err {
		net_waiter_add(w, l.id, tag)?
	}

	net_waiter_open :: fun(room: i64, storage: ^[]byte) -> Net_Waiter, err {
		if not net_start() do return Net_Waiter{sockets = [], tags = []}, Socket_Failed
		sockets := slice([:room]Wsa_Poll_Fd, storage)
		tags := slice([:room]i64, storage)
		return Net_Waiter{sockets = sockets, tags = tags}
	}

	// Adds a socket (a Tcp_Connection's or a Tcp_Listener's id) to wait on. It's
	// ready when it can be read: for a listener, when a connection has come. `tag`
	// comes back with it from net_waiter_wait.
	net_waiter_add :: fun(w: ^Net_Waiter, id: File_Id, tag: i64) -> err {
		if w.sockets.len == w.sockets.cap do return Socket_Failed
		&w.sockets ++ Wsa_Poll_Fd{id = id, events = POLLRDNORM, answers = 0}
		&w.tags ++ tag
	}

	// Sets whether a socket added also counts as ready when it can be written. Turn
	// it on when a tcp_send_some couldn't send everything, and off when it's all gone:
	// a socket can almost always be written, so left on it's always ready.
	net_waiter_writing :: fun(w: ^Net_Waiter, id: File_Id, tag: i64, on: bool) -> err {
		for k in 0:w.sockets.len {
			if w.sockets[k].id == id {
				w.sockets[k].events = POLLRDNORM
				if on do w.sockets[k].events = POLLRDNORM | POLLWRNORM
				return
			}
		}
		return Socket_Failed
	}

	// Takes a socket out, before it's closed.
	net_waiter_remove :: fun(w: ^Net_Waiter, id: File_Id) {
		for k in 0:w.sockets.len {
			if w.sockets[k].id == id {
				last := w.sockets.len - 1
				w.sockets[k] = w.sockets[last]
				w.tags[k] = w.tags[last]
				w.sockets.len = last
				w.tags.len = last
				return
			}
		}
	}

	// Waits until some socket is ready, at most `ms` milliseconds, or -1 as long as
	// it takes, and puts those that are into `ready`, up to its room. The rest stay
	// ready for next time. A socket stays ready until what it's ready for is done.
	// `ready` is empty if the time ran out.
	net_waiter_wait :: fun(w: ^Net_Waiter, ready: ^[]Net_Ready, ms: i64) -> err {
		ready.len = 0
		// (WSAPoll with nothing to wait on is an error, and nothing can come.)
		if w.sockets.len == 0 {
			if ms != 0 do sleep_ms(u32(ms))
			return
		}
		n := WSAPoll(&w.sockets[0], u32(w.sockets.len), i32(ms))
		if n < 0 do return Socket_Failed
		if n == 0 do return
		for k in 0:w.sockets.len {
			got := w.sockets[k].answers
			if got == 0 do continue
			if ready.len == ready.cap do return
			r := Net_Ready{tag = w.tags[k], readable = got & (POLLRDNORM | POLLHUP | POLLERR | POLLNVAL) != 0, writable = got & POLLWRNORM != 0}
			ready ++ r
		}
	}

	// Lets the waiter go. The sockets in it stay open.
	net_waiter_close :: fun(w: ^Net_Waiter) {
		w.sockets.len = 0
		w.tags.len = 0
	}

	// Sends as much of data as the system has room for, without waiting, and gives how
	// many bytes that was: 0 when it has no room. Send the rest when net_waiter_wait
	// says the socket can be written. Fails with Send_Failed once the connection has
	// ended.
	tcp_send_some :: fun(c: ^Tcp_Connection, data: []byte) -> i64, err {
		if data.len == 0 do return 0
		want := data.len
		if want > 1 << 30 do want = 1 << 30
		n := send(c.id, data.ptr, i32(want), 0)
		if n >= 0 do return i64(n)
		if WSAGetLastError() == WSAEWOULDBLOCK do return 0
		return 0, Send_Failed
	}

	// Sends all of data on the connection, waiting while the system has no
	// room for more. Fails with Send_Failed once the connection has ended.
	tcp_send :: fun(c: ^Tcp_Connection, data: []byte) -> err {
		rest := data
		for rest.len > 0 {
			want := rest.len
			if want > 1 << 30 do want = 1 << 30
			n := send(c.id, rest.ptr, i32(want), 0)
			if n > 0 {
				rest = rest[i64(n):.len]
				continue
			}
			if WSAGetLastError() != WSAEWOULDBLOCK do return Send_Failed
			if net_wait(c.id, true, -1) < 0 do return Send_Failed
		}
	}

	// Takes what has arrived on the connection, without waiting for more:
	// data.len becomes the number of bytes, 0 when none has. Returns false
	// once the connection has ended: the other side closed it (and all it
	// sent is read), or it broke.
	tcp_receive :: fun(c: ^Tcp_Connection, data: ^[]byte) -> bool, err {
		data.len = 0
		if data.cap == 0 do return true
		want := data.cap
		if want > 1 << 30 do want = 1 << 30
		data.len = want   // (the system's to fill)
		n := recv(c.id, &data[0], i32(want), 0)
		data.len = 0
		if n > 0 {
			data.len = i64(n)
			return true
		}
		if n == 0 do return false
		e := WSAGetLastError()
		if e == WSAEWOULDBLOCK do return true
		if e == WSAECONNRESET or e == WSAECONNABORTED do return false
		return false, Receive_Failed
	}

	// Closes the connection: the other side's tcp_receive returns false once
	// it has read all this side sent.
	tcp_close :: fun(c: ^Tcp_Connection) {
		if c.id == NO_SOCKET do return
		_ = closesocket(c.id)
		c.id = NO_SOCKET
	}

	// Winsock started, as each socket fun needs it first: true. (Counted,
	// so started again by each; the program's end stops it.)
	net_start :: fun() -> bool {
		data : [512!]byte   // (WSADATA, 408 bytes)
		return WSAStartup(0x0202, &data) == 0
	}

	// A new socket, IPv4 (v4) or IPv6, TCP (SOCK_STREAM) or UDP
	// (SOCK_DGRAM): not waiting — its reads and writes answer at once — and
	// not handed to programs this one starts. NO_SOCKET failing.
	net_socket :: fun(v4: bool, kind: i32) -> File_Id {
		family: i32 = AF_INET6
		if v4 do family = AF_INET
		protocol: i32 = IPPROTO_TCP
		if kind == SOCK_DGRAM do protocol = IPPROTO_UDP
		id := WSASocketA(family, kind, protocol, void, 0, WSA_FLAG_OVERLAPPED | WSA_FLAG_NO_HANDLE_INHERIT)
		if id == NO_SOCKET do return NO_SOCKET
		on: u32 = 1
		if ioctlsocket(id, FIONBIO, &on) != 0 {
			_ = closesocket(id)
			return NO_SOCKET
		}
		return id
	}

	// A socket of the kind given at `at`, listening there if TCP; whether
	// it's IPv4 into v4, the port it has into port. At net_any an IPv6
	// socket takes IPv4 too. Where that fails — no IPv6 on the machine, or
	// an IPv6 socket that won't take IPv4 — an IPv4 one takes it all. (Not
	// when the port is taken: IPv4's may be free, but the port is someone
	// else's.)
	net_bind :: fun(at: Net_Address, kind: i32, v4: ^bool, port: ^u16) -> File_Id, err {
		if not net_start() do return NO_SOCKET, Socket_Failed
		v4^ = net_is_ip4(at)
		id, e := net_bind_as(at, kind, v4^, port)
		if e and e != Port_Taken and not v4^ and net_is_any(at) {
			v4^ = true
			id4, e4 := net_bind_as(at, kind, true, port)
			id = id4
			e = e4
		}
		if e do return NO_SOCKET, e
		return id
	}

	// net_bind's socket, IPv4 (v4) or IPv6: made, bound to `at`, listening
	// if TCP, the port it has into port. At net_any an IPv6 one takes IPv4
	// too, or fails.
	net_bind_as :: fun(at: Net_Address, kind: i32, v4: bool, port: ^u16) -> File_Id, err {
		id := net_socket(v4, kind)
		if id == NO_SOCKET do return NO_SOCKET, Socket_Failed
		if not v4 and net_is_any(at) {
			off: u32 = 0   // (IPv4 too, as ::ffff:a.b.c.d)
			if setsockopt(id, IPPROTO_IPV6, IPV6_V6ONLY, &off, 4) != 0 {
				_ = closesocket(id)
				return NO_SOCKET, Socket_Failed
			}
		}
		sa := Sockaddr()
		size := sockaddr_of(at, v4, &sa)
		if bind(id, &sa, i32(size)) != 0 {
			taken := WSAGetLastError() == WSAEADDRINUSE
			_ = closesocket(id)
			if taken do return NO_SOCKET, Port_Taken
			return NO_SOCKET, Socket_Failed
		}
		if kind == SOCK_STREAM and listen(id, SOMAXCONN) != 0 {
			_ = closesocket(id)
			return NO_SOCKET, Socket_Failed
		}
		mine := Sockaddr()
		mine_size: i32 = i32(size_of(Sockaddr))
		if getsockname(id, &mine, &mine_size) != 0 {
			_ = closesocket(id)
			return NO_SOCKET, Socket_Failed
		}
		port^ = address_of(&mine).port
		return id
	}

	// Waits up to `ms` milliseconds for the connect under way: true once
	// connected.
	net_connected :: fun(id: File_Id, ms: i64) -> bool {
		if net_wait(id, true, ms) <= 0 do return false
		problem: i32 = 0
		size: i32 = 4
		if getsockopt(id, SOL_SOCKET, SO_ERROR, &problem, &size) != 0 do return false
		return problem == 0
	}

	// Waits until the socket can be written to (`writing`) or read from, or
	// has failed, at most `ms` milliseconds — -1, as long as it takes: above
	// 0 then, 0 when the time ran out, below 0 failing.
	net_wait :: fun(id: File_Id, writing: bool, ms: i64) -> i32 {
		ready := Fd_Set{count = 1, socket = id}
		failed := Fd_Set{count = 1, socket = id}   // (a connect that failed shows here)
		if ms < 0 {
			if writing do return select(0, void, &ready, &failed, void)
			return select(0, &ready, void, &failed, void)
		}
		time := Timeval{seconds = i32(ms / 1000), microseconds = i32(ms % 1000 * 1000)}
		if writing do return select(0, void, &ready, &failed, &time)
		return select(0, &ready, void, &failed, &time)
	}

	// Sends what's written at once, not holding small writes back to join
	// them (Nagle's wait): a game's messages are small, and late is worse.
	net_no_delay :: fun(id: File_Id) {
		on: u32 = 1
		_ = setsockopt(id, IPPROTO_TCP, TCP_NODELAY, &on, 4)
	}

	// Whether the address is net_any's: every address of this machine.
	net_is_any :: fun(a: Net_Address) -> bool {
		for k in 0:16 {
			if a.ip[k] != 0 do return false
		}
		return true
	}

	// getaddrinfo's answers, a list: each an address the name has. (hints:
	// which are wanted.)
	Addrinfo :: struct {
		flags:    i32
		family:   i32
		kind:     i32
		protocol: i32
		size:     usize      // at's
		name:     ^byte      // (the canonical name, asked for)
		at:       ^Sockaddr
		next:     ^Addrinfo
	}

	// getaddrinfo's question, Addrinfo's layout: which answers are wanted,
	// its pointers 0.
	Addrinfo_Hints :: struct {
		flags:    i32 = 0
		family:   i32 = 0   // (0: any)
		kind:     i32 = 0
		protocol: i32 = 0
		size:     usize = 0
		pointers: [3!]u64 = {0, 0, 0}
	}

	// select's sockets, room for one: how many, then the sockets.
	Fd_Set :: struct {
		count:  u32
		socket: File_Id
	}

	// select's longest wait.
	Timeval :: struct {
		seconds:      i32
		microseconds: i32
	}

	AF_INET                    :: 2
	AF_INET6                   :: 23
	SOCK_STREAM                :: 1
	SOCK_DGRAM                 :: 2
	IPPROTO_TCP                :: 6
	IPPROTO_UDP                :: 17
	IPPROTO_IPV6               :: 41
	IPV6_V6ONLY                :: 27
	TCP_NODELAY                :: 1
	SOL_SOCKET                 :: 0xFFFF
	SO_ERROR                   :: 0x1007
	SOMAXCONN                  :: 0x7FFFFFFF   // (the longest queue the system allows)
	FIONBIO                    :: 0x8004667E   // (ioctlsocket: not waiting)
	WSA_FLAG_OVERLAPPED        :: 0x01
	WSA_FLAG_NO_HANDLE_INHERIT :: 0x80
	WSAEWOULDBLOCK             :: 10035
	WSAEMSGSIZE                :: 10040
	WSAEADDRINUSE              :: 10048
	WSAENETRESET               :: 10052
	WSAECONNABORTED            :: 10053
	WSAECONNRESET              :: 10054

	foreign static_lib "kernel32" {
		fun RtlMoveMemory(to: ^byte, from: ^byte, size: usize)
	}

	// Winsock (ws2_32.dll). A SOCKET is pointer-sized, bound as File_Id:
	// INVALID_SOCKET is NO_SOCKET, -1. Sizes are i32 (int); a fun failing
	// returns -1 (SOCKET_ERROR), WSAGetLastError saying why.
	foreign static_lib "ws2_32" {
		fun WSAStartup(version: u16, data: ^byte) -> i32
		fun WSAGetLastError() -> i32
		fun WSASocketA(family: i32, kind: i32, protocol: i32, info: ^byte, group: u32, flags: u32) -> File_Id
		fun closesocket(s: File_Id) -> i32
		fun ioctlsocket(s: File_Id, command: u32, arg: ^u32) -> i32
		fun setsockopt(s: File_Id, level: i32, name: i32, value: ^byte, size: i32) -> i32
		fun getsockopt(s: File_Id, level: i32, name: i32, value: ^byte, size: ^i32) -> i32
		fun bind(s: File_Id, at: ^Sockaddr, size: i32) -> i32
		fun listen(s: File_Id, backlog: i32) -> i32
		fun accept(s: File_Id, at: ^Sockaddr, size: ^i32) -> File_Id
		fun connect(s: File_Id, at: ^Sockaddr, size: i32) -> i32
		fun getsockname(s: File_Id, at: ^Sockaddr, size: ^i32) -> i32
		fun send(s: File_Id, data: ^byte, size: i32, flags: i32) -> i32
		fun recv(s: File_Id, data: ^byte, size: i32, flags: i32) -> i32
		fun sendto(s: File_Id, data: ^byte, size: i32, flags: i32, to: ^Sockaddr, to_size: i32) -> i32
		fun recvfrom(s: File_Id, data: ^byte, size: i32, flags: i32, from: ^Sockaddr, from_size: ^i32) -> i32
		fun WSAPoll(sockets: ^Wsa_Poll_Fd, count: u32, ms: i32) -> i32
		fun select(ignored: i32, read: ^Fd_Set, write: ^Fd_Set, failed: ^Fd_Set, wait: ^Timeval) -> i32
		fun getaddrinfo(name: cstring, service: ^byte, hints: ^Addrinfo_Hints, found: ^^Addrinfo) -> i32
		fun freeaddrinfo(found: ^Addrinfo)
	}
}
