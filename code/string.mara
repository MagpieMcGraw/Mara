module mara.string

use mara.os

string :: type [..128]utf8
cstring :: type [..128, 0]utf8

// string :: struct (n := 128 ) {
// 	[..n]utf8
// }

overload + add
add :: dispatch {
	add_string
	add_cstring
}

// Append all elements from a slice in place.
add_string :: fun(dst: ^string, src: string) {
	dst[dst.len:] = src
	dst.len += src.len
}

add_cstring :: fun(dst: ^string, src: ^byte) {
	dst + os.read_cstring(dst.cap, src)
}