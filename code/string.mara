module mara.string

use mara.os

String :: type [..128, 0]utf8

overload + add
add :: dispatch {
	add_string
	add_cstring
}

// Append all elements from a slice in place.
add_string :: fun(dst: ^String, src: String) {
	dst[dst.len:] = src
	dst.len += src.len
}

add_cstring :: fun(dst: ^String, src: ^byte) {
	dst + os.read_cstring(dst.cap, src)
}