module mara.string

use mara.os

str :: type [..128]utf8
cstr :: type [..128, 0]utf8

// str :: struct (n := 128 ) {
// 	[..n]utf8
// }

overload + add
add :: dispatch {
	add_str
	add_cstr
}

// Append all elements from a slice in place.
add_str :: fun(dst: ^str, src: str) {
	dst[dst.len:] = src
	dst.len += src.len
}

add_cstr :: fun(dst: ^str, src: ^byte) {
	dst + os.read_cstring(dst.cap, src)
}