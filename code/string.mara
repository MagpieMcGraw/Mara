module mara.string

use mara.core

// (cstring lives in mara.core — it's the FFI boundary type, not a string op.)

// Find the first occurrence of `needle` in `haystack`. Returns (offset, true)
// on match, (-1, false) when not present. Naive O(n*m) search — fine for
// typical use (shader source < 100KB, directives a handful of bytes); swap
// for KMP/Boyer-Moore later if it ever matters.
find :: fun(haystack: []utf8, needle: []utf8, start: i64 = 0) -> i64, bool {
	if needle.len == 0 do return 0, true
	if haystack.len < needle.len do return -1, false

	end := haystack.len - needle.len + 1
	for i in start:end {
		matched := true
		for j in 0:needle.len {
			if haystack[i + j] != needle[j] {
				matched = false
				break
			}
		}
		if matched do return i, true
	}
	return -1, false
}

// Single-byte variant of find — cheap, no inner loop. Useful for locating
// quotes, newlines, separators in shader source / paths / error parsing.
find_byte :: fun(s: []utf8, b: utf8) -> i64, bool {
	for c, i in s {
		if c == b do return i, true
	}
	return -1, false
}

// s cut at its first sep: the text before it, the text after it, true. When
// s has no sep: s, an empty text, false. Takes a text apart a piece at a
// time: `line, rest, _ = cut(rest, '\n')` while rest.len > 0.
cut :: fun(s: []utf8, sep: utf8) -> []utf8, []utf8, bool {
	for c, i in s {
		if c == sep do return s[0:i], s[i + 1:], true
	}
	return s, s[s.len:], false
}

// The piece of s from at up to the next sep or the end, with at moved past
// that sep; false once at is past the end. A loop over the pieces, the last
// one too: `at := 0` then `for word in pieces(line, &at, ' ')`. Two seps in a
// row give an empty piece; a sep at the end gives none after it.
pieces :: fun(s: []utf8, at: ^i64, sep: utf8) -> []utf8, bool {
	start := at^
	if start >= s.len do return s[s.len:], false
	end := start
	for end < s.len and s[end] != sep do end += 1
	at = end + 1
	return s[start:end], true
}

// True if `s` begins with `prefix`. Cheaper than full find when you only
// care about the head of the string (`#include`, `#version`, etc.).
starts_with :: fun(s: []utf8, prefix: []utf8) -> bool {
	if s.len < prefix.len do return false
	for i in 0:prefix.len {
		if s[i] != prefix[i] do return false
	}
	return true
}

// Whether s ends with `suffix` — a file's extension, say: ends_with(name, ".mara").
ends_with :: fun(s: []utf8, suffix: []utf8) -> bool {
	if s.len < suffix.len do return false
	return s[s.len - suffix.len : s.len] == suffix
}

// Whether s has `what` anywhere in it.
contains :: fun(s: []utf8, what: []utf8) -> bool {
	for k in 0..s.len - what.len {
		if s[k : k + what.len] == what do return true
	}
	return false
}

// Whether s has `what` anywhere in it, letters' case not minded: A to Z as a to z.
contains_folded :: fun(s: []utf8, what: []utf8) -> bool {
	for k in 0..s.len - what.len {
		same := true
		for i in 0:what.len {
			if lower(s[k + i]) != lower(what[i]) {
				same = false
				break
			}
		}
		if same do return true
	}
	return false
}

// The text without the spaces, tabs and line ends at its start and its end.
trimmed :: fun(s: []utf8) -> []utf8 {
	a : i64 = 0
	b := s.len
	for a < b {
		if s[a] != ' ' and s[a] != '\t' and s[a] != '\r' and s[a] != '\n' do break
		a += 1
	}
	for b > a {
		if s[b - 1] != ' ' and s[b - 1] != '\t' and s[b - 1] != '\r' and s[b - 1] != '\n' do break
		b -= 1
	}
	return s[a : b]
}

// Where the spaces and tabs from s[k] end: k itself when there are none.
skip_spaces :: fun(s: []utf8, k: i64) -> i64 {
	at := k
	for at < s.len {
		if s[at] != ' ' and s[at] != '\t' do break
		at += 1
	}
	return at
}

// Where the line from `at` ends: at its '\n', or at the text's end. Step
// through a text's lines with it: the next starts at end + 1.
// (A '\r' before the '\n' is the line's last character.)
line_end :: fun(text: []utf8, at: i64) -> i64 {
	end := at
	for end < text.len {
		if text[end] == '\n' do break
		end += 1
	}
	return end
}

// A letter in lower case (A to Z); any other character as it is.
lower :: fun(ch: utf8) -> utf8 {
	if ch >= 'A' and ch <= 'Z' do return utf8(i64(ch) + 32)
	return ch
}

// A letter in upper case (a to z); any other character as it is.
upper :: fun(ch: utf8) -> utf8 {
	if ch >= 'a' and ch <= 'z' do return utf8(i64(ch) - 32)
	return ch
}

// The character at s[at] — its code point, UTF-8 decoded — and how many
// bytes it takes. Step through a text's characters with it: at += n.
// (A byte that doesn't begin one, or one cut off at the text's end: U+FFFD,
// and the bytes it has.)
char_at :: fun(s: []utf8, at: i64) -> u32, i64 {
	b := u32(s[at])
	if b < 0x80 do return b, 1
	n : i64 = 0
	c : u32 = 0
	if b >= 0xF0 {
		n = 4
		c = b & 0x07
	elif b >= 0xE0
		n = 3
		c = b & 0x0F
	elif b >= 0xC0
		n = 2
		c = b & 0x1F
	else
		return u32(0xFFFD), 1
	}
	if at + n > s.len do return u32(0xFFFD), s.len - at
	for k in 1:n {
		c = (c << 6) | (u32(s[at + k]) & 0x3F)
	}
	return c, n
}

// Which of two texts comes first, for sorting: -1 a, 0 the same, 1 b. Byte
// by byte; a text that is the start of the other comes first.
compare :: fun(a: []utf8, b: []utf8) -> i64 {
	n := a.len
	if b.len < n do n = b.len
	for i in 0:n {
		if a[i] < b[i] do return -1
		if a[i] > b[i] do return 1
	}
	if a.len < b.len do return -1
	if a.len > b.len do return 1
	return 0
}

// Which of two texts comes first (see compare), letters' case not minded:
// A to Z as a to z.
compare_folded :: fun(a: []utf8, b: []utf8) -> i64 {
	n := a.len
	if b.len < n do n = b.len
	for i in 0:n {
		ca := lower(a[i])
		cb := lower(b[i])
		if ca < cb do return -1
		if ca > cb do return 1
	}
	if a.len < b.len do return -1
	if a.len > b.len do return 1
	return 0
}

// The number a text spells — digits, maybe a point and more digits, maybe a
// '-' first, maybe an exponent last ("e-8", "E+3") — and whether it is one:
// false when anything else is in it, or it has no digit before its exponent
// or none in it. ("12", "-0.5", "3.", ".5" and "-6.24607e-008" are; "1e",
// "e3" and "+1" aren't.) It's always the nearest f64, an exact tie going to the even
// one, however many digits there are: too big gives infinity, too small 0. Up to 15
// digits and a power of ten to 22 are quick, and more take a few microseconds.
parse_number :: fun(s: []utf8) -> f64, bool {
	i : i64 = 0
	negative := false
	if s.len > 0 and s[0] == '-' {
		negative = true
		i = 1
	}
	first_digit := i
	// (The digits as one whole number, its first 18 that count; the point's
	// place, and digits before it past those 18, move the power of ten.)
	whole : i64 = 0
	kept := 0
	digits := 0
	power : i64 = 0
	point := false
	for i < s.len {
		if s[i] == '.' and not point {
			point = true
			i += 1
			continue
		}
		d := i64(s[i]) - i64('0')
		if d < 0 or d > 9 do break
		if kept < 18 {
			whole = whole * 10 + d
			if whole > 0 do kept += 1
			if point do power -= 1
		elif not point
			power += 1
		}
		digits += 1
		i += 1
	}
	last_digit := i
	written : i64 = 0
	if digits > 0 and i < s.len and (s[i] == 'e' or s[i] == 'E') {
		i += 1
		minus := false
		if i < s.len and (s[i] == '-' or s[i] == '+') {
			minus = s[i] == '-'
			i += 1
		}
		e : i64 = 0
		e_digits := 0
		for i < s.len {
			d := i64(s[i]) - i64('0')
			if d < 0 or d > 9 do break
			if e < 100000 do e = e * 10 + d
			e_digits += 1
			i += 1
		}
		if e_digits == 0 do return 0, false
		if minus do e = -e
		power += e
		written = e
	}
	v : f64 = 0
	if kept <= 15 and power >= -22 and power <= 22 {
		// (Up to 15 digits are exactly an f64, and so is a power of ten to 22: one multiply
		// or divide of exact numbers, rounded once, is the nearest.)
		ten : f64 = 1
		steps := power
		if steps < 0 do steps = -steps
		for k in 0:steps {
			ten *= 10.0
		}
		v = f64(whole)
		if power < 0 {
			v /= ten
		else
			v *= ten
		}
	elif digits > 0
		v = parse_number_exact(s[first_digit:last_digit], written)
	}
	if negative do v = -v
	return v, digits > 0 and i == s.len
}

// The f64 nearest to digits (with maybe a point among them) times 10^exponent, worked out
// in whole numbers so nothing rounds along the way. Past 768 digits nothing can change the
// answer but whether any of them isn't 0.
parse_number_exact :: fun(digits: []utf8, exponent: i64) -> f64 {
	from_bits :: fun(bits: u64) -> f64 { @llvm.bitcast.i64 }
	INFINITE : u64 = 0x7FF0000000000000

	// (A whole number in pieces of 32 bits, smallest first. The largest needed is a 768-digit
	// value's division by 10^1113, shifted to keep 66 bits: about 3,764 bits.)
	big : [128!]u32
	used : i64 = 0

	// big = big * by + extra.
	times :: fun(big: ^[128!]u32, used: ^i64, by: u64, extra: u64) {
		carry := extra
		for k in 0:used^ {
			n := u64(big[k]) * by + carry
			big[k] = u32(n & 0xFFFFFFFF)
			carry = n >> 32
		}
		if carry != 0 {
			big[used^] = u32(carry)
			used^ += 1
		}
	}

	// The digits into big: the 768 that count, nine at a time.
	kept : i64 = 0
	power := exponent
	chunk : u64 = 0
	chunk_size : u64 = 1
	past_point := false
	rest_nonzero := false
	for c in digits {
		if c == '.' {
			past_point = true
			continue
		}
		d := u64(i64(c) - i64('0'))
		if kept == 0 and d == 0 {
			if past_point do power -= 1
			continue
		}
		if kept == 768 {
			if d != 0 do rest_nonzero = true
			if not past_point do power += 1
			continue
		}
		kept += 1
		if past_point do power -= 1
		chunk = chunk * 10 + d
		chunk_size *= 10
		if chunk_size == 1000000000 {
			times(&big, &used, chunk_size, chunk)
			chunk = 0
			chunk_size = 1
		}
	}
	if chunk_size > 1 do times(&big, &used, chunk_size, chunk)
	if kept == 0 do return 0

	// (The value is under 10^(kept + power) and at least a tenth of that.)
	if kept + power > 310 do return from_bits(INFINITE)
	if kept + power < -345 do return 0

	// Multiplied by 10^power, or divided by 10^-power with enough bits shifted in first to
	// keep 66 of the answer. shift says how many: the value is big / 2^shift.
	shift : i64 = 0
	if power > 0 {
		left := power
		for left > 0 {
			step : i64 = 9
			if left < step do step = left
			by : u64 = 1
			for k in 0:step do by *= 10
			times(&big, &used, by, 0)
			left -= step
		}
	elif power < 0
		// (10^q has about q * 3.322 bits.)
		q := -power
		bits_now := (used - 1) * 32
		for top := big[used - 1]; top != 0; top = top >> 1 do bits_now += 1
		want := q * 3322 / 1000 + 2 + 66
		if want > bits_now do shift = want - bits_now
		whole_limbs := shift / 32
		part := u64(shift % 32)
		if part != 0 do times(&big, &used, u64(1) << part, 0)
		if whole_limbs > 0 {
			k := used - 1
			for k >= 0 {
				big[k + whole_limbs] = big[k]
				k -= 1
			}
			for j in 0:whole_limbs do big[j] = 0
			used += whole_limbs
		}
		left := q
		for left > 0 {
			step : i64 = 9
			if left < step do step = left
			by : u64 = 1
			for k in 0:step do by *= 10
			remainder : u64 = 0
			k := used - 1
			for k >= 0 {
				n := (remainder << 32) | u64(big[k])
				big[k] = u32(n / by)
				remainder = n % by
				k -= 1
			}
			if remainder != 0 do rest_nonzero = true
			for used > 0 and big[used - 1] == 0 do used -= 1
			left -= step
		}
	}

	// Its bits: how many, and so where the value is between powers of two.
	if used == 0 do return 0
	length := (used - 1) * 32
	for top := big[used - 1]; top != 0; top = top >> 1 do length += 1
	binary := length - 1 - shift
	if binary > 1023 do return from_bits(INFINITE)

	// An f64 keeps 53 bits, and fewer once it's too small for an exponent of its own.
	keep : i64 = 53
	if binary < -1022 do keep = 53 - (-1022 - binary)
	if keep < 0 do return 0

	bit_at :: fun(big: ^[128!]u32, at: i64) -> u64 {
		return (u64(big[at / 32]) >> u64(at % 32)) & 1
	}
	mantissa : u64 = 0
	dropped := length - keep
	k := length - 1
	for k >= 0 and k >= dropped {
		mantissa = (mantissa << 1) | bit_at(&big, k)
		k -= 1
	}
	if dropped < 0 do mantissa = mantissa << u64(-dropped)
	if dropped > 0 {
		// (Rounded to the nearest, a tie to the even one: the bit just below decides, and
		// then whether anything at all is below that.)
		below := rest_nonzero
		for j in 0:dropped - 1 {
			if bit_at(&big, j) != 0 do below = true
		}
		if bit_at(&big, dropped - 1) != 0 and (below or mantissa & 1 != 0) do mantissa += 1
	}
	if binary < -1022 {
		// (No exponent: a carry out of the top makes it the smallest with one, by itself.)
		return from_bits(mantissa)
	}
	if mantissa == u64(1) << 53 {
		mantissa = mantissa >> 1
		binary += 1
		if binary > 1023 do return from_bits(INFINITE)
	}
	return from_bits((u64(binary + 1023) << 52) | (mantissa & 0xFFFFFFFFFFFFF))
}

// A whole number as text: its digits, a '-' first when it's below 0.
int_text :: fun(n: i64) -> str64 {
	backwards : [24]utf8
	v := n
	for true {
		// (Each digit off v's end without negating v: -v doesn't fit for the
		// smallest i64.)
		d := v % 10
		if d < 0 do d = -d
		&backwards ++ utf8(i64('0') + d)
		v /= 10
		if v == 0 do break
	}
	out : str64
	if n < 0 do &out ++ '-'
	for i in 0:backwards.len {
		&out ++ backwards[backwards.len - 1 - i]
	}
	return out
}

// A float as text. Without decimals it reads as print shows it: up to 6
// significant digits, no zeros at the end, and an exponent for very big and
// very small numbers ("16.6667", "0.5", "1e+06"). With decimals it has that
// many digits after the point: 16.6667 with 2 is "16.67", 2.0 with 1 is "2.0".
// A number too long for a str64 that way is written as print shows it. It
// rounds to the nearest digit, and an exact half to the even one, as print
// does: 2.5 with 0 is "2". A bare literal fits both kinds of float, so give
// it one: `float_text(f64(2.5))`.
float_text :: dispatch {
	float_text_f32
	float_text_f64
}
float_text_f32 :: fun(x: f32, decimals: i64 = -1) -> str64 { return float_text_f64(f64(x), decimals) }
float_text_f64 :: fun(x: f64, decimals: i64 = -1) -> str64 {
	bits_of :: fun(v: f64) -> u64 { @llvm.bitcast.f64 }
	// (A digit of the number the limbs spell, 9 digits to a limb, biggest
	// first. Off either end it's 0.)
	digit :: fun(limbs: []u32, k: i64) -> i64 {
		if k < 0 or k >= limbs.len * 9 do return 0
		v := i64(limbs[k / 9])
		for i in k % 9:8 {
			v /= 10
		}
		return v % 10
	}
	// (The digits from `from` up to `end`, rounded at end, with one more digit
	// first: '0', unless the rounding carried into it.)
	rounded :: fun(limbs: []u32, from: i64, end: i64) -> str64 {
		kept : str64
		&kept ++ '0'
		for k in from:end {
			&kept ++ utf8(i64('0') + digit(limbs, k))
		}
		after := digit(limbs, end)
		up := after > 5
		if after == 5 {
			up = digit(limbs, end - 1) % 2 == 1
			for k in end + 1:limbs.len * 9 {
				if digit(limbs, k) != 0 do up = true
			}
		}
		at := kept.len - 1
		for up {
			if kept[at] == '9' {
				kept[at] = '0'
				at -= 1
			else
				kept[at] = kept[at] + 1
				up = false
			}
		}
		return kept
	}

	out : str64
	bits := bits_of(x)
	power := i64((bits >> 52) & 0x7FF)
	mantissa := bits & 0xFFFFFFFFFFFFF
	if power == 0x7FF and mantissa != 0 {
		&out ++ "nan"
		return out
	}
	if bits >> 63 != 0 do &out ++ '-'
	if power == 0x7FF {
		&out ++ "inf"
		return out
	}
	// (x is mantissa * 2^power.)
	if power == 0 {
		power = 1
	else
		mantissa = mantissa | (u64(1) << 52)
	}
	power -= 1075

	// Its exact digits, 9 to a limb: limb UNITS ends at the point, those before
	// it are bigger, those after it come after the point. The biggest f64 has
	// 309 digits before the point, the smallest 1074 after it.
	UNITS :: 36
	limbs : [160!]u32
	first := UNITS - 1
	last := UNITS + 1
	limbs[first] = u32(mantissa / 1000000000)
	limbs[UNITS] = u32(mantissa % 1000000000)
	for power > 0 {
		step : i64 = 29
		if power < step do step = power
		carry : u64 = 0
		i := last - 1
		for i >= first {
			v := (u64(limbs[i]) << u64(step)) + carry
			limbs[i] = u32(v % 1000000000)
			carry = v / 1000000000
			i -= 1
		}
		if carry != 0 {
			first -= 1
			limbs[first] = u32(carry)
		}
		power -= step
	}
	for power < 0 {
		step : i64 = 9
		if -power < step do step = -power
		// (1000000000 is 512 times a whole number, so halving it 9 times stays exact.)
		part := u64(1000000000) >> u64(step)
		carry : u64 = 0
		for i in first:last {
			v := u64(limbs[i])
			limbs[i] = u32((v >> u64(step)) + carry)
			carry = (v & ((u64(1) << u64(step)) - 1)) * part
		}
		if carry != 0 {
			limbs[last] = u32(carry)
			last += 1
		}
		for first < last - 1 and limbs[first] == 0 {
			first += 1
		}
		power += step
	}

	// (digits[k] is limbs' k-th digit. `point` of them come before the point,
	// and `lead` is the first that isn't 0; a 0's is its units digit.)
	digits := limbs[first:last]
	point := (UNITS + 1 - first) * 9
	lead := 0
	for lead < digits.len * 9 and digit(digits, lead) == 0 {
		lead += 1
	}
	if lead == digits.len * 9 do lead = point - 1
	exponent := point - 1 - lead

	whole := 1
	if exponent > 0 do whole = exponent + 1
	if decimals >= 0 and whole + decimals + 3 <= out.cap {
		from := lead
		if point - 1 < from do from = point - 1
		kept := rounded(digits, from, point + decimals)
		start := 1
		if kept[0] != '0' do start = 0
		end := 1 + point - from
		&out ++ kept[start:end]
		if decimals > 0 {
			&out ++ '.'
			&out ++ kept[end:kept.len]
		}
		return out
	}

	kept := rounded(digits, lead, lead + 6)
	start := 1
	if kept[0] != '0' {
		start = 0
		exponent += 1
	}
	shown := kept[start:start + 6]
	n := shown.len
	for n > 1 and shown[n - 1] == '0' {
		n -= 1
	}
	if exponent < -4 or exponent >= 6 {
		&out ++ shown[0]
		if n > 1 {
			&out ++ '.'
			&out ++ shown[1:n]
		}
		&out ++ 'e'
		power_of_ten := exponent
		if exponent < 0 {
			&out ++ '-'
			power_of_ten = -exponent
		else
			&out ++ '+'
		}
		if power_of_ten < 10 do &out ++ '0'
		&out ++ int_text(power_of_ten)
	elif exponent >= 0
		&out ++ shown[0:exponent + 1]
		if n > exponent + 1 {
			&out ++ '.'
			&out ++ shown[exponent + 1:n]
		}
	else
		&out ++ "0."
		for k in 0:-exponent - 1 {
			&out ++ '0'
		}
		&out ++ shown[0:n]
	}
	return out
}