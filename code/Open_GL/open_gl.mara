module mara.open_gl

// ---------------------------------------------------------------------------
// OpenGL constants — split into typed enums per semantic group
// ---------------------------------------------------------------------------

GL_Type :: union(tag u32) {
    BYTE           = 5120
    UNSIGNED_BYTE  = 5121
    SHORT          = 5122
    UNSIGNED_SHORT = 5123
    INT            = 5124
    UNSIGNED_INT   = 5125
    FLOAT          = 5126
    DOUBLE         = 5130
    HALF_FLOAT        = 5131    // 0x140B
    UNSIGNED_INT_24_8 = 34042   // 0x84FA, a DEPTH24_STENCIL8 texel
}

GL_Draw_Mode :: union(tag u32) {
    POINTS         = 0
    LINES          = 1
    LINE_LOOP      = 2
    LINE_STRIP     = 3
    TRIANGLES      = 4
    TRIANGLE_STRIP = 5
    TRIANGLE_FAN   = 6
}

// What BindBuffer binds a buffer as. A shader storage buffer (GL 4.3) and a
// uniform buffer are read by shaders at a numbered binding: BindBufferBase
// puts one there, `layout(std430, binding = 0) buffer ...` reads it.
GL_Buffer_Target :: union(tag u32) {
    ARRAY_BUFFER          = 34962
    ELEMENT_ARRAY_BUFFER  = 34963
    DRAW_INDIRECT_BUFFER  = 36671
    UNIFORM_BUFFER        = 35345   // 0x8A11
    SHADER_STORAGE_BUFFER = 37074   // 0x90D2
}

GL_Buffer_Usage :: union(tag u32) {
    STREAM_DRAW  = 35040
    STATIC_DRAW  = 35044
    DYNAMIC_DRAW = 35048
}

GL_Clear_Mask :: union(tag u32) {
    DEPTH_BUFFER_BIT   = 256
    STENCIL_BUFFER_BIT = 1024
    COLOR_BUFFER_BIT   = 16384
}

// What Enable turns on. CLIP_DISTANCE0 and 1 clip by gl_ClipDistance[0]
// and [1], which the vertex shader writes: a planar reflection drawn only
// above its plane.
GL_Capability :: union(tag u32) {
    DEPTH_TEST    = 2929
    CULL_FACE     = 2884
    BLEND         = 3042
    SCISSOR_TEST  = 3089
    CLIP_DISTANCE0            = 12288   // 0x3000
    CLIP_DISTANCE1            = 12289   // 0x3001
    TEXTURE_CUBE_MAP_SEAMLESS = 34895   // 0x884F
    FRAMEBUFFER_SRGB          = 36281   // 0x8DB9
}

GL_Blend_Factor :: union(tag u32) {
    ZERO                = 0
    ONE                 = 1
    SRC_ALPHA           = 770
    ONE_MINUS_SRC_ALPHA = 771
}

// A cube map is bound as TEXTURE_CUBE_MAP; each face is filled, or
// attached to a framebuffer, as its own target.
GL_Texture_Target :: union(tag u32) {
    TEXTURE_2D       = 3553
    TEXTURE_2D_ARRAY = 35866
    TEXTURE_CUBE_MAP            = 34067   // 0x8513
    TEXTURE_CUBE_MAP_POSITIVE_X = 34069   // 0x8515
    TEXTURE_CUBE_MAP_NEGATIVE_X = 34070
    TEXTURE_CUBE_MAP_POSITIVE_Y = 34071
    TEXTURE_CUBE_MAP_NEGATIVE_Y = 34072
    TEXTURE_CUBE_MAP_POSITIVE_Z = 34073
    TEXTURE_CUBE_MAP_NEGATIVE_Z = 34074   // 0x851A
}

// The texture units ActiveTexture picks, all 32 GL can name (a driver has
// at least 16 for fragment shaders; GetIntegerv's MAX_TEXTURE_IMAGE_UNITS
// says how many).
GL_Texture_Unit :: union(tag u32) {
    TEXTURE0  = 33984
    TEXTURE1  = 33985
    TEXTURE2  = 33986
    TEXTURE3  = 33987
    TEXTURE4  = 33988
    TEXTURE5  = 33989
    TEXTURE6  = 33990
    TEXTURE7  = 33991
    TEXTURE8  = 33992
    TEXTURE9  = 33993
    TEXTURE10 = 33994
    TEXTURE11 = 33995
    TEXTURE12 = 33996
    TEXTURE13 = 33997
    TEXTURE14 = 33998
    TEXTURE15 = 33999
    TEXTURE16 = 34000
    TEXTURE17 = 34001
    TEXTURE18 = 34002
    TEXTURE19 = 34003
    TEXTURE20 = 34004
    TEXTURE21 = 34005
    TEXTURE22 = 34006
    TEXTURE23 = 34007
    TEXTURE24 = 34008
    TEXTURE25 = 34009
    TEXTURE26 = 34010
    TEXTURE27 = 34011
    TEXTURE28 = 34012
    TEXTURE29 = 34013
    TEXTURE30 = 34014
    TEXTURE31 = 34015
}

// TexParameteri's parameters (TexParameterf's for the anisotropy and the
// LOD bias, both floats). TEXTURE_BASE_LEVEL and TEXTURE_MAX_LEVEL bound the
// mip levels sampled: a texture whose chain stops short sets its last one as
// TEXTURE_MAX_LEVEL. TEXTURE_MAX_ANISOTROPY (GL 4.6, and the EXT extension
// before it) sharpens textures seen at a shallow angle: up to what
// GetFloatv's MAX_TEXTURE_MAX_ANISOTROPY says, 16 on most drivers.
GL_Tex_Param :: union(tag u32) {
    TEXTURE_MIN_FILTER     = 10241
    TEXTURE_MAG_FILTER     = 10240
    TEXTURE_WRAP_S         = 10242
    TEXTURE_WRAP_T         = 10243
    TEXTURE_WRAP_R         = 32882   // 0x8072
    TEXTURE_MIN_LOD        = 33082   // 0x813A
    TEXTURE_MAX_LOD        = 33083   // 0x813B
    TEXTURE_BASE_LEVEL     = 33084   // 0x813C
    TEXTURE_MAX_LEVEL      = 33085   // 0x813D
    TEXTURE_MAX_ANISOTROPY = 34046   // 0x84FE
    TEXTURE_LOD_BIAS       = 34049   // 0x8501
}

GL_Tex_Filter :: union(tag u32) {
    NEAREST                = 9728
    LINEAR                 = 9729
    NEAREST_MIPMAP_NEAREST = 9984
    LINEAR_MIPMAP_NEAREST  = 9985
    NEAREST_MIPMAP_LINEAR  = 9986
    LINEAR_MIPMAP_LINEAR   = 9987
}

GL_Tex_Wrap :: union(tag u32) {
    CLAMP_TO_EDGE   = 33071
    REPEAT          = 10497
    MIRRORED_REPEAT = 33648   // 0x8370
}

// A texture's pixel formats: the layout of the pixels handed in (RED, RG,
// RGB, RGBA, DEPTH_COMPONENT, DEPTH_STENCIL — TexImage2D's `format`), and the
// sized ones textures and renderbuffers are made of (TexImage2D's
// `internalformat`, as a number: `i32(gl.RGBA16F)`). A framebuffer's depth
// texture is DEPTH_COMPONENT24 or 32F, read as DEPTH_COMPONENT with FLOAT;
// RGBA16F and R11F_G11F_B10F hold colors past 1, for HDR.
GL_Tex_Format :: union(tag u32) {
    RED   = 6403
    RGB   = 6407
    RGBA  = 6408
    RGBA8 = 32856
    RGB8  = 32849
    R8    = 33321
    RG              = 33319   // 0x8227
    DEPTH_COMPONENT = 6402    // 0x1902
    DEPTH_STENCIL   = 34041   // 0x84F9
    SRGB8_ALPHA8       = 35907   // 0x8C43
    R16F               = 33325   // 0x822D
    R32F               = 33326   // 0x822E
    RG16F              = 33327   // 0x822F
    RGBA32F            = 34836   // 0x8814
    RGBA16F            = 34842   // 0x881A
    RGB16F             = 34843   // 0x881B
    R11F_G11F_B10F     = 35898   // 0x8C3A
    DEPTH_COMPONENT16  = 33189   // 0x81A5
    DEPTH_COMPONENT24  = 33190   // 0x81A6
    DEPTH_COMPONENT32F = 36012   // 0x8CAC
    DEPTH24_STENCIL8   = 35056   // 0x88F0
}

// Block-compressed texture formats, S3TC (DXT): what DDS textures hold.
// Uploaded with CompressedTexImage2D, a mip level at a time.
GL_Compressed_Format :: union(tag u32) {
    RGB_S3TC_DXT1  = 33776   // 0x83F0
    RGBA_S3TC_DXT1 = 33777   // 0x83F1
    RGBA_S3TC_DXT3 = 33778   // 0x83F2
    RGBA_S3TC_DXT5 = 33779   // 0x83F3
}

GL_Shader_Type :: union(tag u32) {
    FRAGMENT_SHADER = 35632
    VERTEX_SHADER   = 35633
}

GL_Shader_Param :: union(tag u32) {
    COMPILE_STATUS  = 35713
    LINK_STATUS     = 35714
    INFO_LOG_LENGTH = 35716
}

GL_Face :: union(tag u32) {
    FRONT          = 1028
    BACK           = 1029
    FRONT_AND_BACK = 1032
}

GL_Winding :: union(tag u32) {
    CW  = 2304
    CCW = 2305
}

GL_Depth_Func :: union(tag u32) {
    NEVER    = 512
    LESS     = 513
    EQUAL    = 514
    LEQUAL   = 515
    GREATER  = 516
    NOTEQUAL = 517
    GEQUAL   = 518
    ALWAYS   = 519
}

GL_Polygon_Mode :: union(tag u32) {
    POINT = 6912
    LINE  = 6913
    FILL  = 6914
}

// What BindFramebuffer binds: one framebuffer to draw into and read from
// (FRAMEBUFFER), or each apart, as BlitFramebuffer copies between them.
// Framebuffer 0 is the window's.
GL_Framebuffer_Target :: union(tag u32) {
    FRAMEBUFFER      = 36160   // 0x8D40
    READ_FRAMEBUFFER = 36008   // 0x8CA8
    DRAW_FRAMEBUFFER = 36009   // 0x8CA9
}

GL_Renderbuffer_Target :: union(tag u32) {
    RENDERBUFFER = 36161   // 0x8D41
}

// Where in a framebuffer a texture or renderbuffer goes; DrawBuffers and
// DrawBuffer pick which color ones a shader's outputs write, and NONE
// none — a depth-only framebuffer's.
GL_Attachment :: union(tag u32) {
    NONE                     = 0
    COLOR_ATTACHMENT0        = 36064   // 0x8CE0
    COLOR_ATTACHMENT1        = 36065
    COLOR_ATTACHMENT2        = 36066
    COLOR_ATTACHMENT3        = 36067
    COLOR_ATTACHMENT4        = 36068
    COLOR_ATTACHMENT5        = 36069
    COLOR_ATTACHMENT6        = 36070
    COLOR_ATTACHMENT7        = 36071
    DEPTH_ATTACHMENT         = 36096   // 0x8D00
    STENCIL_ATTACHMENT       = 36128   // 0x8D20
    DEPTH_STENCIL_ATTACHMENT = 33306   // 0x821A
}

// What CheckFramebufferStatus says (as a number: compare it with
// `u32(gl.FRAMEBUFFER_COMPLETE)`, or name it with GL_Framebuffer_Status(n)
// — 0 is none of these: the call itself failed).
GL_Framebuffer_Status :: union(tag u32) {
    FRAMEBUFFER_COMPLETE                      = 36053   // 0x8CD5
    FRAMEBUFFER_UNDEFINED                     = 33305   // 0x8219
    FRAMEBUFFER_INCOMPLETE_ATTACHMENT         = 36054   // 0x8CD6
    FRAMEBUFFER_INCOMPLETE_MISSING_ATTACHMENT = 36055   // 0x8CD7
    FRAMEBUFFER_INCOMPLETE_DRAW_BUFFER        = 36059   // 0x8CDB
    FRAMEBUFFER_INCOMPLETE_READ_BUFFER        = 36060   // 0x8CDC
    FRAMEBUFFER_UNSUPPORTED                   = 36061   // 0x8CDD
    FRAMEBUFFER_INCOMPLETE_MULTISAMPLE        = 36182   // 0x8D56
    FRAMEBUFFER_INCOMPLETE_LAYER_TARGETS      = 36264   // 0x8DA8
}

// What GetIntegerv and GetFloatv read: the driver's limits.
GL_Get_Param :: union(tag u32) {
    MAX_TEXTURE_IMAGE_UNITS          = 34930   // 0x8872, per fragment shader
    MAX_COMBINED_TEXTURE_IMAGE_UNITS = 35661   // 0x8B4D, all stages together
    MAX_ARRAY_TEXTURE_LAYERS         = 35071   // 0x88FF
    MAX_TEXTURE_MAX_ANISOTROPY       = 34047   // 0x84FF, a float
    MAX_COLOR_ATTACHMENTS            = 36063   // 0x8CDF
    MAX_DRAW_BUFFERS                 = 34852   // 0x8824
}

// ---------------------------------------------------------------------------
// GL 1.1 functions — available directly from opengl32.lib (Windows)
// ---------------------------------------------------------------------------

// C's text at p, 0-ended, as Mara text: a view of C's memory, while C
// keeps it there (none: empty).
c_text :: fun(p: ^byte) -> []utf8 {
    view : []utf8 = []
    if p == void do return view
    view = slice_from_ptr(p, 1 << 20)
    for ch, i in view {
        if ch == 0 do return view[:i]
    }
    return view
}

foreign static_lib "opengl32" {
    fun glEnable(cap: GL_Capability)
    fun glDisable(cap: GL_Capability)
    fun glClear(mask: GL_Clear_Mask)
    fun glClearColor(r: f32, g: f32, b: f32, a: f32)
    fun glViewport(x: i32, y: i32, w: i32, h: i32)
    fun glBlendFunc(sfactor: GL_Blend_Factor, dfactor: GL_Blend_Factor)
    fun glCullFace(mode: GL_Face)
    fun glDepthMask(flag: u8)                                            // GLboolean
    fun glDrawArrays(mode: GL_Draw_Mode, first: i32, count: i32)
    fun glDrawElements(mode: GL_Draw_Mode, count: i32, type: GL_Type, indices: usize)
    fun glBindTexture(target: GL_Texture_Target, texture: u32)
    fun glTexParameteri(target: GL_Texture_Target, pname: GL_Tex_Param, param: i32)
    fun glTexParameterf(target: GL_Texture_Target, pname: GL_Tex_Param, param: f32)
    fun glGetIntegerv(pname: GL_Get_Param, data: ^i32)                   // GLint* data
    fun glGetFloatv(pname: GL_Get_Param, data: ^f32)                     // GLfloat* data
    fun glGetError() -> u32
    fun glGenTextures(n: i32, textures: ^u32)                            // GLuint* textures
    fun glDeleteTextures(n: i32, textures: ^u32)                         // const GLuint* textures
    fun glTexImage2D(target: GL_Texture_Target, level: i32, internalformat: i32, width: i32, height: i32, border: i32, format: GL_Tex_Format, type: GL_Type, pixels: ^byte)
    fun glDepthFunc(func: GL_Depth_Func)
    fun glPolygonMode(face: GL_Face, mode: GL_Polygon_Mode)
    fun glLineWidth(width: f32)
    fun glScissor(x: i32, y: i32, width: i32, height: i32)
    fun glFrontFace(mode: GL_Winding)
    fun glClearDepth(depth: f64)                                         // what Clear's DEPTH_BUFFER_BIT writes, 1 at first
    fun glColorMask(r: u8, g: u8, b: u8, a: u8)                          // GLboolean each: which color channels draws write
    fun glDrawBuffer(buf: GL_Attachment)                                 // the bound framebuffer's one color output, or NONE
    fun glReadBuffer(src: GL_Attachment)                                 // what reads and blits take from it
}

Enable :: fun(cap: GL_Capability) { glEnable(cap) }
Disable :: fun(cap: GL_Capability) { glDisable(cap) }
Clear :: fun(mask: GL_Clear_Mask) { glClear(mask) }
ClearColor :: fun(r: f32, g: f32, b: f32, a: f32) { glClearColor(r, g, b, a) }
Viewport :: fun(x: i32, y: i32, w: i32, h: i32) { glViewport(x, y, w, h) }
BlendFunc :: fun(sfactor: GL_Blend_Factor, dfactor: GL_Blend_Factor) { glBlendFunc(sfactor, dfactor) }
CullFace :: fun(mode: GL_Face) { glCullFace(mode) }
DepthMask :: fun(flag: u8) { glDepthMask(flag) }
DrawArrays :: fun(mode: GL_Draw_Mode, first: i32, count: i32) { glDrawArrays(mode, first, count) }
// `indices`: where in the bound element buffer the indices start, in
// bytes (GL's `const void*`, an offset when a buffer is bound).
DrawElements :: fun(mode: GL_Draw_Mode, count: i32, type: GL_Type, indices: usize) { glDrawElements(mode, count, type, indices) }
BindTexture :: fun(target: GL_Texture_Target, texture: u32) { glBindTexture(target, texture) }
TexParameteri :: fun(target: GL_Texture_Target, pname: GL_Tex_Param, param: i32) { glTexParameteri(target, pname, param) }
TexParameterf :: fun(target: GL_Texture_Target, pname: GL_Tex_Param, param: f32) { glTexParameterf(target, pname, param) }
GetIntegerv :: fun(pname: GL_Get_Param, data: ^i32) { glGetIntegerv(pname, data) }
GetFloatv :: fun(pname: GL_Get_Param, data: ^f32) { glGetFloatv(pname, data) }
GetError :: fun() -> u32 { return glGetError() }
GenTextures :: fun(n: i32, textures: ^u32) { glGenTextures(n, textures) }
DeleteTextures :: fun(n: i32, textures: ^u32) { glDeleteTextures(n, textures) }
// A texture's image at `level`: `pixels`, as many as width x height
// texels of `format` and `type` take — or none, `[]`: room to draw into or
// to fill after (TexSubImage3D).
TexImage2D :: fun(target: GL_Texture_Target, level: i32, internalformat: i32, width: i32, height: i32, border: i32, format: GL_Tex_Format, type: GL_Type, pixels: []$T) {
    if pixels.len == 0 {
        glTexImage2D(target, level, internalformat, width, height, border, format, type, void)
        return
    }
    glTexImage2D(target, level, internalformat, width, height, border, format, type, pixels.ptr)
}
DepthFunc :: fun(func: GL_Depth_Func) { glDepthFunc(func) }
PolygonMode :: fun(face: GL_Face, mode: GL_Polygon_Mode) { glPolygonMode(face, mode) }
LineWidth :: fun(width: f32) { glLineWidth(width) }
Scissor :: fun(x: i32, y: i32, width: i32, height: i32) { glScissor(x, y, width, height) }
FrontFace :: fun(mode: GL_Winding) { glFrontFace(mode) }
ClearDepth :: fun(depth: f64) { glClearDepth(depth) }
ColorMask :: fun(r: u8, g: u8, b: u8, a: u8) { glColorMask(r, g, b, a) }
DrawBuffer :: fun(buf: GL_Attachment) { glDrawBuffer(buf) }
ReadBuffer :: fun(src: GL_Attachment) { glReadBuffer(src) }

// ---------------------------------------------------------------------------
// Modern GL functions (3.0+) — loaded at runtime via open_gl.c.
// open_gl.c keeps function pointers populated by gl_load() and exposes
// thin wrappers under the standard `gl*` symbol names. Compiled into
// open_gl.lib the first time a build needs it, and that lib is used from
// then on: after a change to open_gl.c, delete open_gl.lib so the next
// build compiles it again.
// gl_load takes the platform's proc-address function as a parameter, so
// open_gl.c has no link-time dependency on a specific windowing lib. Each
// foreign block is this file's own: the module's names are the Mara funs
// after it, which call it.
// ---------------------------------------------------------------------------

// open_gl.c's own: its table of the functions it loads (gl_load), and its
// helpers.
foreign static_lib "open_gl" {
    fun mara_gl_proc_count() -> i32
    fun mara_gl_proc_name(i: i32) -> ^byte
    fun mara_gl_proc_set(i: i32, address: ^byte)
    fun mara_gl_compile_shader(type: GL_Shader_Type, src: cstring) -> u32
    fun mara_gl_link_program(vs: u32, fs: u32) -> u32
    fun mara_gl_has_extension(name: cstring) -> u8
}

// Loads the GL functions open_gl.c calls, once a GL context is current:
// `get_proc` gives each one's address by its name (sdl.GL_GetProcAddress),
// void for one the driver hasn't (an extension's: gl_has_extension).
gl_load :: fun(get_proc: fun([]utf8) -> ^byte) {
    for i in 0:mara_gl_proc_count() {
        mara_gl_proc_set(i, get_proc(c_text(mara_gl_proc_name(i))))
    }
}
// Convenience: compile a shader from a single source string.
// Returns shader id on success, 0 on failure (error printed to stdout).
gl_compile_shader :: fun(type: GL_Shader_Type, src: []utf8) -> u32 { return mara_gl_compile_shader(type, cstring(src)) }
// Convenience: link vertex+fragment shaders into a program.
// Returns program id on success, 0 on failure (error printed to stdout).
gl_link_program :: fun(vs: u32, fs: u32) -> u32 { return mara_gl_link_program(vs, fs) }
// 1 when the driver has the extension `name`, else 0:
// `gl.gl_has_extension("GL_ARB_bindless_texture")`. Asked after gl_load.
gl_has_extension :: fun(name: []utf8) -> u8 { return mara_gl_has_extension(cstring(name)) }

foreign static_lib "open_gl" {
    fun glCreateShader(type: GL_Shader_Type) -> u32
    fun glShaderSource(shader: u32, count: i32, strings: ^^utf8, lengths: ^i32)
    fun glCompileShader(shader: u32)
    fun glDeleteShader(shader: u32)
    fun glCreateProgram() -> u32
    fun glAttachShader(program: u32, shader: u32)
    fun glLinkProgram(program: u32)
    fun glDeleteProgram(program: u32)
    fun glUseProgram(program: u32)
    fun glGetUniformLocation(program: u32, name: cstring) -> i32
    fun glUniform1f(location: i32, v0: f32)
    fun glUniform1i(location: i32, v0: i32)
    fun glUniform2f(location: i32, v0: f32, v1: f32)
    fun glUniform3f(location: i32, v0: f32, v1: f32, v2: f32)
    fun glUniformMatrix4fv(location: i32, count: i32, transpose: u8, value: ^f32)   // GLboolean transpose, const GLfloat* value
    fun glGenVertexArrays(n: i32, arrays: ^u32)                          // GLuint* arrays
    fun glBindVertexArray(array: u32)
    fun glGenBuffers(n: i32, buffers: ^u32)                              // GLuint* buffers
    fun glBindBuffer(target: GL_Buffer_Target, buffer: u32)
    fun glBufferData(target: GL_Buffer_Target, size: isize, data: ^byte, usage: GL_Buffer_Usage)   // GLsizeiptr size, const void* data
    fun glBufferSubData(target: GL_Buffer_Target, offset: isize, size: isize, data: ^byte)   // GLintptr offset, GLsizeiptr size, const void* data
    fun glBindBufferBase(target: GL_Buffer_Target, index: u32, buffer: u32)
    fun glEnableVertexAttribArray(index: u32)
    fun glVertexAttribPointer(index: u32, size: i32, type: GL_Type, normalized: u8, stride: i32, pointer: usize)   // GLboolean normalized; pointer is uintptr_t cast (byte offset)
    fun glVertexAttribIPointer(index: u32, size: i32, type: GL_Type, stride: i32, pointer: usize)   // pointer is byte offset
    fun glVertexAttribDivisor(index: u32, divisor: u32)
    fun glActiveTexture(texture: GL_Texture_Unit)
    fun glTexImage3D(target: GL_Texture_Target, level: i32, internalformat: i32, width: i32, height: i32, depth: i32, border: i32, format: GL_Tex_Format, type: GL_Type, pixels: ^byte)
    fun glTexSubImage3D(target: GL_Texture_Target, level: i32, xoffset: i32, yoffset: i32, zoffset: i32, width: i32, height: i32, depth: i32, format: GL_Tex_Format, type: GL_Type, pixels: ^byte)
    fun glGenerateMipmap(target: GL_Texture_Target)
    fun glCompressedTexImage2D(target: GL_Texture_Target, level: i32, internalformat: GL_Compressed_Format, width: i32, height: i32, border: i32, size: i32, data: ^byte)
    fun glCompressedTexImage3D(target: GL_Texture_Target, level: i32, internalformat: GL_Compressed_Format, width: i32, height: i32, depth: i32, border: i32, size: i32, data: ^byte)
    fun glCompressedTexSubImage3D(target: GL_Texture_Target, level: i32, xoffset: i32, yoffset: i32, zoffset: i32, width: i32, height: i32, depth: i32, format: GL_Compressed_Format, size: i32, data: ^byte)
    fun glTexStorage2D(target: GL_Texture_Target, levels: i32, internalformat: u32, width: i32, height: i32)
    fun glTexStorage3D(target: GL_Texture_Target, levels: i32, internalformat: u32, width: i32, height: i32, depth: i32)
    fun glGetShaderiv(shader: u32, pname: GL_Shader_Param, params: ^i32)   // GLint* params
    fun glGetShaderInfoLog(shader: u32, bufSize: i32, length: ^i32, infoLog: ^utf8)
    fun glGetProgramiv(program: u32, pname: GL_Shader_Param, params: ^i32)
    fun glGetProgramInfoLog(program: u32, bufSize: i32, length: ^i32, infoLog: ^utf8)   // GLchar* infoLog
    fun glDetachShader(program: u32, shader: u32)
    fun glDeleteVertexArrays(n: i32, arrays: ^u32)                       // const GLuint* arrays
    fun glDeleteBuffers(n: i32, buffers: ^u32)                           // const GLuint* buffers
    fun glGenFramebuffers(n: i32, framebuffers: ^u32)                    // GLuint* framebuffers
    fun glDeleteFramebuffers(n: i32, framebuffers: ^u32)
    fun glBindFramebuffer(target: GL_Framebuffer_Target, framebuffer: u32)
    fun glFramebufferTexture2D(target: GL_Framebuffer_Target, attachment: GL_Attachment, textarget: GL_Texture_Target, texture: u32, level: i32)
    fun glFramebufferTextureLayer(target: GL_Framebuffer_Target, attachment: GL_Attachment, texture: u32, level: i32, layer: i32)
    fun glCheckFramebufferStatus(target: GL_Framebuffer_Target) -> u32   // a GL_Framebuffer_Status's value; 0: the call failed
    fun glGenRenderbuffers(n: i32, renderbuffers: ^u32)
    fun glDeleteRenderbuffers(n: i32, renderbuffers: ^u32)
    fun glBindRenderbuffer(target: GL_Renderbuffer_Target, renderbuffer: u32)
    fun glRenderbufferStorage(target: GL_Renderbuffer_Target, internalformat: u32, width: i32, height: i32)
    fun glFramebufferRenderbuffer(target: GL_Framebuffer_Target, attachment: GL_Attachment, renderbuffertarget: GL_Renderbuffer_Target, renderbuffer: u32)
    fun glDrawBuffers(n: i32, bufs: ^GL_Attachment)
    fun glBlitFramebuffer(src_x0: i32, src_y0: i32, src_x1: i32, src_y1: i32, dst_x0: i32, dst_y0: i32, dst_x1: i32, dst_y1: i32, mask: GL_Clear_Mask, filter: GL_Tex_Filter)
    fun glGetTextureHandleARB(texture: u32) -> u64
    fun glMakeTextureHandleResidentARB(handle: u64)
    fun glMakeTextureHandleNonResidentARB(handle: u64)
    fun glUniformHandleui64ARB(location: i32, value: u64)
    fun glMultiDrawElementsIndirect(mode: GL_Draw_Mode, type: GL_Type, indirect: usize, drawcount: i32, stride: i32)
}

// Shaders
CreateShader :: fun(type: GL_Shader_Type) -> u32 { return glCreateShader(type) }
// A shader's source text, in place of what it had.
ShaderSource :: fun(shader: u32, source: []utf8) {
    text := source.ptr
    n := i32(source.len)
    glShaderSource(shader, 1, &text, &n)
}
CompileShader :: fun(shader: u32) { glCompileShader(shader) }
DeleteShader :: fun(shader: u32) { glDeleteShader(shader) }

// Programs
CreateProgram :: fun() -> u32 { return glCreateProgram() }
AttachShader :: fun(program: u32, shader: u32) { glAttachShader(program, shader) }
LinkProgram :: fun(program: u32) { glLinkProgram(program) }
DeleteProgram :: fun(program: u32) { glDeleteProgram(program) }
UseProgram :: fun(program: u32) { glUseProgram(program) }

// Uniforms
GetUniformLocation :: fun(program: u32, name: []utf8) -> i32 { return glGetUniformLocation(program, cstring(name)) }
Uniform1f :: fun(location: i32, v0: f32) { glUniform1f(location, v0) }
Uniform1i :: fun(location: i32, v0: i32) { glUniform1i(location, v0) }
Uniform2f :: fun(location: i32, v0: f32, v1: f32) { glUniform2f(location, v0, v1) }
Uniform3f :: fun(location: i32, v0: f32, v1: f32, v2: f32) { glUniform3f(location, v0, v1, v2) }
UniformMatrix4fv :: fun(location: i32, count: i32, transpose: u8, value: ^f32) { glUniformMatrix4fv(location, count, transpose, value) }

// VAOs
GenVertexArrays :: fun(n: i32, arrays: ^u32) { glGenVertexArrays(n, arrays) }
BindVertexArray :: fun(array: u32) { glBindVertexArray(array) }

// Buffers
GenBuffers :: fun(n: i32, buffers: ^u32) { glGenBuffers(n, buffers) }
BindBuffer :: fun(target: GL_Buffer_Target, buffer: u32) { glBindBuffer(target, buffer) }
// Room for `size` bytes in the bound buffer: `data`'s first size bytes
// copied in — or none, `[]`, to write after (BufferSubData). Past what
// data holds, the program stops.
BufferData :: fun(target: GL_Buffer_Target, size: isize, data: []$T, usage: GL_Buffer_Usage) {
    if data.len == 0 {
        glBufferData(target, size, void, usage)
        return
    }
    assert(size <= isize(data.len) * isize(size_of(T)))
    glBufferData(target, size, data.ptr, usage)
}
// `data` written into the bound buffer from byte `offset` on.
BufferSubData :: fun(target: GL_Buffer_Target, offset: isize, data: []$T) {
    glBufferSubData(target, offset, isize(data.len) * isize(size_of(T)), data.ptr)
}
// A buffer at a shader's numbered binding (`binding = index`): a uniform
// or shader storage buffer.
BindBufferBase :: fun(target: GL_Buffer_Target, index: u32, buffer: u32) { glBindBufferBase(target, index, buffer) }

// Vertex attributes
EnableVertexAttribArray :: fun(index: u32) { glEnableVertexAttribArray(index) }
VertexAttribPointer :: fun(index: u32, size: i32, type: GL_Type, normalized: u8, stride: i32, pointer: usize) { glVertexAttribPointer(index, size, type, normalized, stride, pointer) }
VertexAttribIPointer :: fun(index: u32, size: i32, type: GL_Type, stride: i32, pointer: usize) { glVertexAttribIPointer(index, size, type, stride, pointer) }
VertexAttribDivisor :: fun(index: u32, divisor: u32) { glVertexAttribDivisor(index, divisor) }

// Texture
ActiveTexture :: fun(texture: GL_Texture_Unit) { glActiveTexture(texture) }
// A 2D array's (or a 3D texture's) image at `level`, all `depth` layers:
// `pixels`, or none, `[]` (TexImage2D).
TexImage3D :: fun(target: GL_Texture_Target, level: i32, internalformat: i32, width: i32, height: i32, depth: i32, border: i32, format: GL_Tex_Format, type: GL_Type, pixels: []$T) {
    if pixels.len == 0 {
        glTexImage3D(target, level, internalformat, width, height, depth, border, format, type, void)
        return
    }
    glTexImage3D(target, level, internalformat, width, height, depth, border, format, type, pixels.ptr)
}
// Part of a texture's image at `level`: width x height x depth texels from
// (xoffset, yoffset, zoffset), `pixels` holding them.
TexSubImage3D :: fun(target: GL_Texture_Target, level: i32, xoffset: i32, yoffset: i32, zoffset: i32, width: i32, height: i32, depth: i32, format: GL_Tex_Format, type: GL_Type, pixels: []$T) {
    glTexSubImage3D(target, level, xoffset, yoffset, zoffset, width, height, depth, format, type, pixels.ptr)
}
GenerateMipmap :: fun(target: GL_Texture_Target) { glGenerateMipmap(target) }
// A block-compressed image as it is in the file: `size` bytes of `data`
// for one mip level of width x height.
// A block-compressed image as it is in the file: `data`, one mip level
// of width x height.
CompressedTexImage2D :: fun(target: GL_Texture_Target, level: i32, internalformat: GL_Compressed_Format, width: i32, height: i32, border: i32, data: []$T) {
    glCompressedTexImage2D(target, level, internalformat, width, height, border, i32(data.len * size_of(T)), data.ptr)
}
// The same for a 2D array's mip level, all `depth` layers at once.
// The same for a 2D array's mip level, all `depth` layers at once.
CompressedTexImage3D :: fun(target: GL_Texture_Target, level: i32, internalformat: GL_Compressed_Format, width: i32, height: i32, depth: i32, border: i32, data: []$T) {
    glCompressedTexImage3D(target, level, internalformat, width, height, depth, border, i32(data.len * size_of(T)), data.ptr)
}
// Part of a mip level: `depth` layers from layer `zoffset`, as the file
// holds them — one layer at a time into storage TexStorage3D made.
// Part of a mip level: `depth` layers from layer `zoffset`, as the file
// holds them — one layer at a time into storage TexStorage3D made.
CompressedTexSubImage3D :: fun(target: GL_Texture_Target, level: i32, xoffset: i32, yoffset: i32, zoffset: i32, width: i32, height: i32, depth: i32, format: GL_Compressed_Format, data: []$T) {
    glCompressedTexSubImage3D(target, level, xoffset, yoffset, zoffset, width, height, depth, format, i32(data.len * size_of(T)), data.ptr)
}
// Room for a texture's `levels` mip levels, filled after (TexSubImage3D,
// CompressedTexSubImage3D). GL 4.2. The format is a sized one or a
// compressed one, as a number: `u32(gl.RGBA8)`, `u32(gl.RGBA_S3TC_DXT5)`.
TexStorage2D :: fun(target: GL_Texture_Target, levels: i32, internalformat: u32, width: i32, height: i32) { glTexStorage2D(target, levels, internalformat, width, height) }
TexStorage3D :: fun(target: GL_Texture_Target, levels: i32, internalformat: u32, width: i32, height: i32, depth: i32) { glTexStorage3D(target, levels, internalformat, width, height, depth) }

// Shader info
GetShaderiv :: fun(shader: u32, pname: GL_Shader_Param, params: ^i32) { glGetShaderiv(shader, pname, params) }
// The shader's log (its compile's, its link's) into `log`, as much as its
// room holds; log.len its length.
GetShaderInfoLog :: fun(shader: u32, log: ^[]utf8) {
    n : i32 = 0
    glGetShaderInfoLog(shader, i32(log.cap), &n, &log[0])
    log.len = i64(n)
}
GetProgramiv :: fun(program: u32, pname: GL_Shader_Param, params: ^i32) { glGetProgramiv(program, pname, params) }
// The program's log (its compile's, its link's) into `log`, as much as its
// room holds; log.len its length.
GetProgramInfoLog :: fun(program: u32, log: ^[]utf8) {
    n : i32 = 0
    glGetProgramInfoLog(program, i32(log.cap), &n, &log[0])
    log.len = i64(n)
}

// Shader management
DetachShader :: fun(program: u32, shader: u32) { glDetachShader(program, shader) }

// Cleanup
DeleteVertexArrays :: fun(n: i32, arrays: ^u32) { glDeleteVertexArrays(n, arrays) }
DeleteBuffers :: fun(n: i32, buffers: ^u32) { glDeleteBuffers(n, buffers) }

// Framebuffers (GL 3.0): draws go into the bound one's attachments —
// textures (FramebufferTexture2D; a 2D array's layer, a cube map's face)
// or renderbuffers, storage only drawn into (a depth buffer no shader
// reads). Framebuffer 0 is the window's. CheckFramebufferStatus says
// whether the bound one can be drawn into: FRAMEBUFFER_COMPLETE.
GenFramebuffers :: fun(n: i32, framebuffers: ^u32) { glGenFramebuffers(n, framebuffers) }
DeleteFramebuffers :: fun(n: i32, framebuffers: ^u32) { glDeleteFramebuffers(n, framebuffers) }
BindFramebuffer :: fun(target: GL_Framebuffer_Target, framebuffer: u32) { glBindFramebuffer(target, framebuffer) }
FramebufferTexture2D :: fun(target: GL_Framebuffer_Target, attachment: GL_Attachment, textarget: GL_Texture_Target, texture: u32, level: i32) { glFramebufferTexture2D(target, attachment, textarget, texture, level) }
FramebufferTextureLayer :: fun(target: GL_Framebuffer_Target, attachment: GL_Attachment, texture: u32, level: i32, layer: i32) { glFramebufferTextureLayer(target, attachment, texture, level, layer) }
CheckFramebufferStatus :: fun(target: GL_Framebuffer_Target) -> u32 { return glCheckFramebufferStatus(target) }
GenRenderbuffers :: fun(n: i32, renderbuffers: ^u32) { glGenRenderbuffers(n, renderbuffers) }
DeleteRenderbuffers :: fun(n: i32, renderbuffers: ^u32) { glDeleteRenderbuffers(n, renderbuffers) }
BindRenderbuffer :: fun(target: GL_Renderbuffer_Target, renderbuffer: u32) { glBindRenderbuffer(target, renderbuffer) }
// The format a sized one, as a number: `u32(gl.DEPTH24_STENCIL8)`.
RenderbufferStorage :: fun(target: GL_Renderbuffer_Target, internalformat: u32, width: i32, height: i32) { glRenderbufferStorage(target, internalformat, width, height) }
FramebufferRenderbuffer :: fun(target: GL_Framebuffer_Target, attachment: GL_Attachment, renderbuffertarget: GL_Renderbuffer_Target, renderbuffer: u32) { glFramebufferRenderbuffer(target, attachment, renderbuffertarget, renderbuffer) }
// Which color attachment each of a shader's outputs writes: `n` of them
// at `bufs` (`layout(location = i) out` takes bufs[i]).
// Which color attachment each of a shader's outputs writes: `bufs[i]` for
// `layout(location = i) out`.
DrawBuffers :: fun(bufs: []GL_Attachment) { glDrawBuffers(i32(bufs.len), bufs.ptr) }
// The read framebuffer's rectangle copied into the draw one's, scaled:
// its color, depth or stencil (`mask`), filtered LINEAR or NEAREST
// (depth and stencil NEAREST only).
BlitFramebuffer :: fun(src_x0: i32, src_y0: i32, src_x1: i32, src_y1: i32, dst_x0: i32, dst_y0: i32, dst_x1: i32, dst_y1: i32, mask: GL_Clear_Mask, filter: GL_Tex_Filter) { glBlitFramebuffer(src_x0, src_y0, src_x1, src_y1, dst_x0, dst_y0, dst_x1, dst_y1, mask, filter) }

// Bindless textures (ARB_bindless_texture, where gl_has_extension says
// so). A texture's handle, made resident, is read by any shader without
// binding it to a unit: handles go in a buffer or a uniform, and a
// shader with `#extension GL_ARB_bindless_texture : require` samples
// through them. A handle's texture can't change after (its parameters,
// its storage); make it non-resident before deleting the texture.
GetTextureHandleARB :: fun(texture: u32) -> u64 { return glGetTextureHandleARB(texture) }
MakeTextureHandleResidentARB :: fun(handle: u64) { glMakeTextureHandleResidentARB(handle) }
MakeTextureHandleNonResidentARB :: fun(handle: u64) { glMakeTextureHandleNonResidentARB(handle) }
UniformHandleui64ARB :: fun(location: i32, value: u64) { glUniformHandleui64ARB(location, value) }

// Multi-draw indirect
// `indirect`: where in the bound DRAW_INDIRECT_BUFFER the commands start,
// in bytes (GL's `const void*`, an offset), so one buffer holds every
// group's commands.
MultiDrawElementsIndirect :: fun(mode: GL_Draw_Mode, type: GL_Type, indirect: usize, drawcount: i32, stride: i32) { glMultiDrawElementsIndirect(mode, type, indirect, drawcount, stride) }
