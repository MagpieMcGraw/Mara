module mara.open_gl

// OpenGL's functions as C has them, each named as the GL reference names it
// less its `gl` (gl.BufferData is glBufferData), its parameters too. GL's
// constants are grouped into types by the parameters they go in; its objects
// are u32s, as C's GLuint (0: none, or the default one: framebuffer 0 is the
// window's). GL 1.1's functions are opengl32.dll's; the rest are loaded by
// gl_load once a context is current, and called through open_gl.c.

core :: use mara.core
os :: use mara.os

Sync :: ^byte   // a fence (GLsync)

// --- constants --------------------------------------------------------------------

Type :: union(tag u32) {
	BYTE              = 5120
	UNSIGNED_BYTE     = 5121
	SHORT             = 5122
	UNSIGNED_SHORT    = 5123
	INT               = 5124
	UNSIGNED_INT      = 5125
	FLOAT             = 5126
	DOUBLE            = 5130
	HALF_FLOAT        = 5131    // 0x140B
	UNSIGNED_INT_24_8 = 34042   // 0x84FA, a DEPTH24_STENCIL8 texel
}

Draw_Mode :: union(tag u32) {
	POINTS         = 0
	LINES          = 1
	LINE_LOOP      = 2
	LINE_STRIP     = 3
	TRIANGLES      = 4
	TRIANGLE_STRIP = 5
	TRIANGLE_FAN   = 6
}

// Shader storage (GL 4.3) and uniform buffers are read by shaders at a
// numbered binding: BindBufferBase puts one there.
Buffer_Target :: union(tag u32) {
	ARRAY_BUFFER          = 34962
	ELEMENT_ARRAY_BUFFER  = 34963
	DRAW_INDIRECT_BUFFER  = 36671
	UNIFORM_BUFFER        = 35345   // 0x8A11
	SHADER_STORAGE_BUFFER = 37074   // 0x90D2
}

Buffer_Usage :: union(tag u32) {
	STREAM_DRAW  = 35040
	STATIC_DRAW  = 35044
	DYNAMIC_DRAW = 35048
}

Clear_Mask :: union(tag u32) {
	DEPTH_BUFFER_BIT   = 256
	STENCIL_BUFFER_BIT = 1024
	COLOR_BUFFER_BIT   = 16384
}

// CLIP_DISTANCE0 and 1 clip by the vertex shader's gl_ClipDistance[0] and [1].
Capability :: union(tag u32) {
	DEPTH_TEST                = 2929
	CULL_FACE                 = 2884
	BLEND                     = 3042
	SCISSOR_TEST              = 3089
	CLIP_DISTANCE0            = 12288   // 0x3000
	CLIP_DISTANCE1            = 12289   // 0x3001
	TEXTURE_CUBE_MAP_SEAMLESS = 34895   // 0x884F
	FRAMEBUFFER_SRGB          = 36281   // 0x8DB9
	MULTISAMPLE               = 32925   // 0x809D
	SAMPLE_ALPHA_TO_COVERAGE  = 32926   // 0x809E
	DEPTH_CLAMP               = 34383   // 0x864F
}

Blend_Factor :: union(tag u32) {
	ZERO                = 0
	ONE                 = 1
	SRC_ALPHA           = 770
	ONE_MINUS_SRC_ALPHA = 771
}

// A cube map is bound as TEXTURE_CUBE_MAP; each face is filled, or attached
// to a framebuffer, as its own target.
Texture_Target :: union(tag u32) {
	TEXTURE_2D                  = 3553
	TEXTURE_2D_ARRAY            = 35866
	TEXTURE_CUBE_MAP            = 34067   // 0x8513
	TEXTURE_CUBE_MAP_POSITIVE_X = 34069   // 0x8515
	TEXTURE_CUBE_MAP_NEGATIVE_X = 34070
	TEXTURE_CUBE_MAP_POSITIVE_Y = 34071
	TEXTURE_CUBE_MAP_NEGATIVE_Y = 34072
	TEXTURE_CUBE_MAP_POSITIVE_Z = 34073
	TEXTURE_CUBE_MAP_NEGATIVE_Z = 34074   // 0x851A
}

// A driver has at least 16 units for fragment shaders: GetIntegerv's
// MAX_TEXTURE_IMAGE_UNITS says how many.
Texture_Unit :: union(tag u32) {
	TEXTURE0  = 33984
	TEXTURE1  = 33985
	TEXTURE2  = 33986
	TEXTURE3  = 33987
	TEXTURE4  = 33988
	TEXTURE5  = 33989
	TEXTURE6  = 33990
	TEXTURE7  = 33991
	TEXTURE8  = 33992
	TEXTURE9  = 33993
	TEXTURE10 = 33994
	TEXTURE11 = 33995
	TEXTURE12 = 33996
	TEXTURE13 = 33997
	TEXTURE14 = 33998
	TEXTURE15 = 33999
	TEXTURE16 = 34000
	TEXTURE17 = 34001
	TEXTURE18 = 34002
	TEXTURE19 = 34003
	TEXTURE20 = 34004
	TEXTURE21 = 34005
	TEXTURE22 = 34006
	TEXTURE23 = 34007
	TEXTURE24 = 34008
	TEXTURE25 = 34009
	TEXTURE26 = 34010
	TEXTURE27 = 34011
	TEXTURE28 = 34012
	TEXTURE29 = 34013
	TEXTURE30 = 34014
	TEXTURE31 = 34015
}

// TexParameteri's, and TexParameterf's for the anisotropy and the LOD bias.
// TEXTURE_MAX_ANISOTROPY (GL 4.6) goes up to GetFloatv's
// MAX_TEXTURE_MAX_ANISOTROPY, 16 on most drivers.
Tex_Param :: union(tag u32) {
	TEXTURE_MIN_FILTER     = 10241
	TEXTURE_MAG_FILTER     = 10240
	TEXTURE_WRAP_S         = 10242
	TEXTURE_WRAP_T         = 10243
	TEXTURE_WRAP_R         = 32882   // 0x8072
	TEXTURE_MIN_LOD        = 33082   // 0x813A
	TEXTURE_MAX_LOD        = 33083   // 0x813B
	TEXTURE_BASE_LEVEL     = 33084   // 0x813C
	TEXTURE_MAX_LEVEL      = 33085   // 0x813D
	TEXTURE_MAX_ANISOTROPY = 34046   // 0x84FE
	TEXTURE_LOD_BIAS       = 34049   // 0x8501
}

Tex_Filter :: union(tag u32) {
	NEAREST                = 9728
	LINEAR                 = 9729
	NEAREST_MIPMAP_NEAREST = 9984
	LINEAR_MIPMAP_NEAREST  = 9985
	NEAREST_MIPMAP_LINEAR  = 9986
	LINEAR_MIPMAP_LINEAR   = 9987
}

Tex_Wrap :: union(tag u32) {
	CLAMP_TO_EDGE   = 33071
	REPEAT          = 10497
	MIRRORED_REPEAT = 33648   // 0x8370
}

// The layouts of pixels handed in (RED to DEPTH_STENCIL: a `format`), and
// the sized ones textures and renderbuffers are made of (an
// `internalformat`). RGBA16F and R11F_G11F_B10F hold colors past 1.
Tex_Format :: union(tag u32) {
	RED                = 6403
	RG                 = 33319   // 0x8227
	RGB                = 6407
	RGBA               = 6408
	DEPTH_COMPONENT    = 6402    // 0x1902
	DEPTH_STENCIL      = 34041   // 0x84F9
	R8                 = 33321
	RGB8               = 32849
	RGBA8              = 32856
	SRGB8_ALPHA8       = 35907   // 0x8C43
	R16F               = 33325   // 0x822D
	R32F               = 33326   // 0x822E
	RG16F              = 33327   // 0x822F
	RGB16F             = 34843   // 0x881B
	RGBA16F            = 34842   // 0x881A
	RGBA32F            = 34836   // 0x8814
	R11F_G11F_B10F     = 35898   // 0x8C3A
	DEPTH_COMPONENT16  = 33189   // 0x81A5
	DEPTH_COMPONENT24  = 33190   // 0x81A6
	DEPTH_COMPONENT32F = 36012   // 0x8CAC
	DEPTH24_STENCIL8   = 35056   // 0x88F0
}

// S3TC (DXT), what DDS textures hold.
Compressed_Format :: union(tag u32) {
	RGB_S3TC_DXT1  = 33776   // 0x83F0
	RGBA_S3TC_DXT1 = 33777   // 0x83F1
	RGBA_S3TC_DXT3 = 33778   // 0x83F2
	RGBA_S3TC_DXT5 = 33779   // 0x83F3
}

Shader_Type :: union(tag u32) {
	FRAGMENT_SHADER = 35632
	VERTEX_SHADER   = 35633
}

Shader_Param :: union(tag u32) {
	COMPILE_STATUS  = 35713
	LINK_STATUS     = 35714
	INFO_LOG_LENGTH = 35716
}

Face :: union(tag u32) {
	FRONT          = 1028
	BACK           = 1029
	FRONT_AND_BACK = 1032
}

Winding :: union(tag u32) {
	CW  = 2304
	CCW = 2305
}

Depth_Func :: union(tag u32) {
	NEVER    = 512
	LESS     = 513
	EQUAL    = 514
	LEQUAL   = 515
	GREATER  = 516
	NOTEQUAL = 517
	GEQUAL   = 518
	ALWAYS   = 519
}

Polygon_Mode :: union(tag u32) {
	POINT = 6912
	LINE  = 6913
	FILL  = 6914
}

// FRAMEBUFFER binds one to draw into and read from; READ_ and DRAW_ each
// apart, as BlitFramebuffer copies between them.
Framebuffer_Target :: union(tag u32) {
	FRAMEBUFFER      = 36160   // 0x8D40
	READ_FRAMEBUFFER = 36008   // 0x8CA8
	DRAW_FRAMEBUFFER = 36009   // 0x8CA9
}

Renderbuffer_Target :: union(tag u32) {
	RENDERBUFFER = 36161   // 0x8D41
}

// NONE: no color output, a depth-only framebuffer's.
Attachment :: union(tag u32) {
	NONE                     = 0
	COLOR_ATTACHMENT0        = 36064   // 0x8CE0
	COLOR_ATTACHMENT1        = 36065
	COLOR_ATTACHMENT2        = 36066
	COLOR_ATTACHMENT3        = 36067
	COLOR_ATTACHMENT4        = 36068
	COLOR_ATTACHMENT5        = 36069
	COLOR_ATTACHMENT6        = 36070
	COLOR_ATTACHMENT7        = 36071
	DEPTH_ATTACHMENT         = 36096   // 0x8D00
	STENCIL_ATTACHMENT       = 36128   // 0x8D20
	DEPTH_STENCIL_ATTACHMENT = 33306   // 0x821A
}

// CheckFramebufferStatus's, compared as numbers: `u32(gl.FRAMEBUFFER_COMPLETE)`.
// 0: the call failed.
Framebuffer_Status :: union(tag u32) {
	FRAMEBUFFER_COMPLETE                      = 36053   // 0x8CD5
	FRAMEBUFFER_UNDEFINED                     = 33305   // 0x8219
	FRAMEBUFFER_INCOMPLETE_ATTACHMENT         = 36054   // 0x8CD6
	FRAMEBUFFER_INCOMPLETE_MISSING_ATTACHMENT = 36055   // 0x8CD7
	FRAMEBUFFER_INCOMPLETE_DRAW_BUFFER        = 36059   // 0x8CDB
	FRAMEBUFFER_INCOMPLETE_READ_BUFFER        = 36060   // 0x8CDC
	FRAMEBUFFER_UNSUPPORTED                   = 36061   // 0x8CDD
	FRAMEBUFFER_INCOMPLETE_MULTISAMPLE        = 36182   // 0x8D56
	FRAMEBUFFER_INCOMPLETE_LAYER_TARGETS      = 36264   // 0x8DA8
}

// The driver's limits, for GetIntegerv and GetFloatv.
Get_Param :: union(tag u32) {
	MAX_TEXTURE_IMAGE_UNITS          = 34930   // 0x8872, per fragment shader
	MAX_COMBINED_TEXTURE_IMAGE_UNITS = 35661   // 0x8B4D, all stages together
	MAX_ARRAY_TEXTURE_LAYERS         = 35071   // 0x88FF
	MAX_TEXTURE_MAX_ANISOTROPY       = 34047   // 0x84FF, a float
	MAX_COLOR_ATTACHMENTS            = 36063   // 0x8CDF
	MAX_DRAW_BUFFERS                 = 34852   // 0x8824
}

// ClipControl's (GL 4.5). ZERO_TO_ONE: depth 0 at the near plane, 1 at the far.
Clip_Origin :: union(tag u32) {
	LOWER_LEFT = 36001   // 0x8CA1
	UPPER_LEFT = 36002   // 0x8CA2
}

Clip_Depth :: union(tag u32) {
	NEGATIVE_ONE_TO_ONE = 37726   // 0x935E
	ZERO_TO_ONE         = 37727   // 0x935F
}

// FenceSync's condition, the only one; ClientWaitSync's flag, so it can't
// wait forever on a fence never sent to the card.
SYNC_GPU_COMMANDS_COMPLETE :: u32(37143)   // 0x9117
SYNC_FLUSH_COMMANDS_BIT    :: u32(1)

// ClientWaitSync's, compared as numbers: `u32(gl.CONDITION_SATISFIED)`.
Wait_Result :: union(tag u32) {
	ALREADY_SIGNALED    = 37146   // 0x911A
	TIMEOUT_EXPIRED     = 37147   // 0x911B
	CONDITION_SATISFIED = 37148   // 0x911C
	WAIT_FAILED         = 37149   // 0x911D
}

// TIMESTAMP: the card's clock when it gets to the query (QueryCounter).
// TIME_ELAPSED: its time on the commands between BeginQuery and EndQuery.
// Both in nanoseconds.
Query_Target :: union(tag u32) {
	SAMPLES_PASSED     = 35092   // 0x8914
	ANY_SAMPLES_PASSED = 35887   // 0x8C2F
	TIME_ELAPSED       = 35007   // 0x88BF
	TIMESTAMP          = 36392   // 0x8E28
}

// Reading QUERY_RESULT before QUERY_RESULT_AVAILABLE says 1 waits for the card.
Query_Param :: union(tag u32) {
	QUERY_RESULT           = 34918   // 0x8866
	QUERY_RESULT_AVAILABLE = 34919   // 0x8867
}

// --- GL 1.1: opengl32.dll ------------------------------------------------------
// GLboolean is a u8. Where C takes a pointer that's an offset into a bound
// buffer (`indices`, `pointer`, `indirect`), it's a usize.

foreign static_lib "opengl32" prefix gl {
	// state
	fun Enable(cap: Capability)
	fun Disable(cap: Capability)
	fun BlendFunc(sfactor: Blend_Factor, dfactor: Blend_Factor)
	fun CullFace(mode: Face)
	fun FrontFace(mode: Winding)
	fun DepthFunc(func: Depth_Func)
	fun DepthMask(flag: u8)
	fun ColorMask(red: u8, green: u8, blue: u8, alpha: u8)
	fun PolygonMode(face: Face, mode: Polygon_Mode)
	fun LineWidth(width: f32)
	fun Viewport(x: i32, y: i32, width: i32, height: i32)
	fun Scissor(x: i32, y: i32, width: i32, height: i32)
	fun GetError() -> u32
	fun GetIntegerv(pname: Get_Param, data: ^i32)
	fun GetFloatv(pname: Get_Param, data: ^f32)
	fun Finish()
	fun Flush()

	// clearing
	fun ClearColor(red: f32, green: f32, blue: f32, alpha: f32)
	fun ClearDepth(depth: f64)
	fun Clear(mask: Clear_Mask)

	// textures
	fun GenTextures(n: i32, textures: ^u32)
	fun DeleteTextures(n: i32, textures: ^u32)
	fun BindTexture(target: Texture_Target, texture: u32)
	fun TexImage2D(target: Texture_Target, level: i32, internalformat: Tex_Format, width: i32, height: i32, border: i32, format: Tex_Format, type: Type, data: ^byte)
	fun TexParameteri(target: Texture_Target, pname: Tex_Param, param: i32)
	fun TexParameterf(target: Texture_Target, pname: Tex_Param, param: f32)

	// drawing
	fun DrawArrays(mode: Draw_Mode, first: i32, count: i32)
	fun DrawElements(mode: Draw_Mode, count: i32, type: Type, indices: usize)
	fun DrawBuffer(buf: Attachment)
	fun ReadBuffer(mode: Attachment)
	fun ReadPixels(x: i32, y: i32, width: i32, height: i32, format: Tex_Format, type: Type, data: ^byte)
}

// --- GL 2.0 and after: loaded by gl_load, called through open_gl.c ---------------

foreign static_lib "open_gl" prefix gl {
	// buffers
	fun GenBuffers(n: i32, buffers: ^u32)
	fun DeleteBuffers(n: i32, buffers: ^u32)
	fun BindBuffer(target: Buffer_Target, buffer: u32)
	fun BindBufferBase(target: Buffer_Target, index: u32, buffer: u32)
	fun BufferData(target: Buffer_Target, size: isize, data: ^byte, usage: Buffer_Usage)
	fun BufferSubData(target: Buffer_Target, offset: isize, size: isize, data: ^byte)

	// vertex arrays
	fun GenVertexArrays(n: i32, arrays: ^u32)
	fun DeleteVertexArrays(n: i32, arrays: ^u32)
	fun BindVertexArray(array: u32)
	fun EnableVertexAttribArray(index: u32)
	fun VertexAttribPointer(index: u32, size: i32, type: Type, normalized: u8, stride: i32, pointer: usize)
	fun VertexAttribIPointer(index: u32, size: i32, type: Type, stride: i32, pointer: usize)
	fun VertexAttribDivisor(index: u32, divisor: u32)

	// textures
	fun ActiveTexture(texture: Texture_Unit)
	fun TexImage3D(target: Texture_Target, level: i32, internalformat: Tex_Format, width: i32, height: i32, depth: i32, border: i32, format: Tex_Format, type: Type, data: ^byte)
	fun TexSubImage3D(target: Texture_Target, level: i32, xoffset: i32, yoffset: i32, zoffset: i32, width: i32, height: i32, depth: i32, format: Tex_Format, type: Type, pixels: ^byte)
	fun TexStorage2D(target: Texture_Target, levels: i32, internalformat: u32, width: i32, height: i32)   // a Tex_Format's or a Compressed_Format's
	fun TexStorage3D(target: Texture_Target, levels: i32, internalformat: u32, width: i32, height: i32, depth: i32)
	fun CompressedTexImage2D(target: Texture_Target, level: i32, internalformat: Compressed_Format, width: i32, height: i32, border: i32, imageSize: i32, data: ^byte)
	fun CompressedTexImage3D(target: Texture_Target, level: i32, internalformat: Compressed_Format, width: i32, height: i32, depth: i32, border: i32, imageSize: i32, data: ^byte)
	fun CompressedTexSubImage3D(target: Texture_Target, level: i32, xoffset: i32, yoffset: i32, zoffset: i32, width: i32, height: i32, depth: i32, format: Compressed_Format, imageSize: i32, data: ^byte)
	fun GenerateMipmap(target: Texture_Target)

	// shaders
	fun CreateShader(shaderType: Shader_Type) -> u32
	fun ShaderSource(shader: u32, count: i32, string: ^^utf8, length: ^i32)
	fun CompileShader(shader: u32)
	fun DeleteShader(shader: u32)
	fun GetShaderiv(shader: u32, pname: Shader_Param, params: ^i32)
	fun GetShaderInfoLog(shader: u32, maxLength: i32, length: ^i32, infoLog: ^utf8)

	// programs
	fun CreateProgram() -> u32
	fun AttachShader(program: u32, shader: u32)
	fun DetachShader(program: u32, shader: u32)
	fun LinkProgram(program: u32)
	fun UseProgram(program: u32)
	fun DeleteProgram(program: u32)
	fun GetProgramiv(program: u32, pname: Shader_Param, params: ^i32)
	fun GetProgramInfoLog(program: u32, maxLength: i32, length: ^i32, infoLog: ^utf8)

	// uniforms
	fun GetUniformLocation(program: u32, name: cstring) -> i32
	fun Uniform1f(location: i32, v0: f32)
	fun Uniform1i(location: i32, v0: i32)
	fun Uniform2f(location: i32, v0: f32, v1: f32)
	fun Uniform3f(location: i32, v0: f32, v1: f32, v2: f32)
	fun Uniform4f(location: i32, v0: f32, v1: f32, v2: f32, v3: f32)
	fun UniformMatrix4fv(location: i32, count: i32, transpose: u8, value: ^f32)

	// framebuffers
	fun GenFramebuffers(n: i32, ids: ^u32)
	fun DeleteFramebuffers(n: i32, framebuffers: ^u32)
	fun BindFramebuffer(target: Framebuffer_Target, framebuffer: u32)
	fun FramebufferTexture2D(target: Framebuffer_Target, attachment: Attachment, textarget: Texture_Target, texture: u32, level: i32)
	fun FramebufferTextureLayer(target: Framebuffer_Target, attachment: Attachment, texture: u32, level: i32, layer: i32)
	fun CheckFramebufferStatus(target: Framebuffer_Target) -> u32
	fun DrawBuffers(n: i32, bufs: ^Attachment)
	fun BlitFramebuffer(srcX0: i32, srcY0: i32, srcX1: i32, srcY1: i32, dstX0: i32, dstY0: i32, dstX1: i32, dstY1: i32, mask: Clear_Mask, filter: Tex_Filter)

	// renderbuffers
	fun GenRenderbuffers(n: i32, renderbuffers: ^u32)
	fun DeleteRenderbuffers(n: i32, renderbuffers: ^u32)
	fun BindRenderbuffer(target: Renderbuffer_Target, renderbuffer: u32)
	fun RenderbufferStorage(target: Renderbuffer_Target, internalformat: Tex_Format, width: i32, height: i32)
	fun RenderbufferStorageMultisample(target: Renderbuffer_Target, samples: i32, internalformat: Tex_Format, width: i32, height: i32)
	fun FramebufferRenderbuffer(target: Framebuffer_Target, attachment: Attachment, renderbuffertarget: Renderbuffer_Target, renderbuffer: u32)

	// drawing
	fun MultiDrawElementsIndirect(mode: Draw_Mode, type: Type, indirect: usize, drawcount: i32, stride: i32)
	fun ClipControl(origin: Clip_Origin, depth: Clip_Depth)

	// fences
	fun FenceSync(condition: u32, flags: u32) -> Sync
	fun ClientWaitSync(sync: Sync, flags: u32, timeout: u64) -> u32
	fun DeleteSync(sync: Sync)

	// queries
	fun GenQueries(n: i32, ids: ^u32)
	fun DeleteQueries(n: i32, ids: ^u32)
	fun QueryCounter(id: u32, target: Query_Target)
	fun BeginQuery(target: Query_Target, id: u32)
	fun EndQuery(target: Query_Target)
	fun GetQueryObjectiv(id: u32, pname: Query_Param, params: ^i32)
	fun GetQueryObjectui64v(id: u32, pname: Query_Param, params: ^u64)

	// bindless textures (ARB_bindless_texture: gl_has_extension)
	fun GetTextureHandleARB(texture: u32) -> u64
	fun MakeTextureHandleResidentARB(handle: u64)
	fun MakeTextureHandleNonResidentARB(handle: u64)
	fun UniformHandleui64ARB(location: i32, value: u64)
}

// --- loading, and shaders made in one call ---------------------------------------

foreign static_lib "open_gl" {
	fun mara_gl_proc_count() -> i32
	fun mara_gl_proc_name(i: i32) -> ^byte
	fun mara_gl_proc_set(i: i32, address: ^byte)
	fun mara_gl_compile_shader(type: Shader_Type, src: cstring) -> u32
	fun mara_gl_link_program(vs: u32, fs: u32) -> u32
	fun mara_gl_log() -> ^byte
	fun mara_gl_has_extension(name: cstring) -> u8
}

// Loads the functions open_gl.c calls, once a context is current: `get_proc`
// (sdl.GL_GetProcAddress) gives each one's address by name, void for one the
// driver hasn't.
gl_load :: fun(get_proc: fun([]utf8) -> ^byte) {
	name : [64]utf8   // (emptied for each: get_proc hands it to C, a 0 after it)
	for i in 0:mara_gl_proc_count() {
		name = []
		&name ++ os.read_cstring(name.cap - 1, mara_gl_proc_name(i))
		mara_gl_proc_set(i, get_proc(name))
	}
}

// A shader compiled from one text: 0 when it doesn't compile, its log printed.
gl_compile_shader :: fun(type: Shader_Type, src: []utf8) -> u32 {
	shader := mara_gl_compile_shader(type, cstring(src))
	if shader == 0 do print("[gl] shader compile error:", os.read_cstring(1024, mara_gl_log()))
	return shader
}

// A program of two shaders: 0 when it doesn't link, its log printed.
gl_link_program :: fun(vs: u32, fs: u32) -> u32 {
	program := mara_gl_link_program(vs, fs)
	if program == 0 do print("[gl] program link error:", os.read_cstring(1024, mara_gl_log()))
	return program
}

// 1 when the driver has the extension, else 0. Asked after gl_load.
gl_has_extension :: fun(name: []utf8) -> u8 { return mara_gl_has_extension(cstring(name)) }
