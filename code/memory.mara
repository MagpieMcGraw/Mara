module mara.memory

use mara.os

#if #profile_memory {
	// The memory profiler (runtime/mara_mem.c, linked into a `mara build
	// -profile memory` build): an arena's use, told after its cursor moves
	// on — base's len what's in use, its cap the arena's size.
	foreign static_lib "mara_runtime" {
		fun __mara_mem_arena(kind: cstring, base: ^[]byte)
	}
}

// 1024 bytes.
KB :: 1 << 10
// 1024 KB, in bytes: `16 * MB`.
MB :: 1 << 20
// 1024 MB, in bytes.
GB :: 1 << 30

// Dynamic arena idea rejected

// ---------------------------------------------------------------------------
// Arena_Basic — pure bump allocation with mark/reset, no per-alloc overhead.
//
// Memory layout:
//   [mark0_backlink | ...allocs... | mark1_backlink | ...allocs... ]
//
// Each mark writes 8 bytes (prev_mark offset). No debug headers.

// The report an arena prints when it runs out of memory.
oom_string :: "
	=== Arena out of memory ===

	Arena capacity: % bytes
	Bytes used:     % bytes
	Bytes free:     % bytes

	Failed allocation: %, % bytes in %
	"

// An arena: memory handed out by moving a cursor forward, and freed all at
// once back to a mark. The fast one, for a finished program; make it the
// program's allocator with `this_program = Program(Arena_Basic(16 * MB))`.
// A block holding a value of 1 KB or more marks it when it starts and
// resets it when it ends, by itself.
Arena_Basic :: class(cap: i64) {
	base: []byte = sys_alloc(cap)
	capacity: i64 = cap
	current_mark: i64 = -1

	// sys_alloc hands back len == cap; reset len to 0 so base.len IS the bump
	// cursor (cap stays the reservation). No per-alloc header — pure bump.
	base.len = 0

	// Remembers where the arena is now; reset frees what came after.
	mark :: fun(a: ^Self) {
		prev := a.current_mark
		// Align to 16 — the backlink store is an unaligned i64 write otherwise,
		// and subsequent allocs need a 16-aligned base for typed views.
		off := (a.base.len + 15) & -16

		a.base[off] = prev
		a.current_mark = off
		// Advance past the 16-aligned backlink slot so the next alloc can't
		// clobber it before reset reads it back. (The old offset-field version
		// set the cursor back to `off` here — a latent corruption bug.)
		a.base.len = off + 16
		#if #profile_memory {
			__mara_mem_arena("Arena_Basic", &a.base)
		}
	}

	// Hands out size bytes (16-byte aligned). When the arena is full, prints a
	// report and stops the program.
	alloc :: fun(
		a: ^Self,
		size: i64,
		name: ^byte = #caller_name,
		span: ^byte = #caller_span) -> []byte
	{
		off := (a.base.len + 15) & -16
		end := off + size

		if end > a.capacity {
			dump(a, size, name, span)
			crash()
		}

		result := a.base[off : end]
		a.base.len = end
		#if #profile_memory {
			__mara_mem_arena("Arena_Basic", &a.base)
		}
		return result
	}

	// Frees everything allocated since the last mark.
	reset :: fun(a: ^Self) {
		cm := a.current_mark
		assert(cm != -1)   // reset without a prior mark would read base[-1]

		prev : i64 = a.base[cm]

		a.base.len = cm
		a.current_mark = prev
	}

	// Prints the out-of-memory report.
	dump :: fun(
		a: ^Self,
		failed_size: i64,
		failed_name: ^byte,
		failed_span: ^byte)
	{
		print(oom_string,
			a.capacity, a.base.len, a.capacity - a.base.len,
			failed_name, failed_size, failed_span)
	}
}

// An arena like Arena_Basic that also records each allocation's size and
// where it was asked for, and lists them all when it runs out. Use it while
// writing a program: `this_program = Program(Arena_Debug(16 * MB))`.
Arena_Debug :: class(cap: i64) {
	base: []byte = sys_alloc(cap)
	capacity: i64 = cap
	current_mark: i64 = -1
	last_alloc: i64 = -1

	// sys_alloc hands back len == cap; reset len to 0 so base.len IS the bump
	// cursor (cap stays the reservation). Every base[off] access is a sized
	// byte read/write, which bounds-checks against capacity, so carving ahead
	// of len is fine — no separate offset field needed.
	base.len = 0

	// Remembers where the arena is now; reset frees what came after.
	mark :: fun(a: ^Self) {
		prev := a.current_mark
		off := (a.base.len + 15) & -16

		a.base[off] = prev
		a.base[off + size_of(prev)] = a.last_alloc

		a.current_mark = off
		a.base.len = off + 16
		#if #profile_memory {
			__mara_mem_arena("Arena_Debug", &a.base)
		}
	}

	// What Arena_Debug records in front of each allocation.
	AllocHeader :: class{
		prev: i64
		size: i64
		name: ^byte
		span: ^byte
	}
	// AllocHeader's size in bytes.
	HEADER_SIZE :: size_of(AllocHeader)

	// Hands out size bytes (16-byte aligned), recording its size and where it was
	// asked for. When the arena is full, prints a report and stops the program.
	alloc :: fun(
		a: ^Self,
		size: i64,
		name: ^byte = #caller_name,
		span: ^byte = #caller_span) -> []byte
	{
		off := (a.base.len + 15) & -16
		cap := a.capacity
		end := off + HEADER_SIZE + size

		if end > cap {
			dump(a, size, name, span)
			crash()
		}

		h : AllocHeader = {
			prev = a.last_alloc,
			size = size,
			name = name,
			span = span }
		a.base[off] = h

		data_off := off + HEADER_SIZE
		result := a.base[data_off : data_off+size]
		a.last_alloc = off
		a.base.len = end
		#if #profile_memory {
			__mara_mem_arena("Arena_Debug", &a.base)
		}
		return result
	}

	// Frees everything allocated since the last mark.
	reset :: fun(a: ^Self) {
		cm := a.current_mark
		assert(cm != -1)   // reset without a prior mark would read base[-1]

		prev : i64 = a.base[cm]
		saved_last : i64 = a.base[cm + size_of(prev)]

		a.base.len = cm
		a.last_alloc = saved_last
		a.current_mark = prev
	}

	// Prints the out-of-memory report, then every allocation, most recent first.
	dump :: fun(
		a: ^Self,
		failed_size: i64,
		failed_name: ^byte,
		failed_span: ^byte)
	{
		print(oom_string,
			a.capacity, a.base.len, a.capacity - a.base.len,
			failed_name, failed_size, failed_span)

		print("--- All allocations (most recent first) ---")
		pos := a.last_alloc
		// Walk while pos is a valid offset. -1 is the sentinel (matches
		// last_alloc's init and current_mark's convention); 0 IS a real
		// alloc offset for the first thing in the arena, so `> 0` would
		// silently drop it.
		for pos >= 0 {
			h : AllocHeader = a.base[pos]
			print("  %, % bytes in %", h.name, h.size, h.span)
			pos = h.prev
		}
	}
}