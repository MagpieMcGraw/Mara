Arena_Debug :: class(cap: i64) {
	base: []byte = sys_alloc(cap)
	capacity: i64 = cap
	current_mark: i64 = -1
	last_alloc: i64 = -1

	// sys_alloc hands back len == cap; reset len to 0 so base.len IS the bump
	// cursor (cap stays the reservation). Every base[off] access is a sized
	// byte read/write, which bounds-checks against capacity, so carving ahead
	// of len is fine — no separate offset field needed.
	base.len = 0

	mark :: fun(a: ^Self) {
		prev := a.current_mark
		off := (a.base.len + 15) & -16

		a.base[off] = prev
		a.base[off + size_of(prev)] = a.last_alloc

		a.current_mark = off
		a.base.len = off + 16
	}

	AllocHeader :: class{
		prev: i64
		size: i64
		name: ^byte
		span: ^byte
	}
	HEADER_SIZE :: size_of(AllocHeader)

	alloc :: fun(
		a: ^Self,
		size: i64,
		name: ^byte = #caller_name,
		span: ^byte = #caller_span) -> []byte
	{
		off := (a.base.len + 15) & -16
		cap := a.capacity
		end := off + HEADER_SIZE + size

		if end > cap {
			dump(a, size, name, span)
			crash()
		}

		h : AllocHeader = {
			prev = a.last_alloc,
			size = size,
			name = name,
			span = span }
		a.base[off] = h

		data_off := off + HEADER_SIZE
		result := a.base[data_off : data_off+size]
		a.last_alloc = off
		a.base.len = end
		return result
	}

	reset :: fun(a: ^Self) {
		cm := a.current_mark
		assert(cm != -1)   // reset without a prior mark would read base[-1]

		prev : i64 = a.base[cm]
		saved_last : i64 = a.base[cm + size_of(prev)]

		a.base.len = cm
		a.last_alloc = saved_last
		a.current_mark = prev
	}

	dump :: fun(
		a: ^Self,
		failed_size: i64,
		failed_name: ^byte,
		failed_span: ^byte)
	{
		print(oom_string,
			a.capacity, a.base.len, a.capacity - a.base.len,
			failed_name, failed_size, failed_span)

		print("--- All allocations (most recent first) ---")
		pos := a.last_alloc
		// Walk while pos is a valid offset. -1 is the sentinel (matches
		// last_alloc's init and current_mark's convention); 0 IS a real
		// alloc offset for the first thing in the arena, so `> 0` would
		// silently drop it.
		for pos >= 0 {
			h : AllocHeader = a.base[pos]
			print("  %, % bytes in %", h.name, h.size, h.span)
			pos = h.prev
		}
	}
}