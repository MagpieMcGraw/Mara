module mara.os

use mara.core
use mara.string

// What a file operation can fail with.
// File-system error set. Each fallible file operation returns one of these
// in its trailing err slot; callers either `?`-propagate or match. No
// print() inside the stdlib — the error value is the diagnostic, and the
// caller chooses whether to log, retry, or bail.
File_Error :: error {
    Open_Failed
    Size_Failed
    Read_Failed
    Write_Failed
    Delete_Failed
    Copy_Failed
    Too_Large
    Seek_Failed
}

// What starting or waiting for a process can fail with.
Process_Error :: error {
    Start_Failed
    Wait_Failed
}

// What listening on a name, or connecting to one, can fail with.
Pipe_Error :: error {
    Listen_Failed
    Name_Taken       // another program listens on the name
    Accept_Failed
    Connect_Failed   // nobody listens on the name
}

// A path, as current_dir and executable_path give one back: up to 512
// characters (Windows' paths here end at 260), its room past them there to
// add a name to. Its separators are '/', Windows' too. Under 1 KB: it lives
// where it's declared, no arena needed.
Path :: [512]utf8

// A file or a directory found in a directory (dir_read): its name — not
// its path — and which it is.
Dir_Entry :: struct {
    name: [260]utf8
    dir:  bool   // a directory, not a file
}

// Whence values for file_seek — identical numeric values on Win32
// (FILE_BEGIN/CURRENT/END) and POSIX (SEEK_SET/CUR/END), so one set serves both.
SEEK_SET :: 0   // relative to the start of the file
SEEK_CUR :: 1   // relative to the current position
SEEK_END :: 2   // relative to the end of the file

// The directory a path is in: the path up to its last separator ('/' or
// '\'), without it. Empty for a name alone.
parent_dir :: fun(path: []utf8) -> []utf8 {
	end : i64 = 0
	for i in 0 .. path.len {
		if path[i] == '/' or path[i] == '\\' do end = i
	}
	return path[0 : end]
}

// The directory a path is in, its separator kept at the end: a Path, for a
// file's name to go after — a file beside it, the program's own files beside
// its executable_path: `dir := path_dir(exe)`, `&dir + "font.ttf"`. Empty
// for a name alone. (parent_dir: without the separator, a view of the path.)
// A directory longer than a Path holds stops the program, as an add past
// its room does.
path_dir :: fun(path: []utf8) -> Path {
	end : i64 = 0
	for ch, i in path {
		if ch == '/' or ch == '\\' do end = i + 1
	}
	dir : Path
	&dir + path[0 : end]
	#if #windows {
		slashes_forward(&dir)
	}
	return dir
}

// A path's '\'s made '/': the paths this module gives back say '/' on every
// system, Windows' too (it takes either). Only on Windows: elsewhere a '\'
// can be part of a name.
slashes_forward :: fun(path: ^[]utf8) {
	for k in 0 .. path.len {
		if path[k] == '\\' do path[k] = '/'
	}
}

// The path without the separators at its end ('/' or '\').
trim_separators :: fun(path: []utf8) -> []utf8 {
	n := path.len
	for n > 0 {
		if path[n - 1] != '/' and path[n - 1] != '\\' do break
		n -= 1
	}
	return path[0 : n]
}

// A path for C: copied, a 0 after it — so the functions here take any slice
// of a path, a view into storage too (its room ends where the path does: no
// 0 can follow). Empty when it's too long for the copy: the call then fails
// as for a path that isn't there.
c_path :: fun(path: []utf8) -> [512]utf8 {
	c : [512]utf8
	if path.len < c.cap do &c + path
	return c
}

// Whether two paths name the same place: '/' and '\' alike, separators at
// their ends not minded, and on Windows letters' case not minded (as its
// file system doesn't). Text only: neither path is looked up.
same_path :: fun(a: []utf8, b: []utf8) -> bool {
	x := trim_separators(a)
	y := trim_separators(b)
	if x.len != y.len do return false
	for i in 0 .. x.len {
		cx := x[i]
		cy := y[i]
		if cx == '/' do cx = '\\'
		if cy == '/' do cy = '\\'
		#if #windows {
			cx = lower(cx)
			cy = lower(cy)
		}
		if cx != cy do return false
	}
	return true
}

// Writes text to a file, a pipe or a program's input — all of it, in as
// many writes as that takes (file_write may take only part). Write_Failed
// when a write fails: the other end gone, say.
file_write_text :: fun(id: File_Id, text: []utf8) -> err {
	bytes : []byte = text[:]
	for bytes.len > 0 {
		n := file_write(id, &bytes)?
		if n <= 0 do return Write_Failed   // (nothing went: more tries won't either)
		bytes = bytes[n : bytes.len]
	}
}

// Reads a whole file into storage — after what's there, its len moved past
// it — and gives it back, a view of storage: all of it, or Too_Large when it
// doesn't fit in storage's room (storage untouched) — never a file cut off.
// (As many reads as that takes: one read may stop short.)
read_entire_file :: fun(path: []utf8, storage: ^[]byte) -> []byte, err {
	start := storage.len
	none := storage[start : start]
	id, oe := file_open_read(path)
	if oe do return none, oe
	defer file_close(id)
	size, se := file_size(id)
	if se do return none, se
	if size > storage.cap - start do return none, Too_Large
	got : i64 = 0
	for got < size {
		rest := storage[start + got : start + size]
		re := file_read(id, &rest)
		if re do return none, re
		if rest.len == 0 do break   // (it ended sooner: it shrank since its size was taken)
		got += rest.len
	}
	storage.len = start + got
	return storage[start : start + got]
}

// DANGER BELOW

// Scan a C-owned NUL-terminated buffer into an honest slice: len is the
// distance to the first 0 (or cap if none found within the window).
read_cstring :: fun(cap: i64, src: ^byte) -> []utf8 {
	view : []utf8 = slice_from_ptr(src, cap)
	for utf8_byte, i in view {
		if utf8_byte == 0 do return view[:i]
	}
	return view
}

// Reserves cap bytes of memory from the OS, for an arena to manage.
// NEVER CALL THIS FUNCTION: make an arena instead (mara.memory).
sys_alloc :: fun(cap: i64) -> []byte {
	#if #native {
		raw := vm_reserve(cap)
		_ = vm_commit(raw, cap)
    	return slice_from_ptr(raw, cap)
	}
	#if #web {
		return slice_from_ptr(malloc(usize(cap)), cap)
	}
}

// File_Id is the public token for an open file. Treat it as opaque — flow it
// from file_open_* through file_read / file_write / file_close without
// inspecting the bits. The kernel checks validity on every syscall, so the
// only enforced rule is "use the value file_open_* handed you, don't
// manufacture one."
//
// The underlying representation is platform-native: distinct i64 on Windows
// (pointer-sized HANDLE) and distinct i32 on Linux (fd is int). User code
// sees one type name and one set of operations across platforms; only the
// wrappers and platform-specific bindings know what's underneath.
// Defined inside each platform's #if block so the underlying matches the
// kernel ABI exactly — no widening at the boundary.

#if #web {
	// emcc auto-links libc, so malloc/free resolve without a port flag.
	foreign static_lib "emscripten" {
	    fun malloc(size: usize) -> ^byte
	    fun free(ptr: ^byte)
	    fun emscripten_set_main_loop(callback: fun(), fps: i64, simulate_infinite_loop: i64)
	    fun emscripten_set_main_loop_arg(callback: fun(^byte), arg: ^byte, fps: i64, simulate_infinite_loop: i64)
	    fun emscripten_cancel_main_loop()
	}
}

#if #windows {
	// Win32 platform layer — file I/O, virtual memory, dynamic library loading.
	// All foreign calls go directly to kernel32.dll (statically linked at build
	// time); no C glue file needed.
	//
	// Type notes:
	//   Win32 HANDLE is a pointer-sized opaque token. The kernel uses it as
	//   an index into a per-process handle table; user mode never derefs it.
	//   We expose file handles as `File_Id :: distinct i64` and bind the
	//   relevant kernel32 entry points with i64 in the HANDLE slots — same
	//   bits at the ABI level (both pointer and i64 return in RAX on x64),
	//   no ptr↔int conversion needed in user-facing code. INVALID_HANDLE_VALUE
	//   ((HANDLE)-1 in C) becomes plain `-1` here.
	//
	//   Module handles (HMODULE from LoadLibraryA) and function-pointer
	//   results from GetProcAddress stay as `^byte` for now — they're truly
	//   pointer-typed and the call sites cast them at use. Could become
	//   Module_Id / Symbol_Addr distinct types later if it'd help.

	// ---------------------------------------------------------------------------
	// CreateFileA flag constants
	// ---------------------------------------------------------------------------

	// dwDesiredAccess
	GENERIC_READ  :: 0x80000000
	GENERIC_WRITE :: 0x40000000

	// dwShareMode
	FILE_SHARE_READ  :: 0x00000001
	FILE_SHARE_WRITE :: 0x00000002

	// dwCreationDisposition
	CREATE_NEW        :: 1   // fail if file exists
	CREATE_ALWAYS     :: 2   // truncate or create
	OPEN_EXISTING     :: 3   // fail if file does not exist
	OPEN_ALWAYS       :: 4   // open or create
	TRUNCATE_EXISTING :: 5   // open and truncate; fail if missing

	// dwFlagsAndAttributes
	FILE_ATTRIBUTE_NORMAL :: 0x80

	// ---------------------------------------------------------------------------
	// VirtualAlloc / VirtualFree flags
	// ---------------------------------------------------------------------------

	// flAllocationType — combinable via OR
	MEM_RESERVE :: 0x2000
	MEM_COMMIT  :: 0x1000

	// dwFreeType
	MEM_RELEASE :: 0x8000

	// flProtect
	PAGE_NOACCESS  :: 0x01
	PAGE_READWRITE :: 0x04

	// ---------------------------------------------------------------------------
	// Virtual memory
	// ---------------------------------------------------------------------------

	// Reserve a virtual address range without committing physical pages.
	// Touching uncommitted bytes traps; commit them first with vm_commit.
	// Caller must release with vm_release.
	vm_reserve :: fun(size: i64) -> ^byte {
		return VirtualAlloc(void, usize(size), MEM_RESERVE, PAGE_NOACCESS)
	}

	// Commit physical pages for the [base, base+size) range. Returns 1 on
	// success, 0 on failure (typically out-of-memory). The range must lie
	// inside something previously returned by vm_reserve.
	vm_commit :: fun(base: ^byte, size: i64) -> i64 {
		if VirtualAlloc(base, usize(size), MEM_COMMIT, PAGE_READWRITE) == void do return 0
		return 1
	}

	// Release a reserved (and possibly committed) range. `base` must be
	// exactly the pointer returned by vm_reserve; partial releases are
	// not supported.
	vm_release :: fun(base: ^byte) {
		_ = VirtualFree(base, usize(0), MEM_RELEASE)
	}

	// ---------------------------------------------------------------------------
	// File I/O
	// ---------------------------------------------------------------------------

	// An open file, as file_open_read or file_open_write hands it back.
	// Pointer-sized opaque token. Win32 HANDLE is `void *` — fits in i64 on
	// x64 (and Win32 on x86 isn't a target we'd compile for in 2026).
	File_Id :: distinct i64

	// Win32 sentinel for "no valid handle" — what CreateFileA returns on
	// failure ((HANDLE)-1 in C). Typed as File_Id so equality against the
	// CreateFileA result doesn't need an explicit unwrap.
	INVALID_HANDLE_VALUE :: File_Id(-1)

	// "No template file" sentinel for CreateFileA's hTemplateFile slot.
	NO_FILE :: File_Id(0)

	// Open a file for reading. Returns (id, .Ok) on success; on failure
	// the File_Id is NO_FILE — safe to feed to `defer file_close`.
	// The path is copied for Windows (c_path): any slice of one will do. So
	// for every path this module takes.
	file_open_read :: fun(path: []utf8) -> File_Id, err {
		c := c_path(path)
		id := CreateFileA(cstring(c), GENERIC_READ, FILE_SHARE_READ, void, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NO_FILE)
		if id == INVALID_HANDLE_VALUE do return NO_FILE, Open_Failed
		return id
	}

	// Open a file for writing, creating it if missing and truncating if present.
	file_open_write :: fun(path: []utf8) -> File_Id, err {
		c := c_path(path)
		id := CreateFileA(cstring(c), GENERIC_WRITE, 0, void, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NO_FILE)
		if id == INVALID_HANDLE_VALUE do return NO_FILE, Open_Failed
		return id
	}

	// Closes the file. NO_FILE is ignored, so `defer file_close(id)` right
	// after an open is safe even when the open failed.
	file_close :: fun(id: File_Id) {
		if id == NO_FILE do return
		_ = CloseHandle(id)
	}

	// The file's size in bytes.
	file_size :: fun(id: File_Id) -> i64, err {
		size: i64 = 0
		if not bool(GetFileSizeEx(id, &size)) do return 0, Size_Failed
		return size
	}

	// Reads the next piece of a file, a pipe or a program's output into data:
	// one read, up to data's capacity — less when less has come, or when the
	// system reads less at a time. data.len becomes the number of bytes read
	// (0 at the end of the file, or of a pipe whose writer closed). For all
	// of a file, read_entire_file.
	file_read :: fun(id: File_Id, data: ^[]byte) -> err {
		read: u32 = 0
		// (ReadFile counts in a u32: at most 1 GB a call, so a room of 4 GB
		// or more doesn't wrap to a small count — 4 GB to none.)
		want := data.cap
		if want > 1 << 30 do want = 1 << 30
		if not bool(ReadFile(id, &data[0], u32(want), &read, void)) {
			// (A pipe whose writer closed: its end, as a file's is — 0 bytes.)
			if GetLastError() != ERROR_BROKEN_PIPE do return Read_Failed
		}
		data.len = i64(read)
	}

	// Write data to the file. Returns (n, .Ok) where n is bytes written. Win32
	// may write fewer bytes than requested under disk-full / pipe conditions;
	// compare n against data.len for partial-write detection.
	file_write :: fun(id: File_Id, data: ^[]byte) -> i64, err {
		written: u32 = 0
		if not bool(WriteFile(id, &data[0], u32(data.len), &written, void)) do return 0, Write_Failed
		return i64(written)
	}

	// Move the file pointer to `offset` relative to `whence` (SEEK_SET / SEEK_CUR
	// / SEEK_END) and return the resulting absolute position. Win32
	// SetFilePointerEx — the seek the cache's per-frame streaming will want.
	file_seek :: fun(id: File_Id, offset: i64, whence: u32) -> i64, err {
		new_pos: i64 = 0
		if not bool(SetFilePointerEx(id, offset, &new_pos, whence)) do return 0, Seek_Failed
		return new_pos
	}

	// Deletes the file at path.
	file_delete :: fun(path: []utf8) -> err {
		c := c_path(path)
		if not bool(DeleteFileA(cstring(c))) do return Delete_Failed
	}

	// Copy `src` to `dst`. Overwrites `dst` if it exists. Used by hot-reload
	// loops to copy a freshly-built DLL into a uniquely-named file the host
	// can LoadLibraryA — the original on disk stays unlocked so the build can
	// overwrite it for the next reload.
	copy_file :: fun(src: []utf8, dst: []utf8) -> err {
		from := c_path(src)
		to := c_path(dst)
		if not bool(CopyFileA(cstring(from), cstring(to), 0)) do return Copy_Failed
	}

	// Last-write time of a file, as Windows' 100-nanosecond FILETIME packed
	// into i64 (low DWORD in lo 32 bits, high DWORD in hi 32 bits). Returns 0
	// if the query fails — caller comparing against a previous value will
	// see a "change" and react safely. Used to poll for DLL rebuild events
	// without a directory watcher.
	file_mtime :: fun(path: []utf8) -> i64 {
		data : WIN32_FILE_ATTRIBUTE_DATA
		c := c_path(path)
		if not bool(GetFileAttributesExA(cstring(c), 0, &data)) do return 0
		lo : i64 = i64(data.last_write_low)
		hi : i64 = i64(data.last_write_high) << 32
		return lo | hi
	}

	// Memory layout matches WIN32_FILE_ATTRIBUTE_DATA exactly: DWORD attributes
	// followed by three FILETIMEs (each a pair of DWORDs) followed by file
	// size's two DWORDs. Declared as nine consecutive u32s so the natural-
	// alignment doesn't insert padding between the DWORD and FILETIME slots.
	WIN32_FILE_ATTRIBUTE_DATA :: struct {
		attributes:         u32
		creation_low:       u32
		creation_high:      u32
		last_access_low:    u32
		last_access_high:   u32
		last_write_low:     u32
		last_write_high:    u32
		size_high:          u32
		size_low:           u32
	}

	// The directory the program runs in — where a path not whole starts —
	// its path, whole (no separator at its end but a drive's root, `C:/`),
	// its separators '/': a Path, its room past the path there to add to
	// (`&cwd + "/code"`).
	// Too_Large when it's longer than a Path holds; Read_Failed when the
	// system won't say. (executable_path: the program's own file, wherever
	// it runs.)
	current_dir :: fun() -> Path, err {
		dir : Path
		n := i64(GetCurrentDirectoryA(u32(dir.cap), &dir[0]))
		if n == 0 do return dir, Read_Failed
		// (Too long, it says how much room it wants, its 0 counted.)
		if n >= dir.cap do return dir, Too_Large
		dir.len = n
		slashes_forward(&dir)
		return dir
	}

	// The running program's own file: its path, whole — however it was
	// started (by a name its PATH found, a relative path, a link), unlike
	// this_program.args[0], which is what its starter wrote — for the files
	// that come with it, beside it: a Path, to cut to its directory and add
	// a file's name to (`exe.len = path_dir(exe).len`, `&exe + "font.ttf"`).
	// Too_Large when it's longer than a Path holds; Read_Failed when the
	// system won't say. (GetModuleFileNameA: in the system's code page, as
	// the other files' functions here take paths.)
	executable_path :: fun() -> Path, err {
		path : Path
		n := i64(GetModuleFileNameA(void, &path[0], u32(path.cap)))
		if n == 0 do return path, Read_Failed
		// (As long as the room, it was cut off: no room for its 0.)
		if n >= path.cap do return path, Too_Large
		path.len = n
		slashes_forward(&path)
		return path
	}

	// The files and directories in a directory, to look through what's there:
	// each one's name and whether it's a directory — not "." or "..", in no
	// order to count on — into storage after what's there, side by side, its
	// len moved past them, and given back, a view of them. Fails with
	// Open_Failed when there's no directory there, Too_Large when they don't
	// fit in storage's room (storage untouched). The path is copied: any
	// slice of one will do (cstring's 0 needn't follow it). (Counted first,
	// then each written: listed twice.)
	dir_read :: fun(path: []utf8, storage: ^[]byte) -> []Dir_Entry, err {
		start := storage.len
		none := slice([:0]Dir_Entry, storage)
		storage.len = start
		if path.len > 500 do return none, Open_Failed   // (its pattern on the stack, under 1 KB)
		pattern : [512]utf8
		&pattern + path
		&pattern + "\\*"
		found : WIN32_FIND_DATAA
		search := FindFirstFileA(cstring(pattern), &found)
		if search == INVALID_HANDLE_VALUE do return none, Open_Failed
		count : i64 = 0
		for true {
			name := read_cstring(260, &found.name[0])
			if name != "." and name != ".." do count += 1
			if not bool(FindNextFileA(search, &found)) do break
		}
		_ = FindClose(search)
		// (Room for them, past what aligning them may skip.)
		if storage.cap - start < count * size_of(Dir_Entry) + 8 do return none, Too_Large
		entries := slice([:count]Dir_Entry, storage)
		search = FindFirstFileA(cstring(pattern), &found)
		if search == INVALID_HANDLE_VALUE do return entries[0 : 0], Open_Failed
		k : i64 = 0
		for k < count {
			name := read_cstring(260, &found.name[0])
			if name != "." and name != ".." {
				entry : Dir_Entry
				&entry.name + name
				entry.dir = (found.attributes & FILE_ATTRIBUTE_DIRECTORY) != 0
				entries[k] = entry
				k += 1
			}
			if not bool(FindNextFileA(search, &found)) do break
		}
		_ = FindClose(search)
		return entries[0 : k]   // (fewer when it lost some since it counted)
	}

	FILE_ATTRIBUTE_DIRECTORY :: 0x10

	// WIN32_FIND_DATAA's layout: DWORDs and FILETIMEs (DWORD pairs, so no
	// padding), then the name, MAX_PATH bytes, and the short 8.3 name's 14.
	WIN32_FIND_DATAA :: struct {
		attributes:       u32
		creation_low:     u32
		creation_high:    u32
		last_access_low:  u32
		last_access_high: u32
		last_write_low:   u32
		last_write_high:  u32
		size_high:        u32
		size_low:         u32
		reserved0:        u32
		reserved1:        u32
		name:             [260!]byte
		short_name:       [14!]byte
	}

	// ---------------------------------------------------------------------------
	// Dynamic library loading (dlopen-equivalent)
	// ---------------------------------------------------------------------------

	// Load a DLL by name. Returns void on failure. Win32's search order applies —
	// pass a full path to bypass it. Caller must release with free_library.
	load_library :: fun(name: []utf8) -> ^byte {
		return LoadLibraryA(cstring(name))
	}

	// Look up a symbol in a loaded module. Returns void if the symbol does not
	// exist. Cast the returned ^byte to the appropriate function pointer type
	// at the call site.
	find_symbol :: fun(mod: ^byte, name: []utf8) -> ^byte {
		return GetProcAddress(mod, cstring(name))
	}

	// Unloads a library that load_library loaded.
	free_library :: fun(mod: ^byte) {
	_ = FreeLibrary(mod)
	}

	// ---------------------------------------------------------------------------
	// Processes: a program run with its input and output through pipes
	// ---------------------------------------------------------------------------

	// A program process_start started: its input, to write to with
	// file_write; its output, to read from with file_read, or pipe_read not
	// to wait (its error output comes there too). `id` is its Win32 process handle.
	Process :: struct {
		id:     File_Id
		input:  File_Id
		output: File_Id
	}

	// Runs a command line — a program and its arguments, as a terminal takes
	// them — its input and output through pipes. Read its output while it
	// runs: one that fills its output pipe waits until it is read.
	process_start :: fun(command: []utf8) -> Process, err {
		// (Each pipe's ends inheritable, then the parent's own ends made not:
		// the child holds only its own, so closing ours ends its input.)
		inherit := SECURITY_ATTRIBUTES{length = u32(size_of(SECURITY_ATTRIBUTES)), inherit_handle = 1}
		child_in := NO_FILE
		to_child := NO_FILE
		if not bool(CreatePipe(&child_in, &to_child, &inherit, 0)) do return Process{0}, Start_Failed
		from_child := NO_FILE
		child_out := NO_FILE
		if not bool(CreatePipe(&from_child, &child_out, &inherit, 0)) {
			file_close(child_in)
			file_close(to_child)
			return Process{0}, Start_Failed
		}
		_ = SetHandleInformation(to_child, HANDLE_FLAG_INHERIT, 0)
		_ = SetHandleInformation(from_child, HANDLE_FLAG_INHERIT, 0)
		start := STARTUPINFOA{size = u32(size_of(STARTUPINFOA)), flags = STARTF_USESTDHANDLES,
		                      std_input = child_in, std_output = child_out, std_error = child_out}
		info : PROCESS_INFORMATION
		started := CreateProcessA(void, cstring(command), void, void, 1, CREATE_NO_WINDOW, void, void, &start, &info)
		// (The child's ends are its own now: ours closed, started or not.)
		file_close(child_in)
		file_close(child_out)
		if not bool(started) {
			file_close(to_child)
			file_close(from_child)
			return Process{0}, Start_Failed
		}
		file_close(info.thread)
		return Process{id = info.process, input = to_child, output = from_child}
	}

	// Closes the process's input: it reads to its end. (A server its window
	// started exits there.)
	process_close_input :: fun(p: ^Process) {
		file_close(p.input)
		p.input = NO_FILE
	}

	// Reads from a pipe what has arrived, without waiting for more — for a
	// program that can't wait, as a window between its frames: data.len
	// becomes the number of bytes read, 0 when none has. Returns false once
	// the pipe has ended: its writer closed and all it wrote read.
	pipe_read :: fun(id: File_Id, data: ^[]byte) -> bool, err {
		data.len = 0
		waiting: u32 = 0
		if not bool(PeekNamedPipe(id, void, 0, void, &waiting, void)) {
			if GetLastError() == ERROR_BROKEN_PIPE do return false
			return false, Read_Failed
		}
		if waiting > 0 {
			file_read(id, data)?   // (what has arrived: it doesn't wait)
		}
		return true
	}

	// Waits for the process to end and returns its exit code — its input and
	// output closed first, so one still writing stops rather than waiting
	// for a reader. Read what it writes before.
	process_wait :: fun(p: ^Process) -> i64, err {
		process_close_input(p)
		file_close(p.output)
		p.output = NO_FILE
		code: u32 = 0
		waited := WaitForSingleObject(p.id, INFINITE) != WAIT_FAILED and bool(GetExitCodeProcess(p.id, &code))
		file_close(p.id)
		p.id = NO_FILE
		if not waited do return 0, Wait_Failed
		return i64(code)
	}

	// The program's own input: what a terminal types, or what the program
	// that started it writes (process_start). Read it with file_read.
	standard_input :: fun() -> File_Id {
		return GetStdHandle(STD_INPUT_HANDLE)
	}

	// The program's own output, written to with file_write. (print writes
	// there too, through a buffer of its own: mixing the two can reorder.)
	standard_output :: fun() -> File_Id {
		return GetStdHandle(STD_OUTPUT_HANDLE)
	}

	// CreatePipe's handles, inheritable or not.
	SECURITY_ATTRIBUTES :: struct {
		length:         u32
		descriptor:     ^byte
		inherit_handle: i32
	}

	// CreateProcessA's start: which handles are the child's input and output.
	STARTUPINFOA :: struct {
		size:           u32
		reserved:       ^byte
		desktop:        ^byte
		title:          ^byte
		x:              u32
		y:              u32
		x_size:         u32
		y_size:         u32
		x_chars:        u32
		y_chars:        u32
		fill_attribute: u32
		flags:          u32
		show_window:    u16
		reserved2_size: u16
		reserved2:      ^byte
		std_input:      File_Id
		std_output:     File_Id
		std_error:      File_Id
	}

	// What CreateProcessA started: its process and its first thread.
	PROCESS_INFORMATION :: struct {
		process:    File_Id
		thread:     File_Id
		process_id: u32
		thread_id:  u32
	}

	STARTF_USESTDHANDLES :: 0x00000100
	HANDLE_FLAG_INHERIT  :: 0x00000001
	CREATE_NO_WINDOW     :: 0x08000000   // no console window of its own
	INFINITE             :: 0xFFFFFFFF
	WAIT_FAILED          :: 0xFFFFFFFF
	STD_INPUT_HANDLE     :: 0xFFFFFFF6   // (DWORD)-10
	STD_OUTPUT_HANDLE    :: 0xFFFFFFF5   // (DWORD)-11
	ERROR_BROKEN_PIPE    :: 109

	// Waits: the program does nothing for `ms` milliseconds (at least).
	sleep_ms :: fun(ms: u32) {
		Sleep(ms)
	}

	// ---------------------------------------------------------------------------
	// Named pipes: a program others connect to, by a name
	// ---------------------------------------------------------------------------

	// A name a program listens on (pipe_listen), for others on this machine
	// to connect to (pipe_connect). `id` is the pipe waiting for the next.
	Pipe_Listener :: struct {
		name: [300]utf8   // \\.\pipe\ and the name
		id:   File_Id
	}

	// Listens on a name — a word, such as "mara-view-game" — for programs on
	// this machine to connect to; pipe_accept takes each. Fails with
	// Name_Taken when another program listens on it.
	pipe_listen :: fun(name: []utf8) -> Pipe_Listener, err {
		l := Pipe_Listener{0}
		if name.len > 200 do return l, Listen_Failed
		&l.name + "\\\\.\\pipe\\"
		&l.name + name
		l.id = pipe_instance(&l, FILE_FLAG_FIRST_PIPE_INSTANCE)
		if l.id == INVALID_HANDLE_VALUE {
			l.id = NO_FILE
			if GetLastError() == ERROR_ACCESS_DENIED do return l, Name_Taken
			return l, Listen_Failed
		}
		return l
	}

	// The next program to connect to the listener's name, when one has: its
	// connection, to read from and write to as a file's id (pipe_read not to
	// wait), file_close ending it. NO_FILE when none has — it doesn't wait,
	// so a window can look each frame.
	pipe_accept :: fun(l: ^Pipe_Listener) -> File_Id, err {
		if l.id == NO_FILE {
			// (The last accept couldn't make the next one waiting: again.)
			l.id = pipe_instance(l, 0)
			if l.id == INVALID_HANDLE_VALUE {
				l.id = NO_FILE
				return NO_FILE, Accept_Failed
			}
		}
		// (Not waiting, ConnectNamedPipe says how it is: true, listening
		// from now on; then listening still, connected, or one came and went.)
		if bool(ConnectNamedPipe(l.id, void)) do return NO_FILE
		e := GetLastError()
		if e == ERROR_PIPE_LISTENING do return NO_FILE
		if e == ERROR_NO_DATA {
			_ = DisconnectNamedPipe(l.id)
			return NO_FILE
		}
		if e != ERROR_PIPE_CONNECTED do return NO_FILE, Accept_Failed
		// (Theirs now, its reads and writes waiting as a file's do; a new
		// one waits for the next.)
		mode: u32 = PIPE_WAIT
		_ = SetNamedPipeHandleState(l.id, &mode, void, void)
		taken := l.id
		l.id = pipe_instance(l, 0)
		if l.id == INVALID_HANDLE_VALUE do l.id = NO_FILE
		return taken
	}

	// Connects to a name a program listens on (pipe_listen): the connection,
	// to write to and read from as a file's id, file_close ending it. Fails
	// with Connect_Failed when nobody listens there.
	pipe_connect :: fun(name: []utf8) -> File_Id, err {
		full : [300]utf8
		if name.len > 200 do return NO_FILE, Connect_Failed
		&full + "\\\\.\\pipe\\"
		&full + name
		for _ in 0 .. 5 {
			id := CreateFileA(cstring(full), GENERIC_READ | GENERIC_WRITE, 0, void, OPEN_EXISTING, 0, NO_FILE)
			if id != INVALID_HANDLE_VALUE do return id
			// (Each one taken, between one accept and the next: wait for one.)
			if GetLastError() != ERROR_PIPE_BUSY do return NO_FILE, Connect_Failed
			_ = WaitNamedPipeA(cstring(full), 1000)
		}
		return NO_FILE, Connect_Failed
	}

	// Stops listening: the name free for another. Connections taken stay
	// open until closed.
	pipe_listen_stop :: fun(l: ^Pipe_Listener) {
		file_close(l.id)
		l.id = NO_FILE
	}

	// One pipe of the listener's name, waiting for a program to connect:
	// not blocking (pipe_accept looks, and returns), and for this machine
	// only.
	pipe_instance :: fun(l: ^Pipe_Listener, first: u32) -> File_Id {
		return CreateNamedPipeA(cstring(l.name), PIPE_ACCESS_DUPLEX | first, PIPE_NOWAIT | PIPE_REJECT_REMOTE_CLIENTS,
		                        PIPE_UNLIMITED_INSTANCES, 4096, 4096, 0, void)
	}

	PIPE_ACCESS_DUPLEX            :: 0x00000003
	FILE_FLAG_FIRST_PIPE_INSTANCE :: 0x00080000   // fails when the name is taken
	PIPE_WAIT                     :: 0x00000000   // (byte mode: 0 too)
	PIPE_NOWAIT                   :: 0x00000001
	PIPE_REJECT_REMOTE_CLIENTS    :: 0x00000008
	PIPE_UNLIMITED_INSTANCES      :: 255
	ERROR_ACCESS_DENIED           :: 5
	ERROR_PIPE_BUSY               :: 231
	ERROR_NO_DATA                 :: 232
	ERROR_PIPE_CONNECTED          :: 535
	ERROR_PIPE_LISTENING          :: 536

	// ---------------------------------------------------------------------------
	// kernel32 bindings
	// ---------------------------------------------------------------------------
	// Static-linked: clang resolves the symbols against kernel32.lib at link
	// time. No dynamic_lib needed — kernel32.dll is implicitly loaded into every
	// Win32 process at startup. BOOL is i32 (Win32 zero/non-zero), not Mara bool.

	foreign static_lib "kernel32" {
		// HANDLE-typed slots are bound as File_Id directly — same bits at the
		// ABI level (distinct lowers to its base i64 in IR), but the type
		// checker keeps stray i64s and other handle kinds out of these slots.
		fun CreateFileA(
			name: cstring,
			access: u32,
			share: u32,
			security: ^byte,            // LPSECURITY_ATTRIBUTES — actual pointer; pass void
			disposition: u32,
			flags: u32,
			template: File_Id) -> File_Id  // HANDLE hTemplateFile / return — pass File_Id(0) for none

		fun ReadFile(
			h: File_Id,
			buf: ^byte,
			bytes_to_read: u32,
			bytes_read_out: ^u32,
			overlapped: ^byte) -> i32

		fun WriteFile(
			h: File_Id,
			buf: ^byte,
			bytes_to_write: u32,
			bytes_written_out: ^u32,
			overlapped: ^byte) -> i32

		fun CloseHandle(h: File_Id) -> i32
		fun GetFileSizeEx(h: File_Id, size_out: ^i64) -> i32
		// distance is a LARGE_INTEGER passed by value; new_ptr_out is a
		// PLARGE_INTEGER that receives the resulting position; method is
		// FILE_BEGIN/CURRENT/END (== SEEK_SET/CUR/END).
		fun SetFilePointerEx(h: File_Id, distance: i64, new_ptr_out: ^i64, move_method: u32) -> i32
		fun DeleteFileA(name: cstring) -> i32
		fun CopyFileA(src: cstring, dst: cstring, fail_if_exists: i32) -> i32

		// info_level: GetFileExInfoStandard = 0 (the only documented value).
		// Fills the supplied WIN32_FILE_ATTRIBUTE_DATA with attributes +
		// FILETIMEs + size.
		fun GetFileAttributesExA(name: cstring, info_level: i32, out: ^byte) -> i32

		// A directory's entries: the first, and each next (false: no more).
		fun FindFirstFileA(pattern: cstring, found: ^WIN32_FIND_DATAA) -> File_Id
		fun FindNextFileA(search: File_Id, found: ^WIN32_FIND_DATAA) -> i32
		fun FindClose(search: File_Id) -> i32

		// A loaded library's file — void: the program's own — its path into name.
		fun GetModuleFileNameA(library: ^byte, name: ^utf8, size: u32) -> u32

		// The directory the program runs in, into buf: its length; the room it
		// wants (its 0 counted) when buf is too small; 0 failing.
		fun GetCurrentDirectoryA(size: u32, buf: ^utf8) -> u32

		fun LoadLibraryA(name: cstring) -> ^byte
		fun GetProcAddress(mod: ^byte, name: cstring) -> ^byte
		fun FreeLibrary(mod: ^byte) -> i32

		fun VirtualAlloc(
			addr:       ^byte,        // LPVOID — pass void to let the system choose
			size:       usize,
			alloc_type: u32,          // MEM_RESERVE / MEM_COMMIT (or both via OR)
			protect:    u32) -> ^byte // PAGE_* flags

		fun VirtualFree(
			addr:      ^byte,
			size:      usize,         // 0 with MEM_RELEASE
			free_type: u32) -> i32

		// Processes and pipes
		fun CreatePipe(read: ^File_Id, write: ^File_Id, attributes: ^SECURITY_ATTRIBUTES, size: u32) -> i32
		fun SetHandleInformation(h: File_Id, mask: u32, flags: u32) -> i32
		fun CreateProcessA(
			application:        ^byte,    // void: the command line names the program
			command_line:       cstring,
			process_attributes: ^byte,
			thread_attributes:  ^byte,
			inherit_handles:    i32,
			creation_flags:     u32,
			environment:        ^byte,
			current_directory:  ^byte,
			startup:            ^STARTUPINFOA,
			info:               ^PROCESS_INFORMATION) -> i32
		fun WaitForSingleObject(h: File_Id, milliseconds: u32) -> u32
		fun GetExitCodeProcess(h: File_Id, code: ^u32) -> i32
		fun GetStdHandle(which: u32) -> File_Id
		fun GetLastError() -> u32
		fun PeekNamedPipe(pipe: File_Id, buffer: ^byte, size: u32, read: ^u32, available: ^u32, message_left: ^u32) -> i32
		fun Sleep(ms: u32)

		// Named pipes
		fun CreateNamedPipeA(
			name:          cstring,
			open_mode:     u32,
			pipe_mode:     u32,
			max_instances: u32,
			out_size:      u32,
			in_size:       u32,
			timeout:       u32,
			attributes:    ^SECURITY_ATTRIBUTES) -> File_Id
		fun ConnectNamedPipe(pipe: File_Id, overlapped: ^byte) -> i32
		fun DisconnectNamedPipe(pipe: File_Id) -> i32
		fun SetNamedPipeHandleState(pipe: File_Id, mode: ^u32, max_collection: ^u32, timeout: ^u32) -> i32
		fun WaitNamedPipeA(name: cstring, timeout: u32) -> i32
	}
}

#if #linux {
	// Linux platform layer — file I/O via libc syscalls. Mirrors the
	// Windows API surface (file_open_read/write, file_close, file_size,
	// file_read, file_write, file_delete) so user code is identical
	// across targets.
	//
	// Modern glibc has dlopen/dlsym/dlclose in libc.so; older systems
	// and musl require -ldl. Add a "dl" foreign block if a target
	// system needs that split.

	// An open file, as file_open_read or file_open_write hands it back.
	// 32-bit fd. Linux file descriptors are `int`, not pointer-sized.
	File_Id :: distinct i32

	// "No file": what a failed open hands back, and what file_close ignores.
	// -1 is what open(2) returns on failure, and never a real fd (0 is stdin).
	NO_FILE :: File_Id(-1)

	// ---------------------------------------------------------------------------
	// open(2) flags
	// ---------------------------------------------------------------------------

	// access mode — exactly one of:
	O_RDONLY :: 0x0000
	O_WRONLY :: 0x0001
	O_RDWR   :: 0x0002

	// creation flags — OR with access mode:
	O_CREAT  :: 0x0040
	O_EXCL   :: 0x0080
	O_TRUNC  :: 0x0200

	// On every file and pipe this program opens: closed in a program it
	// starts (process_start) when that one runs — which inherits only its
	// own input and output, as on Windows.
	O_CLOEXEC :: 0x80000

	// Default mode for created files: rw-r--r-- (octal 0o644 = decimal 420).
	// Mara's lexer doesn't recognize `0o` octal prefixes today; using decimal.
	DEFAULT_MODE :: 420

	// ---------------------------------------------------------------------------
	// File I/O: the same functions as the Windows side, failing the same way.
	// ---------------------------------------------------------------------------

	// Open a file for reading. Returns (id, .Ok) on success; on failure
	// the File_Id is NO_FILE — safe to feed to `defer file_close`.
	// The path goes to Linux as it is, not copied (cstring): a 0 must
	// follow it in its storage — so pass a literal, or the buffer it was
	// appended to, not a `[:]` of the buffer (that slice's room ends where
	// the path does). So for every path this module takes but dir_read's,
	// which copies its own.
	file_open_read :: fun(path: []utf8) -> File_Id, err {
		c := c_path(path)
		id := open(cstring(c), O_RDONLY | O_CLOEXEC, 0)
		if id == NO_FILE do return NO_FILE, Open_Failed
		return id
	}

	// Open a file for writing, creating it if missing and truncating if present.
	file_open_write :: fun(path: []utf8) -> File_Id, err {
		c := c_path(path)
		id := open(cstring(c), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, DEFAULT_MODE)
		if id == NO_FILE do return NO_FILE, Open_Failed
		return id
	}

	// Closes the file. NO_FILE is ignored, so `defer file_close(id)` right
	// after an open is safe even when the open failed.
	file_close :: fun(id: File_Id) {
		if id == NO_FILE do return
		_ = close(id)
	}

	// The file's size in bytes.
	file_size :: fun(id: File_Id) -> i64, err {
		st : Stat
		if fstat(id, &st) < 0 do return 0, Size_Failed
		return st.size
	}

	// Reads the next piece of a file, a pipe or a program's output into data:
	// one read, up to data's capacity — less when less has come, or when the
	// system reads less at a time. data.len becomes the number of bytes read
	// (0 at the end of the file, or of a pipe whose writer closed). For all
	// of a file, read_entire_file.
	file_read :: fun(id: File_Id, data: ^[]byte) -> err {
		n := read(id, &data[0], usize(data.cap))
		if n < 0 do return Read_Failed
		data.len = n
	}

	// Write data to the file. Returns (n, .Ok) where n is bytes written. POSIX
	// may write fewer bytes than requested under signal interruption /
	// pipe-full / disk-full conditions; compare n against data.len for
	// partial-write detection.
	file_write :: fun(id: File_Id, data: ^[]byte) -> i64, err {
		n := write(id, &data[0], usize(data.len))
		if n < 0 do return 0, Write_Failed
		return n
	}

	// Move the file pointer to `offset` relative to `whence` (SEEK_SET / SEEK_CUR
	// / SEEK_END) and return the resulting absolute position. POSIX lseek.
	file_seek :: fun(id: File_Id, offset: i64, whence: u32) -> i64, err {
		pos := lseek(id, offset, i32(whence))
		if pos < 0 do return 0, Seek_Failed
		return pos
	}

	// Deletes the file at path.
	file_delete :: fun(path: []utf8) -> err {
		c := c_path(path)
		if unlink(cstring(c)) != 0 do return Delete_Failed
	}

	// Copy `src` to `dst`. Overwrites `dst` if it exists. Reads and writes it
	// in pieces: slower than sendfile(2), but it needs no more bindings, and
	// suits occasional hot-reload-style copies.
	copy_file :: fun(src: []utf8, dst: []utf8) -> err {
		if copy_file_pieces(src, dst) do return Copy_Failed
	}

	// copy_file's copy, failing as whichever step did.
	copy_file_pieces :: fun(src: []utf8, dst: []utf8) -> err {
		from := file_open_read(src)?
		defer file_close(from)
		to := file_open_write(dst)?
		defer file_close(to)
		buf : [512]byte
		for true {
			file_read(from, &buf)?
			if buf.len == 0 do return   // the end of the file
			file_write(to, &buf)?
		}
	}

	// Last-write time as i64 (Linux's st_mtime is already a 64-bit signed
	// seconds-since-epoch). Returns 0 on failure so callers comparing
	// against a previous value see a "change" and react safely.
	file_mtime :: fun(path: []utf8) -> i64 {
		id, e := file_open_read(path)
		if e do return 0
		defer file_close(id)
		st : Stat
		if fstat(id, &st) < 0 do return 0
		return st.mtime
	}

	// The directory the program runs in — where a path not whole starts —
	// its path, whole (no separator at its end but the root, `/`): a Path,
	// its room past the path there to add to (`&cwd + "/code"`). Too_Large
	// when it's longer than a Path holds (or the system won't say: getcwd
	// fails both ways). (executable_path: the program's own file, wherever
	// it runs.)
	current_dir :: fun() -> Path, err {
		dir : Path
		if getcwd(&dir[0], usize(dir.cap)) == void do return dir, Too_Large
		n : i64 = 0
		for n < dir.cap and dir[n] != 0 {
			n += 1
		}
		dir.len = n
		return dir
	}

	// The running program's own file: its path, whole — however it was
	// started (by a name its PATH found, a relative path, a link), unlike
	// this_program.args[0], which is what its starter wrote — for the files
	// that come with it, beside it: a Path, to cut to its directory and add
	// a file's name to (`exe.len = path_dir(exe).len`, `&exe + "font.ttf"`).
	// Too_Large when it's longer than a Path holds; Read_Failed when the
	// system won't say. (/proc/self/exe: a link to the program's file.)
	executable_path :: fun() -> Path, err {
		path : Path
		link := "/proc/self/exe"
		n := readlink(cstring(link), &path[0], usize(path.cap))
		if n < 0 do return path, Read_Failed
		// (As long as the room, it may be cut off.)
		if n >= path.cap do return path, Too_Large
		path.len = n
		return path
	}

	// The files and directories in a directory, to look through what's there:
	// each one's name and whether it's a directory — not "." or "..", in no
	// order to count on — into storage after what's there, side by side, its
	// len moved past them, and given back, a view of them. Fails with
	// Open_Failed when there's no directory there, Too_Large when they don't
	// fit in storage's room (storage untouched). The path is copied: any
	// slice of one will do (cstring's 0 needn't follow it). (Counted first,
	// then each written: listed twice.)
	dir_read :: fun(path: []utf8, storage: ^[]byte) -> []Dir_Entry, err {
		start := storage.len
		none := slice([:0]Dir_Entry, storage)
		storage.len = start
		// (A copy of the path, a 0 after it: any slice of a path will do, as
		// on Windows, where its search pattern is built.)
		if path.len > 500 do return none, Open_Failed   // (the copy on the stack, under 1 KB)
		opened : [512]utf8
		&opened + path
		dir := opendir(cstring(opened))
		if dir == void do return none, Open_Failed
		count : i64 = 0
		for true {
			d := readdir(dir)
			if d == void do break
			name := read_cstring(256, &d.name[0])
			if name != "." and name != ".." do count += 1
		}
		_ = closedir(dir)
		// (Room for them, past what aligning them may skip.)
		if storage.cap - start < count * size_of(Dir_Entry) + 8 do return none, Too_Large
		entries := slice([:count]Dir_Entry, storage)
		dir = opendir(cstring(opened))
		if dir == void do return entries[0 : 0], Open_Failed
		k : i64 = 0
		for k < count {
			d := readdir(dir)
			if d == void do break
			name := read_cstring(256, &d.name[0])
			if name == "." or name == ".." do continue
			entry : Dir_Entry
			&entry.name + name
			entry.dir = d.kind == DT_DIR
			if d.kind == DT_UNKNOWN do entry.dir = dir_entry_is_dir(path, name)
			entries[k] = entry
			k += 1
		}
		_ = closedir(dir)
		return entries[0 : k]   // (fewer when it lost some since it counted)
	}

	// Whether a directory's entry is a directory, asked of the entry itself:
	// for a file system whose readdir doesn't say (DT_UNKNOWN).
	dir_entry_is_dir :: fun(path: []utf8, name: []utf8) -> bool {
		if path.len + name.len > 500 do return false   // (on the stack, under 1 KB)
		full : [512]utf8
		&full + path
		&full + "/"
		&full + name
		id := open(cstring(full), O_RDONLY | O_CLOEXEC, 0)
		if id == NO_FILE do return false
		st : Stat
		got := fstat(id, &st) == 0
		_ = close(id)
		return got and (st.mode & S_IFMT) == S_IFDIR
	}

	// struct dirent (glibc, x86_64): what readdir returns, one entry.
	Dirent :: struct {
		ino:    u64
		offset: i64
		size:   u16              // this record's
		kind:   u8               // DT_DIR, DT_REG, ...; DT_UNKNOWN: not said
		name:   [256!]byte
	}

	DT_UNKNOWN :: u8(0)
	DT_DIR     :: u8(4)
	S_IFMT     :: u32(0xF000)   // st_mode's file kind bits
	S_IFDIR    :: u32(0x4000)   // a directory

	// ---------------------------------------------------------------------------
	// Stat structure (Linux x86_64 — verify per kernel ABI)
	// ---------------------------------------------------------------------------

	// Subset of struct stat. Layout matches glibc's x86_64 stat as of recent
	// kernels; musl and 32-bit targets differ. Production-grade code should
	// switch to statx(2) with an explicit field mask.
	Stat :: struct {
		dev:     u64
		ino:     u64
		nlink:   u64
		mode:    u32
		uid:     u32
		gid:     u32
		_pad0:   u32
		rdev:    u64
		size:    i64
		blksize: i64
		blocks:  i64
		atime:   i64
		atime_n: i64
		mtime:   i64
		mtime_n: i64
		ctime:   i64
		ctime_n: i64
		_pad1:   [3!]i64
	}

	// ---------------------------------------------------------------------------
	// mmap flags (Linux x86_64)
	// ---------------------------------------------------------------------------

	// prot — memory protection bits, combinable via OR.
	PROT_NONE  :: 0x0      // no access; touching the page traps
	PROT_READ  :: 0x1
	PROT_WRITE :: 0x2

	// flags — exactly one of MAP_PRIVATE / MAP_SHARED, plus optional bits.
	// MAP_ANONYMOUS is Linux-specific (0x20); macOS uses 0x1000.
	MAP_PRIVATE   :: 0x02
	MAP_ANONYMOUS :: 0x20

	// ---------------------------------------------------------------------------
	// Virtual memory
	// ---------------------------------------------------------------------------

	// Reserve a virtual address range with no access. Touching the bytes traps;
	// commit them first with vm_commit. Equivalent to Windows VirtualAlloc with
	// MEM_RESERVE + PAGE_NOACCESS.
	vm_reserve :: fun(size: i64) -> ^byte {
		// mmap returns MAP_FAILED = (void*)-1 on failure, not void — so the
		// caller's void-check doesn't catch a failed reserve. In practice this
		// only fires on real OOM, and the subsequent vm_commit's mprotect call
		// would fail anyway, reporting failure cleanly through that path.
		return mmap(void, usize(size), PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0)
	}

	// Commit physical pages for [base, base+size). The range must lie inside
	// something previously returned by vm_reserve. Returns 1 on success, 0 on
	// failure (typically out-of-memory or bad alignment).
	vm_commit :: fun(base: ^byte, size: i64) -> i64 {
		if mprotect(base, usize(size), PROT_READ | PROT_WRITE) != 0 do return 0
		return 1
	}

	// No-op for now. munmap requires (addr, length) and we don't track length
	// at the vm_reserve boundary (Windows VirtualFree with MEM_RELEASE didn't
	// either — the kernel remembered). Arenas live until process exit; the OS
	// reclaims everything then. Revisit when arena dynamic resize / pool reuse
	// needs real release.
	vm_release :: fun(base: ^byte) {
	}

	// ---------------------------------------------------------------------------
	// Dynamic library loading (dlopen / dlsym / dlclose)
	// ---------------------------------------------------------------------------
	// Modern glibc (>= 2.34) ships dlopen et al. in libc.so. Older systems and
	// musl require linking -ldl. If a target system breaks here, split these
	// declarations into their own `foreign static_lib "dl" { ... }` block.

	RTLD_LAZY :: 0x1
	RTLD_NOW  :: 0x2

	// Load a shared library by name. Returns void on failure. Caller must
	// release with free_library.
	load_library :: fun(name: []utf8) -> ^byte {
		return dlopen(cstring(name), RTLD_NOW)
	}

	// Look up a symbol in a loaded library. Returns void if the symbol does not
	// exist. Cast the returned ^byte to the function pointer type at the call site.
	find_symbol :: fun(mod: ^byte, name: []utf8) -> ^byte {
		return dlsym(mod, cstring(name))
	}

	// Unloads a library that load_library loaded.
	free_library :: fun(mod: ^byte) {
		_ = dlclose(mod)
	}

	// ---------------------------------------------------------------------------
	// Processes: a program run with its input and output through pipes
	// ---------------------------------------------------------------------------

	// A program process_start started: its input, to write to with
	// file_write; its output, to read from with file_read, or pipe_read not
	// to wait (its error output comes there too). `id` is its pid.
	Process :: struct {
		id:     i32
		input:  File_Id
		output: File_Id
	}

	// Runs a command line — a program and its arguments, as a terminal takes
	// them (`sh -c`) — its input and output through pipes. Read its output
	// while it runs: one that fills its output pipe waits until it is read.
	// The command ends in a 0, as cstring() takes it: a literal does, and so
	// does a buffer appended to.
	process_start :: fun(command: []utf8) -> Process, err {
		whole : []utf8 = slice_from_ptr(command.ptr, command.cap)
		end := command.len
		if end == command.cap do end -= 1
		if end < 0 or whole[end] != 0 do return Process{0}, Start_Failed
		ignore_broken_pipes()
		// (The words sh runs with, each ending in a 0; then the end of them.)
		sh := "/bin/sh"
		dash_c := "-c"
		words : [4!]^utf8
		words[0] = sh.ptr
		words[1] = dash_c.ptr
		words[2] = command.ptr
		to_child : [2!]i32
		from_child : [2!]i32
		// (Close-on-exec, all four ends: a program started later inherits
		// none, so this one's input ends when ours closes. The child gets its
		// two as its input and output — dup2's copies, without the flag.)
		if pipe2(&to_child[0], O_CLOEXEC) != 0 do return Process{0}, Start_Failed
		made := pipe2(&from_child[0], O_CLOEXEC) == 0
		// (A child's end numbered 0 to 2 — this program's own input or output
		// closed — would stay itself in the child, flag and all, and close as
		// it runs the command: an error instead.)
		if not made or to_child[0] < 3 or from_child[1] < 3 {
			_ = close(File_Id(to_child[0]))
			_ = close(File_Id(to_child[1]))
			if made {
				_ = close(File_Id(from_child[0]))
				_ = close(File_Id(from_child[1]))
			}
			return Process{0}, Start_Failed
		}
		pid := fork()
		if pid == 0 {
			// The child: the pipes its input and output, then the command.
			// (The four ends close as it runs it: close-on-exec.)
			_ = dup2(to_child[0], 0)
			_ = dup2(from_child[1], 1)
			_ = dup2(from_child[1], 2)
			_ = execv(sh.ptr, &words[0])
			_exit(127)   // (no shell to run it)
		}
		// (The child's ends are its own now: ours closed, started or not.)
		_ = close(File_Id(to_child[0]))
		_ = close(File_Id(from_child[1]))
		if pid < 0 {
			_ = close(File_Id(to_child[1]))
			_ = close(File_Id(from_child[0]))
			return Process{0}, Start_Failed
		}
		return Process{id = pid, input = File_Id(to_child[1]), output = File_Id(from_child[0])}
	}

	// Closes the process's input: it reads to its end. (A server its window
	// started exits there.)
	process_close_input :: fun(p: ^Process) {
		file_close(p.input)
		p.input = NO_FILE
	}

	// Reads from a pipe what has arrived, without waiting for more — for a
	// program that can't wait, as a window between its frames: data.len
	// becomes the number of bytes read, 0 when none has. Returns false once
	// the pipe has ended: its writer closed and all it wrote read.
	pipe_read :: fun(id: File_Id, data: ^[]byte) -> bool, err {
		data.len = 0
		ready := Poll_Fd{fd = id, events = POLLIN}
		n := poll(&ready, 1, 0)   // (0 ms: answers at once)
		if n < 0 do return false, Read_Failed
		if n == 0 do return true
		// (Readable: what has arrived, or its end — 0 bytes.)
		file_read(id, data)?
		return data.len > 0
	}

	// Waits for the process to end and returns its exit code — its input and
	// output closed first, so one still writing stops rather than waiting
	// for a reader. Read what it writes before.
	process_wait :: fun(p: ^Process) -> i64, err {
		process_close_input(p)
		file_close(p.output)
		p.output = NO_FILE
		status: i32 = 0
		waited := waitpid(p.id, &status, 0) >= 0
		p.id = -1
		if not waited do return 0, Wait_Failed
		return i64((status >> 8) & 0xff)
	}

	// The program's own input: what a terminal types, or what the program
	// that started it writes (process_start). Read it with file_read.
	standard_input :: fun() -> File_Id {
		return File_Id(0)
	}

	// The program's own output, written to with file_write. (print writes
	// there too, through a buffer of its own: mixing the two can reorder.)
	standard_output :: fun() -> File_Id {
		return File_Id(1)
	}

	// poll's question about a file: are there bytes to read (POLLIN)?
	Poll_Fd :: struct {
		fd:      File_Id
		events:  i16
		revents: i16
	}

	POLLIN :: 0x0001

	// Waits: the program does nothing for `ms` milliseconds (at least).
	sleep_ms :: fun(ms: u32) {
		want := Timespec{seconds = i64(ms / 1000), nanoseconds = i64(ms % 1000) * 1000000}
		_ = nanosleep(&want, void)
	}

	// nanosleep's time.
	Timespec :: struct {
		seconds:     i64
		nanoseconds: i64
	}

	// ---------------------------------------------------------------------------
	// Named pipes: a program others connect to, by a name (a Unix socket)
	// ---------------------------------------------------------------------------

	// A name a program listens on (pipe_listen), for others on this machine
	// to connect to (pipe_connect). `id` is the socket listening.
	Pipe_Listener :: struct {
		at: Sockaddr_Un   // its socket's path
		id: File_Id
	}

	// Listens on a name — a word, such as "mara-view-game" — for programs on
	// this machine to connect to; pipe_accept takes each. Fails with
	// Name_Taken when another program listens on it.
	pipe_listen :: fun(name: []utf8) -> Pipe_Listener, err {
		l := Pipe_Listener{0}
		l.id = NO_FILE
		if not pipe_address(name, &l.at) do return l, Listen_Failed
		ignore_broken_pipes()
		// (A socket there that answers: another listens. One that doesn't:
		// left by a listener that ended — removed.)
		probe := socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0)
		if probe == NO_FILE do return l, Listen_Failed
		taken := connect(probe, &l.at, SOCKADDR_UN_SIZE) == 0
		_ = close(probe)
		if taken do return l, Name_Taken
		_ = unlink(cstring(l.at.path[:]))
		l.id = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0)
		if l.id == NO_FILE do return l, Listen_Failed
		if bind(l.id, &l.at, SOCKADDR_UN_SIZE) != 0 or listen(l.id, 16) != 0 {
			_ = close(l.id)
			l.id = NO_FILE
			return l, Listen_Failed
		}
		return l
	}

	// The next program to connect to the listener's name, when one has: its
	// connection, to read from and write to as a file's id (pipe_read not to
	// wait), file_close ending it. NO_FILE when none has — it doesn't wait,
	// so a window can look each frame.
	pipe_accept :: fun(l: ^Pipe_Listener) -> File_Id, err {
		id := accept4(l.id, void, void, SOCK_CLOEXEC)   // (its reads and writes wait, as a file's)
		if id != NO_FILE do return id
		e := __errno_location()^
		// (Nobody yet; one that came and went; a signal.)
		if e == EAGAIN or e == ECONNABORTED or e == EINTR do return NO_FILE
		return NO_FILE, Accept_Failed
	}

	// Connects to a name a program listens on (pipe_listen): the connection,
	// to write to and read from as a file's id, file_close ending it. Fails
	// with Connect_Failed when nobody listens there.
	pipe_connect :: fun(name: []utf8) -> File_Id, err {
		at : Sockaddr_Un
		if not pipe_address(name, &at) do return NO_FILE, Connect_Failed
		ignore_broken_pipes()
		id := socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0)
		if id == NO_FILE do return NO_FILE, Connect_Failed
		if connect(id, &at, SOCKADDR_UN_SIZE) != 0 {
			_ = close(id)
			return NO_FILE, Connect_Failed
		}
		return id
	}

	// Stops listening: the name free for another. Connections taken stay
	// open until closed.
	pipe_listen_stop :: fun(l: ^Pipe_Listener) {
		if l.id == NO_FILE do return
		_ = close(l.id)
		l.id = NO_FILE
		_ = unlink(cstring(l.at.path[:]))
	}

	// A name's socket address: <name>.sock in the user's own runtime
	// directory ($XDG_RUNTIME_DIR), else /tmp. False when too long for one.
	pipe_address :: fun(name: []utf8, at: ^Sockaddr_Un) -> bool {
		path : [108]utf8
		dir := getenv("XDG_RUNTIME_DIR")
		if dir == void {
			&path + "/tmp"
		else
			&path + read_cstring(100, dir)
		}
		if path.len + name.len + 6 >= 108 do return false
		&path + "/"
		&path + name
		&path + ".sock"
		at.family = AF_UNIX
		for c, i in path {
			at.path[i] = c
		}
		return true
	}

	// A write to a pipe or socket nobody reads any more: Write_Failed, not
	// SIGPIPE ending the program.
	ignore_broken_pipes :: fun() {
		_ = signal(SIGPIPE, SIG_IGN)
	}

	// A Unix socket's address: its path, ending in a 0.
	Sockaddr_Un :: struct {
		family: u16
		path:   [108!]utf8
	}

	SOCKADDR_UN_SIZE :: 110
	AF_UNIX          :: 1
	SOCK_STREAM      :: 1
	SOCK_NONBLOCK    :: 0x800
	SOCK_CLOEXEC     :: 0x80000
	SIGPIPE          :: 13
	SIG_IGN          :: 1
	EINTR            :: 4
	EAGAIN           :: 11
	ECONNABORTED     :: 103

	// ---------------------------------------------------------------------------
	// libc bindings
	// ---------------------------------------------------------------------------
	// Static-linked: clang resolves against libc at link time. ssize_t is i64
	// on 64-bit Linux; size_t is usize. mode_t is u32. fd is int = i32.
	// File_Id is distinct i32, lowers to i32 in IR, matching libc's int — so
	// the foreign declarations bind File_Id directly in the fd slots and the
	// wrappers don't need any conversion.

	foreign static_lib "c" {
		fun open(path: cstring, flags: i32, mode: u32) -> File_Id
		fun close(fd: File_Id) -> i32
		fun read(fd: File_Id, buf: ^byte, n: usize) -> i64
		fun write(fd: File_Id, buf: ^byte, n: usize) -> i64
		fun unlink(path: cstring) -> i32
		fun fstat(fd: File_Id, out: ^Stat) -> i32
		fun lseek(fd: File_Id, offset: i64, whence: i32) -> i64

		// A directory's entries: opened, each next (void: no more), closed.
		fun opendir(path: cstring) -> ^byte
		fun readdir(dir: ^byte) -> ^Dirent
		fun closedir(dir: ^byte) -> i32

		// Where a link points: its path, not 0-ended, into buf; its length, -1 failing.
		fun readlink(path: cstring, buf: ^utf8, size: usize) -> i64

		// The directory the program runs in, 0-ended, into buf: buf; void failing
		// (too long for buf among the ways).
		fun getcwd(buf: ^utf8, size: usize) -> ^utf8

		// Virtual memory
		fun mmap(addr: ^byte, len: usize, prot: i32, flags: i32, fd: i32, offset: i64) -> ^byte
		fun mprotect(addr: ^byte, len: usize, prot: i32) -> i32
		fun munmap(addr: ^byte, len: usize) -> i32

		// Dynamic library loading
		fun dlopen(name: cstring, flags: i32) -> ^byte
		fun dlsym(handle: ^byte, name: cstring) -> ^byte
		fun dlclose(handle: ^byte) -> i32

		// Processes and pipes
		fun pipe2(fds: ^i32, flags: i32) -> i32
		fun fork() -> i32
		fun dup2(old: i32, new: i32) -> i32
		fun execv(path: ^utf8, words: ^^utf8) -> i32
		fun _exit(code: i32)
		fun waitpid(pid: i32, status: ^i32, options: i32) -> i32
		fun poll(fds: ^Poll_Fd, count: u64, timeout_ms: i32) -> i32
		fun nanosleep(want: ^Timespec, left: ^Timespec) -> i32

		// Named pipes: Unix sockets
		fun socket(domain: i32, kind: i32, protocol: i32) -> File_Id
		fun bind(fd: File_Id, at: ^Sockaddr_Un, size: u32) -> i32
		fun listen(fd: File_Id, backlog: i32) -> i32
		fun accept4(fd: File_Id, at: ^byte, size: ^u32, flags: i32) -> File_Id
		fun connect(fd: File_Id, at: ^Sockaddr_Un, size: u32) -> i32
		fun getenv(name: cstring) -> ^byte
		fun signal(sig: i32, handler: usize) -> usize
		fun __errno_location() -> ^i32
	}
}