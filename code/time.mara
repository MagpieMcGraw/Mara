module mara.time

use mara.os
use mara.math

// A game loop's timing: a Timer, how long a frame took; a Fixed_Timer, the
// game's time in fixed steps out of that. Its clock is mara.os's clock_ns —
// a counter here is its nanoseconds, as a u64.

Timer :: struct {
	counter: u64 = time_now()
	seconds: f64 = 0.016
}

Fixed_Timer :: struct {
	tally: 		f64 = 0
	step: 		f64 = 0.01
	limit: 		f64 = 0.25
}

one_step :: fun(fixed : ^Fixed_Timer) -> bool {
	if fixed.tally >= fixed.step {
		fixed.tally -= fixed.step
		return true
	}
	return false
}

// Now: nanoseconds on a clock that only goes forward (clock_ns).
time_now :: fun() -> u64 {
	return u64(clock_ns())
}

// The seconds since `last` (a time_now), and now.
time_since :: fun(last: u64) -> (f64, u64) {
	now := time_now()
	return f64(now - last) / 1000000000.0, now
}

tally_up :: fun(frame : ^Timer, fixed: ^Fixed_Timer) {
	frame.seconds, frame.counter = time_since(frame.counter)
	fixed.tally += min(fixed.limit, frame.seconds)
}

// Waits out the rest of a frame at `fps` frames a second, the frame's work
// timed from `work`.
sleep :: fun(work: Timer, fps: f64) {
	work_seconds, _ := time_since(work.counter)
	sleep_time := 1.0 / fps - work_seconds
	if sleep_time > 0 do delay_ns(seconds_to_ns(sleep_time))
}

seconds_to_ns :: fun (seconds: f64) -> u64 {
	return u64(seconds * 1000000000)
}

delay_ns :: fun(nanoseconds: u64) {
	sleep_ns(i64(nanoseconds))
}
