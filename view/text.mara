module view

use mara.core
use mara.math
use mara.font
use mara.sdl
use mara.string

// Text drawn pixel for pixel: a font's glyphs at one size (mara.font's
// coverage), white in a texture, drawn in any color by color mod. Text is
// UTF-8: ASCII's characters and EXTRA's have glyphs; any other shows '?'.

ATLAS  :: 512   // the glyphs' texture, each side, in pixels
GLYPHS :: 128   // room for ASCII's 95 and EXTRA's

// Characters past ASCII's with glyphs: marks mara ask's answers and doc
// comments use.
EXTRA :: "—–·∞…←→↑↓⟵⟶•×≤≥≠✦"

Text :: struct {
	texture: Texture
	chars:   [GLYPHS]u32     // the character each glyph is: ASCII's from ' ', then EXTRA's
	glyphs:  [GLYPHS]Glyph
	metrics: Line_Metrics
	ascent:  f32   // a line's top to its baseline, whole pixels
	line:    f32   // a line's height, whole pixels
}

// What a color is drawn in: red, green, blue.
Color :: struct {
	r: u8
	g: u8
	b: u8
}

// The font's glyphs, `pixels` high (its em), in a texture of the renderer's.
text_load :: fun(t: ^Text, renderer: Renderer, font_path: []utf8, pixels: f32) -> err {
	t.chars.len = 0
	for c in 32:127 {
		&t.chars + u32(c)
	}
	extra_text := EXTRA
	extra : []utf8 = extra_text
	at : i64 = 0
	for at < extra.len {
		c, n := char_at(extra, at)
		&t.chars + c
		at += n
	}
	atlas : [ATLAS * ATLAS]byte
	load_coverage_chars(font_path, pixels, t.chars, &t.glyphs, &t.metrics, &atlas, ATLAS)?
	// (Each texel white, its alpha the coverage.)
	rgba : [ATLAS * ATLAS * 4]byte
	rgba.len = rgba.cap
	for i in 0:atlas.len {
		rgba[i * 4] = u8(255)
		rgba[i * 4 + 1] = u8(255)
		rgba[i * 4 + 2] = u8(255)
		rgba[i * 4 + 3] = atlas[i]
	}
	if t.texture != void do DestroyTexture(t.texture)
	t.texture = CreateTexture(renderer, PIXELFORMAT_RGBA32, TEXTUREACCESS_STATIC, ATLAS, ATLAS)
	_ = UpdateWholeTexture(t.texture, rgba[0:rgba.cap], ATLAS * 4)
	_ = SetTextureBlendMode(t.texture, BLENDMODE_BLEND)
	_ = SetTextureScaleMode(t.texture, SCALEMODE_NEAREST)
	t.ascent = ceil_f32(t.metrics.ascent)
	t.line = ceil_f32(t.metrics.ascent - t.metrics.descent + t.metrics.line_gap)
}

// The window's fonts at its size: the text's, and code's — a monospace one,
// set on the text's baseline and line height, so a row of both lines up.
fonts_load :: fun(ui: ^Ui) -> err {
	text_load(&ui.text, ui.renderer, ui.font, FONT_SIZE * ui.density)?
	text_load(&ui.mono, ui.renderer, ui.mono_font, FONT_SIZE * MONO_SCALE * ui.density)?
	ui.mono.ascent = ui.text.ascent
	ui.mono.line = ui.text.line
}

// How wide the text is drawn, in pixels.
text_width :: fun(t: ^Text, s: []utf8) -> f32 {
	w : f32 = 0
	at : i64 = 0
	for at < s.len {
		c, n := char_at(s, at)
		at += n
		w += char_width(t, c)
	}
	return w
}

// How far a character moves the pen, in pixels.
char_width :: fun(t: ^Text, c: u32) -> f32 {
	return t.glyphs[glyph_of(t, c)].advance
}

// The text drawn at x, its line's top at y, in a color: each glyph at the
// pen rounded to a whole pixel, its bitmap a texel to a pixel. The pen
// after it.
text_draw :: fun(t: ^Text, renderer: Renderer, s: []utf8, x: f32, y: f32, color: Color) -> f32 {
	_ = SetTextureColorMod(t.texture, color.r, color.g, color.b)
	pen := x
	baseline := floor_f32(y) + t.ascent
	at : i64 = 0
	for at < s.len {
		c, n := char_at(s, at)
		at += n
		g := t.glyphs[glyph_of(t, c)]
		if g.w > 0 {
			from := SDL_FRect{x = f32(g.x), y = f32(g.y), w = f32(g.w), h = f32(g.h)}
			to := SDL_FRect{x = floor_f32(pen + 0.5) + g.bearing_x, y = baseline - g.bearing_y, w = f32(g.w), h = f32(g.h)}
			_ = RenderTexture(renderer, t.texture, &from, &to)
		}
		pen += g.advance
	}
	return pen
}

// A character's glyph: '?' for one the glyphs don't have.
glyph_of :: fun(t: ^Text, c: u32) -> i64 {
	if c >= 32 and c < 127 do return i64(c) - 32
	for k in 95:t.chars.len {
		if t.chars[k] == c do return k
	}
	return i64('?') - 32
}

// A rectangle filled with a color, in pixels.
fill :: fun(renderer: Renderer, x: f32, y: f32, w: f32, h: f32, color: Color) {
	_ = SetRenderDrawColor(renderer, color.r, color.g, color.b, 255)
	r := SDL_FRect{x = x, y = y, w = w, h = h}
	_ = RenderFillRect(renderer, &r)
}
