module view

use mara.core
use mara.files
use mara.math
use mara.memory
use mara.string

// A profile.txt (`mara build -profile time`, written when the program ends):
// header lines, the line naming the columns, then a row per fun — the
// numbers, the fun's name, its file:line (runtime/mara_prof.c says so).
// The columns are the ones the file names, of the titles this window knows
// (column_title): a profile from before a column was added reads too.
// After the rows, the call tree: a line starting `call tree:`, one naming
// its columns, then a row per node — a fun as called along one path from
// main — callers before their callees: its depth, its total ms, its calls,
// its fun's row in the table (from 0), the name. A profile from before the
// tree was written has none, and no chart.

KNOWN       :: 10   // the titles this window knows
MAX_COLUMNS :: 16
MAX_ROWS    :: 20000
MAX_NODES   :: 40000   // (the profiler writes 32768 at most)
MAX_BARS    :: 6000
MAX_FILES   :: 64

// A stretch of the file's text: where it begins, how long.
Field :: struct {
	at:  i64
	len: i64
}

Row :: struct {
	fields: [MAX_COLUMNS!]Field   // each as written
	values: [MAX_COLUMNS!]f64     // a number column's number
	file:   i64                   // the file it's written in: which of the profile's, the most time first
}

// A fun as called along one path from main: a row of the call tree.
Node :: struct {
	row:    i64   // its fun's row
	parent: i64   // its caller's node; -1: nothing called it
	depth:  i64   // how many callers are above it
	stop:   i64   // the node after its last callee's: its callees' are the ones from the next to there
	total:  f64   // ms in it called this way, its callees included
	self:   f64   // ... its callees left out: its own code
	calls:  f64
}

// What a bar of the chart is.
BAR_FUN   :: 0   // a node: a fun, called along one path
BAR_SELF  :: 1   // a fun's own code, under its bar beside its callees'
BAR_REST  :: 2   // a fun's callees too narrow to show each, together
BAR_CRUMB :: 3   // a caller named above the chart, when it shows one bar alone

// A bar of the chart as last drawn (profile_view.mara).
Bar :: struct {
	kind: i64
	node: i64    // its node; a BAR_SELF's or _REST's, the fun's they're under; a BAR_CRUMB's -1: the whole run
	box:  Rect   // where, in the window, pixels
	more: bool   // it has callees the chart had no row left for
}

Profile :: struct {
	text:    [8 * MB]byte          // the file
	header:  [8]Field              // its lines before the columns
	exit_note: i64 = -1              // the header line saying calls were running at exit: its place; -1: none were
	title:   [300]utf8             // which profile it is, as the panel says it: the first line, shortened (profile_title)
	columns: [MAX_COLUMNS]i64      // the columns it has, in order: which title each is
	rows:    [MAX_ROWS]Row
	order:   [MAX_ROWS]i64         // the rows as shown: sorted
	scratch: [MAX_ROWS]i64         // (sorting's)
	widths:  [MAX_COLUMNS!]f32        // each column's, in pixels: its widest text, room around it
	sort_by: i64 = -1                // the column (its place) it's sorted by; -1: as in the file
	descending: bool
	nodes:   [MAX_NODES]Node       // the call tree, callers before their callees: none in an older profile
	files:   [MAX_FILES]Field      // the files the funs are written in, the most time first (a bar's color)
	run_ms:  f64                     // the time in the calls nothing called: main's
	deepest: i64                     // the tree's deepest node's depth
	in_tree: bool                    // (reading: past the line `call tree:`)
	zoom:    i64 = -1                // the node the chart shows alone; -1: the whole run
	bars:    [MAX_BARS]Bar         // the chart as last drawn
	hover_bar: i64 = -1              // the bar under the mouse as last drawn
	problem: [400]utf8             // why there's nothing to show, when there isn't
	missing: bool                    // (that why: no file yet — the usual, not a fault)
	stamp:   i64                     // the file's time when it was read
}

// A title this window knows.
column_title :: fun(k: i64) -> str64 {
	if k == 0 do return "total ms"
	if k == 1 do return "self ms"
	if k == 2 do return "calls"
	if k == 3 do return "avg us"
	if k == 4 do return "min us"
	if k == 5 do return "median us"
	if k == 6 do return "max us"
	if k == 7 do return "probes %"
	if k == 8 do return "fun"
	return "where"
}

// A title's word in layout.txt, where the columns' order is kept.
column_key :: fun(k: i64) -> str64 {
	if k == 0 do return "total"
	if k == 1 do return "self"
	if k == 2 do return "calls"
	if k == 3 do return "avg"
	if k == 4 do return "min"
	if k == 5 do return "median"
	if k == 6 do return "max"
	if k == 7 do return "probes"
	if k == 8 do return "fun"
	return "where"
}

// The columns' order when layout.txt names none: the fun and how much of
// its time is the profiler's first — what a narrow panel shows — then its
// times, where it's written last.
columns_default :: fun(ui: ^Ui) {
	ui.columns.len = 0
	&ui.columns ++ 8
	&ui.columns ++ 7
	&ui.columns ++ 0
	&ui.columns ++ 1
	&ui.columns ++ 2
	&ui.columns ++ 3
	&ui.columns ++ 5
	&ui.columns ++ 4
	&ui.columns ++ 6
	&ui.columns ++ 9
}

// Whether a title is among the window's columns.
has_title :: fun(ui: ^Ui, title: i64) -> bool {
	for t in ui.columns {
		if t == title do return true
	}
	return false
}

// Whether the title's column holds times: ms or us.
is_time :: fun(k: i64) -> bool {
	return k == 0 or k == 1 or (k >= 3 and k <= 6)
}

// Whether the title's column holds numbers (all but fun and where).
is_number :: fun(k: i64) -> bool {
	return k < 8
}

// The text a field is.
field_text :: fun(p: ^Profile, f: Field) -> []utf8 {
	text : []utf8 = p.text[f.at : f.at + f.len]
	return text
}

// The profile read from the file again: its rows in the order it had, then
// sorted as they were. When it can't be shown, why: p.problem.
profile_read :: fun(p: ^Profile, path: []utf8) {
	p.header.len = 0
	p.title.len = 0
	p.exit_note = -1
	p.columns.len = 0
	p.rows.len = 0
	p.order.len = 0
	p.nodes.len = 0
	p.files.len = 0
	p.bars.len = 0
	p.run_ms = 0.0
	p.deepest = 0
	p.in_tree = false
	p.zoom = -1
	p.hover_bar = -1
	p.problem.len = 0
	p.missing = false
	p.stamp = file_mtime(path)
	p.text.len = 0
	_, e := read_entire_file(path, &p.text)
	if e == Open_Failed {
		p.missing = true
		&p.problem ++ "No profile.txt here yet: build the program with `mara build -profile time` and run it."
		return
	}
	if e {
		&p.problem ++ "profile.txt couldn't be read (or is over 8 MB)."
		return
	}
	text : []utf8 = p.text
	at : i64 = 0
	for at < text.len {
		stop := at
		for stop < text.len {
			if text[stop] == '\n' do break
			stop += 1
		}
		line := Field{at = at, len = stop - at}
		at = stop + 1
		if line.len > 0 {
			if text[line.at + line.len - 1] == '\r' do line.len -= 1
		}
		if line.len == 0 do continue
		if p.columns.len == 0 {
			if not read_columns(p, line) and p.header.len < p.header.cap {
				if p.exit_note < 0 and contains(field_text(p, line), "running at exit") do p.exit_note = p.header.len
				&p.header ++ line
			}
			if p.problem.len > 0 do return
			continue
		}
		if p.in_tree {
			if not profile_node(p, line) do return
			continue
		}
		if line.len >= 10 {
			if text[line.at : line.at + 10] == "call tree:" {
				p.in_tree = true
				continue
			}
		}
		if not profile_row(p, line) do return
	}
	if p.columns.len == 0 {
		&p.problem ++ "profile.txt has no line naming its columns: not a profile this window knows."
		return
	}
	// (Each node's callees end where its last one's do; its own code is its
	// time less theirs. Callees are after their callers: last to first.)
	for k in 0:p.nodes.len {
		i := p.nodes.len - 1 - k
		if p.nodes[i].self < 0.0 do p.nodes[i].self = 0.0
		up := p.nodes[i].parent
		if up >= 0 {
			p.nodes[up].stop = max_int(p.nodes[up].stop, p.nodes[i].stop)
			p.nodes[up].self -= p.nodes[i].total
		else
			p.run_ms += p.nodes[i].total
		}
		p.deepest = max_int(p.deepest, p.nodes[i].depth)
	}
	if p.sort_by >= p.columns.len do p.sort_by = -1
	profile_sort(p)
	profile_title(p)
}

// Which profile it is, p.title: the file's first line — `Mara profile:
// <program>, <build>, <how long it ran>, <when>` — without its first words
// and how long it ran (main's total, the table's first row, says that).
// A first line that isn't such a one, as it is.
profile_title :: fun(p: ^Profile) {
	p.title.len = 0
	if p.header.len == 0 do return
	whole := field_text(p, p.header[0])
	s := whole[0 : min_int(whole.len, p.title.cap)]
	from : i64 = 0
	if starts_with(s, "Mara profile: ") do from = 14
	// (The last two `, `: how long it ran is between them.)
	last : i64 = -1
	before : i64 = -1
	for k in from : s.len - 1 {
		if s[k] == ',' and s[k + 1] == ' ' {
			before = last
			last = k
		}
	}
	ran := false
	if from > 0 and before >= 0 and last - before >= 5 {
		piece := s[before + 2 : last]
		digit := piece[0] >= '0' and piece[0] <= '9'
		ran = digit and (piece[piece.len - 2 : piece.len] == " s" or piece[piece.len - 3 : piece.len] == " ms")
	}
	if ran {
		&p.title ++ s[from : before]
		&p.title ++ s[last : s.len]
	else
		&p.title ++ s[from : s.len]
	}
}

// When the line names the columns (it begins "total ms"), the titles it
// names, read into p.columns — true. A title this window doesn't know is
// a problem: the format changed past it.
read_columns :: fun(p: ^Profile, line: Field) -> bool {
	// (Its words, one space between each.)
	words : [300]utf8
	text := field_text(p, line)
	at : i64 = 0
	for at < text.len {
		w := next_word(text, at)
		if w.len == 0 do break
		if words.len > 0 and words.len < words.cap do &words ++ ' '
		if words.len + w.len <= words.cap do &words ++ text[w.at : w.at + w.len]
		at = w.at + w.len
	}
	if words.len < 8 do return false
	if words[0 : 8] != "total ms" do return false

	at = 0
	for at < words.len {
		found : i64 = -1
		for k in 0:KNOWN {
			title := column_title(k)
			stop := at + title.len
			if stop <= words.len {
				if words[at : stop] == title {
					// (The whole title: the words after it are another's.)
					whole := stop == words.len
					if not whole do whole = words[stop] == ' '
					if whole {
						found = k
						break
					}
				}
			}
		}
		if found < 0 or p.columns.len == p.columns.cap {
			&p.problem ++ "profile.txt has a column this window doesn't know: "
			&p.problem ++ words[at : words.len]
			return true
		}
		&p.columns ++ found
		at += column_title(found).len + 1
	}
	return true
}

// A row read off its line; false when it isn't one (p.problem says).
profile_row :: fun(p: ^Profile, line: Field) -> bool {
	if p.rows.len == MAX_ROWS {
		&p.problem ++ "profile.txt has more funs than this window shows (20000)."
		return false
	}
	row := Row{all 0}
	text := field_text(p, line)
	n := 0
	at : i64 = 0
	for at < text.len {
		w := next_word(text, at)
		if w.len == 0 do break
		if n < MAX_COLUMNS do row.fields[n] = Field{at = line.at + w.at, len = w.len}
		n += 1
		at = w.at + w.len
	}
	ok := n == p.columns.len
	for c in 0:p.columns.len {
		if not ok do break
		if is_number(p.columns[c]) {
			v, number := parse_number(field_text(p, row.fields[c]))
			row.values[c] = v
			ok = number
		}
	}
	if not ok {
		&p.problem ++ "A row of profile.txt isn't one this window knows: "
		&p.problem ++ text[0 : min_int(text.len, 200)]
		return false
	}
	// (Its file: the `where` up to its colon; one of the first MAX_FILES
	// named, else the last of them.)
	c := column_of(p, 9)
	if c >= 0 {
		file := row.fields[c]
		for k in 0:file.len {
			if text[file.at - line.at + k] == ':' {
				file.len = k
				break
			}
		}
		row.file = -1
		for f, k in p.files {
			if field_text(p, f) == field_text(p, file) {
				row.file = k
				break
			}
		}
		if row.file < 0 {
			if p.files.len < p.files.cap do &p.files ++ file
			row.file = p.files.len - 1
		}
	}
	// (A time is shown to two digits after the point: a run's times aren't
	// good to the file's third. Its text in the file is written over with
	// that, rounded — never longer than it was. row.values keeps all of
	// it: what the rows sort by.)
	for col in 0:p.columns.len {
		if not is_time(p.columns[col]) do continue
		f := row.fields[col]
		shown := float_text(row.values[col], 2)
		if shown.len > f.len do continue
		for k in 0:shown.len {
			p.text[f.at + k] = u8(shown[k])
		}
		row.fields[col].len = shown.len
	}
	&p.rows ++ row
	return true
}

// The place of the column with title k among the profile's; -1: it has none.
column_of :: fun(p: ^Profile, k: i64) -> i64 {
	for title, c in p.columns {
		if title == k do return c
	}
	return -1
}

// A node read off its line of the call tree: its depth, total ms, calls and
// fun's row, then the name. False when it isn't one (p.problem says).
profile_node :: fun(p: ^Profile, line: Field) -> bool {
	text := field_text(p, line)
	values : [4!]f64
	n := 0
	at : i64 = 0
	for n < 4 {
		w := next_word(text, at)
		if w.len == 0 do break
		word := text[w.at : w.at + w.len]
		if n == 0 and word == "depth" do return true   // (the line naming the columns)
		v, number := parse_number(word)
		if not number do break
		values[n] = v
		n += 1
		at = w.at + w.len
	}
	depth := i64(values[0])
	row := i64(values[3])
	ok := n == 4 and depth >= 0 and row >= 0 and row < p.rows.len and p.nodes.len < MAX_NODES
	if ok {
		// (No deeper than a callee of the node before.)
		last := -1
		if p.nodes.len > 0 do last = p.nodes[p.nodes.len - 1].depth
		ok = depth <= last + 1
	}
	if not ok {
		&p.problem ++ "A row of profile.txt's call tree isn't one this window knows: "
		&p.problem ++ text[0 : min_int(text.len, 200)]
		return false
	}
	node := Node{row = row, parent = -1, depth = depth, stop = p.nodes.len + 1, total = values[1], self = values[1], calls = values[2]}
	if depth > 0 {
		// (Its caller: the nearest node before it that's less deep.)
		up := p.nodes.len - 1
		for p.nodes[up].depth >= depth {
			up = p.nodes[up].parent
		}
		node.parent = up
	}
	&p.nodes ++ node
	return true
}

// The next word in text from `at`: where it begins and how long (0 long:
// none). Words are what spaces separate.
next_word :: fun(text: []utf8, at: i64) -> Field {
	i := at
	for i < text.len {
		if text[i] != ' ' and text[i] != '\t' do break
		i += 1
	}
	j := i
	for j < text.len {
		if text[j] == ' ' or text[j] == '\t' do break
		j += 1
	}
	return Field{at = i, len = j - i}
}

// The rows' order: as in the file, or by the column sorted by — numbers
// largest first when descending, text A to Z (reversed when descending);
// rows that tie keep the file's order.
profile_sort :: fun(p: ^Profile) {
	n := p.rows.len
	p.order.len = n
	p.scratch.len = n
	for i in 0:n {
		p.order[i] = i
	}
	if p.sort_by < 0 do return
	// (A merge sort, bottom up: runs of 1, 2, 4 ... merged into scratch and back.)
	width : i64 = 1
	for width < n {
		lo : i64 = 0
		for lo < n {
			mid := min_int(lo + width, n)
			hi := min_int(lo + 2 * width, n)
			merge_runs(p, lo, mid, hi)
			lo += 2 * width
		}
		for i in 0:n {
			p.order[i] = p.scratch[i]
		}
		width *= 2
	}
}

// order[lo:mid] and order[mid:hi], each sorted, merged into scratch[lo:hi].
merge_runs :: fun(p: ^Profile, lo: i64, mid: i64, hi: i64) {
	i := lo
	j := mid
	k := lo
	for k < hi {
		take_right := false
		if i >= mid {
			take_right = true
		elif j < hi
			take_right = row_before(p, p.order[j], p.order[i])
		}
		if take_right {
			p.scratch[k] = p.order[j]
			j += 1
		else
			p.scratch[k] = p.order[i]
			i += 1
		}
		k += 1
	}
}

// Whether row a goes before row b, sorted as the profile is.
row_before :: fun(p: ^Profile, a: i64, b: i64) -> bool {
	c := p.sort_by
	if is_number(p.columns[c]) {
		va := p.rows[a].values[c]
		vb := p.rows[b].values[c]
		if p.descending do return va > vb
		return va < vb
	}
	order := compare_text(field_text(p, p.rows[a].fields[c]), field_text(p, p.rows[b].fields[c]))
	if p.descending do return order > 0
	return order < 0
}

// -1, 0 or 1: a before b, the same, or after — letters' case not minded
// (Arena after append), then minded, so the order is one.
compare_text :: fun(a: []utf8, b: []utf8) -> i64 {
	order := compare_folded(a, b)
	if order != 0 do return order
	return compare(a, b)
}
