module view

use mara.core
use mara.math
use mara.memory
use mara.sdl
use mara.string

// Text shown a line at a time, each line in a style, scrolled: the Docs
// panel's, the Ask panel's, the Crash panel's. A status line at the bottom,
// when it has one. Lines wider than the panel wrap: at a space, or within a
// word wider than the panel, the rows after a line's first as far in as its
// own indent — each line's rows worked out again only when the panel's
// width changes. Mara code's lines (STYLE_MARA) colored by their tokens
// (code.mara). Text selected with the mouse, copied (select.mara).

STYLE_TEXT  :: 0   // as text is: the ink
STYLE_DIM   :: 1   // quieter
STYLE_TITLE :: 2   // a heading: its first word in the accent, the rest dim
STYLE_CODE  :: 3   // code
STYLE_BAD   :: 4   // a failure
STYLE_QUERY :: 5   // what was asked: the accent
STYLE_MARA  :: 6   // Mara code: each token in its color
STYLE_DOC   :: 7   // text with `code` in it: the code as Mara's, on a box (draw_doc_row)

TAB_SPACES :: 4    // a tab, shown
CODE_MARGIN :: 2   // a code line's first spaces, the panel's margin as a text line's: in the text's font

// A line: its text in Lines.text, and its style; a place it opens, clicked
// (`<file>:<line>`, kept after its text there; none: link_len 0). Mara
// code's: what's open at its start (code_token's state), from the line
// above it. A fold's (lines_fold) — a fun's signature: the lines it shows
// and hides, clicked; a line hidden isn't drawn or copied.
Line :: struct {
	at:    i64
	len:   i64
	style: i64
	link_at:  i64
	link_len: i64
	state: i64
	fold_at:  i64   // the first line it shows and hides
	fold_len: i64   // ... how many; 0: none, not a fold's
	hidden:   bool
}

// A place in the lines' text: `off` bytes into line `line`.
Spot :: struct {
	line: i64
	off:  i64
}

// A row drawn: a line, or as much of one as the width holds — its text
// Lines.text[at : at + len], drawn `indent` in.
Line_Row :: struct {
	line:   i64   // the line it's part of
	at:     i64
	len:    i64
	indent: f32   // the line's own indent, for its rows after the first
}

Lines :: struct {
	text:   [2 * MB]utf8
	lines:  [50000]Line
	status: [400]utf8   // the status line; none when empty
	status_style: i64
	scroll: i64           // the first row shown
	cut:    bool          // more came than it holds: the rest left out
	lit:    i64 = -1      // a line lit, all its rows (the call under the mouse); -1: none
	// What's selected: from where the mouse pressed to where it is (or was
	// let go) — none when they're the same place.
	anchor: Spot
	caret:  Spot
	// The lines wrapped (lines_wrap): to rows_w wide, rows_lines of them.
	rows:   [100000]Line_Row
	rows_w: f32
	rows_lines: i64
}

// Emptied: no lines, no status line, at the top.
lines_clear :: fun(l: ^Lines) {
	l.text.len = 0
	l.lines.len = 0
	l.status.len = 0
	l.status_style = STYLE_DIM
	l.scroll = 0
	l.cut = false
	l.rows.len = 0
	l.rows_lines = 0
	l.anchor = Spot{0}
	l.caret = Spot{0}
}

// A line added in a style: its tabs as spaces, a carriage return left out.
lines_add :: fun(l: ^Lines, s: []utf8, style: i64) {
	if l.lines.len == l.lines.cap or l.text.len + s.len * TAB_SPACES > l.text.cap {
		l.cut = true
		return
	}
	// (Mara code's line after another: what's open where that one ends.)
	state : i64 = 0
	if style == STYLE_MARA and l.lines.len > 0 {
		above := l.lines[l.lines.len - 1]
		if above.style == STYLE_MARA do state = code_state_after(l.text[above.at : above.at + above.len], above.state)
	}
	at := l.text.len
	for ch in s {
		if ch == '\t' {
			for _ in 0 ..< TAB_SPACES {
				&l.text + ' '
			}
		elif ch != '\r'
			&l.text + ch
		}
	}
	&l.lines + Line{at = at, len = l.text.len - at, style = style, state = state, link_at = 0, link_len = 0, fold_at = 0, fold_len = 0, hidden = false}
}

// Line k's text.
line_text :: fun(l: ^Lines, k: i64) -> []utf8 {
	ln := l.lines[k]
	return l.text[ln.at : ln.at + ln.len]
}

// The place line k opens, clicked — `<file>:<line>`; empty for none.
line_link :: fun(l: ^Lines, k: i64) -> []utf8 {
	ln := l.lines[k]
	return l.text[ln.link_at : ln.link_at + ln.link_len]
}

// The line added last given a place it opens, clicked (line_link).
lines_link :: fun(l: ^Lines, link: []utf8) {
	if l.lines.len == 0 or l.text.len + link.len > l.text.cap do return
	ln := &l.lines[l.lines.len - 1]
	ln.link_at = l.text.len
	ln.link_len = link.len
	&l.text + link
}

// The n lines from k — a fun's signature — made a fold's: clicked, they show
// or hide the `count` lines right after them, hidden at first.
lines_fold :: fun(l: ^Lines, k: i64, n: i64, count: i64) {
	if count <= 0 do return
	for i in k ..< k + n {
		l.lines[i].fold_at = k + n
		l.lines[i].fold_len = count
	}
	for i in k + n ..< k + n + count {
		l.lines[i].hidden = true
	}
}

// Whether line k is a fold's first (its mark drawn before it).
lines_fold_head :: fun(l: ^Lines, k: i64) -> bool {
	ln := l.lines[k]
	if ln.fold_len == 0 do return false
	if k == 0 do return true
	above := l.lines[k - 1]
	return above.fold_len == 0 or above.fold_at != ln.fold_at
}

// Line k clicked: a fold's, the lines it shows and hides shown when they're
// hidden, else hidden — all wrapped again, the scroll kept at its line.
// Whether it was a fold's.
lines_toggle :: fun(l: ^Lines, k: i64) -> bool {
	if k < 0 or k >= l.lines.len do return false
	ln := l.lines[k]
	if ln.fold_len == 0 do return false
	hide := not l.lines[ln.fold_at].hidden
	for i in ln.fold_at ..< ln.fold_at + ln.fold_len {
		l.lines[i].hidden = hide
	}
	l.rows_w = -1.0
	return true
}

// Whether line k is lit: the line lit, or a line of the same fold's (a
// signature's lines lit together).
lines_lit :: fun(l: ^Lines, k: i64) -> bool {
	if k == l.lit do return true
	if l.lit < 0 or l.lit >= l.lines.len do return false
	lit := l.lines[l.lit]
	ln := l.lines[k]
	return lit.fold_len > 0 and ln.fold_len > 0 and ln.fold_at == lit.fold_at
}

// The status line: its text, in a style (as much as it holds).
lines_status :: fun(l: ^Lines, s: []utf8, style: i64) {
	l.status.len = 0
	&l.status + s[0 : min_int(s.len, l.status.cap)]
	l.status_style = style
}

// How wide the text drawn in r is: what rows wrap to.
lines_width :: fun(r: Rect) -> f32 {
	return max_f32(r.w - 2.0 * PAD, 40.0)
}

// The lines wrapped to rows w wide: all of them again when the width
// changed — the scroll kept at the line it showed first — else the lines
// added since; a hidden line, none. (No room for more rows: the lines after
// them left out.)
lines_wrap :: fun(ui: ^Ui, l: ^Lines, w: f32) {
	top : i64 = -1
	if w != l.rows_w {
		if l.scroll >= 0 and l.scroll < l.rows.len do top = l.rows[l.scroll].line
		l.rows_w = w
		l.rows.len = 0
		l.rows_lines = 0
	}
	for l.rows_lines < l.lines.len {
		ln := l.lines[l.rows_lines]
		if ln.hidden {
			l.rows_lines += 1
		elif not wrap(ui, l.text[ln.at : ln.at + ln.len], ln.style, w, l.rows_lines, ln.at, &l.rows)
			l.rows_lines = l.lines.len
			l.cut = true
		else
			l.rows_lines += 1
		}
	}
	if top >= 0 {
		l.scroll = 0
		for l.scroll < l.rows.len {
			if l.rows[l.scroll].line >= top do break
			l.scroll += 1
		}
	}
}

// How many rows the lines take, wrapped to r's width.
lines_rows :: fun(ui: ^Ui, l: ^Lines, r: Rect) -> i64 {
	lines_wrap(ui, l, lines_width(r))
	return l.rows.len
}

// Text s, a line of `style`, wrapped to rows w wide, added to rows: each one
// line's part of s — from base + its start in s — the rows after the first
// as far in as s's own indent (half the width at most). Whether there was
// room for them all. (Each character measured in its font: line_char.)
wrap :: fun(ui: ^Ui, s: []utf8, style: i64, w: f32, line: i64, base: i64, rows: ^[]Line_Row) -> bool {
	lead : i64 = 0
	for lead < s.len {
		if s[lead] != ' ' do break
		lead += 1
	}
	indent := min_f32(line_width(ui, style, s, 0, lead), w / 2.0)
	at : i64 = 0
	x : f32 = 0
	more := true
	for more {
		if rows.len == rows.cap do return false
		end := row_end(ui, s, style, at, w - x)
		rows.len += 1
		rows[rows.len - 1] = Line_Row{line = line, at = base + at, len = end - at, indent = x}
		// (The spaces it broke at shown by neither row.)
		at = end
		for at < s.len {
			if s[at] != ' ' do break
			at += 1
		}
		more = at < s.len
		x = indent
	}
	return true
}

// Where the row from `at` ends, w wide, in a line s of `style`: at the last
// space after a word before what doesn't fit, else within the word — a
// character in at least. s's end when the rest fits.
row_end :: fun(ui: ^Ui, s: []utf8, style: i64, at: i64, w: f32) -> i64 {
	x : f32 = 0
	space : i64 = -1
	word := false
	code := style == STYLE_DOC and doc_code_at(s, at)
	k := at
	for k < s.len {
		c, _ := char_at(s, k)
		cw, n := line_char(ui, style, s, k, &code)
		if c == u32(' ') and word do space = k
		x += cw
		if x > w {
			if space > at do return space
			if k > at do return k
			return k + n
		}
		if c != u32(' ') do word = true
		k += n
	}
	return s.len
}

// How far s[at]'s character moves the pen in a line of `style`, and its
// bytes: Mara code's in the monospace font (its margin, code_margin, in the
// text's, so code starts where text does); doc text's (STYLE_DOC) what's
// between paired backticks too, the backticks and the rest in the text's.
// `code`: whether doc text's code is open before it, then after it.
line_char :: fun(ui: ^Ui, style: i64, s: []utf8, at: i64, code: ^bool) -> f32, i64 {
	c, n := char_at(s, at)
	if style == STYLE_MARA {
		if at < code_margin(s) do return char_width(&ui.text, c), n
		return char_width(&ui.mono, c), n
	}
	if style != STYLE_DOC do return char_width(&ui.text, c), n
	if c == u32('`') and (code^ or tick_after(s, at + 1)) {
		code^ = not code^
		return char_width(&ui.text, c), n
	}
	if code^ do return char_width(&ui.mono, c), n
	return char_width(&ui.text, c), n
}

// A code line's margin: its first spaces, CODE_MARGIN at most.
code_margin :: fun(s: []utf8) -> i64 {
	k : i64 = 0
	for k < CODE_MARGIN and k < s.len and s[k] == ' ' {
		k += 1
	}
	return k
}

// How wide s[from : to] is drawn, s a line of `style` (line_char).
line_width :: fun(ui: ^Ui, style: i64, s: []utf8, from: i64, to: i64) -> f32 {
	code := style == STYLE_DOC and doc_code_at(s, from)
	w : f32 = 0
	k := from
	for k < to {
		cw, n := line_char(ui, style, s, k, &code)
		w += cw
		k += n
	}
	return w
}

// Whether doc text s is in code at `at`: the backticks before it, each
// opening one paired with one after it.
doc_code_at :: fun(s: []utf8, at: i64) -> bool {
	code := false
	for k in 0 ..< at {
		if s[k] == '`' and (code or tick_after(s, k + 1)) do code = not code
	}
	return code
}

// The status line's height, wrapped to r's width; 0 for none.
status_height :: fun(ui: ^Ui, l: ^Lines, r: Rect) -> f32 {
	if l.status.len == 0 do return 0
	rows : [STATUS_ROWS]Line_Row
	_ = wrap(ui, l.status[:], STYLE_TEXT, lines_width(r), 0, 0, &rows)
	return f32(rows.len) * ui.text.line + 2.0 * ROW_PAD
}

STATUS_ROWS :: 12   // the most rows a status line or a hint wraps to

// How many rows fit in r, room kept for the status line.
lines_visible :: fun(ui: ^Ui, l: ^Lines, r: Rect) -> i64 {
	h := r.h - 2.0 * PAD - status_height(ui, l, r)
	return max_int(i64(h / ui.text.line), 1)
}

// The lines drawn in r: from the scroll, as many rows as fit — what's
// selected behind them — a scroll bar when they don't all; the status line
// at its bottom. With none, `empty`, dim.
draw_lines :: fun(ui: ^Ui, l: ^Lines, r: Rect, empty: []utf8) {
	rd := ui.renderer
	w := lines_width(r)
	lines_wrap(ui, l, w)
	shown := lines_visible(ui, l, r)
	l.scroll = max_int(0, min_int(l.scroll, l.rows.len - shown))
	if l.lines.len == 0 do _ = draw_wrapped(ui, empty, STYLE_DIM, r.x + PAD, r.y + PAD, w)
	from, to := lines_selection(l)
	selected := spot_before(from, to)
	y := r.y + PAD
	for k in 0 ..< shown {
		at := l.scroll + k
		if at >= l.rows.len do break
		row := l.rows[at]
		ln := l.lines[row.line]
		x := r.x + PAD + row.indent
		if lines_lit(l, row.line) do fill(rd, r.x, y, r.w, ui.text.line, ui.hover)
		if selected do draw_selected(ui, l, row, from, to, x, y)
		// (A fold's mark: where its first line starts, in the room code's
		// lines are indented by.)
		if row.at == ln.at and lines_fold_head(l, row.line) do draw_fold_mark(ui, r.x + PAD, y, not l.lines[ln.fold_at].hidden)
		if ln.style == STYLE_MARA {
			draw_code_row(ui, l, row, x, y)
		elif ln.style == STYLE_DOC
			draw_doc_row(ui, l, row, x, y)
		else
			draw_line(ui, l.text[row.at : row.at + row.len], ln.style, row.at == ln.at, x, y)
		}
		y += ui.text.line
	}
	if l.rows.len > shown {
		track := f32(shown) * ui.text.line
		thumb := max_f32(track * f32(shown) / f32(l.rows.len), 20.0)
		thumb_y := r.y + PAD + (track - thumb) * f32(l.scroll) / f32(l.rows.len - shown)
		fill(rd, r.x + r.w - 8.0, thumb_y, 5.0, thumb, ui.dim)
	}
	if l.status.len > 0 {
		h := status_height(ui, l, r)
		fill(rd, r.x, r.y + r.h - h, r.w, h, ui.header)
		_ = draw_wrapped(ui, l.status[:], l.status_style, r.x + PAD, r.y + r.h - h + ROW_PAD, w)
	}
}

// A fold's mark, centered on x in the row at y: ▸ shut, ▾ open — a
// triangle, filled a row of pixels at a time.
draw_fold_mark :: fun(ui: ^Ui, x: f32, y: f32, open: bool) {
	s := floor_f32(ui.text.line * 0.4)   // how wide pointing down, how tall pointing right
	t := floor_f32(s * 0.75)             // ... the other way
	if open {
		top := y + floor_f32((ui.text.line - t) / 2.0)
		for i in 0 ..< i64(t) {
			w := s * (1.0 - (f32(i) + 0.5) / t)
			fill(ui.renderer, x - w / 2.0, top + f32(i), w, 1.0, ui.dim)
		}
		return
	}
	top := y + floor_f32((ui.text.line - s) / 2.0)
	for i in 0 ..< i64(s) {
		off := abs_f32(f32(i) + 0.5 - s / 2.0) / (s / 2.0)
		fill(ui.renderer, x - t / 2.0, top + f32(i), t * (1.0 - off), 1.0, ui.dim)
	}
}

// The line under (x, y) in the lines drawn in r, as last drawn; -1 for none.
lines_line_at :: fun(ui: ^Ui, l: ^Lines, r: Rect, x: f32, y: f32) -> i64 {
	if not inside(r, x, y) or y < r.y + PAD do return -1
	k := i64(floor_f32((y - r.y - PAD) / ui.text.line))
	if k >= lines_visible(ui, l, r) do return -1
	at := l.scroll + k
	if at >= l.rows.len do return -1
	return l.rows[at].line
}

// Text drawn wrapped to w, from (x, y), in a style; the y below it.
draw_wrapped :: fun(ui: ^Ui, s: []utf8, style: i64, x: f32, y: f32, w: f32) -> f32 {
	rows : [STATUS_ROWS]Line_Row
	_ = wrap(ui, s, STYLE_TEXT, w, 0, 0, &rows)
	at_y := y
	for row in rows {
		draw_line(ui, s[row.at : row.at + row.len], style, row.at == 0, x + row.indent, at_y)
		at_y += ui.text.line
	}
	return at_y
}

// A row drawn at (x, y) in its line's style — `first`: the line's first row.
draw_line :: fun(ui: ^Ui, s: []utf8, style: i64, first: bool, x: f32, y: f32) {
	if style == STYLE_TITLE and first {
		word : i64 = 0
		for word < s.len {
			if s[word] == ' ' do break
			word += 1
		}
		pen := text_draw(&ui.text, ui.renderer, s[0 : word], x, y, ui.accent)
		_ = text_draw(&ui.text, ui.renderer, s[word : s.len], pen, y, ui.dim)
		return
	}
	// (A heading's rows after its first: dim, as the rest of its first.)
	if style == STYLE_TITLE {
		_ = text_draw(&ui.text, ui.renderer, s, x, y, ui.dim)
		return
	}
	_ = text_draw(&ui.text, ui.renderer, s, x, y, style_color(ui, style))
}

// A style's color.
style_color :: fun(ui: ^Ui, style: i64) -> Color {
	if style == STYLE_DIM do return ui.dim
	if style == STYLE_CODE or style == STYLE_MARA do return ui.code
	if style == STYLE_BAD do return ui.bad
	if style == STYLE_QUERY or style == STYLE_TITLE do return ui.accent
	return ui.ink
}
