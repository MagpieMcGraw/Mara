module view

use mara.core
use mara.string
use mara.os
use mara.math
use mara.sdl

// The window's panels: boxes it shows, each a view of something — the
// profile, the docs, the asked query, the last crash, the keys — floating over the window's
// ground. A panel is dragged by its title bar and resized by its edges and
// corners; the one clicked comes to the front, its title bar's x hides it.
// The menu bar's Panels menu shows or hides each and resets their layout;
// its Theme menu makes the window dark or light. The layout — the window's
// size, the theme, each panel's place, size, shown or not, front to back —
// is kept in layout.txt beside the window's program: read when it opens,
// written when it changes and when it closes.

PROFILE_PANEL :: 0
DOCS_PANEL    :: 1
ASK_PANEL     :: 2
KEYS_PANEL    :: 3
CRASH_PANEL   :: 4
PANEL_KINDS   :: 5

// The menu bar's menus; MENU_NONE: none open.
MENU_NONE   :: -1
MENU_PANELS :: 0
MENU_THEME  :: 1
MENUS       :: 2

GRAB_OUT :: 5.0   // how far outside its border the mouse resizes a panel, pixels
GRAB_IN  :: 3.0   // and inside it — but at its top: there its title bar moves it
MIN_W  :: 200.0   // the least a panel is
MIN_H  :: 100.0
MARGIN :: 6.0     // the default layout's room around a panel

// What the mouse is doing with a panel, from a press on it to the release.
DRAG_NONE   :: 0
DRAG_MOVE   :: 1
DRAG_RESIZE :: 2

// The edges a resize moves (bits).
EDGE_LEFT   :: 1
EDGE_RIGHT  :: 2
EDGE_TOP    :: 4
EDGE_BOTTOM :: 8

// A rectangle in the window, pixels.
Rect :: struct {
	x: f32
	y: f32
	w: f32
	h: f32
}

Panel :: struct {
	kind:  i64     // PROFILE_PANEL, ...
	shown: bool
	box:   Rect    // its frame in the window: its title bar, then its content
}

// A panel kind's title, as its title bar and the menu show it.
panel_title :: fun(kind: i64) -> []utf8 {
	if kind == PROFILE_PANEL do return "Profile"
	if kind == DOCS_PANEL do return "Docs"
	if kind == ASK_PANEL do return "Ask"
	if kind == CRASH_PANEL do return "Crash"
	return "Keys"
}

// A panel kind's name in layout.txt.
panel_name :: fun(kind: i64) -> []utf8 {
	if kind == PROFILE_PANEL do return "profile"
	if kind == DOCS_PANEL do return "docs"
	if kind == ASK_PANEL do return "ask"
	if kind == CRASH_PANEL do return "crash"
	return "keys"
}

// The menu bar's height, and a title bar's.
bar_height :: fun(ui: ^Ui) -> f32 {
	return ui.text.line + 2.0 * ROW_PAD
}

// Whether (x, y) is inside r.
inside :: fun(r: Rect, x: f32, y: f32) -> bool {
	return x >= r.x and x < r.x + r.w and y >= r.y and y < r.y + r.h
}

// A panel's content: its box less its title bar and its border.
content_rect :: fun(ui: ^Ui, pn: Panel) -> Rect {
	bar := bar_height(ui)
	return Rect{x = pn.box.x + 1.0, y = pn.box.y + bar, w = pn.box.w - 2.0, h = pn.box.h - bar - 1.0}
}

// A panel's close box: the title bar's right end.
close_rect :: fun(ui: ^Ui, pn: Panel) -> Rect {
	bar := bar_height(ui)
	return Rect{x = pn.box.x + pn.box.w - bar, y = pn.box.y, w = bar, h = bar}
}

// The Docs panel's pin: in its title bar, left of its close box.
pin_rect :: fun(ui: ^Ui, pn: Panel) -> Rect {
	close := close_rect(ui, pn)
	w := text_width(&ui.text, pin_label(ui)) + 2.0 * PAD
	return Rect{x = close.x - w, y = close.y, w = w, h = close.h}
}

// The Docs panel's reload: left of its pin (docs_reload).
reload_rect :: fun(ui: ^Ui, pn: Panel) -> Rect {
	pin := pin_rect(ui, pn)
	w := text_width(&ui.text, "reload") + 2.0 * PAD
	return Rect{x = pin.x - w, y = pin.y, w = w, h = pin.h}
}

// The pin's label: "pin"; pinned, "pinned" — "pinned · new" once a lookup
// waits behind it.
pin_label :: fun(ui: ^Ui) -> []utf8 {
	if not ui.docs_pinned do return "pin"
	if ui.docs_newer do return "pinned · new"
	return "pinned"
}

// The panel of a kind: its place in ui.panels.
find_panel :: fun(ui: ^Ui, kind: i64) -> i64 {
	for pn, i in ui.panels {
		if pn.kind == kind do return i
	}
	return -1
}

// The front panel shown at (x, y): its place in ui.panels; -1 for none.
panel_at :: fun(ui: ^Ui, x: f32, y: f32) -> i64 {
	i := ui.panels.len - 1
	for i >= 0 {
		if ui.panels[i].shown and inside(ui.panels[i].box, x, y) do return i
		i -= 1
	}
	return -1
}

// The front panel shown that a press at (x, y) takes: one it's in, or one
// whose border it's near enough to resize by; its place in ui.panels, -1
// for none.
panel_grab_at :: fun(ui: ^Ui, x: f32, y: f32) -> i64 {
	i := ui.panels.len - 1
	for i >= 0 {
		if ui.panels[i].shown {
			b := ui.panels[i].box
			if inside(b, x, y) or edges_at(b, x, y) != 0 do return i
		}
		i -= 1
	}
	return -1
}

// The front panel shown: its place in ui.panels; -1 for none.
front_panel :: fun(ui: ^Ui) -> i64 {
	i := ui.panels.len - 1
	for i >= 0 {
		if ui.panels[i].shown do return i
		i -= 1
	}
	return -1
}

// Panel i moved to the front — the end of ui.panels: its place now.
bring_to_front :: fun(ui: ^Ui, i: i64) -> i64 {
	last := ui.panels.len - 1
	pn := ui.panels[i]
	for k in i .. last {
		ui.panels[k] = ui.panels[k + 1]
	}
	ui.panels[last] = pn
	return last
}

// The panels as they first are: the profile at the left, the docs and the
// asked query stacked at its right; the keys, hidden, over the docs; the
// last crash, hidden until there's one, over the profile's lower half.
default_layout :: fun(ui: ^Ui) {
	top := bar_height(ui)
	ui.panels.len = 0
	room_h := ui.height - top - 2.0 * MARGIN
	left_w := floor_f32((ui.width - 3.0 * MARGIN) * 0.55)
	right_x := MARGIN + left_w + MARGIN
	right_w := ui.width - right_x - MARGIN
	upper_h := floor_f32((room_h - MARGIN) * 0.5)
	keys := Panel{kind = KEYS_PANEL, shown = false}
	keys.box = Rect{x = ui.width - 520.0 - 4.0 * MARGIN, y = top + 4.0 * MARGIN, w = 520.0, h = 330.0}
	&ui.panels + keys
	profile := Panel{kind = PROFILE_PANEL, shown = true}
	profile.box = Rect{x = MARGIN, y = top + MARGIN, w = left_w, h = room_h}
	&ui.panels + profile
	docs := Panel{kind = DOCS_PANEL, shown = true}
	docs.box = Rect{x = right_x, y = top + MARGIN, w = right_w, h = upper_h}
	&ui.panels + docs
	ask := Panel{kind = ASK_PANEL, shown = true}
	ask.box = Rect{x = right_x, y = top + MARGIN + upper_h + MARGIN, w = right_w, h = room_h - upper_h - MARGIN}
	&ui.panels + ask
	crash := Panel{kind = CRASH_PANEL, shown = false}
	crash.box = Rect{x = MARGIN, y = top + MARGIN + upper_h + MARGIN, w = left_w, h = room_h - upper_h - MARGIN}
	&ui.panels + crash
	clamp_panels(ui)
}

// Each panel kept inside the window, below the menu bar, no smaller than
// the least.
clamp_panels :: fun(ui: ^Ui) {
	top := bar_height(ui)
	for i in 0 .. ui.panels.len {
		b := ui.panels[i].box
		b.w = max_f32(MIN_W, min_f32(b.w, ui.width))
		b.h = max_f32(MIN_H, min_f32(b.h, ui.height - top))
		b.x = max_f32(0, min_f32(b.x, ui.width - b.w))
		b.y = max_f32(top, min_f32(b.y, ui.height - b.h))
		ui.panels[i].box = b
	}
}

// The edges of b the mouse at (x, y) is near enough to resize by (bits):
// within GRAB_OUT outside its border or GRAB_IN inside — at its top, only
// above it: a press on its title bar moves it, never resizes.
edges_at :: fun(b: Rect, x: f32, y: f32) -> i64 {
	if x < b.x - GRAB_OUT or x >= b.x + b.w + GRAB_OUT do return 0
	if y < b.y - GRAB_OUT or y >= b.y + b.h + GRAB_OUT do return 0
	edges : i64 = 0
	if x < b.x + GRAB_IN do edges = edges | EDGE_LEFT
	if x >= b.x + b.w - GRAB_IN do edges = edges | EDGE_RIGHT
	if y < b.y do edges = edges | EDGE_TOP
	if y >= b.y + b.h - GRAB_IN do edges = edges | EDGE_BOTTOM
	return edges
}

// A press of the mouse at (x, y): with a menu open, its item — on another
// menu's button, that menu; on a menu's button, its menu; on a panel, it
// brought to the front and then — near its edges, a resize; on its title
// bar, a move (its x: hidden); in its content, the panel's own click.
press :: fun(ui: ^Ui, p: ^Profile, x: f32, y: f32) {
	ui.dirty = true
	if ui.menu_open != MENU_NONE {
		m := ui.menu_open
		ui.menu_open = MENU_NONE
		item := menu_item_at(ui, m, x, y)
		if item >= 0 {
			menu_choose(ui, m, item)
			return
		}
		// (A click elsewhere only closes it.)
		b := menu_button_at(ui, x, y)
		if b >= 0 and b != m do ui.menu_open = b
		return
	}
	b := menu_button_at(ui, x, y)
	if b >= 0 {
		ui.menu_open = b
		return
	}
	i := panel_grab_at(ui, x, y)
	if i < 0 do return
	i = bring_to_front(ui, i)
	pn := ui.panels[i]
	ui.drag_kind = pn.kind
	ui.drag_x = x
	ui.drag_y = y
	ui.drag_box = pn.box
	edges := edges_at(pn.box, x, y)
	if edges != 0 {
		ui.drag = DRAG_RESIZE
		ui.drag_edges = edges
		return
	}
	if y < pn.box.y + bar_height(ui) {
		if inside(close_rect(ui, pn), x, y) {
			ui.panels[i].shown = false
			layout_save(ui)
			return
		}
		if pn.kind == DOCS_PANEL and inside(pin_rect(ui, pn), x, y) {
			docs_pin(ui)
			return
		}
		if pn.kind == DOCS_PANEL and inside(reload_rect(ui, pn), x, y) {
			docs_reload(ui)
			return
		}
		ui.drag = DRAG_MOVE
		return
	}
	if pn.kind == PROFILE_PANEL do profile_click(ui, p, content_rect(ui, pn), x, y)
	if pn.kind == CRASH_PANEL do crash_click(ui, content_rect(ui, pn), x, y)
	if pn.kind == DOCS_PANEL do docs_click(ui, content_rect(ui, pn), x, y)
}

// Menu m's item chosen: a panel shown or hidden, the layout reset, the
// theme.
menu_choose :: fun(ui: ^Ui, m: i64, item: i64) {
	if m == MENU_THEME {
		theme_set(ui, item == 1)
		layout_save(ui)
		return
	}
	if item < PANEL_KINDS {
		i := find_panel(ui, item)
		ui.panels[i].shown = not ui.panels[i].shown
		if ui.panels[i].shown do _ = bring_to_front(ui, i)
	else
		default_layout(ui)
	}
	layout_save(ui)
}

// The mouse moved to (x, y) while a panel is dragged: its box follows.
drag_to :: fun(ui: ^Ui, x: f32, y: f32) {
	i := find_panel(ui, ui.drag_kind)
	if i < 0 do return
	dx := x - ui.drag_x
	dy := y - ui.drag_y
	b := ui.drag_box
	if ui.drag == DRAG_MOVE {
		b.x += dx
		b.y += dy
	else
		right := b.x + b.w
		bottom := b.y + b.h
		if (ui.drag_edges & EDGE_LEFT) != 0 {
			b.x = min_f32(b.x + dx, right - MIN_W)
			b.w = right - b.x
		}
		if (ui.drag_edges & EDGE_RIGHT) != 0 do b.w = max_f32(b.w + dx, MIN_W)
		if (ui.drag_edges & EDGE_TOP) != 0 {
			b.y = min_f32(b.y + dy, bottom - MIN_H)
			b.h = bottom - b.y
		}
		if (ui.drag_edges & EDGE_BOTTOM) != 0 do b.h = max_f32(b.h + dy, MIN_H)
	}
	ui.panels[i].box = b
	clamp_panels(ui)
	ui.dirty = true
}

// The cursor's look for the mouse at (x, y): resize arrows near a panel's
// edges, else the arrow.
cursor_look :: fun(ui: ^Ui, x: f32, y: f32) -> i32 {
	if ui.menu_open != MENU_NONE do return SYSTEM_CURSOR_DEFAULT
	i := panel_grab_at(ui, x, y)
	if i < 0 do return SYSTEM_CURSOR_DEFAULT
	edges := edges_at(ui.panels[i].box, x, y)
	if edges == EDGE_LEFT | EDGE_TOP or edges == EDGE_RIGHT | EDGE_BOTTOM do return SYSTEM_CURSOR_NWSE_RESIZE
	if edges == EDGE_RIGHT | EDGE_TOP or edges == EDGE_LEFT | EDGE_BOTTOM do return SYSTEM_CURSOR_NESW_RESIZE
	if edges == EDGE_LEFT or edges == EDGE_RIGHT do return SYSTEM_CURSOR_EW_RESIZE
	if edges == EDGE_TOP or edges == EDGE_BOTTOM do return SYSTEM_CURSOR_NS_RESIZE
	return SYSTEM_CURSOR_DEFAULT
}

// The panels drawn back to front, each its frame and content; the menu bar
// over them, its menu when one's open.
draw_window :: fun(ui: ^Ui, p: ^Profile) {
	r := ui.renderer
	_ = SetRenderDrawColor(r, ui.ground.r, ui.ground.g, ui.ground.b, 255)
	_ = RenderClear(r)
	front := front_panel(ui)
	for pn, i in ui.panels {
		if pn.shown do draw_panel(ui, p, pn, i == front)
	}
	draw_menu_bar(ui)
	if ui.menu_open != MENU_NONE do draw_menu(ui, ui.menu_open)
	_ = RenderPresent(r)
}

// A panel: its border, its title bar (the front one's title brighter), its
// close box, its content — kept inside it.
draw_panel :: fun(ui: ^Ui, p: ^Profile, pn: Panel, front: bool) {
	r := ui.renderer
	b := pn.box
	bar := bar_height(ui)
	fill(r, b.x, b.y, b.w, b.h, ui.border)
	fill(r, b.x + 1.0, b.y + 1.0, b.w - 2.0, bar - 1.0, ui.header)
	title_color := ui.dim
	if front do title_color = ui.ink
	_ = text_draw(&ui.text, r, panel_title(pn.kind), b.x + PAD, b.y + ROW_PAD, title_color)
	close := close_rect(ui, pn)
	_ = text_draw(&ui.text, r, "x", close.x + floor_f32((close.w - text_width(&ui.text, "x")) * 0.5), b.y + ROW_PAD, ui.dim)
	if pn.kind == DOCS_PANEL {
		pin := pin_rect(ui, pn)
		pin_color := ui.dim
		if ui.docs_pinned do pin_color = ui.accent
		_ = text_draw(&ui.text, r, pin_label(ui), pin.x + PAD, b.y + ROW_PAD, pin_color)
		reload := reload_rect(ui, pn)
		_ = text_draw(&ui.text, r, "reload", reload.x + PAD, b.y + ROW_PAD, ui.dim)
	}

	c := content_rect(ui, pn)
	fill(r, c.x, c.y, c.w, c.h, ui.background)
	clip := SDL_Rect{x = i32(c.x), y = i32(c.y), w = i32(c.w), h = i32(c.h)}
	_ = SetRenderClipRect(r, &clip)
	if pn.kind == PROFILE_PANEL {
		draw_profile(ui, p, c)
	elif pn.kind == DOCS_PANEL
		draw_docs(ui, c)
	elif pn.kind == ASK_PANEL
		draw_ask(ui, c)
	elif pn.kind == CRASH_PANEL
		draw_crash(ui, c)
	else
		draw_keys(ui, c)
	}
	_ = SetRenderClipRect(r, void)
}

// The Ask panel: what's at the editor's cursor at its top (mara ask
// -cursor: as many lines as it has, up to CURSOR_LINES), a line under it,
// then the query asked, its answer, below.
draw_ask :: fun(ui: ^Ui, r: Rect) {
	asked_hint := "Queries Sublime's Mara Ask asks (mara ask -show) show here, with their answers."
	if ui.at_cursor.lines.len == 0 {
		draw_lines(ui, &ui.asked, r, asked_hint)
		return
	}
	n := min_int(lines_rows(ui, &ui.at_cursor, r), CURSOR_LINES)
	h := min_f32(2.0 * PAD + f32(n) * ui.text.line, r.h)
	draw_lines(ui, &ui.at_cursor, Rect{x = r.x, y = r.y, w = r.w, h = h}, "")
	fill(ui.renderer, r.x, r.y + h, r.w, 1.0, ui.border)
	rest := Rect{x = r.x, y = r.y + h + 1.0, w = r.w, h = r.h - h - 1.0}
	if rest.h >= 2.0 * PAD + ui.text.line do draw_lines(ui, &ui.asked, rest, asked_hint)
}

CURSOR_LINES :: 12   // the most lines of what's at the cursor shown

// A menu's name, as its button shows it.
menu_name :: fun(m: i64) -> []utf8 {
	if m == MENU_PANELS do return "Panels"
	return "Theme"
}

// Menu m's button in the menu bar: after the ones before it.
menu_button_rect :: fun(ui: ^Ui, m: i64) -> Rect {
	x : f32 = 0
	for k in 0 .. m {
		x += text_width(&ui.text, menu_name(k)) + 2.0 * PAD
	}
	return Rect{x = x, y = 0, w = text_width(&ui.text, menu_name(m)) + 2.0 * PAD, h = bar_height(ui)}
}

// The menu button at (x, y); -1 for none.
menu_button_at :: fun(ui: ^Ui, x: f32, y: f32) -> i64 {
	for m in 0 .. MENUS {
		if inside(menu_button_rect(ui, m), x, y) do return m
	}
	return -1
}

// How many items menu m has: the Panels menu, each panel kind and Reset
// layout; the Theme menu, Dark and Light.
menu_items :: fun(m: i64) -> i64 {
	if m == MENU_PANELS do return PANEL_KINDS + 1
	return 2
}

// Item k of menu m, as the menu shows it.
menu_item_text :: fun(m: i64, k: i64) -> []utf8 {
	if m == MENU_THEME {
		if k == 0 do return "Dark"
		return "Light"
	}
	if k == PANEL_KINDS do return "Reset layout"
	return panel_title(k)
}

// Whether item k of menu m is ticked: a panel shown, the theme chosen.
menu_item_ticked :: fun(ui: ^Ui, m: i64, k: i64) -> bool {
	if m == MENU_THEME do return (k == 1) == ui.light
	if k == PANEL_KINDS do return false
	i := find_panel(ui, k)
	if i < 0 do return false
	return ui.panels[i].shown
}

// Whether item k of menu m has a box to tick (Reset layout hasn't).
menu_item_boxed :: fun(m: i64, k: i64) -> bool {
	return not (m == MENU_PANELS and k == PANEL_KINDS)
}

// Menu m's width: its widest item's, a box to tick beside it, room.
menu_width :: fun(ui: ^Ui, m: i64) -> f32 {
	w : f32 = 0
	for k in 0 .. menu_items(m) {
		w = max_f32(w, text_width(&ui.text, menu_item_text(m, k)))
	}
	return ceil_f32(w + ui.text.line + 3.0 * PAD)
}

// Item k of menu m, below its button: Reset layout below a line.
menu_item_rect :: fun(ui: ^Ui, m: i64, k: i64) -> Rect {
	bar := bar_height(ui)
	y := bar + f32(k) * bar
	if m == MENU_PANELS and k == PANEL_KINDS do y += 5.0
	return Rect{x = menu_button_rect(ui, m).x, y = y, w = menu_width(ui, m), h = bar}
}

// Menu m's item at (x, y); -1 for none.
menu_item_at :: fun(ui: ^Ui, m: i64, x: f32, y: f32) -> i64 {
	for k in 0 .. menu_items(m) {
		if inside(menu_item_rect(ui, m, k), x, y) do return k
	}
	return -1
}

// The menu bar: its menus' buttons, the open one's lit.
draw_menu_bar :: fun(ui: ^Ui) {
	r := ui.renderer
	bar := bar_height(ui)
	fill(r, 0, 0, ui.width, bar, ui.header)
	fill(r, 0, bar - 1.0, ui.width, 1.0, ui.border)
	for m in 0 .. MENUS {
		button := menu_button_rect(ui, m)
		if ui.menu_open == m do fill(r, button.x, button.y, button.w, button.h - 1.0, ui.hover)
		_ = text_draw(&ui.text, r, menu_name(m), button.x + PAD, ROW_PAD, ui.ink)
	}
}

// Menu m: its items, each with a box, filled when it's ticked.
draw_menu :: fun(ui: ^Ui, m: i64) {
	r := ui.renderer
	n := menu_items(m)
	last := menu_item_rect(ui, m, n - 1)
	top := bar_height(ui)
	x := last.x
	w := last.w
	fill(r, x, top, w + 1.0, last.y + last.h - top + 1.0, ui.border)
	fill(r, x, top, w, last.y + last.h - top, ui.header)
	hovered := menu_item_at(ui, m, ui.mouse_x, ui.mouse_y)
	ui.menu_hover = hovered
	box := floor_f32(ui.text.line * 0.6)
	for k in 0 .. n {
		item := menu_item_rect(ui, m, k)
		if k == hovered do fill(r, item.x, item.y, item.w, item.h, ui.hover)
		if not menu_item_boxed(m, k) {
			fill(r, x + PAD, item.y - 3.0, w - 2.0 * PAD, 1.0, ui.border)
			_ = text_draw(&ui.text, r, menu_item_text(m, k), x + PAD, item.y + ROW_PAD, ui.ink)
			continue
		}
		bx := x + PAD
		by := floor_f32(item.y + (item.h - box) * 0.5)
		fill(r, bx, by, box, box, ui.dim)
		fill(r, bx + 1.0, by + 1.0, box - 2.0, box - 2.0, ui.header)
		if menu_item_ticked(ui, m, k) do fill(r, bx + 3.0, by + 3.0, box - 6.0, box - 6.0, ui.accent)
		_ = text_draw(&ui.text, r, menu_item_text(m, k), bx + box + PAD, item.y + ROW_PAD, ui.ink)
	}
}

// The Keys panel: what the mouse and keys do.
draw_keys :: fun(ui: ^Ui, r: Rect) {
	keys : [15][]utf8
	does : [15][]utf8
	keys[0] = "Click a column title"
	does[0] = "sort the profile by it; again: the other way"
	keys[1] = "Wheel"
	does[1] = "scroll the panel under the mouse"
	keys[2] = "Up, Down, PageUp, PageDown, Home, End"
	does[2] = "scroll the front panel"
	keys[3] = "Shift+wheel, Left, Right"
	does[3] = "scroll the profile sideways"
	keys[4] = "Select words in Sublime"
	does[4] = "Docs looks them up (the Mara Ask plugin)"
	keys[5] = "Mara Ask in Sublime"
	does[5] = "Ask shows its query and answer"
	keys[6] = "Drag a title bar"
	does[6] = "move its panel"
	keys[7] = "Drag an edge or corner"
	does[7] = "resize its panel"
	keys[8] = "x in a title bar"
	does[8] = "hide its panel"
	keys[9] = "Panels (top left)"
	does[9] = "show or hide panels, reset the layout"
	keys[10] = "Theme (top left)"
	does[10] = "dark or light"
	keys[11] = "pin in the Docs title bar"
	does[11] = "keep what's shown; lookups wait until it's unpinned"
	keys[12] = "Click a call in Crash"
	does[12] = "open its file at its line in the editor"
	keys[13] = "Click a title in Docs"
	does[13] = "open the file it's defined in, at its line, in the editor"
	keys[14] = "F5, or reload in the Docs title bar"
	does[14] = "look what Docs shows up again: your edits shown, the scroll kept"
	widest : f32 = 0
	for k in keys {
		widest = max_f32(widest, text_width(&ui.text, k))
	}
	// (What each does wraps in its column.)
	does_x := r.x + 2.0 * PAD + widest
	does_w := max_f32(r.x + r.w - PAD - does_x, 40.0)
	y := r.y + PAD
	for k, i in keys {
		_ = text_draw(&ui.text, ui.renderer, k, r.x + PAD, y, ui.ink)
		y = draw_wrapped(ui, does[i], STYLE_DIM, does_x, y, does_w) + ROW_PAD
	}
}

// The layout written to layout.txt:
//   mara view layout
//   window <width> <height>
//   theme <dark or light>
//   panel <name> <shown: 0 or 1> <x> <y> <width> <height>   (back to front)
// (A layout that can't be written is just not kept.)
layout_save :: fun(ui: ^Ui) {
	text : [..1000]utf8
	&text + "mara view layout\nwindow "
	&text + int_text(i64(ui.width))
	&text + " "
	&text + int_text(i64(ui.height))
	&text + "\ntheme "
	if ui.light {
		&text + "light"
	else
		&text + "dark"
	}
	&text + "\n"
	for pn in ui.panels {
		&text + "panel "
		&text + panel_name(pn.kind)
		&text + " "
		&text + int_text(i64(pn.shown))
		&text + " "
		&text + int_text(i64(floor_f32(pn.box.x + 0.5)))
		&text + " "
		&text + int_text(i64(floor_f32(pn.box.y + 0.5)))
		&text + " "
		&text + int_text(i64(floor_f32(pn.box.w + 0.5)))
		&text + " "
		&text + int_text(i64(floor_f32(pn.box.h + 0.5)))
		&text + "\n"
	}
	id, oe := file_open_write(ui.layout_path)
	if bool(oe) do return
	_ = file_write_text(id, text[:])
	file_close(id)
}

// The layout read from layout.txt: the theme, the panels it names, in its
// order, and the window's size it had (ui.saved_width, saved_height); a
// panel kind it doesn't name, as the default layout has it. False when
// there's none — or it isn't one: the default layout then.
layout_load :: fun(ui: ^Ui) -> bool {
	buf : [..4000]byte
	if bool(read_entire_file(ui.layout_path, &buf)) do return false
	text : []utf8 = buf[:]
	ui.panels.len = 0
	first := true
	at : i64 = 0
	for at < text.len {
		end := at
		for end < text.len {
			if text[end] == '\n' do break
			end += 1
		}
		line : []utf8 = text[at : end]
		at = end + 1
		if line.len > 0 {
			if line[line.len - 1] == '\r' do line = line[0 : line.len - 1]
		}
		words : [..8]Field
		w_at : i64 = 0
		for w_at < line.len {
			w := next_word(line, w_at)
			if w.len == 0 or words.len == words.cap do break
			&words + w
			w_at = w.at + w.len
		}
		if words.len == 0 do continue
		if first {
			if line != "mara view layout" do return false
			first = false
			continue
		}
		head := line[words[0].at : words[0].at + words[0].len]
		if head == "window" and words.len == 3 {
			ui.saved_width, _ = parse_number(word_text(line, words[1]))
			ui.saved_height, _ = parse_number(word_text(line, words[2]))
		}
		if head == "theme" and words.len == 2 {
			theme_set(ui, word_text(line, words[1]) == "light")
		}
		if head == "panel" and words.len == 7 {
			name := word_text(line, words[1])
			kind : i64 = -1
			for k in 0 .. PANEL_KINDS {
				if name == panel_name(k) do kind = k
			}
			if kind >= 0 and find_panel(ui, kind) < 0 and ui.panels.len < ui.panels.cap {
				shown, _ := parse_number(word_text(line, words[2]))
				x, _ := parse_number(word_text(line, words[3]))
				y, _ := parse_number(word_text(line, words[4]))
				bw, _ := parse_number(word_text(line, words[5]))
				bh, _ := parse_number(word_text(line, words[6]))
				&ui.panels + Panel{kind = kind, shown = shown > 0.5, box = Rect{x = f32(x), y = f32(y), w = f32(bw), h = f32(bh)}}
			}
		}
	}
	if first or ui.panels.len == 0 do return false
	// (Kinds it doesn't name — panels newer than it: where the default
	// layout has them, in front, to be seen.)
	saved : [..8]Panel
	for pn in ui.panels {
		&saved + pn
	}
	default_layout(ui)
	defaults : [..8]Panel
	for pn in ui.panels {
		&defaults + pn
	}
	ui.panels.len = 0
	for pn in saved {
		&ui.panels + pn
	}
	for pn in defaults {
		named := false
		for s in saved {
			if s.kind == pn.kind do named = true
		}
		if not named do &ui.panels + pn
	}
	return true
}

// A word of a line, as text.
word_text :: fun(line: []utf8, w: Field) -> []utf8 {
	return line[w.at : w.at + w.len]
}
