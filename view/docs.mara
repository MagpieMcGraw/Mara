module view

use mara.core
use mara.os
use mara.math
use mara.memory
use mara.string

// The Docs panel's search: words — what's selected in the editor, sent by
// `mara docs` — looked up in the .mara files of the directory they came from
// (the editor's file's, `mara docs`'s; none said: the window's own), the
// stdlib's (the compiler's code/, and the directories in it) and the doc/
// pages beside it. Each definition whose name has a
// word, or whose doc comment does, is found; the best are shown first, each
// with its doc comment and its signature (a struct's body; a fun's body
// shown when its signature's clicked). Crude: it reads
// lines, not the program. A definition is a line `name :: ...`, a foreign
// block's `fun name(...)`, a struct's `name: type` (a field), or a file's
// `module name`; its doc comment, the `//` lines right above it, or a
// `/* … */` block (doc_words: the lines it shows).
//
// An example (doc/basics.mara's of each keyword and builtin) is a fun named
// example_<anything>: found by each word in backticks its doc comment's first
// line starts with (`print`, `print_int`), else by the word after example_.
// It's shown with its function, as written, and the definitions after it up
// to the next comment line at the top level. Definitions in an example
// aren't found themselves.

DOCS_SHOWN     :: 40   // the most definitions shown
DOCS_BODY      :: 40   // the most lines of a struct's body shown
DOCS_SIGNATURE :: 12   // ... of a signature with no body (a param's fun, a foreign fun)
DOCS_FUN       :: 200  // ... of a fun's code (a longer one's: how many more there are, said after)
DOCS_EXAMPLE   :: 60   // ... of an entry's example
DOC_LINES      :: 200  // the most lines of a doc comment shown

// A doc comment's line that marks it as one the user wrote or approved, in
// their style: the comments to match. Not shown.
DOC_MARK :: "#magpie"

// What a definition is.
DEF_MODULE :: 0   // a file's module: its doc comment, its `module` line
DEF_TYPE   :: 1   // a struct, union, error set: its body shown
DEF_FUN    :: 2   // its signature shown; clicked, its body below it
DEF_OTHER  :: 3   // a constant, a foreign fun: its line
DEF_FIELD  :: 4   // a struct's: its line, and the struct named
DEF_LINE   :: 5   // a line declaring what's at the cursor, no definition the scan finds: a local's, a param's
DEF_EXAMPLE :: 6  // an example (example_print): its function shown

ENTRY_PREFIX :: 8   // how long "example_" is

// What the name at the editor's cursor refers to (`mara docs at`), as the
// compiler found it: shown first. kind empty: none; path empty: a builtin or
// a keyword, shown by its entry.
Exact :: struct {
	kind: []utf8   // "fun", "type", "field", "local", "param", "keyword", ... (as `mara ask at` says)
	name: []utf8
	path: []utf8
	line: i64
	loose: bool    // its line maybe moved since (a reload): the definition by its name nearest it
}

// A lookup as made — what a reload makes again: its words, where they came
// from, what was at the cursor.
Docs_Query :: struct {
	made:  bool
	dir:   [1000]utf8
	words: [400]utf8
	kind:  [40]utf8
	name:  [200]utf8
	path:  [1000]utf8
	line:  i64
}

Docs_File :: struct {
	path: [1000]utf8
	at:   i64   // its text in Docs.source
	len:  i64
}

// A definition found: how well it matched, where it is.
Found :: struct {
	score: i64
	file:  i64       // in Docs.files
	line:  i64       // its line's number, from 1
	at:    i64       // its line's start, in its file's text
	doc:   i64       // its doc comment's first line's start; -1: none
	kind:  i64       // DEF_...
	name:  Field     // in its file's text
	owner: Field     // a field's struct's name
}

// The search's room: the files read, what's found.
Docs :: struct {
	source: [8 * MB]byte          // the files' text, one after another
	files:  [600]Docs_File
	found:  [DOCS_SHOWN]Found     // the best, best first
	count:  i64                     // how many matched in all
	query:  [400]utf8             // the words, lower case
	words:  [16]Field             // in query
	exact:  Found                   // the cursor's definition, as the scan found it
	has_exact:   bool               // ... when it did
	exact_off:   i64                // ... a loose one's lines from where it was
	root:   [1000]utf8            // the compiler's directory: a place under it shown from there
	exact_shown: bool               // the cursor's shown first, found by the scan or not
}

// The words looked up: the Docs panel shows what's found — what the name
// at the cursor refers to first, when the editor said (ex) — its status
// line how much.
// (`into`: the lines to fill — a reload's, the ones shown; -1: the ones
// shown, or while the panel's pinned, the other ones, waiting to be shown
// when it's unpinned.)
docs_search :: fun(ui: ^Ui, dir: []utf8, asked: []utf8, ex: Exact, into: i64) {
	d := &ui.search
	target := into
	if target < 0 {
		target = ui.docs_front
		if ui.docs_pinned {
			target = 1 - ui.docs_front
			ui.docs_newer = true
		}
	}
	l := &ui.docs[target]
	docs_keep_query(&ui.docs_query[target], dir, asked, ex)
	lines_clear(l)
	docs_words(d, asked)
	d.found.len = 0
	d.count = 0
	d.has_exact = false
	d.exact_off = 1 << 40
	d.exact_shown = false
	shown_query := asked[0 : min_int(asked.len, 60)]
	if d.words.len == 0 and ex.kind.len == 0 {
		none : [300]utf8
		&none + "Nothing to look up in \""
		&none + shown_query
		&none + "\": no word of two letters or more."
		lines_status(l, none[:], STYLE_DIM)
		return
	}
	docs_read(ui, d, dir)
	for f in 0:d.files.len {
		docs_scan(d, f, ex)
	}
	if ex.kind.len > 0 do docs_show_exact(d, l, ex)
	if d.exact_shown and d.found.len > 0 do lines_add(l, "Also found:", STYLE_DIM)
	for fd in d.found {
		docs_show(d, l, fd, "", "")
	}
	status : [300]utf8
	if d.exact_shown {
		&status + "At the cursor: "
		&status + ex.kind
		&status + " "
		&status + ex.name[0 : min_int(ex.name.len, 60)]
		&status + ". "
		if d.count == 0 {
			&status + "Nothing more found."
			lines_status(l, status[:], STYLE_DIM)
			return
		}
		&status + "And "
	}
	if d.count == 0 {
		&status + "Nothing found for \""
		&status + shown_query
		&status + "\""
		where_looked(ui, dir, &status)
		&status + "."
		lines_status(l, status[:], STYLE_BAD)
		return
	}
	&status + int_text(d.count)
	&status + " found for \""
	&status + shown_query
	&status + "\""
	where_looked(ui, dir, &status)
	if d.count > d.found.len {
		&status + ", the best "
		&status + int_text(d.found.len)
		&status + " shown"
	}
	&status + "."
	lines_status(l, status[:], STYLE_DIM)
}

// A lookup kept, to be made again (docs_reload).
docs_keep_query :: fun(q: ^Docs_Query, dir: []utf8, words: []utf8, ex: Exact) {
	q.made = true
	q.dir.len, q.words.len, q.kind.len, q.name.len, q.path.len = 0, 0, 0, 0, 0
	&q.dir + dir[0 : min_int(dir.len, q.dir.cap)]
	&q.words + words[0 : min_int(words.len, q.words.cap)]
	&q.kind + ex.kind[0 : min_int(ex.kind.len, q.kind.cap)]
	&q.name + ex.name[0 : min_int(ex.name.len, q.name.cap)]
	&q.path + ex.path[0 : min_int(ex.path.len, q.path.cap)]
	q.line = ex.line
}

// The lookup the Docs panel shows, made again — the files read again, your
// edits in them shown — where it is, scrolled as it was, the funs whose code
// was shown shown again: the reload button, F5. What was at the cursor is
// found by its name in its file, nearest the line it was on (edits may have
// moved it).
docs_reload :: fun(ui: ^Ui) {
	i := ui.docs_front
	l := &ui.docs[i]
	q := &ui.docs_query[i]
	if not q.made {
		lines_status(l, "Nothing to look up again yet: select words in Sublime first.", STYLE_DIM)
		ui.dirty = true
		return
	}
	// (Copies: the search keeps the query again, over these.)
	dir, words, kind, name, path : [1000]utf8
	&dir + q.dir[:]
	&words + q.words[:]
	&kind + q.kind[:]
	&name + q.name[:]
	&path + q.path[:]
	scroll := l.scroll
	open : [16 * KB]utf8
	docs_open_folds(l, &open)
	docs_search(ui, dir, words, Exact{kind = kind, name = name, path = path, line = q.line, loose = true}, i)
	docs_reopen_folds(l, open[:])
	l.scroll = scroll
	// (Where it was found now: where the next reload looks.)
	if ui.search.has_exact do q.line = ui.search.exact.line
	ui.dirty = true
}

// The funs whose code l shows, a line each into `open`: how many funs above
// it have the same signature's first line (two systems' file_read), a space,
// that line. (As many as it holds.)
docs_open_folds :: fun(l: ^Lines, open: ^[16 * KB]utf8) {
	for k in 0:l.lines.len {
		if not lines_fold_head(l, k) or l.lines[l.lines[k].fold_at].hidden do continue
		s := line_text(l, k)
		if open.len + s.len + 30 > open.cap do return
		open + int_text(fold_same_above(l, k))
		open + ' '
		open + s
		open + '\n'
	}
}

// The funs in l that `open` has a line for (docs_open_folds: a reload's),
// their code shown again.
docs_reopen_folds :: fun(l: ^Lines, open: []utf8) {
	for k in 0:l.lines.len {
		if not lines_fold_head(l, k) do continue
		key : [1100]utf8
		&key + int_text(fold_same_above(l, k))
		&key + ' '
		&key + line_text(l, k)[0 : min_int(line_text(l, k).len, 1000)]
		at : i64 = 0
		for at < open.len {
			end := at
			for end < open.len and open[end] != '\n' {
				end += 1
			}
			if open[at : end] == key[:] {
				_ = lines_toggle(l, k)
				break
			}
			at = end + 1
		}
	}
}

// How many folds above line k (a fold's first) start with the same line.
fold_same_above :: fun(l: ^Lines, k: i64) -> i64 {
	n : i64 = 0
	for above in 0:k {
		if lines_fold_head(l, above) and line_text(l, above) == line_text(l, k) do n += 1
	}
	return n
}

// The Docs panel's lines, the ones it shows.
docs_shown :: fun(ui: ^Ui) -> ^Lines {
	return &ui.docs[ui.docs_front]
}

// The pin toggled: pinned, lookups wait; unpinned, the newest one made while
// pinned is shown.
docs_pin :: fun(ui: ^Ui) {
	ui.docs_pinned = not ui.docs_pinned
	if not ui.docs_pinned and ui.docs_newer {
		ui.docs_front = 1 - ui.docs_front
		ui.docs_newer = false
	}
	ui.dirty = true
}

// Where a search looked, for its status line: ", in <dir's name> and the
// stdlib" — nothing when it's the stdlib's own.
where_looked :: fun(ui: ^Ui, dir: []utf8, status: ^[300]utf8) {
	if dir.len == 0 or dir == "." or stdlib_dir(ui, dir) do return
	status + ", in "
	status + get_file(trim_separators(dir))
	status + " and the stdlib"
}

// The words asked, lower case: each run of letters, digits and _, two or
// more long (a selection's punctuation and one-letter names left out).
docs_words :: fun(d: ^Docs, asked: []utf8) {
	d.query.len = 0
	d.words.len = 0
	at : i64 = 0
	for at < asked.len {
		if not is_word_char(asked[at]) {
			at += 1
			continue
		}
		end := at
		for end < asked.len {
			if not is_word_char(asked[end]) do break
			end += 1
		}
		if end - at >= 2 and d.words.len < d.words.cap and d.query.len + end - at <= d.query.cap {
			w := Field{at = d.query.len, len = end - at}
			for k in at:end {
				&d.query + lower(asked[k])
			}
			&d.words + w
		}
		at = end
	}
}

// The files looked in, read: the words' directory's (none said: the
// window's), the stdlib's, the doc pages.
docs_read :: fun(ui: ^Ui, d: ^Docs, dir: []utf8) {
	d.source.len = 0
	d.files.len = 0
	d.root.len = 0
	&d.root + ui.compiler_dir[:]
	// (Unless it's the stdlib's own, or doc/: read below, once.)
	if dir.len == 0 {
		docs_read_dir(d, ".", ui.sep)
	elif not stdlib_dir(ui, dir)
		docs_read_dir(d, dir, ui.sep)
	}
	code : [1000]utf8
	&code + ui.compiler_dir
	&code + "code"
	docs_read_dir(d, code, ui.sep)
	// (The directories in code/, as the compiler looks in them.)
	room : [64 * KB]byte
	entries, de := dir_read(code, &room)
	if not de {
		for entry in entries {
			if not entry.dir do continue
			sub_dir : [1000]utf8
			&sub_dir + code[:]
			&sub_dir + ui.sep
			&sub_dir + entry.name[:]
			docs_read_dir(d, sub_dir, ui.sep)
		}
	}
	doc : [1000]utf8
	&doc + ui.compiler_dir
	&doc + "doc"
	docs_read_dir(d, doc, ui.sep)
}

// Whether a directory is one the search reads anyway: the stdlib's, one in
// it, doc/.
stdlib_dir :: fun(ui: ^Ui, dir: []utf8) -> bool {
	code : [1000]utf8
	&code + ui.compiler_dir
	&code + "code"
	doc : [1000]utf8
	&doc + ui.compiler_dir
	&doc + "doc"
	return same_path(dir, code) or same_path(dir, doc) or same_path(get_dir(trim_separators(dir)), code)
}

// The .mara files in a directory read into d.source, as many as fit — a
// directory that isn't there (or of more than a thousand or so), or a file
// that can't be read, left out. A file's path: its name alone in ".", else
// the directory's, sep, its name.
docs_read_dir :: fun(d: ^Docs, dir: []utf8, sep: utf8) {
	room : [300 * KB]byte
	entries, e := dir_read(dir, &room)
	if e do return
	for entry in entries {
		name : []utf8 = entry.name[:]
		if entry.dir or name.len < 6 do continue
		if name[name.len - 5 : name.len] != ".mara" do continue
		if d.files.len == d.files.cap do return
		path : [1000]utf8
		if dir != "." {
			&path + dir
			&path + sep
		}
		&path + name
		if not docs_add_file(d, path) and d.source.len == d.source.cap do return
	}
}

// A file read into d.source, as the last of d.files: false when it can't be
// read, or there's no room for it.
docs_add_file :: fun(d: ^Docs, path: []utf8) -> bool {
	if d.files.len == d.files.cap or path.len > 1000 do return false
	at := d.source.len
	text, e := read_entire_file(path, &d.source)
	if e do return false
	file := Docs_File{at = at, len = text.len}
	&file.path + path
	&d.files + file
	return true
}

// The file at a path among d.files — read now when it isn't: its place;
// -1 when it can't be read.
docs_file_of :: fun(d: ^Docs, path: []utf8) -> i64 {
	for f in 0:d.files.len {
		if same_path(d.files[f].path, path) do return f
	}
	if not docs_add_file(d, path) do return -1
	return d.files.len - 1
}

// File f's text.
docs_text :: fun(d: ^Docs, f: i64) -> []utf8 {
	file := d.files[f]
	return d.source[file.at : file.at + file.len]
}

// File f's definitions, each scored against the words: the ones that match
// counted, the best kept.
docs_scan :: fun(d: ^Docs, f: i64, ex: Exact) {
	text := docs_text(d, f)
	// (The cursor's definition: in its file, on its line, by its name — kept
	// aside, to be shown first. A builtin's or a keyword's: its entry.)
	exact_file := ex.kind.len > 0 and ex.path.len > 0 and same_path(d.files[f].path, ex.path)
	exact_entry := ex.kind.len > 0 and ex.path.len == 0
	line : i64 = 0
	at : i64 = 0
	doc : i64 = -1             // the comment right above: its first line's start
	owner := Field{at = -1, len = 0}    // the struct the lines are in; at -1: none
	owner_indent : i64 = 0     // its line's indentation
	field_indent : i64 = -1    // its fields' (its first line's); -1: not seen yet
	in_example := false        // in an entry's example: nothing found there
	block : i64 = 0            // inside a `/* … */` this deep: its lines the comment's
	for at < text.len {
		end := line_end(text, at)
		line += 1
		indent, from := indentation(text, at, end)
		rest := trimmed(text[from : end])
		if block > 0 {
			block += comment_depth(rest)
			at = end + 1
			continue
		}
		// (An example ends at a comment line at the top level.)
		if in_example {
			if indent > 0 or not (starts_with(rest, "//") or starts_with(rest, "/*")) {
				at = end + 1
				continue
			}
			in_example = false
		}
		if rest.len == 0 {
			doc = -1
		elif starts_with(rest, "//")
			if doc < 0 do doc = at
		elif starts_with(rest, "/*")
			if doc < 0 do doc = at
			block = comment_depth(rest)
		else
			// (The struct's end: a `}` no further in than its line.)
			if owner.at >= 0 and rest[0] == '}' and indent <= owner_indent do owner.at = -1
			fd := Found{file = f, line = line, at = at, doc = doc, kind = -1}
			definition(rest, from, &fd)
			if fd.kind < 0 and owner.at >= 0 {
				if field_indent < 0 do field_indent = indent
				if indent == field_indent do field(rest, from, &fd)
				if fd.kind == DEF_FIELD do fd.owner = owner
			}
			if fd.kind >= 0 {
				off := abs_int(line - ex.line)
				if exact_file and (line == ex.line or ex.loose and off < d.exact_off) and text[fd.name.at : fd.name.at + fd.name.len] == ex.name {
					// (A loose one nearer than the one taken: that one only found.)
					if d.has_exact and d.exact.file == f do docs_score(d, text, &d.exact)
					d.exact = fd
					d.has_exact = true
					d.exact_off = off
				elif exact_entry and not d.has_exact and is_entry(fd.kind) and entry_names(text, fd, ex.name)
					d.exact = fd
					d.has_exact = true
				else
					docs_score(d, text, &fd)
				}
			}
			if is_entry(fd.kind) do in_example = true
			// (A struct's body follows: its fields.)
			if fd.kind == DEF_TYPE and rest[rest.len - 1] == '{' {
				w := text[fd.name.at + fd.name.len : end]
				if contains(w, "struct") or contains(w, "class") {
					owner = fd.name
					owner_indent = indent
					field_indent = -1
				}
			}
			doc = -1
		}
		at = end + 1
	}
}

// What the line (its text from its indentation: rest, at `from` in the
// file) defines, into fd: kind and name; kind stays -1 for none.
definition :: fun(rest: []utf8, from: i64, fd: ^Found) {
	if starts_with(rest, "module ") {
		n := word_at(rest, 7)
		if n > 0 {
			fd.kind = DEF_MODULE
			fd.name = Field{at = from + 7, len = n}
		}
		return
	}
	if starts_with(rest, "fun ") {
		n := word_at(rest, 4)
		if n > 0 {
			fd.kind = DEF_OTHER
			fd.name = Field{at = from + 4, len = n}
		}
		return
	}
	n := word_at(rest, 0)
	if n == 0 do return
	k := skip_spaces(rest, n)
	if not starts_with(rest[k : rest.len], "::") do return
	fd.name = Field{at = from, len = n}
	fd.kind = DEF_OTHER
	what := rest[skip_spaces(rest, k + 2) : rest.len]
	if starts_with(what, "fun") or opens_params(what, 0) {
		fd.kind = DEF_FUN
		// (An entry: found by the word after its prefix.)
		if n > ENTRY_PREFIX {
			if starts_with(rest, "example_") do fd.kind = DEF_EXAMPLE
			if is_entry(fd.kind) do fd.name = Field{at = from + ENTRY_PREFIX, len = n - ENTRY_PREFIX}
		}
	elif starts_with(what, "struct") or starts_with(what, "class") or starts_with(what, "union") or starts_with(what, "error") or starts_with(what, "enum")
		fd.kind = DEF_TYPE
	}
}

// A struct's field on the line — `name: type`, `name := value` — into fd.
field :: fun(rest: []utf8, from: i64, fd: ^Found) {
	n := word_at(rest, 0)
	if n == 0 do return
	k := skip_spaces(rest, n)
	if k >= rest.len or rest[k] != ':' do return
	if k + 1 < rest.len {
		if rest[k + 1] == ':' do return
	}
	fd.kind = DEF_FIELD
	fd.name = Field{at = from, len = n}
}

// Whether a definition's kind is a keyword's or a builtin's entry.
is_entry :: fun(kind: i64) -> bool {
	return kind == DEF_EXAMPLE
}

// Whether an entry is for the word: its name, or one of the words its doc
// comment's first line starts with — "// `if`, `elif`, `else`: ..." — each
// in backticks, before the colon. Case not minded.
entry_names :: fun(text: []utf8, fd: Found, word: []utf8) -> bool {
	if same_folded(text[fd.name.at : fd.name.at + fd.name.len], word) do return true
	return entry_name_of(text, fd, word).len > 0
}

// The one of an entry's names that's the word — `elif` of "`if`, `elif`,
// `else`: ...", as written there. Empty when none is. Case not minded.
entry_name_of :: fun(text: []utf8, fd: Found, word: []utf8) -> []utf8 {
	none := text[0 : 0]
	if fd.doc < 0 or word.len == 0 do return none
	words : [DOC_LINES]Field
	doc_words(text, fd.doc, fd.at, &words)
	if words.len == 0 do return none
	first := text[words[0].at : words[0].at + words[0].len]
	at : i64 = 0
	for at < first.len {
		if first[at] == ' ' or first[at] == ',' {
			at += 1
			continue
		}
		if first[at] != '`' do return none
		close := at + 1
		for close < first.len {
			if first[close] == '`' do break
			close += 1
		}
		if close == first.len do return none
		if same_folded(first[at + 1 : close], word) do return first[at + 1 : close]
		at = close + 1
	}
	return none
}

// An entry's doc comment's first paragraph — to its first empty line: what
// it's for. Empty for none.
entry_summary :: fun(text: []utf8, fd: Found) -> []utf8 {
	if fd.doc < 0 do return text[0 : 0]
	words : [DOC_LINES]Field
	doc_words(text, fd.doc, fd.at, &words)
	if words.len == 0 do return text[0 : 0]
	last := words[0]
	for w in words {
		if w.len == 0 do break
		last = w
	}
	return text[words[0].at : last.at + last.len]
}

// How much deeper a line leaves `/* … */` comments: its `/*`s less its `*/`s.
comment_depth :: fun(s: []utf8) -> i64 {
	depth : i64 = 0
	k : i64 = 0
	for k + 1 < s.len {
		if s[k] == '/' and s[k + 1] == '*' {
			depth += 1
			k += 2
		elif s[k] == '*' and s[k + 1] == '/'
			depth -= 1
			k += 2
		else
			k += 1
		}
	}
	return depth
}

// Where text[at : end] ends less its spaces and carriage return at the end.
trim_end :: fun(text: []utf8, at: i64, end: i64) -> i64 {
	e := end
	for e > at {
		if text[e - 1] != ' ' and text[e - 1] != '\t' and text[e - 1] != '\r' do break
		e -= 1
	}
	return e
}

// A doc comment's lines — text[from : to], `//` lines or a `/* … */` block
// — as the panel shows them, into out as places in text: a `//` line's
// words after its `//` and one space; a block's lines less its `/*` line's
// indentation, its `/*` and `*/` left out (a first or last line with
// nothing else on it, none). A line of DOC_MARK alone left out; empty
// lines at the end too.
doc_words :: fun(text: []utf8, from: i64, to: i64, out: ^[DOC_LINES]Field) {
	out.len = 0
	at := from
	block := false
	block_indent : i64 = 0   // its `/*` line's indentation, in characters
	for at < to and out.len < out.cap {
		end := line_end(text, at)
		_, start := indentation(text, at, end)
		e := trim_end(text, at, end)
		c := start
		keep := true
		if not block and starts_with(text[start : e], "//") {
			c = start + 2
			if c < e and text[c] == ' ' do c += 1
		elif not block and starts_with(text[start : e], "/*")
			block = true
			block_indent = start - at
			c = start + 2
			for c < e and text[c] == ' ' {
				c += 1
			}
			if ends_with(text[c : e], "*/") {
				e = trim_end(text, c, e - 2)
				block = false
			}
			keep = c < e   // (`/*` alone: no line)
		elif block
			c = at
			for c < at + block_indent and c < e and (text[c] == ' ' or text[c] == '\t') {
				c += 1
			}
			if ends_with(text[c : e], "*/") {
				e = trim_end(text, c, e - 2)
				block = false
				keep = c < e   // (`*/` alone: no line)
			}
		}
		// (The mark of a comment the user wrote or approved: not shown.)
		if keep and c < e and trimmed(text[c : e]) == DOC_MARK do keep = false
		if keep {
			if c > e do c = e
			out + Field{at = c, len = e - c}
		}
		at = end + 1
	}
	for out.len > 0 {
		if out[out.len - 1].len > 0 do break
		out.len -= 1
	}
}

// Whether two words are the same, case not minded.
same_folded :: fun(a: []utf8, b: []utf8) -> bool {
	return a.len == b.len and contains_folded(a, b)
}

// fd scored against the words — each word in its name: all of it 100 (an
// entry's words too), its start 50, anywhere 25; in an entry's first line,
// 30; else in its doc comment, 6 — and kept among the best when it matched.
docs_score :: fun(d: ^Docs, text: []utf8, fd: ^Found) {
	name := text[fd.name.at : fd.name.at + fd.name.len]
	// (A module by its last part: mara.os's is os.)
	if fd.kind == DEF_MODULE {
		last_dot : i64 = -1
		for i in 0:name.len {
			if name[i] == '.' do last_dot = i
		}
		name = name[last_dot + 1 : name.len]
	}
	doc := text[0 : 0]
	if fd.doc >= 0 do doc = text[fd.doc : fd.at]
	trailing := text[0 : 0]
	if fd.kind == DEF_FIELD {
		end := line_end(text, fd.at)
		line := text[fd.at : end]
		for i in 0 : line.len - 1 {
			if line[i] == '/' and line[i + 1] == '/' {
				trailing = line[i : line.len]
				break
			}
		}
	}
	score : i64 = 0
	matched : i64 = 0   // words it has, in its name or its doc
	for w in d.words {
		word := d.query[w.at : w.at + w.len]
		before := score
		if name.len == word.len and contains_folded(name, word) {
			score += 100
		elif is_entry(fd.kind) and entry_names(text, fd^, word)
			score += 100
		elif name.len >= word.len and contains_folded(name[0 : word.len], word)
			score += 50
		elif is_entry(fd.kind) and contains_folded(entry_summary(text, fd^), word)
			// (What it's for, searched in words: "function" finds fun's.)
			score += 30
		elif contains_folded(name, word)
			score += 25
		elif contains_folded(doc, word) or contains_folded(trailing, word)
			score += 6
		}
		if score > before do matched += 1
	}
	if score == 0 do return
	// (Every word, of two or more: what was asked about, more than one word's
	// namesake — "read file" finds read_entire_file before read.)
	if matched == d.words.len and matched > 1 do score += 100
	d.count += 1
	// (Ties: an entry first — `len`'s, before every struct's len — then a
	// type, a fun, a module, the rest, a field.)
	if is_entry(fd.kind) do score += 4
	if fd.kind == DEF_TYPE do score += 3
	if fd.kind == DEF_FUN or fd.kind == DEF_MODULE do score += 2
	if fd.kind == DEF_OTHER do score += 1
	fd.score = score
	// (Into the best, in order: after those as good, so files' order holds.)
	place := d.found.len
	for place > 0 {
		if d.found[place - 1].score >= score do break
		place -= 1
	}
	if place >= d.found.cap do return
	if d.found.len < d.found.cap do d.found.len += 1
	k := d.found.len - 1
	for k > place {
		d.found[k] = d.found[k - 1]
		k -= 1
	}
	d.found[place] = fd^
}

// A definition found, as the panel shows it: its name, a struct's for a
// field, its file:line; its doc comment; its code — a fun's signature, a
// type's body, the line — less its line's indentation. A blank line after.
// What the name at the cursor refers to, first: its definition as the
// search shows one; else — a local's, a param's — the line declaring it (a
// param's: its fun's signature), the comment above it; a builtin, said.
docs_show_exact :: fun(d: ^Docs, l: ^Lines, ex: Exact) {
	title : [1200]utf8
	&title + ex.name[0 : min_int(ex.name.len, 200)]
	&title + "   "
	&title + ex.kind
	if d.has_exact {
		lines_add(l, "At the cursor:", STYLE_DIM)
		d.exact_shown = true
		docs_show(d, l, d.exact, ex.kind, ex.name)
		return
	}
	if ex.path.len == 0 {
		lines_add(l, "At the cursor:", STYLE_DIM)
		d.exact_shown = true
		lines_add(l, title[:], STYLE_TITLE)
		if ex.kind == "keyword" {
			lines_add(l, "  A keyword: doc/basics.mara has no entry for it yet.", STYLE_TEXT)
		else
			lines_add(l, "  Built into the compiler: doc/basics.mara has no entry for it yet.", STYLE_TEXT)
		}
		lines_add(l, "", STYLE_TEXT)
		return
	}
	f := docs_file_of(d, ex.path)
	if f < 0 do return
	text := docs_text(d, f)
	at := line_start(text, ex.line)
	if at < 0 do return
	lines_add(l, "At the cursor:", STYLE_DIM)
	d.exact_shown = true
	here := Found{score = 0, file = f, line = ex.line, at = at, doc = comment_above(text, at), kind = DEF_LINE, name = Field{0}, owner = Field{0}}
	lines_add(l, title[:], STYLE_TITLE)
	lines_link(l, docs_link(d, here)[:])
	docs_show_body(d, l, here)
}

// Where line n (from 1) of the text starts; -1 past its end.
line_start :: fun(text: []utf8, n: i64) -> i64 {
	if n < 1 do return -1
	at : i64 = 0
	line : i64 = 1
	for line < n {
		end := line_end(text, at)
		if end >= text.len do return -1
		at = end + 1
		line += 1
	}
	return at
}

// The comment right above the line at `at`: its first line's start; -1
// for none.
comment_above :: fun(text: []utf8, at: i64) -> i64 {
	doc : i64 = -1
	k := at
	// (A `/* … */` block ending on the line above: from its `/*` line.)
	if k > 0 {
		above := k - 1
		for above > 0 {
			if text[above - 1] == '\n' do break
			above -= 1
		}
		_, from := indentation(text, above, k - 1)
		if ends_with(trimmed(text[from : k - 1]), "*/") {
			for above >= 0 {
				_, start := indentation(text, above, line_end(text, above))
				if starts_with(trimmed(text[start : line_end(text, above)]), "/*") do return above
				if above == 0 do break
				above -= 1
				for above > 0 {
					if text[above - 1] == '\n' do break
					above -= 1
				}
			}
			return -1
		}
	}
	for k > 0 {
		prev_end := k - 1   // (the '\n' ending the line above)
		prev := prev_end
		for prev > 0 {
			if text[prev - 1] == '\n' do break
			prev -= 1
		}
		_, from := indentation(text, prev, prev_end)
		if not starts_with(trimmed(text[from : prev_end]), "//") do break
		doc = prev
		k = prev
	}
	return doc
}

// (`kind`: what the compiler says it is, for the cursor's — `builtin`,
// `keyword` — shown after an example's name; else none.)
// (`word`: the name at the cursor, an entry titled by it; else none, an
// entry titled by the word looked up of its names.)
docs_show :: fun(d: ^Docs, l: ^Lines, fd: Found, kind: []utf8, word: []utf8) {
	text := docs_text(d, fd.file)
	title : [1200]utf8
	&title + text[fd.name.at : fd.name.at + fd.name.len]
	if fd.kind == DEF_FIELD {
		&title + "   field of "
		&title + text[fd.owner.at : fd.owner.at + fd.owner.len]
	}
	if is_entry(fd.kind) {
		// (Named by the word clicked or looked up, when it's one of the names
		// its first line gives — `elif` of `if`, `elif`, `else` — else by the
		// first.)
		title.len = 0
		name := entry_name_of(text, fd, word)
		for w in d.words {
			if name.len > 0 do break
			name = entry_name_of(text, fd, d.query[w.at : w.at + w.len])
		}
		if name.len == 0 do name = example_name(text, fd)
		&title + name
		if kind.len > 0 {
			&title + "   "
			&title + kind
		}
	}
	lines_add(l, title[:], STYLE_TITLE)
	lines_link(l, docs_link(d, fd)[:])
	docs_show_body(d, l, fd)
}

// An example's name: the first word in backticks its first line starts
// with (`print`), else the word after example_.
example_name :: fun(text: []utf8, fd: Found) -> []utf8 {
	name := text[fd.name.at : fd.name.at + fd.name.len]
	if fd.doc < 0 do return name
	words : [DOC_LINES]Field
	doc_words(text, fd.doc, fd.at, &words)
	if words.len == 0 do return name
	first := text[words[0].at : words[0].at + words[0].len]
	if first.len < 2 or first[0] != '`' do return name
	for k in 1:first.len {
		if first[k] == '`' do return first[1 : k]
	}
	return name
}

// The place a definition opens, clicked: `<file>:<line>`.
docs_link :: fun(d: ^Docs, fd: Found) -> [1100]utf8 {
	link : [1100]utf8
	&link + d.files[fd.file].path[:]
	&link + ":"
	&link + int_text(fd.line)
	return link
}

// Where a definition is, as its last line shows it — `doc\basics.mara:476`:
// a file under the compiler's directory from there, else its folder's name
// and its own — after an entry's names (an entry's first line's, `print`,
// `print_int`: the words it's found by). Clicked, it opens there too.
docs_footer :: fun(d: ^Docs, l: ^Lines, fd: Found, names: []utf8) {
	path : []utf8 = d.files[fd.file].path[:]
	short := path
	if d.root.len > 0 and path.len > d.root.len and same_path(path[0 : d.root.len], d.root[:]) {
		short = path[d.root.len : path.len]
	else
		seps : i64 = 0
		for k := path.len - 1; k > 0; k -= 1 {
			if path[k] == '\\' or path[k] == '/' {
				seps += 1
				if seps == 2 {
					short = path[k + 1 : path.len]
					break
				}
			}
		}
	}
	footer : [1400]utf8
	&footer + "  "
	if names.len > 0 {
		&footer + names[0 : min_int(names.len, 300)]
		&footer + "   "
	}
	&footer + short[0 : min_int(short.len, 1000)]
	&footer + ":"
	&footer + int_text(fd.line)
	lines_add(l, footer[:], STYLE_DIM)
	lines_link(l, docs_link(d, fd)[:])
}

// Where an entry's names end on its doc comment's first line — the words in
// backticks it starts with (`print`, `print_int`), and a colon after them —
// with the spaces after: 0 for none.
names_end :: fun(first: []utf8) -> i64 {
	at : i64 = 0
	end : i64 = 0
	for at < first.len {
		if first[at] == ' ' or first[at] == ',' {
			at += 1
			continue
		}
		if first[at] == ':' and end > 0 {
			at += 1
			for at < first.len and first[at] == ' ' {
				at += 1
			}
			return at
		}
		if first[at] != '`' do break
		close := at + 1
		for close < first.len {
			if first[close] == '`' do break
			close += 1
		}
		if close == first.len do break
		end = close + 1
		at = end
	}
	for end > 0 and end < first.len and first[end] == ' ' {
		end += 1
	}
	return end
}

// A definition's doc comment and code, as the panel shows them below its
// title; a blank line after.
docs_show_body :: fun(d: ^Docs, l: ^Lines, fd: Found) {
	text := docs_text(d, fd.file)
	// The doc comment: its lines' words (doc_words) — an entry's names, the
	// words its first line starts with, shown at its end instead — as
	// Markdown has them: a paragraph's lines joined, wrapped to the panel's
	// width; a blank line between paragraphs. A list item (`- `, `* `, `1. `)
	// starts a line of its own. Code keeps its lines, shown as Mara code: a
	// line indented by a tab (or four spaces), or the lines between ```s.
	names : [300]utf8
	said := false   // a doc line shown
	if fd.doc >= 0 {
		words : [DOC_LINES]Field
		doc_words(text, fd.doc, fd.at, &words)
		para : [8 * KB]utf8   // the paragraph being joined, two spaces in
		fenced := false
		for w, i in words {
			line := text[w.at : w.at + w.len]
			if i == 0 and is_entry(fd.kind) {
				end := names_end(line)
				for ch in line[0 : end] {
					if ch != '`' and names.len < names.cap do &names + ch
				}
				for names.len > 0 {
					last := names[names.len - 1]
					if last != ' ' and last != ':' and last != ',' do break
					names.len -= 1
				}
				line = line[end : line.len]
				if line.len == 0 do continue
			}
			words_in := trimmed(line)
			if starts_with(words_in, "```") {
				doc_paragraph(l, &para)
				fenced = not fenced
				continue
			}
			if fenced or doc_code_line(line) {
				doc_paragraph(l, &para)
				indent : i64 = 0
				if not fenced do indent = TAB_SPACES
				lines_add_code(l, line, indent)
				said = true
				continue
			}
			if words_in.len == 0 {
				doc_paragraph(l, &para)
				if l.lines.len > 0 and l.lines[l.lines.len - 1].len > 0 do lines_add(l, "", STYLE_TEXT)
				continue
			}
			if doc_list_item(words_in) or para.len + 1 + words_in.len > para.cap do doc_paragraph(l, &para)
			if para.len == 0 {
				&para + "  "
			else
				&para + ' '
			}
			&para + words_in[0 : min_int(words_in.len, para.cap - para.len)]
			said = true
		}
		doc_paragraph(l, &para)
	}
	if is_entry(fd.kind) {
		// (An example's function a line below what's said of it.)
		if said do lines_add(l, "", STYLE_TEXT)
		docs_show_example(l, text, fd)
		docs_footer(d, l, fd, names[:])
		lines_add(l, "", STYLE_TEXT)
		return
	}

	// The code, from the definition's line: a fun's whole, its body hidden
	// (docs_show_fun); a type's to its `}`, the rest's to where its
	// parentheses close (a foreign fun's signature can take lines).
	first_end := line_end(text, fd.at)
	indent, _ := indentation(text, fd.at, first_end)
	if fd.kind == DEF_FUN {
		docs_show_fun(l, text, fd.at, indent)
		docs_footer(d, l, fd, names[:])
		lines_add(l, "", STYLE_TEXT)
		return
	}
	at := fd.at
	most := DOCS_SIGNATURE
	if fd.kind == DEF_TYPE do most = DOCS_BODY
	if fd.kind == DEF_FIELD or fd.kind == DEF_MODULE do most = 1
	depth : i64 = 0   // parentheses open
	shown : i64 = 0
	for at < text.len {
		end := line_end(text, at)
		code := text[at : end]
		line_indent, from := indentation(text, at, end)
		rest := trimmed(text[from : end])
		last := shown + 1 == most
		if fd.kind == DEF_OTHER or fd.kind == DEF_LINE {
			for ch in rest {
				if ch == '(' do depth += 1
				if ch == ')' do depth -= 1
			}
			if depth <= 0 do last = true
			// (A param's line, its fun's signature: its `{` left out.)
			if last and fd.kind == DEF_LINE and rest.len > 0 {
				if rest[rest.len - 1] == '{' do code = text[at : from + rest.len - 1]
			}
		}
		if fd.kind == DEF_TYPE and shown > 0 and line_indent <= indent and rest.len > 0 {
			if rest[0] == '}' do last = true
		}
		if fd.kind == DEF_TYPE and shown == 0 and contains(rest, "}") do last = true
		if trimmed(code).len > 0 or not last do lines_add_code(l, code, indent)
		shown += 1
		at = end + 1
		if last do break
		if shown == most {
			lines_add(l, "  …", STYLE_DIM)
			break
		}
	}
	docs_footer(d, l, fd, names[:])
	lines_add(l, "", STYLE_TEXT)
}

// The paragraph joined so far added as a line, and emptied; none, nothing.
doc_paragraph :: fun(l: ^Lines, para: ^[8 * KB]utf8) {
	if para.len == 0 do return
	lines_add(l, para[:], STYLE_DOC)
	para.len = 0
}

// Whether a doc comment's line is code: indented by a tab, or four spaces.
doc_code_line :: fun(line: []utf8) -> bool {
	return starts_with(line, "\t") or starts_with(line, "    ")
}

// Whether a doc comment's line (its spaces left out) starts a list item:
// `- `, `* `, or a number and `. `.
doc_list_item :: fun(s: []utf8) -> bool {
	if starts_with(s, "- ") or starts_with(s, "* ") do return true
	k : i64 = 0
	for k < s.len and s[k] >= '0' and s[k] <= '9' {
		k += 1
	}
	return k > 0 and starts_with(s[k : s.len], ". ")
}

// A fun's code as written, to its closing `}` — a fun of one line, its
// first; else the `}` no further in than it: its signature, to the `{` its
// body opens with (a line, or several), then its body, hidden until the
// signature's clicked (lines_fold). A long one: its first DOCS_FUN lines,
// and how many more.
docs_show_fun :: fun(l: ^Lines, text: []utf8, from: i64, indent: i64) {
	// (Its lines counted first: to say how many aren't shown.)
	count : i64 = 0
	sig : i64 = 0     // its signature's lines
	depth : i64 = 0   // the signature's parentheses open
	at := from
	for at < text.len {
		end := line_end(text, at)
		line_indent, start := indentation(text, at, end)
		rest := trimmed(text[start : end])
		count += 1
		at = end + 1
		for ch in rest {
			if sig > 0 do break
			if ch == '(' do depth += 1
			if ch == ')' do depth -= 1
			if ch == '{' and depth == 0 do sig = count
		}
		if count == 1 and rest.len > 0 and rest[rest.len - 1] == '}' do break   // (`{ return n }`)
		if count > 1 and line_indent <= indent and rest.len > 0 and rest[0] == '}' do break
	}
	most := min_int(count, DOCS_FUN)
	if sig == 0 or sig > most do sig = most
	first := l.lines.len
	at = from
	for _ in 0:most {
		end := line_end(text, at)
		lines_add_code(l, text[at : end], indent)
		at = end + 1
	}
	if most < count {
		more : [60]utf8
		&more + "  … "
		&more + int_text(count - most)
		&more + " more lines"
		lines_add(l, more[:], STYLE_DIM)
	}
	// (Its body hidden: as much of it as there was room for.)
	added := l.lines.len - first
	if added > sig do lines_fold(l, first, sig, added - sig)
}

// An example's code, below its doc comment: its function as written, then
// what's defined after it, up to the next comment line at the top level —
// blank lines at its end left out.
docs_show_example :: fun(l: ^Lines, text: []utf8, fd: Found) {
	first_end := line_end(text, fd.at)
	indent, _ := indentation(text, fd.at, first_end)
	at := fd.at
	blanks : i64 = 0   // blank lines held back, shown when code follows
	shown : i64 = 0
	for at < text.len {
		end := line_end(text, at)
		line_indent, from := indentation(text, at, end)
		rest := trimmed(text[from : end])
		if line_indent == 0 and at > fd.at and (starts_with(rest, "//") or starts_with(rest, "/*")) do break
		line_after := end + 1
		if rest.len == 0 {
			blanks += 1
			at = line_after
			continue
		}
		if shown + blanks >= DOCS_EXAMPLE {
			lines_add(l, "  …", STYLE_DIM)
			break
		}
		for blanks > 0 {
			lines_add(l, "", STYLE_MARA)
			blanks -= 1
			shown += 1
		}
		lines_add_code(l, text[at : end], indent)
		shown += 1
		at = line_after
	}
}

// Line k of the Docs panel's — a definition's title, its place below it —
// as the file and line it opens (line_link: `<file>:<line>`), and whether it
// opens one (an "At the cursor" builtin's title doesn't).
docs_place :: fun(l: ^Lines, k: i64) -> []utf8, i64, bool {
	none := l.text[0 : 0]
	if k < 0 or k >= l.lines.len do return none, 0, false
	text := line_link(l, k)
	colon := text.len - 1
	for colon > 0 {
		if text[colon] == ':' do break
		colon -= 1
	}
	if colon <= 0 do return none, 0, false
	line, ok := parse_number(text[colon + 1 : text.len])
	if not ok do return none, 0, false
	return text[0 : colon], i64(line), true
}

// The definition title, or the fun's signature, under the mouse in the Docs
// panel: its line (any of its rows); -1 when it's over none (or over a
// panel in front of Docs).
docs_hover :: fun(ui: ^Ui) -> i64 {
	i := panel_at(ui, ui.mouse_x, ui.mouse_y)
	if i < 0 do return -1
	if ui.panels[i].kind != DOCS_PANEL do return -1
	l := docs_shown(ui)
	k := lines_line_at(ui, l, content_rect(ui, ui.panels[i]), ui.mouse_x, ui.mouse_y)
	if k < 0 do return -1
	_, _, place := docs_place(l, k)
	if not place and l.lines[k].fold_len == 0 do return -1
	return k
}

// The Docs panel: what was found, the title or signature under the mouse
// lit.
draw_docs :: fun(ui: ^Ui, r: Rect) {
	ui.docs_hover = docs_hover(ui)
	l := docs_shown(ui)
	l.lit = ui.docs_hover
	draw_lines(ui, l, r, "Select words in Sublime (Mara Ask), or run mara docs <words> anywhere, to look them up. A title clicked opens its file there; a fun's signature clicked shows its code.")
}

// A press in the Docs panel's content r: a fun's signature, its body shown
// or hidden; a definition's title, its file opened in the editor at its
// line.
docs_click :: fun(ui: ^Ui, r: Rect, x: f32, y: f32) {
	l := docs_shown(ui)
	k := lines_line_at(ui, l, r, x, y)
	if lines_toggle(l, k) {
		ui.dirty = true
		return
	}
	file, line, place := docs_place(l, k)
	if not place do return
	editor_open(ui, l, file, line)
}

// A line of code added: `indent` columns of its indentation left out, two
// spaces in.
lines_add_code :: fun(l: ^Lines, code: []utf8, indent: i64) {
	col : i64 = 0
	k : i64 = 0
	for k < code.len and col < indent {
		if code[k] == '\t' {
			col += TAB_SPACES
		elif code[k] == ' '
			col += 1
		else
			break
		}
		k += 1
	}
	end := code.len
	for end > k {
		if code[end - 1] != ' ' and code[end - 1] != '\t' and code[end - 1] != '\r' do break
		end -= 1
	}
	shown : [1200]utf8
	&shown + "  "
	&shown + code[k : min_int(end, k + 1000)]
	lines_add(l, shown[:], STYLE_MARA)
}

// The line's indentation in columns (a tab, TAB_SPACES), and where its text
// begins — a carriage return at its end left off by the caller's end.
indentation :: fun(text: []utf8, at: i64, end: i64) -> i64, i64 {
	col : i64 = 0
	k := at
	for k < end {
		if text[k] == '\t' {
			col += TAB_SPACES
		elif text[k] == ' '
			col += 1
		else
			break
		}
		k += 1
	}
	return col, k
}

// How long the name at s[k] is: letters, digits, _ and dots (a module's
// name has them); 0 for none.
word_at :: fun(s: []utf8, k: i64) -> i64 {
	at := k
	for at < s.len {
		if not is_word_char(s[at]) and not (s[at] == '.' and at > k) do break
		at += 1
	}
	return at - k
}

// Whether ch is a letter, a digit or _.
is_word_char :: fun(ch: utf8) -> bool {
	return (ch >= 'a' and ch <= 'z') or (ch >= 'A' and ch <= 'Z') or (ch >= '0' and ch <= '9') or ch == '_'
}
