module view

use mara.core
use mara.string
use mara.os
use mara.math
use mara.sdl

// The Crash panel: the program's last crash, as its report in crash.txt says
// (runtime/mara_crash.c writes it beside the program) — when, what went
// wrong, then the calls that were running, innermost first, each where it was
// in the source: `  at area (dbg.mara:38)`. A call clicked opens its file at
// its line in the editor the windows were told of (`mara editor`: Sublime's
// Mara Ask plugin tells them its subl), kept in editor.txt beside the
// window's program. A crash newer than the window's last comes to the front.
// So does the window's own last crash, when it opens after one: its report,
// in the crash.txt beside the window's program, said to be its own, its calls
// opening its sources (own_crash_look).

CRASH :: "crash.txt"   // in the directory the window runs in: its program's

// The program's newest report read from crash.txt into ui.crash; whether
// there's one.
crash_read :: fun(ui: ^Ui) -> bool {
	ui.crash_stamp = file_mtime(CRASH)
	return crash_load(ui, CRASH, false)
}

// The newest report of a crash file read into ui.crash — each one in the file
// ends in a blank line, the newest last — the window's own (`own`) under a
// line saying so, its calls' files in its directory (ui.crash_dir); whether
// there's one.
crash_load :: fun(ui: ^Ui, path: []utf8, own: bool) -> bool {
	lines_clear(&ui.crash)
	ui.crash_dir.len = 0
	crash_status(ui)
	ui.crash_text.len = 0
	_, re := read_entire_file(path, &ui.crash_text)
	if bool(re) do return false
	if own {
		lines_add(&ui.crash, "mara view itself crashed the last time it ran. Its report, from view/crash.txt:", STYLE_TITLE)
		&ui.crash_dir + path_dir(path)
	}
	text : []utf8 = ui.crash_text[:]
	end := text.len
	for end > 0 {
		if text[end - 1] != '\n' and text[end - 1] != '\r' do break
		end -= 1
	}
	start : i64 = 0
	for k in 1 .. end {
		if text[k - 1] == '\n' and text[k] == '\n' do start = k + 1
	}
	// (Its first line when; the calls in code's color; the rest, what went
	// wrong.)
	at := start
	for at < end {
		stop := at
		for stop < end {
			if text[stop] == '\n' do break
			stop += 1
		}
		line := text[at : stop]
		style := STYLE_BAD
		if at == start do style = STYLE_DIM
		if starts_with(line, "  at ") do style = STYLE_CODE
		if starts_with(line, "  ... ") do style = STYLE_DIM
		lines_add(&ui.crash, line, style)
		at = stop + 1
	}
	return ui.crash.lines.len > 0
}

// The window's own last crash, when there's one since it last looked: its
// report shown in the Crash panel, in front. Each is shown once — layout.txt
// keeps the time of the crash.txt beside the window's program as it last
// looked; its first look only notes it.
own_crash_look :: fun(ui: ^Ui) {
	stamp := file_mtime(ui.own_crash_path)
	if stamp == 0 do return
	now := int_text(stamp)
	if ui.own_crash_seen.len > 0 and ui.own_crash_seen[:] != now[:] {
		if crash_load(ui, ui.own_crash_path, true) do crash_show(ui)
	}
	ui.own_crash_seen.len = 0
	&ui.own_crash_seen + now[:]
	layout_save(ui)
}

// The panel shown, in front: a new crash.
crash_show :: fun(ui: ^Ui) {
	i := find_panel(ui, CRASH_PANEL)
	if i < 0 do return
	ui.panels[i].shown = true
	_ = bring_to_front(ui, i)
	layout_save(ui)
}

// The status line: until the windows know an editor, how they're told.
crash_status :: fun(ui: ^Ui) {
	if ui.editor.len > 0 {
		ui.crash.status.len = 0
		return
	}
	lines_status(&ui.crash, "Calls open in the editor once it's named: Sublime's Mara Ask plugin names its own (mara editor).", STYLE_DIM)
}

// Line k's call, as its file and its line — `  at <name> (<file>:<line>)` —
// and whether it is one.
crash_call :: fun(ui: ^Ui, k: i64) -> []utf8, i64, bool {
	text := line_text(&ui.crash, k)
	none := text[0 : 0]
	if not starts_with(text, "  at ") or text[text.len - 1] != ')' do return none, 0, false
	paren := text.len - 1
	for paren > 0 {
		if text[paren] == '(' do break
		paren -= 1
	}
	colon := text.len - 1
	for colon > paren {
		if text[colon] == ':' do break
		colon -= 1
	}
	if colon <= paren do return none, 0, false
	line, ok := parse_number(text[colon + 1 : text.len - 1])
	if not ok do return none, 0, false
	return text[paren + 1 : colon], i64(line), true
}

// The call under the mouse: its line (any of its rows, wrapped); -1 when
// it's over none (or over another panel in front of the Crash panel).
crash_hover :: fun(ui: ^Ui) -> i64 {
	i := panel_at(ui, ui.mouse_x, ui.mouse_y)
	if i < 0 do return -1
	if ui.panels[i].kind != CRASH_PANEL do return -1
	k := lines_line_at(ui, &ui.crash, content_rect(ui, ui.panels[i]), ui.mouse_x, ui.mouse_y)
	if k < 0 do return -1
	_, _, call := crash_call(ui, k)
	if not call do return -1
	return k
}

// The Crash panel: the report, the call under the mouse lit.
draw_crash :: fun(ui: ^Ui, r: Rect) {
	ui.crash_hover = crash_hover(ui)
	ui.crash.lit = ui.crash_hover
	draw_lines(ui, &ui.crash, r, "No crash yet. When the program crashes, its report shows here, and a call clicked opens in the editor.")
}

// A press in the Crash panel's content r: a call, opened in the editor at
// its line.
crash_click :: fun(ui: ^Ui, r: Rect, x: f32, y: f32) {
	k := lines_line_at(ui, &ui.crash, r, x, y)
	if k < 0 do return
	file, line, call := crash_call(ui, k)
	if not call do return
	editor_load(ui)
	crash_status(ui)
	// (The window's own calls: its sources, beside it — a path not already whole.)
	full : [..2000]utf8
	whole := file.len > 1 and (file[1] == ':' or file[0] == '/' or file[0] == '\\')
	if ui.crash_dir.len > 0 and not whole do &full + ui.crash_dir[:]
	&full + file[0 : min_int(file.len, 1000)]
	editor_open(ui, &ui.crash, full[:], line)
}

// A file opened in the editor at a line — `"<editor>" "<file>:<line>"`,
// waited for (it hands the file to the editor and ends). No editor named
// yet, or one that didn't start: said on l's status line.
editor_open :: fun(ui: ^Ui, l: ^Lines, file: []utf8, line: i64) {
	editor_load(ui)
	if ui.editor.len == 0 {
		lines_status(l, "Files open in the editor once it's named: Sublime's Mara Ask plugin names its own (mara editor).", STYLE_DIM)
		return
	}
	command : [..3000]utf8
	&command + "\""
	&command + ui.editor[:]
	&command + "\" \""
	&command + file
	&command + ":"
	&command + int_text(line)
	&command + "\""
	pr, e := process_start(command)   // (the buffer itself: a 0 follows its text)
	if bool(e) {
		lines_status(l, "The editor didn't start: mara editor names it.", STYLE_BAD)
		return
	}
	_, _ = process_wait(&pr)
}

// The editor the windows were told of, as editor.txt keeps it — read again
// each time it's wanted: another window may have been told since.
editor_load :: fun(ui: ^Ui) {
	buf : [..1000]byte
	ui.editor.len = 0
	data, re := read_entire_file(ui.editor_path, &buf)
	if bool(re) do return
	text : []utf8 = data
	n := text.len
	for n > 0 {
		if text[n - 1] != '\n' and text[n - 1] != '\r' do break
		n -= 1
	}
	&ui.editor + text[0 : n]
}

// The editor a "-editor <program>" line names, kept in editor.txt for every
// window.
editor_set :: fun(ui: ^Ui, program: []utf8) {
	ui.editor.len = 0
	&ui.editor + program[0 : min_int(program.len, ui.editor.cap)]
	id, oe := file_open_write(ui.editor_path)
	if not bool(oe) {
		_ = file_write_text(id, ui.editor[:])
		file_close(id)
	}
	crash_status(ui)
	ui.dirty = true
}
