module view

// The Mara window: `mara view` opens it on a module. It shows panels
// (panels.mara): the module's profile.txt (build with `mara build -profile`,
// run the program), every probed fun's times sorted by whichever column is
// clicked, read again whenever the program writes it; the docs, looked up
// for the words an editor sends (`mara docs`, docs.mara); the last query an
// editor asked (`mara ask -show`) and its answer; the program's last crash,
// its calls opened in the editor (crash.mara); the keys. Panels are
// moved, resized, shown and hidden; the layout and the theme, dark or
// light, are kept. It answers `mara ask` here from a `mara serve` of its
// own (hub.mara).
//   view <compiler> <module> <pipe name> <docs pipe name>   (as `mara view` starts it)
// Its font, Inter (OFL.txt), and SDL3.dll are beside it, and its layout,
// layout.txt. Built here: `mara build view` — with the window closed
// (Windows won't write over a program that's running).

use mara.core
use mara.os
use mara.math
use mara.sdl
include mara.memory

PROFILE   :: "profile.txt"   // in the directory it runs in: the module's
FONT_SIZE :: 15.0            // the text's em, pixels on a display at 100%
PAD       :: 12.0            // room around text: a panel's margin, a column's
ROW_PAD   :: 3.0             // room above and below a line of text in a bar or row

// The window and what it shows.
Ui :: struct {
	window:   Window
	renderer: Renderer
	text:     Text
	font:     [..1000]utf8   // the font's path
	layout_path: [..1000]utf8
	editor_path: [..1000]utf8   // editor.txt's: the editor the windows were told of
	density:  f32            // pixels a window unit (a high-density display has more)
	frame_ns: u64            // the display's time between frames: as often as it's drawn
	width:    f32            // the window's size, pixels
	height:   f32
	saved_width:  f64        // its size as layout.txt had it
	saved_height: f64
	mouse_x:  f32            // the mouse, pixels; -1 when it's outside
	mouse_y:  f32
	cursors:  [12]Cursor     // the system's, by SYSTEM_CURSOR_...
	cursor:   i32            // the one shown
	running:  bool = true
	dirty:    bool = true    // drawn again when it is

	panels:   [..8]Panel     // back to front: the last is drawn over the rest
	menu_open:  i64 = MENU_NONE   // the menu open: MENU_PANELS, MENU_THEME
	menu_hover: i64 = -1     // the menu's item under the mouse as last drawn
	drag:       i64          // DRAG_NONE, _MOVE, _RESIZE: what the mouse is doing
	drag_kind:  i64          // the panel dragged
	drag_edges: i64          // a resize's edges (EDGE_...)
	drag_x:     f32          // the mouse where the drag began
	drag_y:     f32
	drag_box:   Rect         // the panel's box then

	// The Profile panel's.
	hover_row: i64 = -1      // the row under the mouse as last drawn; -1: none
	scroll:   i64            // the first row shown
	scroll_x: f32            // pixels the table is scrolled sideways

	// The Docs panel's and the Ask panel's lines — what's at the editor's
	// cursor, above what was asked; the docs search's room.
	docs:   [2]Lines         // the one shown, docs[docs_front]; the other, a lookup made while pinned
	docs_front:  i64
	docs_pinned: bool        // lookups don't replace what's shown (the title bar's pin)
	docs_newer:  bool        // ... one was made: shown when it's unpinned
	docs_query:  [2]Docs_Query   // what each of docs was looked up by: a reload's
	asked:  Lines
	at_cursor: Lines
	search: Docs
	compiler_dir: [..1000]utf8   // the compiler's directory, its separator at the end
	sep:    utf8                 // the compiler's path's separator: '\' or '/'

	// The Crash panel's: the newest report of crash.txt, the file as read.
	crash:       Lines
	crash_text:  [..2 * MB]byte
	crash_stamp: i64             // the file's time when it was read
	crash_hover: i64 = -1        // the call under the mouse as last drawn
	docs_hover:  i64 = -1        // the Docs title under the mouse as last drawn
	// What the mouse selects in (select.mara): the lines, how many clicks
	// began it — 2: a word, 3: a line, the one they selected — what Ctrl+C
	// copied, a 0 after it.
	sel:        ^Lines
	sel_clicks: i64
	sel_from:   Spot
	sel_to:     Spot
	sel_scrolled: u32        // when it last scrolled the lines (GetTicks)
	clip:       [..2 * MB]utf8
	editor:      [..1000]utf8    // the editor a call opens in: `"<editor>" "<file>:<line>"`

	// The theme's colors (theme.mara: theme_set).
	theme:      i64     // THEME_DARK, _LIGHT, _SUBLIME
	colors_path:  [..1000]utf8   // colors.txt's: Sublime's colors, as the windows were told them
	colors_stamp: i64            // its time when they were read
	ground:     Color   // the window behind the panels
	background: Color   // a panel's
	border:     Color
	stripe:     Color   // every other row
	hover:      Color   // what's under the mouse
	header:     Color   // bars: the menu, titles, a status line
	ink:        Color
	dim:        Color
	accent:     Color   // the column sorted by; a ticked box; a name found
	bad:        Color
	code:       Color   // code, as the Docs panel shows it (not Mara's: a crash's calls)
	tokens:     [TOKENS]Color   // Mara code's, each token kind's (code.mara)
	selected:   Color   // text selected, behind it
}

main :: fun() -> i64 {
	this_program = Program(Arena_Basic(256 * MB))
	ui : Ui
	p : Profile
	hub : Hub
	theme_set(&ui, THEME_DARK)

	// (Its font and its layout beside it: the directory of its own file —
	// executable_path's, however it was started; args[0] is what its
	// starter wrote, maybe just its name.)
	exe : [..1000]utf8
	if bool(executable_path(&exe)) {
		print("mara view: where its own file is, the system didn't say")
		return 1
	}
	dir := path_dir(exe)
	&ui.font + dir
	&ui.font + "Inter.ttf"
	&ui.layout_path + dir
	&ui.layout_path + "layout.txt"
	&ui.editor_path + dir
	&ui.editor_path + "editor.txt"
	&ui.colors_path + dir
	&ui.colors_path + COLORS

	// (The compiler's directory: its stdlib and doc pages, for the docs. Its
	// separator, the paths made from it.)
	if this_program.args.len > 1 {
		compiler_dir := path_dir(this_program.args[1])
		&ui.compiler_dir + compiler_dir
		ui.sep = '/'
		if compiler_dir.len > 0 do ui.sep = compiler_dir[compiler_dir.len - 1]
	}

	title : str256
	if this_program.args.len > 2 {
		&title + this_program.args[2]
		&title + " - "
	}
	&title + "mara view"

	// (A click that brings the window forward is a click too: on Windows SDL
	// would drop it.)
	_ = SetHint("SDL_MOUSE_FOCUS_CLICKTHROUGH", "1")
	if not Init(Video) {
		print("mara view: SDL didn't start")
		return 1
	}
	defer Quit()
	ui.window = CreateWindow(cstring(title), 1100, 700, Resizable | HighPixelDensity)
	// (SDL's OpenGL renderer: Direct3D 11's, its default on Windows, showed a
	// frame late now and then — a dragged panel moved on after its release,
	// again when the mouse came over it. OpenGL's, as Pounce draws, didn't.)
	driver := "opengl"
	ui.renderer = CreateRenderer(ui.window, &driver[0])
	// (Vsync, and frames no oftener than the display shows them (run): sent
	// faster, they'd queue to be shown, behind the mouse — a click's, a
	// dragged panel's.)
	_ = SetRenderVSync(ui.renderer, 1)
	for id in 0 .. 12 {
		ui.cursors[id] = CreateSystemCursor(i32(id))
	}
	measure(&ui)
	e := text_load(&ui.text, ui.renderer, ui.font, FONT_SIZE * ui.density)
	if bool(e) {
		print("mara view: its font didn't load:", e)
		return 1
	}
	profile_read(&p, PROFILE)
	measure_columns(&ui, &p)
	editor_load(&ui)
	_ = crash_read(&ui)
	if layout_load(&ui) {
		restore_window(&ui)
	else
		fit_window(&ui, &p)
		default_layout(&ui)
	}
	clamp_panels(&ui)
	hub_start(&ui, &hub)
	run(&ui, &p, &hub)
	layout_save(&ui)
	DestroyRenderer(ui.renderer)
	DestroyWindow(ui.window)
	// (After the window's gone: serve may finish a check before it ends.)
	hub_stop(&hub)
	return 0
}

// Events until the window closes: drawn again when what it shows changed —
// no oftener than the display shows frames: a mouse moving says so a
// thousand times a second — the profile and the crash report read again
// when their files changed (a new crash brought to the front), and the hub's
// pipes looked at. (Waiting, not spinning: for an event, a
// quarter second at most to look at the file, less to look at the pipes —
// hub_wait — or, with something to draw, until it's time to.)
run :: fun(ui: ^Ui, p: ^Profile, hub: ^Hub) {
	looked := GetTicks()
	next : u64 = 0   // the soonest the next frame is drawn (GetTicksNS)
	for ui.running {
		wait := hub_wait(hub)
		if ui.dirty {
			now := GetTicksNS()
			if now >= next {
				measure(ui)
				draw_window(ui, p)
				ui.dirty = false
				// (The next a refresh after this one, and a little more: frames
				// sent faster than the display shows them queue up — the window
				// isn't made to wait — and the picture falls behind, the longer
				// the more: a dragged panel went on moving after its release.)
				next = now + ui.frame_ns + ui.frame_ns / 50
			else
				wait = i32((next - now) / 1000000) + 1
			}
		}
		ev : Event
		if WaitEventTimeout(&ev, wait) {
			handle(ui, p, &ev)
			for PollEvent(&ev) {
				handle(ui, p, &ev)
			}
		}
		hub_poll(ui, hub)
		if GetTicks() - looked >= 500 {
			looked = GetTicks()
			if file_mtime(PROFILE) != p.stamp {
				profile_read(p, PROFILE)
				measure_columns(ui, p)
				ui.dirty = true
			}
			if file_mtime(CRASH) != ui.crash_stamp {
				if crash_read(ui) do crash_show(ui)
				ui.dirty = true
			}
			colors_look(ui)
		}
	}
}

// One event: the window closed, resized or shown again; the mouse moved,
// pressed, released or wheeled; a key.
handle :: fun(ui: ^Ui, p: ^Profile, ev: ^Event) {
	e := ev^
	match e {
	Quit
		ui.running = false
	WindowCloseRequested
		ui.running = false
	WindowResized
		window_changed(ui)
	WindowPixelSizeChanged
		window_changed(ui)
	WindowExposed
		ui.dirty = true
	WindowDisplayScaleChanged
		measure(ui)
		le := text_load(&ui.text, ui.renderer, ui.font, FONT_SIZE * ui.density)
		if bool(le) do print("mara view: its font didn't load:", le)
		measure_columns(ui, p)
		window_changed(ui)
	MouseMotion
		ui.mouse_x = e.x * ui.density
		ui.mouse_y = e.y * ui.density
		if ui.drag != DRAG_NONE {
			// (A drag follows the OS cursor, as its press did: one source,
			// read now — an event's place can be an older one. The button not
			// held now: the drag's over, its release missed or not.)
			x, y, held := cursor_now(ui)
			if held {
				drag_to(ui, x, y)
			else
				end_drag(ui)
			}
		else
			look := cursor_look(ui, ui.mouse_x, ui.mouse_y)
			if look != ui.cursor {
				ui.cursor = look
				_ = SetCursor(ui.cursors[look])
			}
			// (Drawn again only when what's under it changes: all motion shows.)
			if profile_hover(ui, p) != ui.hover_row do ui.dirty = true
			if crash_hover(ui) != ui.crash_hover do ui.dirty = true
			if docs_hover(ui) != ui.docs_hover do ui.dirty = true
			if ui.menu_open != MENU_NONE {
				// (Over another menu's button: that menu, as menu bars do.)
				b := menu_button_at(ui, ui.mouse_x, ui.mouse_y)
				if b >= 0 and b != ui.menu_open {
					ui.menu_open = b
					ui.dirty = true
				}
				if menu_item_at(ui, ui.menu_open, ui.mouse_x, ui.mouse_y) != ui.menu_hover do ui.dirty = true
			}
		}
	WindowMouseLeave
		ui.mouse_x = -1.0
		ui.mouse_y = -1.0
		ui.dirty = true
	MouseButtonDown
		if e.button == 1 {
			x, y, _ := cursor_now(ui)
			press(ui, p, x, y, i64(e.clicks))
		}
	MouseButtonUp
		if e.button == 1 {
			end_drag(ui)
		}
	MouseWheel
		i := panel_at(ui, ui.mouse_x, ui.mouse_y)
		if i >= 0 {
			if ui.panels[i].kind == PROFILE_PANEL {
				// (Shift held: the wheel moves the table sideways; a wheel
				// that tilts, or a touchpad, moves it sideways anyway.)
				sideways := e.x
				if (GetModState() & KMOD_SHIFT) != 0 {
					sideways = -e.y
				else
					ui.scroll -= i64(e.y * 3.0)
				}
				ui.scroll_x += sideways * 60.0
				ui.dirty = true
			}
			l, has := panel_lines(ui, ui.panels[i].kind)
			if has {
				l.scroll -= i64(e.y * 3.0)
				ui.dirty = true
			}
		}
	KeyDown
		if e.scancode == Scancode.Escape and ui.menu_open != MENU_NONE {
			ui.menu_open = MENU_NONE
			ui.dirty = true
		}
		// (F5: the Docs panel's lookup made again, whatever's in front.)
		if e.scancode == Scancode.F5 do docs_reload(ui)
		// (Ctrl+C: what's selected copied, whichever panel it's in.)
		if (GetModState() & KMOD_CTRL) != 0 {
			if e.scancode == Scancode.C do select_copy(ui)
			if e.scancode == Scancode.A do select_all(ui)
		}
		// (Keys go to the front panel.)
		i := front_panel(ui)
		if i >= 0 {
			if ui.panels[i].kind == PROFILE_PANEL {
				page := visible_rows(ui, p, content_rect(ui, ui.panels[i]))
				if e.scancode == Scancode.Down do ui.scroll += 1
				if e.scancode == Scancode.Up do ui.scroll -= 1
				if e.scancode == Scancode.PageDown do ui.scroll += page
				if e.scancode == Scancode.PageUp do ui.scroll -= page
				if e.scancode == Scancode.Home do ui.scroll = 0
				if e.scancode == Scancode.End do ui.scroll = p.rows.len
				if e.scancode == Scancode.Left do ui.scroll_x -= 60.0
				if e.scancode == Scancode.Right do ui.scroll_x += 60.0
				ui.dirty = true
			}
			l, has := panel_lines(ui, ui.panels[i].kind)
			if has {
				page := lines_visible(ui, l, content_rect(ui, ui.panels[i]))
				if e.scancode == Scancode.Down do l.scroll += 1
				if e.scancode == Scancode.Up do l.scroll -= 1
				if e.scancode == Scancode.PageDown do l.scroll += page
				if e.scancode == Scancode.PageUp do l.scroll -= page
				if e.scancode == Scancode.Home do l.scroll = 0
				if e.scancode == Scancode.End do l.scroll = l.rows.len
				ui.dirty = true
			}
		}
	else
	}
}

// The lines a panel kind shows — the Docs panel's, the Ask panel's, the
// Crash panel's — and whether it shows lines (false: the others).
panel_lines :: fun(ui: ^Ui, kind: i64) -> ^Lines, bool {
	if kind == ASK_PANEL do return &ui.asked, true
	if kind == CRASH_PANEL do return &ui.crash, true
	return docs_shown(ui), kind == DOCS_PANEL
}

// The drag, if any, over: the layout saved — a selection's, its end
// (select_end).
end_drag :: fun(ui: ^Ui) {
	if ui.drag == DRAG_NONE do return
	if ui.drag == DRAG_SELECT {
		ui.drag = DRAG_NONE
		select_end(ui)
		return
	}
	ui.drag = DRAG_NONE
	layout_save(ui)
}

// The window resized: its size measured, the panels kept inside it.
window_changed :: fun(ui: ^Ui) {
	measure(ui)
	clamp_panels(ui)
	ui.dirty = true
}

// Where the cursor is in the window now, in pixels — its place on the
// screen less the window's — and whether the left button is held. (A
// button event's own place is wherever SDL last saw the mouse move: for a
// click before any motion it saw, (0, 0); for one right after a quick
// move, a place on the way.)
cursor_now :: fun(ui: ^Ui) -> f32, f32, bool {
	gx : f32 = 0
	gy : f32 = 0
	buttons := GetGlobalMouseState(&gx, &gy)
	wx : i32 = 0
	wy : i32 = 0
	_ = GetWindowPosition(ui.window, &wx, &wy)
	return (gx - f32(wx)) * ui.density, (gy - f32(wy)) * ui.density, (buttons & 1) != 0
}

// The window's size in pixels, and how many a window unit is.
measure :: fun(ui: ^Ui) {
	w : i32 = 0
	h : i32 = 0
	_ = GetRenderOutputSize(ui.renderer, &w, &h)
	units_w : i32 = 0
	units_h : i32 = 0
	_ = GetWindowSize(ui.window, &units_w, &units_h)
	ui.width = f32(w)
	ui.height = f32(h)
	ui.density = 1.0
	if units_w > 0 do ui.density = f32(w) / f32(units_w)
	// (The display's refresh: 60 a second when it doesn't say.)
	hz : f32 = 60.0
	mode := GetCurrentDisplayMode(GetDisplayForWindow(ui.window))
	if mode != void {
		if mode.refresh_rate > 1.0 do hz = mode.refresh_rate
	}
	ui.frame_ns = u64(1000000000.0 / hz)
}

// The room the window's display has for it, window units: the display's
// usable part (the taskbar left out), a little less.
display_room :: fun(ui: ^Ui) -> f32, f32 {
	room := SDL_Rect{}
	if not GetDisplayUsableBounds(GetDisplayForWindow(ui.window), &room) do return 100000.0, 100000.0
	return f32(room.w) - 40.0, f32(room.h) - 40.0
}

// The window, the first time: wide enough that the profile's panel, in
// the default layout, shows its table's every column — no wider than its
// display has room for.
fit_window :: fun(ui: ^Ui, p: ^Profile) {
	if p.problem.len > 0 do return
	room_w, _ := display_room(ui)
	units_w : i32 = 0
	units_h : i32 = 0
	_ = GetWindowSize(ui.window, &units_w, &units_h)
	want := ceil_f32((table_width(p) + 2.0) / 0.55 / ui.density)
	want = min_f32(want, room_w)
	if want > f32(units_w) {
		_ = SetWindowSize(ui.window, i32(want), units_h)
		measure(ui)
	}
}

// The window in front of the others (`mara view` again, with this one
// open), shown again first if it's minimized.
window_raise :: fun(ui: ^Ui) {
	flags := GetWindowFlags(ui.window)
	if (flags & 64) != 0 do _ = RestoreWindow(ui.window)   // (Minimized)
	// (Windows lets only the program in front put a window in front — asked
	// from Sublime, the window behind it only flashed in the taskbar — so
	// forced: SDL takes the front window's input as its own for the moment.
	// That un-maximizes a window: maximized again.)
	_ = SetHint(cstring("SDL_FORCE_RAISEWINDOW"), cstring("1"))
	_ = RaiseWindow(ui.window)
	_ = SetHint(cstring("SDL_FORCE_RAISEWINDOW"), cstring("0"))
	if (flags & 128) != 0 do _ = MaximizeWindow(ui.window)   // (Maximized)
	ui.dirty = true
}

// The window as big as layout.txt had it, no bigger than its display.
restore_window :: fun(ui: ^Ui) {
	if ui.saved_width < 1.0 or ui.saved_height < 1.0 do return
	room_w, room_h := display_room(ui)
	w := min_f32(f32(ui.saved_width) / ui.density, room_w)
	h := min_f32(f32(ui.saved_height) / ui.density, room_h)
	_ = SetWindowSize(ui.window, i32(w), i32(h))
	measure(ui)
}
