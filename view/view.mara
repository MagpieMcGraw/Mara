module view

// The Mara window: `mara view` opens it on a module. It shows panels
// (panels.mara) — for now the module's profile.txt (build with `mara build
// -profile`, run the program), every probed fun's times sorted by whichever
// column is clicked, read again whenever the program writes it; and the
// keys. Panels are moved, resized, shown and hidden; the layout is kept.
//   view <compiler> <module> <pipe name>   (as `mara view` starts it)
// Its font, Inter (OFL.txt), and SDL3.dll are beside it, and its layout,
// layout.txt. Built here: `mara build view` — with the window closed
// (Windows won't write over a program that's running).

use mara.core
use mara.os
use mara.math
use mara.sdl
include mara.memory

PROFILE   :: "profile.txt"   // in the directory it runs in: the module's
FONT_SIZE :: 15.0            // the text's em, pixels on a display at 100%
PAD       :: 12.0            // room around text: a panel's margin, a column's
ROW_PAD   :: 3.0             // room above and below a line of text in a bar or row
FRAME_MS  :: u64(8)          // the least time between two frames drawn

// The window and what it shows.
Ui :: struct {
	window:   Window
	renderer: Renderer
	text:     Text
	font:     [..1000]utf8   // the font's path
	layout_path: [..1000]utf8
	density:  f32            // pixels a window unit (a high-density display has more)
	width:    f32            // the window's size, pixels
	height:   f32
	saved_width:  f64        // its size as layout.txt had it
	saved_height: f64
	mouse_x:  f32            // the mouse, pixels; -1 when it's outside
	mouse_y:  f32
	cursors:  [10]Cursor     // the system's, by SYSTEM_CURSOR_...
	cursor:   i32            // the one shown
	running:  bool = true
	dirty:    bool = true    // drawn again when it is

	panels:   [..8]Panel     // back to front: the last is drawn over the rest
	menu_open:  bool
	menu_hover: i64 = -1     // the menu's item under the mouse as last drawn
	drag:       i64          // DRAG_NONE, _MOVE, _RESIZE: what the mouse is doing
	drag_kind:  i64          // the panel dragged
	drag_edges: i64          // a resize's edges (EDGE_...)
	drag_x:     f32          // the mouse where the drag began
	drag_y:     f32
	drag_box:   Rect         // the panel's box then

	// The Profile panel's.
	hover_row: i64 = -1      // the row under the mouse as last drawn; -1: none
	scroll:   i64            // the first row shown
	scroll_x: f32            // pixels the table is scrolled sideways

	ground     := Color{r = 22, g = 23, b = 25}    // the window behind the panels
	background := Color{r = 30, g = 31, b = 34}    // a panel's
	border     := Color{r = 58, g = 60, b = 66}
	stripe     := Color{r = 36, g = 37, b = 41}    // every other row
	hover      := Color{r = 52, g = 55, b = 62}    // what's under the mouse
	header     := Color{r = 44, g = 46, b = 51}    // bars: the menu, titles, a status line
	ink        := Color{r = 222, g = 222, b = 222}
	dim        := Color{r = 150, g = 152, b = 158}
	accent     := Color{r = 236, g = 180, b = 80}  // the column sorted by; a shown panel
	bad        := Color{r = 240, g = 120, b = 110}
}

main :: fun() -> i64 {
	this_program = Program(Arena_Basic(256 * MB))
	ui : Ui
	p : Profile

	// (Its font and its layout beside it: the directory of its own path.)
	exe := this_program.args[0]
	dir_end : i64 = 0
	for ch, i in exe {
		if ch == '\\' or ch == '/' do dir_end = i + 1
	}
	&ui.font + exe[0 : dir_end]
	&ui.font + "Inter.ttf"
	&ui.layout_path + exe[0 : dir_end]
	&ui.layout_path + "layout.txt"

	title : str256
	if this_program.args.len > 2 {
		&title + this_program.args[2]
		&title + " - "
	}
	&title + "mara view"

	// (A click that brings the window forward is a click too: on Windows SDL
	// would drop it.)
	_ = SetHint("SDL_MOUSE_FOCUS_CLICKTHROUGH", "1")
	if not Init(Video) {
		print("mara view: SDL didn't start")
		return 1
	}
	defer Quit()
	ui.window = CreateWindow(cstring(title), 1100, 700, Resizable | HighPixelDensity)
	ui.renderer = CreateRenderer(ui.window, void)
	// (No vsync: it's drawn only when what it shows changes, and a frame
	// sent waits for none before it — with vsync, frames sent faster than the
	// screen shows them queue up, and a click's waits behind them.)
	_ = SetRenderVSync(ui.renderer, 0)
	for id in 0 .. 10 {
		ui.cursors[id] = CreateSystemCursor(i32(id))
	}
	measure(&ui)
	e := text_load(&ui.text, ui.renderer, ui.font, FONT_SIZE * ui.density)
	if bool(e) {
		print("mara view: its font didn't load:", e)
		return 1
	}
	profile_read(&p, PROFILE)
	measure_columns(&ui, &p)
	if layout_load(&ui) {
		restore_window(&ui)
	else
		fit_window(&ui, &p)
		default_layout(&ui)
	}
	clamp_panels(&ui)
	run(&ui, &p)
	layout_save(&ui)
	DestroyRenderer(ui.renderer)
	DestroyWindow(ui.window)
	return 0
}

// Events until the window closes: drawn again when what it shows changed —
// no oftener than FRAME_MS: a mouse moving says so a thousand times a second
// — and the profile read again when the file changed. (Waiting, not
// spinning: for an event, a quarter second at most to look at the file, or,
// with something to draw, until it's time to.)
run :: fun(ui: ^Ui, p: ^Profile) {
	looked := GetTicks()
	drawn : u64 = 0   // when it was last drawn (GetTicksNS)
	for ui.running {
		wait : i32 = 250
		if ui.dirty {
			since := (GetTicksNS() - drawn) / 1000000
			if since >= FRAME_MS {
				measure(ui)
				draw_window(ui, p)
				drawn = GetTicksNS()
				ui.dirty = false
			else
				wait = i32(FRAME_MS - since)
			}
		}
		ev : Event
		if WaitEventTimeout(&ev, wait) {
			handle(ui, p, &ev)
			for PollEvent(&ev) {
				handle(ui, p, &ev)
			}
		}
		if GetTicks() - looked >= 500 {
			looked = GetTicks()
			if file_mtime(PROFILE) != p.stamp {
				profile_read(p, PROFILE)
				measure_columns(ui, p)
				ui.dirty = true
			}
		}
	}
}

// One event: the window closed, resized or shown again; the mouse moved,
// pressed, released or wheeled; a key.
handle :: fun(ui: ^Ui, p: ^Profile, ev: ^Event) {
	e := ev^
	match e {
	Quit
		ui.running = false
	WindowCloseRequested
		ui.running = false
	WindowResized
		window_changed(ui)
	WindowPixelSizeChanged
		window_changed(ui)
	WindowExposed
		ui.dirty = true
	WindowDisplayScaleChanged
		measure(ui)
		le := text_load(&ui.text, ui.renderer, ui.font, FONT_SIZE * ui.density)
		if bool(le) do print("mara view: its font didn't load:", le)
		measure_columns(ui, p)
		window_changed(ui)
	MouseMotion
		ui.mouse_x = e.x * ui.density
		ui.mouse_y = e.y * ui.density
		if ui.drag != DRAG_NONE {
			drag_to(ui, ui.mouse_x, ui.mouse_y)
		else
			look := cursor_look(ui, ui.mouse_x, ui.mouse_y)
			if look != ui.cursor {
				ui.cursor = look
				_ = SetCursor(ui.cursors[look])
			}
			// (Drawn again only when what's under it changes: all motion shows.)
			if profile_hover(ui, p) != ui.hover_row do ui.dirty = true
			if ui.menu_open and menu_item_at(ui, ui.mouse_x, ui.mouse_y) != ui.menu_hover do ui.dirty = true
		}
	WindowMouseLeave
		ui.mouse_x = -1.0
		ui.mouse_y = -1.0
		ui.dirty = true
	MouseButtonDown
		if e.button == 1 {
			x, y := cursor_in_window(ui)
			press(ui, p, x, y)
		}
	MouseButtonUp
		if e.button == 1 and ui.drag != DRAG_NONE {
			ui.drag = DRAG_NONE
			layout_save(ui)
		}
	MouseWheel
		i := panel_at(ui, ui.mouse_x, ui.mouse_y)
		if i >= 0 {
			if ui.panels[i].kind == PROFILE_PANEL {
				// (Shift held: the wheel moves the table sideways; a wheel
				// that tilts, or a touchpad, moves it sideways anyway.)
				sideways := e.x
				if (GetModState() & KMOD_SHIFT) != 0 {
					sideways = -e.y
				else
					ui.scroll -= i64(e.y * 3.0)
				}
				ui.scroll_x += sideways * 60.0
				ui.dirty = true
			}
		}
	KeyDown
		if e.scancode == Scancode.Escape and ui.menu_open {
			ui.menu_open = false
			ui.dirty = true
		}
		// (Keys go to the front panel.)
		i := front_panel(ui)
		if i >= 0 {
			if ui.panels[i].kind == PROFILE_PANEL {
				page := visible_rows(ui, p, content_rect(ui, ui.panels[i]))
				if e.scancode == Scancode.Down do ui.scroll += 1
				if e.scancode == Scancode.Up do ui.scroll -= 1
				if e.scancode == Scancode.PageDown do ui.scroll += page
				if e.scancode == Scancode.PageUp do ui.scroll -= page
				if e.scancode == Scancode.Home do ui.scroll = 0
				if e.scancode == Scancode.End do ui.scroll = p.rows.len
				if e.scancode == Scancode.Left do ui.scroll_x -= 60.0
				if e.scancode == Scancode.Right do ui.scroll_x += 60.0
				ui.dirty = true
			}
		}
	else
	}
}

// The window resized: its size measured, the panels kept inside it.
window_changed :: fun(ui: ^Ui) {
	measure(ui)
	clamp_panels(ui)
	ui.dirty = true
}

// Where the cursor is in the window, in pixels: its place on the screen less
// the window's. (A button event's own place is wherever SDL last saw the
// mouse move — for a click before any motion it saw, the first one on a
// window just opened or brought forward, (0, 0).)
cursor_in_window :: fun(ui: ^Ui) -> f32, f32 {
	gx : f32 = 0
	gy : f32 = 0
	_ = GetGlobalMouseState(&gx, &gy)
	wx : i32 = 0
	wy : i32 = 0
	_ = GetWindowPosition(ui.window, &wx, &wy)
	return (gx - f32(wx)) * ui.density, (gy - f32(wy)) * ui.density
}

// The window's size in pixels, and how many a window unit is.
measure :: fun(ui: ^Ui) {
	w : i32 = 0
	h : i32 = 0
	_ = GetRenderOutputSize(ui.renderer, &w, &h)
	units_w : i32 = 0
	units_h : i32 = 0
	_ = GetWindowSize(ui.window, &units_w, &units_h)
	ui.width = f32(w)
	ui.height = f32(h)
	ui.density = 1.0
	if units_w > 0 do ui.density = f32(w) / f32(units_w)
}

// The room the window's display has for it, window units: the display's
// usable part (the taskbar left out), a little less.
display_room :: fun(ui: ^Ui) -> f32, f32 {
	room := SDL_Rect{}
	if not GetDisplayUsableBounds(GetDisplayForWindow(ui.window), &room) do return 100000.0, 100000.0
	return f32(room.w) - 40.0, f32(room.h) - 40.0
}

// The window, the first time: as wide as the profile's table — no wider
// than its display has room for — so every column shows.
fit_window :: fun(ui: ^Ui, p: ^Profile) {
	if p.problem.len > 0 do return
	room_w, _ := display_room(ui)
	units_w : i32 = 0
	units_h : i32 = 0
	_ = GetWindowSize(ui.window, &units_w, &units_h)
	want := ceil_f32((table_width(p) + 2.0 * MARGIN + 2.0) / ui.density)
	want = min_f32(want, room_w)
	if want > f32(units_w) {
		_ = SetWindowSize(ui.window, i32(want), units_h)
		measure(ui)
	}
}

// The window as big as layout.txt had it, no bigger than its display.
restore_window :: fun(ui: ^Ui) {
	if ui.saved_width < 1.0 or ui.saved_height < 1.0 do return
	room_w, room_h := display_room(ui)
	w := min_f32(f32(ui.saved_width) / ui.density, room_w)
	h := min_f32(f32(ui.saved_height) / ui.density, room_h)
	_ = SetWindowSize(ui.window, i32(w), i32(h))
	measure(ui)
}

// A count as digits.
count_text :: fun(n: i64) -> str64 {
	backwards : [..24]utf8
	v := n
	for true {
		&backwards + utf8(i64('0') + v % 10)
		v /= 10
		if v == 0 do break
	}
	out : str64
	for i in 0 .. backwards.len {
		&out + backwards[backwards.len - 1 - i]
	}
	return out
}
