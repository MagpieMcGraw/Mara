module view

use mara.core
use mara.string
use mara.os
use mara.math
use mara.sdl

// The window's side of `mara ask` and `mara docs` (the compiler's
// view.odin): it listens on the pipe name `mara view` gives it and keeps a
// `mara serve` of its own running. Each connection sends a line, answered
// with an end line after (serve's: "-- end of answer --", or "...: failed
// --"), then closed:
//   <query>          what serve answers it — as `mara ask <query>` would
//   -show <query>    the same, shown in the Ask panel (an editor's queries)
//   -cursor <query>  the same, shown at the Ask panel's top: what's at the
//                    editor's cursor (`mara ask -cursor what at <point>`)
//   -raise           the window brought to the front: `mara view` with it
//                    open already
// Docs aren't the module's: every window the compiler opens listens for
// them on one name, the docs pipe name it's given too — the first window
// opened answers there, the others try again every few seconds, so one
// takes over when it closes. Its line:
//   -docs <directory><tab><words>[<tab><kind><tab><name><tab><path><tab><line>]
// what the Docs panel finds for the words, in that directory's .mara files
// and the stdlib's, shown there — the four more fields what the name at
// the editor's cursor refers to: shown first. There too:
//   -editor <program>  the editor a call in the Crash panel opens in, kept
//                      for every window (`mara editor`; crash.mara)
// Never waiting: looked at between frames
// (hub_poll). Queries go to serve one at a time, in the order their lines
// came; docs are answered at once. Serve, ended — a compiler bug stops it —
// is started again for the next query.

DOCS_RETRY :: 2000   // ms between tries to take the docs pipe name

ANSWER_DONE   :: "-- end of answer --"
ANSWER_FAILED :: "-- end of answer: failed --"

// A connection, its line coming.
Client :: struct {
	id:    File_Id
	line:  [..2000]utf8   // as it comes; whole once it ends in '\n'
	whole: bool
	docs:  bool           // it came on the docs pipe: docs are all it's answered
}

Hub :: struct {
	listening: bool
	listener:  Pipe_Listener
	command:   [..2000]utf8   // "<compiler>" serve <module>
	serve:     Process
	serving:   bool           // serve started, not ended
	waiting:   [..16]Client   // connected, their lines coming or waiting for serve
	asked:     Client         // the one whose query serve is answering
	asking:    bool
	shown:     bool           // ... a query the Ask panel shows
	cursor:    bool           // ... what's at the editor's cursor, shown at its top
	cursor_started: bool      // ... its first line come: the last one's replaced
	gone:      bool           // ... its connection failed: the answer read on to its end
	current:   [..4000]utf8   // serve's answer's line coming

	docs_name:      [..300]utf8   // the docs pipe name; none: `mara view` gave none
	docs_listening: bool
	docs_listener:  Pipe_Listener
	docs_tried:     u32           // when listening there was last tried (GetTicks)
}

// Listening on the pipe name, serve started — when `mara view` gave a name.
hub_start :: fun(ui: ^Ui, h: ^Hub) {
	args := this_program.args
	if args.len > 4 {
		&h.docs_name + args[4]
		docs_listen(h)
	}
	if args.len < 4 do return
	&h.command + "\""
	&h.command + args[1]
	&h.command + "\" serve "
	&h.command + args[2]
	l, e := pipe_listen(args[3])
	if bool(e) {
		if e == .Name_Taken {
			lines_status(&ui.asked, "Another window open on this module answers mara ask.", STYLE_DIM)
		else
			lines_status(&ui.asked, "mara ask can't reach this window: listening on its pipe failed.", STYLE_BAD)
		}
		return
	}
	h.listener = l
	h.listening = true
	// (Serve checks the module as it starts: ready by the first query.)
	_ = serve_up(h)
}

// Listening stopped, the connections closed, serve ended.
hub_stop :: fun(h: ^Hub) {
	if h.docs_listening {
		pipe_listen_stop(&h.docs_listener)
		h.docs_listening = false
	}
	for i in 0 .. h.waiting.len {
		file_close(h.waiting[i].id)
	}
	h.waiting.len = 0
	if not h.listening do return
	pipe_listen_stop(&h.listener)
	if h.asking do file_close(h.asked.id)
	serve_down(h)
	h.listening = false
}

// Listening on the docs pipe name, unless another window does: tried again
// DOCS_RETRY later (hub_poll).
docs_listen :: fun(h: ^Hub) {
	h.docs_tried = GetTicks()
	l, e := pipe_listen(h.docs_name)
	if bool(e) do return
	h.docs_listener = l
	h.docs_listening = true
}

// The connections that have come to a listener, into the waiting list:
// `docs`, the docs pipe's.
take_connections :: fun(h: ^Hub, l: ^Pipe_Listener, docs: bool) {
	for h.waiting.len < h.waiting.cap {
		c, e := pipe_accept(l)
		if bool(e) or c == NO_FILE do break
		// (Its place filled where it is: a Client is too big to build aside.)
		h.waiting.len += 1
		fresh := &h.waiting[h.waiting.len - 1]
		fresh.id = c
		fresh.line.len = 0
		fresh.whole = false
		fresh.docs = docs
	}
}

// How long the window may wait for an event before looking again, ms:
// soon while connections are coming or a query is with serve.
hub_wait :: fun(h: ^Hub) -> i32 {
	if not h.listening and not h.docs_listening do return 250
	if h.asking or h.waiting.len > 0 do return 2
	return 25
}

// What's arrived since the last look: connections taken, their lines read,
// docs answered, the next query sent to serve, serve's answer passed on.
hub_poll :: fun(ui: ^Ui, h: ^Hub) {
	if not h.docs_listening and h.docs_name.len > 0 and GetTicks() - h.docs_tried >= DOCS_RETRY do docs_listen(h)
	if h.docs_listening do take_connections(h, &h.docs_listener, true)
	if h.listening do take_connections(h, &h.listener, false)
	i : i64 = 0
	for i < h.waiting.len {
		if not h.waiting[i].whole and not client_read(&h.waiting[i]) {
			// (Gone before its line ended.)
			file_close(h.waiting[i].id)
			drop_waiting(h, i)
			continue
		}
		if h.waiting[i].whole and starts_with(h.waiting[i].line[:], "-editor ") {
			line := line_of(&h.waiting[i])
			editor_set(ui, line[8 : line.len])
			_ = file_write_text(h.waiting[i].id, "-- end of answer --\n")
			file_close(h.waiting[i].id)
			drop_waiting(h, i)
			continue
		}
		if h.waiting[i].whole and not h.waiting[i].docs and starts_with(h.waiting[i].line[:], "-raise") {
			window_raise(ui)
			_ = file_write_text(h.waiting[i].id, "-- end of answer --\n")
			file_close(h.waiting[i].id)
			drop_waiting(h, i)
			continue
		}
		if h.waiting[i].whole and starts_with(h.waiting[i].line[:], "-docs ") {
			answer_docs(ui, &h.waiting[i])
			file_close(h.waiting[i].id)
			drop_waiting(h, i)
			continue
		}
		if h.waiting[i].whole and starts_with(h.waiting[i].line[:], "-reload") {
			// (`mara docs -reload`: what the Docs panel shows looked up again, as F5 does.)
			docs_reload(ui)
			answer_lines(&ui.docs[ui.docs_front], &h.waiting[i], ui.docs_query[ui.docs_front].made)
			file_close(h.waiting[i].id)
			drop_waiting(h, i)
			continue
		}
		if h.waiting[i].whole and h.waiting[i].docs {
			// (A query on the docs pipe: not this window's to answer.)
			_ = file_write_text(h.waiting[i].id, "the docs pipe answers -docs lines only\n-- end of answer: failed --\n")
			file_close(h.waiting[i].id)
			drop_waiting(h, i)
			continue
		}
		i += 1
	}
	if not h.asking {
		for k in 0 .. h.waiting.len {
			if h.waiting[k].whole {
				h.asked = h.waiting[k]
				drop_waiting(h, k)
				ask_serve(ui, h)
				break
			}
		}
	}
	if h.asking do read_answer(ui, h)
}

// Client c's line read, what has arrived of it: false when its connection
// ended first.
client_read :: fun(c: ^Client) -> bool {
	chunk : [..512]byte
	open, e := pipe_read(c.id, &chunk)
	if bool(e) or not open do return false
	text : []utf8 = chunk[:]
	for ch in text {
		if c.line.len == c.line.cap do return false   // (no query is that long)
		&c.line + ch
		if ch == '\n' {
			c.whole = true
			break
		}
	}
	return true
}

// Waiting connection i taken off the list.
drop_waiting :: fun(h: ^Hub, i: i64) {
	for k in i .. h.waiting.len - 1 {
		h.waiting[k] = h.waiting[k + 1]
	}
	h.waiting.len -= 1
}

// A line without its line end.
line_of :: fun(c: ^Client) -> []utf8 {
	n := c.line.len
	for n > 0 {
		if c.line[n - 1] != '\n' and c.line[n - 1] != '\r' do break
		n -= 1
	}
	return c.line[0 : n]
}

// A "-docs <words>" line answered: the words looked up, the Docs panel
// showing what's found; the connection sent it as text, its end line after.
answer_docs :: fun(ui: ^Ui, c: ^Client) {
	line := line_of(c)
	// (Its fields, between tabs: the directory, the words, then the cursor's
	// kind, name, path and line. One field alone: the words, the window's
	// own directory.)
	fields : [6][]utf8
	n : i64 = 0
	start : i64 = 6
	for k in 6 .. line.len + 1 {
		ends := k == line.len
		if not ends do ends = line[k] == '\t'
		if ends {
			if n < 6 {
				fields[n] = line[start : k]
				n += 1
			}
			start = k + 1
		}
	}
	dir := line[0 : 0]
	words := fields[0]
	if n >= 2 {
		dir = fields[0]
		words = fields[1]
	}
	ex : Exact
	if n >= 6 {
		at_line, _ := parse_number(fields[5])
		ex = Exact{kind = fields[2], name = fields[3], path = fields[4], line = i64(at_line)}
	}
	docs_search(ui, dir, words, ex, -1)
	ui.dirty = true
	// (The lines it filled: the shown ones, or while pinned, the waiting ones.)
	found := &ui.docs[ui.docs_front]
	if ui.docs_pinned do found = &ui.docs[1 - ui.docs_front]
	answer_lines(found, c, ui.search.count > 0 or ui.search.exact_shown)
}

// Lines sent as an answer: the status line, a blank one, each line; then the
// end line — failed when nothing was `found`.
answer_lines :: fun(found: ^Lines, c: ^Client, ok: bool) {
	out : [..64 * KB]utf8
	&out + found.status[:]
	&out + "\n\n"
	for k in 0 .. found.lines.len {
		text := line_text(found, k)
		if out.len + text.len + 1 > out.cap {
			if bool(file_write_text(c.id, out[:])) do return
			out.len = 0
		}
		&out + text[0 : min_int(text.len, out.cap - 1)]
		&out + "\n"
	}
	if not ok {
		&out + ANSWER_FAILED
	else
		&out + ANSWER_DONE
	}
	&out + "\n"
	_ = file_write_text(c.id, out[:])
}

// The asked connection's query sent to serve — started if it isn't; one
// that ended since the last, found by the write failing, started again.
// A "-show " query is shown in the Ask panel as it's answered.
ask_serve :: fun(ui: ^Ui, h: ^Hub) {
	line := line_of(&h.asked)
	h.shown = starts_with(line, "-show ")
	h.cursor = starts_with(line, "-cursor ")
	h.cursor_started = false
	query := line
	if h.shown do query = line[6 : line.len]
	if h.cursor do query = line[8 : line.len]
	if h.shown {
		lines_clear(&ui.asked)
		heading : [..2100]utf8
		&heading + "mara ask "
		&heading + query
		lines_add(&ui.asked, heading[:], STYLE_QUERY)
		lines_add(&ui.asked, "", STYLE_TEXT)
		lines_status(&ui.asked, "Asking…", STYLE_DIM)
		ui.dirty = true
	}
	h.gone = false
	h.current.len = 0
	sent : [..2100]utf8
	&sent + query
	&sent + "\n"
	if serve_up(h) {
		if not bool(file_write_text(h.serve.input, sent[:])) {
			h.asking = true
			return
		}
		serve_down(h)
		if serve_up(h) {
			if not bool(file_write_text(h.serve.input, sent[:])) {
				h.asking = true
				return
			}
		}
	}
	// (No serve to ask: cut off, the connection makes `mara ask` check for itself.)
	file_close(h.asked.id)
	if h.shown do lines_status(&ui.asked, "mara serve didn't start: mara ask checked for itself.", STYLE_BAD)
	ui.dirty = true
}

// What has arrived of serve's answer: passed on to the asker as it comes,
// its lines to the Ask panel when it's shown; at its end line, the
// connection closed.
read_answer :: fun(ui: ^Ui, h: ^Hub) {
	chunk : [..16 * KB]byte
	open, e := pipe_read(h.serve.output, &chunk)
	if bool(e) or not open {
		// (Serve ended answering it — maybe for it. Cut off, with no end
		// line: `mara ask` checks for itself. The next query starts serve.)
		serve_down(h)
		file_close(h.asked.id)
		h.asking = false
		if h.shown do lines_status(&ui.asked, "mara serve ended answering: mara ask checked for itself.", STYLE_BAD)
		ui.dirty = true
		return
	}
	if chunk.len == 0 do return
	if not h.gone {
		piece : []byte = chunk[:]
		_, we := file_write(h.asked.id, &piece)
		if bool(we) do h.gone = true
	}
	text : []utf8 = chunk[:]
	for ch in text {
		if ch != '\n' {
			if h.current.len < h.current.cap do &h.current + ch
			continue
		}
		line := trimmed(h.current[:])
		if starts_with(line, "-- end of answer") {
			file_close(h.asked.id)
			h.asking = false
			if h.shown {
				if line == ANSWER_FAILED {
					lines_status(&ui.asked, "Failed: what mara ask said is above.", STYLE_BAD)
				else
					lines_status(&ui.asked, "Answered.", STYLE_DIM)
				}
			}
			// (Nothing at the cursor — a blank, a comment: nothing shown.)
			if h.cursor and (line == ANSWER_FAILED or not h.cursor_started) do lines_clear(&ui.at_cursor)
			ui.dirty = true
			h.current.len = 0
			return
		}
		if h.shown {
			lines_add(&ui.asked, h.current[:], STYLE_TEXT)
			ui.dirty = true
		}
		if h.cursor {
			if not h.cursor_started {
				lines_clear(&ui.at_cursor)
				h.cursor_started = true
			}
			lines_add(&ui.at_cursor, h.current[:], cursor_style(ui.at_cursor.lines.len, h.current[:]))
			ui.dirty = true
		}
		h.current.len = 0
	}
}

// How a line of `mara ask what at`'s answer is shown, the n-th: the first
// (what the name is) a title; where it's declared, what it's in, dim; the
// code — a signature, the expressions around it — as code.
cursor_style :: fun(n: i64, line: []utf8) -> i64 {
	if n == 0 do return STYLE_TITLE
	if starts_with(line, "  declared") or starts_with(line, "  in ") or starts_with(line, "  built into") do return STYLE_DIM
	return STYLE_CODE
}

// Serve running: started unless it is. False when it can't be.
serve_up :: fun(h: ^Hub) -> bool {
	if h.serving do return true
	p, e := process_start(h.command)
	if bool(e) do return false
	h.serve = p
	h.serving = true
	return true
}

// Serve ended — its input closed: it ends there — and waited for.
serve_down :: fun(h: ^Hub) {
	if not h.serving do return
	_, we := process_wait(&h.serve)
	h.serving = false
	if bool(we) do return   // (its handles closed all the same)
}
