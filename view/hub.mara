module view

use mara.core
use mara.string
use mara.files
use mara.paths
os :: use mara.os
use mara.math
use mara.memory
use mara.sdl

// The window's side of `mara ask` and `mara docs` (the compiler's
// view.odin): it listens on the pipe name `mara view` gives it and keeps a
// `mara serve` of its own running. A compiler has one window, whatever module
// it's asked about. Each connection sends a line, answered with an end line
// after (serve's: "-- end of answer --", or "...: failed --"), then closed.
// A query says where it's asked from, and serve goes there to answer it:
//   -in "<folder>" <module> <query>     what serve answers, as `mara ask
//                       <query>` would there
//   -show -in ...       the same, shown in the Ask panel (an editor's queries)
//   -cursor -in ...     the same, shown at the Ask panel's top: what's at the
//                       editor's cursor (`mara ask -cursor what at <point>`)
//   -raise -in "<folder>" <module>      the window brought to the front:
//                       `mara view` with it open already
// -show, -cursor and -raise also move the window to that module (hub_follow).
// The others:
//   -docs <directory><tab><words>[<tab><kind><tab><name><tab><path><tab><line>]
//                       what the Docs panel finds for the words, in that
//                       directory's .mara files and the stdlib's, shown there.
//                       The four more fields say what the name at the editor's
//                       cursor refers to: shown first.
//   -editor <program>   the editor a call in the Crash panel opens in
//                       (`mara editor`; crash.mara)
//   -colors <name>=#rrggbb ...  Sublime's colors, for the Sublime theme
//                       (`mara colors`; theme.mara)
// Never waiting: looked at between frames (hub_poll). Queries go to serve one
// at a time, in the order their lines came; docs are answered at once. Serve,
// ended — a compiler bug stops it — is started again for the next query.

ANSWER_DONE   :: "-- end of answer --"
ANSWER_FAILED :: "-- end of answer: failed --"

// A connection, its line coming.
Client :: struct {
	id:    File_Id
	line:  [2000]utf8   // as it comes; whole once it ends in '\n'
	whole: bool
}

Hub :: struct {
	listening: bool
	listener:  os.Pipe_Listener
	compiler:  [1000]utf8   // the compiler's path
	command:   [2000]utf8   // "<compiler>" serve <module>
	dir:       [1000]utf8   // the folder the window runs in
	module_name: [300]utf8  // the module it's on there
	moved:     bool           // it's gone to another folder: its files to read (run)
	serve:     os.Process
	serving:   bool           // serve started, not ended
	waiting:   [16]Client   // connected, their lines coming or waiting for serve
	asked:     Client         // the one whose query serve is answering
	asking:    bool
	shown:     bool           // ... a query the Ask panel shows
	cursor:    bool           // ... what's at the editor's cursor, shown at its top
	cursor_started: bool      // ... its first line come: the last one's replaced
	cursor_errors:  bool      // ... the module's errors in it: it doesn't check
	gone:      bool           // ... its connection failed: the answer read on to its end
	sent:      [2100]utf8   // ... the line serve was sent
	answered:  bool           // ... any of the answer come
	resent:    bool           // ... sent again, to a serve started anew
	current:   [4000]utf8   // serve's answer's line coming
}

// Listening on the pipe name, serve started — when `mara view` gave a name
// (the view's command line, main's args).
hub_start :: fun(ui: ^Ui, h: ^Hub, args: [][]utf8) {
	if args.len < 4 do return
	&h.compiler ++ args[1]
	&h.module_name ++ args[2]
	here, no_dir := current_dir()
	if not no_dir do &h.dir ++ here
	serve_command(h)
	l, e := os.pipe_listen(args[3])
	if e {
		if e == os.Name_Taken {
			lines_status(&ui.asked, "Another window answers mara ask.", STYLE_DIM)
		else
			lines_status(&ui.asked, "mara ask can't reach this window: listening on its pipe failed.", STYLE_BAD)
		}
		return
	}
	h.listener = l
	h.listening = true
	// (Serve checks the module as it starts: ready by the first query.)
	_ = serve_up(h)
}

// The command that starts serve: on the module the window's on, in the folder
// the window runs in.
serve_command :: fun(h: ^Hub) {
	h.command = []   // (all 0 again: it goes to C, which needs a 0 after it)
	&h.command ++ "\""
	&h.command ++ h.compiler
	&h.command ++ "\" serve "
	&h.command ++ h.module_name
}

// Where a line says it's asked from, `-in "<folder>" <module>` at its start:
// the folder, the module, and what's after them. When it doesn't say: both
// empty, and the whole line.
line_place :: fun(line: []utf8) -> ([]utf8, []utf8, []utf8) {
	if not starts_with(line, "-in \"") do return line[0 : 0], line[0 : 0], line
	start : i64 = 5
	end := start
	for end < line.len {
		if line[end] == '"' do break
		end += 1
	}
	dir := line[start : end]
	start = min_int(end + 2, line.len)
	end = start
	for end < line.len {
		if line[end] == ' ' do break
		end += 1
	}
	return dir, line[start : end], line[min_int(end + 1, line.len) : line.len]
}

// The window moved to where an editor is: the module named, in its folder. The
// title says which module. The window now runs in that folder, so its Profile
// and Crash panels show that folder's files (run reads them: h.moved). Reading
// in the stdlib's folders or doc/ doesn't move it: you're still on your
// program.
hub_follow :: fun(ui: ^Ui, h: ^Hub, dir: []utf8, name: []utf8) {
	if dir.len == 0 or stdlib_dir(ui, dir) do return
	same_dir := same_path(dir, h.dir)
	on : []utf8 = h.module_name
	if same_dir and name == on do return
	if not same_dir {
		if set_current_dir(dir) {
			lines_status(&ui.asked, "The window couldn't go to that module's folder.", STYLE_BAD)
			return
		}
		h.dir.len = 0
		&h.dir ++ dir
		h.moved = true
	}
	h.module_name.len = 0
	&h.module_name ++ name
	serve_command(h)
	title := window_title(name)
	_ = SetWindowTitle(ui.window, cstring(title))
	ui.dirty = true
}

// Listening stopped, the connections closed, serve ended.
hub_stop :: fun(h: ^Hub) {
	for i in 0:h.waiting.len {
		file_close(h.waiting[i].id)
	}
	h.waiting.len = 0
	if not h.listening do return
	os.pipe_listen_stop(&h.listener)
	if h.asking do file_close(h.asked.id)
	serve_down(h)
	h.listening = false
}

// The connections that have come, into the waiting list.
take_connections :: fun(h: ^Hub) {
	for h.waiting.len < h.waiting.cap {
		c, e := os.pipe_accept(&h.listener)
		if e or c == NO_FILE do break
		// (Its place filled where it is: a Client is too big to build aside.)
		h.waiting.len += 1
		fresh := &h.waiting[h.waiting.len - 1]
		fresh.id = c
		fresh.line.len = 0
		fresh.whole = false
	}
}

// How long the window may wait for an event before looking again, ms:
// soon while connections are coming or a query is with serve.
hub_wait :: fun(h: ^Hub) -> i32 {
	if not h.listening do return 250
	if h.asking or h.waiting.len > 0 do return 2
	return 25
}

// What's arrived since the last look: connections taken, their lines read,
// docs answered, the next query sent to serve, serve's answer passed on.
hub_poll :: fun(ui: ^Ui, h: ^Hub) {
	if h.listening do take_connections(h)
	i : i64 = 0
	for i < h.waiting.len {
		if not h.waiting[i].whole and not client_read(&h.waiting[i]) {
			// (Gone before its line ended.)
			file_close(h.waiting[i].id)
			drop_waiting(h, i)
			continue
		}
		if h.waiting[i].whole and starts_with(h.waiting[i].line, "-editor ") {
			line := line_of(&h.waiting[i])
			editor_set(ui, line[8 : line.len])
			_ = file_write_text(h.waiting[i].id, "-- end of answer --\n")
			file_close(h.waiting[i].id)
			drop_waiting(h, i)
			continue
		}
		if h.waiting[i].whole and starts_with(h.waiting[i].line, "-colors ") {
			line := line_of(&h.waiting[i])
			colors_set(ui, line[8 : line.len])
			_ = file_write_text(h.waiting[i].id, "-- end of answer --\n")
			file_close(h.waiting[i].id)
			drop_waiting(h, i)
			continue
		}
		if h.waiting[i].whole and starts_with(h.waiting[i].line, "-raise") {
			line := line_of(&h.waiting[i])
			if line.len > 7 {
				dir, name, _ := line_place(line[7 : line.len])
				hub_follow(ui, h, dir, name)
			}
			window_raise(ui)
			_ = file_write_text(h.waiting[i].id, "-- end of answer --\n")
			file_close(h.waiting[i].id)
			drop_waiting(h, i)
			continue
		}
		if h.waiting[i].whole and starts_with(h.waiting[i].line, "-docs ") {
			answer_docs(ui, &h.waiting[i])
			file_close(h.waiting[i].id)
			drop_waiting(h, i)
			continue
		}
		if h.waiting[i].whole and starts_with(h.waiting[i].line, "-reload") {
			// (`mara docs -reload`: what the Docs panel shows looked up again, as F5 does.)
			docs_reload(ui)
			answer_lines(&ui.docs[ui.docs_front], &h.waiting[i], ui.docs_query[ui.docs_front].made)
			file_close(h.waiting[i].id)
			drop_waiting(h, i)
			continue
		}
		i += 1
	}
	if not h.asking {
		for k in 0:h.waiting.len {
			if h.waiting[k].whole {
				h.asked = h.waiting[k]
				drop_waiting(h, k)
				ask_serve(ui, h)
				break
			}
		}
	}
	if h.asking do read_answer(ui, h)
}

// Client c's line read, what has arrived of it: false when its connection
// ended first.
client_read :: fun(c: ^Client) -> bool {
	chunk : [512]byte
	still_open, e := os.pipe_read(c.id, &chunk)
	if e or not still_open do return false
	text : []utf8 = chunk
	for ch in text {
		if c.line.len == c.line.cap do return false   // (no query is that long)
		&c.line ++ ch
		if ch == '\n' {
			c.whole = true
			break
		}
	}
	return true
}

// Waiting connection i taken off the list.
drop_waiting :: fun(h: ^Hub, i: i64) {
	for k in i : h.waiting.len - 1 {
		h.waiting[k] = h.waiting[k + 1]
	}
	h.waiting.len -= 1
}

// A line without its line end.
line_of :: fun(c: ^Client) -> []utf8 {
	n := c.line.len
	for n > 0 {
		if c.line[n - 1] != '\n' and c.line[n - 1] != '\r' do break
		n -= 1
	}
	return c.line[0 : n]
}

// A "-docs <words>" line answered: the words looked up, the Docs panel
// showing what's found; the connection sent it as text, its end line after.
answer_docs :: fun(ui: ^Ui, c: ^Client) {
	line := line_of(c)
	// (Its fields, between tabs: the directory, the words, then the cursor's
	// kind, name, path and line. One field alone: the words, the window's
	// own directory.)
	fields : [6!][]utf8
	n : i64 = 0
	start : i64 = 6
	for k in 6..line.len {
		ends := k == line.len
		if not ends do ends = line[k] == '\t'
		if ends {
			if n < 6 {
				fields[n] = line[start : k]
				n += 1
			}
			start = k + 1
		}
	}
	dir := line[0 : 0]
	words := fields[0]
	if n >= 2 {
		dir = fields[0]
		words = fields[1]
	}
	ex := Exact{all 0}
	if n >= 6 {
		at_line, _ := parse_number(fields[5])
		ex = Exact{kind = fields[2], name = fields[3], path = fields[4], line = i64(at_line), loose = false}
	}
	docs_search(ui, dir, words, ex, -1)
	ui.dirty = true
	// (The lines it filled: the shown ones, or while pinned, the waiting ones.)
	found := &ui.docs[ui.docs_front]
	if ui.docs_pinned do found = &ui.docs[1 - ui.docs_front]
	answer_lines(found, c, ui.search.count > 0 or ui.search.exact_shown)
}

// Lines sent as an answer: the status line, a blank one, each line shown (a
// fun's signature, its body hidden: as the panel shows it first); then the
// end line — failed when nothing was `found`.
answer_lines :: fun(found: ^Lines, c: ^Client, ok: bool) {
	out : [64 * KB]utf8
	&out ++ found.status
	&out ++ "\n\n"
	for k in 0:found.lines.len {
		if found.lines[k].hidden do continue
		text := line_text(found, k)
		if out.len + text.len + 1 > out.cap {
			if file_write_text(c.id, out) do return
			out.len = 0
		}
		&out ++ text[0 : min_int(text.len, out.cap - 1)]
		&out ++ "\n"
	}
	if not ok {
		&out ++ ANSWER_FAILED
	else
		&out ++ ANSWER_DONE
	}
	&out ++ "\n"
	_ = file_write_text(c.id, out)
}

// The asked connection's query sent to serve — started if it isn't; one
// that ended since the last, found by the write failing, started again.
// A "-show " query is shown in the Ask panel as it's answered. That and a
// "-cursor " one come from an editor: the window moves to where it is. A
// query from anywhere else, a terminal say, is answered without moving it.
ask_serve :: fun(ui: ^Ui, h: ^Hub) {
	line := line_of(&h.asked)
	h.shown = starts_with(line, "-show ")
	h.cursor = starts_with(line, "-cursor ")
	h.cursor_started = false
	h.cursor_errors = false
	query := line
	if h.shown do query = line[6 : line.len]
	if h.cursor do query = line[8 : line.len]
	dir, name, asked := line_place(query)
	if h.shown or h.cursor do hub_follow(ui, h, dir, name)
	if h.shown {
		lines_clear(&ui.asked)
		heading : [2100]utf8
		&heading ++ "mara ask "
		&heading ++ asked
		lines_add(&ui.asked, heading, STYLE_QUERY)
		lines_add(&ui.asked, "", STYLE_TEXT)
		lines_status(&ui.asked, "Asking…", STYLE_DIM)
		ui.dirty = true
	}
	h.gone = false
	h.answered = false
	h.resent = false
	h.current.len = 0
	h.sent.len = 0
	&h.sent ++ query
	&h.sent ++ '\n'
	if serve_up(h) {
		if not file_write_text(h.serve.input, h.sent) {
			h.asking = true
			return
		}
		serve_down(h)
		if serve_up(h) {
			if not file_write_text(h.serve.input, h.sent) {
				h.asking = true
				return
			}
		}
	}
	// (No serve to ask: cut off, the connection makes `mara ask` check for itself.)
	file_close(h.asked.id)
	if h.shown do lines_status(&ui.asked, "mara serve didn't start: mara ask checked for itself.", STYLE_BAD)
	ui.dirty = true
}

// What has arrived of serve's answer: passed on to the asker as it comes,
// its lines to the Ask panel when it's shown; at its end line, the
// connection closed.
read_answer :: fun(ui: ^Ui, h: ^Hub) {
	chunk : [16 * KB]byte
	still_open, e := os.pipe_read(h.serve.output, &chunk)
	if e or not still_open {
		serve_down(h)
		// (Serve ended before any of its answer — as one does when Mara was
		// rebuilt: a new one started and asked again, once.)
		if not h.answered and not h.resent {
			h.resent = true
			if serve_up(h) {
				if not file_write_text(h.serve.input, h.sent) do return
				serve_down(h)
			}
		}
		// (Serve ended answering it — maybe for it. Cut off, with no end
		// line: `mara ask` checks for itself. The next query starts serve.)
		file_close(h.asked.id)
		h.asking = false
		if h.shown do lines_status(&ui.asked, "mara serve ended answering: mara ask checked for itself.", STYLE_BAD)
		ui.dirty = true
		return
	}
	if chunk.len == 0 do return
	h.answered = true
	if not h.gone {
		piece : []byte = chunk
		_, we := file_write(h.asked.id, piece)
		if we do h.gone = true
	}
	text : []utf8 = chunk
	for ch in text {
		if ch != '\n' {
			if h.current.len < h.current.cap do &h.current ++ ch
			continue
		}
		line := trimmed(h.current)
		if starts_with(line, "-- end of answer") {
			file_close(h.asked.id)
			h.asking = false
			if h.shown {
				if line == ANSWER_FAILED {
					lines_status(&ui.asked, "Failed: what mara ask said is above.", STYLE_BAD)
				else
					lines_status(&ui.asked, "Answered.", STYLE_DIM)
				}
			}
			// (Nothing at the cursor — a blank, a comment: nothing shown. The
			// module not checking: why, kept, under its title.)
			failed := line == ANSWER_FAILED and not h.cursor_errors
			if h.cursor and (failed or not h.cursor_started) do lines_clear(&ui.at_cursor)
			ui.dirty = true
			h.current.len = 0
			return
		}
		if h.shown {
			lines_add(&ui.asked, h.current, STYLE_TEXT)
			ui.dirty = true
		}
		if h.cursor {
			if not h.cursor_started {
				lines_clear(&ui.at_cursor)
				h.cursor_started = true
				h.cursor_errors = is_diagnostic(h.current)
				if h.cursor_errors do lines_add(&ui.at_cursor, CURSOR_NOT_CHECKED, STYLE_BAD)
			}
			if h.cursor_errors {
				lines_add(&ui.at_cursor, h.current, STYLE_TEXT)
			else
				cursor_add(&ui.at_cursor, h, h.current)
			}
			ui.dirty = true
		}
		h.current.len = 0
	}
}

// Over the module's errors, at the Ask panel's top, when what's at the
// cursor can't be told: the module doesn't check (the editor may not show
// them: its diagnostics off).
CURSOR_NOT_CHECKED :: "The module doesn't check, so what's at the cursor can't be shown:"

// Whether a line is the compiler's error — `[file:line:col] Type error: …`,
// `Found 2 type error(s). Aborting.` — not an answer's.
is_diagnostic :: fun(line: []utf8) -> bool {
	if starts_with(line, "Found ") and contains(line, " error(s)") do return true
	return starts_with(line, "[") and contains(line, "] ") and contains(line, " error: ")
}

// How a line of `mara ask what at`'s answer is shown, the n-th: the first
// (the name, its path) a title, and each list's heading; where a name is
// declared, dim; the code — a signature, a line a place shows, the types along
// the path — as Mara code.
cursor_style :: fun(n: i64, line: []utf8) -> i64 {
	if n == 0 do return STYLE_TITLE
	if n > 1 and (line == "declared" or line == "operations" or starts_with(line, "written ") or starts_with(line, "read ") or starts_with(line, "pointer taken ") or starts_with(line, "maybe ")) do return STYLE_TITLE
	if starts_with(line, "  declared") or starts_with(line, "  built into") do return STYLE_DIM
	return STYLE_MARA
}

// Where a place's `<file>:<line>` ends in a line of the answer —
// `  <file>:<line>  <what it's in>`; 0 for a line that's no place.
place_end :: fun(line: []utf8) -> i64 {
	if line.len < 3 or line[0] != ' ' or line[1] != ' ' or line[2] == ' ' do return 0
	end := 2
	for end < line.len {
		if line[end] == ' ' and end + 1 < line.len and line[end + 1] == ' ' do break
		end += 1
	}
	colon := end - 1
	for colon > 2 {
		if line[colon] < '0' or line[colon] > '9' do break
		colon -= 1
	}
	if colon + 1 == end or colon < 7 or line[colon] != ':' do return 0
	if line[colon - 5 : colon] != ".mara" do return 0
	return end
}

// A line of the answer added, in its style. A place shows its file's name alone,
// and opens where it says, clicked: its folder's kept, from this window's folder
// when it's not whole.
cursor_add :: fun(l: ^Lines, h: ^Hub, line: []utf8) {
	end := place_end(line)
	if end == 0 {
		lines_add(l, line, cursor_style(l.lines.len, line))
		return
	}
	name := end
	for name > 2 {
		if line[name - 1] == '\\' or line[name - 1] == '/' do break
		name -= 1
	}
	shown : [1000]utf8
	&shown ++ "  "
	&shown ++ line[name : min_int(line.len, name + 900)]
	lines_add(l, shown, STYLE_DIM)
	link : [2000]utf8
	whole := line[2] == '/' or line[2] == '\\' or line[3] == ':'
	if not whole {
		&link ++ h.dir
		&link ++ "/"
	}
	&link ++ line[2 : min_int(end, 900)]
	lines_link(l, link)
}

// A press on what's at the cursor: a place, or the line of source under it,
// opened in the editor there.
cursor_click :: fun(ui: ^Ui, r: Rect, x: f32, y: f32) {
	l := &ui.at_cursor
	k := lines_line_at(ui, l, r, x, y)
	file, line, place := docs_place(l, k)
	if not place do file, line, place = docs_place(l, k - 1)
	if not place do return
	editor_open(ui, l, file, line)
}

// Serve running: started unless it is. False when it can't be.
serve_up :: fun(h: ^Hub) -> bool {
	if h.serving do return true
	p, e := os.process_start(h.command)
	if e do return false
	h.serve = p
	h.serving = true
	return true
}

// Serve ended — its input closed: it ends there — and waited for.
serve_down :: fun(h: ^Hub) {
	if not h.serving do return
	_, we := os.process_wait(&h.serve)
	h.serving = false
	if we do return   // (its handles closed all the same)
}
