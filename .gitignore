# Build artifacts
*.exe
*.pdb
*.obj
*.o
*.ll
*.lib
*.a
*.dll
*.so
# Bundled toolchain — vendored, not build output
!tools/*.exe
# Vendored runtime deps — shipped with the apps, not produced by the build
!**/SDL2.dll
!**/SDL3.dll
# emcc web build output
*.html
*.js
*.wasm

# Crash journal written by asserts/crash() at runtime (runtime/mara_crash.c)
crash.txt

# Per-user Claude settings
**/settings.local.json

# Claude runtime state (worktrees, plans, etc.)
.claude/

# Sublime workspace — churns on every open; project file stays tracked
Mara.sublime-workspace

# Personal scratch
Pounce/Warlock.odin

# Backup of the pre-publish history. Kept on disk locally for reference;
# never goes upstream.
.git.backup-history/

# Generated stress-test projects (regenerated from generator/, never committed)
test_*/

# Asset bundles — regenerated from the source assets in Pounce/data/
# subdirs. The bundles together are ~80MB; keep them local.
Pounce/data/*.bin

# Profile written by a -profile build at exit (runtime/mara_prof.c)
profile.txt
# mara view: where its panels were, per machine
view/layout.txt

# mara lsp crash hunt (test/lsp_fuzz.py): texts that crashed it
test/lsp_crashes/
