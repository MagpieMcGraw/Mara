# Build artifacts
*.exe
*.pdb
*.obj
*.o
*.ll
*.lib
*.lib.flags
# The names a build's generated import libraries are made of (<name>_build/kernel32.def)
**/*_build/*.def
# ... and its natvis, for Visual Studio's debugger (natvis_write)
**/*_build/mara.natvis
*.a
*.a.flags
*.dll
*.so
# Bundled toolchain — vendored, not build output
!tools/*.exe
# Vendored runtime deps — shipped with the apps, not produced by the build
!**/SDL2.dll
!**/SDL3.dll
!**/SDL3_mixer.dll
# emcc web build output
*.html
*.js
# ... but the VS Code extension's own
!editor/vscode/*.js
*.wasm

# Crash journal written by asserts/crash() at runtime (runtime/mara_crash.c)
crash.txt

# Per-user Claude settings
**/settings.local.json

# Claude runtime state (worktrees, plans, etc.)
.claude/

# Sublime workspace — churns on every open; project file stays tracked
Mara.sublime-workspace

# Personal scratch
Pounce/Warlock.odin

# Backup of the pre-publish history. Kept on disk locally for reference;
# never goes upstream.
.git.backup-history/


# Asset bundles — regenerated from the source assets in Pounce/data/
# subdirs. The bundles together are ~80MB; keep them local.
Pounce/data/*.bin

# Profiles written at exit: profile.txt by a -profile time build (runtime/mara_prof.c),
# memory.txt by a -profile memory build (runtime/mara_mem.c)
profile.txt
memory.txt
# mara view: where its panels were, per machine
view/layout.txt
view/editor.txt
view/colors.txt


# A compiler folder for other projects (sox's update_compiler.bat copies it; release.sh made it)
release/

