module slice_compare_neg

use mara.core

// MUST FAIL: a slice that isn't text has no `==` (only text's is overloaded);
// the checker says so, rather than codegen failing on it.
//@ expect-fail: cannot compare

main :: fun() {
	a : [3!]i64 = [1, 2, 3]
	x := a[0:2]
	y := a[1:3]
	if x == y do print("same")
}
