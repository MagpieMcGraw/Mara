module relotest

// Probe: does the "relocatable" bare-local-array form actually relocate the
// backing to the caller's sret, or dangle? build() returns a struct whose slice
// field views a local fixed array; clobber() then stomps the stack.

Holder :: struct { sl: []i32 }

build :: fun() -> Holder {
	verts : [4]i32
	verts[0] = 11  verts[1] = 22  verts[2] = 33  verts[3] = 44
	return Holder{verts}
}

clobber :: fun() -> i32 {
	j : [64]i32
	s : i32 = 0
	for i in 0..64 { j[i] = i32(i * 7)  s += j[i] }
	return s
}

main :: fun() {
	h := build()
	_ = clobber()
	print("relo:", h.sl[0], h.sl[1], h.sl[2], h.sl[3])   // 11 22 33 44 if relocated
}
