module spec

// =============================================================================
// THE MARA SPECIFICATION  —  spec + docs + tests, in one runnable file.
//
// This file is the single source of truth for how Mara behaves. Read it
// top-to-bottom as documentation: each section's comment is the spec prose, the
// code beneath it is a worked example, and the `assert`s verify that the prose
// is actually true. Building and running it proves the docs are accurate:
//
//     cd test && ../Mara.exe build spec && ./spec.exe
//
// Conventions:
//   - POSITIVE behavior is shown live and asserted here. If it runs green,
//     every claim made in the prose above held.
//   - Things that must NOT compile cannot live in a runnable file, so they are
//     shown as a commented example with a pointer to a runnable fixture under
//     test/failures/ — each `*_fail.mara` there is a negative test of this spec.
//   - Every section is a `fun` called from main, in reading order.
// =============================================================================

use mara.memory   // Program / Arena_Debug, and the MB constant
use mara.string

main :: fun() -> i64 {
	this_program = Program(Arena_Debug(1 * MB))

	the_three_array_shapes()
	partial_array_growth()

	print("spec verified")
	return 0
}

// -----------------------------------------------------------------------------
// THE THREE ARRAY SHAPES:  [N]T  vs  []T  vs  [..N]T
//
// Mara has three array-shaped types, and the distinction between them is
// value-vs-reference:
//
//   [N]T    Fixed array. A VALUE of exactly N inline elements. The length N is
//           part of the type; assigning or returning one copies all N elements.
//
//   []T     Slice. A REFERENCE — a {ptr, len, cap} header (each field i64, so
//           24 bytes) that views elements it does not own. `a[lo:hi]` builds a
//           slice over existing storage.
//
//   [..N]T  Partial array. Inline storage for up to N elements, fronted by a
//           slice header — the growable local buffer. It starts empty (.len 0,
//           .cap N) and you append into its capacity (see the next section).
//
// Because [N]T is a value and []T is a reference, neither implicitly stands in
// for the other: converting between them is an explicit copy. In particular you
// may NOT return a slice where a fixed array is expected —
//
//     as_arr :: fun(s: []i32) -> [4]i32 { return s }   // ERROR: []i32 vs [4]i32
//
// (runnable negative test: test/failures/test_slice_to_fixed_array_fail.mara)
// -----------------------------------------------------------------------------
the_three_array_shapes :: fun() {
	// A fixed array is N inline values; its length is part of the type.
	fixed : [4]i32 = [4]i32{10, 20, 30, 40}
	assert(fixed[0] == 10)
	assert(fixed[3] == 40)

	// A slice views existing storage. `.len` is how many elements it spans.
	view : []i32 = fixed[1:3]
	assert(view.len == 2)
	assert(view[0] == 20)   // view[0] aliases fixed[1]
	assert(view[1] == 30)
}

// -----------------------------------------------------------------------------
// PARTIAL ARRAYS:  growing a buffer with .len
//
// A fresh `[..N]T` starts with .len == 0 and .cap == N — empty, with room for
// N. You append by writing at index `.len` (the first free slot) and bumping
// `.len`. An index WRITE is bounds-checked against .cap (the physical extent),
// which is precisely why writing at `.len` is allowed: it is the append slot.
//
//     buf[buf.len] = x   buf.len += 1
//
// Range-for over a partial array (or a slice) walks the LIVE region, 0..len —
// never the capacity — so a freshly grown buffer iterates only what you put in.
// -----------------------------------------------------------------------------
partial_array_growth :: fun() {
	buf : [..4]i32
	assert(buf.len == 0)
	assert(buf.cap == 4)

	buf[buf.len] = 100   buf.len += 1
	buf[buf.len] = 200   buf.len += 1
	buf[buf.len] = 300   buf.len += 1
	assert(buf.len == 3)
	assert(buf[0] == 100)
	assert(buf[2] == 300)

	// Range-for sees the three appended elements, not all four slots.
	count : i32 = 0
	sum : i32 = 0
	for v in buf {
		count += 1
		sum += v
	}
	assert(count == 3)
	assert(sum == 600)
}
