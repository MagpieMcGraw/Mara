module broadcast_probe

// `all <expr>` (without braces) desugars to `{all <expr>}` — a broadcast
// struct literal that fills every element of an array field.

Camera :: class(w, h, fovy : f32) {
    width  := w
    height := h
}

Game :: struct {
    cameras: [..6]Camera = all Camera(640, 480, 90)
}

main :: fun() -> i64 {
    g : Game
    if g.cameras[0].width  != 640 { return 1 }
    if g.cameras[5].height != 480 { return 2 }
    return 0
}
