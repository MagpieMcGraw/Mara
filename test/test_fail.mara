module test_fail

// Negative tests — each is EXPECTED to fail. They can't all be live at once
// (a compile error would break the whole build; a runtime trap aborts the
// process), so this file ships INERT and you enable one at a time:
//
//   * Runtime-trap tests (compile fine, abort when run): uncomment its call in
//     main, rebuild, run — confirm it aborts with the noted diagnostic.
//   * Compile-error tests: uncomment the function AND its call, rebuild —
//     confirm the build fails with the noted error, then re-comment.
//
// As shipped (every negative commented/uncalled) this builds and runs clean.

use mara.memory

// ============================================================================
// runtime traps — compile OK, abort at runtime. Uncomment a call in main.
// ============================================================================

// Out-of-bounds reinterpret read: sizeof(Big)=32 > buf cap 16 -> bounds trap.
Big :: struct {
	a: i64
	b: i64
	c: i64
	d: i64
}

fail_byte_view_oob :: fun() {
	buf : [..16]byte
	p : ^Big = &buf[0]
	p.a = 1
}

// assert(false) in debug: prints "<loc> assertion failed: x<y" and exit(1).
fail_assert :: fun() {
	x : i32 = 5
	y : i32 = 3
	assert(x > y)                  // passes
	print("after passing assert")
	assert(x < y)                  // fails — aborts here
	print("should NOT reach here")
}

// ============================================================================
// compile errors — uncomment the fn AND its call to verify the diagnostic.
// ============================================================================

// Stray C-style else: `} else {`. Mara wants the else INSIDE one brace pair.
// Expected: Parse error: stray `else`.
// fail_stray_else :: fun() {
// 	x := 5
// 	if x < 10 {
// 		print("small")
// 	} else {
// 		print("big")
// 	}
// }

// Write to a `::` const string. Expected: cannot write to immutable constant.
// FAIL_GLYPHS :: " .,-~:;=!*#$@"
// fail_const_write :: fun() {
// 	FAIL_GLYPHS[0] = 'x'
// }

// `var` keyword in a type position (removed). Expected: parse/type error on `var`.
// fail_var_gone :: fun() {
// 	x : var [4]i32
// 	x[0] = 1
// }

// u8-typed index from a function. Expected: index must be i32 to match width.
// fail_reads_u8 :: fun() -> u8 { return 3 }
// fail_width_check :: fun() {
// 	arr : [6]bool
// 	arr[fail_reads_u8()] = true
// }

// Unary minus on unsigned: no representable result (binary `0 - x` traps the
// same underflow at runtime, the unary form is rejected at compile time).
// Expected: cannot negate unsigned u32 — no representable result; widen to
// signed first (e.g. -i64(x)).
// fail_returns_u32 :: fun() -> u32 { return 3 }
// fail_negate_unsigned :: fun() {
// 	u := fail_returns_u32()
// 	v := -u
// 	print(v)
// }

// Discarded non-void return (must-use). Expected: return value of
// 'fail_returns_int' is discarded — capture it (`x := ...`) or discard it
// explicitly (`_ = ...`). The `_ = fail_returns_int()` form compiles clean.
// fail_returns_int :: fun() -> i32 { return 7 }
// fail_discarded_return :: fun() {
// 	fail_returns_int()
// }

// Struct copy-with-overrides (`new := var{...}`). Expected: 'm' is a struct
// variable — copy-with-overrides is not supported. Copy first, then override
// in place. (Used to slip through as an untyped var with checking bypassed.)
// Fail_Copy_M :: struct { x, y : f32 }
// fail_struct_copy_form :: fun() {
// 	m : Fail_Copy_M = {1, 2}
// 	m2 := m{y = 99}
// 	print(m2.y)
// }

// Multi-return call in a single-argument slot. The extra values have nowhere
// to go, so codegen used to silently keep the first; now it's rejected.
// Expected: a call returning 2 values can't be used as a single argument —
// destructure it first. (`a, b := fail_mr2()` is the fix.)
// fail_mr2 :: fun() -> i64, i64 { return 3, 9 }
// fail_multi_return_as_arg :: fun() {
// 	print("both: ", fail_mr2())
// }

// A nested fn referencing an enclosing function's runtime local. Locals are
// function-private — no closures, so a lifted nested fn has no frame to reach
// into. Only ::defs cross the boundary; a local simply isn't in scope.
// Expected: undefined identifier 'secret'.
// fail_capture_local :: fun() -> i64 {
// 	secret := 42
// 	grab :: fun() -> i64 { return secret }
// 	return grab()
// }

main :: fun() -> i64 {
	this_program = Program(Arena_Debug(1 * MB))

	// Uncomment exactly ONE:
	// fail_byte_view_oob()
	// fail_assert()
	// fail_stray_else()
	// fail_const_write()
	// fail_var_gone()
	// fail_width_check()
	// fail_discarded_return()
	// fail_negate_unsigned()
	// fail_struct_copy_form()
	// fail_multi_return_as_arg()
	// fail_capture_local()

	print("test_fail: inert (all negatives disabled)")
	return 0
}
