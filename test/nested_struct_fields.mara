module nested_struct_fields

//@ expect-output: empty=7 5 1
//@ expect-output: positional=7 3
//@ expect-output: call=7 4 hi
//@ expect-output: copy=9 1

// A struct-typed field in a literal goes through the one struct store: an
// empty nested `{}` constructs the field (its defaults applied) — it used to
// be read as a null source pointer and crash.

use mara.core
use mara.math
use mara.string

Pose  :: struct { k := 7, j: i64, dir := QUAT_IDENTITY }
Outer :: struct { p: Pose, q := 5, a: [2]i64, s: str64 }

mkp :: fun(n: i64) -> Pose {
	return Pose{j = n}
}

main :: fun() {
	v := Outer{p = {}}
	print("empty=% % %", v.p.k, v.q, v.p.dir[3])

	w := Outer{{}, 3}
	print("positional=% %", w.p.k, w.q)

	c := Outer{p = mkp(4), s = "hi"}
	print("call=% % %", c.p.k, c.p.j, c.s)

	x := Pose{j = 9}
	d := Outer{p = x}
	x.j = 1
	print("copy=% %", d.p.j, x.j)
}
