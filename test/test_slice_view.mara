module test_slice_view

// byte and utf8 are both 8-bit views over the same memory; slice headers
// of either should flow into the other in both directions.

main :: fun() -> i64 {
    data : [..32]byte

    // byte buffer → utf8 view
    text : []utf8 = data[:]
    print("byte -> utf8 view len:", text.len, "cap:", text.cap)

    // utf8 view → byte view (the case that used to fail)
    bytes_back : []byte = text[:]
    print("utf8 -> byte view len:", bytes_back.len, "cap:", bytes_back.cap)

    return 0
}
