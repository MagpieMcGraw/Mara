module test_slice_positional

// slice([:n]T, &buf[off]) — positional form. Builds a fresh slice header
// in writable memory pointing at the source bytes; len = cap = n.
// Previously was a `take` codegen bug that synthesized a fake header.

run :: fun(bytes: ^[]byte) {
    view : []byte = slice([:4]byte, &bytes[0])
    print("len:", i64(view.len))
    print("cap:", i64(view.cap))
}

main :: fun() -> i64 {
    buf : [..16]byte
    run(&buf)
    return 0
}
