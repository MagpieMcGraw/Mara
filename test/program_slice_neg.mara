module program_slice_neg
//@ expect-fail: cannot slice 'this_program'

// A slice of this_program's args is a view that could write them. (A slice of
// one arg's text views the text, not this_program: that's fine.)

main :: fun() {
	rest := this_program.args[1:]
	first := this_program.args[0][1:]
	print(rest.len, first.len)
}
