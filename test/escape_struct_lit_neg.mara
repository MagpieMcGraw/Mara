module escape_struct_lit_neg

// MUST FAIL (every return): a returned slice/ptr — including a slice FIELD of a
// returned struct — may never point at this frame's memory. You pass storage
// DOWN (a ^[]T param) and return a view of it UP; you never return a view of a
// local. Every form below backs the slice with frame-local storage:
//   via_slice_of_local - explicit slice of a local array
//   via_call_decay     - a by-value fixed-array call result, decayed
//   via_param_array    - a by-value array param (a frame-local copy), decayed
//   via_decl_local     - a bare local array decl, decayed
//   via_init_local     - a `:=`-from-call local array, decayed
// The compliant pass-down form is test/escape_struct_ok.

Holder :: struct { sl: []i32 }

make_arr :: fun() -> [4]i32 {
	r : [4]i32
	r[0] = 7
	return r
}

via_slice_of_local :: fun() -> Holder {
	r : [4]i32
	return Holder{r[:]}
}

via_call_decay :: fun() -> Holder {
	return Holder{make_arr()}
}

via_param_array :: fun(arr: [4]i32) -> Holder {
	return Holder{arr}
}

via_decl_local :: fun() -> Holder {
	verts : [4]i32
	return Holder{verts}
}

via_init_local :: fun() -> Holder {
	x := make_arr()
	return Holder{x}
}

main :: fun() {
	a := via_slice_of_local()
	b := via_call_decay()
	c := via_param_array(make_arr())
	d := via_decl_local()
	e := via_init_local()
	print(a.sl[0], b.sl[0], c.sl[0], d.sl[0], e.sl[0])
}
