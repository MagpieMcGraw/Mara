module test_partial_array

// Phase 2 smoke test for [..N]T partial array declarations.
// Decl should allocate {ptr, len, cap, [N x T]} on the stack with ptr=&elements.

test_partial_array :: fun() {
	print("=== test_partial_array ===")

	// Basic decl: cap is 16, len starts at 0.
	storage : [..16]i64
	print(storage.cap)
	print(storage.len)

	// Indexing through the inline storage.
	storage[0] = 100
	storage[1] = 200
	storage[2] = 300
	print(storage[0])
	print(storage[1])
	print(storage[2])

	// Sub-slice from partial array — should produce a []i64 view.
	sl : []i64 = storage[0:3]
	print(sl.len)
	print(sl[0])
	print(sl[2])

	// Sentinel partial array: cap stays N (sentinel slot is hidden).
	// Reserve 1 extra byte beyond N; len starts at 0.
	name : [..16, 0]utf8
	print(name.cap)
	print(name.len)

	// String-literal init populates the bytes and writes the sentinel.
	greet : [..32, 0]utf8 = "hello"
	print(greet.cap)
	print(greet.len)

	// Partial-to-partial copy: the copy must have its `ptr` re-anchored to
	// its own elements. A subsequent write to the source must NOT bleed into
	// the copy. Without the ptr fixup, both reads below would return 999.
	src : [..4]i64
	src[0] = 111
	src[1] = 222
	dst : [..4]i64 = src
	src[0] = 999       // mutate source AFTER the copy
	print(dst[0])      // expect 111 — copy unaffected
	print(dst[1])      // expect 222

	print("=== test_partial_array passed ===")
}
