module program_write_neg
//@ expect-fail: cannot write into 'this_program'

// this_program is read only: set at the top of main, then only read. A fun
// changing its args would hand the change to every fun that reads them.

drop_first :: fun() {
	this_program.args = this_program.args
}

main :: fun() {
	drop_first()
	print(this_program.args.len)
}
