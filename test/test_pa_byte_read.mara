module test_pa_byte_read

// arr : [..N]T = bytes[lo:hi] reinterprets the byte slice as an array of T.
// - source.len / sizeof(T) elements are read into the partial array's backing.
// - len is auto-incremented by that count (starts at 0 for a fresh decl).
// - cap stays at the compile-time N.
// - Runtime traps on `source.len % sizeof(T) != 0` or count > N.

Entry :: struct {
    a: i32
    b: i32  // sizeof(Entry) = 8 bytes
}

run :: fun(bytes: ^[]byte) {
    // 16 bytes / 8 bytes per Entry = 2 elements. Cap stays at the declared 8.
    dst : [..8]Entry = bytes[0 : 16]
    print("len:", i64(dst.len))   // expect 2
    print("cap:", i64(dst.cap))   // expect 8
}

main :: fun() -> i64 {
    buf : [..64]byte
    buf.len = 32
    run(&buf)
    return 0
}
