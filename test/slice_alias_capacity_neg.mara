module slice_alias_capacity_neg
//@ expect-fail: a slice has no storage of its own, so a type can't carry a count

// A slice type holds no storage of its own, so a type alias can't carry a
// count: n of T are taken from memory, `slice([:n]T, &memory)`.

use mara.core

Name :: distinct [:128]utf8

main :: fun() {
	n : Name
	print(n.len)
}
