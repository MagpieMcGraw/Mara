module list_literal_items_neg

//@ expect-fail: takes no items: an empty list is written `[]`, every item one value `{all v}`, and a list of items `[a, b, …]`

// A `{…}` with items, typed by a list it goes into: braces into a list only
// fill it (`{all v}`); items are `[1, 2]`, and an empty list `[]`.

use mara.core

main :: fun() {
	xs : [4]i64 = {1, 2}
	print(xs.len)
}
