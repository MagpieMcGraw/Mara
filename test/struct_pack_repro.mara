module struct_pack_repro

use mara.memory

// Repro for the TTF Head-table read bug. A packed binary record with an i64
// after a 20-byte prefix — the exact shape of TTF's `head` (created/modified
// are i64 at file offset 20). Mara aligns the i64 to 8 bytes, inserting 4
// bytes of padding after the 20-byte prefix, so every field past it is read
// from a shifted offset. The packed file has no such padding, so a
// `#big_endian` whole-struct read misreads `marker` (and, in head,
// index_to_loc_format). There is no #packed attribute to opt out of the
// alignment.
//
// Expected: marker = 0xBEEF (48879). Bug: reads 0 (from offset 32, not 28).
Rec :: struct {
	a : u32   // packed 0
	b : u32   // packed 4
	c : u32   // packed 8
	d : u32   // packed 12
	e : u16   // packed 16
	f : u16   // packed 18   (20-byte prefix, like head up to units_per_em)
	stamp : i64   // packed 20; Mara aligns to 24 (+4 pad)
	marker : u16  // packed 28; Mara reads it at 32
}

main :: fun() -> i64 {
	this_program = Program(Arena_Debug(1 * MB))
	buf : [..64]byte
	buf.len = 64
	buf[28] = u8(0xBE)   // marker, big-endian, at PACKED offset 28
	buf[29] = u8(0xEF)

	r : Rec = #big_endian buf[0]
	print("marker: expect 48879 (0xBEEF), got", i32(r.marker))
	return 0
}
