module bug1

// Bug 1: returning a partial array (str64) by value. Now lowered via sret with
// NRVO — the callee builds straight into the caller's slot — instead of the old
// by-value `ret {agg} %allocaPtr` that clang rejected.

use mara.core

// NRVO: `out` is the single returned local -> built directly in %sret.
build :: fun() -> str64 {
    out : str64
    &out + 'h'
    &out + 'i'
    return out
}

// Non-NRVO: returns a parameter, so the return copies it into %sret.
passthrough :: fun(p: str64) -> str64 {
    return p
}

// Chained NRVO: `inner` is built by a call and then returned, so build()'s sret
// is forwarded straight to wrap()'s sret (0 copies through the chain).
wrap :: fun() -> str64 {
    inner := build()
    return inner
}

main :: fun() {
    s := build()
    print(s)              // hi

    w := wrap()
    print(w)              // hi

    base : str64
    &base + 'y'
    &base + 'o'
    p := passthrough(base)
    print(p)              // yo
}
