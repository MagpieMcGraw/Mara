module slice_copy_store_neg

//@ expect-fail: `lexer.tokens` is a copy of the immutable param `tokens_in`

// An immutable param stored into a struct by the fun it's given to stays
// read-only there: lexer.tokens, set by init from its param, can't be
// appended to, as it couldn't be through tokens_in itself.

use mara.core

Lexer :: struct {
	tokens: []i64
	pos: i64
}

init :: fun(lexer: ^Lexer, tokens_in: []i64) {
	lexer.tokens = tokens_in
	lexer.pos = 0
}

main :: fun() {
	list : [8]i64
	lexer : Lexer
	init(&lexer, list)
	&lexer.tokens + 7
	print(list.len)
}
