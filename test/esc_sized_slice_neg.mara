module esc_sized_slice_neg
//@ expect-fail: cannot return local reference

// A slice of a local array views memory that dies with it (the scope
// allocator resets when make_it returns): the second call would reuse it,
// and `t[0]` read back 9.

use mara.memory

#allocator Arena_Debug(1 * MB)

make_it :: fun(n: i64) -> []i64 {
	room : [16!]i64
	s := room[0:n]
	s[0] = 7
	return s[0:4]
}

main :: fun() {
	t := make_it(4)
	u := make_it(4)
	u[0] = 9
	print(t[0])
}
