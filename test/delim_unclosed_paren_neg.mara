module delim_unclosed_paren_neg
//@ expect-fail: [delim_unclosed_paren_neg.mara:12:7] Parse error: this `(` is never closed: its `)` is missing. The `}` at 14:1 comes first

// A `(` never closed is said at the `(`, not where the parser gives up —
// here the file's end, two lines on — and once: what the parser makes of the
// lines after it isn't said.

use mara.core

main :: () {
	x := 5
	print("x is", x
	print("after")
}
