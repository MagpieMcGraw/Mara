module test_take_return_fail

// Should fail: returning a take-bound name. The view's lifetime is the function;
// even though the source memory belongs to the caller, the binding can't escape.

Pair :: struct {
    a: i64
    b: i64
}

run :: fun(memory: ^[:]byte) -> Pair {
    p : Pair = take(Pair, memory)
    return p
}

test_take_return_fail :: fun() {
}
