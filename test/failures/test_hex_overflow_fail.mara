module test_hex_overflow_fail

// Hex literals up to u64 max (`0xFFFFFFFFFFFFFFFF`, 16 hex digits) now parse
// — see `test/u64_literal` for the positive case. Only literals beyond u64
// width (more than 16 significant hex digits) still fail at parse time.

main :: fun() -> i64 {
    c := 0x1_0000000000000000  // 2^64, 17 significant hex digits
    return 0
}
