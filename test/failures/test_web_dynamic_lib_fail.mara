module test_web_dynamic_lib_fail

// Should fail under `-web`: dynamic_lib has no analog on emscripten
// (no LoadLibrary / GetProcAddress). Run with:
//   ../mara.exe test_web_dynamic_lib_fail.mara -web
// Without `-web` this is a perfectly valid native binding.

foreign dynamic_lib "SomeLib" prefix Foo_ {
	fun Init() -> bool
}

main :: fun() -> i64 {
	return 0
}
