module test_escape_via_call_fail

// Should fail: a stack-allocated buffer in `outer` is passed (as `&storage`)
// to `leaf`, which returns a slice that views it. `outer` returns that slice,
// so it would dangle past outer's frame.
//
// The provenance analysis walks leaf's body — leaf returns
// `take([:3]i64, storage)` whose provenance follows parameter 0 — and
// inherits that arg's provenance at outer's call site. `&storage` resolves
// to .Stack, so outer's return is rejected.

leaf :: fun(storage: ^[]byte) -> []i64 {
	return take([:3]i64, storage)
}

outer :: fun() -> []i64 {
	storage : [..512]byte
	return leaf(&storage)
}

test_escape_via_call_fail :: fun() {
	sl := outer()
	print(sl[0])
}
