module test_param_parallel_defaults

// Multi-name with parallel per-name defaults: `a, b: i64 = 5, 10`.
// Verifies the unified declaration parser distributes each value to its
// corresponding name (not broadcast).

pair_sum :: fun(a, b: i64 = 5, 10) -> i64 {
    return a + b
}

// Broadcast still works: one value to many names.
pair_sum_broadcast :: fun(a, b: i64 = 7) -> i64 {
    return a + b
}

test_param_parallel_defaults :: fun() {
    print("=== test_param_parallel_defaults ===")
    print(pair_sum())              // expect 15  (5 + 10)
    print(pair_sum(100, 200))      // expect 300
    print(pair_sum_broadcast())    // expect 14  (7 + 7)
    print("=== test_param_parallel_defaults passed ===")
}
