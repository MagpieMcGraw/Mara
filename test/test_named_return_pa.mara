module test_named_return_pa

// Reproduces the loca bug: a struct with a partial-array field, produced via a
// named struct return. The named return's %sret is caller-zero-filled, so the
// [..N] header used to come up cap=0 (setting .len then trapped). Zero-init
// should now stamp cap=N.

Loca :: struct {
    offsets : [..8]u32
}

make_loca :: fun(n: i32) -> loca: Loca {
    loca.offsets.len = n          // trapped here before: "len n not in [0, 0]"
    for i in 0..n {
        loca.offsets[i] = u32(i * 10)
    }
    return loca
}

main :: fun() -> i64 {
    l : Loca = make_loca(5)
    print("named return -> len:", l.offsets.len, "cap:", l.offsets.cap)
    for v, i in l.offsets {
        print("  ", i, ":", i32(v))
    }

    // Bare struct local with a partial-array field — sibling case, just read
    // its cap to see whether plain zero-init also stamps it.
    b : Loca
    print("bare local   -> cap:", b.offsets.cap)
    return 0
}
