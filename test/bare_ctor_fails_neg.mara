module bare_ctor_fails_neg

//@ expect-fail: 't : T' runs T's constructor, which can fail: write `t := T()?`, or `= void` to leave it unset

// A bare declaration runs its type's constructor: one that can fail would
// have nothing to take its err, so it's an error saying what to write.

Bad :: error {
	Neg
}

T :: struct(x: i32 = 0) -> err {
	v: i32
	if x < 0 do return Neg
}

main :: fun() {
	t : T
	print(t.v)
}
