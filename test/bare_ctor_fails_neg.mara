module bare_ctor_fails_neg

//@ expect-fail: 't' of type 'T' can't be built bare

// A bare declaration runs the constructor on its defaults; one that can fail
// has nothing to take its err.

Bad :: error {
	Neg
}

T :: struct(x: i32 = 0) -> err {
	v: i32
	if x < 0 do return Neg
}

main :: fun() {
	t : T
	print(t.v)
}
