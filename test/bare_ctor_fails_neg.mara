module bare_ctor_fails_neg

//@ expect-fail: field 'v' of 't' is used before being assigned a value

// A bare declaration doesn't run the constructor — one that can fail would
// have nothing to take its err: its fields are unset until written, and read
// before, an error.

Bad :: error {
	Neg
}

T :: struct(x: i32 = 0) -> err {
	v: i32
	if x < 0 do return Neg
}

main :: fun() {
	t : T
	print(t.v)
}
