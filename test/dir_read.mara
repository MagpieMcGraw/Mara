module dir_read

use mara.core
use mara.os
include mara.memory

// dir_read: a directory's names, each a file or a directory. The stdlib's
// directory, beside test/ — its os.mara a file, its SDL a directory, no "."
// or ".." among them; too many for a one-entry list (Too_Large); and a
// directory that isn't there (Open_Failed).

//@ expect-output: os.mara: file
//@ expect-output: SDL: directory
//@ expect-output: dots: 0
//@ expect-output: one entry: File_Error.Too_Large
//@ expect-output: missing: File_Error.Open_Failed

main :: fun() -> i64 {
	this_program = Program(Arena_Basic(4 * MB))
	entries : [..500]Dir_Entry
	e := dir_read("../code", &entries)
	if bool(e) {
		print("../code:", e)
		return 1
	}
	dots := 0
	for entry in entries {
		name : []utf8 = entry.name[:]
		if name == "." or name == ".." do dots += 1
		if name == "os.mara" or name == "SDL" {
			kind := "file"
			if entry.dir do kind = "directory"
			print("%: %", name, kind)
		}
	}
	print("dots:", dots)

	one : [..1]Dir_Entry
	print("one entry:", dir_read("../code", &one))
	print("missing:", dir_read("../no_such_directory", &entries))
	return 0
}
