module dir_read

use mara.core
use mara.os
use mara.memory

#allocator Arena_Basic(4 * MB)

// dir_read: a directory's names, each a file or a directory, into storage
// after what's there. The stdlib's directory, beside test/ — its os.mara a
// file, its SDL a directory, no "." or ".." among them; a storage too small
// for them (Too_Large, storage untouched); a directory that isn't there
// (Open_Failed); two listings in one storage, side by side.

//@ expect-output: os.mara: file
//@ expect-output: SDL: directory
//@ expect-output: dots: 0
//@ expect-output: moved past them: true
//@ expect-output: small room: File_Error.Too_Large 0 0
//@ expect-output: missing: File_Error.Open_Failed 0
//@ expect-output: twice: true true

main :: fun() -> i64 {
	storage : [200 * KB]byte
	entries, e := dir_read("../code", &storage)
	if bool(e) {
		print("../code:", e)
		return 1
	}
	dots := 0
	for entry in entries {
		name : []utf8 = entry.name[:]
		if name == "." or name == ".." do dots += 1
		if name == "os.mara" or name == "SDL" {
			kind := "file"
			if entry.dir do kind = "directory"
			print("%: %", name, kind)
		}
	}
	print("dots:", dots)
	print("moved past them:", storage.len >= entries.len * size_of(Dir_Entry))

	small : [300]byte
	none, se := dir_read("../code", &small)
	print("small room:", se, none.len, small.len)
	gone, me := dir_read("../no_such_directory", &storage)
	print("missing:", me, gone.len)

	before := storage.len
	again, _ := dir_read("../code", &storage)
	print("twice:", again.len == entries.len, storage.len > before)
	return 0
}
