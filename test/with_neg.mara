module with_neg
//@ expect-fail: `with` takes the arena's address: `with &lib`

// `with` takes a pointer to an arena: given the arena, it says to take its
// address.

use mara.core
use mara.memory

#allocator Arena_Basic(16 * MB)

main :: () {
	lib := Arena_Basic(1 * MB)
	with lib do print("x")
}
