module inferconflict
//@ expect-fail: inferred binding 'n' is used at conflicting widths: i32

// `n := 5` used where an i32 goes, then where an i16 goes: one binding, one
// width — and no widening to reconcile two. A conflict, whichever use comes
// first; annotate it, or cast at a use.

take_i32 :: fun(x: i32) {}
take_i16 :: fun(x: i16) {}

main :: fun() {
	n := 5
	take_i32(n)
	take_i16(n)
}
