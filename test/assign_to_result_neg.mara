module assign_to_result_neg

//@ expect-fail: can't assign to what a call gives back: it's a value, gone after the line

// Assigning to a call's result, a value: the pointer it gives is written
// through with `^` — `next(&list)^ = …`.

use mara.core

main :: fun() {
	views : [4][]byte
	data : []byte
	next(&views) = data
	print(views.len)
}
