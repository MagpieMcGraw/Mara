module disttest

// A distinct struct prints under its own name: DPoint, not Point.
//@ expect-output: distinct var:   DPoint { x: 1, y: 2 }
//@ expect-output: distinct field: Holder { p: DPoint { x: 1, y: 2 } }
//@ expect-output: distinct call:  DPoint { x: 1, y: 2 }

Point :: struct {
	x : i64 = 1
	y : i64 = 2
}

DPoint :: distinct Point

make_dp :: fun() -> DPoint {
	r := DPoint(Point())
	return r
}

Holder :: struct {
	p := DPoint(Point())
}

main :: fun() {
	dp := DPoint(Point())
	print("distinct var:  ", dp)
	h := Holder()
	print("distinct field:", h)
	print("distinct call: ", make_dp())
}
