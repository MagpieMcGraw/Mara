module slice_loop_view

//@ expect-output: 4 10
//@ expect-output: 3 60

// A collection loop walks its collection as it is when the loop begins: the
// header's pointer and len are read once, so a body that shrinks the slice or
// points it elsewhere doesn't change what the loop visits. Elements are read
// live, as the loop reaches them.

main :: fun() {
	a : [4]i64 = [1, 2, 3, 4]
	b : [3]i64 = [10, 20, 30]
	s := a[0:4]
	n : i64 = 0
	t : i64 = 0
	for x in s {
		n += 1
		t += x
		s.len = 1
	}
	print(n, t)

	s = b[0:3]
	n = 0
	t = 0
	for x, i in s {
		n += 1
		t += x
		if i == 0 { s = a[0:2] }
	}
	print(n, t)
}
