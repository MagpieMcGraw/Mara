module for_ref

use mara.core

//@ expect-output: bumped: 2 3 4
//@ expect-output: doubled: 2 4 6 8
//@ expect-output: with index: 10 21 32
//@ expect-output: through a pointer: 5 5 5
//@ expect-output: a fixed array: 7 7 7
//@ expect-output: part of a list: 1 0 0 4

// `for &item in xs`: item points at each item where it is, so writing
// through it writes the collection — a field (`item.x += 1`), the whole item
// (`item^ = v`).

Point :: struct {
	x: i64
	y: i64
}

set_all :: fun(xs: ^[]i64, v: i64) {
	for &x in xs { x^ = v }
}

main :: fun() {
	pts : [4]Point
	&pts + Point{1, 0}
	&pts + Point{2, 0}
	&pts + Point{3, 0}
	for &p in pts { p.x += 1 }
	print("bumped:", pts[0].x, pts[1].x, pts[2].x)

	nums : [8]i64
	&nums + 1
	&nums + 2
	&nums + 3
	&nums + 4
	for &n in nums { n^ = n^ * 2 }
	print("doubled:", nums[0], nums[1], nums[2], nums[3])

	vals : [4]i64
	&vals + 10
	&vals + 20
	&vals + 30
	for &v, i in vals { v^ += i }
	print("with index:", vals[0], vals[1], vals[2])

	three : [4]i64
	&three + 1
	&three + 2
	&three + 3
	set_all(&three, 5)
	print("through a pointer:", three[0], three[1], three[2])

	fixed : [3!]i64 = {1, 2, 3}
	for &f in fixed { f^ = 7 }
	print("a fixed array:", fixed[0], fixed[1], fixed[2])

	four : [4]i64
	&four + 1
	&four + 2
	&four + 3
	&four + 4
	for &x in four[1:3] { x^ = 0 }
	print("part of a list:", four[0], four[1], four[2], four[3])
}
