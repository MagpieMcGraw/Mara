module test_byte_view_oob

use mara.memory

// Big enough to be larger than the buffer slack, so the bounds check fires.
Big :: struct {
    a: i64
    b: i64
    c: i64
    d: i64
}

main :: fun() -> i64 {
    this_program = Program(Arena_Basic)
    buf : [..16]byte
    // sizeof(Big) is 32 bytes, capacity is 16: offset 0 + 32 > 16 → trap.
    p : ^Big = &buf[0]
    p.a = 1
    return 0
}
