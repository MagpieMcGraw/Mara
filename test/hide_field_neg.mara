module hide_field_neg
//@ expect-fail: 'fast' here is both the variable declared at

// What a struct's top block declares is its constructor's variable, named
// by the rules any variable is: it may have a variant's name in sight, and
// `h.fast` means the field, but `fast` by itself in the body means both
// (as a fun's, a type's, a module's: hide_fun_neg, variant_name_neg).

use mara.core

Holder :: struct {
	fast: i64 = 4
	twice := fast * 2
}
Mode :: union { fast  slow }

main :: fun() {
	h := Holder()
	print(h.fast)
}
