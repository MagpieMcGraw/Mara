module all_name_ok

use mara.core

//@ expect-output: broadcast: 4 7 7
//@ expect-output: literal: 2 2

// `all` broadcasts, in a declaration and in a literal. (Nothing can be named
// all: all_name_neg, all_local_neg, all_field_neg.)

main :: fun() {
	nums : [4]i64 = all 7
	print("broadcast:", nums.len, nums[0], nums[3])
	three : [3!]i64 = {all 2}
	print("literal:", three[0], three[2])
}
