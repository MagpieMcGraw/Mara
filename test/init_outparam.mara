module init_outparam

//@ expect-output: init_outparam 17

// Handing a variable's address to a call is an out-parameter: the callee may
// assign through it, so a pointer in it that's void only because it was
// zeroed (declared bare) counts as written afterwards. (An address kept in a
// local, `hp := &h`, isn't one: what's void under it is void wherever it's
// read — init_alias_neg.)

Holder :: struct { p: ^i64, sl: []i64 }

init :: fun(h: ^Holder, target: ^i64) { h.p = target }
set_ptr :: fun(pp: ^^i64, target: ^i64) { pp^ = target }
set_slice :: fun(s: ^[]i64, src: []i64) { s^ = src }

main :: fun() {
	y : i64 = 5
	buf : [4!]i64
	buf[1] = 7

	h : Holder
	init(&h, &y)                 // &h: the whole struct
	a := h.p^

	h2 : Holder
	set_slice(&h2.sl, buf[:])    // &h2.sl: just that field
	b := h2.sl[1]

	p : ^i64
	set_ptr(&p, &y)              // a pointer variable, assigned through ^^
	c := p^

	print("init_outparam", a + b + c)   // 17
}
