module widen_test

use mara.memory

// Regression: integer widening must extend by the SOURCE's signedness.
// Unsigned source zero-extends (even into a signed target); signed source
// sign-extends. (Doubles as an assert smoke test.)
main :: fun() -> i64 {
	this_program = Program(Arena_Debug(1 * MB))

	a : u16 = 0xCAFE            // 51966, high bit set
	assert(i32(a) == 51966)    // u16 -> i32 must zero-extend, not -13570
	assert(i64(a) == 51966)

	b : i16 = -1               // 0xFFFF
	assert(i32(b) == -1)       // i16 -> i32 sign-extends
	assert(i64(b) == -1)

	print("widen ok")
	return 0
}
