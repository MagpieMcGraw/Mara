module byte_fill_bounds

// A partial array filled from bytes, `pa : [N]T = bytes[off]`, is an
// array's worth of memory from off: N elements' bytes, clipped at the
// source's cap — as many whole elements as fit there, its len their count.
// A span `bytes[lo:hi]` is those bytes (hi within the cap); to the
// source's len, `bytes[lo:.len]` — only the bytes it holds (open,
// `bytes[lo:]`, it runs to the cap, as an open slice does). (It once never checked: a [4096]u16 filled from a
// 16-byte buffer copied 8 KB past it. Then it trapped when the source ran
// short: mara.font's crash on small fonts.) Past the cap: byte_fill_past_cap.

//@ expect-output: whole: 4 9
//@ expect-output: clipped at the cap: 3
//@ expect-output: at the cap: 0
//@ expect-output: to the len: 2 9
//@ expect-output: a span past the len: 6

main :: fun() {
	bytes : [16]byte
	bytes.len = 4
	bytes[1] = u8(9)
	whole : [4]u16 = #big_endian bytes[0]   // (8 bytes: past the len, within the cap)
	print("whole:", whole.len, whole[0])
	clipped : [8]u16 = bytes[9]             // (7 bytes left: 3 whole u16)
	print("clipped at the cap:", clipped.len)
	none : [8]u16 = bytes[16]
	print("at the cap:", none.len)
	held : [8]u16 = #big_endian bytes[0:.len]   // (the 4 bytes it holds)
	print("to the len:", held.len, held[0])
	span : [8]u16 = bytes[0:12]
	print("a span past the len:", span.len)
}
