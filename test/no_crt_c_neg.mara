module no_crt_c_neg
//@ build-flags: -no crt
//@ expect-fail: no C library

// `-no crt` and C source that calls the C library (printf): there is none to
// link, and the build says so with the linker's own word for what's missing.

use mara.core

foreign static_lib "libc_user" {
	fun libc_user(x: i32) -> i32
}

main :: fun() {
	print(libc_user(3))
}
