module arrayctor

use mara.core

//@ expect-output: local PA      (0 0): 0 0
//@ expect-output: local fixed   (7 7): 7 7
//@ expect-output: element name  (ok): ok
//@ expect-output: field fixed   (7 7): 7 7
//@ expect-output: str64 elem    (hi): hi

// A bare fixed array of structs builds each item with its constructor, as
// `= all Inner()` does; a bare list starts empty, its room zero. Each
// element's partial arrays are stamped all the same: they take appends.

Inner  :: struct { x : i32 = 7,  name : str64 }
Holder :: struct { items : [3]Inner,  fixed : [2!]Inner = all Inner() }

main :: fun() {
    arr : [3]Inner
    print("local PA      (0 0):", arr[0].x, arr[2].x)

    farr : [3!]Inner
    print("local fixed   (7 7):", farr[0].x, farr[1].x)
    &farr[1].name ++ "ok"
    print("element name  (ok):", farr[1].name)

    h := Holder()
    print("field fixed   (7 7):", h.fixed[0].x, h.fixed[1].x)

    names : [3!]str64
    &names[0] ++ "hi"
    print("str64 elem    (hi):", names[0])
}
