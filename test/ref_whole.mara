module ref_whole

use mara.core

//@ expect-output: call: 2 8 2 9
//@ expect-output: whole: 3 9 3

// A whole slice written through a ^[]T to a slice: a call's result, a whole
// array's view — the slice repointed, and the reference with it (its header
// built where the slice is, never over the reference).

give :: (s: []i64) -> []i64 { return s[1:] }

main :: () {
	three : [3!]i64 = [7, 8, 9]
	s : []i64 = three[0:1]
	p : ^[]i64 = &s
	p^ = give(three[:])
	print("call:", s.len, s[0], p.len, p[1])
	p^ = three[:]
	print("whole:", s.len, s[2], p.cap)
}
