module infer_open_decisions

use mara.math
include mara.memory

// A decision that needs a binding's width — which member of a dispatch
// group, a generic's type, how many bytes a byte write takes — takes the
// width its uses have given it so far. None yet: its default from there on
// (a byte write: the untyped error), and a use at another width, before or
// after in the code, is a conflict (infer_dispatch_pin_neg,
// infer_generic_pin_neg, infer_byte_write_neg). A dispatch matches exactly:
// one member of the binding's kind fits: chosen, its param the binding's
// width; more: the one its width fits, else its default width's. (Before
// 1169eaa: a single member was chosen but didn't count — `n` stayed an i64
// into an i32 param, stopping codegen; several were "ambiguous"; a generic
// took i64 regardless.)

//@ expect-output: one member: 32 4
//@ expect-output: two, no use gives one: 64 8
//@ expect-output: two, given one before: 32 4
//@ expect-output: min, no use gives one: 0 8
//@ expect-output: generic, given one before: 10 2
//@ expect-output: byte write, given one before: 10 0

show_i32 :: fun(x: i32) -> i64 { return 32 }
show_i64 :: fun(x: i64) -> i64 { return 64 }
show_str :: fun(x: []utf8) -> i64 { return 0 }
show2 :: dispatch{ show_i32, show_i64 }
show1 :: dispatch{ show_i32, show_str }

t16 :: fun(x: i16) {}
t32 :: fun(x: i32) {}
ident :: fun(x: $T) -> T { return x }

main :: fun() {
	this_program = Program(Arena_Basic(1 * MB))
	a := 0
	print("one member:", show1(a), size_of(a))
	c := 0
	print("two, no use gives one:", show2(c), size_of(c))
	d := 0
	t32(d)
	print("two, given one before:", show2(d), size_of(d))
	f := 0
	print("min, no use gives one:", min(f, 3), size_of(f))

	h := 10
	t16(h)
	w := ident(h)
	print("generic, given one before:", w, size_of(w))

	m := 10
	t16(m)
	buf : [..16]byte
	buf[0] = m
	print("byte write, given one before:", buf[0], buf[1])
}
