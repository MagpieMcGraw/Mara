module for_call_neg

use mara.core

//@ expect-fail: a loop over a call takes one bool from it each round

// A loop over a call whose results end in no bool: an error, not a loop
// that guesses when to stop.

Nothing :: error { Done }

next :: fun(n: ^i64) -> i64, err {
	if n^ >= 3 do return 0, Done
	n^ += 1
	return n^
}

main :: () {
	n : i64 = 0
	for v in next(&n) {
		print(v)
	}
}
