module test_union_pad

// Verifies typed-pad union layout and .pad accessor.
// SDL3-shaped: u32 tag, u32 pad, u64 first-payload-field starting at offset 8.

Padded :: union(tag u32, pad u32, size 32) {
    A = 1 {
        timestamp: u64
        x: i32
    }
    B = 2 {
        timestamp: u64
        y: i32
    }
}

test_union_pad :: fun() {
    e: Padded = A{timestamp = 99, x = 7}
    print(e.tag)        // 1
    print(e.pad)        // 0 (we never wrote it)
    match e {
    A a
        print(a.timestamp)   // 99
        print(a.x)           // 7
    B b
        print(b.timestamp)
        print(b.y)
    }
}
