module struct_param_field_neg

use mara.core

// MUST FAIL: a struct's param is no field of it (it isn't laid out): `p.w`
// names nothing. (Params shared the fields' map, so `p.w` was typed as the
// field at w's place among the params — `h` — and codegen then failed.)
//@ expect-fail: has no field 'w'

P :: struct(w: i64) {
	h := w * 3
}

main :: fun() {
	p := P(5)
	print(p.w)
}
