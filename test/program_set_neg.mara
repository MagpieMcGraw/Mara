module program_set_neg
//@ expect-fail: is set only at the top of main

// The program's arena is chosen at the top of main's body; written anywhere
// else, the setting would do nothing.

include mara.memory

use_debug :: fun() {
	this_program = Program(Arena_Debug(1 * MB))
}

main :: fun() {
	this_program = Program(Arena_Basic(1 * MB))
	use_debug()
}
