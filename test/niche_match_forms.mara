module niche_match_forms

//@ expect-output: dot 0 1
//@ expect-output: named -1 5
//@ expect-output: else 9 5
//@ expect-output: tag true true
//@ expect-output: sizes 16 16

// A union of a fieldless variant and one holding a single pointer matches
// like any other: `.None` dot arms, named arms with a binding, `else`, and
// `.tag`. (It was once stored as the pointer alone, null for None; pointers
// have their own null, `void`, so it's a tagged union like any other.)

use mara.maybe

Tagged :: union(tag u32) {
	Empty
	Ref { p: ^i64 }
}

dot :: fun(m: Maybe(^i64)) -> i64 {
	match m {
	.None  return 0
	.Some  return 1
	}
}

named :: fun(m: Maybe(^i64)) -> i64 {
	match m {
	None    return -1
	Some s  return s.value^
	}
}

with_else :: fun(m: Maybe(^i64)) -> i64 {
	match m {
	Some s  return s.value^
	else    return 9
	}
}

main :: fun() {
	x := 5
	a : Maybe(^i64) = .None
	b : Maybe(^i64) = Some{value = &x}
	print("dot", dot(a), dot(b))
	print("named", named(a), named(b))
	print("else", with_else(a), with_else(b))
	print("tag", a.tag == 0, b.tag == 1)
	print("sizes", size_of(Maybe(^i64)), size_of(Tagged))
}
