module pafill

// Partial array as a fill buffer (the font-glyph pattern). &buf is ^[..N]T,
// which flows into a ^[]T param because a partial array carries a slice
// header. A fresh [..N]T has len 0, but indexing is cap-bounded, so the
// callee can write buf[i] up to cap and then set len to mark it full.

fill :: fun(buf: ^[]i32) {
	buf.len = buf.cap
	for i in 0..i32(buf.len) {
		buf[i] = i * 10
	}
}

main :: fun() {
	data : [..8]i32        // len 0, cap 8
	fill(&data)
	print("C:", data.len, data[0], data[7])   // 8 0 70
}
