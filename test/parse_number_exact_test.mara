module parse_number_exact_test

use mara.core
use mara.memory
use mara.string
use mara.math

//@ expect-output: table: 20 right of 20
//@ expect-output: half the smallest: 0 is a tie going to even, 1 past it is the smallest: true true
//@ expect-output: past 768 digits: true true
//@ expect-output: signs and forms: true true true true true
//@ expect-output: not numbers: false false false

// parse_number is the nearest f64 however many digits there are. The bits here are Python's
// float(), which is correctly rounded: the largest f64 and just past it, the smallest and
// half of it, the edge of the subnormals, integers that fall between two doubles, and
// 1e23, the classic one a simple scaling gets wrong. It was compared with Python on 155,742
// cases when it was written, with no differences.

#allocator Arena_Basic(1 * MB)

CASES :: [20!][]utf8{
	"0.1",
	"0.3",
	"1.7976931348623157e308",
	"1.7976931348623158e308",
	"1.797693134862315807e308",
	"1.797693134862315808e308",
	"4.94065645841246544e-324",
	"2.4703282292062327e-324",
	"2.4703282292062328e-324",
	"2.2250738585072014e-308",
	"2.2250738585072011e-308",
	"1e23",
	"8.41e21",
	"9007199254740993",
	"9007199254740995",
	"123456789012345678",
	"6.2460699999999995e-8",
	"1e400",
	"1e-400",
	"0.",
}

BITS :: [20!]u64{
	4591870180066957722,
	4599075939470750515,
	9218868437227405311,
	9218868437227405311,
	9218868437227405311,
	9218868437227405312,
	1,
	0,
	1,
	4503599627370496,
	4503599627370495,
	4950912855330343670,
	4934958393344299186,
	4845873199050653696,
	4845873199050653698,
	4862596447618666293,
	4499311825174580224,
	9218868437227405312,
	0,
	0,
}

main :: fun() {
	right := 0
	for k in 0:CASES.len {
		v, ok := parse_number(CASES[k])
		if ok and f64_bits(v) == BITS[k] {
			right += 1
		else
			print("wrong:", CASES[k], v)
		}
	}
	print("table:", right, "right of", CASES.len)

	half : [1200]utf8
	&half ++ "0."
	tie, _ := parse_number(half)
	&half ++ "1"
	over, _ := parse_number(half)
	print("half the smallest: 0 is a tie going to even, 1 past it is the smallest:", f64_bits(tie) == 0, f64_bits(over) == 1)

	// (9007199254740993 lies exactly between two doubles, so it goes to the even one, and
	// any nonzero digit however far along tips it up. A kept digit and one past 768.)
	long : [1000]utf8
	&long ++ "9007199254740993."
	for k in 0:800 do &long ++ '0'
	even, _ := parse_number(long)
	&long ++ "1"
	up, _ := parse_number(long)
	print("past 768 digits:", f64_bits(even) == 4845873199050653696, f64_bits(up) == 4845873199050653697)

	a, ok_a := parse_number("-1.5e3")
	b, ok_b := parse_number(".5")
	c, ok_c := parse_number("3.")
	d, ok_d := parse_number("00012.5")
	e, ok_e := parse_number("-0")
	print("signs and forms:", ok_a and a == -1500, ok_b and b == 0.5, ok_c and c == 3, ok_d and d == 12.5, ok_e and f64_bits(e) == 9223372036854775808)

	_, bad_1 := parse_number("")
	_, bad_2 := parse_number("1e")
	_, bad_3 := parse_number("12abc")
	print("not numbers:", bad_1, bad_2, bad_3)
}
