module executable_path

use mara.core
use mara.os
use mara.memory

// executable_path: the program's own file — its path whole (a drive's or
// the root's at its start), its own name in it — whatever this_program.args[0]
// says (run.sh starts it by a relative path). Into storage after what's
// there; the path opens with file_open_read as it is. A room too small:
// Too_Large, storage untouched.

//@ expect-output: has its own name: true
//@ expect-output: whole: true
//@ expect-output: in storage: true
//@ expect-output: opens: true
//@ expect-output: too small: File_Error.Too_Large 0

main :: fun() -> i64 {
	this_program = Program(Arena_Basic(4 * MB))
	storage : [..1000]byte
	path, e := executable_path(&storage)
	if bool(e) {
		print("executable_path:", e)
		return 1
	}
	print("has its own name:", has(path, "executable_path"))
	whole := path.len > 2 and (path[0] == '/' or path[1] == ':')
	print("whole:", whole)
	print("in storage:", storage.len == path.len)
	id, oe := file_open_read(path)
	print("opens:", not bool(oe))
	file_close(id)
	small : [..4]byte
	_, se := executable_path(&small)
	print("too small:", se, small.len)
	return 0
}

// Whether text has `part` in it.
has :: fun(text: []utf8, part: []utf8) -> bool {
	if text.len < part.len do return false
	for k in 0 .. text.len - part.len + 1 {
		if text[k : k + part.len] == part do return true
	}
	return false
}
