module test_named_returns

// Named multi-return: the names in the signature ARE pre-declared locals.
named_pair :: fun() -> a: i64, b: i64 {
	a = 10
	b = 20
	return a, b
}

// Positional multi-return (no parens): also valid; locals declared in body.
positional_pair :: fun() -> i64, i64 {
	x : i64 = 100
	y : i64 = 200
	return x, y
}

test_named_returns :: fun() {
	print("=== test_named_returns ===")
	n1, n2 := named_pair()
	print(n1)
	print(n2)
	p1, p2 := positional_pair()
	print(p1)
	print(p2)
	print("=== test_named_returns passed ===")
}
