module foreign_names_free

use mara.core
use mara.os

//@ expect-output: locals: 1 2 3 4 b.txt

// A local may take a C function's name, though it may not a Mara fun's — `open`
// on Linux, where mara.os declares libc's open, failed to build ("a variable
// can't take the name of a fun") while Windows built it.

main :: fun() {
	open := 1
	read := 2
	GetLastError := 3
	CloseHandle := 4
	print("locals:", open, read, GetLastError, CloseHandle, get_file("a/b.txt"))
}
