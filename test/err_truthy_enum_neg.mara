module err_truthy_enum_neg

//@ expect-fail: an enum is one when a variant is written `= 0`, the false one, and Color has none

// An enum is a condition only when one of its variants is written `= 0`,
// the false one (truthy_enum). Red is 0 here too, but no variant says so:
// compare it instead, `c == .Red`.

Color :: union { Red  Green }

main :: fun() {
	c := Color.Green
	if c do print("green")
}
