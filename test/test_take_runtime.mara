module test_take_runtime

// take([:n]T, storage) — runtime-counted slice form.
// Advances storage.len by n*sizeof(T), returns []T with len=cap=n;
// the data pointer aliases the carved range of storage.

Pair :: struct {
    a: i64
    b: i64
}

fill :: fun(pairs: ^[]Pair, base: i64) {
    for i in 0..pairs.len {
        // Mix whole-struct assign and field-assign so the chain handles both.
        pairs[i].a = base + i64(i) * 10
        pairs[i].b = base + i64(i) * 10 + 1
    }
}

run :: fun(storage: ^[]byte, n: i64) {
    print("=== test_take_runtime ===")

    // Literal count: compiler folds the 2, runtime path still kicks in.
    fixed : []Pair = take([:2]Pair, storage)
    fill(&fixed, 100)

    // Runtime count from a parameter.
    runtime : []Pair = take([:n]Pair, storage)
    fill(&runtime, 500)

    print(fixed.len)        // 2
    print(fixed.cap)        // 2
    print(fixed[0].a)       // 100
    print(fixed[1].b)       // 111

    print(runtime.len)      // n (3)
    print(runtime[0].a)     // 500
    print(runtime[2].b)     // 521

    // Cursor advanced by 2*16 + n*16 = 32 + n*16. With n=3 → 80.
    print(storage.len)      // 80 (auto-deref through ^[]byte)

    print("=== test_take_runtime passed ===")
}

test_take_runtime :: fun() {
    storage : [..1024]byte
    run(&storage, 3)
}
