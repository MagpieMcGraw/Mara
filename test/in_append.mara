module in_append

//@ expect-output: true false false true

// `in` takes a `++` on its right as `==` does: `1 in a ++ 1` looks among
// a's items and one more (it was `(1 in a) ++ 1`).

use mara.core

main :: () {
	a : [4]i64
	&a ++ 2
	b : [4]i64
	&b ++ 2 ++ 1
	print(1 in a ++ 1, 3 in a ++ 1, 2 not in a ++ 1, a ++ 1 == b)
}
