module mixwiden

// Arithmetic on two widths takes a cast to one (no implicit mixing — it was,
// until the user dropped widening): written, it keeps out of C's "unsigned
// wins" swamp the same way — -1 cast to i64 stays -1 beside a u32 cast to
// i64. (Unwritten: mixwiden_neg.)

//@ expect-output: over by 904
//@ expect-output: a+b: 1000100
//@ expect-output: neg<u: true
//@ expect-output: neg+u: 4
//@ expect-output: x+y: 1200

main :: fun() {
	size : i64 = 5000
	cap  : i32 = 4096
	if size > i64(cap) do print("over by", size - i64(cap))

	a : i32 = 100
	b : i64 = 1000000
	print("a+b:", i64(a) + b)

	neg : i32 = -1
	u   : u32 = 5
	print("neg<u:", i64(neg) < i64(u))
	print("neg+u:", i64(neg) + i64(u))

	x : u8  = 200
	y : u16 = 1000
	print("x+y:", u16(x) + y)
}
