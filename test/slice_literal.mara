module slice_literal

use mara.core

//@ expect-output: i32s: 17
//@ expect-output: u8s: 250
//@ expect-output: floats: 2.5
//@ expect-output: i16s: 700
//@ expect-output: default: 5
//@ expect-output: appended: 1 3 3
//@ expect-output: taken at a computed offset: 77 88 2

// An array literal sliced, `[1, 2, 3][:]`: an array held as itself, its
// elements the width the slice's use gives (else their default) — and a
// take at an offset worked out by a call or arithmetic.

take32 :: (s: []i32) -> i32 { return s[1] + s[2] }
take8 :: (s: []u8) -> u8 { return s[2] }
pick :: (n: i64) -> i64 { return n }

main :: () {
	print("i32s:", take32([7, 8, 9][:]))
	print("u8s:", take8([1, 2, 250][:]))
	f := [1.5, 2.5][:]
	print("floats:", f[1])
	g : []i16 = [300, 400][:]
	print("i16s:", g[0] + g[1])
	s := [4, 5, 6][:]
	print("default:", s[1])

	storage : [64]byte
	views := slice([:1][]i64, &storage)
	&views + [1, 2, 3][:]
	print("appended:", views.len, views[0].len, views[0][2])

	bytes : [32]byte
	bytes.len = 32
	bytes[8:16] = 77
	bytes[16:24] = 88
	n := 8
	a := let(i64, &bytes[pick(8)])
	b := let(i64, &bytes[n + 8])
	two := slice([:2]i64, &bytes[pick(0)])
	print("taken at a computed offset:", a, b, two.cap)
}
