module from_text_not_assigned_neg
//@ expect-fail: Mode.from_text writes only where it's assigned, and only when the text names a variant

// `E.from_text(s)` writes its target only when s names a variant: as a value
// of its own — an argument, a comparison — it would have nothing to be when
// none does.

use mara.core

Mode :: union { build  run }

show :: fun(m: Mode) { print(m) }

main :: fun() {
	show(Mode.from_text("run"))
}
