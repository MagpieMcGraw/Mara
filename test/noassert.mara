module noassert

use mara.core

//@ build-flags: -no assert
//@ expect-output: calls 0
//@ expect-output: v 5

// `-no assert` compiles asserts out: a failing one doesn't stop the program,
// and its condition isn't evaluated — the call in it never runs. An err read
// only by an assert is still read (the must-use-err check sees the same code
// as without the flag).

Oops :: error { Bad }

might_fail :: fun(x: i64) -> i64, err {
	if x < 0 { return 0, Bad }
	return x
}

bump :: fun(calls: ^i64) -> i64 {
	calls^ += 1
	return calls^
}

main :: fun() {
	calls : i64 = 0
	assert(bump(&calls) == 99)
	assert(calls == 1)
	print("calls", calls)
	v, e := might_fail(5)
	assert(e == .Ok)
	print("v", v)
}
