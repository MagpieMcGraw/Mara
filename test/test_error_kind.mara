module test_error_kind

File_Error :: error {
    Not_Found
    Too_Large
    Read_Failed
}

Shader_Error :: error {
    Bad_Text
    Failed_Compilation
    Failed_Link
}

main :: fun() -> i64 {
    // Variants are u32 (set_id<<16 | tag); Ok is the universal zero.
    a := File_Error.Not_Found
    b := File_Error.Read_Failed
    c := Shader_Error.Failed_Compilation
    ok := File_Error.Ok

    print(a)
    print(b)
    print(c)
    print(ok)

    print(File_Error.Too_Large)
    print(Shader_Error.Bad_Text)

    // Encoding sanity: File_Error has set_id=1, Shader_Error has set_id=2.
    // .Not_Found is tag 1 -> 0x10001 = 65537
    // Shader_Error.Failed_Compilation is tag 2 -> 0x20002 = 131074
    print(i64(a))
    print(i64(c))
    print(i64(ok))

    // Comparison via concrete error_kind type
    if a == File_Error.Not_Found do print("matched Not_Found")
    if a != File_Error.Read_Failed do print("a is not Read_Failed")

    // Match arms on concrete error_kind
    match a {
        File_Error.Not_Found   do print("match: not found")
        File_Error.Too_Large   do print("match: too large")
        File_Error.Read_Failed do print("match: read failed")
        File_Error.Ok          do print("match: ok")
    }
    return 0
}
