module append_chain

use mara.core
use mara.memory

//@ expect-output: chained: C:/code/a.mara 14
//@ expect-output: next: 2 C:/code/b.mara x/y
//@ expect-output: struct: 1 3 0
//@ expect-output: items: 3 1 2 3
//@ expect-output: through a pointer: 2 dir/one dir/two
//@ expect-output: as it is: 1 ab

// An add gives its list back, so adds chain: `&name + dir + "/" + file`.
// `next(&list)` makes a list one longer and gives that item, to write into
// where it is — `next(&files) + dir + "/" + name`, nothing copied — as it
// is (as an add's dst is): empty in a list only grown, what it held in one
// shrunk and filled again.

Name :: [..500]utf8
Pair :: struct { a: i64  b: i64 }

// A list's next name, from its parts, through the list's pointer.
add_name :: fun(names: ^[]Name, dir: []utf8, file: []utf8) {
	next(names) + dir + "/" + file
}

main :: fun() {
	this_program = Program(Arena_Basic(4 * MB))
	name : str64
	&name + "C:/code" + "/" + "a.mara"
	print("chained:", name, name.len)

	files : [..10]Name
	next(&files) + "C:/code" + "/" + "b.mara"
	next(&files) + "x" + '/' + "y"
	print("next:", files.len, files[0], files[1])

	pairs : [..4]Pair
	p := next(&pairs)
	p.a = 3
	print("struct:", pairs.len, pairs[0].a, pairs[0].b)

	nums : [..8]i64
	&nums + 1 + 2 + 3
	print("items:", nums.len, nums[0], nums[1], nums[2])

	names : [..4]Name
	add_name(&names, "dir", "one")
	add_name(&names, "dir", "two")
	print("through a pointer:", names.len, names[0], names[1])

	again : [..4]str64
	next(&again) + "a"
	again.len = 0
	next(&again) + "b"
	print("as it is:", again.len, again[0])
}
