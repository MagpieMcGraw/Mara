module shapes

use mara.core

// (mara edit's <fun>.calls, test/edit_test.py: emit's body written out
// where it can be its call — and where `here` is stale, not.)

Lexer :: struct {
	pos:  i64
	text: [16]utf8
}

Tok :: struct {
	at, len, kind : i64
}

emit :: fun(l: ^Lexer, len: i64, kind: i64) -> bool, Tok {
	here := l.pos
	l.pos += len
	return true, Tok{here, len, kind}
}

look :: fun(l: ^Lexer) -> utf8 {
	if l.pos >= l.text.len do return 0
	return l.text[l.pos]
}

skip :: fun(l: ^Lexer) {
	l.pos += 1
}

next :: fun(l: ^Lexer) -> bool, Tok {
	here := l.pos
	c := look(l)
	if c == '+' {
		l.pos += 1
		return true, Tok{here, 1, 1}
	}
	if c == '-' {
		skip(l)
		l.pos += 1
		return true, Tok{here, 2, 2}
	}
	if c == '*' {
		start := l.pos
		l.pos += 1
		return true, Tok{start, 1, 3}
	}
	return false, Tok{0}
}

// (mara edit's <fun>.do: the first chain written with do; a branch of two
// statements, a comment, one written with do already, left.)
kind_of :: fun(c: utf8) -> i64 {
	if c == '+' {
		return 1
	elif c == '-'
		return 2
	}
	if c == '*' {
		x := 3
		return x
	}
	if c == '/' {
		// (kept)
		return 4
	}
	if c == '%' do return 5
	return 0
}

// (mara edit's <fun>.elif: the first three ifs one chain — each before the
// last leaving — the blank line kept; the fourth after one that falls
// through, left.)
sign :: fun(n: i64) -> i64 {
	if n < 0 {
		return -1
	}

	if n == 0 {
		return 0
	}
	if n > 100 {
		print("big")
	}
	if n > 50 {
		return 2
	}
	return 1
}

// (mara edit's <fun>.elif: a braced if then a chain written with do, one
// braced chain — its `}` after the do lines.)
classify :: fun(c: utf8) -> i64 {
	if c == 'a' {
		x := 1
		return x
	}
	if c == 'b' do return 2
	elif c == 'c' do return 3
	else do return 4
}

// (mara edit's <fun>.do: a braced chain's one-statement branches after its
// first, each with do inside the braces.)
grade :: fun(n: i64) -> i64 {
	if n > 90 {
		print("top")
		return 1
	elif n > 50
		return 2
	else
		return 3
	}
}

main :: () {
	l := Lexer{pos = 0, text = "+-x*"}
	print(sign(-5), sign(0), sign(500), sign(70), sign(3))
	print(classify('a'), classify('b'), classify('c'), classify('z'), grade(95), grade(60), grade(10))
	for t in next(&l) {
		print(t.at, t.len, t.kind, kind_of(l.text[t.at]))
	}
}
