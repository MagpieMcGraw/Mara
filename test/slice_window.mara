module slice_window

//@ expect-output: inside the len: 4 4 [3, 4, 5, 6]
//@ expect-output: past the len: 4 4 [8, 0, 0, 0]
//@ expect-output: items: 8 8 - the rest: 6 6
//@ expect-output: given as a slice: 8 16
//@ expect-output: of a fixed array: 4 [2, 2, 2, 2]
//@ expect-output: of a slice: 2 [4, 5]

// A slicing shows its window: `xs[a:b]` is b - a items, whatever xs's len.
// With no hi, `xs[:]` and `xs[lo:]` of a list end at its len: its items. A
// list given where a slice goes is a view of its items, its room behind them.

use mara.core

counts :: fun(xs: []i64) -> i64, i64 {
	return xs.len, xs.cap
}

main :: fun() {
	xs : [16]i64
	for k in 1..8 do &xs + k

	v := xs[2:6]
	print("inside the len:", v.len, v.cap, v)

	w := xs[7:11]
	print("past the len:", w.len, w.cap, w)

	items := xs[:]
	rest := xs[2:]
	print("items:", items.len, items.cap, "- the rest:", rest.len, rest.cap)

	n, room := counts(xs)
	print("given as a slice:", n, room)

	buf : [8!]i64
	for k in 0:8 do buf[k] = 2
	f := buf[2:6]
	print("of a fixed array:", f.len, f)

	s := v[1:3]
	print("of a slice:", s.len, s)
}
