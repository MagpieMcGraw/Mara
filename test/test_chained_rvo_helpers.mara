module test_chained_rvo_helpers

Pair :: struct {
	x: i64
	y: i64
}

// --- Pure chain (no modification) ----------------------------------------

level_c :: fun() -> Pair {
	p : Pair
	p.x = 10
	p.y = 20
	return p
}

level_b :: fun() -> Pair {
	return level_c()
}

level_a :: fun() -> Pair {
	return level_b()
}

// --- Modify-each-level chain ---------------------------------------------

mod_c :: fun() -> Pair {
	p : Pair
	p.x = 100
	p.y = 200
	return p
}

mod_b :: fun() -> Pair {
	p := mod_c()
	p.x += 1
	return p
}

mod_a :: fun() -> Pair {
	p := mod_b()
	p.y *= 2
	return p
}

// --- Slice variants -------------------------------------------------------

sl_c :: fun(storage: ^[]byte) -> []i64 {
	out := take([:3]i64, storage)
	out[0] = 100
	out[1] = 200
	out[2] = 300
	return out
}

sl_b :: fun(storage: ^[]byte) -> []i64 {
	return sl_c(storage)
}

sl_a :: fun(storage: ^[]byte) -> []i64 {
	return sl_b(storage)
}

sl_mod_c :: fun(storage: ^[]byte) -> []i64 {
	out := take([:3]i64, storage)
	out[0] = 1
	out[1] = 2
	out[2] = 3
	return out
}

sl_mod_b :: fun(storage: ^[]byte) -> []i64 {
	s := sl_mod_c(storage)
	s[0] += 10
	return s
}

sl_mod_a :: fun(storage: ^[]byte) -> []i64 {
	s := sl_mod_b(storage)
	s[2] *= 100
	return s
}

// --- Fixed-array variants -------------------------------------------------

arr_c :: fun() -> [3]i64 {
	r : [3]i64
	r[0] = 1
	r[1] = 2
	r[2] = 3
	return r
}

arr_b :: fun() -> [3]i64 {
	return arr_c()
}

arr_a :: fun() -> [3]i64 {
	return arr_b()
}

arr_mod_c :: fun() -> [3]i64 {
	r : [3]i64
	r[0] = 10
	r[1] = 20
	r[2] = 30
	return r
}

arr_mod_b :: fun() -> [3]i64 {
	a := arr_mod_c()
	a[0] += 1
	return a
}

arr_mod_a :: fun() -> [3]i64 {
	a := arr_mod_b()
	a[2] *= 2
	return a
}
