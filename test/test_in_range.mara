module test_in_range

// `x in a..b` and `x not in a..b` — half-open range membership.
// Parser desugars to (x >= a) and (x < b), so iteration count
// (b - a) matches "number of values that satisfy `in`".

check :: fun(label: [:, 0]utf8, x: i64, lo: i64, hi: i64) {
    if x in lo..hi {
        print(label, "in")
    else
        print(label, "out")
    }
}

check_not :: fun(label: [:, 0]utf8, x: i64, lo: i64, hi: i64) {
    if x not in lo..hi {
        print(label, "out")
    else
        print(label, "in")
    }
}

test_in_range :: fun() {
    print("=== test_in_range ===")

    // Boundaries: half-open [0, 10) — 0 is in, 10 is not.
    check("0", 0, 0, 10)            // in
    check("9", 9, 0, 10)            // in
    check("10", 10, 0, 10)          // out (hi exclusive)
    check("neg1", -1, 0, 10)        // out (below lo)
    check("5", 5, 0, 10)            // in

    // `not in` is the inverse.
    check_not("0_n", 0, 0, 10)      // in
    check_not("10_n", 10, 0, 10)    // out
    check_not("99_n", 99, 0, 10)    // out

    // Edge: empty range. 0..0 has no values, so nothing is in it.
    check("empty_lo", 0, 5, 5)      // out
    check("empty_hi", 5, 5, 5)      // out

    print("=== test_in_range passed ===")
}
