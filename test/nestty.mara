module nestty

// Nested type referenced in TYPE position (params, decls) via Parent.Inner.
// use_inner sits BELOW Box; mirror_inner in front of it exercises the
// forward-reference order too.

mirror_inner :: fun(p: ^Box.Inner) -> i64 {
	return p.a
}

Box :: struct (v: i64) {
	Inner :: struct {
		a : i64
	}
	// Scope consts work in sibling field array sizes regardless of position
	// in the body (consts pre-register before field resolution).
	pool : [..CAP]i64
	CAP :: 1 << 4
	x := v
}

use_inner :: fun(p: ^Box.Inner) -> i64 {
	return p.a
}

main :: fun() {
	i : Box.Inner
	i.a = 7
	assert(use_inner(&i) == 7)
	assert(mirror_inner(&i) == 7)

	b := Box(3)
	assert(b.pool.cap == 16)
	assert(b.x == 3)
	print("nestty ok")
}
