module slice_param_header_neg
//@ expect-fail: `s` is a slice: its len is its size

// A slice param's header is the caller's (passed by address): writing it
// shortened the caller's slice. A slice's len is its size: never written;
// reslice it, or take a list (`^[$N]T`) to move a len.

trim :: fun(s: []i64) { s.len = 1 }

main :: fun() {
	a : [3!]i64 = [1, 2, 3]
	s : []i64 = a[:]
	trim(s)
	print(s.len)
}
