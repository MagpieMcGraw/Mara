module for_ref_escape_neg

use mara.core

//@ expect-fail: cannot return local reference

// A reference loop's item points into the collection: kept past it (a
// local list's, given back), it would point at memory freed.

first :: fun() -> ^i64 {
	nums : [4]i64
	&nums + 1
	keep : ^i64
	for &n in nums { keep = n }
	return keep
}

main :: fun() {
	p := first()
	print(p^)
}
