module field_ref_literal_neg

use mara.core

//@ expect-fail: cannot assign infer_int to variable 'r' of type S.f32

// A number isn't a field reference.

Inner :: struct { x: f32 }
Other :: struct { y: f32 }
Key :: union { None = 0  A = 1 }
S :: struct {
	inner: Inner
	p: ^Inner
	list: [4]i64
	items: []i64
	fixed: [4!]i64
}

main :: fun() {
	r : S.f32 = 8
	print(r)
}
