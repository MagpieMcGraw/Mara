module ck_core_decls

//@ expect-output: -1 5 3 -3 true false
//@ expect-output: 2.5 7 1

// Typed declarations of numbers, variables, parens, `-`, arithmetic and
// comparisons — the lean checker core's (ck.odin): a literal beside a
// typed operand, on either side, takes that operand's width (`-4 + p` once
// left the -4 open, and lowering couldn't build its `+`).

f :: fun(p: i64, q: u8, r: f64) -> i64 {
	a : i64 = -4 + p
	b : i64 = p + -1 + 3
	c : u8 = 1 + q
	d : i64 = (p - 6) * 1
	e : bool = 2 < p
	g : bool = q == 9 and -1 > p
	h : f64 = -0.5 + r
	i : u8 = 7 - 0
	j : i64 = p / 3
	print(a, b, c, d, e, g)
	print(h, i, j)
	return a
}

main :: fun() {
	_ = f(3, 2, 3.0)
}
