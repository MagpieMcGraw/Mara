module slice_compare

use mara.core

//@ expect-output: views: false true true
//@ expect-output: lists: true false true
//@ expect-output: arrays: true false
//@ expect-output: bytes: true
//@ expect-output: text: true false true true

// `==` and `!=` on lists and slices compare their items, whatever they are
// (mara.core's slice_equal): text is one case of it. Two that hold different
// numbers of items differ.

K :: union { A B }

main :: () {
	a : [3!]i64 = [1, 2, 3]
	x := a[0:2]
	y := a[1:3]
	print("views:", x == y, x == a[0:2], x != y)

	p : [4]i64
	q : [4]i64
	&p ++ 1 ++ 2
	&q ++ 1 ++ 2
	same := p == q
	&q ++ 3
	print("lists:", same, p == q, p != q)

	b : [3!]i64 = [1, 2, 4]
	print("arrays:", a == a, a == b)

	m : [4]byte
	n : [4]byte
	&m ++ u8(7)
	&n ++ u8(7)
	print("bytes:", m == n)

	name : [16]utf8
	&name ++ "B"
	k : K = B
	print("text:", name == "B", name == "b", k.text() == name, "B" == k.text())
}
