module void_ptr_legal

//@ expect-output: reassigned 7 null-compare false c-null ok
//@ expect-output: set void: true

// A pointer's `void` is its null, a value: written to a variable, compared
// against, handed to a C function for a nullable parameter.

use mara.core
use mara.os

main :: fun() {
	x := 7
	p := &x
	p = void
	p = &x
	print("reassigned", p^, "null-compare", p == void, "c-null", "ok")
	base := vm_reserve(4096)         // vm_reserve passes VirtualAlloc/mmap a void address
	_ = base
	q := &x
	q = void
	print("set void:", q == void)
}
