module field_ref_from_number_neg

use mara.core

//@ expect-fail: can't make a field reference

// Only a struct's type and a path make a field reference, never a number.

Inner :: struct { x: f32 }
Other :: struct { y: f32 }
Key :: union { None = 0  A = 1 }
S :: struct {
	inner: Inner
	p: ^Inner
	list: [4]i64
	items: []i64
	fixed: [4!]i64
}

R :: alias S.f32
main :: fun() {
	r := R(3)
	print(r)
}
