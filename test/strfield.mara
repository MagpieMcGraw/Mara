module strfield

// Regression for TWO fixes:
//  1. infer_field_type_from_default: an UNANNOTATED literal struct-field
//     default infers a real type (string -> quantized [..64]utf8,
//     char -> utf8), not Type_Any -> i64.
//  2. constructor codegen: a partial-array / string FIELD default is actually
//     copied into the field (len + bytes), instead of allocating a
//     dead local and leaving the field's len uninitialised. This affected the
//     annotated form too, so both are checked here.

use mara.string

Inferred :: struct {
	greet := "hello"   // unannotated -> quantized [..64]utf8
	sep   := '/'       // unannotated -> utf8
	n     := 7
}

Annotated :: struct {
	greet : [..128]utf8 = "hello"
}

main :: fun() {
	i := Inferred()
	assert(i.greet.cap == 64)    // quantized tier for "hello", not i64
	assert(i.greet.len == 5)     // default actually copied in
	assert(i.greet[0] == 'h')
	assert(i.greet[4] == 'o')
	assert(i.sep == '/')         // utf8 field default, not i64
	assert(i.n == 7)

	a := Annotated()
	assert(a.greet.len == 5)     // annotated form copies in too
	assert(a.greet[0] == 'h')

	print("strfield ok")
}
