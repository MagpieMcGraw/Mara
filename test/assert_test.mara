module assert_test

use mara.memory

main :: fun() -> i64 {
	this_program = Program(Arena_Debug(1 * MB))
	x : i32 = 5
	y : i32 = 3

	assert(x > y)                  // passes — silent
	print("after passing assert")

	assert(x < y)                  // fails — prints location + "x<y", exits
	print("should NOT reach here")
	return 0
}
