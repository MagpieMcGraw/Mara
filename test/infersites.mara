module infersites

// Each binding below is open and flows into exactly ONE kind of concrete
// context. If that site doesn't pin the width, the binding defaults to i64 and
// the i32 use mismatches (LLVM type error at build, or a wrong value at run).

Box :: struct { v: i32 }

ret_open :: fun() -> i32 {
	n := 7          // open → returned where i32 is expected
	return n
}

// A function's untyped default param defers like a `:=` local: it adopts the
// width it's used at in the body. `seed` flows through `doubled` into a u32
// return, so the whole chain — param, local, return — settles at u32.
param_from_use :: fun(seed := 4) -> u32 {
	doubled := seed * 2
	return doubled
}

// No width-bearing local in the way — the param is pinned by the return type.
param_from_return :: fun(base := 10) -> i16 {
	return base
}

main :: fun() {
	assert(ret_open() == 7)        // return site

	k := 9
	bx := Box{ k }                 // struct field-init site
	assert(bx.v == 9)

	m := 11
	j : i32 = m                    // annotated-decl site
	assert(j == 11)

	p := 3
	bx.v = p                       // field-assign site
	assert(bx.v == 3)

	assert(param_from_use() == 8)      // default seed=4 → u32 8
	assert(param_from_use(5) == 10)    // override → u32 10
	assert(param_from_return() == 10)  // default, inferred i16
	assert(param_from_return(-3) == -3)

	// An open binding flowing through ARITHMETIC into an annotated context pins
	// to that width too — not only direct use. (coerce_infer_to_hint must record
	// the adopted width on the cell, else the binding stays i64 and disagrees.)
	w := 6
	narrowed : i16 = w + 1
	assert(narrowed == 7)

	print("sites ok")
}
