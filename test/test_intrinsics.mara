module test_intrinsics

use mara.math

test_intrinsics :: fun() {
	// sqrt via dispatch (f32)
	a : f32 = 16.0
	ra := sqrt(a)
	print(ra)  // 4.0

	// sqrt via dispatch (f64)
	b : f64 = 25.0
	rb := sqrt(b)
	print(rb)  // 5.0

	// abs_f32
	c : f32 = -3.5
	rc := abs_f32(c)
	print(rc)  // 3.5

	// min/max f32
	print(min(f32(2.0), f32(5.0)))  // 2.0
	print(max(f32(2.0), f32(5.0)))  // 5.0

	// min/max i64
	print(min(10, 3))  // 3
	print(max(10, 3))  // 10

	// min/max f64
	print(min(f64(1.5), f64(2.5)))  // 1.5
	print(max(f64(1.5), f64(2.5)))  // 2.5
}
