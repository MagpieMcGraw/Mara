module tuple_union

//@ expect-output: a=one 4 1
//@ expect-output: b=two 8 2
//@ expect-output: v=1 3 3

// A union in a multi-return slot: the return side stored the union's ADDRESS
// as its value (no union case — invalid IR), and the destructure bound it as a
// scalar, so `match` read the union loaded as a value where it expects an
// address. A distinct-array literal with a runtime slot took the same scalar
// fallback and became an LLVM constant holding an SSA value.

Pick :: union(tag u8) { One = 1 { n: i64 } Two = 2 { m: i64 } }
Vec3 :: distinct [3]f32

pk :: fun(k: i64) -> (Pick, i64) {
	if k == 1 { return One{n = 4}, 1 }
	p : Pick = Two{m = 8}
	return p, 2
}
v3 :: fun(x: f32) -> (Vec3, i64) { return Vec3{x, 2, 3}, 3 }

say :: fun(label: []utf8, p: Pick, i: i64) {
	match p {
	One o
		print("%=one % %", label, o.n, i)
	Two t
		print("%=two % %", label, t.m, i)
	}
}

main :: fun() {
	a, i := pk(1)
	b, j := pk(2)
	say("a", a, i)
	say("b", b, j)
	v, k := v3(1)
	print("v=% % %", v[0], v[2], k)
}
