module test_hex_literals

// Smoke test for hex literal parsing.

test_hex_literals :: fun() {
	// Basic hex
	a := 0xFF
	print(a)            // 255

	// Mixed case hex digits
	b := 0xDeAdBeEf
	print(b)            // 3735928559

	// Underscore separators
	c := 0xFF_FF_00_00
	print(c)            // 4294901760

	// Negative hex (Minus + Number folds at parse time)
	d := -0x10
	print(d)            // -16

	// 0x as upper-case prefix
	e := 0X80
	print(e)            // 128

	// In const expression
	f := 0x80000000 | 0x40000000
	print(f)            // 3221225472

	// Precision: values above 2^53 must round-trip exactly. The old
	// f64-only literal storage rounded these to the nearest representable
	// double, losing the low bit. With i64 storage these stay exact.
	above53 := 0x20_0000_0000_0001     // 2^53 + 1 = 9007199254740993
	at53    := 0x20_0000_0000_0000     // 2^53     = 9007199254740992
	print(above53 - at53)               // must print 1, not 0

	hi_dec : i64 = 9007199254740993    // same value via decimal — also exact
	print(hi_dec - at53)                // 1
}
