module gl_binding

use mara.core
gl :: use mara.open_gl

//@ expect-output: units: 33984 34015
//@ expect-output: params: 33085 34046 34049 32882
//@ expect-output: filters: 9985 9986 33648
//@ expect-output: limits: 34930 34047
//@ expect-output: buffers: 37074 35345
//@ expect-output: numbered: GL_Tex_Param.TEXTURE_MAX_LEVEL GL_Texture_Unit.TEXTURE5
//@ expect-output: framebuffers: 36160 36064 36096 36053 36161
//@ expect-output: depth: 33190 36012 6402 35056 34042
//@ expect-output: hdr: 34842 35898 5131
//@ expect-output: cube: 34067 34069 34074 12288
//@ expect-output: names: Clear

// mara.open_gl's values, as GL numbers them, and its functions linked: a
// call to each is built (not run — that needs a GL context) so a name
// missing from opengl32 or open_gl.c stops the build. Its C funs are its
// file's (foreign_private_neg): these are the Mara funs that call them,
// taking data as slices (`[]`: none) and text as Mara text.

uses :: fun() {
	gl.ActiveTexture(gl.TEXTURE31)
	gl.TexParameteri(gl.TEXTURE_2D_ARRAY, gl.TEXTURE_MAX_LEVEL, 4)
	gl.TexParameterf(gl.TEXTURE_2D, gl.TEXTURE_MAX_ANISOTROPY, 16.0)
	units : i32 = 0
	gl.GetIntegerv(gl.MAX_TEXTURE_IMAGE_UNITS, &units)
	most : f32 = 0
	gl.GetFloatv(gl.MAX_TEXTURE_MAX_ANISOTROPY, &most)
	gl.BindBufferBase(gl.SHADER_STORAGE_BUFFER, 0, 1)
	// (Offsets into the bound buffers, in bytes: a draw group's own.)
	gl.DrawElements(gl.TRIANGLES, 6, gl.UNSIGNED_INT, 24)
	gl.MultiDrawElementsIndirect(gl.TRIANGLES, gl.UNSIGNED_INT, 3 * 20, 2, 0)
	gl.TexStorage2D(gl.TEXTURE_2D, 1, u32(gl.RGBA8), 4, 4)
	gl.TexStorage3D(gl.TEXTURE_2D_ARRAY, 3, u32(gl.RGBA_S3TC_DXT5), 64, 64, 16)
	block : [16!]byte
	gl.CompressedTexSubImage3D(gl.TEXTURE_2D_ARRAY, 0, 0, 0, 0, 4, 4, 1, gl.RGBA_S3TC_DXT5, block)
	gl.CompressedTexImage3D(gl.TEXTURE_2D_ARRAY, 0, gl.RGBA_S3TC_DXT5, 4, 4, 1, 0, block)
	// (Buffers: room only, `[]`; data, a slice of any items; text, Mara's.)
	verts : [6!]f32 = [0, 0, 1, 0, 0, 1]
	gl.BufferData(gl.ARRAY_BUFFER, 1024, [], gl.DYNAMIC_DRAW)
	gl.BufferData(gl.ARRAY_BUFFER, 24, verts, gl.STATIC_DRAW)
	gl.BufferSubData(gl.ARRAY_BUFFER, 8, verts[2:6])
	shader := gl.CreateShader(gl.VERTEX_SHADER)
	gl.ShaderSource(shader, "#version 330 core\nvoid main() {}")
	log : [256]utf8
	gl.GetShaderInfoLog(shader, &log)
	gl.GetProgramInfoLog(1, &log)
	if gl.GetUniformLocation(1, "model") < 0 do print(log[:])
	// (A framebuffer of a color texture and a depth texture — a
	// reflection's, the scene's depth — and one of a depth renderbuffer.)
	fbo : u32 = 0
	gl.GenFramebuffers(1, &fbo)
	gl.BindFramebuffer(gl.FRAMEBUFFER, fbo)
	gl.TexImage2D(gl.TEXTURE_2D, 0, i32(gl.RGBA16F), 512, 512, 0, gl.RGBA, gl.HALF_FLOAT, [])
	gl.FramebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, 1, 0)
	gl.TexImage2D(gl.TEXTURE_2D, 0, i32(gl.DEPTH_COMPONENT24), 512, 512, 0, gl.DEPTH_COMPONENT, gl.FLOAT, [])
	gl.FramebufferTexture2D(gl.FRAMEBUFFER, gl.DEPTH_ATTACHMENT, gl.TEXTURE_2D, 2, 0)
	gl.FramebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT1, gl.TEXTURE_CUBE_MAP_POSITIVE_X, 3, 0)
	gl.FramebufferTextureLayer(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT2, 4, 0, 7)
	outs : [2!]gl.GL_Attachment = [gl.COLOR_ATTACHMENT0, gl.COLOR_ATTACHMENT1]
	gl.DrawBuffers(outs)
	if gl.CheckFramebufferStatus(gl.FRAMEBUFFER) != u32(gl.FRAMEBUFFER_COMPLETE) do print("incomplete")
	rbo : u32 = 0
	gl.GenRenderbuffers(1, &rbo)
	gl.BindRenderbuffer(gl.RENDERBUFFER, rbo)
	gl.RenderbufferStorage(gl.RENDERBUFFER, u32(gl.DEPTH24_STENCIL8), 512, 512)
	gl.FramebufferRenderbuffer(gl.FRAMEBUFFER, gl.DEPTH_STENCIL_ATTACHMENT, gl.RENDERBUFFER, rbo)
	gl.DrawBuffer(gl.NONE)
	gl.ReadBuffer(gl.COLOR_ATTACHMENT0)
	gl.ClearDepth(1.0)
	gl.ColorMask(0, 0, 0, 0)
	gl.Enable(gl.CLIP_DISTANCE0)
	gl.BindFramebuffer(gl.READ_FRAMEBUFFER, fbo)
	gl.BindFramebuffer(gl.DRAW_FRAMEBUFFER, 0)
	gl.BlitFramebuffer(0, 0, 512, 512, 0, 0, 1024, 1024, gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT, gl.NEAREST)
	gl.DeleteRenderbuffers(1, &rbo)
	gl.DeleteFramebuffers(1, &fbo)
	if gl.gl_has_extension("GL_ARB_bindless_texture") == 1 {
		handle := gl.GetTextureHandleARB(1)
		gl.MakeTextureHandleResidentARB(handle)
		gl.UniformHandleui64ARB(0, handle)
		gl.MakeTextureHandleNonResidentARB(handle)
	}
}

main :: fun(args: [][]utf8) {
	print("units:", u32(gl.TEXTURE0), u32(gl.TEXTURE31))
	print("params:", u32(gl.TEXTURE_MAX_LEVEL), u32(gl.TEXTURE_MAX_ANISOTROPY), u32(gl.TEXTURE_LOD_BIAS), u32(gl.TEXTURE_WRAP_R))
	print("filters:", u32(gl.LINEAR_MIPMAP_NEAREST), u32(gl.NEAREST_MIPMAP_LINEAR), u32(gl.MIRRORED_REPEAT))
	print("limits:", u32(gl.MAX_TEXTURE_IMAGE_UNITS), u32(gl.MAX_TEXTURE_MAX_ANISOTROPY))
	print("buffers:", u32(gl.SHADER_STORAGE_BUFFER), u32(gl.UNIFORM_BUFFER))
	// (A number as its enum's value: a constant checked now, a unit's at run time.)
	unit := 5
	if args.len > 100 do unit = 2
	print("numbered:", gl.GL_Tex_Param(0x813D), gl.GL_Texture_Unit(33984 + unit))
	print("framebuffers:", u32(gl.FRAMEBUFFER), u32(gl.COLOR_ATTACHMENT0), u32(gl.DEPTH_ATTACHMENT), u32(gl.FRAMEBUFFER_COMPLETE), u32(gl.RENDERBUFFER))
	print("depth:", u32(gl.DEPTH_COMPONENT24), u32(gl.DEPTH_COMPONENT32F), u32(gl.DEPTH_COMPONENT), u32(gl.DEPTH24_STENCIL8), u32(gl.UNSIGNED_INT_24_8))
	print("hdr:", u32(gl.RGBA16F), u32(gl.R11F_G11F_B10F), u32(gl.HALF_FLOAT))
	print("cube:", u32(gl.TEXTURE_CUBE_MAP), u32(gl.TEXTURE_CUBE_MAP_POSITIVE_X), u32(gl.TEXTURE_CUBE_MAP_NEGATIVE_Z), u32(gl.CLIP_DISTANCE0))
	// (A local may take a C fun's name: it's open_gl.mara's alone.)
	glClear := "Clear"
	print("names:", glClear)
	if args.len > 100 do uses()
}
