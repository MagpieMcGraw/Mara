module nichetest

// (Maybe: defined at this file's end.)

// A union of two variants, one fieldless, one holding a single pointer: a
// tagged union like any other (it was once stored as the pointer alone).
Opt :: union {
	Nope
	Yep {
		p: ^i64
	}
}

main :: fun() {
	x := 7
	a: Opt = Yep{p = &x}
	match a {
	Nope
		assert(false)
	Yep y
		assert(y.p^ == 7)
	}

	b: Opt = .Nope
	match b {
	Nope
		assert(true)
	Yep y
		assert(false)
	}

	// Generic Maybe(^T), through the generic-instantiation path.
	z := 99
	m: Maybe(^i64) = Some{value = &z}
	match m {
	None
		assert(false)
	Some s
		assert(s.value^ == 99)
	}

	n: Maybe(^i64) = .None
	match n {
	None
		assert(true)
	Some s
		assert(false)
	}

	print("niche ok")
}

// Nothing, or a value: a generic union.
Maybe :: union($T: type) {
	None
	Some {
		value: T
	}
}
