module test_err_multi

E :: error { Bad_Input }

// Three-slot return: (i64, i64, err)
two_vals :: fun(fail: bool) -> i64, i64, err {
    if fail do return 0, 0, E.Bad_Input
    return 10, 20, E.Ok
}

// Caller destructures and propagates.
chain :: fun(fail: bool) -> i64, i64, err {
    x, y := two_vals(fail)?
    return x * 100, y * 100, E.Ok
}

main :: fun() -> i64 {
    a, b, e := chain(false)
    print("ok path:", a, b, e)

    a2, b2, e2 := chain(true)
    print("fail path:", a2, b2, e2)

    return 0
}
