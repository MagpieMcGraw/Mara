module test_match_namespace

// Namespace-form match: subject is a struct, arms are bool field-predicates.
// Each arm fires independently when its predicate is true (multi-fire).
//
// Inside arms, bare identifiers fall back to subject-field lookup — bare
// `payload` inside `match e { … }` resolves as `e.payload` when no local of
// that name shadows it. Same idea as `using subject` for the arm scope.

Payload :: struct {
	count: i64
}

Events :: struct {
	quit:        bool
	double_save: bool
	debug_print: bool
	payload:     Payload
}

test_match_namespace :: fun() {
	e: Events
	e.quit          = true
	e.debug_print   = true
	e.payload.count = 42

	// Should print 1 then 3 — quit and debug_print fire, double_save does not.
	// debug_print's body uses bare `payload.count` which resolves as e.payload.count.
	match e {
	quit        do print(1)
	double_save do print(2)
	debug_print do print(3, payload.count)
	}

	// All true — every arm fires (11, 12, 13 then 42).
	all_on: Events
	all_on.quit          = true
	all_on.double_save   = true
	all_on.debug_print   = true
	all_on.payload.count = 100
	match all_on {
	quit        do print(11)
	double_save do print(12)
	debug_print do print(13, payload.count)
	}

	// All false — nothing fires.
	none: Events
	match none {
	quit        do print(91)
	double_save do print(92)
	debug_print do print(93)
	}
}
