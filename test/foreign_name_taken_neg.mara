module foreign_name_taken_neg

//@ expect-fail: its module already defines that name

// A module can't define a name as both a C function and a Mara fun.

use mara.core

foreign static_lib "kernel32" {
	fun GetLastError() -> u32
}

GetLastError :: fun() -> i64 { return 0 }

main :: fun() {
	print(GetLastError())
}
