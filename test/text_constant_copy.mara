module text_constant_copy

use mara.core

// A text constant's name declaring a variable — `s := GREETING` — gives it
// the text, as a literal does: the variable's buffer set up first (its
// header pointing at it), then the text in it. It was left unset: sliced,
// s showed its own header's bytes.

//@ expect-output: hello | hello | el | 104
//@ expect-output: — 3

GREETING :: "hello"
DASH :: "—"

main :: fun() -> i64 {
	s := GREETING
	whole : []utf8 = s[:]
	viewed : []utf8 = s
	part := s[1:3]
	print(whole, "|", viewed, "|", part, "|", u32(whole[0]))
	d := DASH
	print(d, d.len)
	return 0
}
