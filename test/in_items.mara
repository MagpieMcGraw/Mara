module in_items

//@ expect-output: numbers true false true | not in false true
//@ expect-output: texts true false true | literal list true
//@ expect-output: through a pointer true false
//@ expect-output: | added 3 | includes true

// `x in xs`: whether some item of xs is x — mara.core's `overload in`,
// includes, `==` as the items' type has it; `x not in xs`, its negation.
// A list, an array, a view, an array literal; text items with any text;
// through one pointer, as `for` sees.

use mara.core

Filename :: [32]utf8

add_new :: (files: ^[]Filename, name: []utf8) {
	if name not in files do next(files) + name
}

main :: () {
	nums : [8]i64
	&nums + 1 + 2 + 3
	fixed : [3!]i64 = {4, 5, 6}
	print("numbers", 2 in nums, 9 in nums, 5 in fixed, "| not in", 3 not in nums, 7 not in nums[0 : 2])
	names : [4]str64
	&names + "ada"
	&names + "grace"
	view := "grace"
	print("texts", "ada" in names, "bob" in names, view in names, "| literal list", 3 in [1, 2, 3])
	files : [8]Filename
	&files + "a.mara"
	&files + "b.mara"
	print("through a pointer", "a.mara" in &files, "c.mara" in &files)
	add_new(&files, "a.mara")
	add_new(&files, "c.mara")
	add_new(&files, "c.mara")
	print("| added", files.len, "| includes", includes(files, "c.mara"))
}
