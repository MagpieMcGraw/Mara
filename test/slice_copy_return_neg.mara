module slice_copy_return_neg

//@ expect-fail: `head` is a copy of the immutable param `text`

// What a fun gives back of its immutable param is a copy of it: written
// through, it would write the caller's text through a param that said it
// wouldn't.

use mara.core

first_word :: fun(text: []utf8) -> []utf8 {
	for c, i in text {
		if c == ' ' do return text[0 : i]
	}
	return text
}

main :: fun() {
	line : [32]utf8
	&line + "hello world"
	head := first_word(line)
	head[0] = 'J'
	print(line)
}
