module field_ref_pointer_neg

use mara.core

//@ expect-fail: can't go into

// A field reference reaches only what the struct holds itself: not through a pointer.

Inner :: struct { x: f32 }
Other :: struct { y: f32 }
Key :: union { None = 0  A = 1 }
S :: struct {
	inner: Inner
	p: ^Inner
	list: [4]i64
	items: []i64
	fixed: [4!]i64
}

main :: fun() {
	f := S.p.x
	print(f)
}
