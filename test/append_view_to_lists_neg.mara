module append_view_to_lists_neg

//@ expect-fail: mismatched types for '++': ^[4]str64 and []utf8

// A list of lists takes items, and a view is no item: it has no room of
// its own. Its text goes into an item there: `&names[i] ++ view`.

use mara.core

main :: fun() {
	names : [4]str64
	whole := "Ada"
	view : []utf8 = whole
	&names ++ view
	print(names.len)
}
