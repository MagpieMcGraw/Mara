module test_param_tuple_destructure

// Tuple-destructure-as-default: when N param names share one call source
// whose return is an N-tuple, the call fires ONCE per call site and each
// param takes its corresponding slot. Distinct from broadcast (one scalar
// value cloned per name).

get_pair :: fun() -> (i64, i64) {
    return 11, 22
}

get_triple :: fun() -> (i64, i64, i64) {
    return 100, 200, 300
}

take_pair :: fun(x, y := get_pair()) -> i64 {
    return x + y  // expect x=11, y=22 → 33
}

take_triple :: fun(a, b, c := get_triple()) -> i64 {
    return a + b + c  // expect 100+200+300 → 600
}

// Mixed: explicit args overriding the destructure shouldn't even reach
// the destructure path.
take_pair_explicit :: fun(x, y := get_pair()) -> i64 {
    return x + y
}

test_param_tuple_destructure :: fun() {
    print("=== test_param_tuple_destructure ===")
    print(take_pair())                // expect 33
    print(take_triple())              // expect 600
    print(take_pair_explicit(5, 7))   // expect 12 (no defaults)
    print("=== test_param_tuple_destructure passed ===")
}
