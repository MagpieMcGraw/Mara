module several_results_return_neg
//@ expect-fail: a call returning 3 values can't be returned whole from a fun returning 2

// `return f()` hands on f's results when they fit the fun's (return_forward);
// three into two don't.

use mara.core

three :: fun() -> i64, bool, i64 { return 1, true, 2 }

two :: fun() -> i64, bool {
	return three()
}

main :: fun() {
	a, b := two()
	print(a, b)
}
