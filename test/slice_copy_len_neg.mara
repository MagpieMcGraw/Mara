module slice_copy_len_neg

//@ expect-fail: `tail` is a slice: its len is its size

// A slice's len is its size: it can't be set, a copy's either — raised, it
// would reach past the view. (Re-pointing the copy, `tail = tail[1:]`, is
// fine: slice_copy_ok.)

use mara.core

widen :: fun(items: []i64) -> i64 {
	tail := items
	tail.len = 3
	return tail[2]
}

main :: fun() {
	list : [4]i64
	&list + 1
	print(widen(list))
}
