module xreturn

// The user's case: x := make_arr() is a fixed-array local; returning it inside a
// struct should work (codegen relocates the bare-ident array to caller sret,
// regardless of value==nil). If h.sl survives clobber() intact, it relocated.

Holder :: struct { sl: []i32 }

make_arr :: fun() -> [4]i32 {
	r : [4]i32
	r[0] = 11  r[1] = 22  r[2] = 33  r[3] = 44
	return r
}

build :: fun() -> Holder {
	x := make_arr()
	return Holder{x}
}

clobber :: fun() -> i32 {
	j : [64]i32
	s : i32 = 0
	for i in 0..64 { j[i] = i32(i * 7)  s += j[i] }
	return s
}

main :: fun() {
	h := build()
	_ = clobber()
	print("xret:", h.sl[0], h.sl[1], h.sl[2], h.sl[3])   // 11 22 33 44 if relocated
}
