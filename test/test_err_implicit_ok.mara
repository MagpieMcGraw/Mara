module test_err_implicit_ok

File_Error :: error {
    Not_Found
    Too_Large
}

// Bare `return` in an err-only fn — implicit `.Ok`.
ok_only_bare :: fun() -> err {
    return
}

// Fall-off-end in an err-only fn — same as bare `return`.
ok_only_falloff :: fun() -> err {
    print("doing work")
}

// (T, err) — return one value, trailing err filled with .Ok.
// Also exercises bare-name resolution in the err slot (Too_Large vs File_Error.Too_Large).
make_value :: fun(flag: bool) -> i64, err {
    if flag do return 0, Too_Large
    return 42
}

// (T1, T2, err) — return two values, trailing err filled with .Ok.
// Bare-name in the err slot via leading-dot also still works.
make_two :: fun(flag: bool) -> i64, i64, err {
    if flag do return 0, 0, .Not_Found
    return 10, 20
}

// Propagation still works through the new implicit form.
chain :: fun(flag: bool) -> i64, err {
    x := make_value(flag)?
    return x + 100
}

main :: fun() -> i64 {
    e1 := ok_only_bare()
    print("ok_only_bare:", e1)

    e2 := ok_only_falloff()
    print("ok_only_falloff:", e2)

    a, ea := make_value(false)
    print("make_value ok:", a, ea)

    a2, ea2 := make_value(true)
    print("make_value fail:", a2, ea2)

    b1, b2, eb := make_two(false)
    print("make_two ok:", b1, b2, eb)

    n, en := chain(false)
    print("chain ok:", n, en)

    _, en2 := chain(true)
    print("chain fail:", en2)

    return 0
}
