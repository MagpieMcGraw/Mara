module font_test

use mara.os
use mara.memory
use mara.font

// Exercises the font loader on a real TTF without launching the game:
// bake printable ASCII (32..127) into the atlas, then dump 'A'.
main :: fun() -> i64 {
	this_program = Program(Arena_Debug(64 * MB))

	glyphs : [..96]Glyph
	glyphs.len = 96
	atlas, metrics := load_glyphs(
		&glyphs, 32, "../Pounce/data/fonts/Inter_18pt-Regular.ttf")
	print("line metrics: ascent", metrics.ascent,
		"descent", metrics.descent, "line_gap", metrics.line_gap)

	a := glyphs[65 - 32]   // 'A'
	print("glyph 'A': cell", a.w, "x", a.h, "bearing", a.bearing_x, a.bearing_y, "advance", a.advance)
	print("--- atlas cell for 'A' (median) ---")
	ab : []byte = atlas[:]
	dump_atlas_cell(&ab, 1024, a.x, a.y, a.w, a.h)
	return 0
}
