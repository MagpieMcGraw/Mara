module list_literal_items_typed_neg

//@ expect-fail: takes no items: an empty list is written `[]`, every item one value `{all v}`, and a list of items `[a, b, …]`

// A typed list literal with items: only its fill is written with braces
// (`[N]T{all v}`); items are `[1, 2]`, and an empty list `[]`.

use mara.core

main :: fun() {
	xs := [4]i64{1, 2}
	print(xs.len)
}
