module enum_from_text

//@ expect-output: build Mode.build
//@ expect-output: bogus Mode.none
//@ expect-output: Mode.run
//@ expect-output: Mode.check
//@ expect-output: Mode.none Mode.none Mode.none
//@ expect-output: D.run
//@ expect-output: slice: Mode.run
//@ expect-output: field Mode.check element [Mode.none, Mode.run]
//@ expect-output: compared
//@ expect-output: running

// `E.from_text(s)`: the variant of E whose name s spells exactly; when none
// does, E's variant written `= 0` (from_text_no_zero_neg: E must have one).
// Text from a slice, a buffer, a constant; a distinct enum's; as a value
// anywhere — a field's, an element's, a comparison's side. (llvm_from_text:
// no function — compared where it's called.)

use mara.core

Mode :: union { build  run  check  help  none = 0 }
D :: distinct Mode
Holder :: struct { m: Mode }

show :: fun(s: []utf8) {
	print(s, Mode.from_text(s))
}

main :: fun() {
	show("build")
	show("bogus")
	m := Mode.from_text("run")
	print(m)
	name : str64
	&name + "che"
	&name + "ck"
	m = Mode.from_text(name)
	print(m)
	print(Mode.from_text("ru"), Mode.from_text("runx"), Mode.from_text(""))
	d := D.from_text("run")
	print(d)
	word : str64
	&word + "run"
	m = Mode.from_text(word[0:3])
	print("slice:", m)
	h := Holder{m = Mode.from_text("check")}
	ms : [2!]Mode
	ms[1] = Mode.from_text("run")
	print("field", h.m, "element", ms)
	if Mode.from_text(word) == run do print("compared")
	match m {
	build
		print("building")
	run
		print("running")
	else
		print("other")
	}
}
