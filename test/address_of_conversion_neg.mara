module address_of_conversion_neg

//@ expect-fail: cannot take the address of `i32(log.len)`: it's a converted copy of 'log.len', so what's written through it never reaches 'log.len'

// A variable converted is a copy of it: a C function handed the copy's
// address writes the copy (GL's info log length), and log.len stays 0.

use mara.core

Count :: distinct i64

fill :: fun(length: ^i32) { length^ = 5 }
fill_count :: fun(c: ^Count) { c^ = Count(5) }

main :: fun() {
	log : [16]utf8
	fill(&(i32(log.len)))
	n : i64 = 0
	fill_count(&Count(n))
	print(log.len, n)
}
