module foreign_mara_first

use mara.core
use from_mara
use from_c

// Two modules in use have `both`, one a Mara fun and one a C function: the Mara
// fun is the one called. C's names aren't chosen here and differ by platform, so
// they shouldn't make a Mara fun's call ambiguous. Named, either is reached.

main :: fun() {
	print(both())
	print(from_c.both())
}
