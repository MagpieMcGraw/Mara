module byte_write_list_struct

//@ expect-output: span written: 64
//@ expect-output: read back: abc 3 3
//@ expect-output: unaligned: hello 5 77
//@ expect-output: nested: xy 2 9 last 41

// A struct holding a list writes into a byte buffer as its bytes: the list's
// len and room go with them, as a list's do on its own (a list is its len
// and its items, nothing pointing elsewhere). sooblivion's plugin index
// wrote a struct of the fields it needed instead: "can't lower ... its view".

use mara.core

Span :: struct {
	name: [8]utf8
	start: i64
}

Outer :: struct {
	span: Span
	last: i64
}

main :: () {
	chunk : [256]byte
	chunk.len = 64
	span := Span{name = [], start = 3}
	&span.name + "abc"
	chunk[16] = span
	print("span written: %", chunk.len)
	back : Span = chunk[16]
	print("read back: % % %", back.name, back.name.len, back.start)

	other := Span{name = [], start = 77}
	&other.name + "hello"
	chunk[33] = other
	again : Span = chunk[33]
	print("unaligned: % % %", again.name, again.name.len, again.start)

	outer := Outer{span = Span{name = [], start = 9}, last = 41}
	&outer.span.name + "xy"
	chunk[100] = outer
	o : Outer = chunk[100]
	print("nested: % % % last %", o.span.name, o.span.name.len, o.span.start, o.last)
}
