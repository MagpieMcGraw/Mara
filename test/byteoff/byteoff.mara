module byteoff

// Under 8 8 8 slices, a byte-buffer reinterpret read `#big_endian buf[off]`
// accepts any-width offset: an `int` (i64 — the default for `off := 2`) widens
// losslessly to the i64 slice/index width. Pre-8-8-8 this hit an i32-vs-i64
// mismatch (the original bug); now it just works, no cast.
main :: fun() {
	buf : [16]byte
	buf[2] = 0
	buf[3] = 5
	off := 2                        // int → i64
	v : u16 = #big_endian buf[off]  // i64 offset — widens to header width
	print("v:", v)                  // v: 5  (big-endian {0, 5})
}
