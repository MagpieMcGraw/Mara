module constmoduse

//@ expect-output: imported=0 0
//@ expect-output: constmoduse ok

use constmoddef
use constmodmid

main :: fun() -> i64 {
	m := DEF_MESH
	assert(m.index == 0)

	v : CM_Visual
	v.mesh = DEF_MESH
	v.texture = DEF_TEXTURE
	assert(v.texture.uv[2] == 0)

	// fields of another module's constant (Pounce: `ATLAS_TEXTURE.uv`)
	v.texture.uv = DEF_TEXTURE.uv
	print("imported=% %", DEF_TEXTURE.uv[3], DEF_MESH.index)

	print("constmoduse ok")
	return 0
}
