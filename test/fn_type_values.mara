module fn_type_values

//@ expect-output: local 42
//@ expect-output: param 10
//@ expect-output: struct 2 1
//@ expect-output: multi 4 7

// Calls through structural fn types (`fun(T) -> R` written in place). The
// checker fills their lowered signature when the type resolves; codegen used
// to fill it lazily, writing a shared Type_Scope from the parallel workers.

Pair :: struct {
	a: i64
	b: i64
}

double :: fun(x: i64) -> i64 { return x * 2 }
swap :: fun(p: Pair) -> Pair { return Pair{a = p.b, b = p.a} }
split :: fun(x: i64) -> i64, i64 { return x / 10, x % 10 }

apply :: fun(x: i64, op: fun(i64) -> i64) -> i64 { return op(x) }
apply_pair :: fun(p: Pair, op: fun(Pair) -> Pair) -> Pair { return op(p) }

main :: fun() {
	f : fun(i64) -> i64 = double
	print("local", f(21))
	print("param", apply(5, double))
	q := apply_pair(Pair{a = 1, b = 2}, swap)
	print("struct", q.a, q.b)
	s : fun(i64) -> i64, i64 = split
	hi, lo := s(47)
	print("multi", hi, lo)
}
