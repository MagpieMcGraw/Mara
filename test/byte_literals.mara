module byte_literals

use mara.core

//@ expect-output: decl: 4 true true true true
//@ expect-output: u32: 285147137
//@ expect-output: assign: true true true true
//@ expect-output: list: 3 8 true true
//@ expect-output: arg: 4 72
//@ expect-output: field: true 4
//@ expect-output: mixed: true true true
//@ expect-output: named: true true
//@ expect-output: return: true true

// Int literals go into an array of bytes, one byte each, from 0 to 255
// (byte_literal_range_neg past that), as a comparison with a byte takes
// them. A byte stays memory, not a number (byte_literal_number_neg).

Header :: struct {
	magic: [4!]byte,
	size: u32,
}

Four :: [4!]byte

sum :: fun(b: [4!]byte) -> i64 {
	total := 0
	for x in b {
		if x == 72 do total += 72
	}
	return total
}

riff :: fun() -> [4!]byte {
	return [82, 73, 70, 70]
}

main :: fun() {
	data : [4!]byte = [1, 0, 0xff, 16]
	print("decl:", data.len, data[0] == 1, data[1] == 0, data[2] == 255, data[3] == 16)
	// (Read as memory, the four bytes are one u32: 0x10ff0001.)
	one : u32 = data[0]
	print("u32:", one)
	data = [7, 8, 9, 10]
	print("assign:", data[0] == 7, data[1] == 8, data[2] == 9, data[3] == 10)
	list : [8]byte = [1, 2, 3]
	print("list:", list.len, list.cap, list[1] == 2, list[2] == 3)
	print("arg:", 4, sum([72, 0, 0, 0]))
	h := Header{magic = [82, 73, 70, 70], size = 4}
	print("field:", h.magic[0] == 82, h.size)
	b := data[0]
	mixed : [3!]byte = [1, b, 3]
	print("mixed:", mixed[0] == 1, mixed[1] == 7, mixed[2] == 3)
	named : Four = [5, 6, 0, 0]
	print("named:", named[0] == 5, named[1] == 6)
	r := riff()
	print("return:", r[0] == 82, r[3] == 70)
}
