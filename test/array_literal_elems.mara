module array_literal_elems

//@ expect-output: slices=abc defgh
//@ expect-output: bare=defgh abc
//@ expect-output: padded=abc 0
//@ expect-output: pick0=one 1
//@ expect-output: pick1=two 9
//@ expect-output: pick2=two 7
//@ expect-output: structs=3 4 5 6 7 14
//@ expect-output: strings=ab xy
//@ expect-output: nested=1 3 4 6
//@ expect-output: ret=defgh abc
//@ expect-output: tuple=defgh abc 5
//@ expect-output: sliceparam=abc,defgh
//@ expect-output: arrayparam=defgh abc
//@ expect-output: field=abc defgh
//@ expect-output: fieldlit=defgh abc
//@ expect-output: all=abc abc abc
//@ expect-output: runtime=1.5 2 1.5
//@ expect-output: fixed=7 3
//@ expect-output: fixedbare=7 4
//@ expect-output: slice=7 5
//@ expect-output: slicebare=7 6

// An array literal's slots are stored through ONE element-store dispatch
// (gen_store_elem_into). Slices, unions, strings and nested arrays are
// pointer-valued in codegen, so the old `store <elem> <gen_expr result>` wrote
// an address where the value belongs — invalid IR for every literal of them, in
// every context (decl, return, tuple return, argument, field, broadcast). And a
// literal in value position with a RUNTIME scalar (`f(Vec3{a, 2, a})`) was
// emitted as an LLVM constant holding SSA values ("invalid use of
// function-local name").

Point :: struct { x: i64, y: i64 }
Pick :: union(tag u8) { One = 1 { n: i64 } Two = 2 { m: i64 } }
H :: struct { a: [2][]utf8, n: i64 }
Vec3 :: distinct [3]f32

mk :: fun(v: i64) -> Point { return Point{x = v, y = v * 2} }
say :: fun(label: []utf8, p: Pick) {
	match p {
	One o
		print("%=one %", label, o.n)
	Two t
		print("%=two %", label, t.m)
	}
}
two :: fun(a: []utf8, b: []utf8) -> [2][]utf8 { return [2][]utf8{b, a} }
two_n :: fun(a: []utf8, b: []utf8) -> ([2][]utf8, i64) { return [2][]utf8{b, a}, 5 }
show_all :: fun(list: [][]utf8) { print("sliceparam=%,%", list[0], list[1]) }
show_two :: fun(list: [2][]utf8) { print("arrayparam=% %", list[0], list[1]) }
sv :: fun(v: Vec3) { print("runtime=% % %", v[0], v[1], v[2]) }
si :: fun(label: []utf8, v: [2]i64) { print("%=% %", label, v[0], v[1]) }
ss :: fun(label: []utf8, v: []i64) { print("%=% %", label, v[0], v[1]) }

main :: fun() {
	w1 := "abc"
	w2 := "defgh"
	s1 : []utf8 = w1
	s2 : []utf8 = w2

	a := [2][]utf8{s1, s2}
	print("slices=% %", a[0], a[1])
	b : [2][]utf8 = [s2, s1]
	print("bare=% %", b[0], b[1])
	c : [3][]utf8 = [s1]
	print("padded=% %", c[0], c[1].len)

	p : Pick = Two{m = 7}
	picks := [3]Pick{One{n = 1}, Two{m = 9}, p}
	say("pick0", picks[0])
	say("pick1", picks[1])
	say("pick2", picks[2])

	pt := Point{x = 3, y = 4}
	pts := [3]Point{pt, Point{x = 5, y = 6}, mk(7)}
	print("structs=% % % % % %", pts[0].x, pts[0].y, pts[1].x, pts[1].y, pts[2].x, pts[2].y)

	w : [..8]utf8 = "xy"
	strs := [2][..8]utf8{"ab", w}
	print("strings=% %", strs[0], strs[1])

	row : [3]i64 = [1, 2, 3]
	grid := [2][3]i64{row, [4, 5, 6]}
	print("nested=% % % %", grid[0][0], grid[0][2], grid[1][0], grid[1][2])

	r := two(w1, w2)
	print("ret=% %", r[0], r[1])
	t, n := two_n(w1, w2)
	print("tuple=% % %", t[0], t[1], n)

	show_all([2][]utf8{s1, s2})
	show_two([2][]utf8{s2, s1})

	h : H
	h.a = [2][]utf8{s1, s2}
	print("field=% %", h.a[0], h.a[1])
	k := H{a = [2][]utf8{s2, s1}, n = 1}
	print("fieldlit=% %", k.a[0], k.a[1])

	bc : [3][]utf8 = all s1
	print("all=% % %", bc[0], bc[1], bc[2])

	f : f32 = 1.5
	i := 7
	sv(Vec3{f, 2, f})
	si("fixed", [2]i64{i, 3})
	si("fixedbare", [i, 4])
	ss("slice", [2]i64{i, 5})
	ss("slicebare", [i, 6])
}
