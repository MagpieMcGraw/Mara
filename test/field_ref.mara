module field_ref

use mara.core

//@ expect-output: write by ref: 5 5
//@ expect-output: bool by ref: true true
//@ expect-output: runtime index: true
//@ expect-output: printed: mouse.x keys.held[W] keys.held[S]
//@ expect-output: text: mouse.x keys.held[W]
//@ expect-output: from_text: 7 true
//@ expect-output: from_text miss: false
//@ expect-output: from_text written out: keys.held[W] mouse true
//@ expect-output: bind: quit false
//@ expect-output: bind: mouse.pressed[1] true
//@ expect-output: bind: keys.held[A] false
//@ expect-output: through a pointer: 9 9
//@ expect-output: compare: true false
//@ expect-output: composed: true mouse.x
//@ expect-output: spelled types: 1.5 mouse 9
//@ expect-output: by value: 2.5
//@ expect-output: list item: true true 0 buttons[2]
//@ expect-output: list runtime: 2.5 stick[1]
//@ expect-output: list from_text: -1 true
//@ expect-output: void: void void void -1 true true false
//@ expect-output: in place: tail cells[1].y
//@ expect-output: alias: by_key[B] true true
//@ expect-output: using: hp hp true true
//@ expect-output: self: 2 b
//@ expect-output: as numbers: 56 8 0 0

// Field references: `Events.mouse.x` is a value naming a field of Events by its
// place, typed `Events.f32`; `events[f]` reads and writes it, through a pointer
// too. Paths go into fixed arrays by any index, enum-indexed ones by variant,
// and lists within their cap, a write leaving the len as indexing does; text()
// and from_text name them. A reference never set is its type's first field.

Key :: union {
	None = 0
	A = 4
	S = 22
	W = 26
}

Mouse :: struct {
	x, y: f32
	pressed: [6!]bool
}

Keys :: struct {
	held: [32 Key]bool
}

Events :: struct {
	quit: bool
	mouse: Mouse
	keys: Keys
	scroll: f32
}

Look :: alias Events.f32
Button :: alias Events.bool

main :: fun() {
	events := Events{all 0}
	f := Events.mouse.x
	events[f] = 5
	print("write by ref:", events.mouse.x, events[f])
	b := Events.keys.held[W]
	events[b] = true
	print("bool by ref:", events.keys.held[W], events[b] == true)
	k := Key.S
	by_runtime := Events.keys.held[k]
	events[by_runtime] = true
	print("runtime index:", events.keys.held[S])
	print("printed:", f, b, by_runtime)
	print("text:", f.text(), b.text())
	g := Look.from_text("mouse.y")
	if g != void do events[g] = 7
	print("from_text:", events.mouse.y, g != void)
	none := Look.from_text("mouse.z") != void
	print("from_text miss:", none)
	w, ms := Events.bool.from_text("keys.held[W]"), Events.Mouse.from_text("mouse")
	print("from_text written out:", w, ms, Events.f32.from_text("quit") == void)
	binds : [3!]Button = [Events.quit, Events.mouse.pressed[1], Events.keys.held[A]]
	events.mouse.pressed[1] = true
	for bind in binds { print("bind:", bind, events[bind]) }
	p := &events
	p[f] = 9
	print("through a pointer:", p[f], events.mouse.x)
	print("compare:", f == Events.mouse.x, f == Events.mouse.y)
	m := Events.mouse
	mx := m.x
	print("composed:", mx == f, mx)
	r : Events.f32 = Events.scroll
	t : Events.Mouse = Events.mouse
	events[r] += 1.5
	print("spelled types:", events.scroll, t, events[t].x)
	print("by value:", read(Inner_S{inner = Inner{x = 2.5}, fixed = [0, 0, 0, 0]}, Inner_S.inner.x))
	pad := Pad{all 0}
	pf := Pad.buttons[2]
	pad[pf] = true
	print("list item:", pad.buttons[2], pad[pf], pad.buttons.len, pf)
	at := 1
	if pad.flag do at = 0
	ps := Pad.stick[at]
	pad[ps] = 2.5
	print("list runtime:", pad.stick[1], ps.text())
	pg := Pad_Axis.from_text("stick[0]")
	if pg != void do pad[pg] = -1
	print("list from_text:", pad.stick[0], pg != void)
	more()
}

// A reference's zero is void, none: a struct of them made `{all 0}`,
// from_text's miss, `= void`. It prints "void", is -1 as a number, and
// compares equal to void.
more :: fun() {
	h := Holder{all 0}
	m := Named_Text.from_text("nope")
	v : Named.[]utf8 = void
	print("void:", h.f, m, v, i64(h.f), h.f == void, m == void, Named.name == void)
	print("in place:", Named.tail, Named.cells[1].y)
	b := Keyed.by_key[B]
	by_b := Keyed_Bool.from_text("by_key[B]") != void
	also := Keyed_Bool.from_text("by_key[Also_B]")
	by_also := also != void
	print("alias:", b, by_b, by_also and also == b)
	by_short := Keyed_Int.from_text("hp") != void
	by_full := Keyed_Int.from_text("base.hp") != void
	print("using:", Keyed.hp, Keyed.base.hp.text(), by_short, by_full)
	o := Own{a = 1, b = 2, pick = Own.b}
	print("self:", o[o.pick], o.pick)
	// (Its value comes out as an integer, counted from its type's first field.)
	print("as numbers:", i64(Named.tail), u64(Named.count), i32(Named.id), i64(Named.cells[0].x))
}

Inner :: struct { x: f32 }
Inner_S :: struct { inner: Inner  fixed: [4!]i64 }
read :: fun(s: Inner_S, f: Inner_S.f32) -> f32 { return s[f] }

Pad :: struct {
	flag: bool
	buttons: [4]bool
	stick: [2]f32
}
Pad_Axis :: alias Pad.f32

Cell :: struct { x: f32  y: f32 }
Named :: struct { id: i64  count: i64  name: []utf8  cells: [2!]Cell  tail: i64 }
Named_Text :: alias Named.[]utf8
Holder :: struct { f: Named.[]utf8 }
K :: union { A = 0  B = 1  Also_B = 1  C = 2 }
Base :: struct { hp: i64 }
Keyed :: struct { by_key: [3 K]bool  using base: Base }
Keyed_Bool :: alias Keyed.bool
Keyed_Int :: alias Keyed.i64
Own :: struct { a: i64  b: i64  pick: Own.i64 }
