module memory_profile

use mara.core
use mara.os
use mara.string
use mara.memory

#allocator Arena_Basic(1 * MB)

//@ build-flags: -profile memory
//@ expect-output: 1225 3 Ok
//@ expect-output: carved: 2 true
//@ expect-output: child: 0
//@ expect-output: arena: Arena_Basic, its peak within its size: true

// A -profile memory build runs as a plain one does: its locals, a struct's
// fields copied into a partial array, a file read through a ^[]byte param,
// a take, an arena — each probe told, none of them changing what it does.
// (Its memory.txt is mara_mem.c's to write; doc/memory_profiling.mara says
// what's in it.)
//
// Then it runs itself again, the child writing its own memory.txt, and reads
// what that says (sooblivion's, MARA_ISSUES.md): an arena's peak is the most
// of it in use (it read a `^[]byte`'s len's address).

Item :: struct {
	name: [64]utf8
	count: i64
}

squares :: fun(n: i64) -> i64 {
	found : [1000]i64
	for k in 0:n {
		&found + k * k
	}
	return found.len
}

Part :: struct {
	texture: [160]utf8
	count: i64
}

Bytes :: struct {
	data: [100000]u8
}

make_parts :: fun(storage: ^[]byte) -> i64 {
	parts := slice([:4]Part, storage)
	for k in 0:4 {
		&parts + Part{texture = [], count = k}
		&parts[k].texture + "textures/a.dds"
	}
	return parts.len
}

make_bytes :: fun(storage: ^[]byte) -> i64 {
	holders := slice([:1]Bytes, storage)
	holder := next(&holders)
	holder.data.len = 0
	for k in 0:50000 do &holder.data + u8(k)
	return holder.data.len
}

// The child's run: parts carved from the storage, the storage emptied, an
// item made in it with next().
child :: fun() {
	storage : [300000]byte
	_ = make_parts(&storage)
	storage.len = 0
	_ = make_bytes(&storage)
}

// A line's words, split at spaces.
words :: fun(line: []utf8) -> [12][]utf8 {
	out : [12][]utf8
	k := skip_spaces(line, 0)
	for k < line.len and out.len < out.cap {
		start := k
		for k < line.len and line[k] != ' ' do k += 1
		&out + line[start : k]
		k = skip_spaces(line, k)
	}
	return out
}

// The row of memory.txt whose word at `column` is `name`, split.
row :: fun(text: []utf8, column: i64, name: []utf8) -> [12][]utf8 {
	at : i64 = 0
	for at < text.len {
		end := line_end(text, at)
		w := words(text[at : end])
		if w.len > column and w[column] == name do return w
		at = end + 1
	}
	none : [12][]utf8
	return none
}

number :: fun(s: []utf8) -> i64 {
	v, _ := parse_number(s)
	return i64(v)
}

// The child's memory.txt, what it says.
report :: fun(exe: []utf8) -> err {
	command : str256
	&command + "\""
	&command + exe
	&command + "\" child"
	p := process_start(command)?
	process_close_input(&p)
	code := process_wait(&p)?
	print("child:", code)
	here := exe_path()?
	path : Path
	&path + get_dir(here)
	&path + "memory.txt"
	storage : [64 * KB]byte
	bytes := read_entire_file(path, &storage)?
	text : []utf8 = bytes
	arena := row(text, 3, "Arena_Basic")
	size, peak := number(arena[0]), number(arena[1])
	print("arena: Arena_Basic, its peak within its size:", peak > 0 and peak <= size)
}

main :: fun(args: [][]utf8) -> i64 {
	if args.len > 1 {
		child()
		return 0
	}
	total := 0
	for n in 1:50 {
		total += squares(n)
	}
	items : [100]Item
	for k in 0:3 {
		it : Item
		it.name = "an item"
		it.count = k
		&items + it
	}
	storage : [4096]byte
	_, e := read_entire_file("memory_profile.mara", &storage)
	print(total, items.len, e)
	pair := slice([:2]i64, &storage)
	pair[0] = 1
	print("carved:", pair.cap, storage.len > 16)
	re := report(args[0])
	if re do print("report failed:", re)
	return 0
}
