module text_partial_array

//@ expect-output: abc 3 defgh 5
//@ expect-output: two 3 7
//@ expect-output: name kenney/bridge 13

// Text is only its bytes in memory, whatever its type says ([N]utf8). As a
// partial array it's built into one: returned from a `-> str64` fun, where
// both emitters copied a whole partial array's worth from the text (reading
// past it — the output held its neighbours); and handed to a str64 param,
// where the graph's emitter passed the bytes' address as the partial array.

use mara.core

name :: fun(k: i64) -> str64 {
	if k > 0 do return "abc"
	return "defgh"
}
pair :: fun() -> str64, i64 {
	return "two", 7
}
Entry :: struct { name: [64!]utf8, n: i64 }
set_name :: fun(e: ^Entry, new_name: str64) {
	e.n = new_name.len
	for i in 0:new_name.len { e.name[i] = new_name[i] }
}

main :: fun() {
	a := name(1)
	b := name(0)
	print(a, a.len, b, b.len)
	s, n := pair()
	print(s, s.len, n)
	e : Entry
	set_name(&e, "kenney/bridge")
	print("name", e.name[:e.n], e.n)
}
