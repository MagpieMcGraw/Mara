module literal_gap_variant_neg

//@ expect-fail: Rect has 2 fields but only 1 was set. h was unset.

// A variant's literal runs no body either: every field of its variant is
// given, or it's an error (`.Rect` constructs one, its defaults run).

Shape :: union {
	Rect { w: i64 = 2  h: i64 = 3 }
	Dot
}

main :: fun() {
	s : Shape = Rect{w = 4}
	print(s)
}
