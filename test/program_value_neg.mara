module program_value_neg
//@ expect-fail: a Program value's arena is the program's own kind, Arena_Basic

// A Program value's arena is the kind main's this_program has: the
// program's arena functions are that kind's.

use mara.core
use mara.memory

main :: () {
	this_program = Program(Arena_Basic(16 * MB))
	lib := Program(Arena_Debug(1 * MB))
	print(lib.args.len)
}
