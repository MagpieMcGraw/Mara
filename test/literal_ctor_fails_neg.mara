module literal_ctor_fails_neg

//@ expect-fail: 'T' can fail, and a literal has no err to hand back

// A literal of a struct whose constructor can fail would drop the err: the
// literal has nowhere to hand it back.

Bad :: error {
	Neg
}

T :: struct(x: i32 = 0) -> err {
	v: i32
	if x < 0 do return Neg
}

main :: fun() {
	t := T{}
	print(t.v)
}
