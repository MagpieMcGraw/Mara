module append_array_literal

//@ expect-output: items: [1, 2, 3, 4] 4
//@ expect-output: bytes: [250, 251] 2
//@ expect-output: one view: 1 3 3
//@ expect-output: views in a list: 2 [4, 5] [6]

// An array literal appended: its items into a list of numbers, or itself as
// one view into a list of slices. The checker took both, and lowering
// stopped at "an array literal as an operand", so they were written
// `&views + [1, 2, 3][:]` (the literal held as an array, viewed).

use mara.core

main :: fun() {
	nums : [8]i64
	&nums + [1, 2, 3]
	&nums + 4
	print("items:", nums, nums.len)
	bytes : [8]u8
	&bytes + [250, 251]
	print("bytes:", bytes, bytes.len)

	storage : [64]byte
	views := slice([:2][]i64, &storage)
	&views + [1, 2, 3]
	print("one view:", views.len, views[0].len, views[0][2])
	list : [4][]i64
	&list + [4, 5]
	&list + [6]
	print("views in a list:", list.len, list[0], list[1])
}
