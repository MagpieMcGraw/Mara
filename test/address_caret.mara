module address_caret

use mara.core
use mara.memory

#allocator Arena_Basic(16 * MB)

//@ expect-output: through p: 7
//@ expect-output: bumped: 8
//@ expect-output: field: 3 4
//@ expect-output: same address: true
//@ expect-output: list: 2 5 6
//@ expect-output: with: 16408
//@ expect-output: bits: 2

// `^x` takes an address as `&x` does: a local's, a field's, a list's, an
// arena's for `with`. `p^` still follows one, and `a & b` is still and.

Pair :: struct {
	a: i64
	b: i64
}

bump :: fun(n: ^i64) {
	n^ += 1
}

work :: fun(lib: ^Arena_Basic) -> i64 {
	big : [16 * KB]byte
	big[0] = u8(1)
	return lib.base.len
}

main :: fun() {
	x := 5
	p := ^x
	p^ = 7
	print("through p:", x)

	bump(^x)
	print("bumped:", x)

	s := Pair{1, 2}
	q := ^s.a
	q^ = 3
	r := ^s
	r.b = 4
	print("field:", s.a, s.b)

	print("same address:", ^x == &x)

	list : [4]i64
	next(^list)^ = 5
	next(^list)^ = 6
	print("list:", list.len, list[0], list[1])

	lib := Arena_Basic(1 * MB)
	with ^lib do print("with:", work(^lib))

	print("bits:", 6 & 3)
}
