module list_stays_empty

use mara.core

//@ expect-warning: Warning: 'combo' is indexed, but nothing gives it a len
//@ expect-warning: Warning: 'used' is indexed, but nothing gives it a len
//@ expect-warning: Warning: 'table' is indexed, but nothing gives it a len
//@ expect-warning: Warning: 'seen' is indexed, but nothing gives it a len
//@ expect-warning: Warning: 'shown' is indexed, but nothing gives it a len
//@ expect-warning: Warning: 'looped' is looped over, but nothing gives it a len: it stays an empty list, and the loop runs no times
//@ expect-no-warning: 'names'
//@ expect-no-warning: 'later'
//@ expect-no-warning: 'filled'
//@ expect-no-warning: 'ok'
//@ expect-no-warning: 'buf'
//@ expect-no-warning: 'arr'
//@ expect-no-warning: 'given'
//@ expect-no-warning: 'items'
//@ expect-no-warning: 'made'
//@ expect-no-warning: 'whole'
//@ expect-no-warning: 'grown'
//@ expect-output: combos 0
//@ expect-output: walk 0 2
//@ expect-output: 0 5 | 0 3 | 1
//@ expect-output: seen h true 1 2
//@ expect-output: read 2 8 | 1 4 | 2
//@ expect-output: [] 0 0 | 1
//@ expect-output: loops 0 1

// A list declared with nothing in it that no code gives a len stays empty:
// indexed, it is warned about — the index is past its len, a loop over it
// runs no times (combo: its inner lists are appended to, its own len stays
// 0). Anything that could give it a len — an append, its `.len` written,
// its address taken, a value written to it whole, a literal's field, a read
// out of bytes — in any function, and it isn't. Given to a function by
// value (printed, counted), it is still empty. A loop over one is warned
// about as an index is.

Keys :: struct { held: [4!]bool  jump: bool  run: bool }

Bind :: class {
	combo : [3][4]Keys.bool
	names : [3][16]utf8
	used  : [8]i64
	later : [8]i64
}

Packet :: struct {
	total: i64
	items: [4]i64
}

Made :: struct {
	made: [4]i64
}

count :: fun(xs: []i64) -> i64 { return xs.len }
grow :: fun(xs: ^[]i64) { xs ++ 1 }

fill :: fun(b: ^Bind) {
	&b.names ++ "walk"
	b.later.len = 2
}

main :: fun() {
	binds : [2!]Bind
	&binds[0].combo[0] ++ Keys.jump
	combos := 0
	for c in binds[0].combo do combos += 1
	print("combos", combos)
	fill(&binds[1])
	print(binds[1].names[0], binds[0].later.len, binds[1].later.len)

	binds[0].used[2] = 5
	table : [4]i64
	table[1] = 3
	filled : [4]i64
	&filled ++ 1
	print(binds[0].used.len, binds[0].used[2], "|", table.len, table[1], "|", filled[0])

	seen : [16]bool
	seen[3] = true
	ok : [16]bool
	ok.len = 16
	ok[3] = true
	buf : [8]utf8
	&buf ++ "hi"
	arr : [4!]i64
	arr[0] = 1
	given : [4]i64 = [1, 2]
	if seen[3] do print("seen", buf[0], ok[3], arr[0], given[1])

	// (A list that comes out of bytes has the len written there.)
	sent := Packet{total = 2, items = [7, 8]}
	bytes : [64!]byte
	bytes[0] = sent
	got : Packet = bytes[0]
	m := Made{made = [4]}
	whole : [4]i64
	whole = [1, 2]
	print("read", got.items.len, got.items[1], "|", m.made.len, m.made[0], "|", whole[1])

	shown : [4]i64
	shown[0] = 1
	grown : [4]i64
	grown[1] = 1
	grow(&grown)
	print(shown, count(shown), len(shown), "|", grown.len)

	looped : [4]i64
	runs := 0
	for x in looped do runs += 1
	over := 0
	for x in grown do over += 1
	print("loops", runs, over)
}
