module slice_copy_local_neg

//@ expect-fail: `out` is a copy of the immutable param `items`

// A copy of an immutable param's slice is immutable too. Appending to it
// would write into the room past the caller's len, which the caller's list
// never sees (its len doesn't move), and its next append writes over.

use mara.core

grow :: fun(items: []i64) -> i64 {
	out := items
	&out + 1
	return out.len
}

main :: fun() {
	list : [8]i64
	print(grow(list), list.len)
}
