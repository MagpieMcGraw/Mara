module slice_copy_local_neg

//@ expect-fail: `out` is a copy of the immutable param `items`

// A copy of an immutable param's slice is immutable too: writing an item
// through it would write the caller's, which the param promised not to.

use mara.core

grow :: fun(items: []i64) -> i64 {
	out := items
	out[0] = 1
	return out.len
}

main :: fun() {
	list : [8]i64
	print(grow(list), list.len)
}
