module own_fun_beside_group

use mara.core
use mara.math

//@ expect-fail: function 'add' is ambiguous (defined in: own_fun_beside_group, mara.core, mara.math)

// A fun its own module defines beside a dispatch group of that name in a
// module it uses hides nothing, and is not hidden: the bare name means
// neither, and the call says so — here a plain fun beside core's and math's
// `add`, a generic beside math's `min`, a fun in a body beside math's `abs`.
// Said through its scope each works: strict_names. (The own fun used to win
// silently; before that, the groups did.)

add :: fun(a: i64, b: i64) -> i64 { return a + b + 1000 }
min :: fun(a: $T, b: T) -> i64 { return 7 }

main :: fun() {
	abs :: fun(a: []utf8) -> i64 { return 9 }
	print("own:", add(1, 2), min(1, 2), abs("x"))
}
