module addrfixedarr

// `&arr` on a fixed-array local must yield its address (the alloca), so it can
// feed a pointer param — e.g. gl.TexSubImage3D(..., &white). Previously the
// address-of path handled struct/union/slice/scalar idents but not fixed
// arrays, so `&white` hit "cannot take the address of this expression".

use mara.core

// Takes the array by pointer (like a foreign raw-pointer param) and reads it.
read0 :: fun(p: ^[4]u8) -> u8 {
    v : []u8 = slice_from_ptr(p, 4)
    return v[0]
}

main :: fun() {
    white := [4]u8{255, 254, 253, 252}
    print(read0(&white))   // 255 — &arr passed to a pointer param
    print(white[3])        // 252 — the array itself is still usable
}
