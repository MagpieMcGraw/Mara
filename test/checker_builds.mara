module checker_builds
// Constructs the checker builds the graph of as it checks them, which no
// other fixture reached: each lost its builder fallback once the checker's
// graph became mandatory (a graph error), and is built as the builder built
// it now.
//@ expect-output: loop 6 3
//@ expect-output: slice el 2 3
//@ expect-output: len 2 3
//@ expect-output: ops 4 -2
//@ expect-output: fields 3 4
//@ expect-output: if yes 3
//@ expect-output: dispatch 6 6.5
//@ expect-output: text hi mara
//@ expect-output: swizzle 2 1
//@ expect-output: view 4

V2 :: struct {
	x: f64
	y: f64
}
v2_add :: fun(a: V2, b: V2) -> V2 { return V2{x = a.x + b.x, y = a.y + b.y} }
v2_neg :: fun(a: V2) -> V2 { return V2{x = -a.x, y = -a.y} }
overload + add
add :: dispatch{ v2_add }
overload - neg
neg :: dispatch{ v2_neg }

items :: fun() -> [3]i64 { return [1, 2, 3] }
four :: fun() -> [4]i64 { return [1, 2, 3, 4] }
first :: fun(xs: []i64) -> i64 { return xs[0] }

H :: struct { d: [4]i64 }
mk :: fun() -> H { return H{d = [1, 2, 3, 4]} }

two :: fun() -> i64, i64 { return 3, 4 }
S :: struct {
	a, b := two()
}

sum3 :: fun(xs: [3]i64) -> i64 { return xs[0] + xs[1] + xs[2] }
sumf :: fun(xs: [3]f64) -> f64 { return xs[0] + xs[1] + xs[2] }
sumb :: fun(b: bool) -> i64 { return 0 }
sumi :: dispatch{ sum3, sumb }
sumd :: dispatch{ sumf, sumb }

GREET :: "hi"
NAME :: "mara"
greet :: fun() -> [..8]utf8 { return GREET }
name :: fun() -> []utf8 { return NAME }

main :: fun() {
	// A loop over what is no plain place: a call's result, text.
	s : i64 = 0
	for v in items() { s += v }
	n : i64 = 0
	for ch in "abc" { n += 1 }
	print("loop", s, n)

	// A slice of text, of a call's result's field.
	t := "hello"[1:3]
	a := four()
	print("slice", t, first(a[1:3]), mk().d[1:3][1])

	// len of a value; of an if.
	s1 := a[0:2]
	s2 := a[0:3]
	c := false
	print("len", len(a[0:2]), len(if c do s1 else s2))

	// A field of an operator's value.
	p := V2{x = 1, y = 2}
	q := V2{x = 3, y = 4}
	print("ops", (p + q).x, (-p).y)

	// A struct's fields from one call.
	st : S
	print("fields", st.a, st.b)

	// An if of text; of slices, asked for its place.
	ok := true
	msg := if ok do "yes" else "no"
	print("if", msg, len(if ok do s2 else s1))

	// Array literals as a dispatch's arguments.
	print("dispatch", sumi([1, 2, 3]), sumd([1, 2, 3.5]))

	// Text constants returned as a partial array, as a slice.
	print("text", greet(), name())

	// A named array literal out of order.
	w : [3]f32 = [0, 0, 0]
	w = [3]f32{z = 1, x = 2}
	print("swizzle", w[0], w[2])

	// An array's value where a slice param views it.
	print("view", first([4]i64{4, 5, 6, 7}), first(items()) + 3)
}
