module fordo

// `do` single-statement bodies on all four for-loop forms.
main :: fun() {
	// range-for
	sum := 0
	for i in 0..5 do sum += i
	assert(sum == 10)

	// collection-for
	vals : [4]i32 = [1, 2, 3, 4]
	total : i32 = 0
	for v in vals do total += v
	assert(total == 10)

	// while-form (already worked; keep it covered)
	n := 0
	for n < 7 do n += 1
	assert(n == 7)

	// C-style
	acc := 0
	for k := 0; k < 4; k += 1 do acc += k
	assert(acc == 6)

	// block bodies still parse
	count := 0
	for i in 0..3 {
		count += 1
	}
	assert(count == 3)

	print("fordo ok")
}
