module compositor_wait

use mara.core
os :: use mara.os

//@ expect-output: waited: true

// mara.os's compositor_wait on Windows: DwmFlush, back within a few refreshes.

main :: () {
	start := os.clock_ns()
	er := os.compositor_wait()
	took := os.clock_ns() - start
	print("waited:", not er and took < 1000000000)
}
