module void_ptr_store_neg

//@ expect-fail: cannot store `void` in

// A pointer always points at something that exists in the program. `void`
// only de-initializes a variable (see void_ptr_deinit_neg) or passes a C
// function a null. Stored anywhere else a pointer goes, it would be a null
// pointer by another name — each of these is an error.

H :: struct {
	n: i64
	p: ^i64
	q: ^i64 = void                   // a field's value
}

Box :: struct(p: ^i64) {
	q: ^i64 = p
	get :: fun(self: ^Self, r: ^i64) -> ^i64 { return r }
}

Opt :: union {
	Some { value: ^i64 }
	None {}
}

find :: fun(q: ^i64, want: bool) -> ^i64 {
	if want do return q
	return void                      // a return value
}

use_p :: fun(p: ^i64) -> i64 { return p^ }
dflt :: fun(p: ^i64 = void) -> i64 { return 1 }   // a parameter's default

pick :: fun(x: ^i64, c: bool) -> ^i64 {
	r := if c do x else void         // a branch of an if-expression
	return r
}

main :: fun() {
	x := 5
	h := H{n = 1, p = void}          // a literal field
	h.p = void                       // a field store
	arr : [2]^i64 = {&x, void}       // an array element
	arr[1] = void                    // an element store
	pp := &h.p
	pp^ = void                       // a store through a pointer
	print(use_p(void))               // an argument
	o : Opt = Some{value = void}     // a variant's field
	bx := Box(void)                  // a constructor's argument
	bp := &bx
	r := bp.get(void)                // a method's argument
	f : fun(^i64) -> i64 = use_p
	print(f(void))                   // an argument through a function value
	print(find(&x, true)^, h.n, arr[0]^, dflt(&x), pick(&x, true)^, r^)
}
