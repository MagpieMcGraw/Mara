module dropped_join_chain_neg

//@ expect-fail: the value of 'dir ++ "/" ++ file' is dropped, and 'dir' is as it was: an operator changes only what it's given a pointer to (`&dir ++ "/" ++ file`)

// A chain of joins dropped: the message names the list the chain starts
// from, and the chain of appends that was meant.

use mara.core

main :: fun() {
	dir : str64
	&dir ++ "code"
	file := "main.mara"
	dir ++ "/" ++ file
	print(dir)
}
