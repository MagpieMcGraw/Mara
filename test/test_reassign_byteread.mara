module test_reassign_byteread

// off16 = #big_endian buf[0] as a REASSIGNMENT (not decl-init): set len first,
// then reinterpret-read via index. User's expectation: index read leaves len
// alone (overread into backing storage is fine), so the loop iterates `n`.

read_into :: fun(n: i32, buf: []byte) {
    off16 : [..16]u16          // cap 16 -> reads 32 bytes, within buf's 64
    off16.len = n
    off16 = #big_endian buf[0]
    print("reassign index-read -> len:", off16.len, "cap:", off16.cap)
    for v, i in off16 {
        print("  ", i, ":", i32(v))
    }
}

main :: fun() -> i64 {
    buf : [..64]byte
    buf.len = 64
    for i in 0..32 {
        buf[i*2]     = u8(0)
        buf[i*2 + 1] = u8(i + 1)
    }
    read_into(5, buf[:])   // big-endian (0, i+1) => value i+1; want len 5, values 1..5
    return 0
}
