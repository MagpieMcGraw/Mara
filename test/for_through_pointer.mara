module for_through_pointer

//@ expect-output: list 6 | fixed 15 | view 5
//@ expect-output: | indexed 0:1 1:2 2:3
//@ expect-output: from a call 6 | struct's 30
//@ expect-output: | kept 3 4

// A for loop sees through one pointer to what it walks — a list, a fixed
// array, a view — as indexing and fields do: `for f in files`, files a
// `^[]T`, walks the caller's list (`files^` still works). The items are
// copies, as ever; `files[i] = …` writes the caller's.

use mara.core
use mara.string

sum_list :: (xs: ^[]i64) i64 {
	s : i64 = 0
	for x in xs { s += x }
	return s
}

sum_fixed :: (xs: ^[5!]i64) i64 {
	s : i64 = 0
	for x in xs { s += x }
	return s
}

sum_view :: (xs: ^[]i64) i64 {
	s : i64 = 0
	for x in xs^ { s += x }
	return s
}

indexed :: (xs: ^[]i64) {
	line : [64]utf8
	&line + "| indexed"
	for x, i in xs {
		&line + ' '
		&line + int_text(i)
		&line + ':'
		&line + int_text(x)
	}
	print(line)
}

Bag :: struct {
	items: [8]i64
}

the_list :: (b: ^Bag) ^[]i64 { return &b.items }

// Each item, kept and its double added after — the loop walks the items
// there when it began.
keep_doubled :: (xs: ^[$N]i64) {
	for x in xs {
		if x < 3 do xs + x * 2
	}
}

main :: () {
	list : [8]i64
	&list + 1
	&list + 2
	&list + 3
	five : [5!]i64 = {1, 2, 3, 4, 5}
	view := list[1 : 3]
	print("list", sum_list(&list), "| fixed", sum_fixed(&five), "| view", sum_view(&view))
	indexed(&list)
	b : Bag
	&b.items + 10
	&b.items + 20
	total : i64 = 0
	for x in the_list(&b) { total += x }
	print("from a call", sum_list(&list), "| struct's", total)
	kept : [8]i64
	&kept + 1
	&kept + 5
	keep_doubled(&kept)
	print("| kept", kept.len, kept[2] + kept[1] - 3)
}
