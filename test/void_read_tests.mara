module void_read_tests

//@ expect-output: tests: 3 0 4 0 3 6 3 3
//@ expect-output: refs: true false true
//@ expect-output: values: -1 2 true

// Each way a test says a value isn't void, so a read through it is fine:
// `!=` and `==` with an early return, `and`, `or`, `not`, a loop's
// condition, an assert, a field reference tested (from_text's too), a fun
// used as a value testing what a call through one gives.

Node :: struct {
	x: i64
	next: ^Node
}

State :: struct { quit: bool  a: bool }
Flag :: alias State.bool

both :: fun(p: ^Node, q: ^Node) -> i64 {
	if p != void and q != void { return p.x + q.x }
	return 0
}

early :: fun(p: ^Node, q: ^Node) -> i64 {
	if p == void or q == void do return 0
	return p.x + q.x
}

negated :: fun(p: ^Node) -> i64 {
	if not (p == void) { return p.x }
	return 0
}

total :: fun(p: ^Node) -> i64 {
	n := p
	sum := 0
	for n != void {
		sum += n.x
		n = n.next
	}
	return sum
}

asserted :: fun(p: ^Node) -> i64 {
	assert(p != void)
	return p.x
}

held :: fun(p: ^Node) -> i64 {
	// (A field compared, then read: the test holds till it's written.)
	if p.next != void do return p.next.x
	return p.x
}

// (Used as a value, which a call gives void: tested.)
or_none :: fun(p: ^Node) -> i64 {
	if p == void do return -1
	return p.x
}

// (Used as a value, never given void: read as it is. Of or_none's signature,
// it would be tested too: any fun used as a value of the signature a call
// gives void may be the one called.)
plain :: fun(p: ^Node) -> bool { return p.x > 0 }

main :: fun() {
	a := Node{x = 1, next = void}
	b := Node{x = 2, next = &a}
	print("tests:", both(&a, &b), both(&a, void), early(&b, &b), early(void, &a), total(&b), total(&b) * 2, asserted(&b) + negated(&a), held(&b) + 2)
	s := State{all 0}
	g := Flag.from_text("a")
	if g != void do s[g] = true
	k : State.bool = void
	if k != void do s[k] = true
	m := Flag.from_text("nope")
	if m != void do s[m] = true
	print("refs:", s.a, s.quit, k == void)
	f : fun(^Node) -> i64 = or_none
	h := plain
	print("values:", f(void), f(&b), h(&a))
}
