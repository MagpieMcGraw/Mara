module test_chained_rvo

use test_chained_rvo_helpers

main :: fun() -> i64 {
	// Pure chain — should be pure forwarding (already verified).
	r := level_a()
	print(r.x)         // 10
	print(r.y)         // 20

	// Modify-each-level struct chain.
	m := mod_a()
	print(m.x)         // 101 (100 + 1)
	print(m.y)         // 400 (200 * 2)

	storage : [..512]byte

	sl := sl_a(&storage)
	print(sl[0])       // 100
	print(sl[1])       // 200
	print(sl[2])       // 300

	storage2 : [..512]byte
	sm := sl_mod_a(&storage2)
	print(sm[0])       // 11 (1 + 10)
	print(sm[1])       // 2
	print(sm[2])       // 300 (3 * 100)

	a := arr_a()
	print(a[0])        // 1
	print(a[1])        // 2
	print(a[2])        // 3

	am := arr_mod_a()
	print(am[0])       // 11 (10 + 1)
	print(am[1])       // 20
	print(am[2])       // 60 (30 * 2)

	return 0
}
