module field_ref_owner_neg

use mara.core

//@ expect-fail: is a field of S, not of Other

// A field reference indexes only its own struct.

Inner :: struct { x: f32 }
Other :: struct { y: f32 }
Key :: union { None = 0  A = 1 }
S :: struct {
	inner: Inner
	p: ^Inner
	list: [4]i64
	items: []i64
	fixed: [4!]i64
}

main :: fun() {
	o := Other{y = 1}
	f := S.inner.x
	print(o[f])
}
