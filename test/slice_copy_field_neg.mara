module slice_copy_field_neg

//@ expect-fail: `lexer.tokens` is a copy of the immutable param `tokens_in`

// A class keeps its immutable param in a field, and another fun writes into
// the field (mara3's lexer, 2026-10-27, appended to it): the field is a copy
// of the param, so it's immutable too.

use mara.core

Lexer :: class (tokens_in: []i64) {
	tokens := tokens_in
}

lex :: fun(lexer: ^Lexer) {
	lexer.tokens[0] = 7
}

main :: fun() {
	tokens : [16]i64
	lexer := Lexer(tokens)
	lex(&lexer)
	print(tokens.len)
}
