module slicefield

// Two regressions found via `glyf := bytes[lo:hi]` in the TTF constructor:
//
// 1. An UNANNOTATED constructor-body decl whose value is a slice expression
//    is a FIELD whose type must be inferred (top-level ctor decls are fields).
//    infer_field_type_from_default had no Expr_Slice branch, so `view :=
//    bytes[2:5]` fell through to Type_Any and codegen panicked
//    (llvm_type_from_checker) instead of typing the field []byte. Now it
//    infers []elem, auto-dereffing a ^[]T / ^[N]T base like check_slice does.
//
// 2. A slice value as a struct-literal field value (`Wrap{data = view}`) must
//    store the {len,cap,ptr} aggregate, not the header alloca POINTER — invalid
//    IR clang rejected ("'%t' defined with type 'ptr' but expected
//    '{ i64, i64, ptr }'"). Routed through gen_slice_value_ptr + header memcpy.
//    (This originally exercised the positional pure-struct ctor `Wrap(view)`,
//    since removed: pure-data structs take no positional args — only `Wrap()` /
//    `Wrap{...}` literals. Brace field values hit the same slice-store logic.)

Holder :: struct (bytes: ^[]byte) {
	Wrap :: struct {
		data: []byte
	}

	view := bytes[2:5]           // 1: inferred slice-expr field → []byte
	head := view[0:1]            // 1: slice of an already-typed sibling field
	wrap := Wrap{data = bytes[3:6]}  // 2: slice expr as struct-literal field value
	lit  := Wrap{data = view}        // slice var via struct-literal field value
}

main :: fun() {
	buf : [..8]byte
	buf.len = 8
	for i in 0..7 {
		buf[i] = u8(i * 10)
	}
	h := Holder(&buf)
	assert(h.view.len == 3)
	assert(h.view[0] == 20)
	assert(h.view[2] == 40)
	assert(h.head.len == 1)
	assert(h.head[0] == 20)
	assert(h.wrap.data.len == 3)
	assert(h.wrap.data[0] == 30)
	assert(h.lit.data.len == 3)
	assert(h.lit.data[2] == 40)

	// 2, outside any ctor: slice VAR and slice EXPR as struct-literal field values.
	view := buf[2:5]
	a := Wrap2{data = view}
	assert(a.data.len == 3)
	assert(a.data[0] == 20)
	b := Wrap2{data = buf[2:5]}
	assert(b.data.len == 3)
	assert(b.data[2] == 40)
	print("slicefield ok")
}

Wrap2 :: struct {
	data: []byte
}
