module process_pipe_read

use mara.core
use mara.os

// pipe_read: a child's output read without waiting. Until the child has its
// whole input it writes nothing, so a read then gets 0 bytes, the pipe still
// open — a read that waited would never return. After, reads take what has
// arrived until the pipe ends (false), and the child's exit code follows.

//@ expect-output: before: 0 bytes, open true
//@ expect-output: got: child got: ping
//@ expect-output: ended, exit 5

main :: fun(args: [][]utf8) -> i64 {
	if args.len > 1 {
		// The child: its whole input, then an answer.
		got : [200]byte
		chunk : [64!]byte
		room := chunk[:]
		for true {
			piece, e := file_read(standard_input(), &room)
			if bool(e) or piece.len == 0 do break
			&got + piece
		}
		text : []utf8 = got
		print("child got:", text)
		return 5
	}
	command : str256
	&command + "\""
	&command + args[0]
	&command + "\" child"
	p, e := process_start(command)
	if bool(e) {
		print("start failed:", e)
		return 1
	}
	chunk : [64!]byte
	room := chunk[:]
	early, open, re := pipe_read(p.output, &room)
	if bool(re) {
		print("read failed:", re)
		return 1
	}
	print("before:", early.len, "bytes, open", open)

	message := "ping"
	bytes : []byte = message
	_, we := file_write(p.input, bytes)
	if bool(we) {
		print("write failed:", we)
		return 1
	}
	process_close_input(&p)
	out : [400]byte
	for true {
		piece, still, re2 := pipe_read(p.output, &room)
		if bool(re2) {
			print("read failed:", re2)
			return 1
		}
		&out + piece
		if not still do break
	}
	text : []utf8 = out
	print("got:", text)
	code, xe := process_wait(&p)
	if bool(xe) {
		print("wait failed:", xe)
		return 1
	}
	print("ended, exit", code)
	return 0
}
