module test_compound_eval

// Each call returns counter.n then increments it. If `arr[bump(...)] *= 10`
// evaluates the LHS once, bump runs once and counter.n ends at 1. If it
// runs twice, counter.n ends at 2 and the write hits the wrong slot.

Counter :: struct {
	n : i64
}

bump :: fun(c: ^Counter) -> i64 {
	v := c.n
	c.n = v + 1
	return v
}

test_compound_eval :: fun() {
	print("=== test_compound_eval ===")
	arr : [4]i64
	arr[0] = 10
	arr[1] = 20
	arr[2] = 30
	arr[3] = 40

	counter : Counter

	arr[bump(&counter)] *= 10

	// Expected (single-eval): counter.n == 1, arr[0] == 100, arr[1] == 20
	// If double-eval: counter.n == 2, arr[0] == 10,  arr[1] == 200
	print(counter.n)
	print(arr[0])
	print(arr[1])
	print("=== test_compound_eval passed ===")
}
