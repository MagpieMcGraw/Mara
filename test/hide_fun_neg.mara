module hide_fun_neg

//@ expect-fail: variable 'filter' would hide the fun 'filter'

// A variable may not take the name of a fun in sight, its own module's or
// one it uses (mara.core's filter here): the fun would be out of reach
// below it, and nothing would say so. A field may (hide_ok).

use mara.core

main :: fun() {
	filter := 3
	print(filter)
}
