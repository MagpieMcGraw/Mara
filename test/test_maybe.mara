module test_maybe

use mara.maybe

unwrap_or_zero :: fun(m: Maybe(i64)) -> i64 {
	match m {
	None
		return 0
	Some s
		return s.value
	}
}

Box :: struct {
	x: i64
}

deref_or_neg :: fun(m: Maybe(^Box)) -> i64 {
	match m {
	None
		return -1
	Some s
		return s.value.x
	}
}

test_maybe :: fun() {
	print("=== test_maybe ===")
	a : Maybe(i64) = Some{value = 42}
	b : Maybe(i64) = None{}
	print(unwrap_or_zero(a))  // 42
	print(unwrap_or_zero(b))  // 0

	box : Box
	box.x = 7
	p : Maybe(^Box) = Some{value = &box}
	q : Maybe(^Box) = None{}
	print(deref_or_neg(p))    // 7
	print(deref_or_neg(q))    // -1
	print("=== test_maybe passed ===")
}
