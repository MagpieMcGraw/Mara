	print(">>>> START <<<<")
	print("
            === Arena out of memory ===

            Arena capacity: % bytes
            Bytes used:     % bytes
            Bytes free:     % bytes

            Failed allocation: %, % bytes in %

            --- All allocations (most recent first) ---
            ", 1, 2, 3, "x", 5, "y")
	print(">>>> END <<<<")
}

