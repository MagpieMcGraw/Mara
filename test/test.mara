	cp := 1024
	us := 768
	print("
        === test fmt ===
        Capacity:  % bytes
        Used:      % bytes
        Free:      % bytes
        ", cp, us, cp - us)
}

GLYPHS :: " .,-~:;=!*#$@"

test_const_string_index :: fun() {
	for i in 0..13 {
		row : [1]utf8
		row[0] = GLYPHS[i]
		print(row)
	}
}

test_sentinel_append :: fun() {
	empty : str
	print(empty)
	one : str
	&one + "Escaping..."
	print(one)
	many : str
	&many + "ab"
	&many + "cd"
	&many + "ef"
	print(many)
	sized : [:64, 0]utf8
	&sized + "from sized"
	print(sized)
	grt : str = "hello"
	print(grt)
	&grt + " world"
	print(grt)
}

with_two :: fun(a: i64 = 10, b: i64 = 20) -> i64 {
	return a + b
}

with_three :: fun(a: i64, b: i64 = 5, c: i64 = 7) -> i64 {
	return a * 100 + b * 10 + c
}

Point3 :: struct {
	x: i64 = 100
	y: i64 = 200
	z: i64 = 300
}

disp_helper_int :: fun(a: i64 = 1, b: i64) -> i64 {
	return a * 1000 + b
}

disp_helper_bool :: fun(a: i64 = 2, b: bool) -> i64 {
	return a * 2000
}

disp :: dispatch {
	disp_helper_int
	disp_helper_bool
}

disp_trail_int :: fun(a: i64, b: i64 = 10) -> i64 {
	return a * 100 + b
}

disp_trail_bool :: fun(a: bool, b: i64 = 20) -> i64 {
	return b
}

disp_trail :: dispatch {
	disp_trail_int
	disp_trail_bool
}

test_underscore_default :: fun() {
	print(with_two(1, 2))      // 3
	print(with_two(_, 2))      // 12
	print(with_two(1, _))      // 21
	print(with_two(_, _))      // 30
	print(with_three(1, _, 9)) // 159
	print(with_three(2, _, _)) // 257
	a : Point3 = Point3(10, 20, 30)
	print(a.x)                 // 10
	print(a.z)                 // 30
	b : Point3 = Point3(_, 7, _)
	print(b.x)                 // 100
	print(b.y)                 // 7
	print(b.z)                 // 300
	print(disp(_, 5))          // 1005
	print(disp(_, true))       // 4000
	print(disp_trail(5))       // 510
	print(disp_trail(true))    // 20
	print(disp_trail(5, 7))    // 507
}

// ============================================================================
// sized reinterpret read (slice form, destination-bounded partial fill)
// ============================================================================

Sized_Rec :: struct {
	a : i32
	b : i32
	c : i32
}

Sized_Glyph :: struct {
	n   : i16
	pad : i16
	pts : [..8]i32
}

test_sized_read :: fun() {
	buf : [..16]byte
	buf.len = 16
	i : i32 = 0
	for i < 16 {
		buf[i] = u8(0)
		i += 1
	}
	buf[3] = u8(1)
	buf[7] = u8(2)

	// Exact span (12 == sizeof(Sized_Rec)).
	full : Sized_Rec = #big_endian buf[0:12]
	assert(full.a == 1)
	assert(full.b == 2)
	assert(full.c == 0)

	// Short span (8 < 12): a,b filled, c keeps its zero-init.
	part : Sized_Rec = #big_endian buf[0:8]
	assert(part.a == 1)
	assert(part.b == 2)
	assert(part.c == 0)

	// Omitted high (= cap). cap 8 < sizeof -> partial fill.
	buf8 : [..8]byte
	buf8.len = 8
	j : i32 = 0
	for j < 8 {
		buf8[j] = u8(0)
		j += 1
	}
	buf8[3] = u8(5)
	buf8[7] = u8(6)
	whole : Sized_Rec = #big_endian buf8[0:]
	assert(whole.a == 5)
	assert(whole.b == 6)
	assert(whole.c == 0)

	// Struct with a [..N]T field: the partial-array header must come out
	// stamped (cap=N), not zeroed, after a sized read of the leading fields.
	gh : Sized_Glyph = #big_endian buf[0:4]
	assert(gh.pad == 1)         // bytes 2..3 = 00 01 (buf[3]=1), big-endian
	assert(gh.pts.cap == 8)     // stamped, NOT 0
	gh.pts.len = 2
	gh.pts[0] = 100
	gh.pts[1] = 200
	assert(gh.pts[0] == 100)
	assert(gh.pts[1] == 200)

	print("sized read ok")
}

