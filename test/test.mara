	arena : Arena_Debug = Arena_Debug(1 * KB)
	ap : ^Arena_Debug = &arena
	buf : []byte = ap.alloc(32)
	print(buf.len)   // 32
	buf2 : []byte = ap.alloc(64)
	print(buf2.len)  // 64
}

