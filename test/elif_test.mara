module elif_test

use mara.memory

main :: fun() -> i64 {
	this_program = Program(Arena_Debug(1 * MB))
	x : i32 = 5

	// elif chain (the new chain keyword)
	if x > 10 {
		print("big")
	elif x > 3
		print("medium")
	else
		print("small")
	}

	// `else` whose body starts with a nested `if` — used to be a parse error
	// (read as `else if`); now `elif` owns the chain, so this is unambiguous.
	if x > 100 {
		print("huge")
	else
		if x > 3 {
			print("nested-if-in-else works")
		}
	}
	return 0
}
