module comptime_int_ops

//@ expect-output: xor 5
//@ expect-output: not 3
//@ expect-output: masks 14

// An array's size folds every integer operator: xor (`~`, binary) and
// bitwise not (`~`, unary) among them, through constants too.

MASK :: 0xF0 | 0x0F
N :: (MASK ~ 0xF8) << 1

main :: fun() {
	a : [6 ~ 3!]i64
	print("xor", a.len)
	b : [~(-4)!]i64
	print("not", b.len)
	c : [N!]i64
	print("masks", c.len)
}
