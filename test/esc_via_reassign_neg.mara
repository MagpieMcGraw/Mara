module esc_via_reassign_neg
//@ expect-fail: `leaf(...)`: its return may reference local memory via parameter `storage`

// The callee's returned local is written twice; both writes view `storage`, so
// its summary still ties the result to param 0. `outer` passes a local buffer
// and returns the result.

leaf :: fun(storage: ^[_]byte) -> []i64 {
	out := slice([:3]i64, storage)
	out = slice([:3]i64, storage)
	return out
}

outer :: fun() -> []i64 {
	storage : [512]byte
	return leaf(&storage)
}

main :: fun() {
	sl := outer()
	print(sl[0])
}
