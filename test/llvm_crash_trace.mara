module llvm_crash_trace
//@ build-flags: -llvm
//@ expect-output: llvm_crash_trace.mara:29:11 runtime error: index 6 out of bounds [0, 4) for 'xs'
//@ expect-output: at pick (llvm_crash_trace.mara:29)
//@ expect-output: at ping (llvm_crash_trace.mara:20)
//@ expect-output: at pong (llvm_crash_trace.mara:25)
//@ expect-output: at ping (llvm_crash_trace.mara:21)
//@ expect-output: ... the 2 calls above, 2 more times
//@ expect-output: at main (llvm_crash_trace.mara:34)
//@ expect-exit: 1

// A failure's report in an LLVM build: the calls that were running, named
// by its debug info (llvm_dbg.odin) as the x86 backend's are.

use mara.core

Point :: struct { x: i64  y: f32 }

ping :: fun(n: i64, p: Point, xs: []i64) -> i64 {
	if n == 0 do return pick(xs, p.x)
	return pong(n - 1, p, xs) + 1
}

pong :: fun(n: i64, p: Point, xs: []i64) -> i64 {
	return ping(n, p, xs) + 1
}

pick :: fun(xs: []i64, i: i64) -> i64 {
	return xs[i * 2]
}

main :: fun() {
	xs := [1, 2, 3, 4]
	print(ping(3, Point{x = 3}, xs[:]))
}
