module usedef

// step 1: sibling-scope shadowing — the two `y` are distinct bindings
shadow :: fun(x: i64) -> i64 {
	total := x
	if x > 0 {
		y := x + 1
		total = total + y
	else
		y := x - 10
		total = total + y
	}
	return total
}

// step 2: a branch-merge (`a` reaches BOTH branch defs) and a loop back-edge
// (`b` inside the loop reaches the previous iteration's def)
flow :: fun(p: i64) -> i64 {
	a := p
	if p > 0 {
		a = p + 1
	else
		a = p + 2
	}
	b := a
	for i in 0..p {
		b = b + i
	}
	return b
}

// step 3: interprocedural backward slice. `pick_first` returns its FIRST param,
// so its return_args = {0}: `dead` does not contribute.
pick_first :: fun(a: i64, b: i64) -> i64 {
	dead := b + 1
	return a
}

// Slicing `caller`'s return must include `x` and the call, but NOT `y` (the
// callee ignores it) and NOT `junk` (dead w.r.t. the return).
caller :: fun(x: i64, y: i64) -> i64 {
	r := pick_first(x, y)
	junk := y * 100
	return r
}

// step 4: control dependence. `c` never flows into `r`, but it decides WHICH
// branch assigns `r`, so changing it changes the result — it must show up as a
// (control) contributor, pulled in by the `if` that guards `r`'s definitions.
guarded :: fun(p: i64, c: i64) -> i64 {
	r := 0
	if c > 0 {
		r = p * 2
	else
		r = p * 3
	}
	return r
}

main :: fun() {
	s := shadow(3)
	f := flow(s)
	c := caller(f, 7)
	g := guarded(c, s)
}
