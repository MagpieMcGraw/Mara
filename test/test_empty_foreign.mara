module test_empty_foreign

// Empty foreign block: declares a link-only dependency on a system library
// (kernel32 on Windows, libm on Linux) without binding any symbols from it.
// Used by raylib-style bindings to pull in system libs that raylib's own
// symbols transitively need.
#if #windows {
	foreign static_lib "kernel32" {}
}
#if #linux {
	foreign static_lib "m" {}
}

main :: fun() -> i64 {
	return 0
}
