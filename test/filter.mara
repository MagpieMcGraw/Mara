module filter

use mara.core
use mara.string

//@ expect-output: evens: 0 2 4 6 8 | 5
//@ expect-output: storage: 80
//@ expect-output: big: 7 8 9 | 3
//@ expect-output: storage after both: 160
//@ expect-output: words: apple avocado | 2
//@ expect-output: none: 0 240
//@ expect-output: empty: 0 240
//@ expect-output: structs: b 2 d 4 | 2

// filter: the items its function says yes to, in order, into storage after
// what's there (room for all the items taken: 80 bytes for 10 i64s) — two
// filters one after the other in one storage, text items, structs, nothing
// kept, no items at all.

is_even :: fun(n: i64) -> bool { return n % 2 == 0 }
is_big :: fun(n: i64) -> bool { return n > 6 }
never :: fun(n: i64) -> bool { return false }
starts_a :: fun(s: []utf8) -> bool { return starts_with(s, "a") }

Pair :: struct {
	name: [8]utf8
	n: i64
}
is_even_pair :: fun(p: Pair) -> bool { return p.n % 2 == 0 }

main :: fun() {
	storage : [512]byte
	nums : [10!]i64
	for k in 0 .. 10 {
		nums[k] = k
	}

	evens := filter(nums[:], is_even, &storage)
	print("evens: % % % % % | %", evens[0], evens[1], evens[2], evens[3], evens[4], evens.len)
	print("storage:", storage.len)

	big := filter(nums[:], is_big, &storage)
	print("big: % % % | %", big[0], big[1], big[2], big.len)
	print("storage after both:", storage.len)

	words : [4!][]utf8 = {"apple", "pear", "avocado", "fig"}
	text_room : [256]byte
	a_words := filter(words[:], starts_a, &text_room)
	print("words: % % | %", a_words[0], a_words[1], a_words.len)

	none := filter(nums[:], never, &storage)
	print("none:", none.len, storage.len)

	nothing : []i64 = nums[0 : 0]
	empty := filter(nothing, is_even, &storage)
	print("empty:", empty.len, storage.len)

	pairs : [4]Pair
	for name, k in "abcd" {
		p : Pair
		&p.name + name
		p.n = k + 1
		&pairs + p
	}
	pair_room : [512]byte
	kept := filter(pairs[:], is_even_pair, &pair_room)
	print("structs: % % % % | %", kept[0].name[:], kept[0].n, kept[1].name[:], kept[1].n, kept.len)
}
