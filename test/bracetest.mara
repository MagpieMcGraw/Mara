module bracetest

// Pins down which positions accept a `{...}` struct literal. The one
// remaining gap is the copy form `new := var{...}`, which is a hard error
// (test_fail has the negative) -- copy first, then override in place.

Metrics :: struct {
	x, y, z : f32
}

make :: fun() -> Metrics {
	// bare literal in return position, typed by the declared return
	return {4, 5, 6}
}

eat :: fun(m: Metrics) -> f32 {
	return m.y
}

Holder :: struct {
	m : Metrics
	val : i32

	Inner :: struct {
		a, b : i32
	}
	inner : Inner
}

main :: fun() -> i64 {
	h : Holder

	// 1. bare positional literal into a typed field
	h.m = {1, 2, 3}
	assert(h.m.y == 2)

	// 2. bare named literal into a typed field
	h.m = {x = 4, y = 5, z = 6}
	assert(h.m.z == 6)

	// 3. named-type literal, top-level type, := decl
	m1 := Metrics{7, 8, 9}
	assert(m1.x == 7)

	// 4. annotated decl with a bare literal
	m2 : Metrics = {1, 2, 3}
	assert(m2.x == 1)

	// 5. construct + override
	m3 := Metrics(){10, 11, 12}
	assert(m3.z == 12)

	// 6. nested type path WITH parens (the form that parses today)
	h.inner = Holder.Inner(){1, 2}
	assert(h.inner.b == 2)

	// 7. in-place var override
	m2{y = 99}
	assert(m2.y == 99)
	assert(m2.x == 1)

	// 8. zero init
	h.m = {0}
	assert(h.m.x == 0)

	// 9. bare literal in return position
	m4 := make()
	assert(m4.z == 6)

	// 10. dotted type path WITHOUT parens (named literal, qualified name)
	h.inner = Holder.Inner{3, 4}
	assert(h.inner.a == 3)
	i2 := Holder.Inner{5, 6}
	assert(i2.b == 6)

	// 11. bare literal in call-argument position (param type propagates)
	got := eat({1, 2, 3})
	assert(got == 2)
	got2 := eat({x = 7, y = 8, z = 9})
	assert(got2 == 8)

	// 12. named literal in call-argument position
	got3 := eat(Metrics{0, 5, 0})
	assert(got3 == 5)

	print("bracetest ok")
	return 0
}
