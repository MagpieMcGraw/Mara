module field_ref_list_neg

use mara.core

//@ expect-fail: can't go into

// A field reference can't go into a list: its items aren't the struct's own.

Inner :: struct { x: f32 }
Other :: struct { y: f32 }
Key :: union { None = 0  A = 1 }
S :: struct {
	inner: Inner
	p: ^Inner
	list: [4]i64
	items: []i64
	fixed: [4!]i64
}

main :: fun() {
	f := S.list[0]
	print(f)
}
