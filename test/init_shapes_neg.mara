module init_shapes_neg
//@ expect-fail: 'p' may be void here

// A read the void check must reject: void on a loop's back edge. (A field a
// braces literal never gave is its zero, void for a pointer: comparing it
// is fine.)

Node :: struct { next : ^Node  val : i64 }

unset_on_the_back_edge :: fun(src: ^i64) {
	p := src
	for i in 0:3 {
		print(p^)            // the second time round, p is void
		p = void
	}
}

inferred_literal :: fun() {
	n := Node{val = 1}
	m := n.next              // next was never given
	print(m == void)
}

main :: fun() {
	v := 5
	unset_on_the_back_edge(&v)
	inferred_literal()
}
