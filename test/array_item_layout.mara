module array_item_layout

use mara.core

// An array goes where a buffer of its items goes only when its items are
// laid out as that buffer's are. A literal is made as the items it goes to:
// text where slices go, slices of it; short rows where longer fixed rows
// go, the rest zero. (Arrays of lists into slices of slices:
// array_item_layout_neg, array_item_rows_neg, array_item_decl_neg.)

NAMES :: [2!][]utf8{"walk", "Mouse_Left"}

first :: fun(names: [][]utf8) {
	print("count % first % second %", names.len, names[0], names[1])
}
rows :: fun(r: [][4!]i64) {
	print("rows % first % % % % second % % % %", r.len, r[0][0], r[0][1], r[0][2], r[0][3], r[1][0], r[1][1], r[1][2], r[1][3])
}
views :: fun(r: [][]i64) {
	print("views % first % % second %", r.len, r[0][0], r[0][1], r[1][0])
}

main :: fun() {
	first(["walk", "run"])
	first(NAMES)
	local := [2!][]utf8{"jump", "swim"}
	first(local)
	a : [64]utf8 = "list a"
	b : [64]utf8 = "list b"
	first([a, b])
	s : [8][]utf8
	s.len = 2
	s[0] = "x"
	s[1] = "yy"
	first(s)
	x : [2!][4!]i64 = [[1, 2], [3, 4]]
	rows(x)
	rows([[5, 6], [7, 8, 9]])
	views([[1, 2], [3]])
	texts : [2!][64]utf8 = ["c", "dd"]
	print("texts % %", texts[0], texts[1])
}

//@ expect-output: count 2 first walk second run
//@ expect-output: count 2 first walk second Mouse_Left
//@ expect-output: count 2 first jump second swim
//@ expect-output: count 2 first list a second list b
//@ expect-output: count 2 first x second yy
//@ expect-output: rows 2 first 1 2 0 0 second 3 4 0 0
//@ expect-output: rows 2 first 5 6 0 0 second 7 8 9 0
//@ expect-output: views 2 first 1 2 second 3
//@ expect-output: texts c dd
