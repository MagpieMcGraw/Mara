module file_var_hides_neg

//@ expect-fail: 'helper' here is both the variable declared at

// A variable at a file's top named as a fun in sight, read there by its
// name alone: it means both, as a local's would. (main doesn't see it: its
// `helper()` is the fun's.)

use mara.core

helper := 5
twice := helper * 2

helper :: fun() -> i64 { return 1 }

main :: fun() {
	print(helper())
}
