module dispatch_tie_neg
//@ expect-fail: ambiguous dispatch 'pair'

// Two members, each closer on one argument and farther on the other: no
// member is closest — ambiguous. (A cast picks one.)

pair_a :: fun(x: i32, y: i64) {}
pair_b :: fun(x: i64, y: i32) {}
pair :: dispatch{ pair_a, pair_b }

main :: fun() {
	p : i16 = 1
	q : i16 = 2
	pair(p, q)
}
