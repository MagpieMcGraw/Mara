module askcalls

// Fixture for what `mara ask` says of a fun or a field by name: a fun's signature
// and doc comment, call trees one level unless asked, each row where it's defined
// and each first-level call where it's written. Queried by test/ask_queries.txt.

// A box, with a size that changes.
Box :: struct {
	size: i64
	count: i64
	left_only: i64
}

Bag :: struct {
	count: i64
}

Pair :: struct($T: type) {
	first: T
	second: T
}

// The bottom of the tree.
leaf :: fun(n: i64) -> i64 {
	return n + 1
}

// Calls leaf twice on one line and once on another.
middle :: fun(n: i64) -> i64 {
	a := leaf(n) + leaf(n + 1)
	return a + leaf(2)
}

// Written over lines, with no doc comment's blank line kept:
//
// it has two paragraphs.
long_signature :: fun(
	first: i64,
	second: i64,   // (a comment beside it)
) -> i64 {
	return middle(first) + second
}

other_top :: fun() -> i64 {
	return middle(7)
}

// Called only through a default argument of with_default.
default_value :: fun() -> i64 {
	return 3
}

with_default :: fun(n: i64 = default_value()) -> i64 {
	return n
}

pick :: fun($T: type, a: T, b: T) -> T {
	return a
}

no_doc :: fun() -> i64 {
	return pick(1, 2) + i64(pick(f32(1), f32(2)))
}

grow :: fun(box: ^Box) {
	box.size += 1
}

main :: fun() {
	box := Box{size = 1, count = 2, left_only = 3}
	bag := Bag{count = 4}
	grow(&box)
	pair : Pair(i64) = {first = 5, second = 6}
	print(long_signature(1, 2), other_top(), with_default(), no_doc(), box.size, box.count, box.left_only, bag.count, pair.first, pair.second)
	second_main(&box)
}

// Says what it's given, by its kind.
note_it :: dispatch { note_text, note_number }

note_text :: fun(text: []utf8) -> i64 {
	return text.len
}

note_number :: fun(n: i64) -> i64 {
	return note_text("a number") + n
}

// Its budget only decides: three branches, through a local for one, and nothing
// it computes.
decide :: fun(budget: i64, start: i64) -> i64 {
	limit := budget
	if start > budget do return 1
	for k in 0:3 {
		if k > limit do break
	}
	if budget == 2 do return 2
	return 3
}

only_printed :: fun(shown: i64) {
	print(shown)
}

never_used :: fun(idle: i64) -> i64 {
	return 1
}

// Read, into nothing.
discarded :: fun(kept: i64) {
	_ = kept
}

// A param given a call's result, a constant, an expression and its default.
given :: fun(a: i64, b: i64 = 4) -> i64 {
	return a + b
}

GIVEN_LIMIT :: 9

Counter :: struct {
	n: i64
}

bump :: fun(counter: Counter, by: i64) -> i64 {
	return counter.n + by
}

second_main :: fun(box: ^Box) {
	print(note_it("a"), note_it(1), decide(1, 2), never_used(3))
	only_printed(4)
	discarded(5)
	print(given(leaf(1)), given(GIVEN_LIMIT), given(1 + 2, 5))
	c := Counter{n = 1}
	print(c.bump(2))
	print(bump(c, 3))
}
