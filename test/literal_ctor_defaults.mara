module literal_ctor_defaults

//@ expect-output: 5 9 5 7 2
//@ expect-output: 5 5

// A construction without arguments — `P()`, a literal, a bare declaration —
// runs its constructor on its params' defaults (a literal once called it
// with none: whatever the argument registers held). A bare fixed array's
// items are each built so.

Bad :: error {
	Neg
}

P :: struct(x: i32 = 5) {
	v: i32
	v = x
}

Q :: struct(x: i32) {
	v: i32 = 3
	v = v + x
}

T :: struct(x: i32 = 0) -> err {
	v: i32 = 4
	if x < 0 do return Neg
}

Holder :: struct {
	p: P = P(7)
	q: Q = Q(-1)
}

main :: fun() {
	p := P()
	p2 : P = {v = 9}
	pb := P()
	h := Holder()
	print(p.v, p2.v, pb.v, h.p.v, h.q.v)
	ps : [2!]P
	print(ps[0].v, ps[1].v)
}
