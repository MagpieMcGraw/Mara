module test_distinct_construct

// Verify distinct type construction and unwrap.
// `Foo(x)` where Foo :: distinct T constructs a Foo from x.
// `T(foo)` unwraps a Foo to its underlying T (existing primitive-cast path,
// works because Type_Distinct lowers to its base type at IR level).

File_Id :: distinct i64
Tag     :: distinct i32

test_distinct_construct :: fun() {
	print("=== test_distinct_construct ===")

	// Construct from a literal.
	id : File_Id = File_Id(66)
	print(i64(id))    // expect 66

	// Construct from a non-literal i64.
	n : i64 = 1234
	id2 := File_Id(n)
	print(i64(id2))   // expect 1234

	// Distinct over a smaller integer.
	t : Tag = Tag(7)
	print(i64(i32(t)))  // expect 7 (Tag → i32 → i64 for print)

	// Round-trip: unwrap then re-construct.
	round := File_Id(i64(id) + 1)
	print(i64(round))  // expect 67

	print("=== test_distinct_construct passed ===")
}
