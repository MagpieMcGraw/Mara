module nested_fwd_fun

// Regression / property guard: a forward reference to a nested `::` fun defined
// LATER in the same body. `v := compute(5)` is checked before `compute` appears
// in source order, so the nested fun's signature must resolve when the call
// pulls it. This was historically the "eager_signatures" pre-pass; that pass is
// GONE — nested fun signatures now resolve ON DEMAND (ensure_fun_signature ->
// resolve_fun_signature -> build_scope_decl_env rebuilds the decl env from the
// durable parent_scope graph). This fixture is the direct guard for that path.

make :: fun() -> i64 {
    v := compute(5)
    compute :: fun(x: i64) -> i64 { return x * 2 }
    return v
}

main :: fun() {
    print(make())   // 10
}
