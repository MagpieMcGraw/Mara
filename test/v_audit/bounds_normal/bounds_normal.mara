module bounds_normal

// V audit: bounds checking works on normal arrays (this V claim is true).
// Mara analog: read past the end of a fixed array with a runtime index.
// Expected behaviour: emit_bounds_check traps with
// "index out of bounds" and exits.

main :: fun() -> i64 {
    arr : [4]i64
    arr[0] = 1
    arr[1] = 2
    arr[2] = 3
    arr[3] = 4
    // Force a runtime index so the compile-time elision doesn't strip the check.
    i : i64 = 10
    return arr[i]
}
