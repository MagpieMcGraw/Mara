module imm_bypass

// V audit: immutable references can be silently cast to mutable.
// Mara analog: take a pointer to a local and write through it.
// Expected behaviour: Mara doesn't yet have a unified mutability
// model (see project_pointer_ref_mutable_deferred.md in memory).
// This test pins the current behaviour for later review.

main :: fun() -> i64 {
    x : i64 = 10
    p : ^i64 = &x
    p^ = 20
    return x
}
