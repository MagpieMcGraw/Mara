module bounds_partial

// V audit: V's bounds check can be bypassed by manually setting an
// array's `len` and `cap` properties.
// Mara analog: Mara slices/partial arrays don't expose len/cap as
// mutable fields — write through `[..N]T` cap should trap on OOB.

main :: fun() -> i64 {
    pa : [..16]i64
    i : i64 = 100
    pa[i] = 42
    return 0
}
