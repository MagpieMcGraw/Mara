module dangling

// V audit: arbitrary integers can be cast to struct pointers.
// Mara analog: try the cleanest user-facing routes — direct cast
// from int to ^Foo, or via a foreign-block pointer reinterpret.
// Expected behaviour: type checker rejects all integer-to-pointer
// conversions outside `take` / foreign-block APIs.

Foo :: struct {
    x: i64
}

main :: fun() -> i64 {
    addr : i64 = 3735928559
    p : ^Foo = addr
    return p.x
}
