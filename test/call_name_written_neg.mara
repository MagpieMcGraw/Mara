module call_name_written_neg

//@ expect-fail: argument 1 of 'int_text': parameter 'n' expects i64, got bool

// A call through a module's name is said as written, not by the flat name
// it resolves to (mara_string_int_text).

str :: use mara.string

main :: fun() {
	text := str.int_text(true)
	print(text)
}
