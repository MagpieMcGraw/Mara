module test_take_return

// Returning a let-bound view by value is safe: the bytes get memcpy'd into
// the caller's sret slot, the source memory still belongs to the caller, and
// nothing dangles. Used to be wrongly rejected as "view binding is scoped to
// the function" — see commit log for the relaxation.

Pair :: struct {
	a: i64
	b: i64
}

// Writes a Pair into the front of memory, then returns it by value. The
// returned Pair is a *copy* of the bytes — the caller's memory still owns
// them. This is the pattern the rejected rule used to disallow.
roundtrip :: fun(memory: ^[]byte) -> Pair {
	p : Pair = let(Pair, memory)
	p.a = 100
	p.b = 200
	return p
}

test_take_return :: fun() {
	print("=== test_take_return ===")
	buf : [..256]byte
	out := roundtrip(&buf)
	print(out.a)  // 100
	print(out.b)  // 200
	print("=== test_take_return passed ===")
}
