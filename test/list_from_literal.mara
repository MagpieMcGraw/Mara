module list_from_literal

use mara.core

//@ expect-output: decl: 3 8 3
//@ expect-output: names: 2 1 2
//@ expect-output: assign: 1 4
//@ expect-output: nested: 2 2 1 3
//@ expect-output: field: 2 6
//@ expect-output: arg: 3
//@ expect-output: return: 2 9

// A list made from an array literal holds as many items as the literal
// has: its len is the literal's count (it was left 0, the items written
// past it). More items than its room is an error (list_literal_room_neg).

Bag :: struct {
	items: [4]i64,
}

count :: fun(list: [8]i64) -> i64 {
	return list.len
}

two :: fun() -> [4]i64 {
	return [8, 9]
}

main :: fun() {
	ints : [8]i64 = [1, 2, 3]
	print("decl:", ints.len, ints.cap, ints[2])
	a := 1
	b := 2
	names : [8]i64 = [a, b]
	print("names:", names.len, names[0], names[1])
	ints = [4]
	print("assign:", ints.len, ints[0])
	grid : [2][4]i64 = [[1, 2], [3]]
	print("nested:", grid.len, grid[0].len, grid[1].len, grid[1][0])
	bag := Bag{items = [5, 6]}
	print("field:", bag.items.len, bag.items[1])
	print("arg:", count([1, 2, 3]))
	r := two()
	print("return:", r.len, r[1])
}
