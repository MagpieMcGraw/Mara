module view_hub

use mara.core
use mara.os

// A stand-in for the window (`mara view`), for test/ask.sh: the window's
// side of `mara ask` asking it, with no window. Run as `mara view` runs one
// — view_hub <compiler> <module> <pipe name> — it listens on the pipe name,
// keeps the compiler's `serve` running, and answers each connection's line
// with what serve answers, its end line too; then closes the connection. A
// "-show <query>" or "-cursor <query>" line is a query the window would
// show: here, answered as any; a "-docs <words>" line, docs it has none of:
// answered as failed.
// Each line goes in view_hub.log, in the directory it runs in, as does serve
// starting and ending, and "ended" when it ends: once no one has connected
// for a second or so.

// The compiler's `serve`, started again after it ends — a compiler bug stops
// it — once a query needs it: one that dies each start costs a start a
// query, not a loop of them.
Server :: struct {
	command: str256   // "<compiler>" serve <module>
	process: Process
	running: bool
}

main :: fun(args: [][]utf8) -> i64 {
	if args.len < 4 do return 1
	l, le := pipe_listen(args[3])
	if bool(le) do return 1   // (another listens there: it answers)
	defer pipe_listen_stop(&l)
	log, oe := file_open_write("view_hub.log")
	if bool(oe) do return 1
	defer file_close(log)
	s : Server
	&s.command + "\""
	&s.command + args[1]
	&s.command + "\" serve "
	&s.command + args[2]
	if bool(server_up(&s, log)) do return 1

	// (A look each 10 ms; 100 with no one: a second or so — Windows' sleeps
	// run long.)
	idle := 0
	for idle < 100 {
		c, ae := pipe_accept(&l)
		if bool(ae) do break
		if c == NO_FILE {
			idle += 1
			sleep_ms(10)
			continue
		}
		idle = 0
		e := answer(c, &s, log)
		file_close(c)
		if bool(e) do note(log, "unanswered\n")
	}
	note(log, "ended\n")
	server_down(&s, log)
	return 0
}

// Serve running: started, unless it is.
server_up :: fun(s: ^Server, log: File_Id) -> err {
	if not s.running {
		p := process_start(s.command)?
		s.process = p
		s.running = true
		note(log, "serve started\n")
	}
}

// Serve ended, or ended now: waited for.
server_down :: fun(s: ^Server, log: File_Id) {
	if not s.running do return
	_, we := process_wait(&s.process)
	if bool(we) do note(log, "serve not waited for\n")
	s.running = false
	note(log, "serve ended\n")
}

// A connection's line asked of serve, and what serve answers passed back as
// it comes, to its end line.
answer :: fun(c: File_Id, s: ^Server, log: File_Id) -> err {
	line : [500]byte
	chunk : [200]byte
	for true {
		file_read(c, &chunk)?
		if chunk.len == 0 do break
		&line + chunk[:]
		text : []utf8 = line[:]
		if text[text.len - 1] == '\n' do break
	}
	asked : []utf8 = line[:]
	note(log, "asked: ")
	note(log, asked)
	if asked.len >= 6 {
		if asked[0 : 6] == "-docs " {
			no_docs := "the stand-in window has no docs\n-- end of answer: failed --\n"
			no_docs_bytes : []byte = no_docs[:]
			file_write(c, no_docs_bytes)?
			return
		}
	}

	// (To serve — a "-show " query without it. One that ended since the last
	// query, found by the write failing, is started again and asked: it never
	// saw it.)
	server_up(s, log)?
	bytes : []byte = line[:]
	if asked.len >= 6 {
		if asked[0 : 6] == "-show " do bytes = line[6 : line.len]
	}
	if asked.len >= 8 {
		if asked[0 : 8] == "-cursor " do bytes = line[8 : line.len]
	}
	_, we := file_write(s.process.input, bytes)
	if bool(we) {
		server_down(s, log)
		server_up(s, log)?
		file_write(s.process.input, bytes)?
	}

	current : [100]utf8   // the line coming, to know the end line
	done := false
	passed := false   // any of the answer passed on
	resent := false
	for not done {
		file_read(s.process.output, &chunk)?
		if chunk.len == 0 {
			server_down(s, log)
			// (Ended before any of its answer — as serve does when Mara was
			// rebuilt: a new one started and asked again, once.)
			if not passed and not resent {
				resent = true
				server_up(s, log)?
				file_write(s.process.input, bytes)?
				continue
			}
			// (Serve ended answering it — maybe for it: not asked again. No
			// end line, so `mara ask` checks for itself; the next query
			// starts a new serve.)
			return Read_Failed
		}
		passed = true
		piece : []byte = chunk[:]
		file_write(c, piece)?
		for ch in chunk[:] {
			letter := utf8(ch)
			if letter == '\n' {
				if current.len >= 16 {
					if current[0:16] == "-- end of answer" do done = true
				}
				current.len = 0
				continue
			}
			if current.len < current.cap {
				&current + letter
			}
		}
	}
}

// Text written to the log.
note :: fun(log: File_Id, text: []utf8) {
	bytes : []byte = text[:]
	_, we := file_write(log, bytes)
	if bool(we) do print("the log couldn't be written:", we)
}
