module array_item_rows_neg
//@ expect-fail: its items are fixed arrays of 2, and a [][4!]i64 holds fixed arrays of 4

use mara.core

// Rows of 2 where rows of 4 go: read as rows of 4, they ran into each
// other. Refused (a literal's short rows are made long: array_item_layout).

rows :: fun(r: [][4!]i64) {
	print("rows % first %", r.len, r[0][3])
}

main :: fun() {
	small : [3!][2!]i64 = [[1, 2], [3, 4], [5, 6]]
	rows(small)
}
