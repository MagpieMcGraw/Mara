module test_take_basic

// Smoke test for the let(T, storage) builtin.
// let advances storage.len by size_of(T) and returns a typed view at the
// just-advanced range. The view aliases storage's bytes — mutations through
// the binding write back into storage.

use mara.memory

Pair :: struct {
    a: i64
    b: i64
}

run :: fun(memory: ^[]byte) {
    print("=== test_take_basic ===")

    // Carve a Pair from the front of memory.
    p : Pair = let(Pair, memory)
    p.a = 7
    p.b = 11

    // Carve a [4]i64 region right after it.
    nums : [4]i64 = let([4]i64, memory)
    nums[0] = 100
    nums[1] = 200
    nums[2] = 300
    nums[3] = 400

    // Read back through the bindings.
    print(p.a)         // 7
    print(p.b)         // 11
    print(nums[0])     // 100
    print(nums[3])     // 400

    // Confirm the cursor advanced by sizeof(Pair) + sizeof([4]i64) = 16 + 32 = 48.
    // (`let` advances the cursor on both value and fixed-array carves.)
    print(memory.len)  // 48

    print("=== test_take_basic passed ===")
}

test_take_basic :: fun() {
    // Sized slice — fresh cursor (len=0, cap=256). Coercing a fixed array
    // `[256]byte` to `[]byte` would instead produce a populated view
    // (len=cap=256), which would put `let` past the end of the buffer.
    buf : [..256]byte
    run(&buf)
}
