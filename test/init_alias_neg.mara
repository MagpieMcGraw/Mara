module init_alias_neg
//@ expect-fail: 'hp.p' may be void here

// Taking an address is not an assignment: only handing it to a call is (see
// init_outparam). Kept in a local, what's void under it — h.p, zeroed — may
// be void wherever it's read: through hp, unchecked, an error.

Holder :: struct { p: ^i64 }

main :: fun() {
	h : Holder
	hp := &h
	print(hp.p^)
}
