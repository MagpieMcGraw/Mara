module enum_numbering

//@ expect-output: 1 2 0
//@ expect-output: 0 1 2
//@ expect-output: 5 6 7
//@ expect-output: 0 10 11
//@ expect-output: 0 2 1
//@ expect-output: 2 3 0 4
//@ expect-output: 1 0 2
//@ expect-output: 1 2 3 0 4
//@ expect-output: 1 1 2

// A variant not given a value takes the one after the variant before it —
// skipping any value another variant is given: `{ build, ask, none = 0 }`
// is build 1, ask 2, none 0. (It was build 0 beside none 0: two variants of
// one value, build printed for none.) A variant written `= 0` counts as the
// first wherever it is, so the ones after it go on from the ones before:
// `{ a, none = 0, b }` is 1, 0, 2. (b was 1 beside a's 1: a lexer's `not`
// printed as its EOF.) One not given a value landing on another's is an
// error (enum_same_tag_neg); two written alike are two names for one value.

use mara.core

A :: union { build, ask, none = 0 }
B :: union { none = 0, build, ask }
C :: union { a = 5, b, c }
D :: union { a, b = 10, c }
E :: union { a, b, c = 1 }
F :: union { x = 2, y, z = 0, w }
G :: union { a, none = 0, b }
Kind :: union { Not, And, At, Mystery = 0, EOF }
H :: union { a = 1, b = 1, c }

main :: fun() {
	print(i64(A.build), i64(A.ask), i64(A.none))
	print(i64(B.none), i64(B.build), i64(B.ask))
	print(i64(C.a), i64(C.b), i64(C.c))
	print(i64(D.a), i64(D.b), i64(D.c))
	print(i64(E.a), i64(E.b), i64(E.c))
	print(i64(F.x), i64(F.y), i64(F.z), i64(F.w))
	print(i64(G.a), i64(G.none), i64(G.b))
	print(i64(Kind.Not), i64(Kind.And), i64(Kind.At), i64(Kind.Mystery), i64(Kind.EOF))
	print(i64(H.a), i64(H.b), i64(H.c))
}
