module join

use mara.core
use mara.os
use mara.memory

#allocator Arena_Basic(4 * MB)

//@ expect-output: joined: C:/Code/code 64 | kept: C:/Code 7
//@ expect-output: chained: C:/Code/code/core.mara 22
//@ expect-output: items: 1 3 3 64
//@ expect-output: compare: true
//@ expect-output: assigned: new-and-old
//@ expect-output: argument: new/z
//@ expect-output: made: C:/Code/x.mara 512 | wider: abcdef 512 abc
//@ expect-output: big: start-a-b-c 11 1000
//@ expect-output: generic size: 2 4 6 3 | 128

// `x + y`, x a list not pointed at: a join — a new list of x's own type
// (its room), x as it was; `&x + y` still adds into x. Text, one
// character, items, one item. A chain builds one list in place (x copied
// once); an assignment's builds apart first, since it may read its own
// destination. A view has no room: `Path(view)` makes one of it. And a
// generic's size param, `[$N]T`, bound by the array passed.

show :: fun(s: []utf8) { print("argument:", s) }

// Each item doubled: an array of the same size.
doubled :: fun(a: [$N!]i64) -> [N!]i64 {
	out := a
	for k in 0 ..< N {
		out[k] = out[k] * 2
	}
	return out
}

// A list of the same room as a's, and that room again.
room_twice :: fun(a: [$N]$T) -> i64 {
	spare : [N]T
	return spare.cap + N
}

main :: fun() {
	cwd : str64
	&cwd + "C:/Code"
	code := cwd + "/code"
	print("joined: % % | kept: % %", code, code.cap, cwd, cwd.len)

	file := code + '/' + "core.mara"
	print("chained:", file, file.len)

	nums : [64]i64
	&nums + 1
	more := nums + 2 + 3
	print("items:", nums.len, more.len, more[2], more.cap)

	print("compare:", cwd + "/code" == "C:/Code/code")

	x : str64
	&x + "old"
	y : str64
	&y + "new"
	x = y + "-" + "and-" + x
	print("assigned:", x)
	show(y + "/" + "z")

	whole : str64
	&whole + "C:/Code/rest"
	dir := whole[0 : 7]
	made := Path(dir) + "/" + "x.mara"
	small : str64
	&small + "abc"
	wide := Path(small) + "def"
	print("made: % % | wider: % % %", made, made.cap, wide, wide.cap, small)

	big : [1000]utf8
	&big + "start"
	long := big + "-a" + "-b" + "-c"
	print("big:", long, long.len, long.cap)

	three : [3!]i64 = {1, 2, 3}
	d := doubled(three)
	print("generic size: % % % % | %", d[0], d[1], d[2], d.len, room_twice(code))
}
