module param_pointer_write_neg
//@ expect-fail: 'p' is a param, and a param can't point elsewhere: `p = v` writes what it points at (i64); this is a pointer, ^i64

// A pointer param itself can't be written either: `p = v` writes what it
// points at (write_through), and another pointer isn't that.

pick :: fun(p: ^i64, q: ^i64) -> i64 {
	p = q
	return p^
}

main :: fun() {
	a := 1
	b := 2
	print(pick(&a, &b))
}
