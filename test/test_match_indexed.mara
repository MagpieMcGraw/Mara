module test_match_indexed

// Enum-indexed bool arrays: `[4 Color]bool` indexed by a union value, read as
// `colors[Green]`. (This used to be exercised through a namespace match; that
// form was removed, so the same coverage now runs via plain `if`.)

Color :: union(tag u8) {
	Red    = 0
	Green  = 1
	Blue   = 2
	Yellow = 3
}

Events :: struct {
	quit:   bool
	colors: [4 Color]bool
}

test_match_indexed :: fun() {
	e: Events
	e.quit          = true
	e.colors[Green] = true
	e.colors[Blue]  = true
	// Prints 99, 12, 13 — quit, then Green and Blue from colors.
	if e.quit           do print(99)
	if e.colors[Red]    do print(11)
	if e.colors[Green]  do print(12)
	if e.colors[Blue]   do print(13)
	if e.colors[Yellow] do print(14)

	// Multi-statement body still works through a plain if.
	more: Events
	more.colors[Red]    = true
	more.colors[Yellow] = true
	if more.colors[Red] {
		print(81)
		print(82)
	}
	if more.colors[Green]  do print(83)
	if more.colors[Yellow] do print(84)
}

main :: fun() -> i64 {
	test_match_indexed()   // prints: 99 12 13  then  81 82 84
	return 0
}
