module map_sort

use mara.core
use mara.memory
use mara.map
use mara.sorting

//@ expect-output: text: 11 true 0 false 2 of 100
//@ expect-output: has: true false
//@ expect-output: deleted: true false 1
//@ expect-output: counts: the 3 cat 1
//@ expect-output: numbers: 999 true , all found: true
//@ expect-output: churn: 0 left, all correct: true
//@ expect-output: cleared: 0 false
//@ expect-output: sorted: [1, 2, 3, 5, 8, 9]
//@ expect-output: by: [9, 8, 5, 3, 2, 1]
//@ expect-output: names: amy bob cal
//@ expect-output: empty and one: 0 1
//@ expect-output: sizes sorted: true true true true true
//@ expect-output: heap path: true

// mara.map: text and number keys, values changed in place, deletes that keep
// searches working. mara.sorting: every shape of input, including the one that
// makes a plain quicksort slow.

#allocator Arena_Basic(64 * MB)

maps :: fun(storage: ^[]byte) {
	m : Map([]utf8, i64)
	map_init(&m, 100, storage)
	map_set(&m, "one", 1)
	map_set(&m, "two", 2)
	map_set(&m, "one", 11)
	a, found_a := map_get(&m, "one")
	b, found_b := map_get(&m, "three")
	print("text:", a, found_a, b, found_b, m.count, "of", m.room)
	print("has:", map_has(&m, "two"), map_has(&m, "three"))

	gone := map_delete(&m, "two")
	again := map_delete(&m, "two")
	print("deleted:", gone, again, m.count)

	counts : Map([]utf8, i64)
	map_init(&counts, 16, storage)
	words : [5!][]utf8
	words[0] = "the"
	words[1] = "cat"
	words[2] = "the"
	words[3] = "dog"
	words[4] = "the"
	for w in words do map_at(&counts, w)^ += 1
	the, _ := map_get(&counts, "the")
	cat, _ := map_get(&counts, "cat")
	print("counts: the", the, "cat", cat)

	n : Map(i64, f64)
	map_init(&n, 1000, storage)
	for k in 0:1000 do map_set(&n, k * 7, f64(k))
	x, found_x := map_get(&n, 7 * 999)
	all_found := true
	for k in 0:1000 {
		v, ok := map_get(&n, k * 7)
		if not ok or v != f64(k) do all_found = false
		if map_has(&n, k * 7 + 1) do all_found = false
	}
	print("numbers:", x, found_x, ", all found:", all_found)

	// (Deletes in another order than the sets, each followed by checks of what's
	// left: a delete that broke a search chain would lose one of them.)
	c : Map(i64, i64)
	map_init(&c, 200, storage)
	right := true
	for round in 0:20 {
		for k in 0:200 do map_set(&c, k * 31 + round, k)
		for k in 0:200 {
			pick := (k * 73) % 200
			if not map_delete(&c, pick * 31 + round) do right = false
			for j in k + 1:200 {
				if not map_has(&c, ((j * 73) % 200) * 31 + round) do right = false
			}
		}
		if c.count != 0 do right = false
	}
	print("churn:", c.count, "left, all correct:", right)

	map_clear(&m)
	print("cleared:", m.count, map_has(&m, "one"))
}

// (xorshift: the same numbers each run.)
next_number :: fun(state: ^u64) -> i64 {
	s := state^
	s = s ~ (s << 13)
	s = s ~ (s >> 7)
	s = s ~ (s << 17)
	state^ = s
	return i64(s >> 1)
}

in_order :: fun(items: []i64) -> bool {
	for k in 1:items.len {
		if items[k] < items[k - 1] do return false
	}
	return true
}

later :: fun(a: i64, b: i64) -> bool { return a > b }

name_before :: fun(a: str64, b: str64) -> bool {
	for k in 0:a.len {
		if k >= b.len do return false
		if a[k] != b[k] do return i64(a[k]) < i64(b[k])
	}
	return a.len < b.len
}

// Whether every n and shape sorts. Past 16 items quicksort runs, and the sawtooth
// and organ pipe shapes are its usual trouble.
sizes :: fun(n: i64, state: ^u64) -> bool {
	big : [20000]i64
	ok := true
	for shape in 0:5 {
		big.len = 0
		for k in 0:n {
			if shape == 0 do &big ++ next_number(state)
			if shape == 1 do &big ++ k
			if shape == 2 do &big ++ (n - k)
			if shape == 3 do &big ++ (k % 7)
			if shape == 4 do &big ++ (if k < n / 2 do k else n - k)
		}
		sort(&big)
		if not in_order(big) or big.len != n do ok = false
	}
	return ok
}

// A depth of 0 sends the whole run to heapsort, which bad pivots would send it to
// in time.
heap_path :: fun() -> bool {
	big : [20000]i64
	for k in 0:20000 do &big ++ (20000 - k)
	sort_run(&big, later_or_same, 0, big.len, 0)
	return in_order_down(big)
}

later_or_same :: fun(a: i64, b: i64) -> bool { return a > b }

in_order_down :: fun(items: []i64) -> bool {
	for k in 1:items.len {
		if items[k] > items[k - 1] do return false
	}
	return true
}

main :: fun() {
	storage : [4 * MB]byte
	maps(&storage)

	xs : [6]i64
	&xs ++ 5
	&xs ++ 2
	&xs ++ 9
	&xs ++ 1
	&xs ++ 3
	&xs ++ 8
	sort(&xs)
	print("sorted:", xs)
	sort_by(&xs, later)
	print("by:", xs)

	names : [3]str64
	&names ++ "cal"
	&names ++ "amy"
	&names ++ "bob"
	sort_by(&names, name_before)
	print("names:", names[0], names[1], names[2])

	none : [4]i64
	sort(&none)
	one : [4]i64
	&one ++ 7
	sort(&one)
	print("empty and one:", none.len, one.len)

	state : u64 = 88172645463325252
	print("sizes sorted:", sizes(10, &state), sizes(17, &state), sizes(100, &state), sizes(1000, &state), sizes(20000, &state))
	print("heap path:", heap_path())
}
