module array_element_widen

// An array literal's element widens into the element type, as a value does
// wherever else it goes (a declaration, an argument, a field): an i32 into an
// i64 element, a u8 into an i16. It was the one place a value had to be the
// element type exactly — and an inferred binding (`n := 5`) whose width its
// other uses decide, an i32, goes into an i64 element too.

//@ expect-output: -5 200 1 200 3 5

take_i32 :: fun(x: i32) {}

main :: fun() {
	x : i32 = -5
	u : u8 = 200
	arr : [3]i64 = {x, u, 1}
	w : [2]i16 = {u, 3}
	n := 5
	take_i32(n)
	m : [2]i64 = {n, 1}
	print(arr[0], arr[1], arr[2], w[0], w[1], m[0])
}
