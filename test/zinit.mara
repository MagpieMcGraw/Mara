module zinit

use mara.core
use mara.os
include mara.memory

#allocator Arena_Basic(16 * MB)

main :: fun() {
	// Partial-array backing starts zeroed: trim up and read — all zeros.
	z : [8]i64
	z.len = 8
	assert(z[0] == 0)
	assert(z[7] == 0)

	// A slice of an array too.
	arr : [16!]i64
	s := arr[0:16]
	assert(s[3] == 0)
	assert(s[15] == 0)

	// A count known at run time.
	n := 12
	more : [16!]i64
	r := more[0:n]
	assert(r[11] == 0)

	// The payoff: a utf8 buffer filled by ELEMENT WRITES (no appends, no
	// literals) is deterministically valid for cstring — the zeroed tail
	// supplies the terminator.
	path : [64]utf8
	src := "zinit.mara"
	path.len = src.len
	for i in 0..src.len {
		path[i] = src[i]
	}
	data : [4096]byte = void
	_, err := read_entire_file(path, &data)
	assert(not bool(err))
	assert(data.len > 0)
	print("element-written path ok, bytes:")
	print(data.len)

	print("zinit ok")
}
