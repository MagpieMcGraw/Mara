module test_bswap

bswap16 :: fun(x: u16) -> u16 { @llvm.bswap.i16 }
bswap32 :: fun(x: u32) -> u32 { @llvm.bswap.i32 }
bswap64 :: fun(x: u64) -> u64 { @llvm.bswap.i64 }

// Signed variant should also type-check — sign-agnostic at the LLVM level.
bswap32_signed :: fun(x: i32) -> i32 { @llvm.bswap.i32 }

main :: fun() -> i64 {
    a : u16 = 0x1234
    print("bswap16(0x1234):", bswap16(a))         // expect 0x3412 = 13330

    b : u32 = 0xDEADBEEF
    print("bswap32(0xDEADBEEF):", bswap32(b))     // expect 0xEFBEADDE

    c : u64 = 0x0123456789ABCDEF
    print("bswap64:", bswap64(c))                  // expect 0xEFCDAB8967452301

    d : i32 = 0x12345678
    print("bswap32_signed:", bswap32_signed(d))   // expect 0x78563412

    return 0
}
