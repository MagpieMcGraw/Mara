module test_bswap

use mara.endian

main :: fun() -> i64 {
    a : u16 = 0x1234
    print("bswap16(0x1234):", bswap16(a))         // expect 0x3412 = 13330

    b : u32 = 0xDEADBEEF
    print("bswap32(0xDEADBEEF):", bswap32(b))     // expect 0xEFBEADDE = 4022250974

    c : u64 = 0x0123456789ABCDEF
    print("bswap64:", bswap64(c))                  // expect 0xEFCDAB8967452301

    // BE readers — TTF/PNG/network-format building blocks.
    buf : [8]u8
    buf[0] = 0xDE
    buf[1] = 0xAD
    buf[2] = 0xBE
    buf[3] = 0xEF
    buf[4] = 0x01
    buf[5] = 0x23
    buf[6] = 0x45
    buf[7] = 0x67
    bytes : []byte = buf[:]
    print("read_u16be:", read_u16be(bytes[0]))    // 0xDEAD = 57005
    print("read_u32be:", read_u32be(bytes[0]))    // 0xDEADBEEF = 3735928559
    print("read_u64be:", read_u64be(bytes[0]))    // 0xDEADBEEF01234567 = 16045690984833335655

    return 0
}
