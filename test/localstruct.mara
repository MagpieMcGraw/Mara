module localstruct

// Regression: a struct defined inside a function body must be usable as the
// element type of that function's own local declarations. Before the fix, a
// function's nested defs were never registered into ft.types (only a struct's
// were), so the field-resolution loop couldn't resolve `Node` here and reported
// "unknown type 'Node'" against the function head.

main :: fun() {
	Node :: struct {
		x, y: f32
		on_curve: bool
	}
	nodes : [..8]Node
	nodes[0].x = 1.0
	nodes[0].y = 2.0
	nodes[0].on_curve = true
	nodes.len = 1

	sum : f32 = 0.0
	for i in 0..i32(nodes.len) {
		sum = sum + nodes[i].x + nodes[i].y
	}
	assert(sum > 2.9)

	// Regression: a function-local struct used in a `:=` / annotated struct
	// literal. This used to fail codegen ("'p' is not a struct") because local
	// struct types are keyed in c.table.structs under a mangled name the literal
	// path didn't resolve; it now finds them through the env.
	n := Node{ x = 5.0, y = 6.0, on_curve = false }
	assert(n.x == 5.0)
	assert(n.y == 6.0)
	m : Node = Node{ x = 7.0, y = 8.0, on_curve = true }
	assert(m.y == 8.0)
}
