module test_underscore_default

// `_` at a positional arg slot uses the parameter's declared default value.
// Mixes freely with explicit args and trailing-omission defaults.

with_two :: fun(a: i64 = 10, b: i64 = 20) -> i64 {
	return a + b
}

with_three :: fun(a: i64, b: i64 = 5, c: i64 = 7) -> i64 {
	return a * 100 + b * 10 + c
}

Point3 :: struct {
	x: i64 = 100
	y: i64 = 200
	z: i64 = 300
}

// Two dispatch candidates that differ on the second param's type. Bool
// avoids the Type_Infer_Int-matches-any-numeric ambiguity that would fire
// for two numeric overloads. `_` on slot 0 is fine for both (both have a
// default at position 0); the second-slot arg disambiguates which overload runs.
disp_helper_int  :: fun(a: i64 = 1, b: i64) -> i64  { return a * 1000 + b }
disp_helper_bool :: fun(a: i64 = 2, b: bool) -> i64 { return a * 2000 }

disp :: dispatch {
	disp_helper_int
	disp_helper_bool
}

// Two candidates with trailing defaults. Leading-arg type disambiguates.
disp_trail_int  :: fun(a: i64,  b: i64 = 10) -> i64 { return a * 100 + b }
disp_trail_bool :: fun(a: bool, b: i64 = 20) -> i64 { return b }

disp_trail :: dispatch {
	disp_trail_int
	disp_trail_bool
}

test_underscore_default :: fun() {
	// All explicit
	print(with_two(1, 2))     // 3

	// `_` on first param, explicit on second
	print(with_two(_, 2))     // 12 (10 + 2)

	// Explicit first, `_` second
	print(with_two(1, _))     // 21 (1 + 20)

	// Both `_`
	print(with_two(_, _))     // 30 (10 + 20)

	// Required first arg, `_` for middle, explicit for last
	print(with_three(1, _, 9))   // 159 (1*100 + 5*10 + 9)

	// Required first, `_` for both trailing
	print(with_three(2, _, _))   // 257 (2*100 + 5*10 + 7)

	// Positional parameterless-struct ctor — args map to fields.
	a : Point3 = Point3(10, 20, 30)
	print(a.x)   // 10
	print(a.y)   // 20
	print(a.z)   // 30

	// `_` substitutes the field's default in the same shape.
	b : Point3 = Point3(_, 7, _)
	print(b.x)   // 100 (from field default)
	print(b.y)   // 7
	print(b.z)   // 300 (from field default)

	// Dispatch + `_`: each candidate's default fills its own `_` slot. Second
	// arg's type picks the overload, then position 0 takes that overload's default.
	print(disp(_, 5))      // disp_helper_int  → 1*1000 + 5 = 1005
	print(disp(_, true))   // disp_helper_bool → 2*2000      = 4000

	// Trailing default fill in dispatch: one supplied arg picks the overload
	// by type, the trailing default fills.
	print(disp_trail(5))      // disp_trail_int  → 5*100 + 10 = 510
	print(disp_trail(true))   // disp_trail_bool → 20
	// Explicit arg overrides the default.
	print(disp_trail(5, 7))   // disp_trail_int  → 5*100 + 7 = 507
}
