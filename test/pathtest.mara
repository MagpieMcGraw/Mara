module pathtest

use mara.core
use mara.os
include mara.memory

#allocator Arena_Basic(16 * MB)

main :: fun() {
	// mara.os copies a path for C, a 0 after it (c_path): any slice of a
	// path opens. The arena backs the 4 KB read buffer.
	path : [64]utf8
	&path + "pathtest"
	&path + ".mara"
	data : [4096]byte
	text, err := read_entire_file(path, &data)
	assert(not bool(err))
	assert(text.len > 0)
	print("appended path ok, bytes:")
	print(text.len)

	// A tight slice: its room ends where the path does, no 0 after it.
	data.len = 0
	_, err2 := read_entire_file(path[:], &data)
	assert(not bool(err2))
	print("tight slice ok")

	// A path in the middle of other text.
	quoted := "(pathtest.mara)"
	data.len = 0
	_, err3 := read_entire_file(quoted[1 : quoted.len - 1], &data)
	assert(not bool(err3))
	print("slice of text ok")

	// A literal path.
	data.len = 0
	_, err4 := read_entire_file("pathtest.mara", &data)
	assert(not bool(err4))
	print("literal path ok")

	mt := file_mtime("pathtest.mara")
	assert(mt != 0)
	print("mtime ok")
}
