module dropped_join_neg

//@ expect-fail: the value of 'clean ++ c' is dropped, and 'clean' is as it was: an operator changes only what it's given a pointer to (`&clean ++ c`)

// `clean ++ c` is a join: a new list, clean left as it was. On a line of its
// own the new list goes nowhere, so the loop built nothing. `&clean ++ c`
// appends: an operator changes only what it's given a pointer to.

use mara.core

main :: fun() {
	clean : [16]utf8
	for c in "abc" do clean ++ c
	print(clean.len)
}
