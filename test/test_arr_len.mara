module test_arr_len

// Fixed arrays and slices are "always full" — for them, .len returns .cap.
// Both names must work so generic code can prefer .len consistently.

use mara.array

Box :: struct {
    xs    : [4]i64
    bytes : [12]byte
}

test_arr_len :: fun() {
    // --- Fixed array: direct ident access -------------------------------
    fa : [8]i64
    print(fa.len)   // expect 8
    print(fa.cap)   // expect 8

    // --- Slice over the fixed array: .len == .cap ----------------------
    sl : [:]i64 = fa[0 : 4]
    print(sl.len)   // expect 4
    print(sl.cap)   // expect 4

    // --- Byte fixed-array: bounds knowledge is just an integer ---------
    bytes : [16]byte
    print(bytes.len)  // expect 16
    print(bytes.cap)  // expect 16

    // --- Use in an expression context (proves it folds to a constant) --
    if fa.len == 8 {
        print(1)    // expect 1
    }

    // --- Pass a fixed-array-backed slice through for comparison --------
    full := fa[0:]
    print(full.len)  // expect 8
    print(full.cap)  // expect 8

    // --- Chained access: struct containing a fixed-array field ---------
    box : Box
    print(box.xs.len)    // expect 4
    print(box.xs.cap)    // expect 4
    print(box.bytes.len) // expect 12
}
