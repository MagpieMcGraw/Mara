module slice_count_carve

//@ expect-output: len 3 24
//@ expect-output: twice 23 64
//@ expect-output: generic 4 5 176

// `slice([:n]T, storage)` carves room for a runtime count of T (an empty
// slice, its cap the count). The checker reads
// `[:n]T` as type []T, count n, and records that beside the source instead of
// rewriting it: the rewrite changed the syntax tree, and generic instances
// share it, so the second instance of carve_generic lost its count (0).

Cell :: struct {
	v: i64
}

Wide :: struct {
	a: i64
	b: i64
}

carve :: fun(memory: ^[]byte, n: i64) -> i64 {
	xs : []Cell = slice([:n]Cell, memory)
	xs[n - 1].v = 9
	return xs.cap
}

carve_twice :: fun(memory: ^[]byte) -> i64 {
	a : []Cell = slice([:2]Cell, memory)
	b : []Cell = slice([:2 + 1]Cell, memory)
	return a.cap * 10 + b.cap
}

carve_generic :: fun($T: type, proto: T, memory: ^[]byte, n: i64) -> i64 {
	xs : []T = slice([:n]T, memory)
	return xs.cap
}

main :: fun() {
	buf : [..512]byte
	print("len", carve(&buf, 3), buf.len)
	print("twice", carve_twice(&buf), buf.len)
	print("generic", carve_generic(Cell{0}, &buf, 4), carve_generic(Wide{0}, &buf, 5), buf.len)
}
