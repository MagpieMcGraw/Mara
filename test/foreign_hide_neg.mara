module foreign_hide_neg

//@ expect-fail: 'abs' here is both the variable declared at

// A C function is a definition like any other: a variable of its name, read
// by that name alone, means both.

use mara.core

foreign static_lib "c" {
	fun abs(x: i32) -> i32
}

main :: fun() {
	abs := 1
	print(abs)
}
