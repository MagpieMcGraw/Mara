module esc_via_call_neg
//@ expect-fail: `leaf(...)`: its return may reference local memory via parameter `storage`

// `leaf` returns a view of its `storage` param, so its summary says the result
// comes from param 0. `outer` passes a local buffer and returns that result: a
// view of outer's own frame.

leaf :: fun(storage: ^[]byte) -> []i64 {
	return slice([:3]i64, storage)
}

outer :: fun() -> []i64 {
	storage : [..512]byte
	return leaf(&storage)
}

main :: fun() {
	sl := outer()
	print(sl[0])
}
