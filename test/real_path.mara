module real_path

//@ expect-output: same place true | dots gone true
//@ expect-output: | case on disk true | file true
//@ expect-output: missing File_Error.Open_Failed

// real_path: a path as the system has it — whole, `.` and `..` gone, links
// followed, its letters' case as on disk (on Windows) — so two spellings of
// one place compare equal. Run from test/, beside code/.

use mara.core
use mara.os
use mara.string

main :: () {
	here, _ := real_path(".")
	again, _ := real_path("../code/../test")
	print("same place", here == again, "| dots gone", not contains(again, ".."))
	// (Windows' names don't mind case: asked in the wrong one, the file's
	// found, and comes back in its own. Elsewhere that's another name.)
	asked := "../code/core.mara"
	#if #windows { asked = "../CODE/CORE.mara" }
	found, _ := real_path(asked)
	print("| case on disk", ends_with(found, "/code/core.mara"), "| file", found.len > here.len)
	_, e := real_path("../no_such_folder_here")
	print("missing", e)
}
