module test_sized_slice_field

use mara.memory
use mara.string

Holder :: struct {
	name:  str
	count: i64
}

main :: fun() -> i64 {
	program = Program(Arena_Basic(1 * MB))

	// Sanity: local str works
	s : str
	&s + "world"
	print(s)
	print(s.len)

	// Struct field test
	h := Holder{0}
	h.count = 42
	&h.name + "hello"
	print(h.name)
	print(h.name.len)
	print(h.count)

	return 0
}
