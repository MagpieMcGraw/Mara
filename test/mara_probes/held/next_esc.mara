module next_esc
use mara.core
fill :: (list: ^[]^i64) {
	local : i64 = 1234
	next(list)^ = &local
}
main :: () {
	list : [4]^i64
	fill(&list)
	print(list[0]^)
}

// A list made one longer, and a pointer to the new item to write into.
next :: fun(list: ^[]$T) -> ^T {
	n := list.len
	list.len = n + 1
	return &list[n]
}
