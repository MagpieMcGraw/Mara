module oobwrite
use mara.core
pick :: (n: i64) -> i64 { return n }
main :: () {
	a : [4!]i64 = [1, 2, 3, 4]
	b : [4!]i64 = [10, 20, 30, 40]
	print("b before:", b[0], b[1], b[2], b[3])
	print("a before:", a[0], a[1], a[2], a[3])
	wide := b[pick(0):pick(12)]
	for i in 0 .. 12 do wide[i] = -1
	print("b after: ", b[0], b[1], b[2], b[3])
	print("a after: ", a[0], a[1], a[2], a[3])
}
