module own_fun_other_file

use mara.core

//@ expect-fail: function 'add' is ambiguous (defined in: own_fun_other_file, mara.core)

// A module's fun in another of its files is beside core's `add` in this
// file too — it's its module's, not its file's: the bare name means neither.

main :: fun() {
	print(add(1, 2))
}
