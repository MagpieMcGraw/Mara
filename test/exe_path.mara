module exe_path

use mara.core
use mara.os
use mara.memory

#allocator Arena_Basic(4 * MB)

// exe_path: the program's own file — its path whole (a drive's or
// the root's at its start), its own name in it, the system's own spelling
// (real_path's) — whatever main's args[0] says (run.sh starts it by a
// relative path). Its directory, path_dir's Path, a file's name added: the
// file beside it opens.

//@ expect-output: has its own name: true
//@ expect-output: whole: true
//@ expect-output: real already: true
//@ expect-output: opens: true
//@ expect-output: beside it: true

main :: fun() -> i64 {
	path, e := exe_path()
	if e {
		print("exe_path:", e)
		return 1
	}
	print("has its own name:", has(path, "exe_path"))
	whole := path.len > 2 and (path[0] == '/' or path[1] == ':')
	print("whole:", whole)
	real, re := real_path(path)
	print("real already:", not re and real == path)
	id, oe := file_open_read(path)
	print("opens:", not oe)
	file_close(id)
	beside := path_dir(path)
	&beside + "exe_path.mara"
	sid, se := file_open_read(beside)
	print("beside it:", not se)
	file_close(sid)
	return 0
}

// Whether text has `part` in it.
has :: fun(text: []utf8, part: []utf8) -> bool {
	if text.len < part.len do return false
	for k in 0 .. text.len - part.len + 1 {
		if text[k : k + part.len] == part do return true
	}
	return false
}
