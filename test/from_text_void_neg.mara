module from_text_void_neg
//@ expect-fail: variable 'mode' is used before being assigned a value

// A variable declared `= void`, then written by `E.from_text(s)`, may still be
// unwritten — no variant may have that name — so reading it is an error.
// (Give it a default first: `mode := build`.)

use mara.core

Mode :: union { build  run }

main :: fun() {
	mode : Mode = void
	mode = Mode.from_text("run")
	print(mode)
}
