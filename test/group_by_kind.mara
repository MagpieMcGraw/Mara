module group_by_kind

use mara.core

//@ expect-output: small: 2 5 7
//@ expect-output: big: 2 50 70
//@ expect-output: huge: 2 500 7000
//@ expect-output: kinds: 3
//@ expect-output: even: 4 50 7000 | odd: 2 5 7 | of 2

// mara.core's group: items into one list per value of the enum its
// function gives back (`fun(T) -> $K` binds K to that function's result,
// `[K][]T` is one list for each of K's values). Two enums, two instances.

Size :: union { Small  Big  Huge }
Parity :: union { Even  Odd }

size_of_n :: fun(n: i64) -> Size {
	if n < 10 do return .Small
	if n < 100 do return .Big
	return .Huge
}

parity :: fun(n: i64) -> Parity {
	if n % 2 == 0 do return .Even
	return .Odd
}

main :: fun() {
	nums : [6!]i64 = {5, 50, 500, 7, 70, 7000}
	storage : [..512]byte
	by_size := group(nums[:], size_of_n, &storage)
	print("small:", by_size[Small].len, by_size[Small][0], by_size[Small][1])
	print("big:", by_size[Big].len, by_size[Big][0], by_size[Big][1])
	print("huge:", by_size[Huge].len, by_size[Huge][0], by_size[Huge][1])
	print("kinds:", by_size.len)
	by_parity := group(nums[:], parity, &storage)
	even := by_parity[Even]
	odd := by_parity[Odd]
	print("even: % % % | odd: % % % | of %", even.len, even[0], even[3], odd.len, odd[0], odd[1], by_parity.len)
}
