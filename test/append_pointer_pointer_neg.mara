module append_pointer_pointer_neg

//@ expect-fail: mismatched types for '++': ^^[4]str64 and [64]utf8

// An append onto `&p`, p a pointer to a list already: `&p` is a pointer to
// a pointer, and nothing appends to that. `p ++ "b"` is what was meant.

use mara.core

main :: fun() {
	names : [4]str64
	list := &names
	&list ++ "b"
	print(names.len)
}
