module test_arena_alignment

// Arena_Basic.alloc rounds the offset up to 16 before carving, so byte
// allocations don't desync the cursor for later typed-shape allocations.
// Without alignment a 1-byte alloc would leave offset=1 and the next alloc
// would start at offset=1 (returning an unaligned ptr).

use mara.memory

test_arena_alignment :: fun() {
    print("=== test_arena_alignment ===")

    arena : Arena_Basic = Arena_Basic(1 * KB)
    ap : ^Arena_Basic = &arena

    // First alloc starts at offset=0 (already 16-aligned).
    a : [:]byte = ap.alloc(1)
    print(arena.offset)  // 1

    // Second alloc rounds up: (1 + 15) & -16 = 16, then advances by 8.
    b : [:]byte = ap.alloc(8)
    print(arena.offset)  // 24

    // Third alloc rounds 24 up to 32, then advances by 16.
    c : [:]byte = ap.alloc(16)
    print(arena.offset)  // 48

    // Touch the slices so they're not optimized away.
    print(a.len)  // 1
    print(b.len)  // 8
    print(c.len)  // 16

    print("=== test_arena_alignment passed ===")
}
