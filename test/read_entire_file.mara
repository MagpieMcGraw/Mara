module read_entire_file

use mara.core
use mara.os

// read_entire_file: all of a file or Too_Large, never one cut off — into
// storage after what's there, its len moved past it, and given back, a view
// of storage. The room exactly its size, a byte short (storage untouched),
// two files one after the other in one storage, an empty file, a file that
// isn't there. (Its reads go on until the file's all in: one read may stop
// short. To see that run, make file_read's per-call cap tiny for a moment —
// it isn't, here.)

//@ expect-output: exact: Ok 100 true 100
//@ expect-output: short: File_Error.Too_Large 0 0
//@ expect-output: two: 100 100 200 true
//@ expect-output: empty: Ok 0 200
//@ expect-output: missing: File_Error.Open_Failed 0 200

PATH :: "read_entire_file_demo.txt"
EMPTY :: "read_entire_file_empty.txt"

// Writes text as the whole of the file at path.
save :: fun(path: []utf8, text: []utf8) -> err {
	id := file_open_write(path)?
	defer file_close(id)
	file_write_text(id, text)?
}

main :: fun() {
	text : str256
	for _ in 0:10 {
		&text + "0123456789"
	}
	if bool(save(PATH, text)) or bool(save(EMPTY, "")) {
		print("couldn't write the files")
		return
	}

	room : [100]byte
	data, e := read_entire_file(PATH, &room)
	got : []utf8 = data
	print("exact:", e, data.len, got == text, room.len)

	short : [99]byte
	cut, se := read_entire_file(PATH, &short)
	print("short:", se, cut.len, short.len)

	// One storage for both: the second file goes after the first.
	storage : [500]byte
	first, _ := read_entire_file(PATH, &storage)
	second, _ := read_entire_file(PATH, &storage)
	a : []utf8 = first
	b : []utf8 = second
	print("two:", first.len, second.len, storage.len, a == b)

	empty, ee := read_entire_file(EMPTY, &storage)
	print("empty:", ee, empty.len, storage.len)
	none, me := read_entire_file("no_such_file.txt", &storage)
	print("missing:", me, none.len, storage.len)
	_ = file_delete(PATH)
	_ = file_delete(EMPTY)
}
