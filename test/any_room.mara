module any_room

//@ expect-output: [3, 4] [5] 8004
//@ expect-output: hello 64 abc 64

// `[_]T` in a param: a list of any room, its size unnamed — `[$N]T` with no
// N to write. Each `_` is its own: two `[_]` params take lists of different
// rooms.

use mara.core

// One more item into any list.
push :: fun(xs: ^[_]i64, x: i64) {
	xs + x
}

// Two lists, each of its own room.
rooms :: fun(a: ^[_]i64, b: ^[_]i64) -> i64 {
	return a.cap * 1000 + b.cap
}

// Text of any room, by value.
said :: fun(text: [_]utf8) -> i64 {
	return text.cap
}

main :: fun() {
	a : [8]i64
	b : [4]i64
	push(&a, 3)
	push(&a, 4)
	push(&b, 5)
	print(a, b, rooms(&a, &b))
	s : str64
	&s + "abc"
	print("hello", said("hello"), s, said(s))
}
