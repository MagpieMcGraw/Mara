module infer_any_order

// A binding of no written width (`n := 5`) takes the width its uses give it
// — all the same one, so the order they come in changes nothing: an
// argument, an array literal's element, a pointer to it, a value written
// in, arithmetic, an if's other branch — whichever comes first, the others
// agree with it, or it's a conflict either way round (inferconflict,
// inferconflict_other_order). No widening: a use at another width is never
// let through.

//@ expect-output: call then element: 4 7 7
//@ expect-output: element then call: 4 7 7
//@ expect-output: pointer then value: 4 6
//@ expect-output: written in then passed: 2 300
//@ expect-output: arithmetic: 2 30007
//@ expect-output: an if: 2 2 10

t32 :: fun(x: i32) -> i32 { return x }
t16 :: fun(x: i16) -> i16 { return x }
use16 :: fun(x: i16) {}
p32 :: fun(p: ^i32) { p^ = p^ + 1 }

main :: fun() {
	a := 7
	x := t32(a)
	arr : [2!]i32 = {a, 1}
	print("call then element:", size_of(a), x, arr[0])
	b := 7
	brr : [2!]i32 = {b, 1}
	y := t32(b)
	print("element then call:", size_of(b), brr[0], y)

	m := 5
	p32(&m)
	c := t32(m)
	print("pointer then value:", size_of(m), c)

	w := 0
	h : i16 = 300
	w = h
	print("written in then passed:", size_of(w), t16(w))

	q := 7
	s16 : i16 = 30000
	sum := q + s16
	print("arithmetic:", size_of(q), sum)

	g := 10
	cond := true
	v := if cond do g else 0
	use16(g)
	print("an if:", size_of(v), size_of(g), v)
}
