// How to give part of a program memory of its own: another program, and a
// block run on it.
//
// this_program is the program running: its arena, where values of 1 KB or
// more go, and its command line (see arenas.mara). `Program(arena)` makes
// another one, with an arena of its own — the same kind as this_program's,
// which main's `this_program = Program(…)` names — and no command line.
//
// `with &p {…}` (or `with &p do …`) runs its block on p: what the block puts
// on an arena, and what everything it calls puts there, goes on p's, and
// this_program is p there. At every way out of the block — its end, a
// return, `?`, a break or continue — the program it was is back, so the code
// around it never sees p. A with inside a with runs on the inner one's.
//
// It's how a job gets memory apart from the rest: a level's, a request's, a
// library's. A DLL's #expose funs run on the program their host hands them
// (their first param, a ^Program), so a host can give a library a program of
// its own. A program's arena is reserved for as long as the program runs:
// make one for a long-lived job, not one per call.
module programs

use mara.core
use mara.memory

// What a program's arena has in use, in bytes.
in_use :: fun(p: ^Program) -> i64 {
	return p.scope_allocator.base.len
}

// A level's work: a big buffer — on the arena of the program it runs on.
load_level :: fun(level: ^Program) {
	tiles : [64 * KB]byte
	tiles[0] = u8(1)
	print("loading: the level's arena holds", in_use(level), "bytes")
}

main :: fun() {
	this_program = Program(Arena_Basic(16 * MB))
	level := Program(Arena_Basic(1 * MB))

	// Run on the level's program, load_level's buffer goes on its arena —
	// and is gone when load_level ends.
	with &level {
		load_level(&level)
		print("this_program has a command line here:", this_program.args.len > 0)   // false
	}
	print("after: the level's arena holds", in_use(&level), "bytes")           // 0
	print("and this_program is the program again:", this_program.args.len > 0) // true
}
