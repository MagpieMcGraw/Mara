// How to see what's in a directory — its files and the directories in it —
// with dir_read.
//
// dir_read lists them into storage you declare, `[..N]byte`, after what's
// in it already, and gives them back, a view of storage: a `[]Dir_Entry`,
// an entry for each — its name (not its path: join the directory's and the
// name to open it) and whether it's a directory. "." and ".." aren't
// listed, and the order is the system's: sort them if it matters. It fails
// with File_Error.Open_Failed when there's no directory at the path, and
// with File_Error.Too_Large when they don't all fit in what's left of
// storage — storage then as it was. One storage takes several lists, one
// after another, and files read too (see read_file.mara).
//
// An entry is about 270 bytes (its name up to 260), so storage for a few
// hundred lives in the program's arena: set one first (see arenas.mara).
module directories

use mara.core
use mara.os
use mara.string
use mara.memory

main :: fun() {
	this_program = Program(Arena_Basic(16 * MB))
	storage : [..1 * MB]byte

	// This program's own directory, doc/: the .mara files in it.
	entries, e := dir_read(".", &storage)
	if e {
		print("couldn't read it:", e)
		return
	}
	pages := 0
	for entry in entries {
		name : []utf8 = entry.name[:]
		if entry.dir do continue
		if ends_with(name, ".mara") do pages += 1
	}
	print("doc/ has % pages, this one among them", pages)

	// The stdlib's directory, beside doc/: what's a directory in it. Its
	// list goes after the first, in the same storage.
	stdlib, se := dir_read("../code", &storage)
	if not se {
		for entry in stdlib {
			if entry.dir do print("a directory in code/:", entry.name[:])
		}
	}

	// A directory that isn't there.
	_, missing := dir_read("no_such_directory", &storage)
	print(missing)   // File_Error.Open_Failed
}
