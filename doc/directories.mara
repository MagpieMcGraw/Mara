// How to see what's in a directory — its files and the directories in it —
// with dir_read.
//
// dir_read lists them into storage you declare, `[N]byte`, after what's
// in it already, and gives them back, a view of storage: a `[]Dir_Entry`,
// an entry for each — its name (not its path: join the directory's and the
// name to open it) and whether it's a directory. "." and ".." aren't
// listed, and the order is the system's: sort them if it matters.
//
// An entry can be a link — a symbolic link, or on Windows a junction — to
// somewhere else: its `link` says so, and its `dir` says where it leads, a
// directory or not (a file, or nothing there any more). A walk down a tree
// goes into the entries that are `dir and not link`: a link can lead back
// up the tree, round and round, or to files found already. To follow one
// anyway, real_path says where it leads.
//
// It fails with File_Error.Open_Failed when there's no directory at the
// path, and with File_Error.Too_Large when they don't all fit in what's left
// of storage — storage then as it was. One storage takes several lists, one
// after another, and files read too (see read_file.mara).
//
// To keep only some of the entries — the .mara files, the directories —
// filter takes a function saying yes or no to each: the ones it keeps go
// into the storage too, after the list.
//
// An entry is about 270 bytes (its name up to 260), so storage for a few
// hundred lives in the program's arena: set one first (see arenas.mara).
module directories

use mara.core
use mara.os
use mara.string
use mara.memory

#allocator Arena_Basic(16 * MB)

// Whether an entry is a doc page: a .mara file.
is_page :: fun(entry: Dir_Entry) -> bool {
	return not entry.dir and ends_with(entry.name[:], ".mara")
}

main :: fun() {
	storage : [1 * MB]byte

	// This program's own directory, doc/: the .mara files in it.
	entries, e := dir_read(".", &storage)
	if e {
		print("couldn't read it:", e)
		return
	}
	pages := filter(entries, is_page, &storage)
	print("doc/ has % pages, this one among them", pages.len)

	// The stdlib's directory, beside doc/: what's a directory in it. Its
	// list goes after the first, in the same storage.
	stdlib, se := dir_read("../code", &storage)
	if not se {
		for entry in stdlib {
			if entry.dir do print("a directory in code/:", entry.name[:])
		}
	}

	// A directory that isn't there.
	_, missing := dir_read("no_such_directory", &storage)
	print(missing)   // File_Error.Open_Failed
}
