// How to work with text: literals, buffers you add to, slices, and search.
//
// Text is utf8 characters. A literal "like this" can't change. A buffer
// can: `name : str64` holds up to 64 characters (str256 and str1024 hold
// more, `[..N]utf8` any N), and `&name + "more"` adds to it. An add gives
// the buffer back, so adds chain: `&path + dir + "/" + file`. A list of
// texts, `[..100]str64`: `next(&list)` makes it one longer and gives that
// text, to add into where it is — `next(&list) + dir + "/" + file`.
// `s[a:b]` is part of a text, without a copy.
//
// The rest is in mara.string. Searching: find, find_byte, starts_with,
// ends_with, contains, contains_folded (letters' case not minded). Taking a
// text apart: trimmed, line_end, skip_spaces. Sorting: compare,
// compare_folded. Case: lower, upper. A number to text and back: int_text,
// parse_number.
//
// Two texts compare with `==` and `!=`, by their characters. Characters
// order as their bytes do (`c >= 'a' and c <= 'z'`), but aren't numbers:
// convert one with i64(c) to do arithmetic. A character past ASCII's takes
// more than one utf8: char_at reads it whole.
module text

use mara.core
use mara.string

main :: fun() {
	greeting := "hello"
	print(greeting, greeting.len)            // hello 5
	print(greeting[1:4])                     // ell

	name : str64
	&name + "Ada"
	&name + ' '                              // one character
	&name + "Lovelace"
	print(name, name.len, name.cap)          // Ada Lovelace 12 64

	// Adds chain; a list's next text is added into where it is.
	path : str64
	&path + "doc" + '/' + "text.mara"
	print(path)                              // doc/text.mara
	paths : [..8]str64
	next(&paths) + "doc" + "/" + "basics.mara"
	print(paths.len, paths[0])               // 1 doc/basics.mara
	print(name == "Ada Lovelace", name != "Ada")   // true true

	// Each character, with its position.
	for c, i in "abc" {
		print(i, c)
	}

	at, found := find(name, "Love")
	print(at, found)                         // 4 true
	print(starts_with(name, "Ada"))          // true
	_, has_comma := find_byte(name, ',')
	print(has_comma)                         // false
	print(ends_with("text.mara", ".mara"), contains_folded(name, "LOVE"))   // true true
	print(trimmed("  padded \r\n"))          // padded
	print(compare("apple", "banana"))        // -1: apple comes first

	digit := '7'
	print(i64(digit) - i64('0'))             // 7

	// A number to text, and back.
	count := int_text(-42)
	print(count, count.len)                  // -42 3
	n, ok := parse_number("2.5")
	print(n, ok)                             // 2.5 true
}
