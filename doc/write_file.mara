// How to write a file, and delete one.
//
// write_entire_file writes a file whole, text or bytes, replacing what's
// there: into a new file beside it, then moved over it in one step, so a
// program reading it, or the file after a crash, has the old one or the new
// one, never part of one.
//
// Step by step: file_open_write creates the file, or empties it if it's
// already there. file_open_append keeps what's there and writes after it (a
// log's way), creating the file if it's missing. file_write_text writes text
// into it, all of it. file_write writes bytes and may write only part of
// them: it says how many it wrote.
module write_file

use mara.core
use mara.files
use mara.memory

#allocator Arena_Basic(16 * MB)

// Adds text to the end of the file at path.
add_line :: fun(path: []utf8, text: []utf8) -> err {
	id := file_open_append(path)?
	defer file_close(id)
	file_write_text(id, text)?
}

main :: fun() {
	err := write_entire_file("write_file_demo.txt", "one line\nanother line\n")
	if err {
		print("couldn't write it:", err)
		return
	}
	added := add_line("write_file_demo.txt", "a third, added\n")
	if added do print("couldn't add to it:", added)

	// Read it back to see it arrived (see read_file.mara).
	storage : [1 * KB]byte
	back, _ := read_entire_file("write_file_demo.txt", &storage)
	print("wrote % bytes", back.len)

	err2 := file_delete("write_file_demo.txt")
	if err2 do print("couldn't delete it:", err2)
}
