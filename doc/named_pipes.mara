// How to make a program others connect to: it listens on a name, and
// programs on this machine connect to it by that name — several at once,
// each with a connection of its own.
//
// pipe_listen claims a name, a word such as "mara-view-game"; it fails with
// Name_Taken when another program has it. pipe_accept returns the next
// connection once a program has connected, and NO_FILE while none has: it
// doesn't wait, so a program with other work, a window drawing its frames,
// looks each frame. pipe_connect is the other side. A connection is read
// and written as a file is — file_read, pipe_read not to wait,
// file_write_text (file_write for bytes) —
// and file_close ends it. pipe_listen_stop frees the name.
//
// This program listens, then runs itself again as the one that connects
// (see processes.mara), which asks a question and prints the answer.
module named_pipes

use mara.core
use mara.os

NAME :: "mara-doc-named-pipes"

// The program that connects: asks, and prints what comes back.
ask :: fun() {
	id, e := pipe_connect(NAME)
	if e {
		print("couldn't connect:", e)
		return
	}
	defer file_close(id)
	we := file_write_text(id, "what's six times seven?")
	if we do print("couldn't ask:", we)
	answer : [64!]byte
	room := answer[:]
	got, re := file_read(id, &room)
	if re do print("couldn't read the answer:", re)
	text : []utf8 = got
	print("the answer:", text)
}

main :: fun(args: [][]utf8) -> i64 {
	if args.len > 1 {
		ask()
		return 0
	}
	l, e := pipe_listen(NAME)
	if e {
		print("couldn't listen:", e)
		return 1
	}
	defer pipe_listen_stop(&l)

	command : str256
	&command + "\""
	&command + args[0]
	&command + "\" ask"
	p, pe := process_start(command)
	if pe {
		print("couldn't start it:", pe)
		return 1
	}

	// Look until it connects. (A window would draw a frame between looks.)
	c := NO_FILE
	for c == NO_FILE {
		got, ae := pipe_accept(&l)
		if ae {
			print("couldn't accept:", ae)
			return 1
		}
		c = got
	}
	question : [64!]byte
	room := question[:]
	asked, qe := file_read(c, &room)
	if qe do print("couldn't read the question:", qe)
	text : []utf8 = asked
	print("asked:", text)
	we := file_write_text(c, "42")
	if we do print("couldn't answer:", we)
	file_close(c)

	// What the other program printed, to its end.
	out : [200]byte
	chunk : [64!]byte
	piece_room := chunk[:]
	for true {
		piece, oe := file_read(p.output, &piece_room)
		if oe or piece.len == 0 do break
		&out + piece
	}
	said : []utf8 = out
	print("it printed:", said)
	_, xe := process_wait(&p)
	if xe do print("couldn't wait for it:", xe)
	return 0
}
