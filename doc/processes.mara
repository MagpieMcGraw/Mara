// How to run another program and talk to it, through its input and output.
//
// process_start runs a command line — a program, then its arguments — and
// returns a Process: `p.input` is the program's input, written to with
// file_write_text, and `p.output` its output (its error output too), read with
// file_read. Closing its input, process_close_input, tells it there is no
// more: its reads get 0 bytes. process_wait waits for it to end and returns
// its exit code.
//
// file_read waits for the program to write something. A program that can't
// wait — a window, drawing its frames — reads with pipe_read instead: it
// takes what has arrived, maybe nothing, and returns false once the output
// has ended.
//
// A program reads its own input with standard_input(), and writes its
// output with standard_output() or print.
//
// This program runs itself again, with an argument, as the one it talks to.
module processes

use mara.core
use mara.os

// The program talked to: reads its input to the end, then answers.
child :: fun() {
	got : [200]byte
	chunk : [64]byte
	for true {
		e := file_read(standard_input(), &chunk)
		if e or chunk.len == 0 do break   // 0 bytes: the end
		&got + chunk
	}
	text : []utf8 = got
	print("the child got:", text)
}

main :: fun(args: [][]utf8) -> i64 {
	if args.len > 1 {
		child()
		return 0
	}
	// Its own path, quoted (a path can have spaces), then an argument.
	command : str256
	&command + "\""
	&command + args[0]
	&command + "\" child"
	p, e := process_start(command)
	if e {
		print("couldn't start it:", e)
		return 1
	}

	// Without waiting: nothing has arrived yet (the child is waiting for its
	// input to end), and its output is still open.
	early : [64]byte
	open, pe := pipe_read(p.output, &early)
	if pe do print("couldn't read from it:", pe)
	print("so far:", early.len, "bytes; still open:", open)

	// Write to its input, then close it: the child reads to its end.
	we := file_write_text(p.input, "hello")
	if we do print("couldn't write to it:", we)
	process_close_input(&p)

	// Read what it writes, until its output ends: it has exited.
	out : [400]byte
	chunk : [64]byte
	for true {
		re := file_read(p.output, &chunk)
		if re or chunk.len == 0 do break
		&out + chunk
	}
	text : []utf8 = out
	print("it said:", text)

	code, xe := process_wait(&p)
	if xe do print("couldn't wait for it:", xe)
	print("it exited with", code)
	return 0
}
