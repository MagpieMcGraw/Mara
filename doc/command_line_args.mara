// How to read the command-line arguments a program was run with.
//
// They are `this_program.args`: args[0] is the program's own path, then
// each argument, as text. `this_program.args.len` says how many. They're
// read only, like all of this_program: copy what you'd change into a
// variable.
module command_line_args

use mara.core

main :: fun() {
	if this_program.args.len < 2 {
		print("usage: command_line_args <name>...")
		return
	}
	// Every argument after the program's own path.
	for arg, i in this_program.args {
		if i == 0 do continue
		print("argument", i, "is", arg)
	}
}
