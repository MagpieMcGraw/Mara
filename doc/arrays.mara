// How to keep several values: fixed arrays, growable lists, and slices.
//
// `[4!]i64` is exactly four values. `[8]i64` holds up to eight: its len is
// how many it has, its cap how many fit, and `&list + x` adds one.
// `next(&list)` makes it one longer and points at the new item: `^` writes
// it, `next(&list)^ = x` (or a field of it, `next(&list)^.name = …`). A slice
// `[]i64` is a view of some of either, without a copy: `a[1:3]`, `a[1:]`
// for the rest of its items, or `a[:]` for all of its room (a list's whole
// cap). A slice made so holds all of its items until you append to it:
// then it fills from its start, as an empty one would (`room := buf[:]`,
// then `&room + x`). A list given where a slice goes is a view of its items
// (`sum(list)`). Functions usually take slices, so they work on any of
// these. An array given back isn't a slice, though: a view of a fun's own
// array would outlive it — return the array itself (`-> [8]i64`; text,
// `-> str64`). Reading
// or writing past the end stops the program with a message.
module arrays

use mara.core

// The sum of the values.
sum :: fun(xs: []i64) -> i64 {
	total := 0
	for x in xs {
		total += x
	}
	return total
}

main :: fun() {
	fixed : [4!]i64 = [1, 2, 3, 4]
	print(fixed.len, fixed[0], sum(fixed[:]))    // 4 1 10

	list : [8]i64
	&list + 10
	&list + 20
	print(list.len, list.cap, sum(list))      // 2 8 30
	next(&list) = 30
	print(list.len, list[2])                     // 3 30

	middle := fixed[1:3]
	print(middle.len, middle[0], middle[1])      // 2 2 3

	fixed[0] = 100
	print(fixed[0])                              // 100

	// Each value, with its position.
	for x, i in list {
		print(i, x)
	}
}
