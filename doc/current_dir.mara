// How a program finds the directory it runs in — where a path that isn't
// whole starts from: current_dir. `mara build` in a folder builds the
// module there; a tool given a file's name opens it from there.
//
// It's not where the program's file is: started from another directory, a
// program runs there — executable_path says where its own file is (see
// executable_path.mara).
//
// It puts the path into storage you declare, `[..N]byte`, as
// executable_path does, and gives it back, a view of storage: Too_Large
// when it doesn't fit. The path is whole, with no separator at its end (but
// a drive's root, `C:\`, or `/`): add one before a file's name.
module current_dir

use mara.core
use mara.os
use mara.memory

main :: fun() {
	this_program = Program(Arena_Basic(1 * MB))
	storage : [..64 * KB]byte

	dir, e := current_dir(&storage)
	if bool(e) {
		print("couldn't tell:", e)
		return
	}

	// A file here, two ways: its name alone, and the directory and its name.
	_, alone := read_entire_file("current_dir.mara", &storage)
	whole : [..1100]utf8
	&whole + dir
	&whole + "/"
	&whole + "current_dir.mara"
	_, by_path := read_entire_file(whole, &storage)
	print("read by its name and by its whole path, the same:", alone == by_path)
}
