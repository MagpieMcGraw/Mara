// How a program finds the directory it runs in — where a path that isn't
// whole starts from: current_dir. `mara build` in a folder builds the
// module there; a tool given a file's name opens it from there.
//
// It's not where the program's file is: started from another directory, a
// program runs there — executable_path says where its own file is (see
// executable_path.mara).
//
// It gives back a Path: up to 512 characters, its room past the path there
// to add to — `&dir + "/" + name` makes a file's path of it. Too_Large when
// the path is longer. The path is whole, its separators '/' (Windows' too),
// with none at its end (but a drive's root, `C:/`, or `/`): add one before a
// file's name.
//
// It's spelled as the directory was entered: `cd c:\code` gives `c:/code`,
// and a link or junction on the way stays as it is. real_path(dir) asks the
// system for its own spelling — its letters' case as on disk, links followed
// to where they lead — so two spellings of one folder come out the same:
// make the folders a search starts from so, and the paths built on them
// compare as they are.
module current_dir

use mara.core
use mara.os
use mara.memory

main :: fun() {
	this_program = Program(Arena_Basic(1 * MB))
	storage : [64 * KB]byte

	dir, e := current_dir()
	if e {
		print("couldn't tell:", e)
		return
	}

	// A file here, two ways: its name alone, and the directory and its name.
	_, alone := read_entire_file("current_dir.mara", &storage)
	&dir + "/" + "current_dir.mara"
	_, by_path := read_entire_file(dir, &storage)
	print("read by its name and by its whole path, the same:", alone == by_path)

	// Two spellings of this directory, one as the system has it.
	here, _ := real_path(".")
	there, _ := real_path("../doc")
	print("one folder, however it's spelled:", here == there)
}
