// How to sort a list or a slice, in place, with mara.sorting.
//
// sort(&items) puts them smallest first, by `<`. sort_by(&items, before) takes a
// fun saying whether its first item goes before its second, for items `<` doesn't
// compare, or another order. Items that compare equal can end up in any order.
module sorting

use mara.core
use mara.sorting

Fruit :: struct {
	name: str64
	count: i64
}

most_first :: fun(a: Fruit, b: Fruit) -> bool { return a.count > b.count }

main :: fun() {
	numbers : [8]i64
	&numbers ++ 5
	&numbers ++ 2
	&numbers ++ 9
	sort(&numbers)
	print(numbers)                     // [2, 5, 9]

	fruit : [8]Fruit
	&fruit ++ Fruit{name = "plums", count = 2}
	&fruit ++ Fruit{name = "apples", count = 7}
	sort_by(&fruit, most_first)
	print(fruit[0].name)               // apples
}
