{
    // Path to the Mara compiler executable. A bare "mara" works only if it is on
    // PATH as a real .exe/.bat/.cmd (a Windows subprocess can't run an extension-
    // less shim), so the absolute path is the safe default. Forward slashes are
    // fine on Windows.
    "mara_path": "C:/Code/Mara/Mara.exe",

    // Hops to expand. 0 = the tool's own default (types: full closure; flow: 1
    // call hop). Set to 1 or 2 to keep a god-object's type graph from flooding
    // the panel; raise per-query from the command palette when you want more.
    "default_depth": 0,

    // Fraction of the window width kept for your code when Mara Ask first opens
    // its right-hand output column (the rest goes to the output pane). Only used
    // when the window is a single pane and Mara Ask creates the split; once the
    // column exists, drag the divider to resize and it's remembered.
    "split_ratio": 0.6,

    // After a FLOW query, mark its variables in the code: the queried variable in
    // one colour and the variables its flow surfaces in another, at their def
    // sites. Cleared on the next query or with Ctrl+K Ctrl+C. Set false to disable.
    "highlight_flow": true,

    // Region colours for the highlight — any scope the color scheme defines. The
    // "region.*ish" names are the standard themed accents (build 3148+).
    "highlight_subject_scope": "region.bluish",
    "highlight_scope": "region.yellowish"
}
