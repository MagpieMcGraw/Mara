{
  "name": "mara",
  "displayName": "Mara",
  "description": "Mara in VS Code: colors, the language server (mara lsp), building and debugging, and the mara view window.",
  "version": "0.2.1",
  "publisher": "mara",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:mara",
    "onDebugResolve:mara",
    "onDebugDynamicConfigurations:mara"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mara",
        "aliases": [
          "Mara"
        ],
        "extensions": [
          ".mara"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mara",
        "scopeName": "source.mara",
        "path": "./syntaxes/mara.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "mara"
      }
    ],
    "debuggers": [
      {
        "type": "mara",
        "label": "Mara",
        "languages": [
          "mara"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "module": {
                "type": "string",
                "description": "What `mara build` builds: a module or a build.mara build. Left out: the one in cwd."
              },
              "buildArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "More for `mara build`: -x86, -crt, ..."
              },
              "build": {
                "type": "boolean",
                "default": true,
                "description": "Build before debugging."
              },
              "program": {
                "type": "string",
                "description": "The program to debug. Left out: the one the build made."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The program's command line."
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "Where it's built and run."
              },
              "stopAtEntry": {
                "type": "boolean",
                "default": false
              },
              "console": {
                "type": "string",
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal",
                  "newExternalWindow"
                ],
                "description": "Where its output goes (the C/C++ debugger's choices)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "mara",
            "request": "launch",
            "name": "Build and debug",
            "cwd": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Mara: build and debug",
            "description": "Build the module with `mara build`, then debug it.",
            "body": {
              "type": "mara",
              "request": "launch",
              "name": "Build and debug",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "mara.restartServer",
        "title": "Mara: Restart the Language Server"
      },
      {
        "command": "mara.openView",
        "title": "Mara: Open View"
      }
    ],
    "configuration": {
      "title": "Mara",
      "properties": {
        "mara.path": {
          "type": "string",
          "default": "mara",
          "description": "The Mara compiler: a path, or a name found on PATH. The language server is its `lsp` and builds are its `build`."
        },
        "mara.view.followCursor": {
          "type": "boolean",
          "default": true,
          "description": "Tell a `mara view` window where the cursor rests in a .mara file: its Docs and Ask panels show what's there, and it moves to the file's module."
        },
        "mara.view.delayMs": {
          "type": "number",
          "default": 300,
          "description": "How long the cursor rests before the window is told, in milliseconds."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "mara.openView",
          "when": "resourceLangId == mara",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "mara.openView",
          "when": "editorLangId == mara"
        }
      ]
    }
  }
}
